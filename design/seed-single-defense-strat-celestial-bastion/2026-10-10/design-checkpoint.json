  "tasks": {
    "local_authoring_parts::0faac48f35217f31444de766e3ca4b8abac87d4d97e91cba0b78cfe8974c9471:identity": {
      "identity": "천상의 보루는 고전적인 타워 디펜스 장르를 재해석하여, 플레이어가 실시간으로 전장의 지형을 변형하고 유닛의 속성을 동적으로 조합하는 전략적 깊이를 제공합니다. 핵심 루프인 '적의 경로 예측-방어선 구축-자원 최적화'는 단순한 배치를 넘어, 지형 변형 시스템과 속성 공명 시스템을 통해 매 순간 플레이어의 창의적인 선택이 전황을 뒤바꾸는 고유한 경험을 창출합니다."
    },
    "local_authoring_parts::7cdfac577f50cfa39400bf3d9e43b538fd8a333fb26dbb6809c0e62858e4d4fa:mainIdentity,a,b,abCausality": {
      "mainIdentity": "천상의 보루는 고전적인 타워 디펜스 장르를 재해석하여, 플레이어가 실시간으로 전장의 지형을 변형하고 유닛의 속성을 동적으로 조합하는 전략적 깊이를 제공합니다.",
      "a": {
        "system": "지형 변형 시스템",
        "material": "플레이어가 특정 구역의 지형을 높여 적의 이동을 차단하거나, 낮추어 특정 타워의 사거리 안으로 적을 유인하는 선택",
        "materialDomain": "2D 그리드 기반의 높이 값과 속성 배열",
        "stateChange": "지형 변형 시스템에 의해 경로 탐색 알고리즘에 반영"
      },
      "b": {
        "system": "속성 공명 시스템",
        "material": "화염 타워와 전기 타워를 인접하게 배치하여 광범위한 폭발 효과를 노릴지, 혹은 냉기 타워를 배치하여 적의 이동 속도를 늦출지 선택",
        "materialDomain": "타워의 속성 조합 및 강화",
        "stateChange": "타워 속성이 다른 타워의 성능에 영향을 미치는 즉각적인 변화"
      },
      "abCausality": "지형 변형 시스템과 속성 공명 시스템 간의 양방향 상태 교환은 플레이어의 창의적 선택에 따라 달라집니다. 지형 변형 시스템은 방어선 구축 효율을 극대화하고, 속성 공명 시스템은 적의 약점을 공략하는 전술적 깊이를 더합니다."
    },
    "local_authoring_parts::7cdfac577f50cfa39400bf3d9e43b538fd8a333fb26dbb6809c0e62858e4d4fa:abEvolution,materialFusion,storyCausalChain": {
      "abEvolution": {
        "aChangesB": "지형 변형 시스템의 경로 탐색 알고리즘에 의해 방어선 구축 효율이 극대화되며, 속성 공명 시스템의 타워 속성이 다른 타워의 성능에 영향을 미치는 즉각적인 변화가 발생",
        "bChangesA": "속성 공명 시스템의 타워 속성이 다른 타워의 성능에 영향을 미치는 즉각적인 변화가 발생하며, 지형 변형 시스템의 경로 탐색 알고리즘에 의해 방어선 구축 효율이 극대화됨",
        "lateGameChange": "플레이어의 창의적 선택에 따라 지형 변형 시스템과 속성 공명 시스템 간의 상태 교환은 양방향으로 이뤄지고, 전술적 깊이와 전황 조절 능력이 확장"
      },
      "materialFusion": {
        "contrast": "지형 변형 시스템과 속성 공명 시스템의 상호작용은 플레이어의 창의적 선택에 따라 달라짐",
        "causalBridge": "지형 변형 시스템은 방어선 구축 효율을 극대화하고, 속성 공명 시스템은 적의 약점을 공략하는 전술적 깊이를 더함",
        "removalConsequence": "보조 장르 제거 시 게임의 전략적 자유도와 전술적 깊이가 감소하지만, 주제와 메인 장르의 핵심 루프는 유지됨"
      },
      "storyCausalChain": {
        "cause": "플레이어의 지형 변형 및 속성 공명 선택",
        "characterConflict": "전략적 자유도와 전술적 깊이의 경쟁을 유발",
        "playerChoice": "창의적인 선택으로 지형 변형 시스템과 속성 공명 시스템 간의 상태 교환을 결정",
        "worldChange": "방어선 구축 효율 증대와 적의 약점 확보로 전황 조절 능력 강화",
        "nextEvent": "상호작용 결과에 따른 새로운 타워 기술 연구 또는 타워 속성 강화"
      }
    },
