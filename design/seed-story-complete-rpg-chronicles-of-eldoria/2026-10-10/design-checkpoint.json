  "tasks": {
    "local_authoring_parts::c9f6c622ec553b87f9b96b733e2fd6a1e26ff7e3a2efb2100b5c9c4ef0335ed2:identity": {
      "identity": "엘도리아 연대기는 고전 RPG의 서사적 깊이와 현대적인 모바일 최적화 전략 전투를 결합한 턴제 RPG입니다. 플레이어는 탐험과 전투를 통해 획득한 자원으로 캐릭터의 스킬 트리를 능동적으로 재구성하며, 이 과정에서 발생하는 '전술적 선택'이 전투 결과와 스토리 분기에 즉각적인 상태 변화를 일으켜 매번 새로운 공략 경험을 제공합니다."
    },
    "local_authoring_parts::8aeed77737a11cc12860c1347a69f5f18320fac2387177897eb19183da4824f1:mainIdentity,a,b,abCausality": {
      "mainIdentity": "엘도리아 연대기는 고전 RPG의 서사적 깊이와 현대적인 모바일 최적화 전략 전투를 결합한 턴제 RPG입니다.",
      "a": {
        "system": "속성 공명 시스템",
        "material": "플레이어는 매 턴마다 어떤 속성의 스킬을 우선 사용할지, 혹은 동료와 어떤 속성 연계를 발동시킬지를 결정하며, 이 선택이 전투의 템포와 피해량을 즉각적으로 변화시킵니다.",
        "materialDomain": "캐릭터 스킬 트리 재구성",
        "stateChange": "선택 → 속성 조합 → 전투 결과 및 캐릭터 성장 방향 변화"
      },
      "b": {
        "system": "운명 개척 탐험 시스템",
        "material": "플레이어는 제한된 유물 에너지를 사용하여 특정 지형을 복구할지, 아니면 전투 보너스를 얻기 위해 소모할지를 선택하며, 이 선택이 맵의 접근성과 이후 전투 난이도에 직접적인 영향을 줍니다.",
        "materialDomain": "고대 유물 파편 활용",
        "stateChange": "선택 → 지형 변화/길 열림 → 맵 접근성 및 전투 난이도 변화"
      },
      "abCausality": "속성 공명 시스템 ↔ 운명 개척 탐험 시스템: 플레이어의 선택은 전투 결과와 맵 상태에 즉각적 영향을 미칩니다. 속성 조합은 전투 텀포와 피해량을 결정하고, 유물 에너지는 맵 구조와 전투 난이도를 변동합니다."
    }
  },
