  "tasks": {
    "designer_draft_slices::identity-core": {
      "identity": "마을에서 장비와 퀘스트를 준비하고 5개의 포탈 사냥터를 돌며 AI 유저와 파티를 구성해 보스를 공략하는 3D 액션 RPG.",
      "playerFantasy": "플레이어는 마을에서 퀘스트와 장비를 준비하고, 5개의 포탈 사냥터를 돌며 AI 유저와 파티를 구성해 보스를 공략하는 3D 액션 RPG의 플레이어 역할을 수행한다. 플레이어는 AI 유저와 파티 조합을 선택하고, 보스 공략을 통해 기여도를 통해 보상을 얻는다.",
      "coreFun": "플레이어는 5개의 대형 지역을 전투로 돌파하고, 10명의 AI 유저 중 원하는 역할을 선택해 파티를 구성하며, 기여도를 기반으로 더 큰 보상을 얻는 성장 재미를 경험한다.",
      "coreLoop": [
        "마을에서 퀘스트와 장비 준비",
        "포탈로 사냥터 이동",
        "몬스터 직접 전투",
        "보스 첫 처치로 AI 동료 해금",
        "15마리 파티 사냥과 기여도 보상",
        "플레이어 + 보스 동료 최대 3명 편성",
        "보스 공략 → 보스 동료 해금 → 파티 조합 확장",
        "마을 귀환/회복/강화"
      ],
      "signatureSystems": [
        {
          "name": "5포탈 지역",
          "purpose": "초원·협곡·유적·설원·심연의 독립 대형 사냥터.",
          "playerChoice": "플레이어는 5개의 포탈 지역을 선택하여 전투를 수행한다."
        },
        {
          "name": "레벨 성장",
          "purpose": "레벨업마다 최대체력 +10, 공격력 +10.",
          "playerChoice": "플레이어는 레벨을 올리며 기여도를 통해 보상을 얻는다."
        },
        {
          "name": "15킬 파티사냥",
          "purpose": "15마리 처치 시 종료하고 기여도에 따라 XP/골드 보상.",
          "playerChoice": "플레이어는 15마리의 몬스터를 처치하여 보상을 얻는다."
