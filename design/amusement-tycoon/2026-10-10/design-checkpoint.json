  "tasks": {
    "local_authoring_parts::84609ec7ac3e10188953f8ff55f3ec5171c4378339e7bbf7bebf5238ba38b14e:identity": {
      "identity": "놀이공원 타이쿤은 단순한 경영 시뮬레이션을 넘어, 플레이어가 놀이기구의 배치와 동선 설계를 통해 손님의 감정 상태를 실시간으로 조율하는 3D 전략 경영 게임입니다. 핵심 루프와 시그니처 시스템은 단순히 건물을 짓는 행위에 그치지 않고, 손님의 만족도와 수익이라는 두 가지 상충하는 지표 사이에서 매 순간 최적의 선택을 강제하며, 이 선택이 놀이공원의 전체적인 흐름과 수익성에 즉각적인 변화를 가져오도록 설계되었습니다."
    },
    "local_authoring_parts::e74d6db9638f13f1e1ad6e76d3f5cbe5de9ff42a76486bbf102bf295c7f65c6e:mainIdentity,a,b,abCausality": {
      "mainIdentity": "놀이공원 타이쿤은 단순한 경영 시뮬레이션을 넘어, 플레이어가 놀이기구의 배치와 동선 설계를 통해 손님의 감정 상태를 실시간으로 조율하는 3D 전략 경영 게임입니다.",
      "a": {
        "system": "동선 최적화 시스템",
        "material": "플레이어는 길의 너비, 놀이기구 입구의 위치, 휴식 공간의 배치를 결정하여 손님의 이동 흐름을 직접 제어하고 최적화할 수 있습니다.",
        "materialDomain": "경관 및 인프라",
        "stateChange": "손님의 이동 경로와 행복도 아이콘에 즉각적인 변화를 주며 공원 전체의 수용 능력을 높인다."
      },
      "b": {
        "system": "감정 기반 만족도 엔진",
        "material": "플레이어는 놀이기구의 스릴 강도 조절, 테마 장식 추가, 음식 가격 책정을 통해 손님의 감정 상태를 긍정적으로 유도하는 선택을 합니다.",
        "materialDomain": "문화 및 서비스",
        "stateChange": "손님의 감정 상태가 긍정적이 되면 공원의 평판과 수익에 즉각적인 영향을 미친다."
      },
      "abCausality": "동선 최적화 시스템 ↔ 감정 기반 만족도 엔진: 플레이어의 선택은 동선 배치와 서비스 요소에 실질적 인과 변화를 줄 수 있다. 손님의 이동 효율성과 만족도는 게임의 핵심 지표로 작용하며, 이를 바탕으로 전략적 재투자와 성장 계획이 이루어 진다."
    }
  },
