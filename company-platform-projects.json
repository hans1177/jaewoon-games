{
  "version": 3,
  "policySource": "COMPANY_FLOW.md",
  "ownerApprovedAt": "2026-09-12",
  "primaryPlatform": "ROBLOX",
  "platformPriority": ["ROBLOX", "UNITY_ANDROID", "FORTNITE_UEFN"],
  "rolloutStrategy": {
    "phase1": {
      "platforms": ["ROBLOX"],
      "objective": "FAST_RELEASE_AND_STABILIZATION",
      "exitRequires": [
        "REPEATED_RELEASE_SUCCESS",
        "RUNTIME_STABILITY",
        "QA_REGRESSION_PASS",
        "VERIFIED_EXPERIENCE_ACCUMULATION"
      ]
    },
    "phase2": {
      "platforms": ["ROBLOX", "UNITY_ANDROID"],
      "objective": "DUAL_PLATFORM_RELEASE_EXPERIENCE_ACCUMULATION",
      "unityRule": "PRESERVE_EXISTING_UNITY_AND_IMPLEMENT_EXTENDED_VERSION",
      "exitRequires": [
        "ROBLOX_RELEASE_PATH_STABLE",
        "UNITY_EXTENDED_RELEASE_PATH_VALIDATED",
        "DUAL_PLATFORM_RELEASE_EXPERIENCE_VERIFIED"
      ]
    },
    "phase3": {
      "platforms": ["FORTNITE_UEFN"],
      "objective": "FORTNITE_RELEASE_AFTER_ROBLOX_AND_UNITY_EXPERIENCE",
      "entryRequires": [
        "PHASE1_STABLE",
        "PHASE2_VERIFIED_EXPERIENCE_ACCUMULATED"
      ]
    }
  },
  "switchMode": "PRIMARY_PLATFORM_POINTER",
  "rebuildCompanyStructureOnSwitch": false,
  "projects": {
    "ROBLOX": {
      "status": "ACTIVE_PRIMARY_PHASE1",
      "sourceRoot": "roblox-games/<slug>",
      "language": "Luau",
      "runtime": "ROBLOX_EXPERIENCE",
      "validation": [
        "ACTUAL_EXPERIENCE_ENTRY",
        "MEANINGFUL_INPUT",
        "CORE_LOOP_STATE_CHANGE",
        "SERVER_CLIENT_HEALTH",
        "REMOTE_EVENT_VALIDATION",
        "DATASTORE_WHEN_USED",
        "MOBILE_TOUCH",
        "MULTIPLAYER_WHEN_USED",
        "PERFORMANCE",
        "QA",
        "REGRESSION",
        "EXACT_REVISION"
      ]
    },
    "UNITY_ANDROID": {
      "status": "ACTIVE_FIRST_CLASS_EXTENDED_PHASE2",
      "sourceRoot": "EXISTING_UNITY_PROJECT_ROOTS",
      "language": "C#",
      "runtime": "ANDROID",
      "preserveExistingFlow": true,
      "preserveExistingSourceAndBehavior": true,
      "preserveExistingWebToUnityValidation": true,
      "preserveExistingBuildWorkflow": true,
      "extensionRequired": true,
      "extensionMode": "ADD_CAPABILITY_AROUND_EXISTING_RESPONSIBLE_SYSTEMS",
      "replacementOrRebuildForbidden": true,
      "regressionRequiredAfterSharedArchitectureChange": true,
      "releaseModeAfterPhase1": "DUAL_RELEASE_WITH_ROBLOX"
    },
    "FORTNITE_UEFN": {
      "status": "ACTIVE_AVAILABLE_PHASE3",
      "sourceRoot": "fortnite-uefn/<slug>",
      "language": "Verse",
      "runtime": "FORTNITE_UEFN",
      "validation": [
        "PROJECT_OPENS_IN_UEFN",
        "SESSION_LAUNCH",
        "MEANINGFUL_INPUT",
        "CORE_LOOP_STATE_CHANGE",
        "VERSE_RUNTIME_HEALTH",
        "MULTIPLAYER_SESSION_WHEN_USED",
        "PERFORMANCE",
        "QA",
        "REGRESSION",
        "EXACT_REVISION"
      ]
    }
  },
  "sharedLearning": {
    "distillationRequired": true,
    "canonicalDistillationOnly": true,
    "newPlatformSpecificDistillationChainForbidden": true,
    "newPlatformSpecificCronForbidden": true,
    "newLearningStageForbidden": true,
    "verifiedEvidenceOnly": true,
    "existingVerifiedInputsOnly": true,
    "failureAttemptsAreWarningEvidenceOnly": true,
    "phaseExperienceMustAccumulateBeforeNextPlatformExpansion": true
  },
  "locks": {
    "vibeLearningStructureImmutable": true,
    "vibeLearningCodePathsImmutable": true,
    "buildWorkflowImmutable": true,
    "parentChildBuildTopologyImmutable": true,
    "triggerAndArtifactFlowImmutable": true,
    "noWrapperShadowBypass": true
  },
  "switchingRule": "Change primaryPlatform/project selection only; do not rebuild or fork the company core, Vibe learning chain, existing Unity project, or existing build workflows."
}
