{
  "version": 1,
  "policy": {
    "scope": "homepage-published-games",
    "webGamesReadOnly": true,
    "genericScenarioAlwaysRuns": true,
    "deepScenarioOptionalPerGame": true,
    "mobileViewport": {"width": 360, "height": 800},
    "failOnPageError": true,
    "recordScreenshots": true
  },
  "generic": {
    "startButtonTexts": ["시작", "게임 시작", "START", "PLAY", "재시작", "계속"],
    "keys": ["ArrowRight", "ArrowLeft", "ArrowUp", "ArrowDown", "KeyW", "KeyA", "KeyS", "KeyD", "Space"],
    "checks": [
      "page-load",
      "console-error",
      "page-error",
      "failed-request",
      "horizontal-overflow-360px",
      "first-interaction",
      "reload-survival"
    ]
  },
  "games": {
    "daechung-rpg": {
      "webSmoke": true,
      "androidScenario": [
        "launch",
        "town-to-field",
        "idle-walk-attack-hurt-death",
        "reward-update",
        "death-return-town",
        "save-relaunch-restore",
        "360px-ui"
      ]
    }
  }
}
