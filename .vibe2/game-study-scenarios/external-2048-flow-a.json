{
  "version": 1,
  "engine": "web",
  "page": "index.html",
  "timeoutMs": 30000,
  "requirePlayability": false,
  "failOnRuntimeError": false,
  "metadata": {
    "origin": "external-public",
    "study": "movement-and-merge-progression",
    "sourceAccess": "observation-only"
  },
  "actions": [
    {
      "id": "wait-for-external-game-init",
      "type": "wait",
      "ms": 1800
    },
    {
      "id": "initial-board-ready",
      "type": "expect",
      "name": "initial puzzle board ready",
      "expression": "document.querySelectorAll('.grid-cell').length===16 && document.querySelectorAll('.tile-container .tile').length>=2"
    },
    {
      "id": "move-left",
      "type": "key",
      "key": "ArrowLeft",
      "holdMs": 60
    },
    {
      "id": "wait-after-left",
      "type": "wait",
      "ms": 180
    },
    {
      "id": "move-up",
      "type": "key",
      "key": "ArrowUp",
      "holdMs": 60
    },
    {
      "id": "wait-after-up",
      "type": "wait",
      "ms": 180
    },
    {
      "id": "merge-progression-observed",
      "type": "expect",
      "name": "movement merge progression board remains playable",
      "expression": "document.querySelector('.score-container')!==null && document.querySelectorAll('.tile-container .tile').length>=2"
    },
    {
      "id": "move-right",
      "type": "key",
      "key": "ArrowRight",
      "holdMs": 60
    },
    {
      "id": "move-down",
      "type": "key",
      "key": "ArrowDown",
      "holdMs": 60
    },
    {
      "id": "reward-score-feedback",
      "type": "expect",
      "name": "reward score feedback visible after movement",
      "expression": "document.querySelector('.score-container')!==null && document.querySelector('.best-container')!==null"
    }
  ]
}
