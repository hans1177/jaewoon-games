      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      background-color: #222;\n    }\n    h1 {\n      color: #fff;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div id=\"ui\">\n      <button id=\"start\">Start Game</button>\n      <div id=\"progression\">Progression: <span id=\"progress\">0</span>%</div>\n      <div id=\"economy\">Economy: <span id=\"economyValue\">0</span></div>\n      <div id=\"combat\">Combat: <span id=\"combatValue\">0</span></div>\n    </div>\n    <div id=\"gameArea\"></div>\n  </main>\n  <script>\n    // Protected state preservation\n    const protectedState = {\n      progression: 0,\n      economy: 0,\n      combat: 0,\n      gameArea: document.getElementById('gameArea')\n    };\n\n    // Game loop\n    function gameLoop() {\n      const progress = protectedState.progression;\n      const economy = protectedState.economy;\n      const combat = protectedState.combat;\n\n      // Simulate game progression\n      protectedState.progression = progress + 1;\n      protectedState.economy = economy + 1;\n      protectedState.combat = combat + 1;\n\n      // Update UI\n      document.getElementById('progress').textContent = progress;\n      document.getElementById('economyValue').textContent = economy;\n      document.getElementById('combatValue').textContent = combat;\n\n      // Check for game completion\n      if (progress === 100 && economy === 100 && combat === 100) {\n        alert(\"Game Completed!\");\n      }\n\n      // Simulate player input\n      document.getElementById('start').addEventListener('click', () => {\n        protectedState.progression = 0;\n        protectedState.economy = 0;\n        protectedState.combat = 0;\n        document.getElementById('progress').textContent = 0;\n        document.getElementById('economyValue').textContent = 0;\n        document.getElementById('combatValue').textContent = 0;\n      });\n    }\n\n    // Initialize game\n    document.getElementById('start').addEventListener('click', gameLoop);\n  </script>\n</body>\n</html>"
    }
