  "replaceFiles": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      text-align: center;\n    }\n    h1 {\n      font-size: 2em;\n      margin-bottom: 1em;\n    }\n    button {\n      padding: 0.5em 1em;\n      font-size: 0.9em;\n      margin: 0 0.5em;\n      background-color: #444;\n      color: #fff;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background-color 0.3s;\n    }\n    button:hover {\n      background-color: #666;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <button id=\"startButton\">Start Game</button>\n    <div id=\"gameContent\"></div>\n  </main>\n\n  <script>\n    const gameContainer = document.getElementById('gameContent');\n    const startButton = document.getElementById('startButton');\n\n    startButton.addEventListener('click', () => {\n      gameContainer.innerHTML = `\n        <p>Game is starting...</p>\n        <p>Press any key to continue...</p>\n        <button id=\"continueButton\">Continue</button>\n      `;\n      document.getElementById('continueButton').addEventListener('click', () => {\n        gameContainer.innerHTML = `\n          <p>Game is progressing...</p>\n          <p>Press any key to fail or succeed...</p>\n          <button id=\"failButton\">Fail</button>\n          <button id=\"successButton\">Success</button>\n        `;\n        document.getElementById('failButton').addEventListener('click', () => {\n          gameContainer.innerHTML = `\n            <p>Game failed...</p>\n            <p>Try again...</p>\n            <button id=\"retryButton\">Retry</button>\n          `;\n          document.getElementById('retryButton').addEventListener('click', () => {\n            gameContainer.innerHTML = `\n              <p>Game restarted...</p>\n              <p>Enjoy the game!</p>\n            `;\n          });\n        });\n        document.getElementById('successButton').addEventListener('click', () => {\n          gameContainer.innerHTML = `\n            <p>Game succeeded...</p>\n            <p>Great job!</p>\n          `;\n        });\n      });\n    });\n  </script>\n</body>\n</html>"
    }
  ],
