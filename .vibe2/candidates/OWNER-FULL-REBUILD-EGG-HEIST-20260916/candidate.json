      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      padding: 20px;\n      background-color: #111;\n      min-height: 100vh;\n    }\n    h1 {\n      text-align: center;\n      margin-bottom: 20px;\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n    }\n    .game-container > div {\n      width: 80%;\n      max-width: 600px;\n      background-color: #333;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0,0,0,0.5);\n    }\n    .game-container > div > h2 {\n      margin-bottom: 10px;\n    }\n    .game-container > div > p {\n      margin-bottom: 15px;\n    }\n    .game-container > div > button {\n      background-color: #555;\n      color: #fff;\n      border: none;\n      padding: 10px 20px;\n      border-radius: 4px;\n      cursor: pointer;\n      font-size: 16px;\n    }\n    .game-container > div > button:hover {\n      background-color: #777;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\"></main>\n  <script>\n    // Protected state preservation\n    let gameState = {\n      player: {\n        position: { x: 0, y: 0 },\n        inventory: [],\n        health: 100,\n        score: 0\n      },\n      enemies: [],\n      progress: {\n        level: 1,\n        experience: 0,\n        money: 0\n      },\n      isGameRunning: true\n    };\n\n    // Direct player input\n    document.querySelector('button').addEventListener('click', () => {\n      if (gameState.isGameRunning) {\n        gameState.player.position.x += 1;\n        gameState.player.health -= 1;\n        gameState.player.score += 10;\n        gameState.progress.experience += 5;\n        gameState.progress.money += 5;\n        updateGame();\n      }\n    });\n\n    // Game loop\n    function updateGame() {\n      const gameContainer = document.querySelector('.game-container');\n      gameContainer.innerHTML = `\n        <h2>Game Loop</h2>\n        <p>Player position: ${gameState.player.position.x}, ${gameState.player.position.y}</p>\n        <p>Health: ${gameState.player.health}</p>\n        <p>Score: ${gameState.player.score}</p>\n        <p>Experience: ${gameState.progress.experience}</p>\n        <p>Money: ${gameState.progress.money}</p>\n        <button>Move Right</button>\n      `;\n    }\n\n    // Game state preservation\n    function saveGameState() {\n      localStorage.setItem('gameState', JSON.stringify(gameState));\n    }\n\n    // Game state restoration\n    function restoreGameState() {\n      if (localStorage.getItem('gameState')) {\n        gameState = JSON.parse(localStorage.getItem('gameState'));\n        updateGame();\n      }\n    }\n\n    // Game progression\n    function updateProgress() {\n      const level = gameState.progress.level;\n      const experience = gameState.progress.experience;\n      const money = gameState.progress.money;\n      const levelUpThreshold = 100;\n      const moneyPerLevel = 50;\n\n      if (experience >= levelUpThreshold) {\n        gameState.progress.level += 1;\n        gameState.progress.money += moneyPerLevel;\n      }\n    }\n\n    // Game failure/success\n    function checkGameStatus() {\n      if (gameState.player.health <= 0) {\n        alert(\"Game Over! You lost.\");\n        gameState.isGameRunning = false;\n      } else if (gameState.progress.experience >= 100) {\n        alert(\"Game Won! You reached level 10!\");\n        gameState.isGameRunning = false;\n      }\n    }\n\n    // Game restart\n    function restartGame() {\n      gameState = {\n        player: {\n          position: { x: 0, y: 0 },\n          inventory: [],\n          health: 100,\n          score: 0\n        },\n        enemies: [],\n        progress: {\n          level: 1,\n          experience: 0,\n          money: 0\n        },\n        isGameRunning: true\n      };\n      restoreGameState();\n      updateGame();\n    }\n\n    // Game loop\n    function gameLoop() {\n      updateProgress();\n      checkGameStatus();\n      updateGame();\n      requestAnimationFrame(gameLoop);\n    }\n\n    // Start game\n    gameLoop();\n  </script>\n</body>\n</html>"
