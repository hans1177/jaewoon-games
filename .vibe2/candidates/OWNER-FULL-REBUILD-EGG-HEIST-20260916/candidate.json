      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding: 20px;\n    }\n    h1 {\n      margin-bottom: 10px;\n    }\n    .game {\n      width: 100%;\n      max-width: 800px;\n      background: #111;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    .controls {\n      display: flex;\n      justify-content: space-between;\n      margin-bottom: 20px;\n    }\n    .controls button {\n      padding: 10px 15px;\n      font-size: 16px;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n      background-color: #333;\n      color: #fff;\n    }\n    .controls button:hover {\n      background-color: #555;\n    }\n    .status {\n      margin-bottom: 10px;\n      font-size: 14px;\n      color: #aaa;\n    }\n    .progress {\n      width: 100%;\n      background: #444;\n      border-radius: 4px;\n      overflow: hidden;\n      height: 20px;\n      margin-bottom: 20px;\n    }\n    .progress-bar {\n      height: 100%;\n      background: linear-gradient(to right, #ff4081, #00ccff);\n      width: 0%;\n      transition: width 0.2s ease;\n    }\n    .progress-bar-full {\n      width: 100%;\n    }\n    .message {\n      font-size: 16px;\n      margin-bottom: 10px;\n    }\n    .footer {\n      margin-top: 20px;\n      font-size: 14px;\n      color: #aaa;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"controls\">\n      <button class=\"start-button\" onclick=\"startGame()\">Start</button>\n      <button class=\"restart-button\" onclick=\"restartGame()\">Restart</button>\n    </div>\n    <div class=\"status\">\n      <div class=\"progress\">\n        <div class=\"progress-bar\" id=\"progressBar\"></div>\n      </div>\n      <div class=\"message\" id=\"gameMessage\"></div>\n    </div>\n    <div class=\"game\">\n      <h1>Vibe2</h1>\n      <p class=\"message\" id=\"gameDescription\">잠입→알 획득→위험 증가→추격→탈출의 실제 플레이 루프</p>\n      <div class=\"progress\">\n        <div class=\"progress-bar\" id=\"progressBar\"></div>\n      </div>\n    </div>\n    <div class=\"footer\">\n      <p>모바일 직접 조작과 명확한 피드백을 갖춘 다이내믹한 게임</p>\n    </div>\n  </main>\n  <script>\n    let game = null;\n    let progress = 0;\n    let message = null;\n\n    function startGame() {\n      game = {\n        progress: 0,\n        message: null,\n        gameDescription: \"잠입→알 획득→위험 증가→추격→탈출의 실제 플레이 루프\",\n        controls: {\n          startButton: document.querySelector('.start-button'),\n          restartButton: document.querySelector('.restart-button'),\n          progressBar: document.getElementById('progressBar'),\n          gameMessage: document.getElementById('gameMessage')\n        }\n      };\n      game.controls.startButton.disabled = false;\n      game.controls.startButton.style.backgroundColor = '#00ccff';\n      game.controls.startButton.style.color = '#fff';\n      game.controls.startButton.textContent = 'Start';\n      game.controls.startButton.onclick = () => {\n        game.message = game.gameDescription;\n        game.controls.startButton.disabled = true;\n        game.controls.startButton.style.backgroundColor = '#555';\n        game.controls.startButton.style.color = '#fff';\n        game.controls.startButton.textContent = 'Starting...';\n        game.controls.startButton.onclick = () => {\n          game.progress = 0;\n          game.message = game.gameDescription;\n          game.controls.progressBar.style.width = '0%';\n          game.controls.gameMessage.textContent = game.message;\n        };\n      };\n    }\n\n    function restartGame() {\n      game = {\n       