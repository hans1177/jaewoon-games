  "replaceFiles": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      background-color: #222;\n    }\n    h1 {\n      color: #fff;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div id=\"ui\">\n      <button id=\"start\">Start Game</button>\n      <div id=\"progression\">Progression: <span id=\"progress\">0</span>%</div>\n      <div id=\"economy\">Economy: <span id=\"economyValue\">0</span></div>\n      <div id=\"combat\">Combat: <span id=\"combatValue\">0</span></div>\n    </div>\n    <div id=\"gameArea\"></div>\n  </main>\n  <script>\n    // Protected state preservation\n    const protectedState = {\n      progression: 0,\n      economy: 0,\n      combat: 0,\n      gameArea: document.getElementById('gameArea')\n    };\n\n    // Game loop\n    function gameLoop() {\n      const progress = protectedState.progression;\n      const economy = protectedState.economy;\n      const combat = protectedState.combat;\n\n      document.getElementById('progress').textContent = progress;\n      document.getElementById('economyValue').textContent = economy;\n      document.getElementById('combatValue').textContent = combat;\n\n      // Game logic here\n      // Simulate game progression\n      protectedState.progression += 1;\n      protectedState.economy += 1;\n      protectedState.combat += 1;\n\n      // Check for game over\n      if (progress >= 100) {\n        alert('Game Over!');\n        window.location.reload();\n      }\n    }\n\n    // Start game\n    document.getElementById('start').addEventListener('click', () => {\n      protectedState.progression = 0;\n      protectedState.economy = 0;\n      protectedState.combat = 0;\n      document.getElementById('gameArea').innerHTML = '';\n      gameLoop();\n    });\n\n    // Restart game\n    document.getElementById('restart').addEventListener('click', () => {\n      protectedState.progression = 0;\n      protectedState.economy = 0;\n      protectedState.combat = 0;\n      document.getElementById('gameArea').innerHTML = '';\n      gameLoop();\n    });\n\n    // Mobile gameplay\n    document.addEventListener('touchstart', (e) => {\n      if (e.target.id === 'start') {\n        document.getElementById('start').textContent = 'Game Started';\n        document.getElementById('start').style.backgroundColor = '#4CAF50';\n      }\n    });\n\n    // Responsive layout\n    window.addEventListener('resize', () => {\n      if (window.innerWidth < 600) {\n        document.getElementById('game').style.margin = '20px';\n      } else {\n        document.getElementById('game').style.margin = '40px';\n      }\n    });\n  </script>\n</body>\n</html>"
    }
  ],
