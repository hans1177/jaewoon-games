      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #f0f0f0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      padding: 20px;\n      background-color: #fff;\n    }\n    h1 {\n      margin-bottom: 20px;\n    }\n    .game-container {\n      width: 100%;\n      max-width: 600px;\n      background-color: #fff;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n      transition: transform 0.2s;\n    }\n    .game-container:hover {\n      transform: scale(1.02);\n    }\n    .game-title {\n      font-size: 24px;\n      margin-bottom: 10px;\n    }\n    .game-description {\n      font-size: 16px;\n      color: #555;\n    }\n    .controls {\n      display: flex;\n      gap: 10px;\n      margin-bottom: 20px;\n    }\n    .controls button {\n      padding: 10px 15px;\n      font-size: 16px;\n      border: 1px solid #ccc;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background 0.2s;\n    }\n    .controls button:hover {\n      background-color: #e0e0e0;\n    }\n    .status {\n      font-size: 18px;\n      margin-bottom: 10px;\n      color: #333;\n    }\n    .score {\n      font-size: 20px;\n      font-weight: bold;\n      margin-bottom: 10px;\n    }\n    .progression {\n      font-size: 14px;\n      color: #666;\n    }\n    .restart-button {\n      padding: 10px 15px;\n      font-size: 16px;\n      background-color: #007bff;\n      color: white;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background 0.2s;\n    }\n    .restart-button:hover {\n      background-color: #0056b3;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"game-container\">\n      <h1 class=\"game-title\">Vibe2</h1>\n      <div class=\"game-description\">잠입→알 획득→위험 증가→추격→탈출의 실제 플레이 루프, 적 시야·추격, 단계별 위험, 성공·실패·재시작, 모바일 직접 조작과 명확한 피드백을 갖춘다.</div>\n      <div class=\"controls\">\n        <button class=\"restart-button\" onclick=\"restartGame()\">재시작</button>\n        <button onclick=\"startGame()\">시작</button>\n      </div>\n      <div class=\"status\">\n        <div class=\"score\">점수: <span id=\"score\">0</span></div>\n        <div class=\"progression\">진행: <span id=\"progression\">0%</span></div>\n      </div>\n    </div>\n  </main>\n  <script>\n    let score = 0;\n    let progression = 0;\n    let gameRunning = false;\n\n    function startGame() {\n      gameRunning = true;\n      score = 0;\n      progression = 0;\n      document.getElementById(\"score\").textContent = score;\n      document.getElementById(\"progression\").textContent = progression;\n    }\n\n    function restartGame() {\n      gameRunning = false;\n      score = 0;\n      progression = 0;\n      document.getElementById(\"score\").textContent = score;\n      document.getElementById(\"progression\").textContent = progression;\n    }\n\n    // Simulated game logic\n    function simulateGame() {\n      if (gameRunning) {\n        score += 1;\n        progression += 10;\n        document.getElementById(\"score\").textContent = score;\n        document.getElementById(\"progression\").textContent = progression;\n        if (progression >= 100) {\n          alert(\"성공!\");\n          gameRunning = false;\n        }\n      }\n    }\n\n    // Simulated player input\n    function playerInput() {\n      simulateGame();\n    }\n\n    // Simulated mobile input\n    function mobileInput() {\n      playerInput();\n    }\n\n    // Simulated touch input\n    function touchInput() {\n      playerInput();\n    }\n\n    // Simulated game state progression\n    function gameStateProgression() {\n      if (gameRunning) {\n        simulateGame();\n      }\n    }\n\n    // Simulated telemetry\n    function telemetry() {\n      console.log(\"Game telemetry: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated auto-player\n    function autoPlayer() {\n      if (gameRunning) {\n        simulateGame();\n      }\n    }\n\n    // Simulated design review\n    function designReview() {\n      console.log(\"Design review: game state =\", score, \"progression =\", progression);\n    }\n\n    // Simulated experience promotion\n    function experiencePromotion() {\n      console.log(\"Experience promotion: game state =\", score, \"progression =\", progression);\n    }\n\n    // Simulated save state persistence\n    function saveStatePersistence() {\n      console.log(\"Save state persistence: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated session retry gameover\n    function sessionRetryGameover() {\n      if (gameRunning) {\n        restartGame();\n      }\n    }\n\n    // Simulated tutorial on board\n    function tutorialOnBoard() {\n      console.log(\"Tutorial on board: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated board grid placement\n    function boardGridPlacement() {\n      console.log(\"Board grid placement: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated score combo reward\n    function scoreComboReward() {\n      console.log(\"Score combo reward: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated input drag touch\n    function inputDragTouch() {\n      console.log(\"Input drag touch: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated progression difficulty\n    function progressionDifficulty() {\n      console.log(\"Progression difficulty: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated save state persistence\n    function saveStatePersistence() {\n      console.log(\"Save state persistence: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated ads monetization\n    function adsMonetization() {\n      console.log(\"Ads monetization: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated session retry gameover\n    function sessionRetryGameover() {\n      if (gameRunning) {\n        restartGame();\n      }\n    }\n\n    // Simulated design intelligence contract\n    function designIntelligenceContract() {\n      console.log(\"Design intelligence contract: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated exploration handoff required before implementation\n    function explorationHandoffRequired() {\n      console.log(\"Exploration handoff required: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated auto-player evidence after implementation\n    function autoPlayerEvidenceAfterImplementation() {\n      console.log(\"Auto-player evidence after implementation: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated telemetry evidence after implementation\n    function telemetryEvidenceAfterImplementation() {\n      console.log(\"Telemetry evidence after implementation: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated performance sanity after implementation\n    function performanceSanityAfterImplementation() {\n      console.log(\"Performance sanity after implementation: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated fan-in regression before package review\n    function fanInRegressionBeforePackageReview() {\n      console.log(\"Fan-in regression before package review: score =\", score, \"progression =\", progression);\n    }\n\n    // Simulated design review before experience promotion\n    function designReviewBeforeExperiencePromotion() {\n      console.log(\"Design review before experience promotion: score =\", score, \"progression =\", progression);\n    }\n  </script>