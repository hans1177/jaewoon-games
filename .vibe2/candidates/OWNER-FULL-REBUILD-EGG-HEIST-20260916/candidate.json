      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      padding: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    h1 {\n      margin-bottom: 10px;\n    }\n    .game {\n      width: 100%;\n      max-width: 800px;\n      background: #111;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    .controls {\n      display: flex;\n      gap: 10px;\n      margin-bottom: 20px;\n    }\n    .controls button {\n      padding: 10px 15px;\n      background-color: #333;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background-color 0.3s;\n    }\n    .controls button:hover {\n      background-color: #555;\n    }\n    .status {\n      margin-top: 10px;\n      font-size: 0.9em;\n      color: #aaa;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"game\">\n      <h1>Vibe2</h1>\n      <div class=\"controls\">\n        <button onclick=\"startGame()\">Start</button>\n        <button onclick=\"restartGame()\">Restart</button>\n      </div>\n      <div class=\"status\" id=\"status\">Ready</div>\n      <div id=\"gameArea\"></div>\n    </div>\n  </main>\n  <script>\n    let gameArea = document.getElementById('gameArea');\n    let status = document.getElementById('status');\n    let game = null;\n\n    function startGame() {\n      status.textContent = 'Initializing...';\n      game = {\n        area: gameArea,\n        status: 'Ready',\n        progress: 0,\n        isRunning: false,\n        isRestarted: false\n      };\n      gameArea.innerHTML = '';\n      status.textContent = 'Initializing...';\n      // Simulate game initialization\n      setTimeout(() => {\n        status.textContent = 'Game Initialized';\n        gameArea.innerHTML = '<p>Game initialized. Ready for play.</p>';\n      }, 1000);\n    }\n\n    function restartGame() {\n      if (game) {\n        game.isRestarted = true;\n        status.textContent = 'Restarting...';\n        setTimeout(() => {\n          status.textContent = 'Game Restarted';\n          gameArea.innerHTML = '<p>Game restarted. Ready for play.</p>';\n        }, 1000);\n      }\n    }\n\n    // Simulate game loop\n    function gameLoop() {\n      if (!game || !game.isRunning) return;\n\n      game.progress += 0.1;\n      if (game.progress >= 1) {\n        game.isRunning = false;\n        status.textContent = 'Game Over';\n        gameArea.innerHTML = '<p>Game over. Try again.</p>';\n      } else {\n        gameArea.innerHTML = `<p>Progress: ${game.progress.toFixed(2)}</p>`;\n      }\n      requestAnimationFrame(gameLoop);\n    }\n\n    gameLoop();\n  </script>\n</body>\n</html>"
    }
