      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      padding: 20px;\n      background-color: #111;\n      min-height: 100vh;\n    }\n    h1 {\n      text-align: center;\n      margin-bottom: 20px;\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n    }\n    .game-container > div {\n      width: 80%;\n      max-width: 600px;\n      background-color: #333;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0,0,0,0.5);\n    }\n    .game-container > div > h2 {\n      margin-bottom: 10px;\n    }\n    .game-container > div > p {\n      margin-bottom: 15px;\n    }\n    .game-container > div > button {\n      background-color: #555;\n      color: #fff;\n      border: none;\n      padding: 10px 20px;\n      border-radius: 4px;\n      cursor: pointer;\n      font-size: 16px;\n    }\n    .game-container > div > button:hover {\n      background-color: #777;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\"></main>\n  <script>\n    // Protected state preservation\n    let gameState = {\n      player: {\n        position: { x: 0, y: 0 },\n        inventory: [],\n        health: 100,\n        score: 0\n      },\n      enemies: [],\n      progress: 0,\n      isGameOver: false\n    };\n\n    // Direct player input\n    const gameContainer = document.createElement('div');\n    gameContainer.className = 'game-container';\n    document.body.appendChild(gameContainer);\n\n    // Game loop\n    function gameLoop() {\n      if (gameState.isGameOver) return;\n\n      // Game logic here\n      gameState.progress += 0.1;\n\n      // UI updates\n      gameContainer.innerHTML = `\n        <h2>Game Progress: ${gameState.progress.toFixed(2)}</h2>\n        <p>Player Health: ${gameState.player.health}</p>\n        <p>Score: ${gameState.player.score}</p>\n        <button onclick=\"movePlayer()\">Move</button>\n      `;\n\n      // Check for game over\n      if (gameState.progress >= 1.0) {\n        gameState.isGameOver = true;\n        gameContainer.innerHTML += `<p>Game Over!</p>`;\n      }\n    }\n\n    // Game initialization\n    function initGame() {\n      // Initialize game state\n      gameState.player = {\n        position: { x: 0, y: 0 },\n        inventory: [],\n        health: 100,\n        score: 0\n      };\n      gameState.enemies = [];\n      gameState.progress = 0;\n      gameState.isGameOver = false;\n\n      // Start game loop\n      gameLoop();\n    }\n\n    // Start game\n    initGame();\n  </script>\n</body>\n</html>"
