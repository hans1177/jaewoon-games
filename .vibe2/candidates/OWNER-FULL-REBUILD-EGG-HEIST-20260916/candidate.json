on.onclick = () => {\n        game.message = game.gameDescription;\n        game.controls.startButton.disabled = true;\n        game.controls.startButton.style.backgroundColor = '#555';\n        game.controls.startButton.style.color = '#fff';\n        game.controls.startButton.textContent = 'Starting...';\n        game.controls.startButton.onclick = () => {\n          game.progress = 0;\n          game.message = game.gameDescription;\n          game.controls.progressBar.style.width = '0%';\n          game.controls.gameMessage.textContent = game.message;\n        };\n      };\n    });\n  </script>\n</body>\n</html>"
