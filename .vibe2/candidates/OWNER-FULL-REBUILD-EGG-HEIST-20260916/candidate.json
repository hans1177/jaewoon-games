      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #f0f0f0;\n    }\n    main {\n      padding: 20px;\n      background-color: #fff;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0,0,0,0.1);\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n    }\n    .game-container h1 {\n      margin-bottom: 20px;\n      font-size: 24px;\n      color: #333;\n    }\n    .game-container p {\n      font-size: 16px;\n      color: #555;\n    }\n    .game-container button {\n      margin-top: 10px;\n      padding: 10px 20px;\n      font-size: 16px;\n      border: none;\n      border-radius: 4px;\n      background-color: #007BFF;\n      color: white;\n      cursor: pointer;\n    }\n    .game-container button:hover {\n      background-color: #0056b3;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"game-container\">\n    <h1>Vibe2</h1>\n    <p>잠입 → 알 획득 → 위험 증가 → 추격 → 탈출의 실제 플레이 루프</p>\n    <button onclick=\"startGame()\">시작</button>\n  </main>\n\n  <script>\n    function startGame() {\n      const gameContainer = document.getElementById('game');\n      gameContainer.innerHTML = `\n        <div class=\"game-step\">\n          <h2>잠입</h2>\n          <p>잠입을 위해 위치를 선택하세요.</p>\n          <button onclick=\"selectLocation('잠입')\">잠입</button>\n        </div>\n        <div class=\"game-step\">\n          <h2>알 획득</h2>\n          <p>알을 획득하세요.</p>\n          <button onclick=\"gainItem('알')\">알 획득</button>\n        </div>\n        <div class=\"game-step\">\n          <h2>위험 증가</h2>\n          <p>위험을 증가시켜야 합니다.</p>\n          <button onclick=\"increaseRisk()\">위험 증가</button>\n        </div>\n        <div class=\"game-step\">\n          <h2>추격</h2>\n          <p>추격을 시작하세요.</p>\n          <button onclick=\"startChase()\">추격</button>\n        </div>\n        <div class=\"game-step\">\n          <h2>탈출</h2>\n          <p>탈출을 성공적으로 수행하세요.</p>\n          <button onclick=\"escape()\">탈출</button>\n        </div>\n      `;\n    }\n\n    function selectLocation(location) {\n      document.getElementById('game').innerHTML = `\n        <div class=\"game-step\">\n          <h2>잠입</h2>\n          <p>선택된 위치: ${location}</p>\n          <button onclick=\"startGame()\">시작</button>\n        </div>\n      `;\n    }\n\n    function gainItem(item) {\n      document.getElementById('game').innerHTML = `\n        <div class=\"game-step\">\n          <h2>알 획득</h2>\n          <p>획득된 알: ${item}</p>\n          <button onclick=\"startGame()\">시작</button>\n        </div>\n      `;\n    }\n\n    function increaseRisk() {\n      document.getElementById('game').innerHTML = `\n        <div class=\"game-step\">\n          <h2>위험 증가</h2>\n          <p>위험을 증가시켰습니다.</p>\n          <button onclick=\"startGame()\">시작</button>\n        </div>\n      `;\n    }\n\n    function startChase() {\n      document.getElementById('game').innerHTML = `\n        <div class=\"game-step\">\n          <h2>추격</h2>\n          <p>추격을 시작했습니다.</p>\n          <button onclick=\"startGame()\">시작</button>\n        </div>\n      `;\n    }\n\n    function escape() {\n      document.getElementById('game').innerHTML = `\n        <div class=\"game-step\">\n          <h2>탈출</h2>\n          <p>탈출을 성공적으로 수행했습니다.</p>\n          <button onclick=\"startGame()\">시작</button>\n        </div>\n      `;\n    }\n  </script>\n</body>\n</html>"
    }
