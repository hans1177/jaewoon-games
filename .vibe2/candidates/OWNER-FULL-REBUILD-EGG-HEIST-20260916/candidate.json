      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      color: #fff;\n    }\n    h1 {\n      margin-top: 20px;\n    }\n    #game {\n      width: 100%;\n      max-width: 800px;\n      background: #111;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    .controls {\n      display: flex;\n      gap: 10px;\n      margin-top: 10px;\n    }\n    .controls button {\n      padding: 10px 15px;\n      font-size: 16px;\n      border: none;\n      border-radius: 4px;\n      background-color: #333;\n      color: #fff;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #555;\n    }\n    .status {\n      margin-top: 10px;\n      font-size: 14px;\n      color: #aaa;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div class=\"controls\">\n      <button onclick=\"startGame()\">Start Game</button>\n      <button onclick=\"restartGame()\">Restart</button>\n    </div>\n    <div class=\"status\">Status: <span id=\"status\">Initializing...</span></div>\n    <div class=\"status\">Progression: <span id=\"progression\">0%</span></div>\n    <div class=\"status\">Economy: <span id=\"economy\">0</span></div>\n    <div class=\"status\">UI: <span id=\"ui\">0</span></div>\n  </main>\n  <script>\n    let game = null;\n    let status = \"Initializing...\";\n    let progression = 0;\n    let economy = 0;\n    let ui = 0;\n\n    function startGame() {\n      game = {\n        status: status,\n        progression: progression,\n        economy: economy,\n        ui: ui\n      };\n      document.getElementById(\"status\").textContent = status;\n      document.getElementById(\"progression\").textContent = progression + \"%\";\n      document.getElementById(\"economy\").textContent = economy;\n      document.getElementById(\"ui\").textContent = ui;\n    }\n\n    function restartGame() {\n      progression = 0;\n      economy = 0;\n      ui = 0;\n      status = \"Initializing...\";\n      document.getElementById(\"status\").textContent = status;\n      document.getElementById(\"progression\").textContent = progression + \"%\";\n      document.getElementById(\"economy\").textContent = economy;\n      document.getElementById(\"ui\").textContent = ui;\n    }\n\n    // Simulated game logic\n    function simulateGame() {\n      // Simulate game progression\n      progression += 1;\n      economy += 1;\n      ui += 1;\n\n      // Simulate UI updates\n      document.getElementById(\"status\").textContent = \"Status: \" + status;\n      document.getElementById(\"progression\").textContent = progression + \"%\";\n      document.getElementById(\"economy\").textContent = economy;\n      document.getElementById(\"ui\").textContent = ui;\n    }\n\n    // Simulate game loop\n    function gameLoop() {\n      simulateGame();\n      setTimeout(gameLoop, 1000);\n    }\n\n    // Start the game loop\n    gameLoop();\n  </script>\n</body>\n</html>"
