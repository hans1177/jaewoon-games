      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      padding: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    h1 {\n      margin-bottom: 10px;\n    }\n    .game {\n      width: 100%;\n      max-width: 800px;\n      background: #111;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    .controls {\n      display: flex;\n      gap: 10px;\n      margin-bottom: 20px;\n    }\n    .controls button {\n      padding: 10px 15px;\n      font-size: 16px;\n      border: none;\n      border-radius: 4px;\n      background-color: #333;\n      color: #fff;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #555;\n    }\n    .status {\n      margin-top: 10px;\n      font-size: 14px;\n      color: #aaa;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"game\">\n      <h1>Vibe2</h1>\n      <div class=\"controls\">\n        <button onclick=\"startGame()\">Start Game</button>\n        <button onclick=\"restartGame()\">Restart</button>\n      </div>\n      <div class=\"status\" id=\"status\">Ready</div>\n      <div class=\"status\" id=\"progression\">Progression: 0%</div>\n      <div class=\"status\" id=\"ui\">UI: Basic</div>\n      <div class=\"status\" id=\"economy\">Economy: Basic</div>\n      <div class=\"status\" id=\"combat\">Combat: Basic</div>\n      <div class=\"status\" id=\"movement\">Movement: Basic</div>\n      <div class=\"status\" id=\"ai\">AI: Basic</div>\n    </div>\n  </main>\n  <script>\n    let game = null;\n    let state = {\n      progression: 0,\n      ui: \"Basic\",\n      economy: \"Basic\",\n      combat: \"Basic\",\n      movement: \"Basic\",\n      ai: \"Basic\",\n      status: \"Ready\"\n    };\n\n    function startGame() {\n      game = new Game();\n      game.init();\n      updateStatus();\n    }\n\n    function restartGame() {\n      game = null;\n      state = {\n        progression: 0,\n        ui: \"Basic\",\n        economy: \"Basic\",\n        combat: \"Basic\",\n        movement: \"Basic\",\n        ai: \"Basic\",\n        status: \"Ready\"\n      };\n      updateStatus();\n    }\n\n    function updateStatus() {\n      document.getElementById(\"progression\").textContent = state.progression + \"%\";\n      document.getElementById(\"ui\").textContent = state.ui;\n      document.getElementById(\"economy\").textContent = state.economy;\n      document.getElementById(\"combat\").textContent = state.combat;\n      document.getElementById(\"movement\").textContent = state.movement;\n      document.getElementById(\"ai\").textContent = state.ai;\n      document.getElementById(\"status\").textContent = state.status;\n    }\n\n    function Game() {\n      this.progression = 0;\n      this.ui = \"Basic\";\n      this.economy = \"Basic\";\n      this.combat = \"Basic\";\n      this.movement = \"Basic\";\n      this.ai = \"Basic\";\n      this.status = \"Ready\";\n      this.init();\n    }\n\n    Game.prototype.init = function() {\n      // Initialize game logic here\n      this.progression = 0;\n      this.ui = \"Basic\";\n      this.economy = \"Basic\";\n      this.combat = \"Basic\";\n      this.movement = \"Basic\";\n      this.ai = \"Basic\";\n      this.status = \"Ready\";\n    };\n\n    // Game logic here\n  </script>\n</body>\n</html>"
