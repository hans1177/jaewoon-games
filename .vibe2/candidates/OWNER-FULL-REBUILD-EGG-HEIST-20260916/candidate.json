      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      padding: 20px;\n      background-color: #111;\n      min-height: 100vh;\n    }\n    h1 {\n      text-align: center;\n      margin-bottom: 20px;\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n    }\n    .game-container > div {\n      width: 100%;\n      max-width: 600px;\n      background-color: #333;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    .game-container > div > h2 {\n      margin-bottom: 10px;\n    }\n    .game-container > div > p {\n      margin-bottom: 20px;\n    }\n    .game-container > div > button {\n      background-color: #555;\n      color: #fff;\n      border: none;\n      padding: 10px 20px;\n      font-size: 16px;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background-color 0.3s;\n    }\n    .game-container > div > button:hover {\n      background-color: #777;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\"></main>\n  <script>\n    // Protected state preservation\n    const protectedState = {\n      player: {\n        name: \"Player\",\n        health: 100,\n        inventory: [],\n        progress: 0\n      },\n      game: {\n        title: \"Vibe2\",\n        difficulty: \"easy\",\n        state: \"start\"\n      }\n    };\n\n    // Full gameplay loop\n    function startGame() {\n      const gameContainer = document.querySelector('.game-container');\n      gameContainer.innerHTML = `\n        <h1>Vibe2</h1>\n        <div>\n          <h2>잠입</h2>\n          <p>잠입을 통해 알을 획득하세요.</p>\n          <button onclick=\"startAlStealing()\">알 획득</button>\n        </div>\n        <div>\n          <h2>위험 증가</h2>\n          <p>위험을 줄이기 위해 조치를 취하세요.</p>\n          <button onclick=\"increaseRisk()\">위험 증가</button>\n        </div>\n        <div>\n          <h2>추격</h2>\n          <p>추격을 방지하기 위해 조치를 취하세요.</p>\n          <button onclick=\"preventChase()\">추격 방지</button>\n        </div>\n        <div>\n          <h2>탈출</h2>\n          <p>탈출을 위해 조치를 취하세요.</p>\n          <button onclick=\"escape()\">탈출</button>\n        </div>\n      `;\n    }\n\n    function startAlStealing() {\n      protectedState.player.inventory.push(\"알\");\n      protectedState.game.state = \"al_stealing\";\n    }\n\n    function increaseRisk() {\n      protectedState.player.health -= 10;\n      protectedState.game.state = \"risk_increase\";\n    }\n\n    function preventChase() {\n      protectedState.game.state = \"chase_prevention\";\n    }\n\n    function escape() {\n      protectedState.player.health = 100;\n      protectedState.game.state = \"escape\";\n    }\n\n    // Direct player input\n    document.querySelector('button').addEventListener('click', function() {\n      const button = this;\n      const action = button.textContent;\n      if (action === \"알 획득\") {\n        startAlStealing();\n      } else if (action === \"위험 증가\") {\n        increaseRisk();\n      } else if (action === \"추격 방지\") {\n        preventChase();\n      } else if (action === \"탈출\") {\n        escape();\n      }\n    });\n\n    // Protected state preservation\n    if (protectedState.game.state === \"start\") {\n      startGame();\n    }\n  </script>\n</body>\n</html>"
    }
