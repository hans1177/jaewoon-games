  "replaceFiles": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>수정의 개화</title>\n  <style>\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background-color: #1e1e1e;\n      color: #ffffff;\n      margin: 0;\n      padding: 0;\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      text-align: center;\n    }\n    .game-title {\n      font-size: 2.5em;\n      margin-bottom: 20px;\n    }\n    .game-description {\n      font-size: 1.2em;\n      max-width: 600px;\n    }\n    .controls {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n      margin-top: 20px;\n    }\n    .control {\n      padding: 10px 15px;\n      background-color: #2e2e2e;\n      border: 1px solid #444;\n      border-radius: 8px;\n      font-size: 1em;\n      width: 120px;\n      text-align: center;\n      cursor: pointer;\n      transition: background-color 0.2s;\n    }\n    .control:hover {\n      background-color: #3e3e3e;\n    }\n    .status {\n      margin-top: 20px;\n      font-size: 1em;\n      color: #ffcc00;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"game-container\">\n    <div class=\"game-title\">수정의 개화</div>\n    <div class=\"game-description\">전투로 골드를 얻고 장비를 강화하며 수정 군주 10단계를 돌파하는 방치 성장 RPG.</div>\n    <div class=\"controls\">\n      <div class=\"control\" onclick=\"startCombat()\">전투 시작</div>\n      <div class=\"control\" onclick=\"startProgression()\">진행 시작</div>\n      <div class=\"control\" onclick=\"restartGame()\">재시작</div>\n    </div>\n    <div class=\"status\">HP: 100 | 골드: 0 | 강화: 0</div>\n  </div>\n  <script>\n    let game = {\n      id: 'seed-idle-growth-rpg-crystal-bloom',\n      name: '수정의 개화',\n      mode: 'crystal-idle',\n      hp: 100,\n      gold: 0,\n      level: 0,\n      equipment: [],\n      progress: {\n        current: 0,\n        target: 10\n      },\n      status: {\n        hp: 100,\n        gold: 0,\n        level: 0,\n        equipment: []\n      },\n      combat: {\n        active: false,\n        current: 0,\n        target: 10\n      },\n      restart: function() {\n        this.status.hp = 100;\n        this.status.gold = 0;\n        this.status.level = 0;\n        this.status.equipment = [];\n        this.combat.active = false;\n        this.combat.current = 0;\n        this.combat.target = 10;\n        this.progress.current = 0;\n        this.progress.target = 10;\n      },\n      startCombat: function() {\n        if (!this.combat.active) {\n          this.combat.active = true;\n          this.combat.current = 1;\n          this.combat.target = 10;\n          this.status.gold += 10;\n          this.status.hp -= 10;\n          this.status.level += 1;\n          this.status.equipment.push('장비1');\n        }\n      },\n      startProgression: function() {\n        if (!this.progress.active) {\n          this.progress.active = true;\n          this.progress.current = 1;\n          this.progress.target = 10;\n          this.status.gold += 5;\n          this.status.hp -= 5;\n          this.status.level += 1;\n          this.status.equipment.push('장비2');\n        }\n      }\n    };\n\n    function updateStatus() {\n      document.querySelector('.status').textContent = `HP: ${game.status.hp} | 골드: ${game.status.gold} | 강화: ${game.status.equipment.length}`;\n    }\n\n    function updateControls() {\n      const controls = document.querySelector('.controls');\n      controls.innerHTML = '';\n      game.status.equipment.forEach((item, index) => {\n        const control = document.createElement('div');\n        control.className = 'control';\n        control.textContent = index + 1 + '. ' + item;\n        control.onclick = () => {\n          if (index < game.status.equipment.length - 1) {\n            game.status.equipment.splice(index + 1, 1);\n          } else {\n            game.status.equipment.splice(index, 1);\n          }\n        };\n        controls.appendChild(control);\n      });\n    }\n\n    function updateGame() {\n      updateStatus();\n      updateControls();\n    }\n\n    function startCombat() {\n      game.startCombat();\n      updateGame();\n    }\n\n    function startProgression() {\n      game.startProgression();\n      updateGame();\n    }\n\n    function restartGame() {\n      game.restart();\n      updateGame();\n    }\n\n    // Initial setup\n    updateGame();\n  </script>\n</body>\n</html>"
    }
  ],
  "tests": [
    "mobile gameplay",
