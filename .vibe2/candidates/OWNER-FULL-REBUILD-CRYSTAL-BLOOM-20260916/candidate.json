      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>수정의 개화</title>\n  <link rel=\"stylesheet\" href=\"/web-games/_shared/styles.css\">\n</head>\n<body>\n  <script>\n    window.GAME_CONFIG = {\n      id: 'seed-idle-growth-rpg-crystal-bloom',\n      name: '수정의 개화',\n      mode: 'crystal-idle',\n      hp: 100,\n      desc: '전투로 골드를 얻고 장비를 강화하며 수정 군주 10단계를 돌파하는 방치 성장 RPG.'\n    };\n\n    // Initialize game state\n    let player = {\n      hp: 100,\n      gold: 0,\n      level: 1,\n      equipment: [],\n      progress: 0,\n      isRestarting: false\n    };\n\n    // Game loop\n    function gameLoop() {\n      if (player.isRestarting) {\n        player.hp = 100;\n        player.gold = 0;\n        player.level = 1;\n        player.equipment = [];\n        player.progress = 0;\n        player.isRestarting = false;\n      }\n\n      // Progression system\n      player.progress += 0.01;\n      if (player.progress >= 10) {\n        player.level += 1;\n        player.progress = 0;\n      }\n\n      // UI system\n      document.getElementById('hp').innerText = player.hp;\n      document.getElementById('gold').innerText = player.gold;\n      document.getElementById('level').innerText = player.level;\n      document.getElementById('progress').innerText = player.progress.toFixed(2);\n\n      // Combat system\n      if (Math.random() < 0.1) {\n        player.gold += 10;\n        player.equipment.push('Gold Sword');\n      }\n\n      // Restart system\n      if (player.progress >= 10) {\n        player.isRestarting = true;\n      }\n\n      // Save system\n      if (player.isRestarting) {\n        localStorage.setItem('player', JSON.stringify(player));\n      }\n\n      // Game loop update\n      requestAnimationFrame(gameLoop);\n    }\n\n    // Start game loop\n    gameLoop();\n  </script>\n  <div id=\"game-container\">\n    <div id=\"hp\">100</div>\n    <div id=\"gold\">0</div>\n    <div id=\"level\">1</div>\n    <div id=\"progress\">0.00</div>\n    <div id=\"equipment\">[]</div>\n    <div id=\"status\">Progress: 0.00</div>\n  </div>\n  <script src=\"/web-games/_shared/vibe2-final.js\"></script>\n</body>\n</html>"
