      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>수정의 개화</title>\n  <link rel=\"stylesheet\" href=\"/web-games/_shared/styles.css\">\n</head>\n<body>\n  <script>\n    window.GAME_CONFIG = {\n      id: 'seed-idle-growth-rpg-crystal-bloom',\n      name: '수정의 개화',\n      mode: 'crystal-idle',\n      hp: 100,\n      desc: '전투로 골드를 얻고 장비를 강화하며 수정 군주 10단계를 돌파하는 방치 성장 RPG.'\n    };\n\n    // Initialize game state\n    let player = {\n      hp: window.GAME_CONFIG.hp,\n      gold: 0,\n      level: 1,\n      equipment: [],\n      progress: {\n        stage: 1,\n        target: 10\n      },\n      inventory: []\n    };\n\n    // Game loop\n    function gameLoop() {\n      // Check for progress\n      if (player.progress.stage === player.progress.target) {\n        alert('수정 군주 10단계를 돌파했습니다!');\n        player.progress.stage = 11;\n      }\n\n      // Handle input\n      const input = document.getElementById('input');\n      if (input) {\n        const action = input.value.trim();\n        if (action) {\n          // Process action\n          processAction(action);\n        }\n      }\n\n      // Update UI\n      updateUI();\n\n      // Request next frame\n      requestAnimationFrame(gameLoop);\n    }\n\n    // Process action\n    function processAction(action) {\n      // Handle action logic\n      // Example: collect gold, upgrade equipment, etc.\n      if (action === 'collect_gold') {\n        player.gold += 10;\n        alert('골드를 10개 수집했습니다!');\n      } else if (action === 'upgrade_equipment') {\n        // Logic to upgrade equipment\n        alert('장비를 강화했습니다!');\n      }\n    }\n\n    // Update UI\n    function updateUI() {\n      document.getElementById('hp').innerText = player.hp;\n      document.getElementById('gold').innerText = player.gold;\n      document.getElementById('level').innerText = player.level;\n      document.getElementById('progress').innerText = `현재 단계: ${player.progress.stage} / ${player.progress.target}`;\n    }\n\n    // Initialize game\n    window.addEventListener('load', gameLoop);\n  </script>\n  <div id=\"input\">\n    <input type=\"text\" placeholder=\"입력하세요\">\n  </div>\n  <div id=\"hp\">100</div>\n  <div id=\"gold\">0</div>\n  <div id=\"level\">1</div>\n  <div id=\"progress\">현재 단계: 1 / 10</div>\n</body>\n</html>"
