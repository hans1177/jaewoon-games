      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>수정의 개화</title>\n  <link rel=\"stylesheet\" href=\"/web-games/_shared/styles.css\">\n</head>\n<body>\n  <script>\n    window.GAME_CONFIG = {\n      id: 'seed-idle-growth-rpg-crystal-bloom',\n      name: '수정의 개화',\n      mode: 'crystal-idle',\n      hp: 100,\n      desc: '전투로 골드를 얻고 장비를 강화하며 수정 군주 10단계를 돌파하는 방치 성장 RPG.'\n    };\n\n    // Initialize game state\n    let player = {\n      hp: window.GAME_CONFIG.hp,\n      gold: 0,\n      level: 1,\n      equipment: [],\n      progress: 0,\n      isRestarted: false\n    };\n\n    // Game loop\n    function gameLoop() {\n      if (player.isRestarted) {\n        player.hp = window.GAME_CONFIG.hp;\n        player.gold = 0;\n        player.level = 1;\n        player.equipment = [];\n        player.progress = 0;\n        player.isRestarted = false;\n      }\n\n      // Progression system\n      player.progress += 0.01;\n      if (player.progress >= 10) {\n        player.level += 1;\n        player.progress = 0;\n      }\n\n      // Combat system\n      const enemy = {\n        hp: 100,\n        damage: 10\n      };\n\n      // Simulate combat\n      while (player.hp > 0 && enemy.hp > 0) {\n        player.hp -= enemy.damage;\n        enemy.hp -= player.damage;\n      }\n\n      // Reward system\n      if (player.gold < 100) {\n        player.gold += 10;\n      }\n\n      // UI system\n      const ui = document.getElementById('ui');\n      ui.innerHTML = `\n        <h1>수정의 개화</h1>\n        <p>현재 레벨: ${player.level}</p>\n        <p>현재 HP: ${player.hp}</p>\n        <p>금액: ${player.gold}</p>\n        <p>진행: ${player.progress.toFixed(2)} 단계</p>\n        <button onclick=\"restartGame()\">재시작</button>\n      `;\n\n      // Auto combat\n      if (Math.random() < 0.1) {\n        const enemy = {\n          hp: 100,\n          damage: 15\n        };\n        while (player.hp > 0 && enemy.hp > 0) {\n          player.hp -= enemy.damage;\n          enemy.hp -= player.damage;\n        }\n      }\n\n      // Save system\n      if (player.isRestarted) {\n        localStorage.setItem('player', JSON.stringify(player));\n      }\n    }\n\n    // Start game\n    gameLoop();\n  </script>\n</body>\n</html>"
    }
