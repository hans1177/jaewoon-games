      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>수정의 개화</title>\n  <style>\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background-color: #1e1e1e;\n      color: #ffffff;\n      margin: 0;\n      padding: 0;\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      padding: 20px;\n      background-color: #1e1e1e;\n    }\n    .game-title {\n      font-size: 2.5em;\n      margin-bottom: 20px;\n    }\n    .game-description {\n      font-size: 1.2em;\n      max-width: 600px;\n      text-align: center;\n    }\n    .game-buttons {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n      justify-content: center;\n      margin-top: 20px;\n    }\n    .game-button {\n      padding: 15px 25px;\n      font-size: 1em;\n      border: none;\n      border-radius: 8px;\n      background-color: #08111b;\n      color: #ffffff;\n      cursor: pointer;\n      transition: background-color 0.3s;\n    }\n    .game-button:hover {\n      background-color: #041a2d;\n    }\n    .game-stats {\n      margin-top: 20px;\n      font-size: 1em;\n      text-align: center;\n    }\n    .game-stats span {\n      display: inline-block;\n      margin: 0 10px;\n    }\n    .game-stats .hp {\n      color: #ff4d4d;\n    }\n    .game-stats .gold {\n      color: #ffcc00;\n    }\n    .game-stats .level {\n      color: #00ffcc;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"game-container\">\n    <div class=\"game-title\">수정의 개화</div>\n    <div class=\"game-description\">\n      전투로 골드를 얻고 장비를 강화하며 수정 군주 10단계를 돌파하는 방치 성장 RPG.\n    </div>\n    <div class=\"game-buttons\">\n      <button class=\"game-button\" onclick=\"startGame()\">시작</button>\n      <button class=\"game-button\" onclick=\"restartGame()\">재시작</button>\n    </div>\n    <div class=\"game-stats\">\n      <span class=\"hp\">HP: <span id=\"hp\">100</span></span>\n      <span class=\"gold\">골드: <span id=\"gold\">0</span></span>\n      <span class=\"level\">레벨: <span id=\"level\">1</span></span>\n    </div>\n  </div>\n  <script>\n    let game = {\n      hp: 100,\n      gold: 0,\n      level: 1,\n      currentStep: 1,\n      steps: [\n        { name: '초기', description: '방치 상태로 시작합니다.' },\n        { name: '적·단계', description: '적·단계를 통과해야 합니다.' },\n        { name: '보스', description: '보스를 꺼내야 합니다.' },\n        { name: '목표', description: '수정 군주 10단계를 돌파해야 합니다.' }\n      ],\n      progress: 0,\n      isRunning: false,\n      isRestarted: false,\n      isPaused: false,\n      isGameOver: false,\n      isVictory: false,\n      isDefeated: false\n    };\n\n    function startGame() {\n      game.isRunning = true;\n      game.isRestarted = false;\n      game.isPaused = false;\n      game.isGameOver = false;\n      game.isVictory = false;\n      game.isDefeated = false;\n      game.progress = 0;\n      game.currentStep = 1;\n      game.updateUI();\n    }\n\n    function restartGame() {\n      game.isRunning = false;\n      game.isRestarted = true;\n      game.isPaused = false;\n      game.isGameOver = false;\n      game.isVictory = false;\n      game.isDefeated = false;\n      game.progress = 0;\n      game.currentStep = 1;\n      game.updateUI();\n    }\n\n    function updateUI() {\n      document.getElementById('hp').textContent = game.hp;\n      document.getElementById('gold').textContent = game.gold;\n      document.getElementById('level').textContent = game.level;\n    }\n\n    function handleInput(event) {\n      if (game.isRunning) {\n        if (event.type === 'click' && event.target && event.target.classList.contains('game-button')) {\n          if (event.target.textContent === '시작') {\n            startGame();\n          } else if (event.target.textContent === '재시작') {\n            restartGame();\n          }\n        }\n      }\n    }\n\n    document.addEventListener('touchstart', handleInput);\n    document.addEventListener('click', handleInput);\n  </script>\n</body>\n</html>"
    }
