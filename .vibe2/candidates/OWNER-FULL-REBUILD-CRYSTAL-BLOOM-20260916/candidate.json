  "replaceFiles": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>수정의 개화</title>\n  <style>\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background-color: #1e1e1e;\n      color: #ffffff;\n      margin: 0;\n      padding: 0;\n    }\n    header {\n      background-color: #08111b;\n      padding: 1rem;\n      text-align: center;\n    }\n    header h1 {\n      margin: 0;\n      font-size: 1.5rem;\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      padding: 2rem;\n    }\n    .game-container > div {\n      width: 90%;\n      max-width: 600px;\n      background-color: #2e2e2e;\n      padding: 1rem;\n      border-radius: 8px;\n      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n      text-align: center;\n    }\n    .game-container > div > h2 {\n      margin-bottom: 0.5rem;\n    }\n    .game-container > div > p {\n      margin-bottom: 1rem;\n    }\n    .controls {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 1rem;\n      justify-content: center;\n      margin-top: 1rem;\n    }\n    .controls button {\n      padding: 0.75rem 1.5rem;\n      font-size: 1rem;\n      border: 1px solid #ffffff;\n      background-color: #08111b;\n      color: #ffffff;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background-color 0.2s;\n    }\n    .controls button:hover {\n      background-color: #061a2d;\n    }\n    .status {\n      margin-top: 1rem;\n      font-size: 0.9rem;\n      color: #888;\n    }\n    .progress {\n      margin-top: 1rem;\n      font-size: 0.9rem;\n      color: #00ffcc;\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>수정의 개화</h1>\n  </header>\n  <div class=\"game-container\">\n    <div>\n      <h2>성장의 방치 RPG</h2>\n      <p>전투로 골드를 얻고 장비를 강화하며 수정 군주 10단계를 돌파하는 방치 성장 RPG.</p>\n      <div class=\"controls\">\n        <button onclick=\"startGame()\">시작</button>\n        <button onclick=\"restartGame()\">재시작</button>\n      </div>\n      <div class=\"status\">현재 HP: <span id=\"currentHp\">100</span></div>\n      <div class=\"progress\">성장 단계: <span id=\"growthStage\">1</span>/10</div>\n    </div>\n  </div>\n  <script>\n    let game = {\n      hp: 100,\n      growthStage: 1,\n      currentHp: 100,\n      isRunning: false,\n      isRestarted: false,\n      growthProgress: 0,\n      growthTarget: 10,\n      growthReward: 0,\n      growthSpeed: 1,\n      growthMultiplier: 1,\n      isPaused: false,\n      isGameOver: false,\n      isSaved: false\n    };\n\n    function startGame() {\n      if (!game.isRunning) {\n        game.isRunning = true;\n        game.isPaused = false;\n        game.isGameOver = false;\n        game.isSaved = false;\n        game.growthProgress = 0;\n        game.growthTarget = 10;\n        game.growthReward = 0;\n        game.growthSpeed = 1;\n        game.growthMultiplier = 1;\n        game.currentHp = 100;\n        game.growthStage = 1;\n        game.isRestarted = false;\n        game.isPaused = false;\n        game.isRunning = true;\n        updateDisplay();\n      }\n    }\n\n    function restartGame() {\n      if (game.isRunning) {\n        game.isRunning = false;\n        game.isPaused = true;\n        game.isGameOver = false;\n        game.isSaved = false;\n        game.growthProgress = 0;\n        game.growthTarget = 10;\n        game.growthReward = 0;\n        game.growthSpeed = 1;\n        game.growthMultiplier = 1;\n        game.currentHp = 100;\n        game.growthStage = 1;\n        game.isRestarted = true;\n        updateDisplay();\n      }\n    }\n\n    function updateDisplay() {\n      document.getElementById(\"currentHp\").textContent = game.currentHp;\n      document.getElementById(\"growthStage\").textContent = game.growthStage;\n    }\n\n    function handleCombat() {\n      if (game.isRunning && !game.isPaused) {\n        game.growthProgress += game.growthSpeed;\n        game.growthReward += game.growthMultiplier;\n        if (game.growthProgress >= game.growthTarget) {\n          game.growthProgress = game.growthTarget;\n          game.growthStage++;\n          game.growthReward = 0;\n          game.growthSpeed *= 1.5;\n          game.growthMultiplier *= 1.2;\n          updateDisplay();\n        }\n      }\n    }\n\n    function handlePause() {\n      if (game.isRunning && !game.isPaused) {\n        game.isPaused = true;\n        updateDisplay();\n      }\n    }\n\n    function handleRestart() {\n      if (game.isRunning) {\n        game.isRunning = false;\n        game.isPaused = true;\n        game.isGameOver = false;\n        game.isSaved = false;\n        game.growthProgress = 0;\n        game.growthTarget = 10;\n        game.growthReward = 0;\n        game.growthSpeed = 1;\n        game.growthMultiplier = 1;\n        game.currentHp = 100;\n        game.growthStage = 1;\n        game.isRestarted = true;\n        updateDisplay();\n      }\n    }\n\n    function handleSave() {\n      if (game.isRunning && !game.isPaused) {\n        game.isSaved = true;\n        updateDisplay();\n      }\n    }\n\n    function handleLoad() {\n      if (game.isSaved) {\n        game.isRunning = true;\n        game.isPaused = false;\n        game.isGameOver = false;\n        game.isRestarted = false;\n        game.growthProgress = 0;\n        game.growthTarget = 10;\n        game.growthReward = 0;\n        game.growthSpeed = 1;\n        game.growthMultiplier = 1;\n        game.currentHp = 100;\n        game.growthStage = 1;\n        updateDisplay();\n      }\n    }\n\n    function handleExit() {\n      if (game.isRunning) {\n        game.isRunning = false;\n        game.isPaused = true;\n        game.isGameOver = true;\n        game.isSaved = false;\n        updateDisplay();\n      }\n    }\n\n    // Game loop\n    function gameLoop() {\n      if (game.isRunning && !game.isPaused) {\n        handleCombat();\n        handlePause();\n        handleRestart();\n        handleSave();\n        handleLoad();\n        handleExit();\n      }\n    }\n\n    // Start the game loop\n    setInterval(gameLoop, 1000);\n  </script>\n</body>\n</html>"
    }
