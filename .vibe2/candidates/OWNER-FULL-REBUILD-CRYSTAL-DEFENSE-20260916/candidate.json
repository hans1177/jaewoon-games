      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding: 20px;\n    }\n    h1 {\n      margin-bottom: 10px;\n    }\n    .game {\n      width: 100%;\n      max-width: 800px;\n      background: #111;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    .controls {\n      margin-bottom: 20px;\n    }\n    .controls button {\n      margin: 0 5px;\n      padding: 10px 15px;\n      background: #333;\n      color: #fff;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n    }\n    .status {\n      margin-top: 10px;\n      font-size: 0.9em;\n      color: #aaa;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div class=\"game\">\n      <div class=\"controls\">\n        <button id=\"start\">시작</button>\n        <button id=\"restart\">재시작</button>\n      </div>\n      <div class=\"status\" id=\"status\">준비 중...</div>\n      <div class=\"status\" id=\"game-over\">게임 종료</div>\n    </div>\n  </main>\n  <script>\n    const game = document.getElementById('game');\n    const status = document.getElementById('status');\n    const gameOver = document.getElementById('game-over');\n    const startBtn = document.getElementById('start');\n    const restartBtn = document.getElementById('restart');\n\n    let gameRunning = false;\n\n    startBtn.addEventListener('click', () => {\n      if (!gameRunning) {\n        game.innerHTML = `\n          <div class=\"controls\">\n            <button id=\"start\">시작</button>\n            <button id=\"restart\">재시작</button>\n          </div>\n          <div class=\"status\" id=\"status\">준비 중...</div>\n          <div class=\"status\" id=\"game-over\">게임 종료</div>\n        `;\n        gameRunning = true;\n        status.textContent = \"게임 시작\";\n      }\n    });\n\n    restartBtn.addEventListener('click', () => {\n      if (gameRunning) {\n        gameRunning = false;\n        status.textContent = \"게임 중지\";\n        gameOver.textContent = \"게임 종료\";\n      }\n    });\n  </script>\n</body>\n</html>"
