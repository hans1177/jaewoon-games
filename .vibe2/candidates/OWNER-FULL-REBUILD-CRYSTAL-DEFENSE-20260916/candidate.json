      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #111;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      text-align: center;\n    }\n    h1 {\n      margin-top: 20px;\n    }\n    button {\n      margin-top: 10px;\n      padding: 10px 20px;\n      font-size: 16px;\n      background-color: #333;\n      color: #fff;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n    }\n    button:hover {\n      background-color: #555;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <button id=\"startButton\">시작</button>\n    <div id=\"gameArea\"></div>\n    <div id=\"status\"></div>\n  </main>\n\n  <script>\n    const gameArea = document.getElementById('gameArea');\n    const status = document.getElementById('status');\n    const startButton = document.getElementById('startButton');\n\n    startButton.addEventListener('click', () => {\n      gameArea.innerHTML = '<div>게임 시작 중...</div>';\n      status.innerHTML = '게임 시작';\n    });\n\n    // Progression logic\n    let gameProgress = 0;\n    const progression = document.createElement('div');\n    progression.style.marginTop = '20px';\n    progression.style.fontSize = '18px';\n    progression.style.color = '#fff';\n    progression.style.backgroundColor = '#333';\n    progression.style.padding = '10px 15px';\n    progression.style.borderRadius = '5px';\n    progression.style.border = '1px solid #555';\n    gameArea.appendChild(progression);\n\n    // Restart logic\n    const restartButton = document.createElement('button');\n    restartButton.textContent = '재시작';\n    restartButton.style.marginTop = '20px';\n    restartButton.style.padding = '10px 20px';\n    restartButton.style.fontSize = '16px';\n    restartButton.style.backgroundColor = '#555';\n    restartButton.style.color = '#fff';\n    restartButton.style.borderRadius = '4px';\n    restartButton.style.border = '1px solid #666';\n    restartButton.style.cursor = 'pointer';\n    restartButton.addEventListener('click', () => {\n      gameArea.innerHTML = '<div>게임 재시작 중...</div>';\n      status.innerHTML = '게임 재시작';\n    });\n    gameArea.appendChild(restartButton);\n\n    // Protection logic\n    const protectedState = document.createElement('div');\n    protectedState.style.marginTop = '20px';\n    protectedState.style.fontSize = '16px';\n    protectedState.style.color = '#fff';\n    protectedState.style.backgroundColor = '#333';\n    protectedState.style.padding = '10px 15px';\n    protectedState.style.borderRadius = '5px';\n    protectedState.style.border = '1px solid #555';\n    protectedState.style.display = 'none';\n    gameArea.appendChild(protectedState);\n\n    // Game loop\n    function gameLoop() {\n      gameProgress++;\n      progression.textContent = `Progress: ${gameProgress} / 100`;\n      if (gameProgress >= 100) {\n        gameArea.innerHTML = '<div>게임 종료</div>';\n        status.innerHTML = '게임 종료';\n      }\n    }\n\n    setInterval(gameLoop, 1000);\n  </script>\n</body>\n</html>"
    }
