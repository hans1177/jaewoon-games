      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #111;\n      color: #fff;\n    }\n    main {\n      padding: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    h1 {\n      margin-bottom: 20px;\n    }\n    .shield {\n      width: 200px;\n      height: 200px;\n      background-color: #444;\n      border: 5px solid #00ffcc;\n      border-radius: 10px;\n      margin: 20px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .shield h2 {\n      margin: 0;\n    }\n    .shield p {\n      font-size: 14px;\n    }\n    .controls {\n      margin-top: 20px;\n      display: flex;\n      gap: 10px;\n    }\n    .controls button {\n      padding: 10px 15px;\n      font-size: 16px;\n      border: 1px solid #00ffcc;\n      border-radius: 5px;\n      background-color: #444;\n      color: #00ffcc;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #333;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"shield\">\n      <h1>Shield</h1>\n      <p>Protect your base from attacks!</p>\n      <button onclick=\"attack()\">Attack</button>\n    </div>\n    <div class=\"controls\">\n      <button onclick=\"restartGame()\">Restart</button>\n      <button onclick=\"showHUD()\">HUD</button>\n    </div>\n  </main>\n  <script>\n    let game = {\n      shield: {\n        health: 100,\n        damage: 10\n      },\n      attacks: 0,\n      isRunning: false\n    };\n\n    function attack() {\n      game.shield.health -= game.shield.damage;\n      game.attacks++;\n      if (game.shield.health <= 0) {\n        game.isRunning = false;\n        alert(\"Shield destroyed!\");\n      }\n    }\n\n    function restartGame() {\n      game.shield.health = 100;\n      game.attacks = 0;\n      game.isRunning = true;\n    }\n\n    function showHUD() {\n      alert(\"HUD shown!\");\n    }\n\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      if (game.isRunning) {\n        attack();\n      }\n    });\n  </script>\n</body>\n</html>"
