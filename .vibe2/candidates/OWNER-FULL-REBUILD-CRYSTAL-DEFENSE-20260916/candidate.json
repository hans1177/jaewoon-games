      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #1e1e1e;\n      color: #ffffff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding: 20px;\n    }\n    h1 {\n      margin-bottom: 10px;\n    }\n    .shield {\n      width: 200px;\n      height: 200px;\n      background-color: #4a90e2;\n      border-radius: 10px;\n      margin: 20px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      color: white;\n      font-size: 24px;\n      text-align: center;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    .hud {\n      width: 300px;\n      background-color: #2e2e2e;\n      padding: 10px;\n      border-radius: 5px;\n      margin: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    .hud h2 {\n      margin-bottom: 5px;\n    }\n    .hud p {\n      margin: 5px 0;\n    }\n    .controls {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      margin-top: 20px;\n    }\n    .controls button {\n      margin: 5px;\n      padding: 10px 20px;\n      font-size: 16px;\n      border: none;\n      border-radius: 5px;\n      background-color: #4a90e2;\n      color: white;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #3366cc;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"shield\">🛡️</div>\n    <div class=\"hud\">\n      <h2>Shield Status</h2>\n      <p>Health: <span id=\"shield-health\">100%</span></p>\n      <p>Damage: <span id=\"shield-damage\">0%</span></p>\n    </div>\n    <div class=\"controls\">\n      <button onclick=\"attack()\">Attack</button>\n      <button onclick=\"defend()\">Defend</button>\n      <button onclick=\"restartGame()\">Restart</button>\n    </div>\n  </main>\n\n  <script>\n    let shieldHealth = 100;\n    let shieldDamage = 0;\n\n    function attack() {\n      shieldHealth -= 10;\n      shieldDamage += 5;\n      updateHUD();\n    }\n\n    function defend() {\n      shieldHealth += 10;\n      shieldDamage -= 5;\n      updateHUD();\n    }\n\n    function updateHUD() {\n      document.getElementById(\"shield-health\").textContent = shieldHealth + \"%\";\n      document.getElementById(\"shield-damage\").textContent = shieldDamage + \"%\";\n    }\n\n    function restartGame() {\n      shieldHealth = 100;\n      shieldDamage = 0;\n      updateHUD();\n    }\n  </script>\n</body>\n</html>"
