      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding: 20px;\n    }\n    h1 {\n      margin-bottom: 10px;\n    }\n    .game {\n      width: 100%;\n      max-width: 800px;\n      background: #111;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    .progression {\n      margin-top: 20px;\n      font-size: 0.9em;\n      color: #888;\n    }\n    .ui {\n      margin-top: 20px;\n      font-size: 0.8em;\n      color: #aaa;\n    }\n    .controls {\n      margin-top: 20px;\n      display: flex;\n      gap: 10px;\n    }\n    .controls button {\n      padding: 10px 15px;\n      font-size: 0.9em;\n      border: none;\n      border-radius: 4px;\n      background-color: #333;\n      color: #fff;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #555;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\"></main>\n  <script>\n    // Protected state preservation\n    const protectedState = {\n      player: {\n        health: 100,\n        energy: 100,\n        level: 1,\n        score: 0\n      },\n      game: {\n        isRunning: true,\n        isPaused: false,\n        isGameOver: false\n      }\n    };\n\n    // Game logic\n    const gameContainer = document.getElementById('game');\n    const player = protectedState.player;\n    const game = protectedState.game;\n\n    // Game loop\n    function gameLoop() {\n      if (!game.isRunning) return;\n\n      // Update game state\n      player.health -= 1;\n      player.energy -= 1;\n      player.score += 1;\n\n      // Check for game over\n      if (player.health <= 0) {\n        game.isGameOver = true;\n        game.isRunning = false;\n      }\n\n      // Update UI\n      document.getElementById('game').innerHTML = `\n        <h1>Vibe2</h1>\n        <div class=\"progression\">Progression: ${player.level}</div>\n        <div class=\"ui\">Score: ${player.score}</div>\n        <div class=\"ui\">Health: ${player.health}</div>\n        <div class=\"ui\">Energy: ${player.energy}</div>\n        <div class=\"controls\">\n          <button onclick=\"restartGame()\">Restart</button>\n        </div>\n      `;\n    }\n\n    // Start game\n    function startGame() {\n      game.isRunning = true;\n      game.isPaused = false;\n      gameContainer.innerHTML = `\n        <h1>Vibe2</h1>\n        <div class=\"progression\">Progression: ${protectedState.player.level}</div>\n        <div class=\"ui\">Score: ${protectedState.player.score}</div>\n        <div class=\"ui\">Health: ${protectedState.player.health}</div>\n        <div class=\"ui\">Energy: ${protectedState.player.energy}</div>\n        <div class=\"controls\">\n          <button onclick=\"pauseGame()\">Pause</button>\n          <button onclick=\"restartGame()\">Restart</button>\n        </div>\n      `;\n    }\n\n    // Pause game\n    function pauseGame() {\n      game.isPaused = true;\n      game.isRunning = false;\n    }\n\n    // Restart game\n    function restartGame() {\n      protectedState.player = {\n        health: 100,\n        energy: 100,\n        level: 1,\n        score: 0\n      };\n      protectedState.game = {\n        isRunning: true,\n        isPaused: false,\n        isGameOver: false\n      };\n      startGame();\n    }\n\n    // Game loop\n    setInterval(gameLoop, 1000);\n  </script>\n</body>\n</html>"
    }
