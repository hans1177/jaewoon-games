      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #111;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      text-align: center;\n    }\n    h1 {\n      font-size: 2em;\n      margin-bottom: 1em;\n    }\n    button {\n      padding: 0.5em 1em;\n      font-size: 0.9em;\n      margin: 0 0.5em;\n      background-color: #222;\n      color: #fff;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n    }\n    button:hover {\n      background-color: #444;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <button onclick=\"startGame()\">Start Game</button>\n  </main>\n  <script>\n    function startGame() {\n      const gameContainer = document.getElementById('game');\n      gameContainer.innerHTML = `\n        <h2>Game Start</h2>\n        <p>Click to begin the game.</p>\n        <button onclick=\"beginGame()\">Begin Game</button>\n      `;\n    }\n\n    function beginGame() {\n      const gameContainer = document.getElementById('game');\n      gameContainer.innerHTML = `\n        <h2>Game in Progress</h2>\n        <p>Game is now in progress.</p>\n        <button onclick=\"endGame()\">End Game</button>\n      `;\n    }\n\n    function endGame() {\n      const gameContainer = document.getElementById('game');\n      gameContainer.innerHTML = `\n        <h2>Game Over</h2>\n        <p>The game has ended.</p>\n        <button onclick=\"restartGame()\">Restart Game</button>\n      `;\n    }\n\n    function restartGame() {\n      const gameContainer = document.getElementById('game');\n      gameContainer.innerHTML = `\n        <h2>Game Restart</h2>\n        <p>The game has been restarted.</p>\n        <button onclick=\"startGame()\">Start Game</button>\n      `;\n    }\n  </script>\n</body>\n</html>"
