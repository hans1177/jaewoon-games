\"></div>\n      `;\n      document.getElementById('progression').innerHTML = `\n        <div class=\"progression\" style=\"width: 100px; height: 20px; background: #0000ff; margin: 10px;\"></div>\n      `;\n      document.getElementById('ui').innerHTML = `\n        <div class=\"ui\" style=\"width: 100px; height: 20px; background: #00ff00; margin: 10px;\"></div>\n      `;\n      document.getElementById('restart-button').innerHTML = `\n        <button class=\"restart-button\" style=\"width: 100px; height: 40px; background: #ff00ff; color: #fff; border: none; border-radius: 5px;\">Restart</button>\n      `;\n    }\n\n    // Game logic\n    function updateGame() {\n      // Game logic here\n    }\n\n    // Game event handlers\n    document.getElementById('restart-button').addEventListener('click', () => {\n      game.player.health = 100;\n      game.player.score = 0;\n      game.enemy.position = { x: 0, y: 0 };\n      game.progression.difficulty = 1;\n      game.ui.health = 100;\n      game.ui.score = 0;\n      initGame();\n    });\n\n    initGame();\n  </script>\n</body>\n</html>"
