      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>엘도리아 연대기</title>\n  <style>\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background-color: #1e1e1e;\n      color: #f0f0f0;\n      margin: 0;\n      padding: 0;\n    }\n    header {\n      background-color: #08111b;\n      color: #f0f0f0;\n      padding: 1rem;\n      text-align: center;\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      background-color: #1e1e1e;\n    }\n    .game-content {\n      width: 100%;\n      max-width: 800px;\n      padding: 2rem;\n      background-color: #1a1a1a;\n      border-radius: 8px;\n      box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);\n    }\n    .story {\n      line-height: 1.6;\n      font-size: 1.1rem;\n      color: #f0f0f0;\n    }\n    .choices {\n      margin-top: 2rem;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 1rem;\n      justify-content: center;\n    }\n    .choice {\n      background-color: #1a1a1a;\n      padding: 1rem 1.5rem;\n      border-radius: 5px;\n      width: 250px;\n      text-align: center;\n      font-size: 1rem;\n      color: #f0f0f0;\n      transition: 0.3s;\n    }\n    .choice:hover {\n      background-color: #2a2a2a;\n    }\n    .status {\n      margin-top: 2rem;\n      font-size: 1.2rem;\n      color: #f0f0f0;\n    }\n    .progress {\n      margin-top: 1rem;\n      font-size: 0.9rem;\n      color: #f0f0f0;\n    }\n    .save {\n      margin-top: 2rem;\n      font-size: 0.9rem;\n      color: #f0f0f0;\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>엘도리아 연대기</h1>\n    <p>5장 완결 RPG - 탐색·전투·휴식·강화·스토리 연출</p>\n  </header>\n  <div class=\"game-container\">\n    <div class=\"game-content\">\n      <div class=\"story\">\n        <p>회색 숲에서 엘도리아의 심장까지 5개 장을 탐험하고 전투·휴식·장비 강화를 선택하는 완결형 RPG.</p>\n      </div>\n      <div class=\"choices\">\n        <div class=\"choice\" data-choice=\"탐색\">탐색</div>\n        <div class=\"choice\" data-choice=\"전투\">전투</div>\n        <div class=\"choice\" data-choice=\"휴식\">휴식</div>\n        <div class=\"choice\" data-choice=\"강화\">강화</div>\n      </div>\n      <div class=\"status\">\n        <p>현재 HP: <span id=\"currentHp\">100</span></p>\n      </div>\n      <div class=\"progress\">\n        <p>5장 완결: <span id=\"progressStatus\">0%</span></p>\n      </div>\n      <div class=\"save\">\n        <p>저장: <span id=\"saveStatus\">off</span></p>\n      </div>\n    </div>\n  </div>\n  <script>\n    // 게임 로직 및 상태 관리\n    const choices = document.querySelectorAll('.choice');\n    const currentHp = document.getElementById('currentHp');\n    const progressStatus = document.getElementById('progressStatus');\n    const saveStatus = document.getElementById('saveStatus');\n\n    // 선택 처리\n    choices.forEach(choice => {\n      choice.addEventListener('click', () => {\n        const choiceText = choice.textContent;\n        const status = document.querySelector(`[data-choice=\"${choiceText}\"]`);\n        status.classList.add('active');\n        status.textContent = '선택됨';\n      });\n    });\n\n    // 상태 업데이트\n    function updateStatus() {\n      currentHp.textContent = Math.min(100, parseInt(currentHp.textContent) + 1);\n      progressStatus.textContent = Math.min(100, parseInt(progressStatus.textContent) + 1);\n      saveStatus.textContent = 'on';\n    }\n\n    // 초기 상태\n    updateStatus();\n\n    // 저장 및 재시도 처리\n    document.addEventListener('DOMContentLoaded', () => {\n      const saveButton = document.createElement('button');\n      saveButton.textContent = '저장';\n      saveButton.addEventListener('click', () => {\n        saveStatus.textContent = 'on';\n        updateStatus();\n      });\n\n      document.querySelector('.save').appendChild(saveButton);\n    });\n  </script>\n</body>\n</html>"
    }
