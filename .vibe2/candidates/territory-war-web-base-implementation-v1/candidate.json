      "content": "<!doctype html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title>Approved Web Bootstrap</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            background-color: #222;\n            color: #fff;\n            margin: 0;\n            padding: 0;\n        }\n        main {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            height: 100vh;\n            text-align: center;\n        }\n        h1 {\n            font-size: 2em;\n            margin-bottom: 1em;\n        }\n        button {\n            padding: 0.5em 1em;\n            font-size: 0.9em;\n            margin: 0 0.5em;\n            background-color: #444;\n            color: #fff;\n            border: none;\n            border-radius: 4px;\n            cursor: pointer;\n        }\n        button:hover {\n            background-color: #666;\n        }\n    </style>\n</head>\n<body>\n    <main id=\"game\">\n        <h1>Approved Web Bootstrap</h1>\n        <button onclick=\"startGame()\">Start Game</button>\n    </main>\n    <script>\n        function startGame() {\n            const gameContainer = document.getElementById('game');\n            gameContainer.innerHTML = `\n                <h2>Territory War</h2>\n                <p>Click the button to start the game.</p>\n                <button onclick=\"playGame()\">Play Game</button>\n            `;\n        }\n\n        function playGame() {\n            const gameContainer = document.getElementById('game');\n            gameContainer.innerHTML = `\n                <h2>Territory War</h2>\n                <p>Click the button to play the game.</p>\n                <button onclick=\"restartGame()\">Restart Game</button>\n            `;\n        }\n\n        function restartGame() {\n            const gameContainer = document.getElementById('game');\n            gameContainer.innerHTML = `\n                <h2>Territory War</h2>\n                <p>Click the button to restart the game.</p>\n                <button onclick=\"startGame()\">Start Game</button>\n            `;\n        }\n    </script>\n</body>\n</html>"
