      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>세계의 직조자</title>\n  <style>\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background-color: #1e1e1e;\n      color: #ffffff;\n      margin: 0;\n      padding: 0;\n    }\n    h1 {\n      text-align: center;\n      margin-top: 20px;\n    }\n    #game-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      padding: 20px;\n      background-color: #1a1a1a;\n    }\n    #game-container h2 {\n      margin-bottom: 20px;\n    }\n    #game-container p {\n      max-width: 600px;\n      margin: 0 auto;\n      font-size: 16px;\n    }\n    #game-container button {\n      margin: 10px;\n      padding: 10px 20px;\n      font-size: 16px;\n      border: none;\n      border-radius: 5px;\n      background-color: #007bff;\n      color: white;\n      cursor: pointer;\n    }\n    #game-container button:hover {\n      background-color: #0056b3;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"game-container\">\n    <h1>세계의 직조자</h1>\n    <p>마나로 숲·물길·마을을 창조하고 세계 안정도와 인구 목표를 달성하는 캐주얼 세계 창조 게임.</p>\n    <button onclick=\"startGame()\">시작</button>\n    <div id=\"game-status\"></div>\n    <div id=\"game-map\"></div>\n  </div>\n\n  <script>\n    // Game logic and initialization\n    let gameStatus = document.getElementById('game-status');\n    let gameMap = document.getElementById('game-map');\n\n    function startGame() {\n      gameStatus.textContent = \"게임 시작 중...\";\n      gameMap.innerHTML = \"<div id='map-container'>게임 맵이 로딩 중...</div>\";\n      // Simulate map loading\n      setTimeout(() => {\n        gameMap.innerHTML = \"<div id='map-container'>숲, 물길, 마을이 배치됨</div>\";\n        gameStatus.textContent = \"게임 시작 완료\";\n      }, 1500);\n    }\n\n    // Game progression and interaction\n    function updateProgress() {\n      const progress = Math.floor(Math.random() * 100);\n      gameStatus.textContent = `진행률: ${progress}%`;\n      if (progress >= 80) {\n        gameStatus.textContent = \"세계 안정도가 80% 달성됨!\";\n      }\n    }\n\n    // Mobile input handling\n    document.addEventListener('touchstart', (e) => {\n      if (e.touches.length > 0) {\n        const touch = e.touches[0];\n        const map = document.getElementById('map-container');\n        const cell = findCellFromTouch(touch, map);\n        if (cell) {\n          updateProgress();\n          gameStatus.textContent = \"마나 사용됨\";\n        }\n      }\n    });\n\n    // Restart functionality\n    document.getElementById('game-container').addEventListener('click', () => {\n      gameStatus.textContent = \"게임 재시작 중...\";\n      setTimeout(() => {\n        gameStatus.textContent = \"게임 재시작 완료\";\n        startGame();\n      }, 1500);\n    });\n  </script>\n</body>\n</html>"
    }
  ],
