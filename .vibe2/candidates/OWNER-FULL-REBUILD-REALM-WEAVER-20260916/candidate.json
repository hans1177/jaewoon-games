      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>세계의 직조자</title>\n  <link rel=\"stylesheet\" href=\"/web-games/_shared/styles.css\">\n</head>\n<body>\n  <script>\n    window.GAME_CONFIG = {\n      id: 'seed-casual-realm-weaver',\n      name: '세계의 직조자',\n      mode: 'realm',\n      desc: '마나로 숲·물길·마을을 창조하고 세계 안정도와 인구 목표를 달성하는 캐주얼 세계 창조 게임.'\n    };\n\n    // Initialize game state\n    let gameState = {\n      progress: 0,\n      difficulty: 1,\n      world: {\n        grid: [],\n        population: 0,\n        stability: 0\n      },\n      resources: {\n        mana: 100,\n        wood: 0,\n        water: 0,\n        stone: 0\n      },\n      ui: {\n        currentTile: null,\n        selectedResource: null,\n        progressDisplay: null,\n        difficultyDisplay: null\n      }\n    };\n\n    // Initialize game UI elements\n    const progressDisplay = document.createElement('div');\n    progressDisplay.id = 'progress-display';\n    document.body.appendChild(progressDisplay);\n\n    const difficultyDisplay = document.createElement('div');\n    difficultyDisplay.id = 'difficulty-display';\n    document.body.appendChild(difficultyDisplay);\n\n    const worldGrid = document.createElement('div');\n    worldGrid.id = 'world-grid';\n    document.body.appendChild(worldGrid);\n\n    const resourcesContainer = document.createElement('div');\n    resourcesContainer.id = 'resources-container';\n    document.body.appendChild(resourcesContainer);\n\n    const uiContainer = document.createElement('div');\n    uiContainer.id = 'ui-container';\n    document.body.appendChild(uiContainer);\n\n    // Game logic and progression system\n    function updateProgress() {\n      gameState.progress += 1;\n      updateProgressDisplay();\n      updateDifficultyDisplay();\n    }\n\n    function updateProgressDisplay() {\n      progressDisplay.textContent = `Progress: ${gameState.progress}/${gameState.maxProgress}`;\n    }\n\n    function updateDifficultyDisplay() {\n      difficultyDisplay.textContent = `Difficulty: ${gameState.difficulty}`;\n    }\n\n    // Game mechanics and UI\n    function createWorldGrid() {\n      const grid = [];\n      for (let i = 0; i < 10; i++) {\n        grid[i] = [];\n        for (let j = 0; j < 10; j++) {\n          grid[i][j] = {\n            type: 'empty',\n            resources: {\n              mana: 0,\n              wood: 0,\n              water: 0,\n              stone: 0\n            },\n            population: 0,\n            stability: 0\n          };\n        }\n      }\n      return grid;\n    }\n\n    function renderWorldGrid(grid) {\n      const gridContainer = document.getElementById('world-grid');\n      gridContainer.innerHTML = '';\n      for (let i = 0; i < 10; i++) {\n        const row = document.createElement('div');\n        row.id = `row-${i}`;\n        row.className = 'grid-row';\n        for (let j = 0; j < 10; j++) {\n          const cell = document.createElement('div');\n          cell.id = `cell-${i}-${j}`;\n          cell.className = 'grid-cell';\n          cell.textContent = ' ';\n          row.appendChild(cell);\n        }\n        gridContainer.appendChild(row);\n      }\n    }\n\n    function updateResources() {\n      gameState.resources.mana -= 1;\n      gameState.resources.wood += 1;\n      gameState.resources.water += 1;\n      gameState.resources.stone += 1;\n      updateResourcesContainer();\n    }\n\n    function updateResourcesContainer() {\n      resourcesContainer.innerHTML = `\n        <div>Mana: ${gameState.resources.mana}</div>\n        <div>Wood: ${gameState.resources.wood}</div>\n        <div>Water: ${gameState.resources.water}</div>\n        <div>Stone: ${gameState.resources.stone}</div>\n      `;\n    }\n\n    // Game controls and UI\n    function handlePlayerInput() {\n      const input = window.event;\n      if (input.type === 'click') {\n        const target = input.target;\n        if (target.classList.contains('grid-cell')) {\n          const cell = target;\n          const resources = cell.getAttribute('resources');\n          if (resources) {\n            const { mana, wood, water, stone } = JSON.parse(resources);\n            gameState.resources.mana += mana;\n            gameState.resources.wood += wood;\n            gameState.resources.water += water;\n            gameState.resources.stone += stone;\n            updateResourcesContainer();\n          }\n        }\n      }\n    }\n\n    // Game loop\n    function gameLoop() {\n      updateProgress();\n      updateWorldGrid();\n      updateResources();\n      updateUI();\n      requestAnimationFrame(gameLoop);\n    }\n\n    // Initialize game\n    function initGame() {\n      gameState.maxProgress = 100;\n      gameState.difficulty = 1;\n      gameState.world = createWorldGrid();\n      renderWorldGrid(gameState.world);\n      updateProgressDisplay();\n      updateDifficultyDisplay();\n      gameLoop();\n    }\n\n    // Start game\n    initGame();\n  </script>\n</body>\n</html>"
    }
