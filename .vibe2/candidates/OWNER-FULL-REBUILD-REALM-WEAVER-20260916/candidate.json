    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#08111b\">\n  <title>세계의 직조자</title>\n  <link rel=\"stylesheet\" href=\"/web-games/_shared/styles.css\">\n</head>\n<body>\n  <script>\n    window.GAME_CONFIG = {\n      id: 'seed-casual-realm-weaver',\n      name: '세계의 직조자',\n      mode: 'realm',\n      desc: '마나로 숲·물길·마을을 창조하고 세계 안정도와 인구 목표를 달성하는 캐주얼 세계 창조 게임.'\n    };\n\n    // Progression system initialization\n    const progressionSystem = {\n      currentProgression: 0,\n      maxProgression: 100,\n      progressionSteps: [\n        { name: '초기', value: 0 },\n        { name: '숲의 창조', value: 20 },\n        { name: '물길의 흐름', value: 40 },\n        { name: '마을의 집단', value: 60 },\n        { name: '세계의 안정', value: 80 },\n        { name: '마나의 균형', value: 100 }\n      ],\n      getProgressionStep() {\n        const step = Math.floor((this.currentProgression / this.maxProgression) * this.progressionSteps.length);\n        return this.progressionSteps[step];\n      },\n      updateProgression(delta) {\n        this.currentProgression += delta;\n        if (this.currentProgression >= this.maxProgression) {\n          this.currentProgression = this.maxProgression;\n        }\n      }\n    };\n\n    // UI system initialization\n    const uiSystem = {\n      currentView: 'start',\n      showStartScreen: true,\n      showProgressionScreen: false,\n      showRestartButton: true,\n      showTutorial: true,\n      tutorialSteps: [\n        { step: 1, message: '마나로 숲·물길·마을을 창조하세요.' },\n        { step: 2, message: '세계 안정도와 인구 목표를 달성하세요.' }\n      ],\n      updateTutorialStep() {\n        if (this.currentView === 'tutorial') {\n          this.currentView = this.tutorialSteps[Math.floor((this.currentProgression / this.maxProgression) * this.tutorialSteps.length)];\n        }\n      }\n    };\n\n    // Terrain and settlement interaction system\n    const terrainSystem = {\n      currentTerrain: 'forest',\n      currentSettlement: 'village',\n      terrainTypes: {\n        forest: {\n          name: '숲',\n          resource: 'wood',\n          production: 5,\n          cost: 1\n        },\n        village: {\n          name: '마을',\n          resource: 'food',\n          production: 3,\n          cost: 1\n        }\n      },\n      settlementTypes: {\n        village: {\n          name: '마을',\n          resource: 'food',\n          production: 3,\n          cost: 1\n        }\n      },\n      updateTerrain() {\n        this.currentTerrain = this.terrainTypes[this.currentTerrain === 'forest' ? 'village' : 'forest'];\n      },\n      updateSettlement() {\n        this.currentSettlement = this.settlementTypes[this.currentSettlement === 'village' ? 'village' : 'village'];\n      }\n    };\n\n    // Game loop\n    function gameLoop() {\n      // Update progression\n      progressionSystem.updateProgression(1);\n\n      // Update UI\n      uiSystem.updateTutorialStep();\n\n      // Update terrain and settlement\n      terrainSystem.updateTerrain();\n      terrainSystem.updateSettlement();\n\n      // Check for game over or success\n      if (progressionSystem.currentProgression >= progressionSystem.maxProgression) {\n        alert('세계가 안정되었습니다!');\n      }\n\n      // Check for restart\n      if (uiSystem.showRestartButton && progressionSystem.currentProgression < progressionSystem.maxProgression) {\n        uiSystem.showRestartButton = false;\n        alert('게임을 재시작합니다.');\n      }\n\n      // Render game\n      renderGame();\n    }\n\n    // Render game\n    function renderGame() {\n      // Render terrain and settlement\n      const terrainDiv = document.getElementById('terrain');\n      terrainDiv.innerHTML = `<div class=\"terrain\">${terrainSystem.currentTerrain}</div>`;\n      terrainDiv.innerHTML += `<div class=\"settlement\">${terrainSystem.currentSettlement}</div>`;\n\n      // Render progression\n      const progressionDiv = document.getElementById('progression');\n      progressionDiv.innerHTML = `<div class=\"progression\">${progressionSystem.getProgressionStep().name}</div>`;\n      progressionDiv.innerHTML += `<div class=\"progression-value\">${progressionSystem.getProgressionStep().value}</div>`;\n    }\n\n    // Start game\n    function startGame() {\n      uiSystem.showStartScreen = false;\n      uiSystem.showProgressionScreen = true;\n      renderGame();\n    }\n\n    // Restart game\n    function restartGame() {\n      uiSystem.showRestartButton = true;\n      uiSystem.showStartScreen = true;\n      renderGame();\n    }\n\n    // Initialize game\n    window.onload = function() {\n      startGame();\n    };\n  </script>\n</body>\n</html>"
    }
  ],
