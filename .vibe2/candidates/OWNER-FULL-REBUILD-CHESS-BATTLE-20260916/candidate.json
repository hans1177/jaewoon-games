      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      background-color: #222;\n      color: #fff;\n      margin: 0;\n      padding: 0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      text-align: center;\n    }\n    h1 {\n      margin-bottom: 20px;\n    }\n    .chess-board {\n      display: grid;\n      grid-template-columns: repeat(8, 60px);\n      grid-template-rows: repeat(8, 60px);\n      gap: 5px;\n      width: 480px;\n      height: 480px;\n      background-color: #333;\n      border: 2px solid #555;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    .square {\n      width: 60px;\n      height: 60px;\n      background-color: #444;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 24px;\n      color: #fff;\n      border: 1px solid #666;\n    }\n    .square.selected {\n      background-color: #00ffcc;\n    }\n    .square.occupied {\n      background-color: #ff0000;\n    }\n    .square.empty {\n      background-color: #ccc;\n    }\n    .controls {\n      margin-top: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    .controls button {\n      margin: 5px;\n      padding: 10px 20px;\n      font-size: 18px;\n      border: 2px solid #fff;\n      background-color: #00ffcc;\n      color: #000;\n      border-radius: 5px;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #00cc99;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2 Chess Battle</h1>\n    <div class=\"chess-board\" id=\"chessBoard\"></div>\n    <div class=\"controls\">\n      <button onclick=\"makeMove('a1', 'a2')\">Move</button>\n      <button onclick=\"makeMove('a2', 'a1')\">Capture</button>\n      <button onclick=\"makeMove('b1', 'b2')\">Move</button>\n      <button onclick=\"makeMove('b2', 'b1')\">Capture</button>\n    </div>\n  </main>\n\n  <script>\n    const board = document.getElementById('chessBoard');\n    const controls = document.querySelectorAll('.controls button');\n\n    // Initialize chess board\n    function createBoard() {\n      for (let row = 0; row < 8; row++) {\n        for (let col = 0; col < 8; col++) {\n          const square = document.createElement('div');\n          square.className = 'square';\n          square.dataset.row = row;\n          square.dataset.col = col;\n          square.addEventListener('click', () => selectSquare(square));\n          board.appendChild(square);\n        }\n      }\n    }\n\n    function selectSquare(square) {\n      if (square.classList.contains('selected')) return;\n      square.classList.add('selected');\n      square.style.backgroundColor = '#00ffcc';\n      square.style.border = '2px solid #00cc99';\n    }\n\n    // Simulate move logic\n    function makeMove(from, to) {\n      const fromSquare = document.querySelector(`[data-row='${from[0]}'] [data-col='${from[1]}']`);\n      const toSquare = document.querySelector(`[data-row='${to[0]}'] [data-col='${to[1]}']`);\n\n      if (!fromSquare || !toSquare) return;\n\n      if (fromSquare.classList.contains('selected') && toSquare.classList.contains('empty')) {\n        fromSquare.classList.remove('selected');\n        toSquare.classList.add('selected');\n        toSquare.style.backgroundColor = '#00ffcc';\n        toSquare.style.border = '2px solid #00cc99';\n      } else if (fromSquare.classList.contains('selected') && toSquare.classList.contains('occupied')) {\n        fromSquare.classList.remove('selected');\n        toSquare.classList.remove('selected');\n        toSquare.style.backgroundColor = '#ff0000';\n        toSquare.style.border = '2px solid #ff0000';\n      } else {\n        alert('Invalid move');\n      }\n    }\n\n    // Initialize game\n    createBoard();\n  </script>\n</body>\n</html>"
    }
