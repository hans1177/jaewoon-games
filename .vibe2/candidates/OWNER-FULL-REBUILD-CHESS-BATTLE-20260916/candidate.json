      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 - Chess Game</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      background-color: #f0f0f0;\n      margin: 0;\n      padding: 0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      background-color: #fff;\n    }\n    .game-board {\n      display: grid;\n      grid-template-columns: repeat(8, 60px);\n      grid-template-rows: repeat(8, 60px);\n      gap: 2px;\n      margin: 20px;\n      background-color: #e0e0e0;\n      border: 2px solid #ccc;\n      border-radius: 8px;\n    }\n    .game-board .square {\n      width: 60px;\n      height: 60px;\n      background-color: #fff;\n      border: 1px solid #ccc;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 24px;\n      color: #333;\n    }\n    .game-board .square.selected {\n      background-color: #007bff;\n      color: white;\n    }\n    .game-board .square.occupied {\n      background-color: #007bff;\n      color: white;\n    }\n    .game-board .square.empty {\n      background-color: #e0e0e0;\n    }\n    .game-board .square.occupied .piece {\n      font-weight: bold;\n    }\n    .game-control {\n      margin: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    .game-control button {\n      margin: 5px;\n      padding: 10px 20px;\n      font-size: 18px;\n      background-color: #007bff;\n      color: white;\n      border: none;\n      border-radius: 5px;\n      cursor: pointer;\n      transition: background-color 0.3s;\n    }\n    .game-control button:hover {\n      background-color: #005a9e;\n    }\n    .game-control .status {\n      margin-top: 10px;\n      font-size: 16px;\n      color: #555;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"game-board\" id=\"game-board\"></div>\n    <div class=\"game-control\">\n      <button id=\"new-game\">새 게임</button>\n      <button id=\"start-game\">게임 시작</button>\n      <div class=\"status\" id=\"status\">게임 시작 중</div>\n    </div>\n  </main>\n\n  <script>\n    const gameBoard = document.getElementById('game-board');\n    const status = document.getElementById('status');\n    const startGameBtn = document.getElementById('start-game');\n    const newGameBtn = document.getElementById('new-game');\n\n    // Initialize game board\n    function initBoard() {\n      for (let row = 0; row < 8; row++) {\n        for (let col = 0; col < 8; col++) {\n          const square = document.createElement('div');\n          square.classList.add('square');\n          square.dataset.row = row;\n          square.dataset.col = col;\n          square.addEventListener('click', () => selectSquare(square));\n          gameBoard.appendChild(square);\n        }\n      }\n    }\n\n    // Select a square\n    function selectSquare(square) {\n      if (square.classList.contains('selected')) return;\n      square.classList.add('selected');\n      status.textContent = '선택 중';\n    }\n\n    // Start game\n    function startGame() {\n      status.textContent = '게임 시작 중';\n      // Game logic here\n    }\n\n    // New game\n    function newGame() {\n      status.textContent = '새 게임 시작 중';\n      // Game logic here\n    }\n\n    // Event listeners\n    startGameBtn.addEventListener('click', startGame);\n    newGameBtn.addEventListener('click', newGame);\n\n    // Initialize game\n    initBoard();\n  </script>\n</body>\n</html>"
    }
