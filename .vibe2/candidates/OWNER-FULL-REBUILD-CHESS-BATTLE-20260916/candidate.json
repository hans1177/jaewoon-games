      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #f0f0f0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      padding: 20px;\n      background-color: #fff;\n    }\n    h1 {\n      margin-bottom: 20px;\n    }\n    .game-board {\n      display: grid;\n      grid-template-columns: repeat(8, 60px);\n      grid-template-rows: repeat(8, 60px);\n      gap: 5px;\n      margin: 20px;\n      background-color: #e0e0e0;\n      border: 2px solid #ccc;\n      border-radius: 8px;\n    }\n    .piece {\n      width: 60px;\n      height: 60px;\n      background-color: #fff;\n      border: 2px solid #999;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 24px;\n      color: #333;\n      box-shadow: 0 0 5px #000;\n    }\n    .piece.selected {\n      background-color: #007bff;\n      color: white;\n    }\n    .controls {\n      margin-top: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    .controls button {\n      margin: 5px;\n      padding: 10px 20px;\n      font-size: 18px;\n      border: 2px solid #007bff;\n      border-radius: 5px;\n      background-color: #007bff;\n      color: white;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #005f99;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div class=\"game-board\" id=\"board\"></div>\n    <div class=\"controls\">\n      <button id=\"newGame\">새 게임</button>\n      <button id=\"restartGame\">재시작</button>\n      <button id=\"aiPlay\">AI 턴</button>\n    </div>\n  </main>\n\n  <script>\n    const board = document.getElementById('board');\n    const controls = document.getElementById('controls');\n    const newGameBtn = document.getElementById('newGame');\n    const restartGameBtn = document.getElementById('restartGame');\n    const aiPlayBtn = document.getElementById('aiPlay');\n\n    // 게임 상태 관리\n    let game = null;\n    let turn = 'player';\n    let gameOver = false;\n\n    // 게임 초기화\n    function initGame() {\n      game = {\n        board: createBoard(),\n        turn: 'player',\n        selectedPiece: null,\n        ai: {\n          board: createBoard(),\n          moves: []\n        },\n        gameOver: false\n      };\n      updateBoard();\n      updateControls();\n    }\n\n    // 게임 브레드보드 생성\n    function createBoard() {\n      const board = [];\n      for (let i = 0; i < 8; i++) {\n        board[i] = [];\n        for (let j = 0; j < 8; j++) {\n          board[i][j] = { color: (i + j) % 2 === 0 ? 'light' : 'dark', piece: null };\n        }\n      }\n      return board;\n    }\n\n    // 게임 브레드보드 업데이트\n    function updateBoard() {\n      for (let i = 0; i < 8; i++) {\n        for (let j = 0; j < 8; j++) {\n          const piece = game.board[i][j];\n          const pieceElement = document.createElement('div');\n          pieceElement.className = 'piece';\n          pieceElement.textContent = piece.color === 'light' ? '•' : '•';\n          pieceElement.style.backgroundColor = piece.color === 'light' ? '#fff' : '#e0e0e0';\n          pieceElement.style.border = piece.color === 'light' ? '2px solid #ccc' : '2px solid #ccc';\n          pieceElement.style.display = 'flex';\n          pieceElement.style.alignItems = 'center';\n          pieceElement.style.justifyContent = 'center';\n          pieceElement.style.fontSize = '24px';\n          pieceElement.style.color = piece.color === 'light' ? '#333' : '#000';\n          pieceElement.style.boxShadow = '0 0 5px #000';\n          boardElement.appendChild(pieceElement);\n        }\n      }\n    }\n\n    // 턴 전환\n    function switchTurn() {\n      if (turn === 'player') {\n        turn = 'ai';\n        aiPlayBtn.disabled = false;\n      } else {\n        turn = 'player';\n        aiPlayBtn.disabled = true;\n      }\n    }\n\n    // AI 턴 실행\n    function aiPlay() {\n      if (!game.ai.board || !game.ai.board.length) return;\n      const aiBoard = game.ai.board;\n      const selectedPiece = game.selectedPiece;\n      const board = game.board;\n\n      // AI 이동 로직 (기본 구현)\n      const move = {\n        from: { row: selectedPiece.row, col: selectedPiece.col },\n        to: { row: 0, col: 0 }\n      };\n\n      // 이동 후 턴 전환\n      game.selectedPiece = move.to;\n      switchTurn();\n    }\n\n    // 게임 재시작\n    function restartGame() {\n      initGame();\n    }\n\n    // 게임 새로 시작\n    newGameBtn.addEventListener('click', () => {\n      initGame();\n    });\n\n    // 턴 전환\n    controls.addEventListener('click', (e) => {\n      if (e.target.id === 'aiPlay') {\n        aiPlay();\n      }\n    });\n\n    // 게임 상태 업데이트\n    function updateControls() {\n      if (game && game.turn) {\n        controls.innerHTML = `\n          <button id=\"newGame\">새 게임</button>\n          <button id=\"restartGame\">재시작</button>\n          <button id=\"aiPlay\">AI 턴</button>\n        `;\n      } else {\n        controls.innerHTML = `\n          <button id=\"newGame\">새 게임</button>\n          <button id=\"restartGame\">재시작</button>\n        `;\n      }\n    }\n\n    // 게임 시작\n    initGame();\n  </script>\n</body>\n</html>"
    }
