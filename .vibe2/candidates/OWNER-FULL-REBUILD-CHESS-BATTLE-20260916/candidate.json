      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #f0f0f0;\n    }\n    main {\n      padding: 20px;\n      background-color: #fff;\n      margin: 0 auto;\n      max-width: 600px;\n      border: 1px solid #ccc;\n      border-radius: 8px;\n    }\n    h1 {\n      text-align: center;\n      color: #333;\n    }\n    .game-board {\n      display: grid;\n      grid-template-columns: repeat(8, 60px);\n      grid-template-rows: repeat(8, 60px);\n      gap: 5px;\n      margin: 20px 0;\n    }\n    .square {\n      width: 60px;\n      height: 60px;\n      background-color: #ddd;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 24px;\n      color: #333;\n      border: 1px solid #aaa;\n    }\n    .square.selected {\n      background-color: #007bff;\n      color: white;\n    }\n    .square.occupied {\n      background-color: #007bff;\n      color: white;\n    }\n    .square.empty {\n      background-color: #fff;\n      color: #999;\n    }\n    .controls {\n      text-align: center;\n      margin: 20px 0;\n    }\n    .controls button {\n      padding: 10px 20px;\n      font-size: 18px;\n      margin: 0 5px;\n      border: 1px solid #ccc;\n      border-radius: 4px;\n      background-color: #f0f0f0;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #e0e0e0;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div class=\"game-board\" id=\"board\"></div>\n    <div class=\"controls\">\n      <button id=\"newGame\">새 게임</button>\n      <button id=\"restart\">재시작</button>\n    </div>\n  </main>\n\n  <script>\n    const board = document.getElementById('board');\n    const newGameBtn = document.getElementById('newGame');\n    const restartBtn = document.getElementById('restart');\n\n    // Initialize board\n    function initBoard() {\n      for (let row = 0; row < 8; row++) {\n        for (let col = 0; col < 8; col++) {\n          const square = document.createElement('div');\n          square.className = 'square';\n          square.dataset.row = row;\n          square.dataset.col = col;\n          square.addEventListener('click', () => selectSquare(square));\n          board.appendChild(square);\n        }\n      }\n    }\n\n    // Select a square\n    function selectSquare(square) {\n      if (square.classList.contains('selected')) return;\n      square.classList.add('selected');\n      square.style.backgroundColor = '#007bff';\n      square.style.color = 'white';\n    }\n\n    // Unselect square\n    function unselectSquare(square) {\n      if (square.classList.contains('selected')) {\n        square.classList.remove('selected');\n        square.style.backgroundColor = '#ddd';\n        square.style.color = '#333';\n      }\n    }\n\n    // New game\n    newGameBtn.addEventListener('click', () => {\n      board.innerHTML = '';\n      initBoard();\n    });\n\n    // Restart game\n    restartBtn.addEventListener('click', () => {\n      board.innerHTML = '';\n      initBoard();\n    });\n  </script>\n</body>\n</html>"
    }
