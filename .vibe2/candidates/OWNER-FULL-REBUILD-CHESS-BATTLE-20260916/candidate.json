      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      background-color: #222;\n    }\n    #game {\n      width: 100%;\n      max-width: 600px;\n      background-color: #111;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0,0,0,0.5);\n    }\n    h1 {\n      color: #fff;\n    }\n    .move {\n      margin-top: 20px;\n      font-size: 18px;\n      color: #ccc;\n    }\n    .piece {\n      display: inline-block;\n      width: 40px;\n      height: 40px;\n      background-color: #444;\n      border: 1px solid #999;\n      margin: 2px;\n      border-radius: 4px;\n      text-align: center;\n      line-height: 40px;\n      font-weight: bold;\n      color: #fff;\n    }\n    .piece.black {\n      background-color: #333;\n    }\n    .piece.white {\n      background-color: #666;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div class=\"move\">Move your pieces!</div>\n    <div id=\"board\"></div>\n  </main>\n  <script>\n    // Game logic here\n    const board = document.getElementById('board');\n    const moveDiv = document.querySelector('.move');\n\n    // Initialize board\n    function initBoard() {\n      const boardContainer = document.createElement('div');\n      boardContainer.style.display = 'grid';\n      boardContainer.style.gridTemplateColumns = 'repeat(8, 50px)';\n      boardContainer.style.gridTemplateRows = 'repeat(8, 50px)';\n      boardContainer.style.gap = '2px';\n      boardContainer.style.backgroundColor = '#222';\n      boardContainer.style.border = '1px solid #444';\n      boardContainer.style.borderRadius = '8px';\n      boardContainer.style.boxShadow = '0 0 10px rgba(0,0,0,0.5)';\n      board.appendChild(boardContainer);\n\n      for (let row = 0; row < 8; row++) {\n        for (let col = 0; col < 8; col++) {\n          const piece = document.createElement('div');\n          piece.className = 'piece';\n          if (row % 2 === 0) {\n            piece.style.backgroundColor = row % 2 === 0 ? '#333' : '#666';\n          } else {\n            piece.style.backgroundColor = row % 2 === 0 ? '#666' : '#333';\n          }\n          piece.textContent = row < 8 ? row + 1 : 0;\n          boardContainer.querySelector(`[data-row=\"${row}\"][data-col=\"${col}\"]`).appendChild(piece);\n        }\n      }\n    }\n\n    // Handle player moves\n    function handleMove(from, to) {\n      moveDiv.textContent = 'Moving from ' + from + ' to ' + to;\n      // Game logic here\n    }\n\n    // Initialize the game\n    initBoard();\n  </script>\n</body>\n</html>"
