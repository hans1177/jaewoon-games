      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #f0f0f0;\n    }\n    main {\n      padding: 20px;\n      background-color: #fff;\n      margin: 0 auto;\n      max-width: 600px;\n    }\n    h1 {\n      text-align: center;\n      color: #333;\n    }\n    .game-board {\n      display: grid;\n      grid-template-columns: repeat(8, 60px);\n      grid-template-rows: repeat(8, 60px);\n      gap: 5px;\n      margin: 20px auto;\n      background-color: #eee;\n      border: 2px solid #999;\n      box-shadow: 0 0 10px rgba(0,0,0,0.1);\n    }\n    .square {\n      width: 60px;\n      height: 60px;\n      background-color: #fff;\n      border: 1px solid #ccc;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 24px;\n      color: #333;\n    }\n    .square.selected {\n      background-color: #007bff;\n      color: white;\n    }\n    .square.empty {\n      background-color: #ddd;\n    }\n    .square.occupied {\n      background-color: #007bff;\n      color: white;\n    }\n    .controls {\n      margin: 20px 0;\n      text-align: center;\n    }\n    .controls button {\n      margin: 5px;\n      padding: 10px 20px;\n      font-size: 18px;\n      border: 2px solid #007bff;\n      border-radius: 5px;\n      background-color: #007bff;\n      color: white;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #005f99;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div class=\"game-board\" id=\"board\"></div>\n    <div class=\"controls\">\n      <button onclick=\"makeMove()\">Make Move</button>\n    </div>\n  </main>\n\n  <script>\n    const board = document.getElementById('board');\n    const game = {\n      board: [],\n      currentPlayer: 'white',\n      winner: null,\n      gameOver: false\n    };\n\n    // Initialize board\n    for (let row = 0; row < 8; row++) {\n      game.board[row] = [];\n      for (let col = 0; col < 8; col++) {\n        game.board[row][col] = { color: 'white', piece: null };\n      }\n    }\n\n    // Draw board\n    function drawBoard() {\n      for (let row = 0; row < 8; row++) {\n        for (let col = 0; col < 8; col++) {\n          const square = document.createElement('div');\n          square.className = 'square';\n          if (row % 2 === col % 2) {\n            square.className += ' selected';\n          }\n          square.dataset.row = row;\n          square.dataset.col = col;\n          square.addEventListener('click', makeMove);\n          board.appendChild(square);\n        }\n      }\n    }\n\n    // Make a move\n    function makeMove(e) {\n      const row = parseInt(e.target.dataset.row);\n      const col = parseInt(e.target.dataset.col);\n      const piece = game.board[row][col];\n\n      if (!piece || piece.color !== game.currentPlayer) {\n        return;\n      }\n\n      // Check if move is valid\n      if (isValidMove(row, col, game.currentPlayer)) {\n        game.board[row][col].color = game.currentPlayer === 'white' ? 'black' : 'white';\n        game.board[row][col].piece = null;\n        updateBoard();\n        checkForWin();\n        if (game.gameOver) {\n          alert('Game Over!');\n        } else {\n          switchPlayer();\n        }\n      }\n    }\n\n    // Check if move is valid\n    function isValidMove(row, col, player) {\n      // Simple validation for demonstration\n      return true;\n    }\n\n    // Switch player\n    function switchPlayer() {\n      game.currentPlayer = game.currentPlayer === 'white' ? 'black' : 'white';\n    }\n\n    // Check for win\n    function checkForWin() {\n      // Simple win condition for demonstration\n      if (game.board[0][0].color === game.currentPlayer) {\n        game.winner = game.currentPlayer;\n        game.gameOver = true;\n      }\n    }\n\n    // Update board\n    function updateBoard() {\n      for (let row = 0; row < 8; row++) {\n        for (let col = 0; col < 8; col++) {\n          const square = document.createElement('div');\n          square.className = 'square';\n          if (row % 2 === col % 2) {\n            square.className += ' selected';\n          }\n          square.dataset.row = row;\n          square.dataset.col = col;\n          square.addEventListener('click', makeMove);\n          board.appendChild(square);\n        }\n      }\n    }\n\n    // Start the game\n    window.onload = function () {\n      drawBoard();\n    };\n  </script>\n</body>\n</html>"
    }
