  "replaceFiles": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      background-color: #222;\n    }\n    #game {\n      width: 100%;\n      max-width: 800px;\n      padding: 20px;\n      background-color: #111;\n      border: 1px solid #333;\n      box-shadow: 0 0 10px rgba(0,0,0,0.5);\n    }\n    h1 {\n      color: #fff;\n    }\n    .game-area {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n      gap: 10px;\n      margin-top: 20px;\n    }\n    .piece {\n      width: 60px;\n      height: 60px;\n      background-color: #444;\n      border: 1px solid #666;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 24px;\n      color: #fff;\n      text-align: center;\n      border-radius: 5px;\n      cursor: pointer;\n    }\n    .piece:hover {\n      background-color: #666;\n    }\n    .piece.selected {\n      background-color: #000;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div class=\"game-area\" id=\"game-area\"></div>\n  </main>\n  <script>\n    const gameArea = document.getElementById('game-area');\n    const game = {\n      board: [\n        ['wR', 'wN', 'wB', 'wQ', 'wK', 'wB', 'wN', 'wR'],\n        ['wP', 'wP', 'wP', 'wP', 'wP', 'wP', 'wP', 'wP'],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', '']\n      ],\n      currentPlayer: 'w',\n      selectedPiece: null,\n      gameOver: false\n    };\n\n    function createPiece(piece, color) {\n      const pieceDiv = document.createElement('div');\n      pieceDiv.className = 'piece';\n      pieceDiv.textContent = color === 'w' ? 'W' : 'B';\n      pieceDiv.dataset.piece = piece;\n      pieceDiv.dataset.color = color;\n      return pieceDiv;\n    }\n\n    function renderBoard() {\n      gameArea.innerHTML = '';\n      for (let row = 0; row < 8; row++) {\n        for (let col = 0; col < 8; col++) {\n          const piece = game.board[row][col];\n          const pieceDiv = createPiece(piece, game.board[row][col] === 'w' ? 'w' : 'b');\n          if (piece === '') {\n            pieceDiv.classList.add('empty');\n          }\n          gameArea.appendChild(pieceDiv);\n        }\n      }\n    }\n\n    function selectPiece(row, col) {\n      if (game.selectedPiece) {\n        game.selectedPiece.classList.remove('selected');\n      }\n      game.selectedPiece = document.querySelector(`[data-piece=\"${game.board[row][col]}\"]`);\n      game.selectedPiece.classList.add('selected');\n    }\n\n    function makeMove(fromRow, fromCol, toRow, toCol) {\n      if (game.selectedPiece && game.selectedPiece.dataset.piece === `${game.currentPlayer}P`) {\n        const from = game.board[fromRow][fromCol];\n        const to = game.board[toRow][toCol];\n\n        if (from === '' || to === '') {\n          return false;\n        }\n\n        game.board[fromRow][fromCol] = '';\n        game.board[toRow][toCol] = game.currentPlayer;\n\n        game.currentPlayer = game.currentPlayer === 'w' ? 'b' : 'w';\n        game.selectedPiece = null;\n\n        return true;\n      }\n      return false;\n    }\n\n    function checkGameOver() {\n      const emptyRows = game.board.flat().filter(cell => cell === '');\n      if (emptyRows.length === 64) {\n        return true;\n      }\n      return false;\n    }\n\n    function restartGame() {\n      game.board = [\n        ['wR', 'wN', 'wB', 'wQ', 'wK', 'wB', 'wN', 'wR'],\n        ['wP', 'wP', 'wP', 'wP', 'wP', 'wP', 'wP', 'wP'],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', ''],\n        ['', '', '', '', '', '', '', '']\n      ];\n      game.currentPlayer = 'w';\n      game.selectedPiece = null;\n      game.gameOver = false;\n    }\n\n    document.addEventListener('click', (e) => {\n      const target = e.target;\n      if (target.classList.contains('piece') && !target.classList.contains('selected')) {\n        const row = target.dataset.row;\n        const col = target.dataset.col;\n        selectPiece(parseInt(row), parseInt(col));\n      }\n    });\n\n    document.addEventListener('keydown', (e) => {\n      if (e.key === ' ') {\n        if (game.selectedPiece) {\n          const row = game.selectedPiece.dataset.row;\n          const col = game.selectedPiece.dataset.col;\n          const toRow = parseInt(row) + 1;\n          const toCol = parseInt(col);\n          if (makeMove(parseInt(row), parseInt(col), toRow, toCol)) {\n            renderBoard();\n          }\n        }\n      }\n    });\n\n    renderBoard();\n  </script>\n</body>\n</html>"
    }
  ],
