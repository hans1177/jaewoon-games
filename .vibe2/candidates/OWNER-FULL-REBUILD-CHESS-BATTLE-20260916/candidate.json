  "replaceFiles": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #f0f0f0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      text-align: center;\n    }\n    h1 {\n      margin: 20px 0;\n    }\n    .chess-board {\n      display: grid;\n      grid-template-columns: repeat(8, 60px);\n      grid-template-rows: repeat(8, 60px);\n      gap: 5px;\n      margin: 20px;\n      background-color: #fff;\n      border: 2px solid #ccc;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0,0,0,0.1);\n    }\n    .square {\n      width: 60px;\n      height: 60px;\n      background-color: #eee;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 24px;\n      color: #333;\n      border: 1px solid #999;\n      cursor: pointer;\n    }\n    .square.selected {\n      background-color: #007bff;\n      color: white;\n    }\n    .square.occupied {\n      background-color: #007bff;\n      color: white;\n    }\n    .square.empty {\n      background-color: #fff;\n      color: #999;\n    }\n    .controls {\n      margin: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    .controls button {\n      margin: 5px;\n      padding: 10px 20px;\n      font-size: 18px;\n      border: 2px solid #007bff;\n      border-radius: 5px;\n      background-color: #007bff;\n      color: white;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #005f99;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2 Chess Battle</h1>\n    <div class=\"chess-board\" id=\"chessBoard\"></div>\n    <div class=\"controls\">\n      <button onclick=\"makeMove()\">Make Move</button>\n      <button onclick=\"restartGame()\">Restart Game</button>\n    </div>\n  </main>\n  <script>\n    const board = document.getElementById('chessBoard');\n    const game = {\n      board: [],\n      currentPlayer: 'white',\n      currentMove: null,\n      isGameOver: false,\n      ai: {\n        name: 'AI',\n        color: 'black',\n        moves: []\n      },\n      pieces: {\n        white: ['R', 'N', 'B', 'Q', 'K', 'B', 'N', 'R'],\n        black: ['R', 'N', 'B', 'Q', 'K', 'B', 'N', 'R']\n      }\n    };\n\n    function createBoard() {\n      for (let row = 0; row < 8; row++) {\n        const rowDiv = document.createElement('div');\n        rowDiv.className = 'row';\n        for (let col = 0; col < 8; col++) {\n          const square = document.createElement('div');\n          square.className = 'square';\n          square.dataset.row = row;\n          square.dataset.col = col;\n          square.addEventListener('click', () => selectSquare(square));\n          rowDiv.appendChild(square);\n        }\n        board.appendChild(rowDiv);\n      }\n    }\n\n    function selectSquare(square) {\n      if (square.classList.contains('selected') || square.classList.contains('occupied')) return;\n\n      const row = parseInt(square.dataset.row);\n      const col = parseInt(square.dataset.col);\n\n      if (game.currentMove) {\n        square.classList.add('selected');\n        square.style.backgroundColor = '#007bff';\n        square.style.color = 'white';\n        game.currentMove = null;\n      } else {\n        square.classList.add('selected');\n        square.style.backgroundColor = '#007bff';\n        square.style.color = 'white';\n      }\n    }\n\n    function makeMove() {\n      if (!game.currentMove) {\n        alert('Make a move first!');\n        return;\n      }\n\n      const row = parseInt(game.currentMove.square.dataset.row);\n      const col = parseInt(game.currentMove.square.dataset.col);\n\n      const piece = game.board[row][col];\n      const targetRow = parseInt(game.currentMove.targetRow);\n      const targetCol = parseInt(game.currentMove.targetCol);\n\n      if (piece === 'K' && targetRow === row + 1 && targetCol === col) {\n        // Pawn promotion\n        const promotionPiece = prompt('Promote to (R/N/B/Q):');\n        if (promotionPiece) {\n          game.board[row][col] = promotionPiece;\n          game.currentMove = null;\n          return;\n        }\n      } else if (piece === 'R' && targetRow === row - 1 && targetCol === col) {\n        // Rook move\n        game.board[row][col] = 'R';\n        game.board[targetRow][targetCol] = 'R';\n        game.currentMove = null;\n        return;\n      } else if (piece === 'N' && targetRow === row + 1 && targetCol === col) {\n        // Knight move\n        game.board[row][col] = 'N';\n        game.board[targetRow][targetCol] = 'N';\n        game.currentMove = null;\n        return;\n      } else if (piece === 'B' && targetRow === row + 1 && targetCol === col) {\n        // Bishop move\n        game.board[row][col] = 'B';\n        game.board[targetRow][targetCol] = 'B';\n        game.currentMove = null;\n        return;\n      } else if (piece === 'Q' && targetRow === row + 1 && targetCol === col) {\n        // Queen move\n        game.board[row][col] = 'Q';\n        game.board[targetRow][targetCol] = 'Q';\n        game.currentMove = null;\n        return;\n      } else if (piece === 'K' && targetRow === row - 1 && targetCol === col) {\n        // King move\n        game.board[row][col] = 'K';\n        game.board[targetRow][targetCol] = 'K';\n        game.currentMove = null;\n        return;\n      } else {\n        alert('Invalid move!');\n        return;\n      }\n    }\n\n    function restartGame() {\n      game.board = [];\n      game.currentMove = null;\n      game.isGameOver = false;\n      game.ai.moves = [];\n      createBoard();\n    }\n\n    // Initialize game\n    createBoard();\n  </script>\n</body>\n</html>"
    }
  ],
