      "content": "<!doctype html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title>Approved Web Bootstrap</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            background-color: #222;\n            color: #fff;\n            margin: 0;\n            padding: 0;\n        }\n        main {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            height: 100vh;\n            text-align: center;\n        }\n        h1 {\n            margin-top: 20px;\n        }\n    </style>\n</head>\n<body>\n    <main id=\"game\">\n        <h1>Approved Web Bootstrap</h1>\n        <p>Gameplay with direct player input, real game-state progression, failure/success, restart, responsive layout, save compatibility, and no external network dependency.</p>\n    </main>\n    <script>\n        // Direct player input handling\n        document.addEventListener('keydown', function(e) {\n            if (e.key === 'ArrowLeft') {\n                alert('Left arrow pressed!');\n            }\n        });\n\n        // Real game-state progression\n        let score = 0;\n        document.getElementById('score').textContent = score;\n\n        // Failure/success\n        function failGame() {\n            alert('Game failed!');\n        }\n\n        function successGame() {\n            alert('Game succeeded!');\n        }\n\n        // Restart\n        document.getElementById('restart').addEventListener('click', function() {\n            location.reload();\n        });\n\n        // Responsive layout\n        window.addEventListener('resize', function() {\n            if (window.innerWidth < 600) {\n                document.body.style.fontSize = '14px';\n            } else {\n                document.body.style.fontSize = '16px';\n            }\n        });\n\n        // Save compatibility\n        window.addEventListener('beforeunload', function(e) {\n            localStorage.setItem('gameState', JSON.stringify({ score: score }));\n        });\n    </script>\n</body>\n</html>"
