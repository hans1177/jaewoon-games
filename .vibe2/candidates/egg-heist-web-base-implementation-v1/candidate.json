            </div>\n                    <div class=\"game-buttons\">\n                        <button class=\"start-button\">Start</button>\n                        <button class=\"restart-button\">Restart</button>\n                    </div>\n                </div>\n            `;\n        }\n    </script>\n</body>\n</html>"
