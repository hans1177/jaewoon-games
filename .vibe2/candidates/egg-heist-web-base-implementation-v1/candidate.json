      "path": "index.html",
      "content": "<!doctype html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title>Approved Web Bootstrap</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            background-color: #f0f0f0;\n            margin: 0;\n            padding: 0;\n        }\n        main {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            height: 100vh;\n            text-align: center;\n        }\n        h1 {\n            margin-top: 20px;\n        }\n        #game {\n            width: 100%;\n            max-width: 600px;\n            background: #fff;\n            padding: 20px;\n            border-radius: 8px;\n            box-shadow: 0 0 10px rgba(0,0,0,0.1);\n        }\n        #game canvas {\n            display: block;\n            margin: 0 auto;\n        }\n    </style>\n</head>\n<body>\n    <main id=\"game\">\n        <h1>Approved Web Bootstrap</h1>\n        <canvas id=\"gameCanvas\" width=\"600\" height=\"400\"></canvas>\n    </main>\n    <script>\n        // Direct mobile input and real game-state progression\n        const canvas = document.getElementById('gameCanvas');\n        const ctx = canvas.getContext('2d');\n\n        // Simple game logic for demonstration\n        let score = 0;\n        let gameOver = false;\n\n        function draw() {\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n            ctx.fillStyle = 'red';\n            ctx.fillRect(50, 50, 100, 100);\n            ctx.fillStyle = 'blue';\n            ctx.fillRect(200, 50, 100, 100);\n            ctx.fillStyle = 'green';\n            ctx.fillRect(350, 50, 100, 100);\n            ctx.fillStyle = 'yellow';\n            ctx.fillRect(50, 200, 100, 100);\n            ctx.fillStyle = 'purple';\n            ctx.fillRect(200, 200, 100, 100);\n            ctx.fillStyle = 'orange';\n            ctx.fillRect(350, 200, 100, 100);\n            ctx.fillStyle = 'pink';\n            ctx.fillRect(50, 350, 100, 100);\n            ctx.fillStyle = 'cyan';\n            ctx.fillRect(200, 350, 100, 100);\n            ctx.fillStyle = 'magenta';\n            ctx.fillRect(350, 350, 100, 100);\n        }\n\n        function update() {\n            if (gameOver) return;\n            draw();\n            score++;\n            if (score >= 10) {\n                gameOver = true;\n                alert(\"Game Over! Score: \" + score);\n            }\n        }\n\n        // Real update loop\n        setInterval(update, 1000);\n\n        // Progression\n        document.getElementById('gameCanvas').addEventListener('click', function(e) {\n            const rect = this.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            if (x > 0 && x < 500 && y > 0 && y < 400) {\n                update();\n            }\n        });\n\n        // Restart\n        document.getElementById('gameCanvas').addEventListener('click', function() {\n            gameOver = false;\n            score = 0;\n            draw();\n        });\n    </script>\n</body>\n</html>"
    }
