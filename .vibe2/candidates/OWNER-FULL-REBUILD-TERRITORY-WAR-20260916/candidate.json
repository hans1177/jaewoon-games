      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding: 20px;\n    }\n    h1 {\n      margin-bottom: 20px;\n    }\n    #game {\n      width: 100%;\n      max-width: 800px;\n      background: #111;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    #map {\n      width: 100%;\n      height: 400px;\n      background-color: #333;\n      border: 1px solid #555;\n      margin-bottom: 20px;\n    }\n    #status {\n      width: 100%;\n      max-width: 600px;\n      background: #222;\n      padding: 10px;\n      border-radius: 4px;\n      box-shadow: 0 0 5px rgba(0, 0, 0, 0.3);\n    }\n    #controls {\n      width: 100%;\n      max-width: 600px;\n      background: #333;\n      padding: 10px;\n      border-radius: 4px;\n      box-shadow: 0 0 5px rgba(0, 0, 0, 0.3);\n    }\n    #game-over {\n      width: 100%;\n      max-width: 600px;\n      background: #222;\n      padding: 10px;\n      border-radius: 4px;\n      box-shadow: 0 0 5px rgba(0, 0, 0, 0.3);\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div id=\"map\"></div>\n    <div id=\"status\">\n      <h2>Status</h2>\n      <p id=\"status-text\"></p>\n    </div>\n    <div id=\"controls\">\n      <h2>Controls</h2>\n      <p>Touch or click to move. Touch or click to attack. Touch or click to retreat.</p>\n    </div>\n    <div id=\"game-over\">\n      <h2>Game Over</h2>\n      <p id=\"game-over-text\"></p>\n    </div>\n  </main>\n\n  <script>\n    const map = document.getElementById('map');\n    const statusText = document.getElementById('status-text');\n    const gameOverText = document.getElementById('game-over-text');\n\n    let game = {\n      player: { x: 0, y: 0 },\n      map: {\n        width: 10,\n        height: 10,\n        cells: Array(100).fill(null).map((_, i) => ({ id: i, isOccupied: false }))\n      },\n      turn: 0,\n      winner: null\n    };\n\n    function drawMap() {\n      map.innerHTML = '';\n      for (let y = 0; y < game.map.height; y++) {\n        for (let x = 0; x < game.map.width; x++) {\n          const cell = game.map.cells[y * game.map.width + x];\n          const div = document.createElement('div');\n          div.style.width = '30px';\n          div.style.height = '30px';\n          div.style.backgroundColor = cell ? '#00ff00' : '#333';\n          div.style.border = '1px solid #555';\n          div.style.display = 'inline-block';\n          div.style.margin = '2px';\n          div.draggable = true;\n          div.addEventListener('dragstart', (e) => {\n            e.dataTransfer.setData('text/plain', e.target.id);\n          });\n          div.addEventListener('dragend', () => {\n            if (e.target.id) {\n              game.player.x = parseInt(e.target.id.split('')[0]);\n              game.player.y = parseInt(e.target.id.split('')[2]);\n            }\n          });\n          map.appendChild(div);\n        }\n      }\n    }\n\n    function updateStatus() {\n      statusText.textContent = `Turn: ${game.turn}`;\n    }\n\n    function checkWin() {\n      // Simple win condition for demo\n      if (game.player.x === 9 && game.player.y === 9) {\n        game.winner = 'Player';\n        return true;\n      }\n      return false;\n    }\n\n    function handleMove(dx, dy) {\n      const newX = game.player.x + dx;\n      const newY = game.player.y + dy;\n      if (newX >= 0 && newX < game.map.width && newY >= 0 && newY < game.map.height) {\n        game.player.x = newX;\n        game.player.y = newY;\n        updateStatus();\n        if (checkWin()) {\n          gameOverText.textContent = 'You win!';\n          return true;\n        }\n        return false;\n      }\n      return false;\n    }\n\n    function handleAttack() {\n      // Simple attack logic for demo\n      if (game.player.x === 9 && game.player.y === 9) {\n        game.winner = 'Computer';\n        return true;\n      }\n      return false;\n    }\n\n    function handleRetreat() {\n      // Simple retreat logic for demo\n      if (game.player.x > 0) {\n        game.player.x--;\n        updateStatus();\n        if (checkWin()) {\n          gameOverText.textContent = 'You win!';\n          return true;\n        }\n        return false;\n      }\n      return false;\n    }\n\n    function handleTouch(e) {\n      const rect = map.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      const cellId = (x / 30) * 100 + (y / 30) * 10;\n      if (cellId < 100) {\n        const cell = game.map.cells[cellId];\n        if (cell && cell.isOccupied) {\n          if (x < 30 && y < 30) {\n            // Attack\n            if (handleAttack()) {\n              gameOverText.textContent = 'Computer wins!';\n            }\n          } else if (x > 30 && y < 30) {\n            // Retreat\n            if (handleRetreat()) {\n              gameOverText.textContent = 'You win!';\n            }\n          }\n        }\n      }\n    }\n\n    document.addEventListener('touchstart', handleTouch);\n    document.addEventListener('click', handleTouch);\n\n    drawMap();\n    updateStatus();\n  </script>\n</body>\n</html>"
    }
  ],
