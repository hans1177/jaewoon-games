    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      background-color: #222;\n    }\n    #game {\n      width: 100%;\n      max-width: 800px;\n      padding: 20px;\n      background-color: #111;\n      border: 1px solid #333;\n      box-shadow: 0 0 10px rgba(0,0,0,0.5);\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .game-header {\n      text-align: center;\n      color: #fff;\n      font-size: 24px;\n      font-weight: bold;\n    }\n    .game-controls {\n      display: flex;\n      gap: 10px;\n      flex-wrap: wrap;\n      justify-content: center;\n    }\n    .game-controls button {\n      padding: 10px 15px;\n      font-size: 16px;\n      border: 1px solid #444;\n      border-radius: 5px;\n      background-color: #333;\n      color: #fff;\n      cursor: pointer;\n      transition: background-color 0.2s;\n    }\n    .game-controls button:hover {\n      background-color: #555;\n    }\n    .game-board {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));\n      gap: 10px;\n      width: 100%;\n      max-width: 600px;\n      background-color: #222;\n      padding: 10px;\n      border: 1px solid #555;\n      box-shadow: 0 0 10px rgba(0,0,0,0.3);\n    }\n    .game-board .cell {\n      width: 100px;\n      height: 100px;\n      background-color: #444;\n      border: 1px solid #666;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 24px;\n      color: #fff;\n      cursor: pointer;\n      transition: background-color 0.2s;\n    }\n    .game-board .cell:hover {\n      background-color: #666;\n    }\n    .game-board .cell.selected {\n      background-color: #00ff00;\n    }\n    .game-board .cell.enemy {\n      background-color: #ff0000;\n    }\n    .game-board .cell.empty {\n      background-color: #333;\n    }\n    .game-footer {\n      text-align: center;\n      color: #aaa;\n      font-size: 14px;\n      margin-top: 20px;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"game-header\">Vibe2</div>\n    <div class=\"game-controls\">\n      <button onclick=\"startGame()\">Start Game</button>\n      <button onclick=\"restartGame()\">Restart</button>\n    </div>\n    <div class=\"game-board\" id=\"gameBoard\"></div>\n    <div class=\"game-footer\">© 2025 Vibe2</div>\n  </main>\n  <script>\n    const gameBoard = document.getElementById('gameBoard');\n    const gameContainer = document.getElementById('game');\n\n    let game = null;\n    let isGameOver = false;\n\n    function startGame() {\n      game = {\n        board: createBoard(),\n        currentPlayer: 'player',\n        turn: 0,\n        winner: null,\n        isRestart: false\n      };\n      isGameOver = false;\n      gameContainer.innerHTML = '';\n      gameBoard.innerHTML = '';\n      renderGame();\n    }\n\n    function restartGame() {\n      game = {\n        board: createBoard(),\n        currentPlayer: 'player',\n        turn: 0,\n        winner: null,\n        isRestart: true\n      };\n      isGameOver = false;\n      gameContainer.innerHTML = '';\n      gameBoard.innerHTML = '';\n      renderGame();\n    }\n\n    function createBoard() {\n      const board = [];\n      for (let row = 0; row < 5; row++) {\n        board[row] = [];\n        for (let col = 0; col < 5; col++) {\n          board[row][col] = { player: null, enemy: null, empty: true };\n        }\n      }\n      return board;\n    }\n\n    function renderGame() {\n      gameContainer.innerHTML = '';\n      gameBoard.innerHTML = '';\n      for (let row = 0; row < 5; row++) {\n        for (let col = 0; col < 5; col++) {\n          const cell = document.createElement('div');\n          cell.classList.add('cell');\n          if (game.board[row][col].empty) {\n            cell.classList.add('empty');\n          } else if (game.board[row][col].player) {\n            cell.classList.add('player');\n            cell.style.backgroundColor = '#00ff00';\n          } else if (game.board[row][col].enemy) {\n            cell.classList.add('enemy');\n            cell.style.backgroundColor = '#ff0000';\n          }\n          gameBoard.appendChild(cell);\n        }\n      }\n    }\n\n    function handleCellClick(e) {\n      const cell = e.target;\n      const row = cell.dataset.row;\n      const col = cell.dataset.col;\n\n      if (isGameOver) return;\n\n      if (game.board[row][col].empty) {\n        game.board[row][col].player = game.currentPlayer;\n        game.board[row][col].empty = false;\n        game.currentPlayer = game.currentPlayer === 'player' ? 'enemy' : 'player';\n        game.turn++;\n        renderGame();\n      } else if (game.board[row][col].player === game.currentPlayer) {\n        game.board[row][col].player = null;\n        game.board[row][col].empty = true;\n        game.currentPlayer = game.currentPlayer === 'player' ? 'enemy' : 'player';\n        game.turn++;\n        renderGame();\n      } else if (game.board[row][col].enemy === game.currentPlayer) {\n        game.board[row][col].enemy = null;\n        game.board[row][col].empty = true;\n        game.currentPlayer = game.currentPlayer === 'player' ? 'enemy' : 'player';\n        game.turn++;\n        renderGame();\n      } else {\n        game.isGameOver = true;\n        game.winner = game.currentPlayer;\n        renderGame();\n      }\n    }\n\n    gameBoard.addEventListener('click', handleCellClick);\n  </script>\n</body>\n</html>"
    }
  ],
