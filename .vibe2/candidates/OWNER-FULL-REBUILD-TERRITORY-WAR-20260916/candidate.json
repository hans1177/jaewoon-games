    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding: 20px;\n    }\n    h1 {\n      margin-bottom: 10px;\n    }\n    #game {\n      width: 100%;\n      max-width: 800px;\n      height: 600px;\n      background-color: #111;\n      border: 2px solid #333;\n      border-radius: 10px;\n      overflow: hidden;\n    }\n    #game canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n    #controls {\n      margin-top: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    #controls button {\n      margin: 5px;\n      padding: 10px 20px;\n      font-size: 16px;\n      border: 2px solid #fff;\n      border-radius: 5px;\n      background-color: #333;\n      color: #fff;\n      cursor: pointer;\n    }\n    #controls button:hover {\n      background-color: #555;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\"></main>\n  <div id=\"controls\">\n    <button onclick=\"startGame()\">Start Game</button>\n    <button onclick=\"restartGame()\">Restart</button>\n  </div>\n\n  <script>\n    const gameContainer = document.getElementById('game');\n    const controls = document.getElementById('controls');\n\n    let game = null;\n\n    function startGame() {\n      game = new Game();\n      gameContainer.innerHTML = '';\n      game.draw();\n      controls.innerHTML = '';\n    }\n\n    function restartGame() {\n      if (game) {\n        game = null;\n        gameContainer.innerHTML = '';\n        controls.innerHTML = '';\n        startGame();\n      }\n    }\n\n    class Game {\n      constructor() {\n        this.map = new Map();\n        this.player = new Player();\n        this.ai = new AI();\n        this.progression = new Progression();\n        this.ui = new UI();\n        this.saveState = new SaveState();\n      }\n\n      draw() {\n        const canvas = document.createElement('canvas');\n        canvas.width = 800;\n        canvas.height = 600;\n        gameContainer.appendChild(canvas);\n        this.map.draw(canvas);\n        this.player.draw(canvas);\n        this.ai.draw(canvas);\n        this.progression.draw(canvas);\n        this.ui.draw(canvas);\n      }\n\n      update() {\n        this.map.update();\n        this.player.update();\n        this.ai.update();\n        this.progression.update();\n        this.ui.update();\n      }\n\n      render() {\n        const canvas = document.querySelector('#game canvas');\n        canvas.width = 800;\n        canvas.height = 600;\n        this.map.render(canvas);\n        this.player.render(canvas);\n        this.ai.render(canvas);\n        this.progression.render(canvas);\n        this.ui.render(canvas);\n      }\n\n      start() {\n        this.update();\n        this.render();\n        setInterval(() => {\n          this.update();\n          this.render();\n        }, 1000);\n      }\n    }\n\n    class Map {\n      constructor() {\n        this.grid = new Grid(10, 10);\n        this.playerPosition = { x: 0, y: 0 };\n      }\n\n      draw(canvas) {\n        const ctx = canvas.getContext('2d');\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\n        this.grid.draw(ctx);\n      }\n\n      update() {\n        this.playerPosition = this.ai.getMove(this.playerPosition);\n        this.grid.setTile(this.playerPosition.x, this.playerPosition.y, 'player');\n      }\n\n      getMove(position) {\n        // Simple AI for demonstration\n        return { x: position.x, y: position.y };\n      }\n    }\n\n    class Grid {\n      constructor(rows, cols) {\n        this.rows = rows;\n        this.cols = cols;\n        this.tiles = new Array(rows).fill(0).map(() => new Array(cols).fill('empty'));\n      }\n\n      draw(ctx) {\n        for (let y = 0; y < this.rows; y++) {\n          for (let x = 0; x < this.cols; x++) {\n            ctx.fillStyle = this.tiles[y][x] === 'player' ? 'green' : this.tiles[y][x] === 'enemy' ? 'red' : 'gray';\n            ctx.fillRect(x * 64, y * 64, 64, 64);\n          }\n        }\n      }\n\n      setTile(x, y, type) {\n        this.tiles[y][x] = type;\n      }\n    }\n\n    class Player {\n      constructor() {\n        this.position = { x: 0, y: 0 };\n      }\n\n      draw(ctx) {\n        ctx.fillStyle = 'blue';\n        ctx.fillRect(this.position.x * 64, this.position.y * 64, 64, 64);\n      }\n\n      update() {\n        this.position = this.ai.getMove(this.position);\n      }\n    }\n\n    class AI {\n      constructor() {\n        this.directions = [\n          { x: 0, y: 1 },\n          { x: 1, y: 0 },\n          { x: 0, y: -1 },\n          { x: -1, y: 0 }\n        ];\n      }\n\n      getMove(position) {\n        // Simple AI for demonstration\n        return this.directions[Math.floor(Math.random() * this.directions.length)];\n      }\n    }\n\n    class Progression {\n      constructor() {\n        this.difficulty = 1;\n        this.score = 0;\n      }\n\n      draw(ctx) {\n        ctx.fillStyle = 'yellow';\n        ctx.fillRect(500, 500, 100, 30);\n        ctx.fillStyle = 'red';\n        ctx.fillRect(520, 510, 80, 20);\n        ctx.fillStyle = 'green';\n        ctx.fillRect(540, 520, 60, 20);\n      }\n\n      update() {\n        this.difficulty += 0.1;\n        this.score += 10;\n      }\n    }\n\n    class UI {\n      constructor() {\n        this.score = 0;\n      }\n\n      draw(ctx) {\n        ctx.fillStyle = 'white';\n        ctx.font = '16px Arial';\n        ctx.fillText(`Score: ${this.score}`, 10, 30);\n      }\n\n      update() {\n        this.score += 10;\n      }\n    }\n\n    class SaveState {\n      constructor() {\n        this.state = {\n          difficulty: 1,\n          score: 0\n        };\n      }\n\n      save() {\n        localStorage.setItem('vibe2_state', JSON.stringify(this.state));\n      }\n\n      load() {\n        if (localStorage.getItem('vibe2_state')) {\n          this.state = JSON.parse(localStorage.getItem('vibe2_state'));\n        }\n      }\n    }\n\n    // Initialize game\n    window.onload = () => {\n      startGame();\n    };\n  </script>\n</body>\n</html>"
    }
