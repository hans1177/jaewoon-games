      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      text-align: center;\n    }\n    h1 {\n      margin-top: 20px;\n    }\n    #game {\n      width: 100%;\n      max-width: 800px;\n      padding: 20px;\n      background-color: #111;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    #game canvas {\n      width: 100%;\n      height: 100%;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <canvas id=\"gameCanvas\"></canvas>\n  </main>\n  <script>\n    // Game logic here\n    const canvas = document.getElementById('gameCanvas');\n    const ctx = canvas.getContext('2d');\n\n    // Game initialization\n    function initGame() {\n      // Initialize game state\n      const game = {\n        map: {\n          width: 10,\n          height: 10,\n          cells: Array(100).fill(null)\n        },\n        player: {\n          x: 4,\n          y: 4,\n          direction: 'right'\n        },\n        enemies: [],\n        score: 0\n      };\n\n      // Draw game\n      function draw() {\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\n        // Draw map\n        for (let y = 0; y < game.map.height; y++) {\n          for (let x = 0; x < game.map.width; x++) {\n            if (game.map.cells[y * game.map.width + x]) {\n              ctx.fillStyle = '#444';\n              ctx.fillRect(x * 30, y * 30, 30, 30);\n            }\n          }\n        }\n        // Draw player\n        ctx.fillStyle = '#00ff00';\n        ctx.fillRect(game.player.x * 30, game.player.y * 30, 30, 30);\n        // Draw enemies\n        game.enemies.forEach(enemy => {\n          ctx.fillStyle = '#ff0000';\n          ctx.fillRect(enemy.x * 30, enemy.y * 30, 30, 30);\n        });\n        // Draw score\n        ctx.fillStyle = '#fff';\n        ctx.font = '16px Arial';\n        ctx.fillText(`Score: ${game.score}`, 10, 20);\n      }\n\n      // Game loop\n      function gameLoop() {\n        draw();\n        requestAnimationFrame(gameLoop);\n      }\n\n      gameLoop();\n    }\n\n    // Handle player input\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'ArrowRight') {\n        game.player.direction = 'right';\n      } else if (e.key === 'ArrowLeft') {\n        game.player.direction = 'left';\n      } else if (e.key === 'ArrowUp') {\n        game.player.direction = 'up';\n      } else if (e.key === 'ArrowDown') {\n        game.player.direction = 'down';\n      }\n    });\n\n    // Handle enemy AI\n    function enemyAI() {\n      // Simple AI for enemies\n      game.enemies.forEach((enemy, index) => {\n        if (game.player.direction === 'right') {\n          if (enemy.x < game.player.x) {\n            enemy.x++;\n          } else if (enemy.x > game.player.x) {\n            enemy.x--;\n          }\n        } else if (game.player.direction === 'left') {\n          if (enemy.x > game.player.x) {\n            enemy.x--;\n          } else if (enemy.x < game.player.x) {\n            enemy.x++;\n          }\n        } else if (game.player.direction === 'up') {\n          if (enemy.y < game.player.y) {\n            enemy.y++;\n          } else if (enemy.y > game.player.y) {\n            enemy.y--;\n          }\n        } else if (game.player.direction === 'down') {\n          if (enemy.y < game.player.y) {\n            enemy.y--;\n          } else if (enemy.y > game.player.y) {\n            enemy.y++;\n          }\n        }\n      });\n    }\n\n    // Handle collision detection\n    function checkCollision() {\n      // Simple collision detection\n      for (let i = 0; i < game.enemies.length; i++) {\n        const enemy = game.enemies[i];\n        if (enemy.x === game.player.x && enemy.y === game.player.y) {\n          game.score = 0;\n          game.enemies.splice(i, 1);\n          return true;\n        }\n      }\n      return false;\n    }\n\n    // Handle restart\n    document.addEventListener('click', () => {\n      game.player.x = 4;\n      game.player.y = 4;\n      game.score = 0;\n      game.enemies = [];\n      initGame();\n    });\n\n    // Start game\n    initGame();\n  </script>\n</body>\n</html>"
    }
