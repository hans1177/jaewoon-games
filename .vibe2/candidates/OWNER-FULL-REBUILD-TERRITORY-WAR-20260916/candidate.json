      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n      background-color: #222;\n      color: #fff;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      padding: 20px;\n    }\n    h1 {\n      margin-bottom: 20px;\n    }\n    #game {\n      width: 100%;\n      max-width: 800px;\n      background: #111;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\n    }\n    #turn-feedback {\n      margin-bottom: 20px;\n    }\n    #controls {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n      justify-content: center;\n    }\n    .control {\n      flex: 1 1 25%;\n      background: #333;\n      padding: 10px;\n      border-radius: 4px;\n      box-shadow: 0 0 5px rgba(0, 0, 0, 0.3);\n      transition: transform 0.2s;\n    }\n    .control:hover {\n      transform: scale(1.02);\n    }\n    .control.active {\n      background: #555;\n    }\n    #status {\n      margin-top: 20px;\n      font-size: 1.2em;\n      font-weight: bold;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <h1>Vibe2</h1>\n    <div id=\"turn-feedback\"></div>\n    <div id=\"controls\">\n      <div class=\"control\" data-action=\"move\">Move</div>\n      <div class=\"control\" data-action=\"attack\">Attack</div>\n      <div class=\"control\" data-action=\"defend\">Defend</div>\n      <div class=\"control\" data-action=\"restart\">Restart</div>\n    </div>\n    <div id=\"status\"></div>\n  </main>\n\n  <script>\n    const game = document.getElementById('game');\n    const turnFeedback = document.getElementById('turn-feedback');\n    const controls = document.getElementById('controls');\n    const status = document.getElementById('status');\n\n    let currentPlayer = 'player';\n    let gameStatus = 'idle';\n    let turn = 0;\n\n    function updateStatus(message) {\n      status.textContent = message;\n    }\n\n    function updateTurnFeedback(message) {\n      turnFeedback.textContent = message;\n    }\n\n    function handleMove(action) {\n      if (currentPlayer === 'player') {\n        if (action === 'move') {\n          updateStatus('Player moves to a new position.');\n          turn++;\n          if (turn >= 10) {\n            updateStatus('Game over. Player wins!');\n            gameStatus = 'win';\n          }\n        } else if (action === 'attack') {\n          updateStatus('Player attacks the enemy.');\n          turn++;\n          if (turn >= 10) {\n            updateStatus('Game over. Player wins!');\n            gameStatus = 'win';\n          }\n        } else if (action === 'defend') {\n          updateStatus('Player defends against the enemy attack.');\n          turn++;\n          if (turn >= 10) {\n            updateStatus('Game over. Player wins!');\n            gameStatus = 'win';\n          }\n        }\n      } else {\n        updateStatus('Enemy attacks. Player defends.');\n        turn++;\n        if (turn >= 10) {\n          updateStatus('Game over. Enemy wins!');\n          gameStatus = 'loss';\n        }\n      }\n    }\n\n    function handleRestart() {\n      currentPlayer = 'player';\n      gameStatus = 'idle';\n      turn = 0;\n      updateStatus('Game restarted.');\n    }\n\n    function handleControlClick(event) {\n      const control = event.target;\n      const action = control.getAttribute('data-action');\n\n      if (action) {\n        handleMove(action);\n      }\n    }\n\n    controls.addEventListener('click', handleControlClick);\n\n    // Initial game state\n    updateStatus('Game started.');\n    updateTurnFeedback('Turn 0');\n  </script>\n</body>\n</html>"
    }
