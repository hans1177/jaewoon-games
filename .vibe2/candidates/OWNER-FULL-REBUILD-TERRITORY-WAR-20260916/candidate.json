   game.innerHTML = `\n        <h1>Vibe2</h1>\n        <div id=\"controls\">\n          <button id=\"start\">Start</button>\n          <button id=\"restart\">Restart</button>\n        </div>\n        <div id=\"status\">\n          <p id=\"status-text\">Status: <span id=\"status-player\">Player</span></p>\n        </div>\n        <div id=\"map\"></div>\n        <div id=\"info\">\n          <h2>Info</h2>\n          <p>Gameplay loop, restart, progression, UI, and mobile responsiveness</p>\n        </div>\n        <div id=\"score\">\n          <h3>Score</h3>\n          <p id=\"score-text\">Score: <span id=\"score-player\">0</span></p>\n        </div>\n      `;\n    }\n\n    controls.addEventListener('click', (e) => {\n      if (e.target.id === 'start') {\n        startGame();\n      } else if (e.target.id === 'restart') {\n        restartGame();\n      }\n    });\n  </script>\n</body>\n</html>"
