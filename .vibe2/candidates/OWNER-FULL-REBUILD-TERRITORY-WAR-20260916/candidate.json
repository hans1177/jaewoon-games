      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      background-color: #222;\n    }\n    #game {\n      width: 100%;\n      max-width: 800px;\n      padding: 20px;\n      background-color: #111;\n      border: 1px solid #333;\n      box-shadow: 0 0 10px rgba(0,0,0,0.5);\n    }\n    .game-container {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .game-header {\n      text-align: center;\n      font-size: 24px;\n      color: #fff;\n    }\n    .game-content {\n      flex: 1;\n    }\n    .game-buttons {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-top: 10px;\n    }\n    .game-buttons button {\n      padding: 10px 20px;\n      font-size: 16px;\n      background-color: #333;\n      color: #fff;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background-color 0.3s;\n    }\n    .game-buttons button:hover {\n      background-color: #555;\n    }\n    .game-status {\n      text-align: center;\n      font-size: 18px;\n      color: #fff;\n      background-color: #444;\n      padding: 10px;\n      border-radius: 4px;\n      margin-top: 10px;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"game-container\">\n      <div class=\"game-header\">Vibe2</div>\n      <div class=\"game-content\">\n        <div class=\"game-buttons\">\n          <button id=\"startButton\">Start Game</button>\n          <button id=\"restartButton\">Restart</button>\n        </div>\n        <div class=\"game-status\" id=\"status\">Status: Ready</div>\n        <div class=\"game-buttons\">\n          <button id=\"moveUpButton\">Move Up</button>\n          <button id=\"moveDownButton\">Move Down</button>\n        </div>\n        <div class=\"game-buttons\">\n          <button id=\"attackButton\">Attack</button>\n          <button id=\"defendButton\">Defend</button>\n        </div>\n      </div>\n    </div>\n  </main>\n  <script>\n    const gameContainer = document.getElementById('game');\n    const status = document.getElementById('status');\n    const startButton = document.getElementById('startButton');\n    const restartButton = document.getElementById('restartButton');\n    const moveUpButton = document.getElementById('moveUpButton');\n    const moveDownButton = document.getElementById('moveDownButton');\n    const attackButton = document.getElementById('attackButton');\n    const defendButton = document.getElementById('defendButton');\n\n    startButton.addEventListener('click', () => {\n      status.textContent = 'Status: Playing';\n      gameContainer.style.display = 'flex';\n      // Game logic here\n    });\n\n    restartButton.addEventListener('click', () => {\n      status.textContent = 'Status: Ready';\n      gameContainer.style.display = 'none';\n    });\n\n    moveUpButton.addEventListener('click', () => {\n      status.textContent = 'Status: Moving Up';\n      // Game logic here\n    });\n\n    moveDownButton.addEventListener('click', () => {\n      status.textContent = 'Status: Moving Down';\n      // Game logic here\n    });\n\n    attackButton.addEventListener('click', () => {\n      status.textContent = 'Status: Attacking';\n      // Game logic here\n    });\n\n    defendButton.addEventListener('click', () => {\n      status.textContent = 'Status: Defending';\n      // Game logic here\n    });\n  </script>\n</body>\n</html>"
