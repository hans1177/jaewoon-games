ss=\"game-button\" onclick=\"attackEnemy()\">Attack Enemy</button>\n      </div>\n      <div class=\"game-status\">Status: Neutral</div>\n    `;\n\n    gameContainer.appendChild(game);\n\n    function extendTerritory() {\n      // Simulated territory extension\n      game.innerHTML = `\n        <div class=\"game-title\">Territory War</div>\n        <div class=\"game-buttons\">\n          <button class=\"game-button\" onclick=\"extendTerritory()\">Extend Territory</button>\n          <button class=\"game-button\" onclick=\"attackEnemy()\">Attack Enemy</button>\n        </div>\n        <div class=\"game-status\">Status: Extended</div>\n      `;\n    }\n\n    function attackEnemy() {\n      // Simulated attack\n      game.innerHTML = `\n        <div class=\"game-title\">Territory War</div>\n        <div class=\"game-buttons\">\n          <button class=\"game-button\" onclick=\"extendTerritory()\">Extend Territory</button>\n          <button class=\"game-button\" onclick=\"attackEnemy()\">Attack Enemy</button>\n        </div>\n        <div class=\"game-status\">Status: Attack in Progress</div>\n      `;\n    }\n  </script>\n</body>\n</html>"
