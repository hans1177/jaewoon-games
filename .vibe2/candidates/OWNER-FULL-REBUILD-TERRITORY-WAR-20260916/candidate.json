      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Vibe2 bootstrap</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n    main {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      height: 100vh;\n      background-color: #2c3e50;\n    }\n    h1 {\n      color: #ecf0f1;\n    }\n    #game {\n      width: 80%;\n      max-width: 800px;\n      background-color: #34495e;\n      padding: 20px;\n      border-radius: 8px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);\n    }\n    .territory {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 10px;\n    }\n    .territory span {\n      font-size: 16px;\n      color: #ecf0f1;\n    }\n    .controls {\n      display: flex;\n      gap: 10px;\n      margin-top: 10px;\n    }\n    .controls button {\n      padding: 5px 10px;\n      font-size: 14px;\n      border: 1px solid #ecf0f1;\n      border-radius: 4px;\n      background-color: #34495e;\n      color: #ecf0f1;\n      cursor: pointer;\n    }\n    .controls button:hover {\n      background-color: #2c3e50;\n    }\n    .status {\n      margin-top: 10px;\n      font-size: 14px;\n      color: #ecf0f1;\n    }\n  </style>\n</head>\n<body>\n  <main id=\"game\">\n    <div class=\"territory\">\n      <span>Territory</span>\n      <span id=\"territory\"></span>\n    </div>\n    <div class=\"controls\">\n      <button id=\"expand\">Expand</button>\n      <button id=\"attack\">Attack</button>\n      <button id=\"defend\">Defend</button>\n    </div>\n    <div class=\"status\" id=\"status\">Status: <span id=\"statusText\">Ready</span></div>\n  </main>\n  <script>\n    // Simulated territory war logic\n    const territory = document.getElementById('territory');\n    const statusText = document.getElementById('statusText');\n    const expandButton = document.getElementById('expand');\n    const attackButton = document.getElementById('attack');\n    const defendButton = document.getElementById('defend');\n\n    // Simulated territory expansion\n    function expandTerritory() {\n      territory.textContent = 'Expanded Territory';\n      statusText.textContent = 'Status: Expanded';\n    }\n\n    // Simulated attack\n    function attackTerritory() {\n      territory.textContent = 'Attacked Territory';\n      statusText.textContent = 'Status: Attacked';\n    }\n\n    // Simulated defend\n    function defendTerritory() {\n      territory.textContent = 'Defended Territory';\n      statusText.textContent = 'Status: Defended';\n    }\n\n    // Simulated game loop\n    function gameLoop() {\n      const now = new Date().getTime();\n      const elapsed = now - lastUpdate;\n      lastUpdate = now;\n\n      if (elapsed > 1000) {\n        statusText.textContent = 'Status: Updated';\n      }\n\n      // Simulated game logic\n      if (Math.random() < 0.5) {\n        attackButton.disabled = false;\n        defendButton.disabled = true;\n      } else {\n        defendButton.disabled = false;\n        attackButton.disabled = true;\n      }\n    }\n\n    // Initialize game\n    function initGame() {\n      lastUpdate = new Date().getTime();\n      expandButton.disabled = true;\n      attackButton.disabled = true;\n      defendButton.disabled = true;\n      statusText.textContent = 'Status: Ready';\n    }\n\n    // Start game loop\n    function startGameLoop() {\n      setInterval(gameLoop, 1000);\n    }\n\n    // Initialize and start game\n    initGame();\n    startGameLoop();\n  </script>\n</body>\n</html>"
    }
