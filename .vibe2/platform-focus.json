{
  "version": 2,
  "mode": "UNITY_ROBLOX_EQUAL_FIRST_TIER",
  "enabled": true,
  "primaryPlatforms": [
    "unity",
    "roblox"
  ],
  "selection": [
    "readiness",
    "estimated-execution-cost",
    "enqueued-at"
  ],
  "web": {
    "preserveExistingFlow": true
  },
  "policy": {
    "restoreLegacyRobloxPrimaryBlocks": true,
    "deferUnityBecauseRobloxAvailable": false,
    "unityMaintenanceOnly": false,
    "platformBudgetSplit": false,
    "doNotCancelRunningWork": true,
    "doNotBlockOwnerDirectives": true,
    "doNotLowerQa": true,
    "doNotChangeHomepageOrCatalog": true
  }
}
