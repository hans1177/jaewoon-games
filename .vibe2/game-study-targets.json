{
  "version": 1,
  "mode": "server-hourly-24h-parallel-study",
  "maxConcurrentTasks": 30,
  "policy": {
    "execution": "server-only",
    "learningState": ".vibe2/experience.json",
    "publicObservationSourceAccess": "observation-only",
    "sourceAnalysisRequires": "owned-or-authorized-server-workspace",
    "rawSourceCopiedIntoMemory": false,
    "mayAutoCopyGameplayValues": false,
    "mayExpandAuthority": false,
    "robloxPublicExperienceDownload": false,
    "robloxAuthorizedCopyDownloadLearning": true,
    "robloxAuthorizedCopyStudioLearning": false,
    "robloxAuthorizedCopyPermission": "creator-enabled-place-copying",
    "robloxAuthorizedDownloadAuthority": "vibe2-roblox-authorized-download",
    "robloxAuthorizedStudioAuthority": "vibe2-roblox-studio-runtime",
    "robloxAuthorizedDownloadFormat": "rbxlx",
    "robloxUnauthorizedCopyDownload": false,
    "robloxStudioRunnerMustBeExplicitlyReady": true,
    "externalRobloxActiveAutomation": false,
    "externalCopyEnabledRobloxAutomation": true,
    "clientLocalLearning": false,
    "learningInputs": {
      "studioRuntime": true,
      "ownedOrAuthorizedSourceStructure": true,
      "webRuntimeObservation": true,
      "ciQaRegressionEvidence": true,
      "playTelemetry": true,
      "ownerDirectiveFeedback": true,
      "rawExternalSourceMemory": false,
      "studioRuntimeScope": "VERIFIED_STUDIO_RUNTIME_EVIDENCE_ONLY",
      "rawStudioSourceMemory": false
    },
    "robloxMaterialCollector": {
      "enabled": false,
      "tool": "tools/vibe2-game-study-planner-context.mjs",
      "targetEngine": "roblox",
      "verifiedCrossGamePatternsOnly": true,
      "maxMaterialsPerTask": 6,
      "autoConnectBeforeReservation": true,
      "rawSourceIncluded": false,
      "rawGameplayValuesIncluded": false,
      "authorityExpanded": false
    },
    "runtimeReadinessScheduling": {
      "robloxReadinessVariable": "VIBE2_ROBLOX_STUDIO_RUNNER_READY",
      "offlineBehavior": "preserve-queue-without-consuming-study-slot",
      "onlineBehavior": "studio-learning-forbidden-use-non-studio-evidence-only",
      "productionRunnerFallback": false,
      "productionStudioUntouched": true
    },
    "robloxStudioConcurrency": {
      "productionPriority": true,
      "sameWindowsSessionConcurrent": false,
      "sameWindowsSessionBehavior": "defer-study-and-retry-next-cycle",
      "isolatedRunnerOrSessionConcurrent": true,
      "isolatedSessionEnv": "VIBE2_ROBLOX_STUDY_ISOLATED_SESSION",
      "productionBusyEnv": "VIBE2_ROBLOX_STUDIO_PRODUCTION_BUSY",
      "defaultMultiplayerClients": 2,
      "maxStudioTestClients": 8
    }
  },
  "targets": [
    {
      "id": "external-tictactoe-flow-a",
      "enabled": true,
      "origin": "external-public",
      "engine": "web",
      "gameId": "external-tictactoe",
      "url": "https://ramazancetinkaya.github.io/tictactoe/",
      "scenarioFile": ".vibe2/game-study-scenarios/external-tictactoe-flow-a.json",
      "sourceAccess": "observation-only",
      "priority": "low",
      "tags": [
        "external-reference",
        "turn-based",
        "board-state",
        "ai-opponent",
        "restart-confirmation",
        "mit-licensed-reference"
      ]
    },
    {
      "id": "external-tictactoe-flow-b",
      "enabled": true,
      "origin": "external-public",
      "engine": "web",
      "gameId": "external-tictactoe",
      "url": "https://ramazancetinkaya.github.io/tictactoe/",
      "scenarioFile": ".vibe2/game-study-scenarios/external-tictactoe-flow-b.json",
      "sourceAccess": "observation-only",
      "priority": "low",
      "tags": [
        "external-reference",
        "difficulty-selection",
        "turn-feedback",
        "player-action",
        "ai-response",
        "mit-licensed-reference"
      ]
    },
    {
      "id": "external-memory-flow-a",
      "enabled": true,
      "origin": "external-public",
      "engine": "web",
      "gameId": "external-memory-game",
      "url": "https://sitzelwucht.github.io/memory-card-game/",
      "scenarioFile": ".vibe2/game-study-scenarios/external-memory-flow-a.json",
      "sourceAccess": "observation-only",
      "priority": "low",
      "tags": [
        "external-reference",
        "memory-game",
        "board-size-selection",
        "card-interaction",
        "move-feedback"
      ]
    },
    {
      "id": "external-roblox-potion-shop-flow-a",
      "enabled": false,
      "origin": "external-public-copy-enabled",
      "engine": "roblox",
      "gameId": "external-roblox-potion-shop-demo",
      "scenarioFile": ".vibe2/game-study-scenarios/external-roblox-potion-shop-flow-a.json",
      "sourceAccess": "owned-or-authorized-server-workspace",
      "sourceRoot": ".vibe2/authorized-roblox-source/potion-shop-demo",
      "runnerReady": false,
      "command": "node",
      "commandArgs": [
        "tools/vibe2-roblox-studio-cli-runner.mjs",
        "--place-id=14215142052",
        "--copy-permission=creator-enabled-place-copying",
        "--permission-evidence=https://create.roblox.com/docs/cloud/guides/instance#potion-shop-demo",
        "--source-root=.vibe2/authorized-roblox-source/potion-shop-demo"
      ],
      "timeoutMs": 240000,
      "priority": "normal",
      "tags": [
        "external-reference",
        "roblox",
        "creator-copy-enabled",
        "official-roblox-demo",
        "studio-cli-runtime",
        "authorized-source-distillation",
        "production-priority-session-safe"
      ],
      "disabledReason": "24h-learning-roblox-studio-forbidden"
    }
  ]
}
