한 인원 구성이 감염과 정화 때문에 실시간으로 바뀌며, 방금 전 동료가 다음 순간 나를 쫓는 긴장감.","coreLoop":["인간4/몬스터4 배정, 빈자리 AI 충원","인간은 고유 도구·대시·정화로 생존/반격","몬스터는 인간을 접촉 감염","감염된 인간은 몬스터로 전환해 옛 팀 추격","한 진영이 0명이 되면 즉시 승패","240초까지 양팀이 남으면 무승부"],"signatureSystems":[{"name":"4대4 AI 충원","purpose":"논리 인원 8명, 인간4/몬스터4를 실제 플레이어+AI로 항상 채운다.","playerChoice":""},{"name":"감염 전환","purpose":"잡힌 인간이 탈락하지 않고 몬스터가 되어 즉시 반대팀으로 플레이한다.","playerChoice":""},{"name":"인간 정화","purpose":"인간이 정화 공격으로 몬스터를 라운드에서 제거한다.","playerChoice":""},{"name":"확장형 인간 로스터","purpose":"각 인간은 고유 도구+패시브+감염 후 능력 세트로 계속 추가한다.","playerChoice":""},{"name":"고전 몬스터 5종","purpose":"드라큘라·프랑켄슈타인·늑대인간·미라·사신의 다른 추격 능력.","playerChoice":""},{"name":"3맵 순환","purpose":"학교·폐병원·폐놀이공원을 서로 다른 동선과 랜덤 이벤트로 순환한다.","playerChoice":""}],"progressionDirection":"새 인간 직업과 몬스터를 동일한 데이터 구조에 계속 추가하고, 각 캐릭터는 플레이 방식이 달라지게 확장한다.","multiplayerMode":"FOUR_VS_FOUR_INFECTION_WITH_AI_FILL","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=6","PLACEHOLDER_OR_PRIMITIVE_USAGE_HIGH","VFX_IMPLEMENTATION_SPARSE","PERFORMANCE_BUDGET_SPARSE"],"signals":{"combat":12,"progression":24,"ai":18,"save":25,"multiplayer":0,"animation":2,"vfx":0,"camera":8,"ui":5,"uiFlow":5,"input":7,"map":23,"landmark":4,"interaction":3,"inventory":0,"equipment":10,"settings":12,"feedback":5,"session":10,"content":14,"choice":41,"connection":0,"performance":0,"lighting":6,"primitive":13,"todo":0,"errorRecovery":0},"topFiles":[{"file":"unity-games/horror-escape-room/Assets/Scripts/UnityWebFloorGame.cs","score":80},{"file":"unity-games/horror-escape-room/Assets/Editor/UnityWebFloorBuild.cs","score":60},{"file":"unity-games/horror-escape-room/Assets/Art/unity-web-floor-domain.json","score":2},{"file":"unity-games/horror-escape-room/Assets/Animations/unity-web-floor-domain.json","score":0},{"file":"unity-games/horror-escape-room/Assets/Ma