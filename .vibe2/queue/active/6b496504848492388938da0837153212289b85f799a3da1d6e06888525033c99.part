arningActionFeedback(control)","score":66},{"file":"roblox-games/seed-action-survival-rogu-echoes-of-the-lost-star/server/Game.server.luau","line":238,"kind":"FUNCTION","symbol":"bindNativeFoundationPlayer","context":"local function bindNativeFoundationPlayer(player)","score":66},{"file":"roblox-games/seed-action-survival-rogu-echoes-of-the-lost-star/client/Game.client.luau","line":286,"kind":"FUNCTION","symbol":"bindVerifiedLearningControl","context":"local function bindVerifiedLearningControl(control)","score":50},{"file":"roblox-games/seed-action-survival-rogu-echoes-of-the-lost-star/client/Game.client.luau","line":139,"kind":"FUNCTION","symbol":"syncVerifiedLearningCharacterMotion","context":"local function syncVerifiedLearningCharacterMotion(character)","score":42},{"file":"roblox-games/seed-action-survival-rogu-echoes-of-the-lost-star/server/Game.server.luau","line":17,"kind":"FUNCTION","symbol":"readNumber","context":"local function readNumber(player, name, fallback)","score":42},{"file":"roblox-games/seed-action-survival-rogu-echoes-of-the-lost-star/server/Game.server.luau","line":22,"kind":"FUNCTION","symbol":"setNumber","context":"local function setNumber(player, name, value)","score":42},{"file":"roblox-games/seed-action-survival-rogu-echoes-of-the-lost-star/client/Game.client.luau","line":27,"kind":"FUNCTION","symbol":"hasStudioAssetAtom","context":"local function hasStudioAssetAtom(familyOrAtom, atom)","score":34},{"file":"roblox-games/seed-action-survival-rogu-echoes-of-the-lost-star/server/Game.server.luau","line":183,"kind":"FUNCTION","symbol":"bindNativeFoundationCharacter","context":"local function bindNativeFoundationCharacter(character)","score":34},{"file":"roblox-games/seed-action-survival-rogu-echoes-of-the-lost-star/client/Game.client.luau","line":23,"kind":"FUNCTION","symbol":"studioAssetFamily","context":"local function studioAssetFamily(family)","score":26}]},"previousVersionDelta":{"previousGoal":"잃어버린 별의 메아리는 우주적 엔트로피에 맞서 싸우는 액션 생존 로그라이트 게임입니다. 플레이어는 '메아리(Echo)' 시스템을 통해 시간과 공간을 조작하며, 단순한 이동을 넘어선 전술적 위치 선정과 즉각적인 빌드 구성을 경험합니다. 이 게임은 매 순간의 선택이 전투의 흐름을 바꾸는 역동적인 시스템 연결을 통해, 기존 생존 게임과는 차별화된 깊이 있는 성장 경험을 제공합니다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.","previousFocus":"STABILITY","previousGeneration":27,"previousSourceTreeFingerprint":"dc1b03c5a3b6a1aaa440fc46ef7e0695e70f88760753bb4a59eb0cc2fc1755c9","currentSourceTreeFingerprint":"88e2394090c41a2e52aeb13151804fa8a28beccdd3983f4ef311533991e2f5d3","sourceChanged":true,"verifiedEvolution":false},"playtestRuntimeFindings":{"platform":"ROBLOX","studioQualityFailure":null,"failureStage":"F0_GAMEPLAY_PRODUCT_READINESS","failureSignature":"ROBLOX_F0_GAMEPLAY_PRODUCT_READINESS_FAILED","blockers":["MISSING_GAMEPLAY_CAPABILITY:CORE_GAMEPLAY_STATE","MISSING_GAMEPLAY_CAPABILITY:SESSION_FLOW","MISSING_GAMEPLAY_CAPABILITY:WORLD","MISSING_GAMEPLAY_CAPABILITY:CONTENT_ENTITY","MISSING_GAMEPLAY_CAPABILITY:COMBAT","MISSING_GAMEPLAY_CAPABILITY:ENEMY_AI","MISSING_GAMEPLAY_CAPABILITY:WAVE","MISSING_GAMEPLAY_CAPABILITY:EQUIPMENT","MISSING_GAMEPLAY_CAPABILITY:PROGRESSION","MISSING_GAMEPLAY_CAPABILITY:BOSS","CORE_LOOP_STEP_UNIMPLEMENTED:0","CORE_LOOP_STEP_UNIMPLEMENTED:1","CORE_LOOP_STEP_UNIMPLEMENTED:2","SIGNATURE_SYSTEM_UNIMPLEMENTED:0","SIGNATURE_SYSTEM_UNIMPLEMENTED:1","GENERIC_SCOPE_HANDLER_SKELETON"],"runtimeObserved":true,"runtimePassed":false,"independentQaPassed":false,"regressionPassed":false},"multiplayerImplementation":{"required":true,"policyVersion":1,"developmentAdmissionGate":false,"missingImplementationAction":"EXISTING_BUILD_UP_LOCAL_IMPLEMENTATION_AND_RETRY","otherGamesAndIndependentWorkContinue":true,"actualMultiplayerPlayVerified":false,"completionEvidence":"ACTUAL_TWO_OR_MORE_CLIENTS_SAME_SESSION_ACTION_STATE_RESULT_AND_RECONNECT"},"qualityGapMap":[{"domain":"CORE_FUN","state":"PASS","reason":"current source and approved design provide sufficient implementation signal"},{"domain":"COMBAT_OR_PRIMARY_INTERACTION","state":"PASS","reason":"curr