6255418187a8ff531f81f1279dc1dc38d83cc35cb84f1493dfd04","gameId":"seed-action-survival-rogu-echoes-of-the-lost-star","gameName":"잃어버린 별의 메아리","generation":1,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","escalationMode":"CONTINUE_UNVERIFIED_DEPTH","previousDirectiveOutcome":"cancelled","designContextMode":"APPROVED_OR_MINIMUM_DESIGN","platform":"WEB","sourceRoot":"web-games/seed-action-survival-rogu-echoes-of-the-lost-star","sourceTreeFingerprint":"db6a7caee527eb9d53a6d9a4c44afba5956b2a63052e90cdda79a52e9e928ee1","designFingerprint":"30ec3e9de4501f5cf65bf0afe3bc5348140d0d78760efd1366c75322923bd4b2","gameIdentityAndNonNegotiables":{"identity":"잃어버린 별의 메아리는 우주적 엔트로피에 맞서 싸우는 액션 생존 로그라이트 게임입니다. 플레이어는 '메아리(Echo)' 시스템을 통해 시간과 공간을 조작하며, 단순한 이동을 넘어선 전술적 위치 선정과 즉각적인 빌드 구성을 경험합니다. 이 게임은 매 순간의 선택이 전투의 흐름을 바꾸는 역동적인 시스템 연결을 통해, 기존 생존 게임과는 차별화된 깊이 있는 성장 경험을 제공합니다.","coreFun":"핵심 재미는 적을 처치하고 얻는 '메아리 파편'을 통해 실시간으로 자신의 전투 스타일을 진화시키는 과정에 있습니다. 플레이어는 적의 공격을 피하며 최적의 위치를 선점하고, 획득한 파편으로 즉각적인 빌드 변화를 선택하여 화면을 가득 채우는 적들을 쓸어버리는 즉각적인 쾌감을 느낍니다.","coreLoop":["실시간 전투를 통해 적의 물결을 돌파하며 생존하고, 적 처치 시 드롭되는 메아리 파편을 수집합니다.","수집한 파편을 사용하여 실시간으로 무기, 스킬, 능력치를 강화하는 '메아리 선택' 메뉴를 통해 빌드를 구성합니다.","강화된 빌드를 바탕으로 더욱 강력해진 적과 보스 웨이브에 도전하며, 최종적으로 런의 결과를 메타 성장 재화로 변환합니다."],"signatureSystems":[{"name":"메아리 공명 시스템","purpose":"전투 중 실시간으로 플레이어의 공격 방식과 유틸리티 능력을 변화시켜 매번 다른 전투 경험을 제공하기 위함입니다.","playerChoice":"플레이어는 획득한 파편을 사용하여 공격 속도 증가, 투사체 분열, 광역 피해 등 다양한 메아리 효과 중 하나를 선택하여 자신의 빌드를 최적화합니다."},{"name":"엔트로피 미터","purpose":"게임의 난이도를 동적으로 조절하고 플레이어에게 위험과 보상 사이의 전략적 선택을 강요하기 위한 시스템입니다.","playerChoice":"플레이어는 엔트로피가 높은 위험 지역으로 진입하여 더 많은 보상을 노릴지, 아니면 안전한 지역에서 파밍을 지속할지 결정해야 합니다."}],"progressionDirection":"메타 진행은 각 런에서 획득한 '별의 가루'를 사용하여 영구적인 능력치 강화와 새로운 메아리 유형을 해금하는 방식으로 이루어집니다. 플레이어는 단순히 강해지는 것을 넘어, 자신의 플레이 스타일에 맞는 메아리 조합을 미리 설정하여 다음 런의 전략적 우위를 점할 수 있습니다. 이 과정은 반복적인 플레이가 지루하지 않도록 새로운 도전 과제와 보상을 지속적으로 제공하며, 플레이어가 자신의 성장을 체감할 수 있도록 설계되었습니다.","multiplayerMode":"SINGLE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=1","GAME_FEEL_SPARSE","CAMERA_LANGUAGE_SPARSE","AUDIO_STATE_TRANSITION_SPARSE","UI_MENU_FLOW_SPARSE","SETTINGS_ACCESSIBILITY_SPARSE"],"signals":{"combat":48,"progression":75,"ai":5,"save":3,"multiplayer":0,"animation":4,"motionStates":24,"gameFeel":0,"vfx":7,"camera":0,"audio":11,"audioDynamics":0,"ui":35,"uiFlow":8,"entryFlow":0,"loadingFlow":0,"input":8,"map":8,"landmark":0,"interaction":5,"inventory":0,"equipment":5,"settings":0,"feedback":0,"session":9,"content":60,"choice":7,"connection":0,"performance":2,"lighting":17,"primitive":0,"todo":0,"errorRecovery":1},"topFiles":[{"file":"web-games/seed-action-survival-rogu-echoes-of-the-lost-star/index.html","score":171}],"sourceAnchors":[{"file":"web-games/seed-action-survival-rogu-echoes-of-the-lost-star/index.html","line":77,"kind":"FUNCTION","symbol":"updateUi","context":"function updateUi(){ui.wave.textContent=wave;ui.level.textContent=player.level;ui.kills.textContent=kills;ui.time.textContent=`${Math.floor(elapsed/60)}:${String(Math.floor(elapsed","score":394},{"file":"web-games/seed-action-survival-rogu-echoes-of-the-lost-star/index.html","line":68,"kind":"FUNCTION","symbol":"update","context":"function update(dt){if(paused||!running)return;elapsed+=dt;waveTimer+=dt;player.fireTimer-=dt;player.inv=Math.max(0,player.inv-dt);player.dashCd=Math.max(0,player.dashCd-dt);","score":354},{"file":"web-games/seed-action-survival-rogu-echoes-of-the-lost-star/index.html","line":78,"kind":"FUNCTION","symbol":"draw","context":"function draw(){ctx.clearRect(0,0,W,H);const grd=ctx.createRadialGradient(player.x,player.y,0,player.x,player.y,Math.max(W,H)*.8);grd.addColorStop(0,'#111f42');grd.addColorStop(.55","score":338},{"file":"web-games/seed-action-survival-rogu-echoes-of-the-lost-star/index.html","line":67,"kind":"FUNCTION","symbol":"das