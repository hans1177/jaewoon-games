:recovery-ticket-bug-65a297adfddd5b2f6324","game-repair-repeat-count:40","game-repair-repeat-count:41","game-repair-repeat-count:42","game-repair-repeat-count:43","game-repair-repeat-count:44","game-repair-repeat-count:45"],"lastOutcome":"FAIL","reservationId":null,"reservationRunId":null,"reservationRunAttempt":0,"reservedAt":null,"neuronExpectedVariants":0,"neuronResults":[],"runtimeEvidenceCandidate":null,"buildUpDirective":{"version":2,"directiveId":"amusement-tycoon-build-up-g2-1e1e3c8ad711","directiveFingerprint":"1e1e3c8ad7113031dbca0325e2a12833e2ffcf77145db9da9db2a93223d58056","previousDirectiveFingerprint":"a105e152fad3b1b4f6cbb1d379c6e160023dda02ac04269e8874a869436acc97","forbiddenRepeatFingerprint":"a105e152fad3b1b4f6cbb1d379c6e160023dda02ac04269e8874a869436acc97","gameId":"amusement-tycoon","gameName":"놀이공원 타이쿤","generation":2,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","escalationMode":"CONTINUE_UNVERIFIED_DEPTH","previousDirectiveOutcome":"cancelled","designContextMode":"APPROVED_OR_MINIMUM_DESIGN","platform":"WEB","sourceRoot":"unity-games/amusement-tycoon","sourceTreeFingerprint":"d9d13278b9a6137256af2f43ac8154c4a4a75911077b86479c9b7fa62c802dd8","designFingerprint":"8d0223a3e8fc1f104f65ba9b1be2c72e2eab36c4f2573227e8940b9af8d6a5a8","gameIdentityAndNonNegotiables":{"identity":"놀이공원 타이쿤은 단순한 경영 시뮬레이션을 넘어, 플레이어가 놀이기구의 배치와 동선 설계를 통해 손님의 감정 상태를 실시간으로 조율하는 3D 전략 경영 게임입니다. 핵심 루프와 시그니처 시스템은 단순히 건물을 짓는 행위에 그치지 않고, 손님의 만족도와 수익이라는 두 가지 상충하는 지표 사이에서 매 순간 최적의 선택을 강제하며, 이 선택이 놀이공원의 전체적인 흐름과 수익성에 즉각적인 변화를 가져오도록 설계되었습니다.","coreFun":"놀이공원 타이쿤의 핵심 재미는 '최적의 동선 설계'와 '손님 만족도 관리'입니다. 플레이어는 놀이기구의 위치를 조정하여 손님의 대기 시간을 줄이고, 상점 배치를 통해 수익을 극대화하는 선택을 반복합니다. 이러한 선택은 손님의 이동 경로와 행복도 수치에 즉각적인 변화를 주며, 결과적으로 공원의 일일 수익과 평판이라는 가시적인 성과로 이어집니다.","coreLoop":["공간 배치 및 놀이기구 건설: 제한된 자본을 사용하여 놀이기구와 편의시설을 배치하고 동선을 설계합니다.","손님 흐름 관찰 및 피드백 수집: 손님들의 이동 경로와 만족도 아이콘을 통해 병목 현상이나 불만족 요소를 실시간으로 파악합니다.","수익 재투자 및 최적화: 벌어들인 수익으로 시설을 업그레이드하거나 새로운 구역을 개방하여 효율을 극대화하고 다음 성장을 준비합니다."],"signatureSystems":[{"name":"동선 최적화 시스템","purpose":"손님의 이동 효율을 극대화하고 병목 현상을 방지하여 공원 전체의 수용 능력을 높이는 것이 목적입니다.","playerChoice":"플레이어는 길의 너비, 놀이기구 입구의 위치, 휴식 공간의 배치를 결정하여 손님의 이동 흐름을 직접 제어하고 최적화할 수 있습니다."},{"name":"감정 기반 만족도 엔진","purpose":"손님 개개인의 만족도를 실시간으로 추적하여 공원의 평판과 수익에 직접적인 영향을 미치는 시스템입니다.","playerChoice":"플레이어는 놀이기구의 스릴 강도 조절, 테마 장식 추가, 음식 가격 책정을 통해 손님의 감정 상태를 긍정적으로 유도하는 선택을 합니다."}],"progressionDirection":"초반에는 소규모 놀이기구와 기본 시설을 통해 경영의 기초를 익히고, 중반에는 테마 구역 확장과 효율적인 동선 설계를 통해 수익을 극대화합니다. 후반부에는 대규모 랜드마크 건설과 고도화된 만족도 관리를 통해 세계 최고의 놀이공원으로 성장하는 것을 목표로 합니다.","multiplayerMode":"SINGLE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=6","PLACEHOLDER_OR_PRIMITIVE_USAGE_HIGH","GAME_FEEL_SPARSE","VFX_IMPLEMENTATION_SPARSE","AUDIO_IMPLEMENTATION_SPARSE","UI_MENU_FLOW_SPARSE","PERFORMANCE_BUDGET_SPARSE"],"signals":{"combat":12,"progression":24,"ai":18,"save":25,"multiplayer":0,"animation":2,"motionStates":16,"gameFeel":0,"vfx":0,"camera":8,"audio":0,"audioDynamics":0,"ui":5,"uiFlow":5,"entryFlow":4,"loadingFlow":0,"input":7,"map":14,"landmark":4,"interaction":3,"inventory":0,"equipment":10,"settings":12,"feedback":5,"session":10,"content":14,"choice":41,"connection":0,"performance":0,"lighting":6,"primitive":13,"todo":0,"errorRecovery":0},"topFiles":[{"file":"unity-games/amusement-tycoon/Assets/Scripts/UnityWebFloorGame.cs","score":86},{"file":"unity-games/amusement-tycoon/Assets/Editor/UnityWebFloorBuild.cs","score":60},{"file":"unity-games/amusement-tycoon/Assets/Art/unity-web-floor-domain.json","score":2},{"file":"unity-games/amusement-tycoon/Assets/Animations/unity-web-floor-domain.json","score":1},{"file":"unity-games/amusement-tycoon/Assets/Materials/unity-web-floor-domain.json","score":0},{"file":"unity-games/amusement-tycoon/Assets/Prefabs/unity-web-floor-domain.json","score":0}],"sourc