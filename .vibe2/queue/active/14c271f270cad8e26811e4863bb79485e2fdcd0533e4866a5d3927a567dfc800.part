5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","systemConnection":"기존 행동 → 상태별 표현/입력 피드백","approvedCoreLoop":["공간 배치 및 놀이기구 건설: 제한된 자본을 사용하여 놀이기구와 편의시설을 배치하고 동선을 설계합니다.","손님 흐름 관찰 및 피드백 수집: 손님들의 이동 경로와 만족도 아이콘을 통해 병목 현상이나 불만족 요소를 실시간으로 파악합니다.","수익 재투자 및 최적화: 벌어들인 수익으로 시설을 업그레이드하거나 새로운 구역을 개방하여 효율을 극대화하고 다음 성장을 준비합니다."],"signatureSystems":["동선 최적화 시스템","감정 기반 만족도 엔진"],"progressionDirection":"초반에는 소규모 놀이기구와 기본 시설을 통해 경영의 기초를 익히고, 중반에는 테마 구역 확장과 효율적인 동선 설계를 통해 수익을 극대화합니다. 후반부에는 대규모 랜드마크 건설과 고도화된 만족도 관리를 통해 세계 최고의 놀이공원으로 성장하는 것을 목표로 합니다.","ideas":[{"id":"TYCOON:PLAY_READABILITY","implementation":"현재 핵심 행동과 결과가 월드·모션·터치 UI에서 명확하게 읽히도록 연결한다.","distinction":"판정·보상·저장 규칙은 유지하고 표현만 개선한다."}],"selectedIdea":{"id":"TYCOON:PLAY_READABILITY","implementation":"현재 핵심 행동과 결과가 월드·모션·터치 UI에서 명확하게 읽히도록 연결한다.","distinction":"판정·보상·저장 규칙은 유지하고 표현만 개선한다."},"ideaHistory":["TYCOON:PLAY_READABILITY"],"implementationPackages":[{"role":"GAMEPLAY_STATE","files":["unity-games/amusement-tycoon/Assets/Scripts/GameCore.cs","unity-games/amusement-tycoon/Assets/Scripts/RuntimeBootstrap.cs","unity-games/amusement-tycoon/Assets/Scripts/UnityWebFloorGame.cs","unity-games/amusement-tycoon/Assets/Editor/UnityWebFloorBuild.cs"],"implementation":"이 파일의 기존 입력·렌더·모션·UI 책임 블록만 개선하고 게임 상태·보상·저장 의미는 유지한다."}],"sourceTreeFingerprint":"d9d13278b9a6137256af2f43ac8154c4a4a75911077b86479c9b7fa62c802dd8","qualityContract":{"reference":"SAME_CONNECTED_PLAY_AND_PRESENTATION_STANDARD_AS_ROBLOX","implementation":"EXISTING_CSHARP_SCENE_PREFAB_AND_ASSET_BINDINGS","required":["CONNECTED_PLAYER_ACTION_STATE_FEEDBACK_AND_NEXT_GOAL","COMPATIBLE_INTERNAL_ASSETS_ACTUALLY_BOUND","MOTION_AUDIO_VFX_LINKED_TO_EXISTING_GAME_STATE_WHEN_APPLICABLE","MOBILE_TOUCH_AND_SCREEN_READABILITY","EXACT_CHANGED_BUILD_RUNTIME_AND_SAVE_REGRESSION"],"runtimeSurface":"UNITY_WEBGL_ACTUAL_BROWSER_PLAY","markerOnlyCompletionAllowed":false,"runtimeVerified":false},"handoffRule":"Use the observed files and symbols within the existing allowed write scope. Reuse