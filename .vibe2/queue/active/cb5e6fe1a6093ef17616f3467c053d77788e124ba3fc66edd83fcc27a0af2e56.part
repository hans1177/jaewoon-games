ind%22%3A%22REQUEST_EVIDENCE%22%2C%22actionActivationState%22%3A%22INHIBITED%22%2C%22actionInhibitors%22%3A%5B%22SUPERVISOR_PASS_REQUIRED_BUT_MISSING%22%2C%22SECURITY_POLICY_BLOCK%22%2C%22ROOT_CAUSE_NOT_VERIFIED%22%5D%2C%22wouldActivateWithoutPhase2Authority%22%3Afalse%2C%22dependencyCount%22%3A0%2C%22unsatisfiedDependencyCount%22%3A0%2C%22executionAllowed%22%3Afalse%2C%22workerCreationAllowed%22%3Afalse%2C%22queueMutationAllowed%22%3Afalse%2C%22waveReorderAllowed%22%3Afalse%2C%22automaticTuningAllowed%22%3Afalse%2C%22lockAcquisitionAllowed%22%3Afalse%2C%22policyMutationAllowed%22%3Afalse%2C%22automaticLearningAllowed%22%3Afalse%2C%22authorityPromotionAllowed%22%3Afalse%7D","worker-artifact-run:37334500640","build-up-shared-generation-exact-object:YES","build-up-previous-effectiveness:UNKNOWN_RUNTIME_EFFECT","build-up-next-vibe-action:REQUEST_REQUIRED_RUNTIME_OBSERVATION","build-up-next-vibe-action-reason:effect cannot be promoted until relevant runtime or deterministic gameplay evidence is observed","build-up-directive-id:village-dungeons-build-up-g1-389eb0533519","build-up-directive-contract-migration:AUTONOMOUS_CONTENT_EXPANSION_V2","build-up-directive-contract-migration-generation:PRESERVED","build-up-directive-freshness:MIGRATED_LEGACY_DIRECTIVE_TO_AUTONOMOUS_CONTENT_EXPANSION_SAME_GENERATION","worker-artifact-run:39006649440"],"lastOutcome":"SYSTEM_STEWARD_STALE_LEASE_RECOVERED","reservationId":"39006649440:1","reservationRunId":"39006649440","reservationRunAttempt":1,"reservedAt":"2026-10-17T05:46:55Z","neuronExpectedVariants":1,"neuronResults":[],"runtimeEvidenceCandidate":null,"buildUpDirective":{"version":2,"directiveId":"village-dungeons-build-up-g1-389eb0533519","directiveFingerprint":"389eb0533519773afd0b2145191ebf78f7e6bfeb9bb36b0de99d7289a2fad0f9","previousDirectiveFingerprint":"e486d4577d40aaf54f9de2f9e7b869335f86a77caf9f3b5ee3af5d8144b93edb","forbiddenRepeatFingerprint":"e486d4577d40aaf54f9de2f9e7b869335f86a77caf9f3b5ee3af5d8144b93edb","gameId":"village-dungeons","gameName":"마을 던전 RPG","generation":1,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","escalationMode":"CONTINUE_UNVERIFIED_DEPTH","previousDirectiveOutcome":"cancelled","designContextMode":"APPROVED_OR_MINIMUM_DESIGN","platform":"WEB","sourceRoot":"web-games/village-dungeons","sourceTreeFingerprint":"bf6888ee8422e2c38306d341ac1920ebdddf18155b50042a625d14be96c5f778","designFingerprint":"c915b5e2afa7f2c4b9b5767a6f020edb0f215c2908fb8e77c16a09789c0d7131","gameIdentityAndNonNegotiables":{"identity":"마을 던전 RPG는 위기 상황에 놓인 마을의 의뢰를 해결하기 위해 5개 던전의 자원과 위험 속으로 진입하여 직관적인 원서클 모바일 액션 전투를 수행하고 수집품을 마을 복구 시설에 환원하여 전투 빌드를 고유하게 완성해 나가는 루프 중심의 캐주얼 모바일 액션 롤플레잉 게임이다.","coreFun":"적의 공격 궤적을 직관적으로 회피하고 연타 공격을 적중시키는 순간의 즉각적인 손맛과 제한된 던전 인벤토리에 어떤 전리품을 챙길지 결정하여 마을 시설의 기술 트리로 환원할 때 일어나는 명확한 전투 스펙 향상의 쾌감이다.","coreLoop":["마을 의뢰 게시판에서 자원 채취 및 특정 던전 몬스터 토벌 퀘스트를 수락하고 장비를 점검한다.","5개로 분기된 던전 중 하나를 선택 진입하여 한 손 조작 기반의 실시간 회피 및 평타/스킬 연계로 몬스터를 격퇴한다.","한정된 던전 배낭 슬롯에 귀환용 고가치 자원과 장비 강화 재료를 취사선택하여 보관한다.","포털을 통해 안전하게 마을로 귀환하여 의뢰를 완료하고 수집 자원으로 대장간과 주점을 업그레이드한다.","확장된 시설 버프와 신규 제작 무기를 바탕으로 더 깊은 던전 층계 및 보스전에 도전한다."],"signatureSystems":[{"name":"마을 재건 시설 연동 시스템","purpose":"던전에서 획득한 고유 건축 목재와 광석을 마을 대장간·주점·연금 공방에 투자하여 영구적인 스탯 버프와 신규 스킬 트리를 해금한다.","playerChoice":"즉시 전투력을 높이는 무기 제련 시설을 우선 복구할 것인지, 소비 물약 효율과 던전 내 추가 부활 기회를 부여하는 연금소를 먼저 지을지 선택한다."},{"name":"리스크 배낭 정밀 적재 시스템","purpose":"던전 내 인벤토리 슬롯을 극도로 제한하여 플레이어가 매 전투 승리 시마다 리스크와 리턴을 저울질하도록 유도한다.","playerChoice":"안전한 마을 귀환 주문서를 유지하기 위해 회복 물약을 버릴 것인지, 희귀 보스 드롭 재료를 위해 체력 회복 수단을 포기할 것인지 결정한다."}],"progressionDirection":"초반 세션에서는 단순 타격과 짧은 3분 던전 탐색으로 기초 장비를 맞추게 하며, 중반에는 5대 던전의 상성 속성(화염, 냉기, 독, 암흑, 번개)에 맞춘 장비 세트 파밍과 마을 상위 시설 건설로 전략적 깊이를 확장하고, 종반에는 심층 보스 타임어택과 극한의 장비 옵션 튜닝을 통해 지속적인 육성 만족도를 제공한다.","multiplayerMode":"SINGLE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRE