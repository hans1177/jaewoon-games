{"id":"internal-motion-leshy-walk-v1","gameId":"horror-escape-room","target":"roblox","unityWebDevelopment":false,"department":"graphics","type":"implementation","assetProductionLane":true,"presentationPass":null,"graphicsReplacementContract":null,"motionRepairWorkUnit":{"scope":"INTERNAL_ASSET_LIBRARY","objectId":"roblox-world-ghost-leshy","clipId":"walk","sourcePath":"init.luau","sourceHash":"e375f87bcb26014b96c755cdb718529705b63c4172c7ffa6c4192579d588156f","sourceWindow":"function Motion.walk(form,bones,time)\n\n local result={}\n for name in pairs(bones)do result[name]={x=0,y=0,z=0,rx=0,ry=0,rz=0}end\n local function pose(name,x,y,z,rx,ry,rz)\n  if result[name]then result[name]={x=x or 0,y=y or 0,z=z or 0,rx=rx or 0,ry=ry or 0,rz=rz or 0}end\n end\n local function smooth(value)local u=math.clamp(value,0,1);return u*u*u*(u*(u*6-15)+10)end\n local TAU=math.pi*2\n\n local p=(time/Motion.Duration)%1\n -- Triangular weight travel is eased at both full-support poses.\n local support=p<.5 and -1+2*smooth(p*2) or 1-2*smooth((p-.5)*2)\n local function leg(offset)\n  local u=(p+offset)%1\n  local travel=u<.64 and .23-.46*smooth(u/.64) or -.23+.46*smooth((u-.64)/.36)\n  local lift=u<.64 and 0 or .10*math.sin(math.pi*(u-.64)/.36)^2\n  return travel,lift\n end\n local l,ly=leg(0);local r,ry=leg(.5)\n local delayed=math.sin(p*TAU-.7)+.2*math.sin(p*TAU*3-1.1)\n pose(\"Torso\",support*.10,-.045+.035*math.cos(p*TAU*2),0,.045,.025*delayed,-.045*support)\n pose(\"Head\",0,0,0,-.03,-.02*delayed,.025*support)\n pose(\"LeftLeg\",0,ly,0,l,0,0);pose(\"RightLeg\",0,ry,0,r,0,0)\n pose(\"LeftArm\",0,0,0,-.10-.11*delayed,0,-.065)\n pose(\"RightArm\",0,0,0,-.10+.11*delayed,0,.065)\n return result\nend","objectBindingEvidence":"Motion.AssetId = \"leshy\"","clipBindingEvidence":"function Motion.walk(form,bones,time)","objectCount":1,"motionCount":1,"estimatedModificationMinutes":60,"lockedSource":["Motion.AssetId = \"leshy\"","function Motion.walk(form,bones,time)","local state=\"walk\""],"preservedAxes":{}},"executionLane":"ASSET_DEVELOPMENT","goal":"[INTERNAL ASSET MOTION REPAIR] roblox-world-ghost-leshy의 기존 walk 동작 하나를 약 60분의 실제 수정 작업량으로 깊게 개선한다. 원본을 읽고 자세·중심 이동·관절 곡선·접촉·후행 움직임·복귀와 루프를 검토한다. 같은 오브젝트와 같은 동작만 수정하며 다른 모션, 루트 이동, 판정, 게임 소스는 변경하지 않는다. 변경하지 않는 축은 소스 근거로 보존한다. 전후 실제 native 재생과 검수 전에는 품질 통과를 주장하지 않는다. 실패는 같은 대상의 기존 수리 흐름에서 반복 수정한다.","responsibleFiles":["assets/roblox/world-ghosts/motions/leshy/init.luau"],"retainedResponsibleFileLocks":[],"dependencies":[],"priority":"critical","portfolioValueScore":0,"ownerDevelopmentHold":false,"releaseState":"development-confirmed","status":"queued","retries":2,"retryPolicy":"UNLIMITED","maxRetries":2,"ownerDirective":true,"requiresOwnerDecision":false,"protectedChange":false,"paidResourceRequired":false,"productionMode":"AUTONOMOUS_VIBE","supervisionApproved":false,"supervisionContract":null,"supervisionReview":null,"blocker":null,"evidence":["asset-production-parallel:v1","single-object-motion-repair:v1","internal-asset-only:v1","owner-motion-depth-request:2026-10-05","native-before-after-qa:required","work-package:horror-escape-room-wp-l4fbpr","task-work-units:6","package-work-units:6","package-related-improvements:0","package-role-separation:exploration|implementation|test|performance|regression|review","package-quantity-goal:FEATURE_COMPLETION","atomic-neuron-stream:presentation","atomic-neuron-micro-fanin:per-task","graphics-atomic-candidate-isolation-required","portfolio-decision:FOCUSED_REPAIR","portfolio-reason:CURRENT_CRITICAL_OR_REPEATED_CAUSAL_BLOCKER","learning-motor-candidate-tournament:repeated-verified-failure","recovery-queue:recovery-ticket-bug-97439712d416497ffce0","recovery-strategy:REPAIR_REPRODUCIBLE_TESTER_BUG_AND_RERUN_EXACT_FAILED_STAGE","recovery-exact-stage:TARGET_PLATFORM_BUILD_OR_PACKAGE","source-mutation-required:YES","game-repair-mode:ROOT_CAUSE_MODE","game-repair-repeat-count:4","game-repair-user-assistance-required:NO","game-repair-save-migration:NOT_APPLICABLE","game-repa