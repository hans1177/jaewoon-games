pendencyCount%22%3A0%2C%22executionAllowed%22%3Afalse%2C%22workerCreationAllowed%22%3Afalse%2C%22queueMutationAllowed%22%3Afalse%2C%22waveReorderAllowed%22%3Afalse%2C%22automaticTuningAllowed%22%3Afalse%2C%22lockAcquisitionAllowed%22%3Afalse%2C%22policyMutationAllowed%22%3Afalse%2C%22automaticLearningAllowed%22%3Afalse%2C%22authorityPromotionAllowed%22%3Afalse%7D","retry-cause-streak:source-candidate-generation-failed:1","transient-work-lock-deferred:work-lock-conflict:not-acquired","worker-artifact-run:39479768739","worker-artifact-run:39482205009","worker-artifact-run:39484521972","worker-artifact-run:39495397598","worker-artifact-run:39501076244","worker-artifact-run:39506374536","worker-artifact-run:39508202102","worker-artifact-run:39509884998","worker-artifact-run:39515359171","worker-artifact-run:39526101646","worker-artifact-run:39530166912","worker-artifact-run:39531427092","worker-artifact-run:39536899582","worker-artifact-run:39555710738","worker-artifact-run:39565341616","worker-artifact-run:39570706929","recovery-queue:recovery-ticket-bug-6f2a1be8144bd2f29e2c","game-repair-mode:FOCUSED_REPAIR","game-repair-repeat-count:1","game-repair-repeat-count:2","game-repair-repeat-count:3"],"lastOutcome":"DEFERRED_BY_WORK_LOCK","reservationId":null,"reservationRunId":null,"reservationRunAttempt":0,"reservedAt":null,"neuronExpectedVariants":0,"neuronResults":[],"runtimeEvidenceCandidate":null,"buildUpDirective":{"version":2,"directiveId":"seed-single-defense-strat-celestial-bastion-build-up-g1-e3914b7b75c5","directiveFingerprint":"e3914b7b75c5a93aafefea266824d5042e1675b2aedd3c401b2547a2b0a82ec7","previousDirectiveFingerprint":"087cb12796a1b0f510eebafe52a0a6b940aecb900f8e06c8d13926c0c2e287cf","forbiddenRepeatFingerprint":"087cb12796a1b0f510eebafe52a0a6b940aecb900f8e06c8d13926c0c2e287cf","gameId":"seed-single-defense-strat-celestial-bastion","gameName":"천상의 보루","generation":1,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","escalationMode":"CONTINUE_UNVERIFIED_DEPTH","previousDirectiveOutcome":"cancelled","designContextMode":"APPROVED_OR_MINIMUM_DESIGN","platform":"WEB","sourceRoot":"web-games/seed-single-defense-strat-celestial-bastion","sourceTreeFingerprint":"3242e77a76a5a0981adca7fcd464fc5ebec74355cefe01399aaf8abee732b168","designFingerprint":"652a5301beebec96ac192d06830fb9af5897a13030b7fb144fb021ef64b33ceb","gameIdentityAndNonNegotiables":{"identity":"천상의 보루는 고전적인 타워 디펜스 장르를 재해석하여, 플레이어가 실시간으로 전장의 지형을 변형하고 유닛의 속성을 동적으로 조합하는 전략적 깊이를 제공합니다. 핵심 루프인 '적의 경로 예측-방어선 구축-자원 최적화'는 단순한 배치를 넘어, 지형 변형 시스템과 속성 상성 시스템을 통해 매 순간 플레이어의 창의적인 선택이 전황을 뒤바꾸는 고유한 경험을 창출합니다.","coreFun":"적의 이동 경로를 실시간으로 차단하거나 유도하는 지형 변형의 쾌감, 그리고 배치된 타워의 속성을 조합하여 적의 약점을 공략할 때 발생하는 즉각적인 파괴의 시각적 피드백이 핵심 재미입니다.","coreLoop":["적의 웨이브 정보를 확인하고, 현재 가용 자원을 고려하여 방어 타워를 배치하거나 지형을 수정하여 적의 이동 경로를 최적화합니다.","전투 중 적을 처치하여 획득한 에너지를 사용하여 타워를 강화하거나, 전장의 지형을 추가로 변형하여 방어 효율을 극대화합니다.","웨이브 종료 후 획득한 보상으로 새로운 타워 기술을 연구하거나 기존 타워의 속성을 강화하여 다음 단계의 더 강력한 적에 대비합니다."],"signatureSystems":[{"name":"지형 변형 시스템","purpose":"고정된 맵에서 벗어나 플레이어가 직접 전장의 길을 만들거나 막아 적의 이동 경로를 제어하게 함으로써 전략적 자유도를 극대화합니다.","playerChoice":"플레이어는 특정 구역의 지형을 높여 적의 이동을 차단하거나, 낮추어 특정 타워의 사거리 안으로 적을 유인하는 선택을 할 수 있습니다."},{"name":"속성 공명 시스템","purpose":"단순한 타워 배치를 넘어, 인접한 타워들의 속성을 조합하여 강력한 시너지 효과를 발생시켜 전술적 깊이를 더합니다.","playerChoice":"플레이어는 화염 타워와 전기 타워를 인접하게 배치하여 광역 폭발 효과를 노릴지, 혹은 냉기 타워를 배치하여 적의 이동 속도를 늦출지 선택해야 합니다."}],"progressionDirection":"초반에는 기본적인 타워 배치와 지형 활용법을 익히고, 중반부터는 속성 공명을 활용한 복합적인 전략이 요구됩니다. 후반부에는 제한된 자원 내에서 최적의 방어 효율을 찾아내는 퍼즐적 요소와 전략적 판단이 결합된 성장을 지향합니다.","multiplayerMode":"SINGLE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=1","MOTION_IMPLEMENTATION_SPARSE","GAME_FEEL_SPARSE","VFX_IMPLEMENTATION_SPARSE","CAMERA_LANGUAGE_SPARSE","AUDIO_STATE_TRANSITION_SPARSE","AI_BEHAVIOR_DEPTH_SPARSE","INVENTORY_EQUIPMENT_FLOW_SPARSE","UI_MENU_FLOW_SPARSE","INTERACTION_DISCOVERABILITY_SPARSE","PERFORMANCE_BUDGET_SPARSE"],"signals":{"combat":42,"progression":57,"ai":0,"save":8,"multiplayer":0,"animation":0,"motionStates":58,"gameFeel":0,"vfx":0,"camera":0,"audio":14,"audioDynamics":0,"ui":35,"uiFlow":0,"entryFlow":0,"loadingFlow":0,"input":7,"map":11,"landmark":10,"interaction":0,"inventory":4,"equipment":0,"settings":6,"feedback":21,"session":7,"content":20,"choice":4,"connection":0,"performance":0,"lighting":3,"primitive":0,"todo":0,"errorRecovery":2},"topFiles":[{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","score":83}],"sourceAnchors":[{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":28,"kind":"FUNCTION","symbol":"commonProgress","context":"function commonProgress(){S.turn++;S.score=Math.max(0,S.score);save()}","score":154},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":43,"kind":"FUNCTION","symbol":"advanceRealmTime","context":"function advanceRealmTime(){S.mana+=4+Math.floor(S.pop/10);S.pop+=S.realm.filter(v=>v===3).length;S.level++}","score":154},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":27,"kind":"FUNCTION","symbol":"end","context":"function end(win,msg){S.ended=true;S.won=win;save();log(msg,win?'win':'lose');render()}","score":146},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":31,"kind":"FUNCTION","symbol":"renderSurvival","context":"function renderSurvival(){const q=survivalCfg();stats([['HP',S.hp],['DAY',S.day+'/'+q.goal],['WOOD',S.wood],['FOOD',S.food]]);buttons(q.actions);const b=$('.board');b.innerHTML='<d","score":146},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":32,"kind":"FUNCTION","symbol":"actSurvival","context":"function actSurvival(i){const insect=C.mode==='insect-survival';if(i===0){S.wood+=2+S.power;S.food+=Math.random()<.55?1:0;S.score+=5;log('주변 자원을 확보했다.')}else if(i===1){if(insect){i","score":146},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":44,"kind":"FUNCTION","symbol":"actRealm","context":"function actRealm(i){if(i<2){if(S.mana<2)return failed('마나가 부족하다.');const empty=S.realm.map((v,n)=>v===0?n:-1).filter(n=>n>=0);if(!empty.length)return failed('빈 땅이 없다.');S.mana-=2;","score":146},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":9,"kind":"FUNCTION","symbol":"$","context":"const $=s=>document.querySelector(s);const el=(t,c,x)=>{const n=document.createElement(t);if(c)n.className=c;if(x!==undefined)n.textContent=x;return n};","score":138},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":24,"kind":"FUNCTION","symbol":"stats","context":"function stats(items){const x=$('.stats');x.innerHTML='';items.forEach(i=>x.appendChild(stat(i[0],i[1])))}","score":138},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":26,"kind":"FUNCTION","symbol":"syncGameState","context":"function syncGameState(){const state=S.ended?(S.won?'victory':'defeat'):'running';statsNode.dataset.state=state;statsNode.dataset.score=String(S.score||0);statsNode.dataset.resourc","score":138},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":23,"kind":"FUNCTION","symbol":"stat","context":"function stat(label,val){const d=el('div','stat');d.innerHTML=`<b>${val}</b><small>${label}</small>`;return d}","score":130},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":25,"kind":"FUNCTION","symbol":"buttons","context":"function buttons(items){for(let i=0;i<5;i++){const b=$('#a'+i);b.textContent=items[i]||'행동';b.disabled=S.ended;}}","score":130},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":30,"kind":"FUNCTION","symbol":"survivalCfg","context":"function survivalCfg(){return C.mode==='insect-survival'?{goal:10,enemy:'🕷️',title:'곤충 정원',actions:['채집 이동','창으로 방어','먹기','야영지 강화','위험 정찰']}:{goal:12,enemy:'🐺',title:'야생 숲',actio","score":130},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":42,"kind":"FUNCTION","symbol":"renderRealm","context":"function renderRealm(){if(!Array.isArray(S.realm)||S.realm.length!==25)S.realm=Array(25).fill(0);stats([['MANA',S.mana],['POP',S.pop],['WORLD',S.progress+'/20'],['SCORE',S.score]])","score":130},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":45,"kind":"FUNCTION","symbol":"renderIdle","context":"function renderIdle(){stats([['HP',S.hp],['STAGE',S.stage+'/10'],['GOLD',S.gold],['POWER',S.power]]);buttons(['공격','회복 (8G)','강화 (20G)','자동 전투 ×5','자동 전투 ×2']);const b=$('.board');","score":130},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":46,"kind":"FUNCTION","symbol":"hit","context":"function hit(){if(S.ended)return true;const dmg=8+S.power*4;S.progress+=dmg;S.hp-=Math.max(1,6+S.stage-S.power);S.score+=dmg;if(S.progress>=100){S.progress=0;S.gold+=12+S.stage*4;S","score":130},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":29,"kind":"FUNCTION","symbol":"failed","context":"function failed(msg){commonProgress();log(msg,'lose');render()}","score":122},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":33,"kind":"FUNCTION","symbol":"renderDefense","context":"function renderDefense(){const goal=C.mode==='bug-defense'?30:15;stats([['CORE',S.hp],['WAVE',S.wave+'/'+goal],['COIN',S.res],['TOWER',S.towers]]);buttons(['타워 설치 (10)','타워 강화 (8)'","score":122},{"file":"web-games/seed-single-defense-strat-celestial-bastion/index.html","line":41,"kind":"FUNCTION","symbol":"actPuzzle","context":"function actPuzzle(i){if(i===0){if(S.score<20)return failed('힌트 비용 점수가 부족하다.');S.score-=20;S.score+=Math.max(2,bestCluster().size);log('가장 큰 색 덩어리를 표시했다.');commonProgress();render(","score":122},{"file":"web-games/seed-single-defense-strat-ce