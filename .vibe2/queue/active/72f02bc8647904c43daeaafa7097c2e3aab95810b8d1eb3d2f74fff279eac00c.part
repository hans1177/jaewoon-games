ll,"buildUpGeneration":0,"buildUpGoal":null,"buildUpSourceTree":null,"buildUpStatus":null,"previousGoal":null,"lastAchievedGoal":null,"developmentDepth":0,"escalationStage":null,"buildUpNextAction":null,"buildUpNextActionReason":null,"nextEscalationRequired":false,"companyContext":null,"sourceRoot":"roblox-games/core-clash-4v4","speculativeEligible":true,"estimatedRisk":"high","atomicNeuronMode":"PER_TASK_MICRO_FANIN","atomicCompletionRequired":true,"taskWorkUnits":6,"packageId":"core-clash-4v4-wp-1uuk76g","packageGoal":"코어 전장 4대4: 관련 구현·품질 개선을 기능 단위로 묶어 끝까지 완료한다.","packageRole":"implementation-owner","packageOwner":"feature-owner:core-clash-4v4","packageWorkUnits":6,"packageSize":1,"packageMinWorkUnits":6,"packageLongWorkProtected":true,"focusedCaretaker":false,"caretakerStickyOwnership":false,"focusCompletionContract":null,"postReleaseFocused":false,"historicalDeploymentRecovery":false,"focusCycle":0,"focusPolicyRef":null,"recoveryGeneration":0,"systemSteward":false,"ownerFocusedCaretaker":false,"packageContext":{"explorationMode":"task-local-exploration-handoff","explorationRequired":true,"sharedPreparation":false,"sourceRoot":"roblox-games/core-clash-4v4","responsibleFiles":["roblox-games/core-clash-4v4/client/Game.client.luau","roblox-games/core-clash-4v4/server/Game.server.luau","roblox-games/core-clash-4v4/shared/GameConfig.luau"],"diagnosticEvidence":[],"roles":{"owner":"work-package-owner","exploration":"read-only-exploration-worker","implementation":"parallel-implementation-workers","test":"incremental-qa-worker","performance":"performance-sanity-worker","regression":"single-fan-in-regression-worker","review":"fan-in-package-review-worker"},"studioQualityEvolution":null},"studioQualityEvolution":null,"completionCriteria":["task-local-exploration-handoff-produced-and-reused","functional-scope-implemented","all-package-task-incremental-qa-pass","performance-sanity-pass","full-core-regression-once-at-fan-in","fan-in-package-review-pass","machine-contract-and-