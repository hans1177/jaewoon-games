tion/shared/GameConfig.luau","roblox-games/seed-single-defense-strat-celestial-bastion/client/Game.client.luau"],"executableCodeCandidateFiles":["roblox-games/seed-single-defense-strat-celestial-bastion/server/Game.server.luau","roblox-games/seed-single-defense-strat-celestial-bastion/client/Game.client.luau"],"gapReasons":["DESIGN_MAIN_A_B_c_AT_INCOMPLETE","MULTIPLAYER_DESIGN_MODE_MISSING","DESIGN_ROLE_NOT_AUTHORED:MAIN","DESIGN_ROLE_NOT_AUTHORED:A","DESIGN_ROLE_NOT_AUTHORED:B","DESIGN_ROLE_NOT_AUTHORED:c","DESIGN_ROLE_NOT_AUTHORED:@"],"codingReviewState":"GAME_STAGE_LOCAL_REPAIR_REQUIRED","sourceImplementationPassed":false,"actualTwoClientPassed":false,"actualWebglRenderPassed":false,"independentQaPassed":false,"stageLocalAction":"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME","schemaAndMarkersAloneCannotPass":true,"newPipeline":false,"changesDevelopmentAdmission":false,"saveBalanceAndExistingMultiplayerMeaningPreserved":true},"designImplementationContext":{"source":"LATEST_VERIFIED_DESIGN_FIELDS","coreFun":"적의 이동 경로를 실시간으로 차단하거나 유도하는 지형 변형의 쾌감, 그리고 배치된 타워의 속성을 조합하여 적의 약점을 공략할 때 발생하는 즉각적인 파괴의 시각적 피드백이 핵심 재미입니다.","coreLoop":["적의 웨이브 정보를 확인하고, 현재 가용 자원을 고려하여 방어 타워를 배치하거나 지형을 수정하여 적의 이동 경로를 최적화합니다.","전투 중 적을 처치하여 획득한 에너지를 사용하여 타워를 강화하거나, 전장의 지형을 추가로 변형하여 방어 효율을 극대화합니다.","웨이브 종료 후 획득한 보상으로 새로운 타워 기술을 연구하거나 기존 타워의 속성을 강화하여 다음 단계의 더 강력한 적에 대비합니다."],"signatureSystems":[{"name":"지형 변형 시스템","purpose":"고정된 맵에서 벗어나 플레이어가 직접 전장의 길을 만들거나 막아 적의 이동 경로를 제어하게 함으로써 전략적 자유도를 극대화합니다.","playerChoice":"플레이어는 특정 구역의 지형을 높여 적의 이동을 차단하거나, 낮추어 특정 타워의 사거리 안으로 적을 유인하는 선택을 할 수 있습니다."},{"name":"속성 공명 시스템","purpose":"단순한 타워 배치를 넘어, 인접한 타워들의 속성을 조합하여 강력한 시너지 효과를 발생시켜 전술적 깊이를 더합니다.","playerChoice":"플레이어는 화염 타워와 전기 타워를 인접하게 배치하여 광역 폭발 효과를 노릴지, 혹은 냉기 타워를 배치하여 적의 이동 속도를 늦출지 선택해야 합니다."}],"systemInterconnections":[{"fromSystem":"지형 변형 시스템","toSystem":"적 AI 경로 탐색","trigger":"플레이어가 지형을 수정하여 이동 경로를 차단하거나 변경할 때","stateChange":"적 AI는 즉시 변경된 지형을 반영하여 최단 경로를 재계산하고 새로운 이동 경로를 생성합니다."},{"fromSystem":"속성 공명 시스템","toSystem":"타워 공격력 계산","trigger":"서로 다른 속성의 타워가 특정 범위 내에 배치되어 공명 조건이 충족될 때","stateChange":"타워의 공격력, 사거리, 혹은 특수 효과가 강화되어 적에게 입히는 데미지 수치가 즉각적으로 상승합니다."},{"fromSystem":"전투 보상 시스템","toSystem":"타워 연구 시스템","trigger":"웨이브를 성공적으로 방어하고 자원을 획득했을 때","stateChange":"플레이어는 획득한 자원을 사용하여 새로운 타워 기술을 해금하거나 기존 타워의 업그레이드 트리를 활성화할 수 있습니다."}],"progressionDirection":"초반에는 기본적인 타워 배치와 지형 활용법을 익히고, 중반부터는 속성 공명을 활용한 복합적인 전략이 요구됩니다. 후반부에는 제한된 자원 내에서 최적의 방어 효율을 찾아내는 퍼즐적 요소와 전략적 판단이 결합된 성장을 지향합니다.","progressionEconomyBalance":{"progressionLoop":"웨이브 방어 성공 -> 자원 획득 -> 타워 강화 및 기술 연구 -> 더 강력한 적 등장 -> 방어 전략 수정의 순환 구조를 가집니다.","resourceFlow":"적 처치 시 획득하는 에너지는 즉각적인 타워 배치와 업그레이드에 사용되며, 웨이브 클리어 보상은 영구적인 기술 연구에 사용되어 성장의 체감을 제공합니다.","balanceRules":"적의 체력과 이동 속도는 웨이브가 진행될수록 점진적으로 상승하며, 플레이어의 타워 강화 속도와 균형을 맞추어 항상 긴장감을 유지하도록 설계합니다."},"contentExpansionPlan":[{"milestone":"환경 상호작용 지형 시스템 도입","newGameplay":"얼음, 용암 등 특수 효과를 가진 지형 타일을 추가하여, 플레이어가 타워 배치 전 지형을 변형하거나 특정 속성 타워를 배치해 환경적 이점을 극대화하는 전략적 플레이를 도입합니다.","systemImpact":"기존의 고정된 그리드 기반 타워 배치 시스템에 환경 변수가 추가되어, 지형 관리 엔진이 타일 속성을 실시간으로 계산하고 전투 로직에 환경 데미지 및 버프를 반영하도록 시스템이 확장됩니다."},{"milestone":"엘리트 적 유닛 및 카운터 메커니즘","newGameplay":"지형을 무시하거나 타워를 일시적으로 무력화하는 특수 능력을 가진 엘리트 적 유닛을 추가하여, 플레이어가 단순히 화력을 집중하는 것이 아니라 특정 타워의 스킬을 타이밍에 맞춰 사용하는 능동적 방어를 수행하게 합니다.","systemImpact":"기존의 단순 경로 차단 AI를 넘어, 적 유닛의 특수 능력과 타워의 방어 스킬 간의 상호작용을 처리하는 전투 로직 엔진의 복잡도가 증가하며, 밸런싱 데이터 수집 시스템이 강화됩니다."},{"milestone":"타워 각성 및 궁극기 시스템","newGameplay":"특정 타워를 최고 레벨까지 강화하면 고유한 궁극기 스킬을 해금하는 각성 시스템을 도입하여, 플레이어가 후반 웨이브에서 전황을 뒤집을 수 있는 강력한 한 방의 선택지를 제공합니다.","systemImpact":"타워 데이터 구조에 각성 상태와 스킬 쿨타임 변수가 추가되며, UI 프레임워크는 각성 가능한 타워를 시각적으로 강조하고 궁극기 버튼을 활성화하는 인터페이스를 지원해야 합니다."}],"failureRetryRisk":{"failureStates":["보루의 내구도가 0이 되어 방어 실패","제한 시간 내에 특정 목표를 달성하지 못함"],"retryFlow":"실패 시 즉시 해당 웨이브의 시작 지점으로 돌아가거나, 이전 체크포인트에서 전략을 수정하여 재도전할 수 있는 기회를 제공합니다.","riskPressure":"실패는 단순히 게임 오버가 아니라, 플레이어가 자신의 전략적 실수를 인지하고 지형 배치나 타워 조합을 변경하도록 유도하는 학습의 과정입니다.","recoveryRules":"재도전 시 이전 시도에서 획득한 일부 자원을 보존하거나, 실패 원인을 분석할 수 있는 힌트 시스템을 제공하여 좌절감을 최소화합니다."},"platformFitPlan":{"targetPlatform":"UNITY","inputModel":"터치 기반의 드래그 앤 드롭으로 타워를 배치하고, 지형을 스와이프하여 변형하는 직관적인 모바일 최적화 조작 방식을 채택합니다.","performanceBudget":"다수의 적 유닛과 타워 효과가 동시에 발생하므로, 오브젝트 풀링을 활용하여 드로우 콜을 최소화하고 모바일 기기에서의 프레임 드랍을 방지합니다.","sessionConstraints":"한 세션당 30분 내외로 구성하며, 웨이브 단위로 끊어 플레이할 수 있도록 하여 짧은 시간에도 몰입 가능한 세션 구조를 설계합니다."},"platformProfiles":{"ROBLOX":{"platform":"ROBLOX","inputModel":"Roblox touch controls first, with keyboard and gamepad parity through ContextActionService and Activated-based UI actions.","sessionModel":"Fast Roblox experience sessions with spawn, respawn, join-in-progress, and social re-entry semantics matched to the common game loop.","multiplayerRuntime":"single-player server boundary with local presentation; no fake multiplayer claims","performanceBudget":"Roblox mobile-first budget: bounded parts and effects, pooled transient objects, limited expensive per-frame work, and stable low-end frame pacing.","uiUx":"Roblox ScreenGui touch-safe layout with readable mobile controls, controller focus support, observable state feedback, and platform-native social affordances.","saveAndNetwork":"Server-validated RemoteEvents plus DataStore-backed persistent state only for approved save meaning; clients never own authoritative rewards or progression.","platformContentAdaptation":"Adapt \"천상의 보루는 고전적인 타워 디펜스 장르를 재해석하여, 플레이어가 실시간으로 전장의 지형을 변형하고 유닛의 속성을 동적으로 조합하는 전략적 깊이를 제공합니다. 핵심 루프인 '적의 경로 예측-방어선 구축-자원 최적화'는 단순한 배치를 넘어, 지형 변형 시스템과 속성 상성 시스템을 통해 매 순간 플레이어의 창의적인 선택이 전황을 뒤바꾸는 고유한 경험을 창출합니다.\" and its loop \"적의 웨이브 정보를 확인하고, 현재 가용 자원을 고려하여 방어 타워를 배치하거나 지형을 수정하여 적의 이동 경로를 최적화합니다. → 전투 중 적을 처치하여 획득한 에너지를 사용하여 타워를 강화하거나, 전장의 지형을 추가로 변형하여 방어 효율을 극대화합니다. → 웨이브 종료 후 획득한 보상으로 새로운 타워 기술을 연구하거나 기존 타워의 속성을 강화하여 다음 단계의 더 강력한 적에 대비합니다.\" to Roblox avatar scale, server/client authority, social sessions, and Roblox-native interaction without changing common gameplay meaning.","internalReleaseTarget":"Private or restricted Roblox experience published to Roblox servers so the owner and explicitly allowed testers can play before public release.","validationEvidence":"Exact published Roblox place and source revision, real Roblox runtime play, mobile controls, server/client boundary, save/rejoin when required, independent QA, and regression evidence."},"UNITY":{"platform":"UNITY","inputModel":"Unity Input System with touch-first on-screen controls, safe-area handling, keyboard and gamepad parity, and app pause/resume input recovery.","sessionModel":"Native mobile app sessions with cold start, suspend/resume, background/foreground transitions, process restart, and deterministic save restoration.","multiplayerRuntime":"single-player app session with local gameplay authority; networking remains disabled until design requires it","performanceBudget":"Android mobile budget covering memory, GPU, thermal load, battery, draw calls, shaders, particles, audio, pooling, GC pressure, and low-end frame pacing.","uiUx":"Unity UI safe-area responsive layout with touch targets, scalable HUD, controller navigation where relevant, and app-native loading/error/recovery states.","saveAndNetwork":"Versioned local save with explicit migration plus validated backend synchronization only when required; app lifecycle cannot silently corrupt progress.","platformContentAdaptation":"Adapt \"천상의 보루는 고전적인 타워 디펜스 장르를 재해석하여, 플레이어가 실시간으로 전장의 지형을 변형하고 유닛의 속성을 동적으로 조합하는 전략적 깊이를 제공합니다. 핵심 루프인 '적의 경로 예측-방어선 구축-자원 최적화'는 단순한 배치를 넘어, 지형 변형 시스템과 속성 상성 시스템을 통해 매 순간 플레이어의 창의적인 선택이 전황을 뒤바꾸는 고유한 경험을 창출합니다.\" and its loop \"적의 웨이브 정보를 확인하고, 현재 가용 자원을 고려하여 방어 타워를 배치하거나 지형을 수정하여 적의 이동 경로를 최적화합니다. → 전투 중 적을 처치하여 획득한 에너지를 사용하여 타워를 강화하거나, 전장의 지형을 추가로 변형하여 방어 효율을 극대화합니다. → 웨이브 종료 후 획득한 보상으로 새로운 타워 기술을 연구하거나 기존 타워의 속성을 강화하여 다음 단계의 더 강력한 적에 대비합니다.\" to Unity scenes, prefabs, mobile app lifecycle, touch UX, and Android packaging without changing common gameplay meaning.","internalReleaseTarget":"Internal or closed Android test build that can be installed and launched by the owner/testers before any public store release.","validationEvidence":"Exact APK/AAB source revision, install and launch, real touch gameplay, pause/resume, save/restore, performance, independent QA, regression, and package identity evidence."}},"webCanonicalDesign":{"role":"SHARED_DESIGN_WEB_APPLICATION","designAuthority":"GAME_DESIGN_REFERENCE_NOT_SOURCE_CODE_AUTHORITY","playerFlow":["적의 웨이브 정보를 확인하고, 현재 가용 자원을 고려하여 방어 타워를 배치하거나 지형을 수정하여 적의 이동 경로를 최적화합니다.","전투 중 적을 처치하여 획득한 에너지를 사용하여 타워를 강화하거나, 전장의 지형을 추가로 변형하여 방어 효율을 극대화합니다.","웨이브 종료 후 획득한 보상으로 새로운 타워 기술을 연구하거나 기존 타워의 속성을 강화하여 다음 단계의 더 강력한 적에 대비합니다.","초반에는 기본적인 타워 배치와 지형 활용법을 익히고, 중반부터는 속성 공명을 활용한 복합적인 전략이 요구됩니다. 후반부에는 제한된 자원 내에서 최적의 방어 효율을 찾아내는 퍼즐적 요소와 전략적 판단이 결합된 성장을 지향합니다."],"worldAndTraversal":"","systemsAndContent":"name: 지형 변형 시스템; purpose: 고정된 맵에서 벗어나 플레이어가 직접 전장의 길을 만들거나 막아 적의 이동 경로를 제어하게 함으로써 전략적 자유도를 극대화합니다.; playerChoice: 플레이어는 특정 구역의 지형을 높여 적의 이동을 차단하거나, 낮추어 특정 타워의 사거리 안으로 적을 유인하는 선택을 할 수 있습니다. / name: 속성 공명 시스템; purpose: 단순한 타워 배치를 넘어, 인접한 타워들의 속성을 조합하여 강력한 시너지 효과를 발생시켜 전술적 깊이를 더합니다.; playerChoice: 플레이어는 화염 타워와 전기 타워를 인접하게 배치하여 광역 폭발 효과를 노릴지, 혹은 냉기 타워를 배치하여 적의 이동 속도를 늦출지 선택해야 합니다.","combatAndInteraction":"적의 이동 경로를 실시간으로 차단하거나 유도하는 지형 변형의 쾌감, 그리고 배치된 타워의 속성을 조합하여 적의 약점을 공략할 때 발생하는 즉각적인 파괴의 시각적 피드백이 핵심 재미입니다.","progressionAndEconomy":"progressionLoop: 웨이브 방어 성공 -> 자원 획득 -> 타워 강화 및 기술 연구 -> 더 강력한 적 등장 -> 방어 전략 수정의 순환 구조를 가집니다.; resourceFlow: 적 처치 시 획득하는 에너지는 즉각적인 타워 배치와 업그레이드에 사용되며, 웨이브 클리어 보상은 영구적인 기술 연구에 사용되어 성장의 체감을 제공합니다.; balanceRules: 적의 체력과 이동 속도는 웨이브가 진행될수록 점진적으로 상승하며, 플레이어의 타워 강화 속도와 균형을 맞추어 항상 긴장감을 유지하도록 설계합니다.","sessionFailureRecovery":"failureStates: 보루의 내구도가 0이 되어 방어 실패 / 제한 시간 내에 특정 목표를 달성하지 못함; retryFlow: 실패 시 즉시 해당 웨이브의 시작 지점으로 돌아가거나, 이전 체크포인트에서 전략을 수정하여 재도전할 수 있는 기회를 제공합니다.; riskPressure: 실패는 단순히 게임 오버가 아니라, 플레이어가 자신의 전략적 실수를 인지하고 지형 배치나 타워 조합을 변경하도록 유도하는 학습의 과정입니다.; recoveryRules: 재도전 시 이전 시도에서 획득한 일부 자원을 보존하거나, 실패 원인을 분석할 수 있는 힌트 시스템을 제공하여 좌절감을 최소화합니다.","uiMenuAndOnboarding":"hudPriorities: 현재 자원, 보루 내구도, 다음 웨이브 정보, 타워 배치 메뉴를 화면 하단과 상단에 고정하여 시선 이동을 최소화합니다.; touchAndInput: 오터치 방지를 위해 타워 배치 시 그리드 스냅 기능을 제공하고, 지형 변형 시에는 명확한 시각적 피드백을 제공합니다.; readability: 색약 모드를 지원하여 속성별 타워와 적의 구분을 색상뿐만 아니라 문양으로도 명확히 식별할 수 있게 합니다.; accessibility: 게임 속도 조절 기능을 제공하여 전략적 판단이 필요한 순간에 충분한 시간을 확보할 수 있도록 돕습니다.","inputCameraAccessibility":"터치 기반의 드래그 앤 드롭으로 타워를 배치하고, 지형을 스와이프하여 변형하는 직관적인 모바일 최적화 조작 방식을 채택합니다.","presentationAndAudio":"visualIdentity: 판타지풍의 화려한 이펙트와 깔끔한 로우 폴리곤 스타일을 결합하여 가독성과 심미성을 동시에 확보합니다.; audioIdentity: 긴박한 전투 상황에서는 웅장한 오케스트라 음악을, 전략을 고민하는 시간에는 차분한 앰비언트 사운드를 사용하여 몰입감을 높입니다.; gameplayFeedbackSync: 타워 공격 시의 타격감과 적 처치 시의 보상 사운드를 명확하게 분리하여 플레이어의 행동에 대한 즉각적인 청각적 피드백을 제공합니다.","multiplayerPersistence":"SINGLE; 현재는 싱글 플레이의 전략적 깊이에 집중하며, 향후 협동 모드나 경쟁 모드 도입 여부는 커뮤니티 피드백을 바탕으로 결정합니다.","expansionSpace":"milestone: 환경 상호작용 지형 시스템 도입; newGameplay: 얼음, 용암 등 특수 효과를 가진 지형 타일을 추가하여, 플레이어가 타워 배치 전 지형을 변형하거나 특정 속성 타워를 배치해 환경적 이점을 극대화하는 전략적 플레이를 도입합니다.; systemImpact: 기존의 고정된 그리드 기반 타워 배치 시스템에 환경 변수가 추가되어, 지형 관리 엔진이 타일 속성을 실시간으로 계산하고 전투 로직에 환경 데미지 및 버프를 반영하도록 시스템이 확장됩니다. / milestone: 엘리트 적 유닛 및 카운터 메커니즘; newGameplay: 지형을 무시하거나 타워를 일시적으로 무력화하는 특수 능력을 가진 엘리트 적 유닛을 추가하여, 플레이어가 단순히 화력을 집중하는 것이 아니라 특정 타워의 스킬을 타이밍에 맞춰 사용하는 능동적 방어를 수행하게 합니다.; systemImpact: 기존의 단순 경로 차단 AI를 넘어, 적 유닛의 특수 능력과 타워의 방어 스킬 간의 상호작용을 처리하는 전투 로직 엔진의 복잡도가 증가하며, 밸런싱 데이터 수집 시스템이 강화됩니다. / milestone: 타워 각성 및 궁극기 시스템; newGameplay: 특정 타워를 최고 레벨까지 강화하면 고유한 궁극기 스킬을 해금하는 각성 시스템을 도입하여, 플레이어가 후반 웨이브에서 전황을 뒤집을 수 있는 강력한 한 방의 선택지를 제공합니다.; systemImpact: 타워 데이터 구조에 각성 상태와 스킬 쿨타임 변수가 추가되며, UI 프레임워크는 각성 가능한 타워를 시각적으로 강조하고 궁극기 버튼을 활성화하는 인터페이스를 지원해야 합니다."},"platformExpansionPolicy":{"mode":"SINGLE_ORIGINAL_PLATFORM_IMPLEMENTATION","sharedLargeFrame":["CORE_IDENTITY","CORE_FUN_AND_REPRESENTATIVE_LOOP","WORLD_AND_PROGRESSION_DIRECTION","SAVE_PERSISTENCE_MEANING","MULTIPLAYER_INTENT"],"expansionLimit":"GAMEPLAY_CHANGES_REQUIRE_SHARED_ORIGINAL_REVISION","webRule":"게임당 하나의 공통 설계 원본을 사용한다. WEB은 같은 MAIN/A/B/c/@·규칙·상태·진행·멀티를 입력·화면·성능·저장 전송에 맞게 구현한다. 별도 원본을 생성하지 않으며 Unity WebGL은 같은 Unity 프로젝트를 사용한다.","unityRule":"동일 공통 원본과 디자이너가 작성한 규칙을 Unity에서 구현한다. 입력·물리 표현·카메라·UI·성능·저장 전송·런타임 검증만 플랫폼에 맞게 적용한다. 게임 규칙 확장은 공통 원본 개정으로 돌아간다.","robloxRule":"기존 Roblox 원본의 규칙과 사용자 요청을 공통 원본에 보존한다. platformProfiles.ROBLOX와 robloxBuildProfile은 같은 원본의 구현·배포·검증 방식이며 독립 게임 설계가 아니다. 다른 플랫폼 실패는 해당 플랫폼의 수정·재시도로 분리한다."},"visualDirection":"천상의 보루라는 이름에 걸맞게 밝고 신비로운 천상의 분위기와 어두운 타락의 대비를 강조합니다. 타워와 적 유닛은 명확한 실루엣과 색상으로 구분하여 전장 상황을 한눈에 파악할 수 있도록 합니다.","mobileUx":"작은 화면에서도 타워의 사거리와 지형의 높낮이를 명확히 인지할 수 있도록 UI를 배치하고, 복잡한 메뉴보다는 직관적인 아이콘과 제스처를 우선합니다.","uxAccessibilityPlan":{"hudPriorities":"현재 자원, 보루 내구도, 다음 웨이브 정보, 타워 배치 메뉴를 화면 하단과 상단에 고정하여 시선 이동을 최소화합니다.","touchAndInput":"오터치 방지를 위해 타워 배치 시 그리드 스냅 기능을 제공하고, 지형 변형 시에는 명확한 시각적 피드백을 제공합니다.","readability":"색약 모드를 지원하여 속성별 타워와 적의 구분을 색상뿐만 아니라 문양으로도 명확히 식별할 수 있게 합니다.","accessibility":"게임 속도 조절 기능을 제공하여 전략적 판단이 필요한 순간에 충분한 시간을 확보할 수 있도록 돕습니다."},"artAudioDirection":{"visualIdentity":"판타지풍의 화려한 이펙트와 깔끔한 로우 폴리곤 스타일을 결합하여 가독성과 심미성을 동시에 확보합니다.","audioIdentity":"긴박한 전투 상황에서는 웅장한 오케스트라 음악을, 전략을 고민하는 시간에는 차분한 앰비언트 사운드를 사용하여 몰입감을 높입니다.","gameplayFeedbackSync":"타워 공격 시의 타격감과 적 처치 시의 보상 사운드를 명확하게 분리하여 플레이어의 행동에 대한 즉각적인 청각적 피드백을 제공합니다."},"selectedDesignPlan":{},"contentVarietyPlan":{},"narrativeDialoguePlan":{},"implementationTraceability":[{"designElement":"지형 변형 시스템 구현","responsibleSystem":"지형 관리 엔진 및 경로 탐색 모듈","validationEvidence":"플레이 테스트를 통해 지형 변형이 적의 경로를 실시간으로 효과적으로 차단하고, 플레이어가 의도한 전략적 우위를 점하는지 경로 탐색 로그 데이터를 분석하여 검증합니다."},{"designElement":"엘리트 적 유닛 전투 로직","responsibleSystem":"전투 로직 엔진 및 AI 상태 머신","validationEvidence":"다양한 타워 조합과 엘리트 적 유닛의 상호작용을 시뮬레이션하여, 적의 특수 능력이 전투 결과에 유의미한 변수로 작용하는지 승률 및 클리어 타임 데이터를 통해 검증합니다."},{"designElement":"타워 각성 UI/UX 인터페이스","responsibleSystem":"UI 프레임워크 및 이벤트 시스템","validationEvidence":"다양한 모바일 기기 해상도에서 각성 버튼의 가독성과 터치 조작의 정확성을 테스트하고, 실제 플레이 중 각성 스킬 사용 빈도와 만족도를 사용자 피드백으로 검증합니다."}],"stabilityPriorityPlan":{}},"gameIdentityAndNonNegotiables":{"identity":"천상의 보루는 고전적인 타워 디펜스 장르를 재해석하여, 플레이어가 실시간으로 전장의 지형을 변형하고 유닛의 속성을 동적으로 조합하는 전략적 깊이를 제공합니다. 핵심 루프인 '적의 경로 예측-방어선 구축-자원 최적화'는 단순한 배치를 넘어, 지형 변형 시스템과 속성 상성 시스템을 통해 매 순간 플레이어의 창의적인 선택이 전황을 뒤바꾸는 고유한 경험을 창출합니다.","coreFun":"적의 이동 경로를 실시간으로 차단하거나 유도하는 지형 변형의 쾌감, 그리고 배치된 타워의 속성을 조합하여 적의 약점을 공략할 때 발생하는 즉각적인 파괴의 시각적 피드백이 핵심 재미입니다.","coreLoop":["적의 웨이브 정보를 확인하고, 현재 가용 자원을 고려하여 방어 타워를 배치하거나 지형을 수정하여 적의 이동 경로를 최적화합니다.","전투 중 적을 처치하여 획득한 에너지를 사용하여 타워를 강화하거나, 전장의 지형을 추가로 변형하여 방어 효율을 극대화합니다.","웨이브 종료 후 획득한 보상으로 새로운 타워 기술을 연구하거나 기존 타워의 속성을 강화하여 다음 단계의 더 강력한 적에 대비합니다."],"signatureSystems":[{"name":"지형 변형 시스템","purpose":"고정된 맵에서 벗어나 플레이어가 직접 전장의 길을 만들거나 막아 적의 이동 경로를 제어하게 함으로써 전략적 자유도를 극대화합니다.","playerChoice":"플레이어는 특정 구역의 지형을 높여 적의 이동을 차단하거나, 낮추어 특정 타워의 사거리 안으로 적을 유인하는 선택을 할 수 있습니다."},{"name":"속성 공명 시스템","purpose":"단순한 타워 배치를 넘어, 인접한 타워들의 속성을 조합하여 강력한 시너지 효과를 발생시켜 전술적 깊이를 더합니다.","playerChoice":"플레이어는 화염 타워와 전기 타워를 인접하게 배치하여 광역 폭발 효과를 노릴지, 혹은 냉기 타워를 배치하여 적의 이동 속도를 늦출지 선택해야 합니다."}],"progressionDirection":"초반에는 기본적인 타워 배치와 지형 활용법을 익히고, 중반부터는 속성 공명을 활용한 복합적인 전략이 요구됩니다. 후반부에는 제한된 자원 내에서 최적의 방어 효율을 찾아내는 퍼즐적 요소와 전략적 판단이 결합된 성장을 지향합니다.","multiplayerMode":"SINGLE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=4","PLACEHOLDER_OR_PRIMITIVE_USAGE_HIGH","UI_MENU_FLOW_SPARSE"],"signals":{"combat":186,"progression":181,"ai":42,"save":66,"multiplayer":30,"animation":29,"motionStates":190,"gameFeel":33,"vfx":24,"camera":33,"audio":4,"audioDynamics":17,"ui":61,"uiFlow":40,"entryFlow":10,"loadingFlow":0,"input":62,"map":178,"landmark":81,"interaction":29,"inventory":6,"equipment":3,"settings":2,"feedback":70,"session":120,"content":166,"choice":35,"connection":2,"performance":23,"lighting":43,"primitive":29,"todo":0,"errorRecovery":19},"topFiles":[{"file":"roblox-games/seed-single-defense-strat-c