ive-graphics-reuse-modes:DIRECT_REUSE_WHEN_ALREADY_CONCEPT_MATCHED,ADAPT_RESTYLE_AND_RETARGET,TRANSFORMATIVE_RECOMBINATION_FROM_MULTIPLE_COMPATIBLE_REFERENCES,NEW_PROJECT_SPECIFIC_EXPRESSION_WHEN_REUSE_WOULD_BE_WEAKER","menu-experience-diversity:v1","existing-game-interface-auto-match:v1","menu-platform-binding:v1","menu-active-platform-binding:GENERIC_WEB_OR_LEGACY_VALIDATION_UI_RUNTIME","unity-web-menu-source:SAME_CANONICAL_UNITY_PROJECT","unity-web-separate-html-css-js-gameplay-ui:FORBIDDEN","menu-one-template-for-all:FORBIDDEN","menu-experience-surfaces:MAIN_MENU,LOBBY_OR_HUB,LOADING_TRANSITION,FIRST_PLAY_GUIDANCE,INVENTORY_UI,SHOP_UI,CRAFT_UI,QUEST_UI,SETTINGS_UI,RESULT_UI","world-lobby-first:v1","world-lobby-theme:CURRENT_GAME_SOURCE_AND_DESIGN","world-lobby-source-preservation:REQUIRED","work-package:fantasy-survival-wp-1ton25g","task-work-units:7","package-work-units:7","package-related-improvements:0","package-role-separation:exploration|implementation|test|performance|regression|review","package-quantity-goal:FEATURE_COMPLETION","learning-motor-candidate-tournament:repeated-verified-failure"],"lastOutcome":null,"reservationId":null,"reservationRunId":null,"reservationRunAttempt":0,"reservedAt":null,"neuronExpectedVariants":0,"neuronResults":[],"runtimeEvidenceCandidate":null,"buildUpDirective":null,"assetRequirements":[],"buildUpDirectiveId":null,"buildUpGeneration":0,"buildUpGoal":null,"buildUpSourceTree":null,"buildUpStatus":null,"previousGoal":null,"lastAchievedGoal":null,"developmentDepth":0,"escalationStage":null,"buildUpNextAction":null,"buildUpNextActionReason":null,"nextEscalationRequired":false,"companyContext":null,"sourceRoot":"web-games/fantasy-survival","speculativeEligible":true,"estimatedRisk":"high","atomicNeuronMode":"PER_TASK_MICRO_FANIN","atomicCompletionRequired":true,"taskWorkUnits":7,"packageId":"fantasy-survival-wp-1ton25g","packageGoal":"마력숲 생존기: 관련 구현·품질 개선을 기능 단위로 묶어 끝까지 완료한다.","packageRole":"implementation-owner","packageOwner":"feature-owner:fantasy-survival","packageWorkUnits":7,"packageSize":1,"packageMinWorkUnits":6,"packageLongWorkProtected":true,"focusedCaretaker":false,"caretakerStickyOwnership":false,"focusCompletionContract":null,"postReleaseFocused":false,"historicalDeploymentRecovery":false,"focusCycle":0,"focusPolicyRef":null,"recoveryGeneration":0,"systemSteward":false,"ownerFocusedCaretaker":false,"packageContext":{"explorationMode":"task-local-exploration-handoff","explorationRequired":true,"sharedPreparation":false,"sourceRoot":"web-games/fantasy-survival","responsibleFiles":["web-games/fantasy-survival/index.html","web-games/fantasy-survival/research-log-2.html","web-games/fantasy-survival/research-log-3.html","web-games/fantasy-survival/research-log.html","web-games/fantasy-survival/tier.html","web-games/fantasy-survival/world3d.mjs"],"diagnosticEvidence":[],"roles":{"owner":"work-package-owner","exploration":"read-only-exploration-worker","implementation":"parallel-implementation-workers","test":"incremental-qa-worker","performance":"performance-sanity-worker","regression":"single-fan-in-regression-worker","review":"fan-in-package-review-worker"},"studioQualityEvolution":null},"studioQualityEvolution":null,"completionCriteria":["task-local-exploration-handoff-produced-and-reused","functional-scope-implemented","all-package-task-incremental-qa-pass","performance-sanity-pass","full-core-regression-once-at-fan-in","fan-in-package-review-pass","machine-contract-and-central-doc-synced-when-architecture-changes","studio-quality-baseline-or-explicit-gap-evidence","studio-quality-focus-implemented","verified-quality-gap-closure-or-delta","no-protected-semantics-regression","verified-learning-feedback-recorded","next-studio-build-cycle-remains-live"],"shard":"web"}