hung-rpg/shared/RPGMenuModel.luau","roblox-games/daechung-rpg/shared/VisualStyle.luau"],"executableCodeCandidateFiles":["roblox-games/daechung-rpg/server/Game.server.luau","roblox-games/daechung-rpg/client/Game.client.luau","roblox-games/daechung-rpg/shared/RPGMenu.luau","roblox-games/daechung-rpg/shared/QACamera.luau","roblox-games/daechung-rpg/shared/RPGMenuModel.luau"],"gapReasons":["DESIGN_MAIN_A_B_c_AT_INCOMPLETE","DESIGN_ROLE_NOT_AUTHORED:MAIN","DESIGN_ROLE_NOT_AUTHORED:A","DESIGN_ROLE_NOT_AUTHORED:B","DESIGN_ROLE_NOT_AUTHORED:c","DESIGN_ROLE_NOT_AUTHORED:@"],"codingReviewState":"GAME_STAGE_LOCAL_REPAIR_REQUIRED","sourceImplementationPassed":false,"actualTwoClientPassed":false,"actualWebglRenderPassed":false,"independentQaPassed":false,"stageLocalAction":"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME","schemaAndMarkersAloneCannotPass":true,"newPipeline":false,"changesDevelopmentAdmission":false,"saveBalanceAndExistingMultiplayerMeaningPreserved":true},"designImplementationContext":{"source":"LATEST_VERIFIED_DESIGN_FIELDS","coreFun":"4인 파티 조합과 장비 세팅을 계속 바꿔 보며 서로 다른 AI 행동·관계·합동기·직업 능력이 맞물리는 순간을 찾는 재미. 희귀도보다 조합과 세팅이 더 중요하다.","coreLoop":["마을과 지역 스토리를 진행해 새로운 AI 동료와 사건을 발견한다.","보유 동료 중 4명을 골라 파티를 만들고 각 동료의 장비, AI 성향, 스킬을 세팅한다.","필드·던전·보스에서 직접 전투하며 파티 조합과 장비가 실제 전투에서 어떻게 맞물리는지 확인한다.","동료 전용 퀘스트, 숙명 관계, 히든 조건, 보스 포섭을 통해 새로운 동료·합동기·전용장비를 얻고 다른 4인 조합을 시험한다."],"signatureSystems":[{"name":"4인 파티 고정","purpose":"파티 슬롯은 항상 4명이며 탱·딜·힐 강제를 없애고 여러 조합이 실전에서 성립하도록 밸런스를 맞춘다.","playerChoice":""},{"name":"무한 확장 AI 동료","purpose":"새 지역·스토리 업데이트마다 동료를 계속 추가할 수 있고 각 동료는 전용 스토리, AI 행동, 스킬과 장비 방향을 가진다.","playerChoice":""},{"name":"숙명 관계","purpose":"특정 동료 조합이 함께 사건을 겪으면 전용 대사, 관계 변화, 합동기 또는 전투 규칙 변화가 열린다.","playerChoice":""},{"name":"파티 기억","purpose":"같은 4인으로 중요한 사건·보스·역전을 겪은 기록이 파티 정체성으로 남고 특수 대사·행동·지원 효과를 연다.","playerChoice":""},{"name":"보스·히든 동료","purpose":"특정 보스를 죽이는 대신 조건을 만족해 포섭하거나 숨겨진 시간·아이템·동료 조합으로 레어 동료를 발견한다.","playerChoice":""},{"name":"장비가 AI를 바꿈","purpose":"장비는 수치뿐 아니라 공격성, 보호 우선, 상태이상 활용 같은 AI 행동 우선순위와 스킬 운용을 바꾼다.","playerChoice":""},{"name":"라이벌 AI 파티","purpose":"다른 AI 4인 파티도 세계에서 성장하고 보스·보물·사건을 경쟁하거나 때로 협력한다.","playerChoice":""},{"name":"조합 엔딩","purpose":"특정 4인 조합으로 주요 스토리를 끝내면 그 조합만의 후일담·비밀 엔딩을 볼 수 있다.","playerChoice":""}],"systemInterconnections":[{"fromSystem":"대충 주사위 판정 시스템","toSystem":"위험도 가속기 시스템","trigger":"플레이어가 주사위 판정에서 연속으로 대성공을 거두어 던전 깊숙이 진입할 때 발생합니다.","stateChange":"던전의 기본 위험도 수치가 즉시 2배로 증가하며, 몬스터의 공격력과 드롭되는 골드량이 동시에 가속화됩니다."},{"fromSystem":"위험도 가속기 시스템","toSystem":"대충 주사위 판정 시스템","trigger":"위험도 가속 수치가 최대치에 도달하여 던전 환경이 폭주 상태로 전환될 때 발생합니다.","stateChange":"주사위 판정에 필요한 최소 성공 요구치가 상승하며, 실패 시 캐릭터가 받는 피해량이 3배로 증가합니다."},{"fromSystem":"대충 주사위 판정 시스템","toSystem":"골드 경제 시스템","trigger":"주사위 판정 결과 보물상자 획득 또는 정예 몬스터 처치 판정이 성공했을 때 발생합니다.","stateChange":"플레이어의 보유 골드가 즉시 증가하며, 마을 상점에서 영구 능력치를 해금할 수 있는 재화 상태로 전환됩니다."}],"progressionDirection":"초기 4인 동료 확보 → 지역 스토리와 장비 파밍 → 숙명 관계·전용 퀘스트 → 히든/보스 동료 → 고난도 조합전투 → 라이벌 파티 경쟁 → 조합별 엔딩과 계속 추가되는 새 동료.","progressionEconomyBalance":{"progressionLoop":"스토리·전투 -> 동료/장비/관계 해금 -> 4인 파티 재구성 -> 더 어려운 전투/히든 조건 -> 새 동료와 전용장비","resourceFlow":"골드와 재료는 장비 제작·강화·동료 세팅에 사용하지만 특정 희귀 동료나 장비만 있으면 압도하도록 만들지 않는다.","balanceRules":"희귀도는 상위호환이 아니라 플레이 방식 차이로 제한한다. 내부 밸런스 목표는 특정 동료가 거의 모든 상위 조합에 고정되거나 한 조합이 동급 콘텐츠에서 약 15~20% 이상 지속적으로 압도하지 않게 조정한다."},"contentExpansionPlan":[{"milestone":"새 지역과 동료군","newGameplay":"새 스토리 지역마다 일반·히든·보스 동료와 전용 장비, 관계 퀘스트를 추가한다.","systemImpact":"기존 4인 조합과 새 동료 간 상호작용을 추가해 조합 수를 계속 확장한다."},{"milestone":"라이벌 파티 시즌","newGameplay":"성장하는 AI 파티가 필드·보스·보물 경쟁에 개입한다.","systemImpact":"같은 콘텐츠라도 어떤 라이벌을 만나는지에 따라 전투와 스토리 결과가 달라진다."},{"milestone":"조합 엔딩","newGameplay":"특정 4인 파티의 기억과 관계를 충족하면 고유 후일담과 비밀 보스를 연다.","systemImpact":"동료 수집을 단순 도감이 아니라 반복 플레이 동기로 연결한다."}],"failureRetryRisk":{"failureStates":["4인 파티 전멸","특정 동료·장비 조합이 전투 기믹과 맞지 않아 공략 실패","라이벌 파티에게 목표를 선점당함"],"retryFlow":"전멸 후 마을에서 동료·장비·AI 성향을 빠르게 바꾸고 다시 도전한다.","riskPressure":"같은 강한 캐릭터만 반복 사용하기보다 적 패턴·관계·장비에 따라 파티를 바꾸는 것이 유리하게 설계한다.","recoveryRules":"스토리 필수 동료는 영구 소실되지 않으며 분기·이탈은 다른 퀘스트나 복귀 루트로 이어진다."},"platformFitPlan":{"targetPlatform":"ROBLOX_UNITY","inputModel":"3D 액션 이동·공격·회피·스킬을 모바일/키보드/게임패드에 맞게 제공하고 파티 명령은 소수의 직관 버튼으로 제한한다.","performanceBudget":"동시에 활성화되는 AI 동료·적 수를 전투 구역 단위로 제한하고 경로탐색/스킬 평가 주기를 분산한다.","sessionConstraints":"짧은 사냥과 긴 스토리/던전 모두 가능하지만 한 전투 안에서는 파티 조합의 차이가 빠르게 드러나야 한다."},"platformProfiles":{"ROBLOX":{"platform":"ROBLOX","inputModel":"Roblox touch controls first, with keyboard and gamepad parity through ContextActionService and Activated-based UI actions.","sessionModel":"마을에서 4인 파티를 편성하고 스토리·필드·던전으로 출발하는 지속형 RPG 세션. 실제 플레이어가 들어오면 AI 슬롯을 대체할 수 있다.","multiplayerRuntime":"싱글은 플레이어 1 + AI 동료 3, 멀티는 실제 플레이어가 AI 슬롯을 대체해 최대 4인 파티를 구성한다. 서버가 동료 전투 AI, 장비, 관계 효과, 보상과 파티 상태를 authoritative하게 관리한다.","performanceBudget":"Roblox mobile-first budget: bounded parts and effects, pooled transient objects, limited expensive per-frame work, and stable low-end frame pacing.","uiUx":"모바일 전투 HUD는 이동·공격·회피·핵심 스킬과 간단 파티 명령만 제공하고, 파티 편성·장비·관계는 별도 화면에서 관리한다.","saveAndNetwork":"동료 보유, 스토리 분기, 관계, 파티 기억, 장비, AI 성향, 히든/보스 동료 해금은 DataStore에 저장하며 전투 판정은 서버 권한으로 처리한다.","platformContentAdaptation":"Adapt \"대충 RPG는 한 손 조작 기반의 초고속 탐험과 자동 전투, 그리고 실시간 위험 회피가 결합된 캐주얼 로그라이트 RPG입니다. 플레이어는 매 순간 전진할지 후퇴할지 결정해야 하며, 이 선택은 시그니처 시스템인 '대충 주사위 판정'과 '위험도 가속기'를 통해 즉각적인 보상과 치명적인 패널티로 이어집니다. 기존의 복잡한 RPG 시스템을 걷어내고, 오직 타이밍과 확률적 선택에만 집중하여 매 세션마다 고유한 상태 변화를 만들어냅니다.\" and its loop \"입력 및 선택: 플레이어가 화면을 터치하여 캐릭터를 전진시키고, 무작위로 등장하는 인카운터(전투, 상자, 함정)에 직면합니다. → 상태 변화: 캐릭터의 체력과 던전 위험도가 실시간으로 변동하며, 주사위 굴림을 통해 전투의 승패와 획득 보상이 결정됩니다. → 보상 및 다음 선택: 획득한 골드로 능력치를 즉시 강화하거나, 더 높은 난이도의 던전으로 진입할지 아니면 안전하게 복귀할지 결정합니다.\" to Roblox avatar scale, server/client authority, social sessions, and Roblox-native interaction without changing common gameplay meaning.","internalReleaseTarget":"Private or restricted Roblox experience published to Roblox servers so the owner and explicitly allowed testers can play before public release.","validationEvidence":"4인 파티 구성 다양성, AI 슬롯의 실제 플레이어 대체, 장비에 따른 AI 행동 변화, 동료 관계/합동기, 저장·재접속, 모바일 전투를 실제 Roblox 서버에서 검증한다."},"UNITY":{"platform":"UNITY","inputModel":"Unity Input System with touch-first on-screen controls, safe-area handling, keyboard and gamepad parity, and app pause/resume input recovery.","sessionModel":"스토리 중심 3D 파티 액션 RPG 세션으로 마을 편성, 지역 탐험, 전투, 귀환과 관계 이벤트가 연결된다.","multiplayerRuntime":"싱글 1+3 AI 파티와 최대 4인 실제/AI 혼합 파티를 같은 파티 규칙으로 지원하고 전투·장비·관계 상태를 권한 주체가 검증한다.","performanceBudget":"Android mobile budget covering memory, GPU, thermal load, battery, draw calls, shaders, particles, audio, pooling, GC pressure, and low-end frame pacing.","uiUx":"터치·패드 전투와 파티 편성/장비/관계 UI를 분리해 가독성을 유지한다.","saveAndNetwork":"버전 저장에 동료, 장비, 스토리, 관계, 파티 기억을 보존하고 멀티 세션 상태는 권한 서버/호스트가 검증한다.","platformContentAdaptation":"Adapt \"대충 RPG는 한 손 조작 기반의 초고속 탐험과 자동 전투, 그리고 실시간 위험 회피가 결합된 캐주얼 로그라이트 RPG입니다. 플레이어는 매 순간 전진할지 후퇴할지 결정해야 하며, 이 선택은 시그니처 시스템인 '대충 주사위 판정'과 '위험도 가속기'를 통해 즉각적인 보상과 치명적인 패널티로 이어집니다. 기존의 복잡한 RPG 시스템을 걷어내고, 오직 타이밍과 확률적 선택에만 집중하여 매 세션마다 고유한 상태 변화를 만들어냅니다.\" and its loop \"입력 및 선택: 플레이어가 화면을 터치하여 캐릭터를 전진시키고, 무작위로 등장하는 인카운터(전투, 상자, 함정)에 직면합니다. → 상태 변화: 캐릭터의 체력과 던전 위험도가 실시간으로 변동하며, 주사위 굴림을 통해 전투의 승패와 획득 보상이 결정됩니다. → 보상 및 다음 선택: 획득한 골드로 능력치를 즉시 강화하거나, 더 높은 난이도의 던전으로 진입할지 아니면 안전하게 복귀할지 결정합니다.\" to Unity scenes, prefabs, mobile app lifecycle, touch UX, and Android packaging without changing common gameplay meaning.","internalReleaseTarget":"Internal or closed Android test build that can be installed and launched by the owner/testers before any public store release.","validationEvidence":"혼합 4인 파티, AI 행동, 스토리 동료 합류, 장비/관계 저장, 실기기 전투 성능과 회귀를 검증한다."}},"webCanonicalDesign":{"role":"SHARED_DESIGN_WEB_APPLICATION","designAuthority":"GAME_DESIGN_REFERENCE_NOT_SOURCE_CODE_AUTHORITY","playerFlow":["마을과 지역 스토리를 진행해 새로운 AI 동료와 사건을 발견한다.","보유 동료 중 4명을 골라 파티를 만들고 각 동료의 장비, AI 성향, 스킬을 세팅한다.","필드·던전·보스에서 직접 전투하며 파티 조합과 장비가 실제 전투에서 어떻게 맞물리는지 확인한다.","동료 전용 퀘스트, 숙명 관계, 히든 조건, 보스 포섭을 통해 새로운 동료·합동기·전용장비를 얻고 다른 4인 조합을 시험한다."],"worldAndTraversal":"","systemsAndContent":"name: 4인 파티 고정; purpose: 파티 슬롯은 항상 4명이며 탱·딜·힐 강제를 없애고 여러 조합이 실전에서 성립하도록 밸런스를 맞춘다. / name: 무한 확장 AI 동료; purpose: 새 지역·스토리 업데이트마다 동료를 계속 추가할 수 있고 각 동료는 전용 스토리, AI 행동, 스킬과 장비 방향을 가진다. / name: 숙명 관계; purpose: 특정 동료 조합이 함께 사건을 겪으면 전용 대사, 관계 변화, 합동기 또는 전투 규칙 변화가 열린다. / name: 파티 기억; purpose: 같은 4인으로 중요한 사건·보스·역전을 겪은 기록이 파티 정체성으로 남고 특수 대사·행동·지원 효과를 연다. / name: 보스·히든 동료; purpose: 특정 보스를 죽이는 대신 조건을 만족해 포섭하거나 숨겨진 시간·아이템·동료 조합으로 레어 동료를 발견한다. / name: 장비가 AI를 바꿈; purpose: 장비는 수치뿐 아니라 공격성, 보호 우선, 상태이상 활용 같은 AI 행동 우선순위와 스킬 운용을 바꾼다. / name: 라이벌 AI 파티; purpose: 다른 AI 4인 파티도 세계에서 성장하고 보스·보물·사건을 경쟁하거나 때로 협력한다. / name: 조합 엔딩; purpose: 특정 4인 조합으로 주요 스토리를 끝내면 그 조합만의 후일담·비밀 엔딩을 볼 수 있다.","combatAndInteraction":"4인 파티 조합과 장비 세팅을 계속 바꿔 보며 서로 다른 AI 행동·관계·합동기·직업 능력이 맞물리는 순간을 찾는 재미. 희귀도보다 조합과 세팅이 더 중요하다.","progressionAndEconomy":"progressionLoop: 스토리·전투 -> 동료/장비/관계 해금 -> 4인 파티 재구성 -> 더 어려운 전투/히든 조건 -> 새 동료와 전용장비; resourceFlow: 골드와 재료는 장비 제작·강화·동료 세팅에 사용하지만 특정 희귀 동료나 장비만 있으면 압도하도록 만들지 않는다.; balanceRules: 희귀도는 상위호환이 아니라 플레이 방식 차이로 제한한다. 내부 밸런스 목표는 특정 동료가 거의 모든 상위 조합에 고정되거나 한 조합이 동급 콘텐츠에서 약 15~20% 이상 지속적으로 압도하지 않게 조정한다.","sessionFailureRecovery":"failureStates: 4인 파티 전멸 / 특정 동료·장비 조합이 전투 기믹과 맞지 않아 공략 실패 / 라이벌 파티에게 목표를 선점당함; retryFlow: 전멸 후 마을에서 동료·장비·AI 성향을 빠르게 바꾸고 다시 도전한다.; riskPressure: 같은 강한 캐릭터만 반복 사용하기보다 적 패턴·관계·장비에 따라 파티를 바꾸는 것이 유리하게 설계한다.; recoveryRules: 스토리 필수 동료는 영구 소실되지 않으며 분기·이탈은 다른 퀘스트나 복귀 루트로 이어진다.","uiMenuAndOnboarding":"hudPriorities: 화면 최상단에 현재 체력과 획득 골드를 표시하고, 중앙에는 주사위 판정 창, 하단에는 전진/탈출 액션 버튼을 배치하여 시각적 위계를 명확히 합니다.; touchAndInput: 모든 터치 영역은 최소 64dp 이상으로 확보하여 오작동을 방지하며, 햅틱 피드백을 적극 활용하여 주사위 충돌과 타격감을 손끝으로 전달합니다.; readability: 고대비 폰트와 굵은 외곽선을 사용하여 야외 광원 아래에서도 텍스트와 수치를 명확히 읽을 수 있도록 가독성을 극대화합니다.; accessibility: 적녹색약 플레이어를 위해 함정과 몬스터의 경고 범위를 단순 색상이 아닌 빗금 패턴과 아이콘으로 병행 표기합니다.","inputCameraAccessibility":"3D 액션 이동·공격·회피·스킬을 모바일/키보드/게임패드에 맞게 제공하고 파티 명령은 소수의 직관 버튼으로 제한한다.","presentationAndAudio":"visualIdentity: 판타지 광장, 룬 기둥, 발광 수정, 무기 실루엣을 중심으로 한 스타일라이즈드 3D. 동료는 직업별 색과 무기 실루엣이 명확하고 보스는 큰 체형·별도 조명·전용 색으로 즉시 구분한다.; audioIdentity: 경쾌한 8비트 레트로 사운드와 웅장한 오케스트라 악기를 혼합하여, 가볍지만 모험의 긴장감을 잃지 않는 독창적인 사운드트랙을 제공합니다.; gameplayFeedbackSync: 주사위가 굴러가서 멈추는 순간의 둔탁한 타격음과 몬스터 처치 시 골드가 쏟아지는 금속성 효과음을 화면 연출과 0.01초 단위로 동기화하여 타격감을 극대화합니다.","multiplayerPersistence":"COOP; 싱글에서는 플레이어 1명 + AI 동료 3명이 기본이며, 멀티에서는 실제 플레이어가 AI 슬롯을 자연스럽게 대체해 최대 4인 파티를 만든다. 실제 플레이어 수와 무관하게 파티 구성·장비·동료 조합의 의미는 유지한다.","expansionSpace":"milestone: 새 지역과 동료군; newGameplay: 새 스토리 지역마다 일반·히든·보스 동료와 전용 장비, 관계 퀘스트를 추가한다.; systemImpact: 기존 4인 조합과 새 동료 간 상호작용을 추가해 조합 수를 계속 확장한다. / milestone: 라이벌 파티 시즌; newGameplay: 성장하는 AI 파티가 필드·보스·보물 경쟁에 개입한다.; systemImpact: 같은 콘텐츠라도 어떤 라이벌을 만나는지에 따라 전투와 스토리 결과가 달라진다. / milestone: 조합 엔딩; newGameplay: 특정 4인 파티의 기억과 관계를 충족하면 고유 후일담과 비밀 보스를 연다.; systemImpact: 동료 수집을 단순 도감이 아니라 반복 플레이 동기로 연결한다."},"platformExpansionPolicy":{"mode":"SINGLE_ORIGINAL_PLATFORM_IMPLEMENTATION","sharedLargeFrame":["CORE_IDENTITY","CORE_FUN_AND_REPRESENTATIVE_LOOP","WORLD_AND_PROGRESSION_DIRECTION","SAVE_PERSISTENCE_MEANING","MULTIPLAYER_INTENT"],"expansionLimit":"GAMEPLAY_CHANGES_REQUIRE_SHARED_ORIGINAL_REVISION","webRule":"게임당 하나의 공통 설계 원본을 사용한다. WEB은 같은 MAIN/A/B/c/@·규칙·상태·진행·멀티를 입력·화면·성능·저장 전송에 맞게 구현한다. 별도 원본을 생성하지 않으며 Unity WebGL은 같은 Unity 프로젝트를 사용한다.","unityRule":"동일 공통 원본과 디자이너가 작성한 규칙을 Unity에서 구현한다. 입력·물리 표현·카메라·UI·성능·저장 전송·런타임 검증만 플랫폼에 맞게 적용한다. 게임 규칙 확장은 공통 원본 개정으로 돌아간다.","robloxRule":"기존 Roblox 원본의 규칙과 사용자 요청을 공통 원본에 보존한다. platformProfiles.ROBLOX와 robloxBuildProfile은 같은 원본의 구현·배포·검증 방식이며 독립 게임 설계가 아니다. 다른 플랫폼 실패는 해당 플랫폼의 수정·재시도로 분리한다."},"visualDirection":"세 게임 중 캐릭터와 전투 연출 퀄리티를 가장 높게 잡는 애니메이션풍 스타일라이즈드 판타지 3D. 기본 Roblox 아바타 감각은 유지하되 직업·동료·보스가 얼굴, 무기, 실루엣, 스킬 이펙트만 봐도 구분되도록 한다. 실사보다 강한 색 대비와 읽기 쉬운 전투 이펙트를 우선한다.","mobileUx":"직접 전투 조작은 이동·기본공격·회피·핵심 스킬 중심으로 단순화하고, 파티 편성·장비·AI 성향은 전투 밖에서 명확한 카드형 UI로 관리한다.","uxAccessibilityPlan":{"hudPriorities":"화면 최상단에 현재 체력과 획득 골드를 표시하고, 중앙에는 주사위 판정 창, 하단에는 전진/탈출 액션 버튼을 배치하여 시각적 위계를 명확히 합니다.","touchAndInput":"모든 터치 영역은 최소 64dp 이상으로 확보하여 오작동을 방지하며, 햅틱 피드백을 적극 활용하여 주사위 충돌과 타격감을 손끝으로 전달합니다.","readability":"고대비 폰트와 굵은 외곽선을 사용하여 야외 광원 아래에서도 텍스트와 수치를 명확히 읽을 수 있도록 가독성을 극대화합니다.","accessibility":"적녹색약 플레이어를 위해 함정과 몬스터의 경고 범위를 단순 색상이 아닌 빗금 패턴과 아이콘으로 병행 표기합니다."},"artAudioDirection":{"visualIdentity":"판타지 광장, 룬 기둥, 발광 수정, 무기 실루엣을 중심으로 한 스타일라이즈드 3D. 동료는 직업별 색과 무기 실루엣이 명확하고 보스는 큰 체형·별도 조명·전용 색으로 즉시 구분한다.","audioIdentity":"경쾌한 8비트 레트로 사운드와 웅장한 오케스트라 악기를 혼합하여, 가볍지만 모험의 긴장감을 잃지 않는 독창적인 사운드트랙을 제공합니다.","gameplayFeedbackSync":"주사위가 굴러가서 멈추는 순간의 둔탁한 타격음과 몬스터 처치 시 골드가 쏟아지는 금속성 효과음을 화면 연출과 0.01초 단위로 동기화하여 타격감을 극대화합니다."},"selectedDesignPlan":{},"contentVarietyPlan":{},"narrativeDialoguePlan":{},"implementationTraceability":[{"designElement":"대충 주사위 판정 시스템의 물리 기반 연출 및 결과 도출 과정","responsibleSystem":"DicePhysicsManager 및 UIResultPresenter 시스템","validationEvidence":"주사위 투척 입력 후 1.2초 이내에 물리 연출이 완료되고, 판정 결과 수치가 UI에 오차 없이 동기화되어 표시되는지 프레임 단위 테스트를 통해 검증합니다."},{"designElement":"위험도 가속기에 따른 몬스터 능력치 실시간 스케일링 공식","responsibleSystem":"DungeonDifficultyDirector 시스템","validationEvidence":"가속도 단계가 상승할 때마다 몬스터의 공격력과 체력이 기획된 지수 그래프 모델을 정확히 따르는지 시뮬레이터 로그 분석을 통해 검증합니다."},{"designElement":"사망 시 골드 유실 및 마을 복귀 처리 흐름","responsibleSystem":"PlayerInventoryAndSessionManager 시스템","validationEvidence":"던전 내 사망 트리거 발생 시 보유 골드의 정확히 50%가 차감되고, 로딩 시간 2초 이내에 마을 씬으로 안전하게 전환되는지 예외 처리 테스트를 통해 검증합니다."}],"stabilityPriorityPlan":{}},"gameIdentityAndNonNegotiables":{"identity":"스토리에서 동료를 만나 영입하고, 수십·수백 명까지 확장되는 AI 동료 풀에서 4인 파티를 구성해 직접 전투·장비 세팅·관계 조합을 연구하는 3D 파티 액션 RPG.","coreFun":"4인 파티 조합과 장비 세팅을 계속 바꿔 보며 서로 다른 AI 행동·관계·합동기·직업 능력이 맞물리는 순간을 찾는 재미. 희귀도보다 조합과 세팅이 더 중요하다.","coreLoop":["마을과 지역 스토리를 진행해 새로운 AI 동료와 사건을 발견한다.","보유 동료 중 4명을 골라 파티를 만들고 각 동료의 장비, AI 성향, 스킬을 세팅한다.","필드·던전·보스에서 직접 전투하며 파티 조합과 장비가 실제 전투에서 어떻게 맞물리는지 확인한다.","동료 전용 퀘스트, 숙명 관계, 히든 조건, 보스 포섭을 통해 새로운 동료·합동기·전용장비를 얻고 다른 4인 조합을 시험한다."],"signatureSystems":[{"name":"4인 파티 고정","purpose":"파티 슬롯은 항상 4명이며 탱·딜·힐 강제를 없애고 여러 조합이 실전에서 성립하도록 밸런스를 맞춘다.","playerChoice":""},{"name":"무한 확장 AI 동료","purpose":"새 지역·스토리 업데이트마다 동료를 계속 추가할 수 있고 각 동료는 전용 스토리, AI 행동, 스킬과 장비 방향을 가진다.","playerChoice":""},{"name":"숙명 관계","purpose":"특정 동료 조합이 함께 사건을 겪으면 전용 대사, 관계 변화, 합동기 또는 전투 규칙 변화가 열린다.","playerChoice":""},{"name":"파티 기억","purpose":"같은 4인으로 중요한 사건·보스·역전을 겪은 기록이 파티 정체성으로 남고 특수 대사·행동·지원 효과를 연다.","playerChoice":""},{"name":"보스·히든 동료","purpose":"특정 보스를 죽이는 대신 조건을 만족해 포섭하거나 숨겨진 시간·아이템·동료 조합으로 레어 동료를 발견한다.","playerChoice":""},{"name":"장비가 AI를 바꿈","purpose":"장비는 수치뿐 아니라 공격성, 보호 우선, 상태이상 활용 같은 AI 행동 우선순위와 스킬 운용을 바꾼다.","playerChoice":""},{"name":"라이벌 AI 파티","purpose":"다른 AI 4인 파티도 세계에서 성장하고 보스·보물·사건을 경쟁하거나 때로 협력한다.","playerChoice":""},{"name":"조합 엔딩","purpose":"특정 4인 조합으로 주요 스토리를 끝내면 그 조합만의 후일담·비밀 엔딩을 볼 수 있다.","playerChoice":""}],"progressionDirection":"초기 4인 동료 확보 → 지역 스토리와 장비 파밍 → 숙명 관계·전용 퀘스트 → 히든/보스 동료 → 고난도 조합전투 → 라이벌 파티 경쟁 → 조합별 엔딩과 계속 추가되는 새 동료.","multiplayerMode":"COOP","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=9","PLACEHOLDER_OR_PRIMITIVE_USAGE_HIGH","UI_MENU_FLOW_SPARSE"],"signals":{"combat":686,"progression":542,"ai":73,"save":185,"multiplayer":18,"animation":58,"motionStates":721,"gameFeel":38,"vfx":49,"camera":118,"audio":44,"audioDynamics":20,"ui":234,"uiFlow":209,"entryFlow":8,"loadingFlow":0,"input":115,"map":545,"landmark":47,"interaction":167,"inventory":61,"equipment":148,"settings":13,"feedback":135,"session":75,"content":834,"choice":138,"connection":4,"performance":41,"lighting":87,"primitive":34,"todo":0,"errorRecovery":22},"topFiles":[{"file":"roblox-games/daechung-rpg/server/Game.server.luau","score":483},{"file":"roblox-games/daechung-rpg/shared/GameConfig.luau","score":367},{"file":"roblox-games/daechung-rpg/client/Game.client.luau","score":359},{"file":"roblox-games/daechung-rpg/shared/RPGMenu.luau","score":179},{"file":"roblox-gam