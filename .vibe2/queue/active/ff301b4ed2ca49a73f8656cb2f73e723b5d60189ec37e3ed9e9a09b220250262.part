au","symbol":"label","kind":"FUNCTION"},{"file":"roblox-games/daechung-rpg/shared/RPGMenu.luau","symbol":"scheduleRefresh","kind":"FUNCTION"},{"file":"roblox-games/daechung-rpg/shared/RPGMenu.luau","symbol":"watchTools","kind":"FUNCTION"},{"file":"roblox-games/daechung-rpg/shared/RPGMenuModel.luau","symbol":"Model.layout","kind":"FUNCTION"},{"file":"roblox-games/daechung-rpg/shared/RPGMenuModel.luau","symbol":"Model.equipment","kind":"FUNCTION"}],"designTraceability":[{"designElement":"대충 주사위 판정 시스템의 물리 기반 연출 및 결과 도출 과정","responsibleSystem":"DicePhysicsManager 및 UIResultPresenter 시스템","validationEvidence":"주사위 투척 입력 후 1.2초 이내에 물리 연출이 완료되고, 판정 결과 수치가 UI에 오차 없이 동기화되어 표시되는지 프레임 단위 테스트를 통해 검증합니다."},{"designElement":"위험도 가속기에 따른 몬스터 능력치 실시간 스케일링 공식","responsibleSystem":"DungeonDifficultyDirector 시스템","validationEvidence":"가속도 단계가 상승할 때마다 몬스터의 공격력과 체력이 기획된 지수 그래프 모델을 정확히 따르는지 시뮬레이터 로그 분석을 통해 검증합니다."},{"designElement":"사망 시 골드 유실 및 마을 복귀 처리 흐름","responsibleSystem":"PlayerInventoryAndSessionManager 시스템","validationEvidence":"던전 내 사망 트리거 발생 시 보유 골드의 정확히 50%가 차감되고, 로딩 시간 2초 이내에 마을 씬으로 안전하게 전환되는지 예외 처리 테스트를 통해 검증합니다."}]},"sourceFiles":["roblox-games/daechung-rpg/server/Game.server.luau","roblox-games/daechung-rpg/client/Game.client.luau","roblox-games/daechung-rpg/shared/GameConfig.luau","roblox-games/daechung-rpg/shared/RPGMenu.luau","roblox-games/daechung-rpg/shared/QACamera.luau","roblox-games/daechung-rpg/shared/RPGMenuModel.luau","roblox-games/daechung-rpg/shared/VisualStyle.luau"],"authoringOrder":["MACRO_REGIONS","TRAVERSAL_AND_OBJECTIVES","OBJECT_VOLUMES_AND_SUPPORT","INTERACTION_AND_STATE_CONNECTIONS","NATIVE_SOURCE"],"preserve":["EXISTING_OBJECT_IDS","EXISTING_TRANSFORMS_UNLESS_DESIGN_REQUIRES_CHANGE","SPAWN_COUNTS","BALANCE","SAVE","SERVER_AUTHORITY"],"runtimeChecks":["EXACT_BUILD_SCENE_BINDINGS","ACTUAL_GROUND_AND_COLLIDERS","PLAYER_ROUTE_REPLAY","INTERACTION_STATE_CHANGE","CAMERA_OCCLUSION_AND_SIGHTLINES","MOBILE_VIEW_AND_PERFORMANCE","MENU_OPEN_BACK_CLOSE_STATE_PRESERVATION","TOUCH_SCROLL_AND_DISABLED_ACTION_GUARDS"],"runtimeVerified":false},"interfaceBlueprintContract":{"version":1,"required":false,"designFingerprint":"e42cef62e6113de6246753410595be0660f3e9dc53ad02cc55a4a4cda9786826","requirements":{"identity":"스토리에서 동료를 만나 영입하고, 수십·수백 명까지 확장되는 AI 동료 풀에서 4인 파티를 구성해 직접 전투·장비 세팅·관계 조합을 연구하는 3D 파티 액션 RPG.","genre":"RPG","coreLoop":["마을과 지역 스토리를 진행해 새로운 AI 동료와 사건을 발견한다.","보유 동료 중 4명을 골라 파티를 만들고 각 동료의 장비, AI 성향, 스킬을 세팅한다.","필드·던전·보스에서 직접 전투하며 파티 조합과 장비가 실제 전투에서 어떻게 맞물리는지 확인한다.","동료 전용 퀘스트, 숙명 관계, 히든 조건, 보스 포섭을 통해 새로운 동료·합동기·전용장비를 얻고 다른 4인 조합을 시험한다."],"systems":[{"fromSystem":"대충 주사위 판정 시스템","toSystem":"위험도 가속기 시스템","trigger":"플레이어가 주사위 판정에서 연속으로 대성공을 거두어 던전 깊숙이 진입할 때 발생합니다.","stateChange":"던전의 기본 위험도 수치가 즉시 2배로 증가하며, 몬스터의 공격력과 드롭되는 골드량이 동시에 가속화됩니다."},{"fromSystem":"위험도 가속기 시스템","toSystem":"대충 주사위 판정 시스템","trigger":"위험도 가속 수치가 최대치에 도달하여 던전 환경이 폭주 상태로 전환될 때 발생합니다.","stateChange":"주사위 판정에 필요한 최소 성공 요구치가 상승하며, 실패 시 캐릭터가 받는 피해량이 3배로 증가합니다."},{"fromSystem":"대충 주사위 판정 시스템","toSystem":"골드 경제 시스템","trigger":"주사위 판정 결과 보물상자 획득 또는 정예 몬스터 처치 판정이 성공했을 때 발생합니다.","stateChange":"플레이어의 보유 골드가 즉시 증가하며, 마을 상점에서 영구 능력치를 해금할 수 있는 재화 상태로 전환됩니다."}],"ux":{"hudPriorities":"화면 최상단에 현재 체력과 획득 골드를 표시하고, 중앙에는 주사위 판정 창, 하단에는 전진/탈출 액션 버튼을 배치하여 시각적 위계를 명확히 합니다.","touchAndInput":"모든 터치 영역은 최소 64dp 이상으로 확보하여 오작동을 방지하며, 햅틱 피드백을 적극 활용하여 주사위 충돌과 타격감을 손끝으로 전달합니다.","readability":"고대비 폰트와 굵은 외곽선을 사용하여 야외 광원 아래에서도 텍스트와 수치를 명확히 읽을 수 있도록 가독성을 극대화합니다.","accessibility":"적녹색약 플레이어를 위해 함정과 몬스터의 경고 범위를 단순 색상이 아닌 빗금 패턴과 아이콘으로 병행 표기합니다."},"mobileUx":"직접 전투 조작은 이동·기본공격·회피·핵심 스킬 중심으로 단순화하고, 파티 편성·장비·AI 성향은 전투 밖에서 명확한 카드형 UI로 관리한다."},"referencePatterns":[{"id":"BUILD_PRESETS","game":"Genshin Impact","sourceUrl":"https://genshin.hoyoverse.com/en/news/detail/156641","observedAt":"2026-10-07","principle":"Save and switch a player-selected equipment setup.","adaptation":"Compare changes before applying; preserve unavailable-item, combat and save restrictions.","authority":"DESIGN_REFERENCE_ONLY","runtimeVerified":false},{"id":"CONDITIONAL_LOOT_FILTER","game":"Diablo IV","sourceUrl":"https://news.blizzard.com/en-us/article/24267729/prepare-for-the-reckoning-lord-of-hatred-draws-near","observedAt":"2026-10-07","principle":"Reusable conditions reduce irrelevant loot information; filters can be shared.","adaptation":"Expose filter state and reset; filtering must not delete rewards or silently auto-sell.","authority":"DESIGN_REFERENCE_ONLY","runtimeVerified":false},{"id":"QUEST_CONTEXT_SHORTCUT","game":"Genshin Impact","sourceUrl":"https://genshin.hoyoverse.com/en/news/detail/157683","observedAt":"2026-10-07","principle":"A quest can offer the relevant time adjustment directly.","adaptation":"Deep-link to the existing permitted action and return to the same quest/filter/scroll position; never bypass quest prerequisites.","authority":"DESIGN_REFERENCE_ONLY","runtimeVerified":false},{"id":"TRAVEL_FAVORITES","game":"No Man's Sky","sourceUrl":"https://www.nomanssky.com/worlds-part-ii-update/","observedAt":"2026-10-07","principle":"Favorite destinations reduce repeated searching in travel menus.","adaptation":"Pin frequent destinations while preserving unlock, cost and travel restrictions.","authority":"DESIGN_REFERENCE_ONLY","runtimeVerified":false}],"sourceFiles":["roblox-games/daechung-rpg/server/Game.server.luau","roblox-games/daechung-rpg/client/Game.client.luau","roblox-games/daechung-rpg/shared/GameConfig.luau","roblox-games/daechung-rpg/shared/RPGMenu.luau","roblox-games/daechung-rpg/shared/QACamera.luau","roblox-games/daechung-rpg/shared/RPGMenuModel.luau","roblox-games/daechung-rpg/shared/VisualStyle.luau"],"selectionRule":"Choose one observed player friction owned by these files. Explain applicability from existing systems, compare alternatives and record rejected patterns; do not add every reference feature.","scope":"TASK_LOCAL_SCREENS_AND_EXISTING_ENTRY_RETURN_BOUNDARIES","schema":{"version":1,"designFingerprint":"exact contract fingerprint","viewport":{"width":390,"height":844,"safeTop":0,"safeBottom":0},"entryId":"first screen","screens":[{"id":"existing screen id","role":"MAIN_MENU or GAMEPLAY or INVENTORY or SHOP or QUEST or SETTINGS","modal":false,"scrollable":false,"contentHeight":844,"controls":[{"id":"existing control id","action":"existing gameplay action","feedback":"observable feedback","enabledWhen":"existing state guard","rect":{"x":0,"y":0,"width":44,"height":44},"binding":{"path":"source file","symbol":"event handler","sourceEvidence":"exact event/handler source"}}]}],"transitions":[{"from":"screen id","controlId":"control id","to":"screen id","kind":"OPEN or BACK or CLOSE or ACTION","preservesState":true}],"playerTasks":[{"id":"frequent player intent","friction":"observed repeated work or information gap","patternId":"reference id or ORIGINAL","adaptation":"why this game needs it","from":"screen id","to":"completion screen","controlId":"completion action","maxNavigationSteps":2,"retainedContext":["selection","filter","scroll","draft"],"failureRecovery":"existing safe recovery","runtimeCheck":"exact-build input sequence and observable result; compare before/after without invented measurements"}]},"learningRule":"Reference descriptions and static plans are hypotheses. Reuse through existing verified experience only after exact-build gameplay evidence; retain failures and reject regressions. Recheck dated references before calling them current.","preserve":["SAVE","PROGRESSION","COMBAT_RETURN_RESTRICTIONS","DISABLED_ACTION_GUARDS","EXISTING_MENU_IDENTITIES"],"runtimeVerified":false},"qualityContract":{"reference":"SAME_CONNECTED_PLAY_AND_PRESENTATION_STANDARD_AS_ROBLOX","implementation":"EXISTING_LUAU_SERVER_CLIENT_AND_ASSET_BINDINGS","required":["CONNECTED_PLAYER_ACTION_STATE_FEEDBACK_AND_NEXT_GOAL","COMPATIBLE_INTERNAL_ASSETS_ACTUALLY_BOUND","MOTION_AUDIO_VFX_LINKED_TO_EXISTING_GAME_STATE_WHEN_APPLICABLE","MOBILE_TOUCH_AND_SCREEN_READABILITY","EXACT_CHANGED_BUILD_RUNTIME_AND_SAVE_REGRESSION"],"runtimeSurface":"ROBLOX_OPEN_CLOUD_EXACT_CANDIDATE","markerOnlyCompletionAllowed":false,"runtimeVerified":false},"handoffRule":"Use the observed files and symbols within the existing allowed write scope. Reuse existing event/data contracts; missing context is not permission to invent an API or edit another file.","contentRule":"PRESENT_EXISTING_BEHAVIOR_ONLY","preservation":["APPROVED_CONCEPT","APPROVED_GENRE","STYLE_LOCK","SAVE_IDENTITY","BALANCE_AND_ECONOMY_MEANING","SERVER_AUTHORITY"],"newWorkflow":false,"newQaStage":false,"implementationStatus":"PLANNED_NOT_IMPLEMENTED"},"robloxProductionPlan":{"version":3,"executionBoundary":"EXISTING_BUILD_UP_ONLY","platform":"ROBLOX","executionSurface":"ROBLOX","mode":"EXISTING_PLAY_PRESENTATION","gameId":"daechung-rpg","genreProfile":"RPG","conceptIdentity":"스토리에서 동료를 만나 영입하고, 수십·수백 명까지 확장되는 AI 동료 풀에서 4인 파티를 구성해 직접 전투·장비 세팅·관계 조합을 연구하는 3D 파티 액션 RPG.","coreAction":"전투·성장·역할 선택","ownerFeatureChanges":[],"ownerChangeFingerprint":"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","systemConnection":"기존 행동 → 상태별 표현/입력 피드백","approvedCoreLoop":["마을과 지역 스토리를 진행해 새로운 AI 동료와 사건을 발견한다.","보유 동료 중 4명을 골라 파티를 만들고 각 동료의 장비, AI 성향, 스킬을 세팅한다.","필드·던전·보스에서 직접 전투하며 파티 조합과 장비가 실제 전투에서 어떻게 맞물리는지 확인한다.","동료 전용 퀘스트, 숙명 관계, 히든 조건, 보스 포섭을 통해 새로운 동료·합동기·전용장비를 얻고 다른 4인 조합을 시험한다."],"signatureSystems":["4인 파티 고정","무한 확장 AI 동료","숙명 관계","파티 기억","보스·히든 동료","장비가 AI를 바꿈","라이벌 AI 파티","조합 엔딩"],"progressionDirection":"초기 4인 동료 확보 → 지역 스토리와 장비 파밍 → 숙명 관계·전용 퀘스트 → 히든/보스 동료 → 고난도 조합전투 → 라이벌 파티 경쟁 → 조합별 엔딩과 계속 추가되는 새 동료.","depthAndReward":null,"ideas":[{"id":"RPG:PLAY_READABILITY","implementation":"현재 핵심 행동과 결과가 월드·모션·터치 UI에서 명확하게 읽히도록 연결한다.","distinction":"판정·보상·저장 규칙은 유지하고 표현만 개선한다."}],"selectedIdea":{"id":"RPG:PLAY_READABILITY","implementation":"현재 핵심 행동과 결과가 월드·모션·터치 UI에서 명확하게 읽히도록 연결한다.","distinction":"판정·보상·저장 규칙은 유지하고 표현만 개선한다."},"ideaHistory":["RPG:PLAY_READABILITY"],"implementationPackages":[{"role":"CLIENT_PRESENTATION","files":["roblox-games/daechung-rpg/client/Game.client.luau"],"implementation":"이 파일의 기존 입력·렌더·모션·UI 책임 블록만 개선하고 게임 상태·보상·저장 의미는 유지한다."},{"role":"SHARED_DEFINITION","files":["roblox-games/daechung-rpg/shared/GameConfig.luau","roblox-games/daechung-rpg/shared/RPGMenu.luau","roblox-games/daechung-rpg/shared/QACamera.luau","roblox-games/daechung-rpg/shared/RPGMenuModel.luau","roblox-games/daechung-rpg/shared/VisualStyle.luau"],"implementation":"이 파일의 기존 입력·렌더·모션·UI 책임 블록만 개선하고 게임 상태·보상·저장 의미는 유지한다."}],"sourceTreeFingerprint":"432820ef72091742a6c8e0b187832b8e66d5fa23c9afc9636e71a58ab06fa133","spatialBlueprintContract":{"version":1,"required":false,"dimension":"SOURCE_BOUND_REQUIRED","platform":"ROBLOX","scope":"PRESERVE_LAYOUT_PRESENTATION_ONLY","designFingerprint":"4d725fc32ff25c7fba54f08505b105edfca92c721b402a7f2963ed6785a88f26","macroSketch":{"identity":"스토리에서 동료를 만나 영입하고, 수십·수백 명까지 확장되는 AI 동료 풀에서 4인 파티를 구성해 직접 전투·장비 세팅·관계 조합을 연구하는 3D 파티 액션 RPG.","genre":"RPG","style":"세 게임 중 캐릭터와 전투 연출 퀄리티를 가장 높게 잡는 애니메이션풍 스타일라이즈드 판타지 3D. 기본 Roblox 아바타 감각은 유지하되 직업·동료·보스가 얼굴, 무기, 실루엣, 스킬 이펙트만 봐도 구분되도록 한다. 실사보다 강한 색 대비와 읽기 쉬운 전투 이펙트를 우선한다.","artDirection":{"visualIdentity":"판타지 광장, 룬 기둥, 발광 수정, 무기 실루엣을 중심으로 한 스타일라이즈드 3D. 동료는 직업별 색과 무기 실루엣이 명확하고 보스는 큰 체형·별도 조명·전용 색으로 즉시 구분한다.","audioIdentity":"경쾌한 8비트 레트로 사운드와 웅장한 오케스트라 악기를 혼합하여, 가볍지만 모험의 긴장감을 잃지 않는 독창적인 사운드트랙을 제공합니다.","gameplayFeedbackSync":"주사위가 굴러가서 멈추는 순간의 둔탁한 타격음과 몬스터 처치 시 골드가 쏟아지는 금속성 효과음을 화면 연출과 0.01초 단위로 동기화하여 타격감을 극대화합니다."},"authoredLayout":{},"coreRoute":["마을과 지역 스토리를 진행해 새로운 AI 동료와 사건을 발견한다.","보유 동료 중 4명을 골라 파티를 만들고 각 동료의 장비, AI 성향, 스킬을 세팅한다.","필드·던전·보스에서 직접 전투하며 파티 조합과 장비가 실제 전투에서 어떻게 맞물리는지 확인한다.","동료 전용 퀘스트, 숙명 관계, 히든 조건, 보스 포섭을 통해 새로운 동료·합동기·전용장비를 얻고 다른 4인 조합을 시험한다."],"systemConnections":[{"fromSystem":"대충 주사위 판정 시스템","toSystem":"위험도 가속기 시스템","trigger":"플레이어가 주사위 판정에서 연속으로 대성공을 거두어 던전 깊숙이 진입할 때 발생합니다.","stateChange":"던전의 기본 위험도 수치가 즉시 2배로 증가하며, 몬스터의 공격력과 드롭되는 골드량이 동시에 가속화됩니다."},{"fromSystem":"위험도 가속기 시스템","toSystem":"대충 주사위 판정 시스템","trigger":"위험도 가속 수치가 최대치에 도달하여 던전 환경이 폭주 상태로 전환될 때 발생합니다.","stateChange":"주사위 판정에 필요한 최소 성공 요구치가 상승하며, 실패 시 캐릭터가 받는 피해량이 3배로 증가합니다."},{"fromSystem":"대충 주사위 판정 시스템","toSystem":"골드 경제 시스템","trigger":"주사위 판정 결과 보물상자 획득 또는 정예 몬스터 처치 판정이 성공했을 때 발생합니다.","stateChange":"플레이어의 보유 골드가 즉시 증가하며, 마을 상점에서 영구 능력치를 해금할 수 있는 재화 상태로 전환됩니다."}],"actorRoles":[{"name":"4인 파티 고정","purpose":"파티 슬롯은 항상 4명이며 탱·딜·힐 강제를 없애고 여러 조합이 실전에서 성립하도록 밸런스를 맞춘다.","playerChoice":""},{"name":"무한 확장 AI 동료","purpose":"새 지역·스토리 업데이트마다 동료를 계속 추가할 수 있고 각 동료는 전용 스토리, AI 행동, 스킬과 장비 방향을 가진다.","playerChoice":""},{"name":"숙명 관계","purpose":"특정 동료 조합이 함께 사건을 겪으면 전용 대사, 관계 변화, 합동기 또는 전투 규칙 변화가 열린다.","playerChoice":""},{"name":"파티 기억","purpose":"같은 4인으로 중요한 사건·보스·역전을 겪은 기록이 파티 정체성으로 남고 특수 대사·행동·지원 효과를 연다.","playerChoice":""},{"name":"보스·히든 동료","purpose":"특정 보스를 죽이는 대신 조건을 만족해 포섭하거나 숨겨진 시간·아이템·동료 조합으로 레어 동료를 발견한다.","playerChoice":""},{"name":"장비가 AI를 바꿈","purpose":"장비는 수치뿐 아니라 공격성, 보호 우선, 상태이상 활용 같은 AI 행동 우선순위와 스킬 운용을 바꾼다.","playerChoice":""},{"name":"라이벌 AI 파티","purpose":"다른 AI 4인 파티도 세계에서 성장하고 보스·보물·사건을 경쟁하거나 때로 협력한다.","playerChoice":""},{"name":"조합 엔딩","purpose":"특정 4인 조합으로 주요 스토리를 끝내면 그 조합만의 후일담·비밀 엔딩을 볼 수 있다.","playerChoice":""}],"menuAndConvenience":{"hudPriorities":"화면 최상단에 현재 체력과 획득 골드를 표시하고, 중앙에는 주사위 판정 창, 하단에는 전진/탈출 액션 버튼을 배치하여 시각적 위계를 명확히 합니다.","touchAndInput":"모든 터치 영역은 최소 64dp 이상으로 확보하여 오작동을 방지하며, 햅틱 피드백을 적극 활용하여 주사위 충돌과 타격감을 손끝으로 전달합니다.","readability":"고대비 폰트와 굵은 외곽선을 사용하여 야외 광원 아래에서도 텍스트와 수치를 명확히 읽을 수 있도록 가독성을 극대화합니다.","accessibility":"적녹색약 플레이어를 위해 함정과 몬스터의 경고 범위를 단순 색상이 아닌 빗금 패턴과 아이콘으로 병행 표기합니다."},"mobileUx":"직접 전투 조작은 이동·기본공격·회피·핵심 스킬 중심으로 단순화하고, 파티 편성·장비·AI 성향은 전투 밖에서 명확한 카드형 UI로 관리한다.","sourceAnchors":[{"file":"roblox-games/daechung-rpg/server/Game.server.luau","symbol":"beginEnemyAttack","kind":"FUNCTION"},{"file":"roblox-games/daechung-rpg/server/Game.server.luau","symbol":"enemyModel","kind":"FUNCTION"},{"file":"roblox-games/daechung-rpg/client/Game.client.luau","symbol":"endBossCinematic","kind":