nction bindVerifiedLearningControl(control)","score":50},{"file":"roblox-games/seed-casual-realm-weaver/client/Game.client.luau","line":139,"kind":"FUNCTION","symbol":"syncVerifiedLearningCharacterMotion","context":"local function syncVerifiedLearningCharacterMotion(character)","score":42},{"file":"roblox-games/seed-casual-realm-weaver/server/Game.server.luau","line":21,"kind":"FUNCTION","symbol":"readNumber","context":"local function readNumber(player, name, fallback)","score":42},{"file":"roblox-games/seed-casual-realm-weaver/server/Game.server.luau","line":26,"kind":"FUNCTION","symbol":"setNumber","context":"local function setNumber(player, name, value)","score":42},{"file":"roblox-games/seed-casual-realm-weaver/client/Game.client.luau","line":27,"kind":"FUNCTION","symbol":"hasStudioAssetAtom","context":"local function hasStudioAssetAtom(familyOrAtom, atom)","score":34},{"file":"roblox-games/seed-casual-realm-weaver/server/Game.server.luau","line":179,"kind":"FUNCTION","symbol":"bindNativeFoundationCharacter","context":"local function bindNativeFoundationCharacter(character)","score":34},{"file":"roblox-games/seed-casual-realm-weaver/client/Game.client.luau","line":23,"kind":"FUNCTION","symbol":"studioAssetFamily","context":"local function studioAssetFamily(family)","score":26}]},"previousVersionDelta":{"previousGoal":"세계의 직조자는 플레이어가 흩어진 조각들을 연결하여 끊임없이 변화하는 풍경을 완성하는 힐링 퍼즐 게임입니다. 단순한 조작으로 세상을 재구성하고, 그 과정에서 얻는 시각적 만족감과 성취감을 핵심 가치로 삼습니다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.","previousFocus":"STABILITY","previousGeneration":25,"previousSourceTreeFingerprint":"6336cf31f3782a79b2189cc8ef30c8dda2fa3176a791c6d6b3261065d4567e15","currentSourceTreeFingerprint":"4af1486da6ca6624da84b7e16171d8de5b0486bf6b19a08b738502a42ce817cd","sourceChanged":true,"verifiedEvolution":false},"playtestRuntimeFindings":{"platform":"ROBLOX","studioQualityFailure":null,"failureStage":"F0_GAMEPLAY_PRODUCT_READINESS","failureSignature":"ROBLOX_F0_GAMEPLAY_PRODUCT_READINESS_FA