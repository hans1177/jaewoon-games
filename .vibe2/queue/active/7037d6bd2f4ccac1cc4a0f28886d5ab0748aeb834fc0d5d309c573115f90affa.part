infrastructure-unavailable:v1","external-ai-quota-retry-at:2026-10-19T01:02:38.194Z","external-ai-quota-wait-resumed:v1","game-repair-repeat-count:15","worker-artifact-run:39183497337","game-repair-repeat-count:16","game-repair-repeat-count:17","external-ai-quota-retry-at:2026-10-19T01:47:11.339Z","game-repair-repeat-count:18","worker-artifact-run:39186186755","external-ai-quota-retry-at:2026-10-19T02:34:13.030Z"],"lastOutcome":"EXTERNAL_AI_QUOTA_WAIT_FINISHED","reservationId":null,"reservationRunId":null,"reservationRunAttempt":0,"reservedAt":null,"neuronExpectedVariants":0,"neuronResults":[],"runtimeEvidenceCandidate":null,"buildUpDirective":{"version":2,"directiveId":"monster-adventure-build-up-g1-7a491bbc1b32","directiveFingerprint":"7a491bbc1b3210a72d35b72c7ee14990d54854dc43bb23b8b65fba56bb52a3c8","previousDirectiveFingerprint":"91da7c77abb3f195a242b970fc598f6f1de15f117de7f6d755c7add6fb3ca2af","forbiddenRepeatFingerprint":"91da7c77abb3f195a242b970fc598f6f1de15f117de7f6d755c7add6fb3ca2af","gameId":"monster-adventure","gameName":"몬스터 어드벤처","generation":1,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","escalationMode":"CONTINUE_UNVERIFIED_DEPTH","previousDirectiveOutcome":"cancelled","designContextMode":"APPROVED_OR_MINIMUM_DESIGN","platform":"WEB","sourceRoot":"web-games/monster-adventure","sourceTreeFingerprint":"67a5ab5bee3b4f960d5d24441145e452371fc9aa67c0188afa795d5ce4cdf809","designFingerprint":"70b5a409bd8cc6698cb726a33cf3dcef68a8cdfadd0903a539c794f33ad7a30d","gameIdentityAndNonNegotiables":{"identity":"몬스터 어드벤처는 턴제 전략과 탐험이 결합된 모바일 어드벤처 게임으로, 플레이어는 몬스터를 포획하고 육성하며 미지의 세계를 탐험합니다. 핵심 루프는 몬스터의 속성과 스킬을 고려한 전략적 선택을 요구하며, 시그니처 시스템인 '속성 상성 전투'와 '몬스터 진화 트리'는 플레이어에게 매번 다른 전투 양상과 성장 경로를 제공하여 깊이 있는 선택과 상태 변화를 경험하게 합니다.","coreFun":"몬스터의 속성을 고려한 턴제 전투에서의 전략적 스킬 선택, 탐험 중 마주치는 환경 변화에 따른 몬스터 육성 방향 결정, 그리고 전투 승리 후 획득한 자원으로 몬스터를 강화하여 더 강력한 적에게 도전하는 즉각적인 성취감입니다.","coreLoop":["탐험 단계: 월드 맵에서 이동하며 몬스터를 조우하거나 자원을 수집하는 선택을 수행합니다.","전투 단계: 턴제 전투 시스템을 통해 몬스터의 스킬을 선택하고 속성 상성을 활용하여 적을 제압합니다.","성장 단계: 전투 보상으로 얻은 경험치와 재료를 사용하여 몬스터를 레벨업하거나 진화시켜 다음 도전을 준비합니다."],"signatureSystems":[{"name":"속성 상성 전투 시스템","purpose":"전투의 전략적 깊이를 더하고 플레이어가 몬스터 조합을 고민하게 만들기 위해 설계되었습니다.","playerChoice":"플레이어는 적의 속성을 파악하고 자신의 몬스터 팀 중 가장 유리한 속성을 가진 몬스터를 교체하거나 특정 스킬을 사용하여 전투의 흐름을 유리하게 바꿀 수 있습니다."},{"name":"몬스터 진화 트리 시스템","purpose":"플레이어에게 장기적인 성장 목표를 제공하고 몬스터 육성의 다양성을 확보하기 위해 설계되었습니다.","playerChoice":"플레이어는 몬스터가 특정 레벨에 도달했을 때 제공되는 여러 진화 경로 중 자신의 전투 스타일이나 팀 구성에 필요한 특성을 가진 형태로 진화시킬지 선택해야 합니다."}],"progressionDirection":"플레이어는 초반에 기본적인 몬스터로 시작하여 점진적으로 더 희귀하고 강력한 몬스터를 포획하고 육성합니다. 난이도는 지역별로 점진적으로 상승하며, 새로운 지역에 진입할 때마다 더 높은 전략적 판단을 요구하는 몬스터 조합을 마주하게 됩니다.","multiplayerMode":"SINGLE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=1","GAME_FEEL_SPARSE","VFX_IMPLEMENTATION_SPARSE","CAMERA_LANGUAGE_SPARSE","AUDIO_IMPLEMENTATION_SPARSE","AI_BEHAVIOR_DEPTH_SPARSE","UI_MENU_FLOW_SPARSE","INTERACTION_DISCOVERABILITY_SPARSE","SETTINGS_ACCESSIBILITY_SPARSE"],"signals":{"combat":99,"progression":38,"ai":1,"save":82,"multiplayer":0,"animation":2,"motionStates":65,"gameFeel":0,"vfx":0,"camera":0,"audio":0,"audioDynamics":0,"ui":46,"uiFlow":3,"entryFlow":0,"loadingFlow":0,"input":15,"map":38,"landmark":0,"interaction":0,"inventory":0,"equipment":0,"settings":0,"feedback":0,"session":44,"content":60,"choice":19,"connection":0,"performance":4,"lighting":8,"primitive":0,"todo":0,"errorRecovery":2},"topFiles":[{"file":"web-games/monster-adventure/index.html","score":144}],"sourceAnchors":[{"file":"web-games/monster-adventure/index.html","line":39,"kind":"FUNCTION","symbol":"renderBattle","context":"function renderBattle(){if(!battle)return;const e=battle.enemy,m=activeMon(),es=species[e.id],ms=species[m.id];$('#enemyName').textContent=es.name;$('#enemyLv').textContent=`Lv.${e","score":282},{"file