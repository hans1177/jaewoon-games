{"id":"internal-motion-kelpie-walk-v1","gameId":"horror-escape-room","target":"roblox","unityWebDevelopment":false,"department":"graphics","type":"implementation","designChange":false,"designScope":null,"proposedDesignChanges":[],"designFields":[],"assetProductionLane":true,"presentationPass":null,"graphicsReplacementContract":null,"motionRepairWorkUnit":{"scope":"INTERNAL_ASSET_LIBRARY","objectId":"roblox-world-ghost-kelpie","clipId":"walk","sourcePath":"init.luau","sourceHash":"d1ded4f686e77917fc9358129c9b0670b2391385497c88b97d5ddd800ab7935f","sourceWindow":"function Motion.walk(form,bones,time)\n\n local result={}\n for name in pairs(bones)do result[name]={x=0,y=0,z=0,rx=0,ry=0,rz=0}end\n local function pose(name,x,y,z,rx,ry,rz)\n  if result[name]then result[name]={x=x or 0,y=y or 0,z=z or 0,rx=rx or 0,ry=ry or 0,rz=rz or 0}end\n end\n local function smooth(value)local u=math.clamp(value,0,1);return u*u*u*(u*(u*6-15)+10)end\n local TAU=math.pi*2\n\n local cycle=(time/Motion.Duration)%1\n local legs={{\"BackLeftLeg\",0},{\"FrontLeftLeg\",.25},{\"BackRightLeg\",.5},{\"FrontRightLeg\",.75}}\n local lifted=0\n for _,leg in ipairs(legs)do\n  local p=(cycle+leg[2])%1\n  local angle,lift\n  if p<.76 then\n   angle=.29-.58*smooth(p/.76);lift=0\n  else\n   local u=(p-.76)/.24\n   angle=-.29+.58*smooth(u);lift=.17*math.sin(math.pi*u)^2\n  end\n  lifted+=lift\n  pose(leg[1],0,lift,0,angle,0,0)\n end\n local a=cycle*TAU\n pose(\"Torso\",.025*math.sin(a),-.04+lifted*.14,0,.025*math.sin(a*2),.02*math.sin(a),.028*math.sin(a))\n pose(\"Head\",0,0,0,-.045*math.sin(a*2-.3),-.025*math.sin(a),0)\n pose(\"Tail\",0,0,0,0,.14*math.sin(a-.65),.025*math.sin(a))\n for name in pairs(bones)do if name:match(\"^TailFan\")then pose(name,0,0,0,0,.12*math.sin(a-1),0)end end\n return result\nend","objectBindingEvidence":"Motion.AssetId = \"kelpie\"","clipBindingEvidence":"function Motion.walk(form,bones,time)","objectCount":1,"motionCount":1,"estimatedModificationMinutes":60,"lockedSource":["Motion.AssetId = \"kelpie\"","function Motion.walk(form,bones,time)","local state=\"walk\""],"preservedAxes":{}},"executionLane":"RELEASE_WAIT","goal":"[INTERNAL ASSET MOTION REPAIR] roblox-world-ghost-kelpie의 기존 walk 동작 하나를 약 60분의 실제 수정 작업량으로 깊게 개선한다. 원본을 읽고 자세·중심 이동·관절 곡선·접촉·후행 움직임·복귀와 루프를 검토한다. 같은 오브젝트와 같은 동작만 수정하며 다른 모션, 루트 이동, 판정, 게임 소스는 변경하지 않는다. 변경하지 않는 축은 소스 근거로 보존한다. 전후 실제 native 재생과 검수 전에는 품질 통과를 주장하지 않는다. 실패는 같은 대상의 기존 수리 흐름에서 반복 수정한다.","responsibleFiles":["assets/roblox/world-ghosts/motions/kelpie/init.luau"],"retainedResponsibleFileLocks":[],"dependencies":[],"priority":"critical","portfolioValueScore":0,"ownerDevelopmentHold":false,"releaseState":"development-confirmed","status":"running","retries":2,"retryPolicy":"UNLIMITED","maxRetries":2,"ownerDirective":true,"requiresOwnerDecision":false,"protectedChange":false,"paidResourceRequired":false,"productionMode":"AUTONOMOUS_VIBE","supervisionApproved":false,"supervisionContract":null,"supervisionReview":null,"blocker":"slot-released-awaiting-fan-in","evidence":["asset-production-parallel:v1","single-object-motion-repair:v1","internal-asset-only:v1","owner-motion-depth-request:2026-10-05","native-before-after-qa:required","work-package:horror-escape-room-wp-13f1nqu","task-work-units:6","package-work-units:6","package-related-improvements:0","package-role-separation:exploration|implementation|test|performance|regression|review","package-quantity-goal:FEATURE_COMPLETION","atomic-neuron-stream:presentation","atomic-neuron-micro-fanin:per-task","graphics-atomic-candidate-isolation-required","portfolio-decision:FOCUSED_REPAIR","portfolio-reason:CURRENT_CRITICAL_OR_REPEATED_CAUSAL_BLOCKER","learning-motor-candidate-tournament:repeated-verified-failure","recovery-queue:recovery-ticket-bug-97439712d416497ffce0","recovery-strategy:REPAIR_REPRODUCIBLE_TESTER_BUG_AND_RERUN_EXACT_FAILED_STAGE","recovery-exact-stage:TARGET_PLATFORM_BUILD_OR_PACKAGE","source-mutation-required:YES","game-repair-mode:ROOT_CAUSE_MODE","game-r