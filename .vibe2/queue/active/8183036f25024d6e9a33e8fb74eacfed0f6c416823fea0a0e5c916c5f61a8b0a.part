/line-defense/client/Game.client.luau"],"inspectedSymbols":[{"file":"roblox-games/line-defense/server/Game.server.luau","symbol":"damageEnemy","kind":"FUNCTION"},{"file":"roblox-games/line-defense/server/Game.server.luau","symbol":"spawnEnemy","kind":"FUNCTION"},{"file":"roblox-games/line-defense/server/Game.server.luau","symbol":"spawnBoss","kind":"FUNCTION"},{"file":"roblox-games/line-defense/client/Game.client.luau","symbol":"render","kind":"FUNCTION"},{"file":"roblox-games/line-defense/server/Game.server.luau","symbol":"startWave","kind":"FUNCTION"}],"designStatus":"DESIGN_REPAIR_REQUIRED","codingStatus":"SOURCE_OWNER_CANDIDATE_UNVERIFIED","executableBehaviorVerified":false,"actualRuntimeVerified":false,"evidenceNeeded":"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA"}],"observedGameCodeFiles":["roblox-games/line-defense/server/Game.server.luau","roblox-games/line-defense/shared/GameConfig.luau","roblox-games/line-defense/client/Game.client.luau"],"executableCodeCandidateFiles":["roblox-games/line-defense/server/Game.server.luau","roblox-games/line-defense/client/Game.client.luau"],"gapReasons":["DESIGN_MAIN_A_B_c_AT_INCOMPLETE","MULTIPLAYER_DESIGN_MODE_MISSING","DESIGN_ROLE_NOT_AUTHORED:MAIN","DESIGN_ROLE_NOT_AUTHORED:A","DESIGN_ROLE_NOT_AUTHORED:B","DESIGN_ROLE_NOT_AUTHORED:c","DESIGN_ROLE_NOT_AUTHORED:@"],"codingReviewState":"GAME_STAGE_LOCAL_REPAIR_REQUIRED","sourceImplementationPassed":false,"actualTwoClientPassed":false,"actualWebglRenderPassed":false,"independentQaPassed":false,"stageLocalAction":"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME","schemaAndMarkersAloneCannotPass":true,"newPipeline":false,"changesDevelopmentAdmission":false,"saveBalanceAndExistingMultiplayerMeaningPreserved":true},"designImplementationContext":{"source":"LATEST_VERIFIED_DESIGN_FIELDS","coreFun":"매 웨이브마다 변화하는 적의 침공 경로를 관찰하고, 제한된 골목 자원을 활용하여 특정 유닛을 배치하거나 실시간으로 업그레이드 경로를 선택함으로써 즉각적인 전투력 변화와 방어 성공의 쾌감을 얻는 것입니다.","coreLoop":["적의 다음 침공 경로와 유닛 구성을 확인하고 아군 유닛을 골목길의 최적 위치에 배치하는 단계","전투 중 적을 처치하여 실시간으로 골목 자원을 획득하고 이를 유닛 업그레이드나 추가 배치에 투자하는 단계","웨이브를 클리어하고 획득한 전리품으로 군단 전체의 영구적 특성을 강화하여 더 높은 난이도에 도전하는 단계"],"signatureSystems":[{"name":"골목길 시너지 배치 시스템","purpose":"특정 골목 구역에 유닛을 인접하게 배치할 때 발생하는 시너지 효과를 통해 플레이어에게 공간 배치 기반의 깊이 있는 전략적 선택을 제공합니다.","playerChoice":"단순히 강한 유닛을 배치할 것인지, 아니면 시너지 효과를 극대화하기 위해 특정 속성의 유닛들을 좁은 골목에 밀집 배치할 것인지 선택합니다."},{"name":"실시간 재화 순환 엔진","purpose":"전투 중 획득하는 자원의 가치를 실시간으로 변동시켜 플레이어가 자원 수집과 소비의 타이밍을 극적으로 조율하도록 만듭니다.","playerChoice":"자원을 즉시 소모하여 하급 유닛을 다수 소환할 것인지, 아니면 이자를 받기 위해 자원을 저축한 후 고성능 유닛을 한 번에 소환할 것인지 결정합니다."}],"systemInterconnections":[{"fromSystem":"골목길 시너지 배치 시스템","toSystem":"실시간 재화 순환 엔진","trigger":"플레이어가 특정 골목 구역에 시너지 배치를 완성하여 적을 빠르게 처치할 때","stateChange":"적 처치 속도가 증가함에 따라 실시간 재화 획득 속도가 가속화되어 더 빠른 업그레이드가 가능해집니다."},{"fromSystem":"실시간 재화 순환 엔진","toSystem":"골목길 시너지 배치 시스템","trigger":"플레이어가 저축한 자원을 일시에 소모하여 고성능 유닛을 소환할 때","stateChange":"새로운 고성능 유닛이 전장에 배치되면서 기존 유닛들과의 새로운 시너지 링크가 활성화되고 방어선 상태가 강화됩니다."},{"fromSystem":"골목길 시너지 배치 시스템","toSystem":"골목길 시너지 배치 시스템","trigger":"배치된 유닛이 적의 강력한 공격을 받아 파괴되거나 후퇴할 때","stateChange":"해당 구역의 시너지 링크가 즉시 끊어지며 주변 유닛들의 공격 속도와 방어력이 감소하는 상태 변화가 발생합니다."}],"progressionDirection":"플레이어는 스테이지를 클리어하며 골목 대장 레벨을 올리고, 새로운 유닛 카드를 해금하며, 영구적인 골목 아지트 연구를 통해 군단의 기본 능력치를 점진적으로 확장해 나갑니다.","progressionEconomyBalance":{"progressionLoop":"스테이지 클리어 -> 골목 자원 및 아지트 부품 획득 -> 아지트 연구 및 유닛 레벨업 -> 더 높은 난이도의 골목 스테이지 도전으로 이어지는 선순환 구조를 가집니다.","resourceFlow":"전투 중 획득하는 '골목 자원'은 해당 전투 내에서만 소모되며, 전투 승리 보상인 '골목 골드'와 '아지트 부품'은 로비에서 유닛 성장 및 아지트 기능 강화에 영구적으로 사용됩니다.","balanceRules":"무과금 플레이어도 일일 퀘스트와 반복 플레이를 통해 필요한 성장 재화를 충분히 수급할 수 있도록 설계하며, 급격한 난이도 상승을 방지하기 위해 스테이지 권장 전투력 대비 유닛 성장 효율을 선형적으로 유지합니다."},"contentExpansionPlan":[{"milestone":"신규 테마 '재개발 구역' 업데이트","newGameplay":"파괴 가능한 장애물과 무너지는 벽 등 지형 변화 요소가 추가된 신규 스테이지 20종을 선보입니다.","systemImpact":"기존의 고정된 골목길 시너지 배치 시스템에 지형 파괴라는 변수가 추가되어 플레이어가 실시간으로 배치 전략을 수정해야 합니다."},{"milestone":"신규 유닛 '골목 대장단' 추가","newGameplay":"고유한 액티브 스킬을 보유하여 전장의 판도를 단번에 바꿀 수 있는 영웅급 유닛 3종이 추가됩니다.","systemImpact":"실시간 재화 순환 엔진에서 영웅 유닛의 스킬 쿨타임 감소 및 마나 충전을 위한 새로운 자원 소모처가 신설됩니다."},{"milestone":"무한의 골목길 디펜스 모드 오픈","newGameplay":"끝없이 밀려오는 적들을 막아내며 자신의 한계에 도전하고 글로벌 랭킹을 겨루는 무한 모드가 도입됩니다.","systemImpact":"장기적인 전투에 대응하기 위해 실시간 재화 순환 엔진의 이자율 제한이 해제되고 초고단계 시너지 효과가 추가됩니다."}],"failureRetryRisk":{"failureStates":["아지트의 체력이 0이 되어 방어에 실패하고 게임 오버가 되는 상태","제한 시간 내에 보스 유닛을 처치하지 못해 타임아웃으로 패배하는 상태"],"retryFlow":"패배 시 즉시 아지트로 귀환하며, 획득한 소량의 위로 재화를 정산받은 후 유닛 세팅을 재정비하여 동일 스테이지에 즉시 재도전할 수 있는 플로우를 제공합니다.","riskPressure":"스테이지 실패에 따른 영구적인 재화 손실이나 패널티는 없으나, 도전 시 소모된 행동력(스태미나)이 차감되므로 플레이어는 매 판 신중하게 유닛을 배치해야 합니다.","recoveryRules":"실패한 스테이지의 적 구성과 약점 속성을 힌트로 제공하고, 추천 유닛 조합을 가이드하여 플레이어가 유닛 성장이나 배치 전략 수정을 통해 쉽게 극복할 수 있도록 돕습니다."},"platformFitPlan":{"targetPlatform":"UNITY","inputModel":"모바일 터치 스크린에 최적화된 드래그 앤 드롭 방식을 채택하여, 하단 카드 덱에서 유닛을 선택해 원하는 골목 타일로 직관적으로 배치할 수 있도록 합니다.","performanceBudget":"모바일 기기에서의 발열과 배터리 소모를 최소화하기 위해 드로우콜을 150 이하로 제한하고, 동시 화면 표시 유닛 수를 최대 60개로 제한하는 최적화를 수행합니다.","sessionConstraints":"모바일 유저의 라이프스타일을 고려하여 한 판당 플레이 시간을 평균 3분에서 5분 내외로 제한하고, 갑작스러운 앱 종료 시에도 이어하기가 가능한 자동 저장 기능을 지원합니다."},"platformProfiles":{"ROBLOX":{"platform":"ROBLOX","inputModel":"Roblox touch controls first, with keyboard and gamepad parity through ContextActionService and Activated-based UI actions.","sessionModel":"Fast Roblox experience sessions with spawn, respawn, join-in-progress, and social re-entry semantics matched to the common game loop.","multiplayerRuntime":"single-player server boundary with local presentation; no fake multiplayer claims","performanceBudget":"Roblox mobile-first budget: bounded parts and effects, pooled transient objects, limited expensive per-frame work, and stable low-end frame pacing.","uiUx":"Roblox ScreenGui touch-safe layout with readable mobile controls, controller focus support, observable state feedback, and platform-native social affordances.","saveAndNetwork":"Server-validated RemoteEvents plus DataStore-backed persistent state only for approved save meaning; clients never own authoritative rewards or progression.","platformContentAdaptation":"Adapt \"골목 군단 대전은 골목길이라는 친숙한 공간에서 펼쳐지는 실시간 라인 디펜스 게임으로, 고유한 '골목길 시너지 배치 시스템'과 '실시간 재화 순환 엔진'을 통해 플레이어가 매 순간 유닛의 배치 위치와 업그레이드 타이밍을 결정하며 아지트를 방어하는 독창적인 전략적 선택과 상태 변화를 창출합니다.\" and its loop \"적의 다음 침공 경로와 유닛 구성을 확인하고 아군 유닛을 골목길의 최적 위치에 배치하는 단계 → 전투 중 적을 처치하여 실시간으로 골목 자원을 획득하고 이를 유닛 업그레이드나 추가 배치에 투자하는 단계 → 웨이브를 클리어하고 획득한 전리품으로 군단 전체의 영구적 특성을 강화하여 더 높은 난이도에 도전하는 단계\" to Roblox avatar scale, server/client authority, social sessions, and Roblox-native interaction without changing common gameplay meaning.","internalReleaseTarget":"Private or restricted Roblox experience published to Roblox servers so the owner and explicitly allowed testers can play before public release.","validationEvidence":"Exact published Roblox place and source revision, real Roblox runtime play, mobile controls, server/client boundary, save/rejoin when required, independent QA, and regression evidence."},"UNITY":{"platform":"UNITY","inputModel":"Unity Input System with touch-first on-screen controls, safe-area handling, keyboard and gamepad parity, and app pause/resume input recovery.","sessionModel":"Native mobile app sessions with cold start, suspend/resume, background/foreground transitions, process restart, and deterministic save restoration.","multiplayerRuntime":"single-player app session with local gameplay authority; networking remains disabled until design requires it","performanceBudget":"Android mobile budget covering memory, GPU, thermal load, battery, draw calls, shaders, particles, audio, pooling, GC pressure, and low-end frame pacing.","uiUx":"Unity UI safe-area responsive layout with touch targets, scalable HUD, controller navigation where relevant, and app-native loading/error/recovery states.","saveAndNetwork":"Versioned local save with explicit migration plus validated backend synchronization only when required; app lifecycle cannot silently corrupt progress.","platformContentAdaptation":"Adapt \"골목 군단 대전은 골목길이라는 친숙한 공간에서 펼쳐지는 실시간 라인 디펜스 게임으로, 고유한 '골목길 시너지 배치 시스템'과 '실시간 재화 순환 엔진'을 통해 플레이어가 매 순간 유닛의 배치 위치와 업그레이드 타이밍을 결정하며 아지트를 방어하는 독창적인 전략적 선택과 상태 변화를 창출합니다.\" and its loop \"적의 다음 침공 경로와 유닛 구성을 확인하고 아군 유닛을 골목길의 최적 위치에 배치하는 단계 → 전투 중 적을 처치하여 실시간으로 골목 자원을 획득하고 이를 유닛 업그레이드나 추가 배치에 투자하는 단계 → 웨이브를 클리어하고 획득한 전리품으로 군단 전체의 영구적 특성을 강화하여 더 높은 난이도에 도전하는 단계\" to Unity scenes, prefabs, mobile app lifecycle, touch UX, and Android packaging without changing common gameplay meaning.","internalReleaseTarget":"Internal or closed Android test build that can be installed and launched by the owner/testers before any public store release.","validationEvidence":"Exact APK/AAB source revision, install and launch, real touch gameplay, pause/resume, save/restore, performance, independent QA, regression, and package identity evidence."}},"webCanonicalDesign":{"role":"SHARED_DESIGN_WEB_APPLICATION","designAuthority":"GAME_DESIGN_REFERENCE_NOT_SOURCE_CODE_AUTHORITY","playerFlow":["적의 다음 침공 경로와 유닛 구성을 확인하고 아군 유닛을 골목길의 최적 위치에 배치하는 단계","전투 중 적을 처치하여 실시간으로 골목 자원을 획득하고 이를 유닛 업그레이드나 추가 배치에 투자하는 단계","웨이브를 클리어하고 획득한 전리품으로 군단 전체의 영구적 특성을 강화하여 더 높은 난이도에 도전하는 단계","플레이어는 스테이지를 클리어하며 골목 대장 레벨을 올리고, 새로운 유닛 카드를 해금하며, 영구적인 골목 아지트 연구를 통해 군단의 기본 능력치를 점진적으로 확장해 나갑니다."],"worldAndTraversal":"","systemsAndContent":"name: 골목길 시너지 배치 시스템; purpose: 특정 골목 구역에 유닛을 인접하게 배치할 때 발생하는 시너지 효과를 통해 플레이어에게 공간 배치 기반의 깊이 있는 전략적 선택을 제공합니다.; playerChoice: 단순히 강한 유닛을 배치할 것인지, 아니면 시너지 효과를 극대화하기 위해 특정 속성의 유닛들을 좁은 골목에 밀집 배치할 것인지 선택합니다. / name: 실시간 재화 순환 엔진; purpose: 전투 중 획득하는 자원의 가치를 실시간으로 변동시켜 플레이어가 자원 수집과 소비의 타이밍을 극적으로 조율하도록 만듭니다.; playerChoice: 자원을 즉시 소모하여 하급 유닛을 다수 소환할 것인지, 아니면 이자를 받기 위해 자원을 저축한 후 고성능 유닛을 한 번에 소환할 것인지 결정합니다.","combatAndInteraction":"매 웨이브마다 변화하는 적의 침공 경로를 관찰하고, 제한된 골목 자원을 활용하여 특정 유닛을 배치하거나 실시간으로 업그레이드 경로를 선택함으로써 즉각적인 전투력 변화와 방어 성공의 쾌감을 얻는 것입니다.","progressionAndEconomy":"progressionLoop: 스테이지 클리어 -> 골목 자원 및 아지트 부품 획득 -> 아지트 연구 및 유닛 레벨업 -> 더 높은 난이도의 골목 스테이지 도전으로 이어지는 선순환 구조를 가집니다.; resourceFlow: 전투 중 획득하는 '골목 자원'은 해당 전투 내에서만 소모되며, 전투 승리 보상인 '골목 골드'와 '아지트 부품'은 로비에서 유닛 성장 및 아지트 기능 강화에 영구적으로 사용됩니다.; balanceRules: 무과금 플레이어도 일일 퀘스트와 반복 플레이를 통해 필요한 성장 재화를 충분히 수급할 수 있도록 설계하며, 급격한 난이도 상승을 방지하기 위해 스테이지 권장 전투력 대비 유닛 성장 효율을 선형적으로 유지합니다.","sessionFailureRecovery":"failureStates: 아지트의 체력이 0이 되어 방어에 실패하고 게임 오버가 되는 상태 / 제한 시간 내에 보스 유닛을 처치하지 못해 타임아웃으로 패배하는 상태; retryFlow: 패배 시 즉시 아지트로 귀환하며, 획득한 소량의 위로 재화를 정산받은 후 유닛 세팅을 재정비하여 동일 스테이지에 즉시 재도전할 수 있는 플로우를 제공합니다.; riskPressure: 스테이지 실패에 따른 영구적인 재화 손실이나 패널티는 없으나, 도전 시 소모된 행동력(스태미나)이 차감되므로 플레이어는 매 판 신중하게 유닛을 배치해야 합니다.; recoveryRules: 실패한 스테이지의 적 구성과 약점 속성을 힌트로 제공하고, 추천 유닛 조합을 가이드하여 플레이어가 유닛 성장이나 배치 전략 수정을 통해 쉽게 극복할 수 있도록 돕습니다.","uiMenuAndOnboarding":"hudPriorities: 화면 상단에는 아지트 체력과 웨이브 진행도를 배치하고, 하단에는 현재 보유 자원과 소환 가능한 유닛 카드를 크게 배치하여 시선의 흐름을 자연스럽게 유도합니다.; touchAndInput: 모든 터치 영역은 최소 44x44 픽셀 이상으로 확보하여 오터치를 방지하고, 드래그 앤 드롭 시 배치 가능한 타일을 밝게 하이라이트하여 시각적 가이드를 명확히 합니다.; readability: 고대비 폰트와 명확한 아이콘을 사용하여 작은 모바일 화면에서도 유닛의 속성과 수치를 쉽게 식별할 수 있도록 하며, 텍스트 크기 조절 옵션을 제공합니다.; accessibility: 적의 속성과 침공 경로를 색상뿐만 아니라 고유한 문양과 점선 이펙트로도 표시하여 색약 플레이어도 게임 진행에 지장이 없도록 배려합니다.","inputCameraAccessibility":"모바일 터치 스크린에 최적화된 드래그 앤 드롭 방식을 채택하여, 하단 카드 덱에서 유닛을 선택해 원하는 골목 타일로 직관적으로 배치할 수 있도록 합니다.","presentationAndAudio":"visualIdentity: 따뜻한 골목길 감성을 담은 파스텔톤 컬러 팔레트를 기반으로 하되, 전투 상황에서는 화려하고 명확한 이펙트를 사용하여 아군과 적군의 구분을 확실히 합니다.; audioIdentity: 경쾌하고 리드미컬한 어쿠스틱 밴드 사운드의 배경음악을 통해 골목길의 활기찬 분위기를 조성하고, 유닛 소환 및 타격 시 경쾌한 효과음을 적용합니다.; gameplayFeedbackSync: 유닛이 시너지 효과를 받을 때 고유한 시각적 연결선 이펙트와 함께 청량한 실로폰 소리의 효과음을 동기화하여 플레이어가 시너지 활성화를 즉각 인지하도록 합니다.","multiplayerPersistence":"SINGLE; 현재는 싱글 플레이어 기반의 완성도 높은 캠페인과 전략적 재미에 집중하며, 추후 유저들의 피드백과 커뮤니티 활성화 정도에 따라 비동기식 유저 아지트 침공 모드(Asynchronous PvP) 도입을 검토할 예정입니다.","expansionSpace":"milestone: 신규 테마 '재개발 구역' 업데이트; newGameplay: 파괴 가능한 장애물과 무너지는 벽 등 지형 변화 요소가 추가된 신규 스테이지 20종을 선보입니다.; systemImpact: 기존의 고정된 골목길 시너지 배치 시스템에 지형 파괴라는 변수가 추가되어 플레이어가 실시간으로 배치 전략을 수정해야 합니다. / milestone: 신규 유닛 '골목 대장단' 추가; newGameplay: 고유한 액티브 스킬을 보유하여 전장의 판도를 단번에 바꿀 수 있는 영웅급 유닛 3종이 추가됩니다.; systemImpact: 실시간 재화 순환 엔진에서 영웅 유닛의 스킬 쿨타임 감소 및 마나 충전을 위한 새로운 자원 소모처가 신설됩니다. / milestone: 무한의 골목길 디펜스 모드 오픈; newGameplay: 끝없이 밀려오는 적들을 막아내며 자신의 한계에 도전하고 글로벌 랭킹을 겨루는 무한 모드가 도입됩니다.; systemImpact: 장기적인 전투에 대응하기 위해 실시간 재화 순환 엔진의 이자율 제한이 해제되고 초고단계 시너지 효과가 추가됩니다."},"platformExpansionPolicy":{"mode":"SINGLE_ORIGINAL_PLATFORM_IMPLEMENTATION","sharedLargeFrame":["CORE_IDENTITY","CORE_FUN_AND_REPRESENTATIVE_LOOP","WORLD_AND_PROGRESSION_DIRECTION","SAVE_PERSISTENCE_MEANING","MULTIPLAYER_INTENT"],"expansionLimit":"GAMEPLAY_CHANGES_REQUIRE_SHARED_ORIGINAL_REVISION","webRule":"게임당 하나의 공통 설계 원본을 사용한다. WEB은 같은 MAIN/A/B/c/@·규칙·상태·진행·멀티를 입력·화면·성능·저장 전송에 맞게 구현한다. 별도 원본을 생성하지 않으며 Unity WebGL은 같은 Unity 프로젝트를 사용한다.","unityRule":"동일 공통 원본과 디자이너가 작성한 규칙을 Unity에서 구현한다. 입력·물리 표현·카메라·UI·성능·저장 전송·런타임 검증만 플랫폼에 맞게 적용한다. 게임 규칙 확장은 공통 원본 개정으로 돌아간다.","robloxRule":"기존 Roblox 원본의 규칙과 사용자 요청을 공통 원본에 보존한다. platformProfiles.ROBLOX와 robloxBuildProfile은 같은 원본의 구현·배포·검증 방식이며 독립 게임 설계가 아니다. 다른 플랫폼 실패는 해당 플랫폼의 수정·재시도로 분리한다."},"visualDirection":"친근하면서도 개성 넘치는 캐주얼 카툰풍의 3D 그래픽 스타일을 지향하며, 골목길의 아기자기한 소품들과 유머러스한 유닛 애니메이션을 통해 시각적 즐거움을 극대화합니다.","mobileUx":"한 손 조작이 가능한 세로형 레이아웃을 기본으로 하며, 엄지손가락 범위 내에 주요 배치 버튼과 스킬 버튼을 배치하여 피로감을 최소화하고 직관적인 터치 피드백을 제공합니다.","uxAccessibilityPlan":{"hudPriorities":"화면 상단에는 아지트 체력과 웨이브 진행도를 배치하고, 하단에는 현재 보유 자원과 소환 가능한 유닛 카드를 크게 배치하여 시선의 흐름을 자연스럽게 유도합니다.","touchAndInput":"모든 터치 영역은 최소 44x44 픽셀 이상으로 확보하여 오터치를 방지하고, 드래그 앤 드롭 시 배치 가능한 타일을 밝게 하이라이트하여 시각적 가이드를 명확히 합니다.","readability":"고대비 폰트와 명확한 아이콘을 사용하여 작은 모바일 화면에서도 유닛의 속성과 수치를 쉽게 식별할 수 있도록 하며, 텍스트 크기 조절 옵션을 제공합니다.","accessibility":"적의 속성과 침공 경로를 색상뿐만 아니라 고유한 문양과 점선 이펙트로도 표시하여 색약 플레이어도 게임 진행에 지장이 없도록 배려합니다."},"artAudioDirection":{"visualIdentity":"따뜻한 골목길 감성을 담은 파스텔톤 컬러 팔레트를 기반으로 하되, 전투 상황에서는 화려하고 명확한 이펙트를 사용하여 아군과 적군의 구분을 확실히 합니다.","audioIdentity":"경쾌하고 리드미컬한 어쿠스틱 밴드 사운드의 배경음악을 통해 골목길의 활기찬 분위기를 조성하고, 유닛 소환 및 타격 시 경쾌한 효과음을 적용합니다.","gameplayFeedbackSync":"유닛이 시너지 효과를 받을 때 고유한 시각적 연결선 이펙트와 함께 청량한 실로폰 소리의 효과음을 동기화하여 플레이어가 시너지 활성화를 즉각 인지하도록 합니다."},"selectedDesignPlan":{},"contentVarietyPlan":{},"narrativeDialoguePlan":{},"implementationTraceability":[{"designElement":"골목길 시너지 배치 시스템의 인접 유닛 버프 활성화","responsibleSystem":"시너지 그리드 매니저 시스템 (Synergy Grid Manager)","validationEvidence":"유닛 배치 시 인접 타일의 유닛 ID를 검사하고 시너지 조건 충족 시 버프 컴포넌트가 정상 활성화되는지 단위 테스트 및 디버그 시각화 툴로 검증합니다."},{"designElement":"실시간 재화 순환 엔진의 이자율 계산 및 자원 지급","responsibleSystem":"전투 재화 컨트롤러 시스템 (Battle Economy Controller)","validationEvidence":"매 웨이브 종료 시점 혹은 일정 시간마다 보유한 자원량 비례 이자가 정확한 수식에 의해 계산되어 플레이어 자원 잔고에 반영되는지 로그 데이터를 통해 검증합니다."},{"designElement":"모바일 터치 드래그 앤 드롭 유닛 배치 UI 피드백","responsibleSystem":"모바일 입력 및 UI 피드백 시스템 (Mobile Input & UI Feedback)","validationEvidence":"유저가 카드를 드래그하여 화면 상의 타일에 올렸을 때 배치 가능 여부에 따라 타일 색상이 녹색/적색으로 즉각 변경되고 햅틱 피드백이 발생하는지 실제 모바일 기기 테스트를 통해 검증합니다."}],"stabilityPriorityPlan":{}},"gameIdentityAndNonNegotiables":{"identity":"골목 군단 대전은 골목길이라는 친숙한 공간에서 펼쳐지는 실시간 라인 디펜스 게임으로, 고유한 '골목길 시너지 배치 시스템'과 '실시간 재화 순환 엔진'을 통해 플레이어가 매 순간 유닛의 배치 위치와 업그레이드 타이밍을 결정하며 아지트를 방어하는 독창적인 전략적 선택과 상태 변화를 창출합니다.","coreFun":"매 웨이브마다 변화하는 적의 침공 경로를 관찰하고, 제한된 골목 자원을 활용하여 특정 유닛을 배치하거나 실시간으로 업그레이드 경로를 선택함으로써 즉각적인 전투력 변화와 방어 성공의 쾌감을 얻는 것입니다.","coreLoop":["적의 다음 침공 경로와 유닛 구성을 확인하고 아군 유닛을 골목길의 최적 위치에 배치하는 단계","전투 중 적을 처치하여 실시간으로 골목 자원을 획득하고 이를 유닛 업그레이드나 추가 배치에 투자하는 단계","웨이브를 클리어하고 획득한 전리품으로 군단 전체의 영구적 특성을 강화하여 더 높은 난이도에 도전하는 단계"],"signatureSystems":[{"name":"골목길 시너지 배치 시스템","purpose":"특정 골목 구역에 유닛을 인접하게 배치할 때 발생하는 시너지 효과를 통해 플레이어에게 공간 배치 기반의 깊이 있는 전략적 선택을 제공합니다.","playerChoice":"단순히 강한 유닛을 배치할 것인지, 아니면 시너지 효과를 극대화하기 위해 특정 속성의 유닛들을 좁은 골목에 밀집 배치할 것인지 선택합니다."},{"name":"실시간 재화 순환 엔진","purpose":"전투 중 획득하는 자원의 가치를 실시간으로 변동시켜 플레이어가 자원 수집과 소비의 타이밍을 극적으로 조율하도록 만듭니다.","playerChoice":"자원을 즉시 소모하여 하급 유닛을 다수 소환할 것인지, 아니면 이자를 받기 위해 자원을 저축한 후 고성능 유닛을 한 번에 소환할 것인지 결정합니다."}],"progressionDirection":"플레이어는 스테이지를 클리어하며 골목 대장 레벨을 올리고, 새로운 유닛 카드를 해금하며, 영구적인 골목 아지트 연구를 통해 군단의 기본 능력치를 점진적으로 확장해 나갑니다.","multiplayerMode":"SINGLE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=4","PLACEHOLDER_OR_PRIMITIVE_USAGE_HIGH","UI_MENU_FLOW_SPARSE"],"signals":{"combat":226,"progression":243,"ai":51,"save":57,"multiplayer":31,"animation":29,"motionStates":190,"gameFeel":34,"vfx":27,"camera":33,"audio":4,"audioDynamics":16,"ui":62,"uiFlow":45,"entryFlow":6,"loadingFlow":0,"input":62,"map":173,"landmark":65,"interaction":31,"inventory":33,"equipment":5,"settings":2,"feedback":70,"session":112,"content":229,"choice":27,"connection":2,"performance":23,"lighting":39,"primitive":17,"todo":0,"errorRecovery":19},"topFiles":[{"file":"roblox-games/line-defense/server/Game.server.luau","score":593},{"file":"roblox-games/line-defense/shared/GameConfig.luau","score":283},{"file":"roblox-games/line-defense/client/Game.client.luau","score":183},{"file":"roblox-games/line-defense/default.project.json","score":2}],"sourceAnchors":[{"file":"roblox-games/line-defense/server/Game.server.luau","line":328,"kind":"FUNCTION","symbol":"damageEnemy","context":"local function damageEnemy(player, enemy, amount)","score":130},{"file":"roblox-games/line-defense/server/Game.server.luau","line":445,"kind":"FUNCTION","symbol":"spawnEnemy","context":"local function spawnEnemy(player, enemyKind, wave, index)","score":114},{"file":"roblox-games/line-defense/server/Game.server.luau","line":486,"kind":"FUNCTION","symbol":"spawnBoss","context":"local function spawnBoss(player, wave)","score":114},{"file":"roblox-games/line-defense/client/Game.client.luau","line":478,"kind":"FUNCTION","symbol":"render","context":"local function render()","score":106},{"file":"roblox-games/line-defense/server/Game.server.luau","line":556,"kind":"FUNCTION","symbol":"startWave","context":"local function startWave(player)","score":106},{"file":"roblox-games/line-defense/server/Game.serv