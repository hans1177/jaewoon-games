damageEnemy\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/line-defense/server/Game.server.luau\",\"symbol\":\"spawnEnemy\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/line-defense/server/Game.server.luau\",\"symbol\":\"spawnBoss\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/line-defense/client/Game.client.luau\",\"symbol\":\"render\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/line-defense/server/Game.server.luau\",\"symbol\":\"startWave\",\"kind\":\"FUNCTION\"}],\"designStatus\":\"DESIGN_REPAIR_REQUIRED\",\"codingStatus\":\"SOURCE_OWNER_CANDIDATE_UNVERIFIED\",\"executableBehaviorVerified\":false,\"actualRuntimeVerified\":false,\"evidenceNeeded\":\"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA\"},{\"role\":\"@\",\"grammarRole\":\"DELVE\",\"systemId\":null,\"systemIds\":[],\"names\":[],\"name\":null,\"stateInputs\":[],\"stateOutputs\":[],\"connections\":[],\"suggestedExistingOwnerFiles\":[\"roblox-games/line-defense/server/Game.server.luau\",\"roblox-games/line-defense/shared/GameConfig.luau\",\"roblox-games/line-defense/client/Game.client.luau\"],\"inspectedSymbols\":[{\"file\":\"roblox-games/line-defense/server/Game.server.luau\",\"symbol\":\"damageEnemy\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/line-defense/server/Game.server.luau\",\"symbol\":\"spawnEnemy\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/line-defense/server/Game.server.luau\",\"symbol\":\"spawnBoss\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/line-defense/client/Game.client.luau\",\"symbol\":\"render\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/line-defense/server/Game.server.luau\",\"symbol\":\"startWave\",\"kind\":\"FUNCTION\"}],\"designStatus\":\"DESIGN_REPAIR_REQUIRED\",\"codingStatus\":\"SOURCE_OWNER_CANDIDATE_UNVERIFIED\",\"executableBehaviorVerified\":false,\"actualRuntimeVerified\":false,\"evidenceNeeded\":\"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA\"}],\"observedGameCodeFiles\":[\"roblox-games/line-defense/server/Game.server.luau\",\"roblox-games/line-defense/shared/GameConfig.luau\",\"roblox-games/line-defense/client/Game.client.luau\"],\"executableCodeCandidateFiles\":[\"roblox-games/line-defense/server/Game.server.luau\",\"roblox-games/line-defense/client/Game.client.luau\"],\"gapReasons\":[\"DESIGN_MAIN_A_B_c_AT_INCOMPLETE\",\"MULTIPLAYER_DESIGN_MODE_MISSING\",\"DESIGN_ROLE_NOT_AUTHORED:MAIN\",\"DESIGN_ROLE_NOT_AUTHORED:A\",\"DESIGN_ROLE_NOT_AUTHORED:B\",\"DESIGN_ROLE_NOT_AUTHORED:c\",\"DESIGN_ROLE_NOT_AUTHORED:@\"],\"codingReviewState\":\"GAME_STAGE_LOCAL_REPAIR_REQUIRED\",\"sourceImplementationPassed\":false,\"actualTwoClientPassed\":false,\"actualWebglRenderPassed\":false,\"independentQaPassed\":false,\"stageLocalAction\":\"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME\",\"schemaAndMarkersAloneCannotPass\":true,\"newPipeline\":false,\"changesDevelopmentAdmission\":false,\"saveBalanceAndExistingMultiplayerMeaningPreserved\":true}\nCODING_IMPLEMENTATION_VERDICT: SOURCE_OWNER_CANDIDATES_ONLY. Do not mark a MAIN/A/B/c/@ role, native platform, multiplayer session or 2.5D graphics PASS from design fields or a source marker. Implement and independently replay actual input→authoritative state→result→reconnect, then rerun existing platform QA.\nMULTIPLAYER_IMPLEMENTATION: {\"required\":true,\"policyVersion\":1,\"developmentAdmissionGate\":false,\"missingImplementationAction\":\"EXISTING_BUILD_UP_LOCAL_IMPLEMENTATION_AND_RETRY\",\"otherGamesAndIndependentWorkContinue\":true,\"actualMultiplayerPlayVerified\":false,\"completionEvidence\":\"ACTUAL_TWO_OR_MORE_CLIENTS_SAME_SESSION_ACTION_STATE_RESULT_AND_RECONNECT\"}\n전 게임 멀티 필수: 기존 서버 권한·클라이언트 입력/동기화 책임 소스에서 접속·참가·준비·시작·이탈·재접속과 목표·승패·보상 일치를 구현한다. 로컬 시뮬레이션이나 플래그만으로 구현 완료라 하지 않는다. 빠진 구현은 기존 BUILD_UP에서 계속 수정·재시도하며 다른 게임과 독립 작업은 계속 진행한다. 실제 2인 이상 같은 세션의 증거를 별도로 남긴다.\nIDENTITY_ONE_LINE_FANTASY: 플레이어는 골목길의 대장이 되어 개성 넘치는 골목 군단을 지휘하고, 적들의 침공 경로를 예측하여 최적의 방어선을 구축함으로써 골목의 평화를 지켜내는 전략적 사령관의 역할을 수행합니다.\nIDENTITY_REPRESENTATIVE_ACTION: 적의 다음 침공 경로와 유닛 구성을 확인하고 아군 유닛을 골목길의 최적 위치에 배치하는 단계\nIDENTITY_REPRESENTATIVE_CHOICE: 단순히 강한 유닛을 배치할 것인지, 아니면 시너지 효과를 극대화하기 위해 특정 속성의 유닛들을 좁은 골목에 밀집 배치할 것인지 선택합니다.\nIDENTITY_SIGNATURE_WORLD_RULE: 적 처치 속도가 증가함에 따라 실시간 재화 획득 속도가 가속화되어 더 빠른 업그레이드가 가능해집니다.\nIDENTITY_SIGNATURE_SYSTEMS: 골목길 시너지 배치 시스템,실시간 재화 순환 엔진\nIDENTITY_GROWTH: 플레이어는 스테이지를 클리어하며 골목 대장 레벨을 올리고, 새로운 유닛 카드를 해금하며, 영구적인 골목 아지트 연구를 통해 군단의 기본 능력치를 점진적으로 확장해 나갑니다.\nIDENTITY_THREE_SENTENCE_TEST: WHAT=골목 군단 대전은 골목길이라는 친숙한 공간에서 펼쳐지는 실시간 라인 디펜스 게임으로, 고유한 '골목길 시너지 배치 시스템'과 '실시간 재화 순환 엔진'을 통해 플레이어가 매 순간 유닛의 배치 위치와 업그레이드 타이밍을 결정하며 아지트를 방어하는 독창적인 전략적 선택과 상태 변화를 창출합니다. | DIFFERENT=특정 골목 구역에 유닛을 인접하게 배치할 때 발생하는 시너지 효과를 통해 플레이어에게 공간 배치 기반의 깊이 있는 전략적 선택을 제공합니다. | GROWTH=플레이어는 스테이지를 클리어하며 골목 대장 레벨을 올리고, 새로운 유닛 카드를 해금하며, 영구적인 골목 아지트 연구를 통해 군단의 기본 능력치를 점진적으로 확장해 나갑니다.\nIDENTITY_BUILD_UP_RULE: EACH_BUILD_UP_MUST_STRENGTHEN_OR_PRESERVE_THE_REPRESENTATIVE_ACTION_CHOICE_WORLD_RULE_SIGNATURE_SYSTEM_OR_GROWTH_IDENTITY; GENERIC_FEATURE_COUNT_DOES_NOT_COUNT\nCAUSAL_GRAMMAR_EVIDENCE: {\"worldRules\":[],\"causalInspirations\":[],\"systemInterconnections\":[{\"fromSystem\":\"골목길 시너지 배치 시스템\",\"toSystem\":\"실시간 재화 순환 엔진\",\"trigger\":\"플레이어가 특정 골목 구역에 시너지 배치를 완성하여 적을 빠르게 처치할 때\",\"stateChange\":\"적 처치 속도가 증가함에 따라 실시간 재화 획득 속도가 가속화되어 더 빠른 업그레이드가 가능해집니다.\"},{\"fromSystem\":\"실시간 재화 순환 엔진\",\"toSystem\":\"골목길 시너지 배치 시스템\",\"trigger\":\"플레이어가 저축한 자원을 일시에 소모하여 고성능 유닛을 소환할 때\",\"stateChange\":\"새로운 고성능 유닛이 전장에 배치되면서 기존 유닛들과의 새로운 시너지 링크가 활성화되고 방어선 상태가 강화됩니다.\"},{\"fromSystem\":\"골목길 시너지 배치 시스템\",\"toSystem\":\"골목길 시너지 배치 시스템\",\"trigger\":\"배치된 유닛이 적의 강력한 공격을 받아 파괴되거나 후퇴할 때\",\"stateChange\":\"해당 구역의 시너지 링크가 즉시 끊어지며 주변 유닛들의 공격 속도와 방어력이 감소하는 상태 변화가 발생합니다.\"}],\"expansionPlan\":[{\"milestone\":\"신규 테마 '재개발 구역' 업데이트\",\"newGameplay\":\"파괴 가능한 장애물과 무너지는 벽 등 지형 변화 요소가 추가된 신규 스테이지 20종을 선보입니다.\",\"systemImpact\":\"기존의 고정된 골목길 시너지 배치 시스템에 지형 파괴라는 변수가 추가되어 플레이어가 실시간으로 배치 전략을 수정해야 합니다.\"},{\"milestone\":\"신규 유닛 '골목 대장단' 추가\",\"newGameplay\":\"고유한 액티브 스킬을 보유하여 전장의 판도를 단번에 바꿀 수 있는 영웅급 유닛 3종이 추가됩니다.\",\"systemImpact\":\"실시간 재화 순환 엔진에서 영웅 유닛의 스킬 쿨타임 감소 및 마나 충전을 위한 새로운 자원 소모처가 신설됩니다.\"},{\"milestone\":\"무한의 골목길 디펜스 모드 오픈\",\"newGameplay\":\"끝없이 밀려오는 적들을 막아내며 자신의 한계에 도전하고 글로벌 랭킹을 겨루는 무한 모드가 도입됩니다.\",\"systemImpact\":\"장기적인 전투에 대응하기 위해 실시간 재화 순환 엔진의 이자율 제한이 해제되고 초고단계 시너지 효과가 추가됩니다.\"}],\"integrityNotes\":[],\"formula\":\"MATERIAL_CAUSAL_GRAMMAR × (MAIN × A × B × c) + @\",\"existingGameGrammarMap\":{\"mode\":\"EXISTING_GAME_RECONSTRUCTION_FROM_CURRENT_DESIGN_AND_INSPECTED_SOURCE\",\"formula\":\"MAIN × A × B × c + @\",\"main\":\"적의 다음 침공 경로와 유닛 구성을 확인하고 아군 유닛을 골목길의 최적 위치에 배치하는 단계\",\"source\":\"LEGACY_DESIGN_HEURISTIC_NOT_IMPLEMENTATION_EVIDENCE\",\"roleSystemIds\":{\"MAIN\":null,\"A\":null,\"B\":null,\"c\":[],\"AT\":[]},\"majorAxes\":[{\"key\":\"A\",\"systemId\":null,\"name\":\"골목길 시너지 배치 시스템\",\"source\":\"LEGACY_DESIGN_FALLBACK_UNVERIFIED\"},{\"key\":\"B\",\"systemId\":null,\"name\":\"실시간 재화 순환 엔진\",\"source\":\"LEGACY_DESIGN_FALLBACK_UNVERIFIED\"}],\"cSubElements\":[\"플레이어가 특정 골목 구역에 시너지 배치를 완성하여 적을 빠르게 처치할 때\",\"플레이어가 저축한 자원을 일시에 소모하여 고성능 유닛을 소환할 때\",\"배치된 유닛이 적의 강력한 공격을 받아 파괴되거나 후퇴할 때\"],\"delveAtEvidence\":[\"신규 테마 '재개발 구역' 업데이트\",\"파괴 가능한 장애물과 무너지는 벽 등 지형 변화 요소가 추가된 신규 스테이지 20종을 선보입니다.\",\"신규 유닛 '골목 대장단' 추가\",\"고유한 액티브 스킬을 보유하여 전장의 판도를 단번에 바꿀 수 있는 영웅급 유닛 3종이 추가됩니다.\",\"무한의 골목길 디펜스 모드 오픈\",\"끝없이 밀려오는 적들을 막아내며 자신의 한계에 도전하고 글로벌 랭킹을 겨루는 무한 모드가 도입됩니다.\"],\"sourceTreeFingerprint\":\"dfa97160d822acb6f6d93ba6b1cc684795c5f77565c54aa651b160c8e4ef5c83\",\"rule\":\"PRESERVE_CURRENT_GAME_MEANING_FIRST; DISCOVER_MAIN_A_B_c_RELATIONSHIPS_FROM_CURRENT_DESIGN_AND_SOURCE; CLOSE_MISSING_CONNECTIONS_BEFORE_ADDING_UNRELATED_SYSTEMS; @ IS_DELVE_MASTERY_DISCOVERY_REVISIT_REINTERPRETATION_OR_ADVANCED_COMBINATION_NOT_A_GENERAL_SYSTEM_AXIS\",\"identityRewriteRequired\":false,\"existingBalanceSaveEconomyAndAuthorityPreserved\":true},\"rule\":\"NEW_CONTENT_MUST_PRESERVE_OR_DE