vior":["CURRENT_STEP_IS_REACHABLE_FROM_PREVIOUS_SESSION_OR_LOOP_STATE","PLAYER_ACTION_TRANSITIONS_TO_NEXT_AUTHORED_LOOP_STEP","SUCCESS_FAILURE_AND_RETRY_FEEDBACK_OBSERVABLE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 A 재진입: B가 갱신한 RouteState와 이전 경로를 비교해 미지 공간과 지도 정보 수집의 새 선택을 실행하거나 @ 발견 조건을 시험한다. 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SIGNATURE_SYSTEM[0]","family":"SIGNATURE_SYSTEM","index":0,"title":"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독","authoredId":"VIBE_MAIN","designDetail":{"id":"VIBE_MAIN","grammarRole":"MAIN","name":"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독","purpose":"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독. MAIN은 A(미지 공간과 지도 정보 수집 × 문화·언어와 번역)의 대규모 창작 규칙과 독립적인 B(상대 기술과 팀 전술 대응 × 의례와 호혜 관계)의 세부 사건 규칙, C(메인 탐험 × 보조 대전 슈팅 액션; 역사적 세력 균형·희극의 오해와 엇갈림 반작용), @(문화·언어와 번역의 경로 해독: B에서 비용이 다른 대응을 선택한 뒤 WorldAccessState에 새 접근 조건을 반영한다. 실패하면 원래 RouteState를 유지한다.)를 연결한 결과로 결정된다. A→B→A의 입력·행동·상태 변화가 실제 목표를 만든다. 플레이어는 선택한 목표를 향해 A→B→A와 @의 발견 조건을 실행한다. WorldAccessState·IntentSt","playerChoice":"A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. 이후 다음 행동의 위험과 보상을 직접 선택한다.","stateInputs":["WorldAccessState","IntentState"],"stateOutputs":["RouteState","WorldAccessState"]},"playerChoice":"A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. 이후 다음 행동의 위험과 보상을 직접 선택한다.","trigger":null,"stateChange":null,"linkedRuleIds":["VIBE_MAIN","VIBE_A","VIBE_DELVE"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["DESIGNED_RULE_ID_INPUT_OUTPUT_STATE_KEYS_BOUND_TO_EXISTING_GAME_SYSTEM","ALTERNATIVE_PLAYER_CHOICES_CHANGE_AUTHORED_STATE_OR_CONSEQUENCE","CORE_LOOP_AND_OTHER_SIGNATURE_SYSTEMS_SHARE_AUTHORITATIVE_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SIGNATURE_SYSTEM[1]","family":"SIGNATURE_SYSTEM","index":1,"title":"미지 공간과 지도 정보 수집 × 문화·언어와 번역","authoredId":"VIBE_A","designDetail":{"id":"VIBE_A","grammarRole":"A","name":"미지 공간과 지도 정보 수집 × 문화·언어와 번역","purpose":"A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 공간과 지도 정보 수집 실행 조건을 판정하고, 언어 단서를 해석하면 거래·동맹·임무의 접근 조건이 달라진다. 결과로 RiskState·ResourceState를 갱신해 B와 세계의 다음 선택을 바꾼다. 조건 미충족·취소 시 이전 상태를 보존한다.","playerChoice":"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.","stateInputs":["RouteState","RiskState"],"stateOutputs":["RiskState","ResourceState"]},"playerChoice":"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.","trigger":null,"stateChange":null,"linkedRuleIds":["VIBE_MAIN","VIBE_A","VIBE_B","VIBE_DELVE"],"designResponsibleSystem":"roblox-games/cozy-island/에서 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 기존 Luau 책임 함수와 코드 모듈","sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["DESIGNED_RULE_ID_INPUT_OUTPUT_STATE_KEYS_BOUND_TO_EXISTING_GAME_SYSTEM","ALTERNATIVE_PLAYER_CHOICES_CHANGE_AUTHORED_STATE_OR_CONSEQUENCE","CORE_LOOP_AND_OTHER_SIGNATURE_SYSTEMS_SHARE_AUTHORITATIVE_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"같은 조건의 입력 전후 위험·세계 상태 값과 다음 B의 선택 변화를 비교한다.","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SIGNATURE_SYSTEM[2]","family":"SIGNATURE_SYSTEM","index":2,"title":"상대 기술과 팀 전술 대응 × 의례와 호혜 관계","authoredId":"VIBE_B","designDetail":{"id":"VIBE_B","grammarRole":"B","name":"상대 기술과 팀 전술 대응 × 의례와 호혜 관계","purpose":"B는 A의 하위 주제가 아니라 의례와 호혜 관계에서 독자적으로 만든 세부 사건·대상 규칙이다. 독립적으로 정한 상대 기술과 팀 전술 대응 행동은 A가 출력한 RiskState·ResourceState를 조건으로 읽는다. 자원 소비·행동 규칙·환경 반응이 계약처럼 서로 대가를 요구한다. 대응 성공 시 RouteState·RiskState를 A로 돌려보내 세계 규칙까지 바꾼다. 조건 미충족 시 상태를 보존한다.","playerChoice":"행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.","stateInputs":["RiskState","ResourceState"],"stateOutputs":["RouteState","RiskState"]},"playerChoice":"행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.","trigger":null,"stateChange":null,"linkedRuleIds":["VIBE_A","VIBE_B","VIBE_DELVE"],"designResponsibleSystem":"roblox-games/cozy-island/에서 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 기존 Luau 책임 함수와 코드 모듈","sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["DESIGNED_RULE_ID_INPUT_OUTPUT_STATE_KEYS_BOUND_TO_EXISTING_GAME_SYSTEM","ALTERNATIVE_PLAYER_CHOICES_CHANGE_AUTHORED_STATE_OR_CONSEQUENCE","CORE_LOOP_AND_OTHER_SIGNATURE_SYSTEMS_SHARE_AUTHORITATIVE_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"B의 반작용 이전/이후 A의 다음 경로·비용·행동 가능성을 비교한다.","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SIGNATURE_SYSTEM[3]","family":"SIGNATURE_SYSTEM","index":3,"title":"문화·언어와 번역의 경로 해독","authoredId":"VIBE_DELVE","designDetail":{"id":"VIBE_DELVE","grammarRole":"DELVE","name":"문화·언어와 번역의 경로 해독","purpose":"같은 표현도 문화적 맥락이 달라지면 의미와 반응이 달라질 수 있다. 원리를 A의 선택과 B의 결과를 비교해 발견한다. 숨겨진 조건을 실험한 뒤 새로운 선택과 경로를 연다.","playerChoice":"A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다.","stateInputs":["RouteState","RiskState"],"stateOutputs":["WorldAccessState","IntentState"]},"playerChoice":"A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다.","trigger":null,"stateChange":null,"linkedRuleIds":["VIBE_B","VIBE_DELVE","VIBE_MAIN","VIBE_A"],"designResponsibleSystem":"진행·탐색·발견을 연결하는 기존 책임 함수","sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["DESIGNED_RULE_ID_INPUT_OUTPUT_STATE_KEYS_BOUND_TO_EXISTING_GAME_SYSTEM","ALTERNATIVE_PLAYER_CHOICES_CHANGE_AUTHORED_STATE_OR_CONSEQUENCE","CORE_LOOP_AND_OTHER_SIGNATURE_SYSTEMS_SHARE_AUTHORITATIVE_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"숨은 발견 조건 이전/이후의 새로운 선택과 재방문 결과를 검증한다.","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SYSTEM_CONNECTION[0]","family":"SYSTEM_CONNECTION","index":0,"title":"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독 → 미지 공간과 지도 정보 수집 × 문화·언어와 번역","authoredId":null,"designDetail":{"fromId":"VIBE_MAIN","toId":"VIBE_A","stateKeys":["RouteState"],"fromSystem":"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독","toSystem":"미지 공간과 지도 정보 수집 × 문화·언어와 번역","trigger":"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 선택: A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 기존 선행조건을 만족해 RouteState 출력이 확정됐을 때 미지 공간과 지도 정보 수집 × 문화·언어와 번역이 같은 키를 읽는다.","stateChange":"VIBE_MAIN 출력 RouteState → VIBE_A 입력. 후속 선택: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다."},"playerChoice":null,"trigger":"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 선택: A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 기존 선행조건을 만족해 RouteState 출력이 확정됐을 때 미지 공간과 지도 정보 수집 × 문화·언어와 번역이 같은 키를 읽는다.","stateChange":"VIBE_MAIN 출력 RouteState → VIBE_A 입력. 후속 선택: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.","linkedRuleIds":["VIBE_MAIN","VIBE_A"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["FROM_SYSTEM_EMITS_DECLARED_STATE_KEYS","TO_SYSTEM_CONSUMES_SAME_STATE_KEYS_WITHOUT_DUPLICATE_SHADOW_STATE","TRIGGER_AND_RESULT_VERIFIED_BOTH_SIDES","SUCCESS_ALTERNATIVE_CANCEL_AND_REVERSE_HANDOFF_USE_EXISTING_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독 → 미지 공간과 지도 정보 수집 × 문화·언어와 번역 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SYSTEM_CONNECTION[1]","family":"SYSTEM_CONNECTION","index":1,"title":"미지 공간과 지도 정보 수집 × 문화·언어와 번역 → 상대 기술과 팀 전술 대응 × 의례와 호혜 관계","authoredId":null,"designDetail":{"fromId":"VIBE_A","toId":"VIBE_B","stateKeys":["RiskState","ResourceState"],"fromSystem":"미지 공간과 지도 정보 수집 × 문화·언어와 번역","toSystem":"상대 기술과 팀 전술 대응 × 의례와 호혜 관계","trigger":"미지 공간과 지도 정보 수집 × 문화·언어와 번역의 선택: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 기존 선행조건을 만족해 RiskState·ResourceState 출력이 확정됐을 때 상대 기술과 팀 전술 대응 × 의례와 호혜 관계이 같은 키를 읽는다.","stateChange":"VIBE_A 출력 RiskState·ResourceState → VIBE_B 입력. 후속 선택: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다."},"playerChoice":null,"trigger":"미지 공간과 지도 정보 수집 × 문화·언어와 번역의 선택: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 기존 선행조건을 만족해 RiskState·ResourceState 출력이 확정됐을 때 상대 기술과 팀 전술 대응 × 의례와 호혜 관계이 같은 키를 읽는다.","stateChange":"VIBE_A 출력 RiskState·ResourceState → VIBE_B 입력. 후속 선택: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.","linkedRuleIds":["VIBE_A","VIBE_B"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["FROM_SYSTEM_EMITS_DECLARED_STATE_KEYS","TO_SYSTEM_CONSUMES_SAME_STATE_KEYS_WITHOUT_DUPLICATE_SHADOW_STATE","TRIGGER_AND_RESULT_VERIFIED_BOTH_SIDES","SUCCESS_ALTERNATIVE_CANCEL_AND_REVERSE_HANDOFF_USE_EXISTING_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 미지 공간과 지도 정보 수집 × 문화·언어와 번역 → 상대 기술과 팀 전술 대응 × 의례와 호혜 관계 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_Q