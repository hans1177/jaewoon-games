TUS_EFFECTS","library":"assets/status-effects.js","sourceFiles":["web-games/cozy-island/index.html","web-games/cozy-island/style.css","web-games/cozy-island/game-v3.js","web-games/cozy-island/abyss-cave-v23.js"],"integration":"REUSE_EXISTING_COMPATIBLE_HANDLER","optional":true,"automaticImport":false,"runtimeVerified":false},{"id":"TARGETING_SYSTEM","library":"assets/targeting-system.js","sourceFiles":["web-games/cozy-island/balance-reset.js"],"integration":"REUSE_EXISTING_COMPATIBLE_HANDLER","optional":true,"automaticImport":false,"runtimeVerified":false},{"id":"TURN_COMBAT","library":"assets/turn-combat.js","sourceFiles":["web-games/cozy-island/style.css","web-games/cozy-island/game.js","web-games/cozy-island/game-v3.js","web-games/cozy-island/abyss-cave-v23.js","web-games/cozy-island/balance-reset.js"],"integration":"REUSE_EXISTING_COMPATIBLE_HANDLER","optional":true,"automaticImport":false,"runtimeVerified":false},{"id":"VISUAL_STYLE","library":"assets/visual-style.js","sourceFiles":["web-games/cozy-island/index.html","web-games/cozy-island/style.css","web-games/cozy-island/game.js","web-games/cozy-island/game-v3.js","web-games/cozy-island/abyss-cave-v23.js","web-games/cozy-island/balance-reset.js"],"integration":"REUSE_EXISTING_COMPATIBLE_HANDLER","optional":true,"automaticImport":false,"runtimeVerified":false},{"id":"WAVE_SPAWNER","library":"assets/wave-spawner.js","sourceFiles":["web-games/cozy-island/style.css"],"integration":"REUSE_EXISTING_COMPATIBLE_HANDLER","optional":true,"automaticImport":false,"runtimeVerified":false}],"firstPartyLibraryCount":37,"assetLibrarySelection":"EXISTING_CANONICAL_ASSET_LIBRARY_WITH_LICENSE_GATE","status":"SOURCE_MATCH_CANDIDATES_NOT_APPLIED","optional":true,"designMutation":false,"noNewGameplaySystem":true,"noShadowUiPipeline":true,"nativeUiOnly":true,"runtimeVerified":false,"applicationRule":"APPLY_ONLY_ON_CONFIRMED_EXISTING_UI_FRICTION_AND_OWNED_HANDLER"}},"compositionRule":"DO_NOT_LIMIT_TO_READY_MADE_ASSETS. VIBE MAY DIRECTLY_REUSE_WHEN_ALREADY_CORRECT, ADAPT_OR_RESTYLE, OR RECOMBINE_MULTIPLE_COMPATIBLE_ASSET_MOTION_VFX_UI_IDEAS INTO_A_NEW_PROJECT_SPECIFIC_EXPRESSION.","conceptRule":"EVERY_APPLIED_RESULT_MUST_MATCH_CURRENT_GAME_IDENTITY_STYLE_LOCK_WORLD_CONTEXT_REGION_ROLE_AND_GAMEPLAY_READABILITY.","antiMashupRule":"RAW_UNPROCESSED_ASSET_PACK_MIXING_OR_STYLE_COLLISION_IS_FORBIDDEN; RECOMBINATION_MUST_BE_NORMALIZED_INTO_ONE_GAME_SPECIFIC_VISUAL_LANGUAGE.","copyRule":"DO_NOT_COPY_FOREIGN_RAW_SOURCE_ASSET_BYTES_PROTECTED_IDENTIFIERS_OR_VERBATIM_IMPLEMENTATION; TRANSFORM_REFERENCES_INTO_NEW_PROJECT_SPECIFIC_EXPRESSION.","implementation":{"actualSourceOrBindingDeltaRequired":true,"selectionOnlyDoesNotCount":true,"markerOnlyDoesNotCount":true,"actualReplacementCountMustBeRecorded":true,"changedSurfacesMustBeRecorded":true,"reuseModesUsedMustBeRecorded":true,"perReplacementSourceEvidenceRequired":true,"actualReplacementCountMustEqualGroundedEvidenceCount":true,"replacementEvidenceMustReferenceTouchedSourcePath":true,"replacementEvidenceSnippetMustExistInChangedSource":true,"duplicateReplacementEvidenceCannotInflateCount":true,"selfReportedCountWithoutGroundedSourceEvidenceCannotPass":true,"zeroActualReplacementCannotPass":true,"beforeAfterEvidenceRequired":true,"preserveGameplayBalanceSaveProgressionHitSemanticsAndNetworkAuthority":true}},"motionRepairWorkUnit":null,"executionLane":"ASSET_DEVELOPMENT","goal":"[WORLD_LOBBY_FIRST]\n게임=cozy-island 포근섬: 작은 왕국 키우기  \n첫 구현 순서는 F2 월드 로비·안전 스폰 → F5 안내·입력·시작 전환 → F8 기존 핵심 플레이 연결 → F9 시작·복귀 회귀 확인이다. 치명적 부팅/저장 오류를 수리하되 빌드업은 계속한다.\n현재 소스와 설계에서 이미 완성된 로비는 보존·재사용한다. 미완성 부분만 먼저 채우고 같은 사이클에 원래 기능 작업을 이어간다. 로비를 매번 다시 짓거나 완료 확인만 반복하지 않는다.\n컨셉 후보(현재 게임 규칙과 실제 월드에 맞게 선택·변형): 현재 게임 세계의 출발 거점, 핵심 행동을 예고하는 고유 랜드마크, 실제 첫 목표로 이어지는 길. 심야대탈출의 호텔이나 UI를 다른 게임에 복제하지 않는다. 색만 바꾼 공통 로비는 금지한다.\n월드 공간의 형태·동선, 대표 랜드마크, 재질·조명, 가벼운 환경음·카메라 연출을 하나의 게임 정체성으로 맞춘다. 안전 스폰과 바닥 충돌, 첫 목표 안내, 모바일 도달 가능한 실제 시작 행동, 플레이 후 복귀를 연결한다. 없는 상점·파티·경제 기능을 장식 버튼으로 만들지 않는다.\nUI는 로비→선택→플레이 상태와 연결한다. 직업 선택은 서버 확정 후 닫고, 이미 선택한 캐릭터는 매번 다시 묻지 않는다. 기존 저장 키·진행·전투 규칙을 보존하고 오래된 이벤트 연결과 겹친 화면을 정리한다.\n저사양 기준으로 로비 생성은 한 번, 이벤트 연결은 중복 없이, 반복 탐색·과도한 파티클·매 프레임 UI 갱신을 줄인다. Studio는 한 창에서 현재 프로세스 준비를 기다린다. 멀티는 소스 계약 검사로 기록하고 실제 다인 실행 성공으로 쓰지 않는다.\n소스/정적 통과와 Studio 실측을 구분해 기록한다. 로비 생성·시작·복귀의 책임 파일과 실제 변경 근거를 남기며, 사진/문구/마커만으로 구현 완료를 주장하지 않는다.\n[/WORLD_LOBBY_FIRST]\n[EXISTING_WEB_ASSESS_AND_IMPLEMENT]\n게임: 포근섬: 작은 왕국 키우기\n기존 Web 소스를 먼저 읽고 승인 설계와 비교하며 게임별 아트 방향과 Style Lock도 함께 확정한다. exploration의 EXISTING_WEB_STRATEGY가 KEEP_AND_CONTINUE면 현재 구조를 보존하며 필요한 개발만 이어가고, PARTIAL_REPAIR면 문제 책임 영역만 수정하고, MAJOR_REWORK면 쓸 수 있는 시스템·세이브·핵심 루프를 보존한 채 큰 결함을 재구성한다. FULL_REBUILD는 exploration이 실제 게임성 신호와 승인 scope 근거가 부족하다고 판정한 경우에만 허용한다. 파일 존재 여부나 프로토타입 문구 하나만으로 전체 재구축을 결정하지 않는다. KEEP 여부와 무관하게 Web에서 플레이어·몬스터·배경·모션 표현을 실제 컨셉과 대조하고, 임시 도형/모형 몹/무맥락 배경을 완성 상태로 인정하지 않는다. 액션·전투 게임은 idle/move/attack/hit/death와 공격·피격·사망 애니메이션이 실제 상태에 연결돼야 하며 이 Web 표현 기준이 런타임에서 성립한 뒤에만 Roblox/Unity/UEFN 이관 대상으로 본다. 검증된 학습은 새 코드·새 에셋 표현으로 재조합하고 기존 게임 정체성과 승인 설계를 유지한다.\n[TRANSFORMATIVE_RECOMBINATION_CONTEXT]\nrecipe=recombine_85f9c40fef7d542a\nsource_projects=external-commercial-afk-arena,external-commercial-hay-day\nfeature_blend=idle-reward,offline-progress,upgrade-layer,claim-idempotency,persistent-growth,commercial-idle-runtime-architecture,crop-cycle,production-chain\ntransformation=change-feedback-rhythm\nUse these as abstract design/implementation references only.\nCreate a new project-specific mechanic/constraint and new code/asset expression.\nDo not emit raw source files, raw asset bytes, logos, source-specific identifiers, or verbatim implementation.\nPreserve the current game identity, approved design, gameplay authority, save meaning, and all existing QA/runtime/regression gates.\n\n[GAME_SPECIFIC_BUILD_UP_DIRECTIVE]\nid=cozy-island-build-up-g1-53302729abdd; generation=1; depth=1; stage=FOUNDATION_COMPLETENESS; focus=CORE_FUN\nGAME_IDENTITY: 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독. MAIN은 A(미지 공간과 지도 정보 수집 × 문화·언어와 번역)와 독립적인 B(상대 기술과 팀 전술 대응 × 의례와 호혜 관계)의 양방향 RiskState·ResourceState·RouteState 변화, C(메인 탐험 × 보조 대전 슈팅 액션)의 판정 차이, @(문화·언어와 번역의 경로 해독)가 여는 새 WorldAccessState를 합성한 결과다.\nDESIGN_IMPLEMENTATION_CONTEXT: {\"source\":\"LATEST_VERIFIED_DESIGN_FIELDS\",\"detailedDesign\":{},\"tutorialPlan\":{},\"presentationPlan\":{},\"interfacePlan\":{},\"verificationPlan\":{},\"spatialLayout\":{},\"spatialDimension\":\"\",\"creativeGrammar\":{\"mainIdentity\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독. A의 미지 공간과 지도 정보 수집 선택과 B의 상대 기술과 팀 전술 대응 대응을 왕복하고, C의 메인 탐험·보조 대전 슈팅 액션 장르 판정과 @(문화·언어와 번역의 경로 해독) 발견 조건이 목표·길·세계 반응을 바꾼다.\",\"a\":{\"system\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역\",\"material\":\"문화·언어와 번역\",\"materialDomain\":\"culture language context의 문화·역사 인과 소재\",\"stateChange\":\"A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 공간과 지도 정보 수집 실행 조건을 판정하고, 언어 단서를 해석하면 거래·동맹·임무의 접근 조건이 달라진다. 결과로 RiskState·ResourceState를 갱신해 B와 세계의 다음 선택을 바꾼다. 조건 미충족·취소 시 이전 상태를 보존한다.\"},\"b\":{\"system\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계\",\"material\":\"의례와 호혜 관계\",\"materialDomain\":\"ritual religion folk tradition의 문화·역사 인과 소재\",\"stateChange\":\"B는 A의 하위 주제가 아니라 의례와 호혜 관계에서 독자적으로 만든 세부 사건·대상 규칙이다. 독립적으로 정한 상대 기술과 팀 전술 대응 행동은 A가 출력한 RiskState·ResourceState를 조건으로 읽는다. 자원 소비·행동 규칙·환경 반응이 계약처럼 서로 대가를 요구한다. 대응 성공 시 RouteState·RiskState를 A로 돌려보내 세계 규칙까지 바꾼다. 조건 미충족 시 상태를 보존한다.\"},\"abCausality\":\"A(미지 공간과 지도 정보 수집)는 RouteState·RiskState를 읽어 실행 여부를 판정하고 ResourceState를 B에 보낸다. B(상대 기술과 팀 전술 대응)는 RiskState·ResourceState를 읽어 행동을 선택하고 RouteState·RiskState를 A에 반환한다. 실패나 취소 때는 상태를 보존하고 다른 선택을 한다.\",\"abEvolution\":{\"aChangesB\":\"미지 공간과 지도 정보 수집 성공으로 RiskState·ResourceState가 바뀐 때만 B의 상대 기술과 팀 전술 대응 대응이 열리고, 실패 시 기존 값과 이전 선택을 보존한다.\",\"bChangesA\":\"B의 상대 기술과 팀 전술 대응 성공 결과인 RouteState·RiskState에 따라 A의 미지 공간과 지도 정보 수집 재진입 경로와 위험·선택 비용이 달라진다. 불가능한 선택은 이전 상태로 복구한다.\",\"lateGameChange\":\"후반에는 문화·언어와 번역와 의례와 호혜 관계의 상반된 조건을 역이용해 같은 장소도 서로 다른 경로와 결말로 해결한다.\"},\"materialFusion\":{\"contrast\":\"문화·언어와 번역의 원인 규칙과 의례와 호혜 관계의 반작용을 미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 서로 다른 선택에 결합한다.\",\"causalBridge\":\"A에서 미지 공간과 지도 정보 수집를 선택해 RiskState·ResourceState를 바꾸고, 그 값을 읽는 B의 상대 기술과 팀 전술 대응 대응을 실행한다. B의 RouteState·RiskState 출력은 다시 A의 접근 가능성과 다음 선택을 바꾼다. 실패 시 마지막 유효 상태로 돌아가 대안을 고른다.\",\"removalConsequence\":\"문화·언어와 번역를 제거하면 A의 선행 조건이 사라지고 의례와 호혜 관계를 제거하면 B의 결과가 A에 돌아오는 대가와 학습이 사라진다.\"},\"storyCausalChain\":{\"cause\":\"문화·언어와 번역의 원칙을 지키는 인물과 의례와 호혜 관계의 책임을 지려는 인물이 목표를 놓고 충돌한다. A의 RiskState·ResourceState가 B의 의례와 호혜 관계 판정을 바꾸고 B의 RouteState·RiskState가 MAIN의 WorldAccessState를 거쳐 다시 A의 접근 조건이 된다.\",\"characterConflict\":\"인물은 플레이어의 이전 선택을 기억하고 신뢰·거래·협력 조건을 변경한다.\",\"playerChoice\":\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 또는 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 중 무엇을 우선할지 판단한다.\",\"worldChange\":\"문화·언어와 번역의 흔적이 남은 지역은 의례와 호혜 관계의 선택에 따라 새로운 출입·보상 조건을 갖는다. 역사적 세력 균형와 희극의 오해와 엇갈림가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다.\",\"nextEvent\":\"관계의 갈등이 플레이어의 실제 선택을 통해 해결되거나 심화되고, 그 결과가 다음 사건의 원인이 된다. 다음 사건은 직전 세계·관계 상태를 읽고 발생한다.\"},\"cThemes\":[{\"name\":\"역사적 세력 균형\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 이 단서의 확인 여부가 A의 RiskState와 B의 ResourceState 사용 조건을 바꾼다.\"},{\"name\":\"희극의 오해와 엇갈림\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"틀린 믿음·잘못 전달된 정보가 실제 목표·동선·관계 상태를 바꾼다. B의 RouteState 해금과 A의 재진입 조건을 바꾸며 대가를 선택하게 한다.\"}],\"cGenres\":[{\"role\":\"PRIMARY\",\"name\":\"탐험\",\"gameplayEffect\":\"A(미지 공간과 지도 정보 수집)와 B(상대 기술과 팀 전술 대응)의 왕복 선택으로 중심 목표와 위험·보상을 판정한다.\"},{\"role\":\"SECONDARY\",\"name\":\"대전 슈팅 액션\",\"gameplayEffect\":\"역사적 세력 균형의 단서와 희극의 오해와 엇갈림의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다.\"}],\"cGenreInterlock\":\"탐험 목표를 해결하려면 A의 ResourceState 확보와 B의 RouteState 변경을 반복한다. 대전 슈팅 액션 판단에서는 역사적 세력 균형의 단서를 먼저 해석하거나 희극의 오해와 엇갈림의 반작용을 감수해야 B의 대응·A의 재진입 중 하나가 가능하다. 보조 장르를 제거하면 실제 접근 조건이 달라진다.\",\"cWorldAndGameplayEffect\":\"A의 RiskState·ResourceState가 B의 의례와 호혜 관계 판정을 바꾸고 B의 RouteState·RiskState가 MAIN의 WorldAccessState를 거쳐 다시 A의 접근 조건이 된다. 역사적 세력 균형와 희극의 오해와 엇갈림가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. A에서 미지 공간과 지도 정보 수집를 선택해 RiskState·ResourceState를 바꾸고, 그 값을 읽는 B의 상대 기술과 팀 전술 대응 대응을 실행한다. B의 RouteState·RiskState 출력은 다시 A의 접근 가능성과 다음 선택을 바꾼다. 실패 시 마지막 유효 상태로 돌아가 대안을 고른다.\",\"delveDiscoveries\":[{\"clue\":\"문화·언어와 번역의 경로 해독: A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다.\",\"discovery\":\"문화·언어와 번역의 경로 해독: 같은 표현도 문화적 맥락이 달라지면 의미와 반응이 달라질 수 있다. 원리를 A의 선택과 B의 결과를 비교해 발견한다.\",\"newChoice\":\"문화·언어와 번역의 경로 해독: B에서 비용이 다른 대응을 선택한 뒤 WorldAccessState에 새 접근 조건을 반영한다. 실패하면 원래 RouteState를 유지한다.\"},{\"clue\":\"의례와 호혜 관계의 귀환 흔적: B가 RouteState·RiskState를 갱신한 뒤 A의 이전 진입 장소를 다시 방문해 차이를 확인한다.\",\"discovery\":\"의례와 호혜 관계의 귀환 흔적: 의례는 보상이 아니라 인간과 세계 사이의 상호 의무를 갱신한다. 원리 때문에 같은 A 행동도 재방문에서는 다른 조건으로 판정됨을 발견한다.\",\"newChoice\":\"의례와 호혜 관계의 귀환 흔적: 다음 A에서 위험을 낮추는 우회 RouteState 또는 정보 회복을 선택한다. 재방문 전에는 해금하지 않는다.\"},{\"clue\":\"역사적 세력 균형·오해와 엇갈림의 이중 단서: C의 두 소재가 각각 A의 RiskState와 B의 ResourceState를 바꾸는 사례를 관찰한 뒤 순서를 비교한다.\",\"discovery\":\"역사적 세력 균형·오해와 엇갈림의 이중 단서: 한 세력의 완전한 승리가 오히려 더 큰 불균형과 반발을 만든다. / 서로 다른 정보와 오해가 연쇄적으로 현실의 결과를 만든다. 두 원리가 결합될 때 대전 슈팅 액션의 해석이 다음 행동 허용 여부를 바꾼다.\",\"newChoice\":\"역사적 세력 균형·오해와 엇갈림의 이중 단서: 단서 해석을 선택해 IntentState를 갱신하고 B의 다른 대응을 연다. 조건 미달이면 기존 행동을 유지한다.\"},{\"clue\":\"미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: A의 위험 선택을 바꾼 두 결과에 동일한 B 대응을 적용해 RouteState·RiskState를 비교한다.\",\"discovery\":\"미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: 문화·언어와 번역의 불리한 결과가 의례와 호혜 관계의 다른 조건에서는 유리해지는 실제 인과를 발견한다.\",\"newChoice\":\"미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: A로 재진입할 때 WorldAccessState에 반대 경로를 기록해 다른 해결을 선택한다. 실패한 시도는 기존 상태를 보존한다.\"}],\"delveGrowthRule\":\"@는 최초 4개 발견으로 출발하지만 완성 개수가 아니다. 각 발견의 WorldAccessState·RouteState·ResourceState·IntentState 결과를 다음 @의 선행 조건으로 연결한다. A의 행동과 B의 대응, C의 두 소재·메인/보조 장르 해석을 다른 순서로 실험해 새 선택을 연다. 새 @마다 실제 상태 변화·실패 복구·육하원칙을 검증하고 단순 이름·순번 교체는 반려한다. 파고들기와 콘텐츠 확장에 최종 개수 제한을 두지 않는다.\",\"finalGameIdentity\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독 복합장르. A와 B의 인과 변화, C의 주·보조 장르, @(문화·언어와 번역의 경로 해독) 발견에서 MAIN이 최종 확정된다. A(미지 공간과 지도 정보 수집)·B(상대 기술과 팀 전술 대응)가 인과 상태를 교환하고 C(탐험×대전 슈팅 액션)가 목표와 대응법을 바꾸며 @(문화·언어와 번역의 경로 해독)의 발견 결과가 다음 행동을 여는 복합 장르다.\",\"fiveWOneH\":[{\"element\":\"MAIN\",\"who\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 탐사자이자 인과 선택의 책임자\",\"when\":\"첫 진입과 매 반복 목표를 고를 때 WorldAccessState·IntentState를 확인한다.\",\"where\":\"문화·언어와 번역의 첫 선택 공간에서 출발해 의례와 호혜 관계의 되돌림 공간을 거쳐 돌아온다.\",\"what\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독. A의 미지 공간과 지도 정보 수집 선택과 B의 상대 기술과 팀 전술 대응 대응을 왕복하고, C의 메인 탐험·보조 대전 슈팅 액션 장르 판정과 @(문화·언어와 번역의 경로 해독) 발견 조건이 목표·길·세계 반응을 바꾼다.\",\"how\":\"A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. → B 대응: A의 ResourceState·RiskState를 확인한 뒤 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 성공하면 RouteState·RiskState를 갱신하고 불가능하면 소비 없이 다시 선택한다. → A 재진입: B가 갱신한 RouteState와 이전 경로를 비교해 미지 공간과 지도 정보 수집의 새 선택을 실행하거나 @ 발견 조건을 시험한다.. A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. 이후 다음 행동의 위험과 보상을 직접 선택한다.\",\"why\":\"반복 목적: 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독. MAIN은 A(미지 공간과 지도 정보 수집 × 문화·언어와 번역)의 대규모 창작 규칙과 독립적인 B(상대 기술과 팀 전술 대응 × 의례와 호혜 관계)의 세부 사건 규칙, C(메인 탐험 × 보조 대전 슈팅 액션; 역사적 세력 균형·희극의 오해와 엇갈림 반작용), @(문화·언어와 번역의 경로 해독: B에서 비용이 다른 대응을 선택한 뒤 WorldAccessState에 새 접근 조건을 반영한다. 실패하면 원래 RouteState를 유지한다.)를 연결한 결과로 결정된다. A→B→A의 입력·행동·상태 변화가 실제 목표를 만든다. 플레이어는 선택한 목표를 향해 A→B→A와 @의 발견 조건을 실행한다. 이 선택이 다음 세계 접근 조건과 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독 복합장르. A와 B의 인과 변화, C의 주·보조 장르, @(문화·언어와 번역의 경로 해독) 발견에서 MAIN이 최종 확정된다. A(미지 공간과 지도 정보 수집)·B(상대 기술과 팀 전술 대응)가 인과 상태를 교환하고 C(탐험×대전 슈팅 액션)가 목표와 대응법을 바꾸며 @(문화·언어와 번역의 경로 해독)의 발견 결과가 다음 행동을 여는 복합 장르다.의 경험을 만든다.\",\"result\":\"RouteState·WorldAccessState를 출력한다. 미지 공간과 지도 정보 수집 × 문화·언어와 번역이 RouteState를 읽고 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 문화·언어와 번역의 경로 해독이 RouteState를 읽고 A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 조건 미충족·취소 시 기존 상태를 유지하고 다른 선택을 고른다.\",\"linkedElements\":[\"MAIN\"],\"ruleIds\":[\"VIBE_MAIN\"],\"regionIds\":[\"VIBE_ORIGIN\",\"VIBE_REVISIT\"]},{\"element\":\"A\",\"who\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 탐사자이자 인과 선택의 책임자\",\"when\":\"RouteState·RiskState 입력이 확정되고 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.의 선행 조건을 만족할 때.\",\"where\":\"문화·언어와 번역의 첫 선택 공간: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.를 시작하는 출발 위치와 복귀 동선을 제공한다.\",\"what\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역에 문화·언어와 번역 소재를 결합한다. 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.\",\"how\":\"입력과 판정: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 공간과 지도 정보 수집 실행 조건을 판정하고, 언어 단서를 해석하면 거래·동맹·임무의 접근 조건이 달라진다. 결과로 RiskState·ResourceState를 갱신해 B와 세계의 다음 선택을 바꾼다. 조건 미충족·취소 시 이전 상태를 보존한다.\",\"why\":\"A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 공간과 지도 정보 수집 실행 조건을 판정하고, 언어 단서를 해석하면 거래·동맹·임무의 접근 조건이 달라진다. 결과로 RiskState·ResourceState를 갱신해 B와 세계의 다음 선택을 바꾼다. 조건 미충족·취소 시 이전 상태를 보존한다. A의 결정을 다음 B의 조건으로 전달하는 이유: 미지 공간과 지도 정보 수집 성공으로 RiskState·ResourceState가 바뀐 때만 B의 상대 기술과 팀 전술 대응 대응이 열리고, 실패 시 기존 값과 이전 선택을 보존한다.\",\"result\":\"RiskState·ResourceState를 출력한다. 상대 기술과 팀 전술 대응 × 의례와 호혜 관계이 RiskState·ResourceState를 읽고 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 문화·언어와 번역의 경로 해독이 RiskState를 읽고 A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 조건 미충족·취소 시 기존 상태를 유지하고 다른 선택을 고른다.\",\"linkedElements\":[\"A\",\"B\"],\"ruleIds\":[\"VIBE_A\",\"VIBE_B\"],\"regionIds\":[\"VIBE_ORIGIN\"]},{\"element\":\"B\",\"who\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 탐사자이자 인과 선택의 책임자\",\"when\":\"RiskState·ResourceState 입력이 확정되고 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.의 선행 조건을 만족할 때.\",\"where\":\"의례와 호혜 관계의 되돌림 공간: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.의 결과가 이전 구역의 통로를 열거나 닫는다.\",\"what\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계에 의례와 호혜 관계 소재를 결합한다. 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.\",\"how\":\"입력과 판정: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. B는 A의 하위 주제가 아니라 의례와 호혜 관계에서 독자적으로 만든 세부 사건·대상 규칙이다. 독립적으로 정한 상대 기술과 팀 전술 대응 행동은 A가 출력한 RiskState·ResourceState를 조건으로 읽는다. 자원 소비·행동 규칙·환경 반응이 계약처럼 서로 대가를 요구한다. 대응 성공 시 RouteState·RiskState를 A로 돌려보내 세계 규칙까지 바꾼다. 조건 미충족 시 상태를 보존한다.\",\"why\":\"B는 A의 하위 주제가 아니라 의례와 호혜 관계에서 독자적으로 만든 세부 사건·대상 규칙이다. 독립적으로 정한 상대 기술과 팀 전술 대응 행동은 A가 출력한 RiskState·ResourceState를 조건으로 읽는다. 자원 소비·행동 규칙·환경 반응이 계약처럼 서로 대가를 요구한다. 대응 성공 시 RouteState·RiskState를 A로 돌려보내 세계 규칙까지 바꾼다. 조건 미충족 시 상태를 보존한다. B의 결정을 다음 A의 조건으로 전달하는 이유: B의 상대 기술과 팀 전술 대응 성공 결과인 RouteState·RiskState에 따라 A의 미지 공간과 지도 정보 수집 재진입 경로와 위험·선택 비용이 달라진다. 불가능한 선택은 이전 상태로 복구한다.\",\"result\":\"RouteState·RiskState를 출력한다. 미지 공간과 지도 정보 수집 × 문화·언어와 번역이 RouteState·RiskState를 읽고 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 문화·언어와 번역의 경로 해독이 RouteState·RiskState를 읽고 A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 조건 미충족·취소 시 기존 상태를 유지하고 다른 선택을 고른다.\",\"linkedElements\":[\"B\",\"A\"],\"ruleIds\":[\"VIBE_B\",\"VIBE_A\"],\"regionIds\":[\"VIBE_REVISIT\"]},{\"element\":\"C\",\"who\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 탐사자이자 인과 선택의 책임자\",\"when\":\"A의 선택 결과를 B가 읽거나 B의 결과가 A로 돌아올 때: 탐험 목표를 해결하려면 A의 ResourceState 확보와 B의 RouteState 변경을 반복한다. 대전 슈팅 액션 판단에서는 역사적 세력 균형의 단서를 먼저 해석하거나 희극의 오해와 엇갈림의 반작용을 감수해야 B의 대응·A의 재진입 중 하나가 가능하다. 보조 장르를 제거하면 실제 접근 조건이 달라진다.\",\"where\":\"문화·언어와 번역의 첫 선택 공간 및 의례와 호혜 관계의 되돌림 공간에서 같은 선택의 세계 반응을 비교한다.\",\"what\":\"C는 메인 장르 탐험 × 보조 장르 대전 슈팅 액션의 융합이다. 보조 소재 역사적 세력 균형· 희극의 오해와 엇갈림가 실제 판단 조건을 바꾼다. A의 RiskState·ResourceState가 B의 의례와 호혜 관계 판정을 바꾸고 B의 RouteState·RiskState가 MAIN의 WorldAccessState를 거쳐 다시 A의 접근 조건이 된다. 역사적 세력 균형와 희극의 오해와 엇갈림가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. A에서 미지 공간과 지도 정보 수집를 선택해 RiskState·ResourceState를 바꾸고, 그 값을 읽는 B의 상대 기술과 팀 전술 대응 대응을 실행한다. B의 RouteState·RiskState 출력은 다시 A의 접근 가능성과 다음 선택을 바꾼다. 실패 시 마지막 유효 상태로 돌아가 대안을 고른다.\",\"how\":\"탐험: A(미지 공간과 지도 정보 수집)와 B(상대 기술과 팀 전술 대응)의 왕복 선택으로 중심 목표와 위험·보상을 판정한다. 대전 슈팅 액션: 역사적 세력 균형의 단서와 희극의 오해와 엇갈림의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다. 역사적 세력 균형: 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 이 단서의 확인 여부가 A의 RiskState와 B의 ResourceState 사용 조건을 바꾼다. 희극의 오해와 엇갈림: 틀린 믿음·잘못 전달된 정보가 실제 목표·동선·관계 상태를 바꾼다. B의 RouteState 해금과 A의 재진입 조건을 바꾸며 대가를 선택하게 한다.\",\"why\":\"탐험 목표를 해결하려면 A의 ResourceState 확보와 B의 RouteState 변경을 반복한다. 대전 슈팅 액션 판단에서는 역사적 세력 균형의 단서를 먼저 해석하거나 희극의 오해와 엇갈림의 반작용을 감수해야 B의 대응·A의 재진입 중 하나가 가능하다. 보조 장르를 제거하면 실제 접근 조건이 달라진다. 인물은 플레이어의 이전 선택을 기억하고 신뢰·거래·협력 조건을 변경한다.\",\"result\":\"문화·언어와 번역의 흔적이 남은 지역은 의례와 호혜 관계의 선택에 따라 새로운 출입·보상 조건을 갖는다. 역사적 세력 균형와 희극의 오해와 엇갈림가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. A/B 출력 RiskState·ResourceState·RouteState에 이 반응을 적용한다. 다음 선택: 관계의 갈등이 플레이어의 실제 선택을 통해 해결되거나 심화되고, 그 결과가 다음 사건의 원인이 된다. 다음 사건은 직전 세계·관계 상태를 읽고 발생한다. 조건 미충족·취소 시 세계 상태를 유지하고 다른 접근을 고른다.\",\"linkedElements\":[\"A\",\"B\",\"C\"],\"ruleIds\":[\"VIBE_A\",\"VIBE_B\"],\"regionIds\":[\"VIBE_ORIGIN\",\"VIBE_REVISIT\"]},{\"element\":\"DELVE\",\"who\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 탐사자이자 인과 선택의 책임자\",\"discoveryIndex\":0,\"when\":\"발견 조건: 문화·언어와 번역의 경로 해독: A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다.\",\"where\":\"문화·언어와 번역의 첫 선택 공간에서 단서를 관찰하고 의례와 호혜 관계의 되돌림 공간의 반응과 비교한다.\",\"what\":\"문화·언어와 번역의 경로 해독: 같은 표현도 문화적 맥락이 달라지면 의미와 반응이 달라질 수 있다. 원리를 A의 선택과 B의 결과를 비교해 발견한다.\",\"how\":\"단서 관찰: 문화·언어와 번역의 경로 해독: A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 비교 실험: 문화·언어와 번역의 경로 해독: B에서 비용이 다른 대응을 선택한 뒤 WorldAccessState에 새 접근 조건을 반영한다. 실패하면 원래 RouteState를 유지한다.\",\"why\":\"학습할 인과: 문화·언어와 번역의 경로 해독: 같은 표현도 문화적 맥락이 달라지면 의미와 반응이 달라질 수 있다. 원리를 A의 선택과 B의 결과를 비교해 발견한다. A·B·C를 함께 바꾸어야 이 해결법을 확인할 수 있다.\",\"result\":\"열리는 선택: 문화·언어와 번역의 경로 해독: B에서 비용이 다른 대응을 선택한 뒤 WorldAccessState에 새 접근 조건을 반영한다. 실패하면 원래 RouteState를 유지한다. 발견 조건을 만족하지 못하면 원래 경로를 유지하고 단서를 다시 비교한다.\",\"linkedElements\":[\"A\",\"B\",\"C\"],\"ruleIds\":[\"VIBE_DELVE\",\"VIBE_A\",\"VIBE_B\"],\"regionIds\":[\"VIBE_ORIGIN\",\"VIBE_REVISIT\"]},{\"element\":\"DELVE\",\"who\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 탐사자이자 인과 선택의 책임자\",\"discoveryIndex\":1,\"when\":\"발견 조건: 의례와 호혜 관계의 귀환 흔적: B가 RouteState·RiskState를 갱신한 뒤 A의 이전 진입 장소를 다시 방문해 차이를 확인한다.\",\"where\":\"의례와 호혜 관계의 되돌림 공간에서 단서를 관찰하고 문화·언어와 번역의 첫 선택 공간의 반응과 비교한다.\",\"what\":\"의례와 호혜 관계의 귀환 흔적: 의례는 보상이 아니라 인간과 세계 사이의 상호 의무를 갱신한다. 원리 때문에 같은 A 행동도 재방문에서는 다른 조건으로 판정됨을 발견한다.\",\"how\":\"단서 관찰: 의례와 호혜 관계의 귀환 흔적: B가 RouteState·RiskState를 갱신한 뒤 A의 이전 진입 장소를 다시 방문해 차이를 확인한다. 비교 실험: 의례와 호혜 관계의 귀환 흔적: 다음 A에서 위험을 낮추는 우회 RouteState 또는 정보 회복을 선택한다. 재방문 전에는 해금하지 않는다.\",\"why\":\"학습할 인과: 의례와 호혜 관계의 귀환 흔적: 의례는 보상이 아니라 인간과 세계 사이의 상호 의무를 갱신한다. 원리 때문에 같은 A 행동도 재방문에서는 다른 조건으로 판정됨을 발견한다. MAIN·A·B를 함께 바꾸어야 이 해결법을 확인할 수 있다.\",\"result\":\"열리는 선택: 의례와 호혜 관계의 귀환 흔적: 다음 A에서 위험을 낮추는 우회 RouteState 또는 정보 회복을 선택한다. 재방문 전에는 해금하지 않는다. 발견 조건을 만족하지 못하면 원래 경로를 유지하고 단서를 다시 비교한다.\",\"linkedElements\":[\"MAIN\",\"A\",\"B\"],\"ruleIds\":[\"VIBE_DELVE\",\"VIBE_MAIN\",\"VIBE_A\",\"VIBE_B\"],\"regionIds\":[\"VIBE_ORIGIN\",\"VIBE_REVISIT\"]},{\"element\":\"DELVE\",\"who\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 탐사자이자 인과 선택의 책임자\",\"discoveryIndex\":2,\"when\":\"발견 조건: 역사적 세력 균형·오해와 엇갈림의 이중 단서: C의 두 소재가 각각 A의 RiskState와 B의 ResourceState를 바꾸는 사례를 관찰한 뒤 순서를 비교한다.\",\"where\":\"문화·언어와 번역의 첫 선택 공간에서 단서를 관찰하고 의례와 호혜 관계의 되돌림 공간의 반응과 비교한다.\",\"what\":\"역사적 세력 균형·오해와 엇갈림의 이중 단서: 한 세력의 완전한 승리가 오히려 더 큰 불균형과 반발을 만든다. / 서로 다른 정보와 오해가 연쇄적으로 현실의 결과를 만든다. 두 원리가 결합될 때 대전 슈팅 액션의 해석이 다음 행동 허용 여부를 바꾼다.\",\"how\":\"단서 관찰: 역사적 세력 균형·오해와 엇갈림의 이중 단서: C의 두 소재가 각각 A의 RiskState와 B의 ResourceState를 바꾸는 사례를 관찰한 뒤 순서를 비교한다. 비교 실험: 역사적 세력 균형·오해와 엇갈림의 이중 단서: 단서 해석을 선택해 IntentState를 갱신하고 B의 다른 대응을 연다. 조건 미달이면 기존 행동을 유지한다.\",\"why\":\"학습할 인과: 역사적 세력 균형·오해와 엇갈림의 이중 단서: 한 세력의 완전한 승리가 오히려 더 큰 불균형과 반발을 만든다. / 서로 다른 정보와 오해가 연쇄적으로 현실의 결과를 만든다. 두 원리가 결합될 때 대전 슈팅 액션의 해석이 다음 행동 허용 여부를 바꾼다. B·C·MAIN를 함께 바꾸어야 이 해결법을 확인할 수 있다.\",\"result\":\"열리는 선택: 역사적 세력 균형·오해와 엇갈림의 이중 단서: 단서 해석을 선택해 IntentState를 갱신하고 B의 다른 대응을 연다. 조건 미달이면 기존 행동을 유지한다. 발견 조건을 만족하지 못하면 원래 경로를 유지하고 단서를 다시 비교한다.\",\"linkedElements\":[\"B\",\"C\",\"MAIN\"],\"ruleIds\":[\"VIBE_DELVE\",\"VIBE_B\",\"VIBE_A\",\"VIBE_MAIN\"],\"regionIds\":[\"VIBE_ORIGIN\",\"VIBE_REVISIT\"]},{\"element\":\"DELVE\",\"who\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 탐사자이자 인과 선택의 책임자\",\"discoveryIndex\":3,\"when\":\"발견 조건: 미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: A의 위험 선택을 바꾼 두 결과에 동일한 B 대응을 적용해 RouteState·RiskState를 비교한다.\",\"where\":\"의례와 호혜 관계의 되돌림 공간에서 단서를 관찰하고 문화·언어와 번역의 첫 선택 공간의 반응과 비교한다.\",\"what\":\"미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: 문화·언어와 번역의 불리한 결과가 의례와 호혜 관계의 다른 조건에서는 유리해지는 실제 인과를 발견한다.\",\"how\":\"단서 관찰: 미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: A의 위험 선택을 바꾼 두 결과에 동일한 B 대응을 적용해 RouteState·RiskState를 비교한다. 비교 실험: 미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: A로 재진입할 때 WorldAccessState에 반대 경로를 기록해 다른 해결을 선택한다. 실패한 시도는 기존 상태를 보존한다.\",\"why\":\"학습할 인과: 미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: 문화·언어와 번역의 불리한 결과가 의례와 호혜 관계의 다른 조건에서는 유리해지는 실제 인과를 발견한다. A·B·MAIN를 함께 바꾸어야 이 해결법을 확인할 수 있다.\",\"result\":\"열리는 선택: 미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: A로 재진입할 때 WorldAccessState에 반대 경로를 기록해 다른 해결을 선택한다. 실패한 시도는 기존 상태를 보존한다. 발견 조건을 만족하지 못하면 원래 경로를 유지하고 단서를 다시 비교한다.\",\"linkedElements\":[\"A\",\"B\",\"MAIN\"],\"ruleIds\":[\"VIBE_DELVE\",\"VIBE_A\",\"VIBE_B\",\"VIBE_MAIN\"],\"regionIds\":[\"VIBE_ORIGIN\",\"VIBE_REVISIT\"]}]},\"coreFun\":\"미지 공간과 지도 정보 수집의 결과를 상대 기술과 팀 전술 대응로 전환하고 달라진 조건을 다시 활용한다. A(미지 공간과 지도 정보 수집)는 RouteState·RiskState를 읽어 실행 여부를 판정하고 ResourceState를 B에 보낸다. B(상대 기술과 팀 전술 대응)는 RiskState·ResourceState를 읽어 행동을 선택하고 RouteState·RiskState를 A에 반환한다. 실패나 취소 때는 상태를 보존하고 다른 선택을 한다. 탐험 목표를 해결하려면 A의 ResourceState 확보와 B의 RouteState 변경을 반복한다. 대전 슈팅 액션 판단에서는 역사적 세력 균형의 단서를 먼저 해석하거나 희극의 오해와 엇갈림의 반작용을 감수해야 B의 대응·A의 재진입 중 하나가 가능하다. 보조 장르를 제거하면 실제 접근 조건이 달라진다.\",\"coreLoop\":[\"A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다.\",\"B 대응: A의 ResourceState·RiskState를 확인한 뒤 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 성공하면 RouteState·RiskState를 갱신하고 불가능하면 소비 없이 다시 선택한다.\",\"A 재진입: B가 갱신한 RouteState와 이전 경로를 비교해 미지 공간과 지도 정보 수집의 새 선택을 실행하거나 @ 발견 조건을 시험한다.\"],\"signatureSystems\":[{\"id\":\"VIBE_MAIN\",\"grammarRole\":\"MAIN\",\"name\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독\",\"purpose\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독. MAIN은 A(미지 공간과 지도 정보 수집 × 문화·언어와 번역)의 대규모 창작 규칙과 독립적인 B(상대 기술과 팀 전술 대응 × 의례와 호혜 관계)의 세부 사건 규칙, C(메인 탐험 × 보조 대전 슈팅 액션; 역사적 세력 균형·희극의 오해와 엇갈림 반작용), @(문화·언어와 번역의 경로 해독: B에서 비용이 다른 대응을 선택한 뒤 WorldAccessState에 새 접근 조건을 반영한다. 실패하면 원래 RouteState를 유지한다.)를 연결한 결과로 결정된다. A→B→A의 입력·행동·상태 변화가 실제 목표를 만든다. 플레이어는 선택한 목표를 향해 A→B→A와 @의 발견 조건을 실행한다. WorldAccessState·IntentSt\",\"playerChoice\":\"A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. 이후 다음 행동의 위험과 보상을 직접 선택한다.\",\"stateInputs\":[\"WorldAccessState\",\"IntentState\"],\"stateOutputs\":[\"RouteState\",\"WorldAccessState\"]},{\"id\":\"VIBE_A\",\"grammarRole\":\"A\",\"name\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역\",\"purpose\":\"A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 공간과 지도 정보 수집 실행 조건을 판정하고, 언어 단서를 해석하면 거래·동맹·임무의 접근 조건이 달라진다. 결과로 RiskState·ResourceState를 갱신해 B와 세계의 다음 선택을 바꾼다. 조건 미충족·취소 시 이전 상태를 보존한다.\",\"playerChoice\":\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.\",\"stateInputs\":[\"RouteState\",\"RiskState\"],\"stateOutputs\":[\"RiskState\",\"ResourceState\"]},{\"id\":\"VIBE_B\",\"grammarRole\":\"B\",\"name\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계\",\"purpose\":\"B는 A의 하위 주제가 아니라 의례와 호혜 관계에서 독자적으로 만든 세부 사건·대상 규칙이다. 독립적으로 정한 상대 기술과 팀 전술 대응 행동은 A가 출력한 RiskState·ResourceState를 조건으로 읽는다. 자원 소비·행동 규칙·환경 반응이 계약처럼 서로 대가를 요구한다. 대응 성공 시 RouteState·RiskState를 A로 돌려보내 세계 규칙까지 바꾼다. 조건 미충족 시 상태를 보존한다.\",\"playerChoice\":\"행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.\",\"stateInputs\":[\"RiskState\",\"ResourceState\"],\"stateOutputs\":[\"RouteState\",\"RiskState\"]},{\"id\":\"VIBE_DELVE\",\"grammarRole\":\"DELVE\",\"name\":\"문화·언어와 번역의 경로 해독\",\"purpose\":\"같은 표현도 문화적 맥락이 달라지면 의미와 반응이 달라질 수 있다. 원리를 A의 선택과 B의 결과를 비교해 발견한다. 숨겨진 조건을 실험한 뒤 새로운 선택과 경로를 연다.\",\"playerChoice\":\"A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다.\",\"stateInputs\":[\"RouteState\",\"RiskState\"],\"stateOutputs\":[\"WorldAccessState\",\"IntentState\"]}],\"systemInterconnections\":[{\"fromId\":\"VIBE_MAIN\",\"toId\":\"VIBE_A\",\"stateKeys\":[\"RouteState\"],\"fromSystem\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독\",\"toSystem\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역\",\"trigger\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 선택: A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 기존 선행조건을 만족해 RouteState 출력이 확정됐을 때 미지 공간과 지도 정보 수집 × 문화·언어와 번역이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_MAIN 출력 RouteState → VIBE_A 입력. 후속 선택: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_A\",\"toId\":\"VIBE_B\",\"stateKeys\":[\"RiskState\",\"ResourceState\"],\"fromSystem\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역\",\"toSystem\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계\",\"trigger\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역의 선택: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 기존 선행조건을 만족해 RiskState·ResourceState 출력이 확정됐을 때 상대 기술과 팀 전술 대응 × 의례와 호혜 관계이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_A 출력 RiskState·ResourceState → VIBE_B 입력. 후속 선택: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_B\",\"toId\":\"VIBE_A\",\"stateKeys\":[\"RouteState\",\"RiskState\"],\"fromSystem\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계\",\"toSystem\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역\",\"trigger\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 선택: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 기존 선행조건을 만족해 RouteState·RiskState 출력이 확정됐을 때 미지 공간과 지도 정보 수집 × 문화·언어와 번역이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_B 출력 RouteState·RiskState → VIBE_A 입력. 후속 선택: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_B\",\"toId\":\"VIBE_DELVE\",\"stateKeys\":[\"RouteState\",\"RiskState\"],\"fromSystem\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계\",\"toSystem\":\"문화·언어와 번역의 경로 해독\",\"trigger\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 선택: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 기존 선행조건을 만족해 RouteState·RiskState 출력이 확정됐을 때 문화·언어와 번역의 경로 해독이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_B 출력 RouteState·RiskState → VIBE_DELVE 입력. 후속 선택: A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_DELVE\",\"toId\":\"VIBE_MAIN\",\"stateKeys\":[\"WorldAccessState\",\"IntentState\"],\"fromSystem\":\"문화·언어와 번역의 경로 해독\",\"toSystem\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독\",\"trigger\":\"문화·언어와 번역의 경로 해독의 선택: A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 기존 선행조건을 만족해 WorldAccessState·IntentState 출력이 확정됐을 때 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_DELVE 출력 WorldAccessState·IntentState → VIBE_MAIN 입력. 후속 선택: A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_A\",\"toId\":\"VIBE_DELVE\",\"stateKeys\":[\"RiskState\"],\"fromSystem\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역\",\"toSystem\":\"문화·언어와 번역의 경로 해독\",\"trigger\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역의 선택: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 기존 선행조건을 만족해 RiskState 출력이 확정됐을 때 문화·언어와 번역의 경로 해독이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_A 출력 RiskState → VIBE_DELVE 입력. 후속 선택: A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"}],\"progressionDirection\":\"성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 미지 공간과 지도 정보 수집의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 상대 기술과 팀 전술 대응의 새 상대는 기존 상태를 증폭하거나 반전한다.\",\"progressionEconomyBalance\":{\"progressionLoop\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역의 변화가 상대 기술과 팀 전술 대응 × 의례와 호혜 관계에서 새로운 선택을 열고 다음 A의 경로에 영향을 준다.\",\"resourceFlow\":\"현재 게임의 실제 획득원과 소비처를 소스에 연결한 후 선택 비용을 검증한다. 임의 보상이나 저장값을 추가하지 않는다.\",\"balanceRules\":\"한쪽 선택이 언제나 이득이 되지 않도록 위험·정보·기회비용을 함께 비교하고 기존 원본 수치는 바꾸지 않는다.\"},\"contentExpansionPlan\":[{\"milestone\":\"초반 선택에 따른 접근 경로와 위험 재구성\",\"newGameplay\":\"미지 공간과 지도 정보 수집의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.\",\"systemImpact\":\"VIBE_A의 기존 Luau 책임 함수에서 RouteState·RiskState 입력 → RiskState·ResourceState 출력 → VIBE_B의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.\",\"trigger\":\"기존 첫 진입 조건을 만족하고 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 목표를 확인한 뒤 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 접근 가능한 선택을 제시한다.\",\"playerChoice\":\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.\",\"ruleIds\":[\"VIBE_MAIN\",\"VIBE_A\",\"VIBE_B\"],\"stateKeys\":[\"RouteState\",\"RiskState\",\"ResourceState\"],\"failureRecovery\":\"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.\",\"validationEvidence\":\"동일 시작 상태에서 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다.\"},{\"milestone\":\"중반 두 시스템의 반작용과 대응 조건 충돌\",\"newGameplay\":\"상대 기술과 팀 전술 대응의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.\",\"systemImpact\":\"VIBE_B의 기존 Luau 책임 함수에서 RiskState·ResourceState 입력 → RouteState·RiskState 출력 → VIBE_A의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.\",\"trigger\":\"직전 확장 단계의 행동 결과가 현재 RiskState·ResourceState와 일치할 때 후속 선택을 연다. 기존 해금 조건을 확인하며 임의 수치를 추가하지 않는다.\",\"playerChoice\":\"행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.\",\"ruleIds\":[\"VIBE_MAIN\",\"VIBE_A\",\"VIBE_B\"],\"stateKeys\":[\"RiskState\",\"ResourceState\",\"RouteState\"],\"failureRecovery\":\"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.\",\"validationEvidence\":\"동일 시작 상태에서 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다.\"},{\"milestone\":\"숨겨진 세계 인과법칙을 이용한 새로운 접근\",\"newGameplay\":\"역사적 세력 균형과 희극의 오해와 엇갈림의 조합에 다른 인간 갈등을 연결한다. 숨겨진 규칙의 발견으로 우회 접근과 새로운 대응법을 연다.\",\"systemImpact\":\"VIBE_A의 기존 Luau 책임 함수에서 RouteState·RiskState 입력 → RiskState·ResourceState 출력 → VIBE_B의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.\",\"trigger\":\"직전 확장 단계의 행동 결과가 현재 RouteState·RiskState와 일치할 때 후속 선택을 연다. 기존 해금 조건을 확인하며 임의 수치를 추가하지 않는다.\",\"playerChoice\":\"A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다.\",\"ruleIds\":[\"VIBE_MAIN\",\"VIBE_A\",\"VIBE_B\",\"VIBE_DELVE\"],\"stateKeys\":[\"RouteState\",\"RiskState\",\"ResourceState\"],\"failureRecovery\":\"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.\",\"validationEvidence\":\"동일 시작 상태에서 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다.\"},{\"milestone\":\"누적된 관계를 되짚는 재방문과 장기 숙련\",\"newGameplay\":\"@의 각 발견 결과에서 다음 A→B→A 조건과 C의 새 해석을 파생한다. 동일 상태값이나 번호만 바꾼 발견은 제외하고 기존 숙련과 다음 숙련의 새 행동·판정·결과를 확인해 상한 없이 이어 간다. 재방문 시 이전 행동이 만든 관계·접근 조건과 결말을 다시 평가한다.\",\"systemImpact\":\"VIBE_B의 기존 Luau 책임 함수에서 RiskState·ResourceState 입력 → RouteState·RiskState 출력 → VIBE_A의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.\",\"trigger\":\"직전 확장 단계의 행동 결과가 현재 RiskState·ResourceState와 일치할 때 후속 선택을 연다. 기존 해금 조건을 확인하며 임의 수치를 추가하지 않는다.\",\"playerChoice\":\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.와 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.를 이전 결과와 비교해 재방문 경로를 고른다.\",\"ruleIds\":[\"VIBE_MAIN\",\"VIBE_A\",\"VIBE_B\",\"VIBE_DELVE\"],\"stateKeys\":[\"RiskState\",\"ResourceState\",\"RouteState\"],\"failureRecovery\":\"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.\",\"validationEvidence\":\"동일 시작 상태에서 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다.\"}],\"failureRetryRisk\":{\"failureStates\":[\"미지 공간과 지도 정보 수집 × 문화·언어와 번역의 위험을 읽지 못해 유효 행동과 진입 경로가 막힌다.\",\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 반작용을 잘못 선택해 목표 접근 조건이 사라진다.\"],\"retryFlow\":\"직전 유효 목표 상태를 다시 확인하고 얻은 정보를 이용해 다른 경로·시스템 선택으로 재시도한다. 기존 저장 정책을 보존한다.\",\"riskPressure\":\"초반에는 A의 선택 위험을, 중반에는 B의 반작용을, 후반에는 C 장르의 정보·관계 제약을 함께 판단하게 한다.\",\"recoveryRules\":\"진행이 막히면 이전 안전 구역과 재선택 가능한 행동을 제공하며 저장·보상 손실 수치는 원본 규칙만 따른다.\"},\"platformFitPlan\":{\"targetPlatform\":\"ROBLOX\",\"inputModel\":\"로블록스 터치 조이스틱·행동 버튼과 키보드·게임패드 입력을 공통 행동에 연결하고 3D 카메라 가림을 검증한다.\",\"performanceBudget\":\"로블록스 서버·클라이언트의 복제·물리·렌더·메모리·화면 내 오브젝트 예산을 모바일 런타임에서 검증한다.\",\"sessionConstraints\":\"첫 행동·시스템 왕복·숙련 발견과 중단 복귀의 실제 소요 시간은 해당 플랫폼 네이티브 런타임에서 측정한다.\"},\"platformProfiles\":{\"ROBLOX\":{\"platform\":\"ROBLOX\",\"inputModel\":\"Roblox keyboard/gamepad plus touch-safe mobile controls using Roblox input and UI conventions.\",\"sessionModel\":\"Roblox social session model: 30분 의미 있는 첫 세션 기준: 0~5분 조작·목표 이해, 5~15분 핵심 루프 반복과 첫 성장/선택, 15~25분 변주·난이도·스토리 또는 전략 변화, 25~30분 중간목표·보상·다음 플레이 동기. 단순 체력/대기/반복으로 시간만 늘리는 것은 금지한다.; fast join/rejoin and avatar-safe spawn flow for 기존 원본과 사용자 요청의 대상 플레이어.\",\"multiplayerRuntime\":\"Roblox server-authoritative COOP replication with join/leave sync and RemoteEvent validation.\",\"performanceBudget\":\"Roblox mobile-first budget with bounded parts, draw calls, effects, replication traffic, memory and streaming distance.\",\"uiUx\":\"Roblox ScreenGui/CoreGui-safe layout with mobile safe zones, readable touch actions, social/player-list compatibility.\",\"saveAndNetwork\":\"Luau 서버가 판정·보상·진행·저장을 소유하고 RemoteEvent 입력을 검증한다. 기존 DataStore 키와 저장 구조 및 멀티 권한을 보존한다.\",\"platformContentAdaptation\":\"게임 원본은 roblox-games/cozy-island/의 Luau다. 설계 문법의 상태 입출력·시스템 연결·콘텐츠를 기존 서버·공유·클라이언트 함수에 직접 구현한다. C# 변환 결과를 원본으로 사용하지 않는다.\",\"internalReleaseTarget\":\"Private or restricted Roblox experience that the owner/testers can launch in the Roblox app before public release.\",\"validationEvidence\":\"설계 문법별 책임 함수·실제 상태 변경·콘텐츠 소스 차이를 연결해 기존 F0~F9 및 Roblox 클라우드 API 런타임에서 검증한다. 정적 검사와 실제 실행 증거를 구분한다.\"},\"UNITY\":{\"platform\":\"UNITY\",\"inputModel\":\"Unity Input System with touch-first controls, safe-area UI, gamepad/keyboard fallback and app lifecycle-safe input recovery.\",\"sessionModel\":\"유니티 네이티브 앱은 현재 오너 보류다. 향후 승인된 앱 개발 시 기존 세션과 중단·복귀 의미를 유지한다.\",\"multiplayerRuntime\":\"Unity app COOP networking using validated transport/session ownership, reconnect and join/leave synchronization.\",\"performanceBudget\":\"Android mobile budget covering memory, GPU, thermal load, battery, loading, texture/compression, pooling and GC pressure.\",\"uiUx\":\"Responsive Unity UI with device safe areas, touch targets, orientation/readability rules and native-app pause/resume behavior.\",\"saveAndNetwork\":\"Versioned local save plus validated backend/cloud synchronization only when required by the approved multiplayer/persistence design.\",\"platformContentAdaptation\":\"로블록스 원본과 분리된 새로운 게임 규칙은 생성하지 않는다. 유니티 네이티브 앱 적응은 오너 보류 해제 후에만 진행한다.\",\"internalReleaseTarget\":\"유니티 네이티브 앱 제작·내부 배포는 오너 보류다. 유니티 웹 빌드 대상은 제외한다.\",\"validationEvidence\":\"현재 유니티 제작 PASS를 주장하지 않는다. 보류 해제 후 정확한 네이티브 앱 실행·저장·QA 증거를 별도로 검증한다.\"}},\"webCanonicalDesign\":{\"role\":\"SHARED_DESIGN_WEB_APPLICATION\",\"designAuthority\":\"GAME_DESIGN_REFERENCE_NOT_SOURCE_CODE_AUTHORITY\",\"playerFlow\":[\"A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다.\",\"B 대응: A의 ResourceState·RiskState를 확인한 뒤 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 성공하면 RouteState·RiskState를 갱신하고 불가능하면 소비 없이 다시 선택한다.\",\"A 재진입: B가 갱신한 RouteState와 이전 경로를 비교해 미지 공간과 지도 정보 수집의 새 선택을 실행하거나 @ 발견 조건을 시험한다.\",\"성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 미지 공간과 지도 정보 수집의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 상대 기술과 팀 전술 대응의 새 상대는 기존 상태를 증폭하거나 반전한다.\"],\"worldAndTraversal\":\"id: VIBE_ORIGIN; ruleIds: VIBE_MAIN / VIBE_A; name: 문화·언어와 번역의 첫 선택 공간; traversal: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.를 시작하는 출발 위치와 복귀 동선을 제공한다.; riskReward: 안전한 진행을 선택하면 발견 속도가 늦어지고 어려운 경로에서는 다른 단서를 얻는다.; landmark: 문화·언어와 번역의 변화가 드러나는 고유 랜드마크를 첫 진입 때 표시한다.; encounterPattern: A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 공간과 지도 정보 수집 실행 조건을 판정하고, 언어 단서를 해석하면 거래·동맹·임무의 접근 조건이 달라진다. 결과로 RiskState·ResourceState를 갱신해 B와 세계의 다음 선택을 바꾼다. 조건 미충족·취소 시 이전 상태를 보존한다. 결과를 읽고 위험·정보 반응이 변화한다.; resourcePressure: 선택 결과에 따른 자원 접근 가능성과 기회비용을 분리해 보여준다.; storyContext: 문화·언어와 번역의 흔적이 남은 지역은 의례와 호혜 관계의 선택에 따라 새로운 출입·보상 조건을 갖는다. / id: VIBE_REVISIT; ruleIds: VIBE_B / VIBE_DELVE; name: 의례와 호혜 관계의 되돌림 공간; traversal: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.의 결과가 이전 \",\"systemsAndContent\":\"id: VIBE_MAIN; grammarRole: MAIN; name: 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독; purpose: 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독. MAIN은 A(미지 공간과 지도 정보 수집 × 문화·언어와 번역)의 대규모 창작 규칙과 독립적인 B(상대 기술과 팀 전술 대응 × 의례와 호혜 관계)의 세부 사건 규칙, C(메인 탐험 × 보조 대전 슈팅 액션; 역사적 세력 균형·희극의 오해와 엇갈림 반작용), @(문화·언어와 번역의 경로 해독: B에서 비용이 다른 대응을 선택한 뒤 WorldAccessState에 새 접근 조건을 반영한다. 실패하면 원래 RouteState를 유지한다.)를 연결한 결과로 결정된다. A→B→A의 입력·행동·상태 변화가 실제 목표를 만든다. 플레이어는 선택한 목표를 향해 A→B→A와 @의 발견 조건을 실행한다. WorldAccessState·IntentSt; playerChoice: A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. 이후 다음 행동의 위험과 보상을 직접 선택한다.; stateInputs: WorldAccessState / IntentState; stateOutputs: RouteState / WorldAccessState / id: VIBE_A; grammarRole: A; name: 미지 공간과 지도 정보 수집 × 문화·언어와 번역; purpose: A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 \",\"combatAndInteraction\":\"id: VIBE_CHOOSE; name: 첫 시스템의 경로 선택; kind: INTERACTION; ownerId: PLAYER; ruleId: VIBE_A; trigger: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 실행 전에 접근 가능성과 비용을 확인한다.; range: 0; rangeUnit: 선택 입력; resource: 행동 기회; cost: 0; cooldownSeconds: 0; telegraph: 선택지의 변화 조건과 현재 위험을 화면에 알린다.; avoidance: 다른 경로를 선택하거나 실행하지 않고 되돌아간다.; effect: 선택 경로와 반응 위험을 계획 상태에 반영한다.; stateInputs: RouteState; stateOutputs: RiskState; source: 시드 인과문법 A의 설계 계약 (실제 구현 전); rangeKey: ; costKey: ; cooldownKey: / id: VIBE_RESPOND; name: 두 번째 시스템의 대응 선택; kind: INTERACTION; ownerId: PLAYER; ruleId: VIBE_B; trigger: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 실행 전에 A의 이전 결과를 읽는다.; range: 0; rangeUnit: 선택 입력; resource: 행동 기회; cost: 0; cooldownSeconds: 0; telegraph: 상대의 다음 반응과 예상되는 선택 비용을 알린다.; avoidance: 대응을 취소\",\"progressionAndEconomy\":\"progressionLoop: 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 변화가 상대 기술과 팀 전술 대응 × 의례와 호혜 관계에서 새로운 선택을 열고 다음 A의 경로에 영향을 준다.; resourceFlow: 현재 게임의 실제 획득원과 소비처를 소스에 연결한 후 선택 비용을 검증한다. 임의 보상이나 저장값을 추가하지 않는다.; balanceRules: 한쪽 선택이 언제나 이득이 되지 않도록 위험·정보·기회비용을 함께 비교하고 기존 원본 수치는 바꾸지 않는다.\",\"sessionFailureRecovery\":\"failureStates: 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 위험을 읽지 못해 유효 행동과 진입 경로가 막힌다. / 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 반작용을 잘못 선택해 목표 접근 조건이 사라진다.; retryFlow: 직전 유효 목표 상태를 다시 확인하고 얻은 정보를 이용해 다른 경로·시스템 선택으로 재시도한다. 기존 저장 정책을 보존한다.; riskPressure: 초반에는 A의 선택 위험을, 중반에는 B의 반작용을, 후반에는 C 장르의 정보·관계 제약을 함께 판단하게 한다.; recoveryRules: 진행이 막히면 이전 안전 구역과 재선택 가능한 행동을 제공하며 저장·보상 손실 수치는 원본 규칙만 따른다.\",\"uiMenuAndOnboarding\":\"hudPriorities: 세계 상태·위험·현재 행동과 되돌릴 수 있는 선택을 플레이 화면에서 먼저 읽게 한다.; touchAndInput: 이동과 행동 동시 입력, 길게 누르기와 중복 터치 방지, 뒤로가기 복구를 분리 검증한다.; readability: 장르별 위험과 사용 가능한 행동을 모양·문장·움직임으로 중복 표시하며 색상만으로 구분하지 않는다.; accessibility: 글자 크기·대비·진동과 소리 설정을 분리하고 실패 원인과 회복 방법을 읽을 수 있게 제공한다.; menuStructure: 타이틀→계속하기 또는 새 게임→본편→장비·지도·설정→실패 복구 또는 결과의 흐름에서 현재 게임에 필요 없는 메뉴는 제외한다.; convenienceDecisions: 같은 선택 반복 시 확인 단계를 줄이되 위험·자원 소모·저장과 관련된 실제 판단은 제거하지 않는다.\",\"inputCameraAccessibility\":\"로블록스 터치 조이스틱·행동 버튼과 키보드·게임패드 입력을 공통 행동에 연결하고 3D 카메라 가림을 검증한다.\",\"presentationAndAudio\":\"visualIdentity: 캐릭터·지역·위험·아이템 표현은 C의 두 소재에 근거한 하나의 3D 스타일로 통일한다.; audioIdentity: 탐색·선택·경고·성공·실패 음악과 효과음을 세계 상태 전이에 맞춰 구분한다.; gameplayFeedbackSync: 실제 게임 판정 이벤트가 확정된 다음 애니메이션·시각효과·오디오·카메라를 동기화해 게임 규칙의 권한을 유지한다.; assetBindings: family: AUDIO; role: AUDIO의 인과 표현 소재; bodyPlan: 플레이 대상의 실제 공간 크기·실루엣·역할을 반영한 3차원 형태; behavior: 미지 공간과 지도 정보 수집 × 문화·언어와 번역와 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 상태 반응에 맞춰 움직임과 상호작용이 달라진다.; presentation: 역사적 세력 균형와 희극의 오해와 엇갈림의 차이를 조명·표면·동작으로 구분한다.; ruleIds: VIBE_MAIN; useLocation: 문화·언어와 번역의 첫 선택 공간에서 세계 반응을 표시한다.; assetId: ; decision: AUTHOR; selectionReason: 확인된 호환 후보가 없으므로 자산 제작 대상이며 재사용과 라이선스 확인이 우선이다.; improvement: 실제 네이티브 형상·리깅·표면·동작의 부조화와 모바일 비용을 비교 검토한다.; platformAdaptation: 로블록스 실행 원본을 우선하고, 유니티 네이티브 앱은 오너 보류 상태의 호환 설계로만 유지한다. 유니티 웹은 제작하지 않는다.; validation: 실제 월드에서 역할 구분과 프레임·모바일 터치 품질을 캡처하고 독립 검증한다. / family: MOTION; role: MOTION의 인과 표현 소재; bodyPlan: 플레이 대상의 실제 공간 크\",\"multiplayerPersistence\":\"COOP; COOP에서 두 이용자가 같은 세계 상태를 읽고 선택 결과를 서버에서 확인하며 이탈·재접속 후 정확히 동기화해야 한다.\",\"expansionSpace\":\"milestone: 초반 선택에 따른 접근 경로와 위험 재구성; newGameplay: 미지 공간과 지도 정보 수집의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.; systemImpact: VIBE_A의 기존 Luau 책임 함수에서 RouteState·RiskState 입력 → RiskState·ResourceState 출력 → VIBE_B의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.; trigger: 기존 첫 진입 조건을 만족하고 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 목표를 확인한 뒤 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 접근 가능한 선택을 제시한다.; playerChoice: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.; ruleIds: VIBE_MAIN / VIBE_A / VIBE_B; stateKeys: RouteState / RiskState / ResourceState; failureRecovery: 조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.; validationEvidence: 동일 시작 상태에서 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다. / milestone: 중반 두 시스템의 반작용\"},\"platformExpansionPolicy\":{\"mode\":\"SINGLE_ORIGINAL_PLATFORM_IMPLEMENTATION\",\"sharedLargeFrame\":[\"CORE_IDENTITY\",\"CORE_FUN_AND_REPRESENTATIVE_LOOP\",\"WORLD_AND_PROGRESSION_DIRECTION\",\"SAVE_PERSISTENCE_MEANING\",\"MULTIPLAYER_INTENT\"],\"expansionLimit\":\"GAMEPLAY_CHANGES_REQUIRE_SHARED_ORIGINAL_REVISION\",\"webRule\":\"웹은 현재 플랫폼 제작 대상이 아니다. 과거 webCanonicalDesign 필드는 기록 호환용 참고 뷰일 뿐, 별도 게임이나 Unity WebGL 빌드를 생성하지 않는다.\",\"unityRule\":\"Unity 네이티브 앱은 오너 보류 상태다. 과거 플랫폼 프로필은 기록 호환을 위해 유지하되 개발·배포·WebGL 빌드는 실행하지 않는다. 보류 해제 후 공통 원본과 규칙을 보존한다.\",\"robloxRule\":\"기존 Roblox 원본의 규칙과 사용자 요청을 공통 원본에 보존한다. platformProfiles.ROBLOX와 robloxBuildProfile은 같은 원본의 구현·배포·검증 방식이며 독립 게임 설계가 아니다. 다른 플랫폼 실패는 해당 플랫폼의 수정·재시도로 분리한다.\"},\"visualDirection\":\"역사적 세력 균형와 희극의 오해와 엇갈림의 법칙을 3차원 공간의 실루엣·재질·광원으로 표현하고 주·보조 장르의 위험 신호를 구분한다.\",\"mobileUx\":\"터치 조이스틱·행동·뒤로가기와 필수 상태를 안전 여백 안에 배치하고 조작·카메라·화면 잘림을 모바일에서 확인한다.\",\"uxAccessibilityPlan\":{\"hudPriorities\":\"세계 상태·위험·현재 행동과 되돌릴 수 있는 선택을 플레이 화면에서 먼저 읽게 한다.\",\"touchAndInput\":\"이동과 행동 동시 입력, 길게 누르기와 중복 터치 방지, 뒤로가기 복구를 분리 검증한다.\",\"readability\":\"장르별 위험과 사용 가능한 행동을 모양·문장·움직임으로 중복 표시하며 색상만으로 구분하지 않는다.\",\"accessibility\":\"글자 크기·대비·진동과 소리 설정을 분리하고 실패 원인과 회복 방법을 읽을 수 있게 제공한다.\",\"menuStructure\":\"타이틀→계속하기 또는 새 게임→본편→장비·지도·설정→실패 복구 또는 결과의 흐름에서 현재 게임에 필요 없는 메뉴는 제외한다.\",\"convenienceDecisions\":\"같은 선택 반복 시 확인 단계를 줄이되 위험·자원 소모·저장과 관련된 실제 판단은 제거하지 않는다.\"},\"artAudioDirection\":{\"visualIdentity\":\"캐릭터·지역·위험·아이템 표현은 C의 두 소재에 근거한 하나의 3D 스타일로 통일한다.\",\"audioIdentity\":\"탐색·선택·경고·성공·실패 음악과 효과음을 세계 상태 전이에 맞춰 구분한다.\",\"gameplayFeedbackSync\":\"실제 게임 판정 이벤트가 확정된 다음 애니메이션·시각효과·오디오·카메라를 동기화해 게임 규칙의 권한을 유지한다.\",\"assetBindings\":[{\"family\":\"AUDIO\",\"role\":\"AUDIO의 인과 표현 소재\",\"bodyPlan\":\"플레이 대상의 실제 공간 크기·실루엣·역할을 반영한 3차원 형태\",\"behavior\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역와 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 상태 반응에 맞춰 움직임과 상호작용이 달라진다.\",\"presentation\":\"역사적 세력 균형와 희극의 오해와 엇갈림의 차이를 조명·표면·동작으로 구분한다.\",\"ruleIds\":[\"VIBE_MAIN\"],\"useLocation\":\"문화·언어와 번역의 첫 선택 공간에서 세계 반응을 표시한다.\",\"assetId\":\"\",\"decision\":\"AUTHOR\",\"selectionReason\":\"확인된 호환 후보가 없으므로 자산 제작 대상이며 재사용과 라이선스 확인이 우선이다.\",\"improvement\":\"실제 네이티브 형상·리깅·표면·동작의 부조화와 모바일 비용을 비교 검토한다.\",\"platformAdaptation\":\"로블록스 실행 원본을 우선하고, 유니티 네이티브 앱은 오너 보류 상태의 호환 설계로만 유지한다. 유니티 웹은 제작하지 않는다.\",\"validation\":\"실제 월드에서 역할 구분과 프레임·모바일 터치 품질을 캡처하고 독립 검증한다.\"},{\"family\":\"MOTION\",\"role\":\"MOTION의 인과 표현 소재\",\"bodyPlan\":\"플레이 대상의 실제 공간 크기·실루엣·역할을 반영한 3차원 형태\",\"behavior\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역와 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 상태 반응에 맞춰 움직임과 상호작용이 달라진다.\",\"presentation\":\"역사적 세력 균형와 희극의 오해와 엇갈림의 차이를 조명·표면·동작으로 구분한다.\",\"ruleIds\":[\"VIBE_A\"],\"useLocation\":\"의례와 호혜 관계의 되돌림 공간에서 세계 반응을 표시한다.\",\"assetId\":\"\",\"decision\":\"AUTHOR\",\"selectionReason\":\"확인된 호환 후보가 없으므로 자산 제작 대상이며 재사용과 라이선스 확인이 우선이다.\",\"improvement\":\"실제 네이티브 형상·리깅·표면·동작의 부조화와 모바일 비용을 비교 검토한다.\",\"platformAdaptation\":\"로블록스 실행 원본을 우선하고, 유니티 네이티브 앱은 오너 보류 상태의 호환 설계로만 유지한다. 유니티 웹은 제작하지 않는다.\",\"validation\":\"실제 월드에서 역할 구분과 프레임·모바일 터치 품질을 캡처하고 독립 검증한다.\"},{\"family\":\"UI\",\"role\":\"UI의 인과 표현 소재\",\"bodyPlan\":\"플레이 대상의 실제 공간 크기·실루엣·역할을 반영한 3차원 형태\",\"behavior\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역와 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 상태 반응에 맞춰 움직임과 상호작용이 달라진다.\",\"presentation\":\"역사적 세력 균형와 희극의 오해와 엇갈림의 차이를 조명·표면·동작으로 구분한다.\",\"ruleIds\":[\"VIBE_B\"],\"useLocation\":\"문화·언어와 번역의 첫 선택 공간에서 세계 반응을 표시한다.\",\"assetId\":\"\",\"decision\":\"AUTHOR\",\"selectionReason\":\"확인된 호환 후보가 없으므로 자산 제작 대상이며 재사용과 라이선스 확인이 우선이다.\",\"improvement\":\"실제 네이티브 형상·리깅·표면·동작의 부조화와 모바일 비용을 비교 검토한다.\",\"platformAdaptation\":\"로블록스 실행 원본을 우선하고, 유니티 네이티브 앱은 오너 보류 상태의 호환 설계로만 유지한다. 유니티 웹은 제작하지 않는다.\",\"validation\":\"실제 월드에서 역할 구분과 프레임·모바일 터치 품질을 캡처하고 독립 검증한다.\"}]},\"selectedDesignPlan\":{\"label\":\"PLAN_A\",\"rationale\":\"첫 공간의 원인을 먼저 읽고 위험을 관찰한 뒤 B의 반작용을 체험하는 경로가 모바일 첫 플레이에 더 명확하다.\",\"identityPreserved\":\"문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독의 대표 목표와 두 인과 소재·세계법칙은 동일하다.\",\"creativeDeviation\":\"두 장르의 정보·위험 상호작용을 기존 A/B 상태 연결에서 직접 확대한다.\",\"genreChange\":false,\"reversibility\":\"새 설계는 후보이며 기존 코드·밸런스·저장은 수정하거나 버리지 않는다.\",\"playthrough\":[{\"phase\":\"OPENING\",\"entryState\":\"시작 위치: 문화·언어와 번역의 첫 선택 공간. 안내: 문화·언어와 번역의 변화가 드러나는 고유 랜드마크를 첫 진입 때 표시한다. 현재 목표와 가능한 첫 행동을 확인한다.\",\"playerChoice\":\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.\",\"actionAndResponse\":\"입력: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 실행 전에 접근 가능성과 비용을 확인한다. 판정: RouteState·RiskState의 기존 접근·비용 조건을 확인한다. 성공: RiskState·ResourceState 출력과 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 다른 경로를 선택하거나 실행하지 않고 되돌아간다. A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 공간과 지도 정보 수집 실행 조건을 판정하고, 언어 단서를 해석하면 거래·동맹·임무의 접근 조건이 달라진다. 결과로 RiskState·ResourceState를 갱신해 B와 세계의 다음 선택을 바꾼다. 조건 미충족·취소 시 이전 상태를 보존한다.\",\"exitState\":\"다음 단계 DEVELOPMENT의 입장 조건과 세계 상태가 결정된다.\",\"nextDecision\":\"DEVELOPMENT에서 변경된 RiskState·ResourceState가 다음 행동의 접근·위험 조건을 바꾸는지 시험한다.\",\"startSeconds\":0,\"endSeconds\":60,\"timeReason\":\"OPENING에서 RouteState·RiskState 입력과 RiskState·ResourceState 출력의 설계 전이를 관찰하는 구간이다. 실제 실행 시간은 미검증이다.\",\"before\":[{\"key\":\"WorldAccessState\",\"value\":0},{\"key\":\"IntentState\",\"value\":0},{\"key\":\"RouteState\",\"value\":0},{\"key\":\"RiskState\",\"value\":0},{\"key\":\"ResourceState\",\"value\":0}],\"after\":[{\"key\":\"WorldAccessState\",\"value\":0},{\"key\":\"IntentState\",\"value\":0},{\"key\":\"RouteState\",\"value\":0},{\"key\":\"RiskState\",\"value\":1},{\"key\":\"ResourceState\",\"value\":1}],\"actions\":[{\"abilityId\":\"VIBE_CHOOSE\",\"actorId\":\"PLAYER\",\"targetId\":\"WORLD\",\"atSeconds\":30,\"distance\":0,\"energyBefore\":10,\"energyAfter\":10,\"hit\":false,\"response\":\"PLAYER가 첫 시스템의 경로 선택을 사용한다. 상대 대응을 관찰하고 확정 타격 없이 다음 선택으로 이어진다. 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 상태 출력 RiskState·ResourceState가 다음 시스템의 선택 조건에 전달된다.\"}],\"ruleIds\":[\"VIBE_A\"],\"outcome\":\"ONGOING\"},{\"phase\":\"DEVELOPMENT\",\"entryState\":\"다음 단계 DEVELOPMENT의 입장 조건과 세계 상태가 결정된다.\",\"playerChoice\":\"행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.\",\"actionAndResponse\":\"입력: 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 실행 전에 A의 이전 결과를 읽는다. 판정: RiskState·ResourceState의 기존 접근·비용 조건을 확인한다. 성공: RouteState·RiskState 출력과 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 대응을 취소하고 이전 안전 단계로 돌아간다. B는 A의 하위 주제가 아니라 의례와 호혜 관계에서 독자적으로 만든 세부 사건·대상 규칙이다. 독립적으로 정한 상대 기술과 팀 전술 대응 행동은 A가 출력한 RiskState·ResourceState를 조건으로 읽는다. 자원 소비·행동 규칙·환경 반응이 계약처럼 서로 대가를 요구한다. 대응 성공 시 RouteState·RiskState를 A로 돌려보내 세계 규칙까지 바꾼다. 조건 미충족 시 상태를 보존한다.\",\"exitState\":\"다음 단계 RESOLUTION의 입장 조건과 세계 상태가 결정된다.\",\"nextDecision\":\"RESOLUTION에서 변경된 RouteState·RiskState가 다음 행동의 접근·위험 조건을 바꾸는지 시험한다.\",\"startSeconds\":60,\"endSeconds\":120,\"timeReason\":\"DEVELOPMENT에서 RiskState·ResourceState 입력과 RouteState·RiskState 출력의 설계 전이를 관찰하는 구간이다. 실제 실행 시간은 미검증이다.\",\"before\":[{\"key\":\"WorldAccessState\",\"value\":0},{\"key\":\"IntentState\",\"value\":0},{\"key\":\"RouteState\",\"value\":0},{\"key\":\"RiskState\",\"value\":1},{\"key\":\"ResourceState\",\"value\":1}],\"after\":[{\"key\":\"WorldAccessState\",\"value\":0},{\"key\":\"IntentState\",\"value\":0},{\"key\":\"RouteState\",\"value\":1},{\"key\":\"RiskState\",\"value\":2},{\"key\":\"ResourceState\",\"value\":1}],\"actions\":[{\"abilityId\":\"VIBE_RESPOND\",\"actorId\":\"PLAYER\",\"targetId\":\"WORLD\",\"atSeconds\":90,\"distance\":0,\"energyBefore\":10,\"energyAfter\":10,\"hit\":false,\"response\":\"PLAYER가 두 번째 시스템의 대응 선택을 사용한다. 상대 대응을 관찰하고 확정 타격 없이 다음 선택으로 이어진다. 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 상태 출력 RouteState·RiskState가 다음 시스템의 선택 조건에 전달된다.\"}],\"ruleIds\":[\"VIBE_B\"],\"outcome\":\"ONGOING\"},{\"phase\":\"RESOLUTION\",\"entryState\":\"다음 단계 RESOLUTION의 입장 조건과 세계 상태가 결정된다.\",\"playerChoice\":\"A의 RouteState로 진입해 RiskState·ResourceState가 바뀐 이유를 확인하고 B의 대응을 시험한다.\",\"actionAndResponse\":\"입력: 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 실행 전에 접근 가능성과 비용을 확인한다. 판정: RouteState·RiskState의 기존 접근·비용 조건을 확인한다. 성공: WorldAccessState·IntentState 출력과 문화·언어와 번역의 경로 해독의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 다른 경로를 선택하거나 실행하지 않고 되돌아간다. B에서 비용이 다른 대응을 선택한 뒤 WorldAccessState에 새 접근 조건을 반영한다. 실패하면 원래 RouteState를 유지한다.\",\"exitState\":\"한 판의 결과와 다음 선택을 기록한다.\",\"nextDecision\":\"이전에 변한 세계 상태와 발견 정보를 비교하고 새로운 접근 경로 또는 재시작 방법을 고른다.\",\"startSeconds\":120,\"endSeconds\":180,\"timeReason\":\"RESOLUTION에서 RouteState·RiskState 입력과 WorldAccessState·IntentState 출력의 설계 전이를 관찰하는 구간이다. 실제 실행 시간은 미검증이다.\",\"before\":[{\"key\":\"WorldAccessState\",\"value\":0},{\"key\":\"IntentState\",\"value\":0},{\"key\":\"RouteState\",\"value\":1},{\"key\":\"RiskState\",\"value\":2},{\"key\":\"ResourceState\",\"value\":1}],\"after\":[{\"key\":\"WorldAccessState\",\"value\":1},{\"key\":\"IntentState\",\"value\":1},{\"key\":\"RouteState\",\"value\":1},{\"key\":\"RiskState\",\"value\":2},{\"key\":\"ResourceState\",\"value\":1}],\"actions\":[{\"abilityId\":\"VIBE_CHOOSE\",\"actorId\":\"PLAYER\",\"targetId\":\"WORLD\",\"atSeconds\":150,\"distance\":0,\"energyBefore\":10,\"energyAfter\":10,\"hit\":false,\"response\":\"PLAYER가 첫 시스템의 경로 선택을 사용한다. 상대 대응을 관찰하고 확정 타격 없이 다음 선택으로 이어진다. 문화·언어와 번역의 경로 해독의 상태 출력 WorldAccessState·IntentState가 다음 시스템의 선택 조건에 전달된다.\"}],\"ruleIds\":[\"VIBE_DELVE\",\"VIBE_A\"],\"outcome\":\"SUCCESS\"}],\"roundSeconds\":180,\"sessionSeconds\":1800,\"durationRationale\":\"한 판의 상태 전이를 연속된 장면으로 나누고 30분 세션의 탐색·반작용·발견을 분리한다. 시간 배분은 설계 가정이며 실제 플레이 측정 전이다.\"},\"contentVarietyPlan\":{\"regions\":[{\"id\":\"VIBE_ORIGIN\",\"ruleIds\":[\"VIBE_MAIN\",\"VIBE_A\"],\"name\":\"문화·언어와 번역의 첫 선택 공간\",\"traversal\":\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.를 시작하는 출발 위치와 복귀 동선을 제공한다.\",\"riskReward\":\"안전한 진행을 선택하면 발견 속도가 늦어지고 어려운 경로에서는 다른 단서를 얻는다.\",\"landmark\":\"문화·언어와 번역의 변화가 드러나는 고유 랜드마크를 첫 진입 때 표시한다.\",\"encounterPattern\":\"A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 공간과 지도 정보 수집 실행 조건을 판정하고, 언어 단서를 해석하면 거래·동맹·임무의 접근 조건이 달라진다. 결과로 RiskState·ResourceState를 갱신해 B와 세계의 다음 선택을 바꾼다. 조건 미충족·취소 시 이전 상태를 보존한다. 결과를 읽고 위험·정보 반응이 변화한다.\",\"resourcePressure\":\"선택 결과에 따른 자원 접근 가능성과 기회비용을 분리해 보여준다.\",\"storyContext\":\"문화·언어와 번역의 흔적이 남은 지역은 의례와 호혜 관계의 선택에 따라 새로운 출입·보상 조건을 갖는다.\"},{\"id\":\"VIBE_REVISIT\",\"ruleIds\":[\"VIBE_B\",\"VIBE_DELVE\"],\"name\":\"의례와 호혜 관계의 되돌림 공간\",\"traversal\":\"행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.의 결과가 이전 구역의 통로를 열거나 닫는다.\",\"riskReward\":\"이전 상태를 역이용한 고급 대응은 짧은 경로와 추가 위험 중 하나를 선택하게 한다.\",\"landmark\":\"의례와 호혜 관계의 반작용과 발견 단서를 시각적으로 구분한다.\",\"encounterPattern\":\"B는 A의 하위 주제가 아니라 의례와 호혜 관계에서 독자적으로 만든 세부 사건·대상 규칙이다. 독립적으로 정한 상대 기술과 팀 전술 대응 행동은 A가 출력한 RiskState·ResourceState를 조건으로 읽는다. 자원 소비·행동 규칙·환경 반응이 계약처럼 서로 대가를 요구한다. 대응 성공 시 RouteState·RiskState를 A로 돌려보내 세계 규칙까지 바꾼다. 조건 미충족 시 상태를 보존한다. 결과를 기준으로 다른 대응법을 요구한다.\",\"resourcePressure\":\"처음 얻은 자원을 유지할지 새로운 접근에 재투자할지 기회비용을 제시한다.\",\"storyContext\":\"관계의 갈등이 플레이어의 실제 선택을 통해 해결되거나 심화되고, 그 결과가 다음 사건의 원인이 된다.\"}],\"enemiesOrChallenges\":[{\"name\":\"문화·언어와 번역의 제약\",\"behavior\":\"A는 문화·언어와 번역을 대규모 세계 규칙으로 창작한다. MAIN의 RouteState·RiskState를 읽어 미지 공간과 지도 정보 수집 실행 조건을 판정하고, 언어 단서를 해석하면 거래·동맹·임무의 접근 조건이 달라진다. 결과로 RiskState·ResourceState를 갱신해 B와 세계의 다음 선택을 바꾼다. 조건 미충족·취소 시 이전 상태를 보존한다.\",\"counterplay\":\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.\",\"positioning\":\"초반 경로에 접근할 때 읽을 수 있다.\",\"timing\":\"A의 첫 입력 이후 B의 대응 전까지 노출된다.\",\"mobility\":\"플레이어가 다른 길로 이동하면 반응 위치가 달라진다.\",\"groupRole\":\"A의 선택을 검증하는 첫 위험·조건이다.\",\"identity\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역\",\"rewardMeaning\":\"한 번의 결과가 다음 대응에 유용한 정보를 남긴다.\"},{\"name\":\"의례와 호혜 관계의 반작용\",\"behavior\":\"B는 A의 하위 주제가 아니라 의례와 호혜 관계에서 독자적으로 만든 세부 사건·대상 규칙이다. 독립적으로 정한 상대 기술과 팀 전술 대응 행동은 A가 출력한 RiskState·ResourceState를 조건으로 읽는다. 자원 소비·행동 규칙·환경 반응이 계약처럼 서로 대가를 요구한다. 대응 성공 시 RouteState·RiskState를 A로 돌려보내 세계 규칙까지 바꾼다. 조건 미충족 시 상태를 보존한다.\",\"counterplay\":\"행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.\",\"positioning\":\"후반 되돌림 공간에서 관찰된다.\",\"timing\":\"이전 A의 상태에 반응한 뒤 다음 선택 전에 나타난다.\",\"mobility\":\"다른 접근 경로와 세계 상태에 따라 대응 위치가 바뀐다.\",\"groupRole\":\"B의 결과를 A로 되돌려 주는 반작용 역할이다.\",\"identity\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계\",\"rewardMeaning\":\"새로운 우회 경로와 숨은 조합을 알게 한다.\"}],\"objectives\":[{\"role\":\"A의 주요 목표\",\"variation\":\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다.가 B의 대응 가능성을 변화시키는지 확인한다.\"},{\"role\":\"B의 반작용\",\"variation\":\"행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다.가 다시 A의 안전·정보 선택을 변화시키는지 확인한다.\"}],\"antiMonotonyRule\":\"같은 적 체력이나 수치만 반복하지 않고 접근 경로·정보·인물 관계·대응 규칙이 초중후반에 변한다.\",\"abilities\":[{\"id\":\"VIBE_CHOOSE\",\"name\":\"첫 시스템의 경로 선택\",\"kind\":\"INTERACTION\",\"ownerId\":\"PLAYER\",\"ruleId\":\"VIBE_A\",\"trigger\":\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 실행 전에 접근 가능성과 비용을 확인한다.\",\"range\":0,\"rangeUnit\":\"선택 입력\",\"resource\":\"행동 기회\",\"cost\":0,\"cooldownSeconds\":0,\"telegraph\":\"선택지의 변화 조건과 현재 위험을 화면에 알린다.\",\"avoidance\":\"다른 경로를 선택하거나 실행하지 않고 되돌아간다.\",\"effect\":\"선택 경로와 반응 위험을 계획 상태에 반영한다.\",\"stateInputs\":[\"RouteState\"],\"stateOutputs\":[\"RiskState\"],\"source\":\"시드 인과문법 A의 설계 계약 (실제 구현 전)\",\"rangeKey\":\"\",\"costKey\":\"\",\"cooldownKey\":\"\"},{\"id\":\"VIBE_RESPOND\",\"name\":\"두 번째 시스템의 대응 선택\",\"kind\":\"INTERACTION\",\"ownerId\":\"PLAYER\",\"ruleId\":\"VIBE_B\",\"trigger\":\"행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 실행 전에 A의 이전 결과를 읽는다.\",\"range\":0,\"rangeUnit\":\"선택 입력\",\"resource\":\"행동 기회\",\"cost\":0,\"cooldownSeconds\":0,\"telegraph\":\"상대의 다음 반응과 예상되는 선택 비용을 알린다.\",\"avoidance\":\"대응을 취소하고 이전 안전 단계로 돌아간다.\",\"effect\":\"대응 결과를 다음 A의 계획 조건으로 되돌려 보낸다.\",\"stateInputs\":[\"RiskState\"],\"stateOutputs\":[\"RouteState\"],\"source\":\"시드 인과문법 B의 설계 계약 (실제 구현 전)\",\"rangeKey\":\"\",\"costKey\":\"\",\"cooldownKey\":\"\"}],\"roleTransitions\":[]},\"narrativeDialoguePlan\":{\"applicable\":true,\"worldRules\":[\"A의 RiskState·ResourceState가 B의 의례와 호혜 관계 판정을 바꾸고 B의 RouteState·RiskState가 MAIN의 WorldAccessState를 거쳐 다시 A의 접근 조건이 된다.\"],\"characterGoals\":[\"문화·언어와 번역의 원칙을 지키는 인물과 의례와 호혜 관계의 책임을 지려는 인물이 목표를 놓고 충돌한다.\"],\"plotBeats\":[\"문화·언어와 번역의 원칙을 지키는 인물과 의례와 호혜 관계의 책임을 지려는 인물이 목표를 놓고 충돌한다. A의 RiskState·ResourceState가 B의 의례와 호혜 관계 판정을 바꾸고 B의 RouteState·RiskState가 MAIN의 WorldAccessState를 거쳐 다시 A의 접근 조건이 된다.\",\"행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 또는 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 중 무엇을 우선할지 판단한다.\",\"문화·언어와 번역의 흔적이 남은 지역은 의례와 호혜 관계의 선택에 따라 새로운 출입·보상 조건을 갖는다. 역사적 세력 균형와 희극의 오해와 엇갈림가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다.\"],\"questStates\":[\"이전 선택 조건을 확인한다.\",\"상대의 반작용이 나타나면 다음 선택을 바꾼다.\"],\"foreshadowing\":[\"문화·언어와 번역의 작은 변화가 의례와 호혜 관계의 큰 반작용을 예고한다.\"],\"payoffs\":[\"의례와 호혜 관계의 결과가 다시 문화·언어와 번역의 앞선 의미를 바꾼다.\"],\"twists\":[\"A/B 중 어느 하나나 C의 보조 장르를 제거하면 정보·동선·세계 반응이 달라지므로 장식으로 대체할 수 없다.\"],\"dialogueRules\":[\"현재 인물의 지식 범위와 플레이어의 지난 행동을 넘는 정보는 대사에 넣지 않는다.\"],\"characterVoiceProfiles\":[{\"character\":\"문화·언어와 번역의 이해관계자\",\"grammarRegister\":\"경험을 중심으로 짧게 이야기한다.\",\"vocabularyRhythm\":\"경고와 선택 비용을 구체적으로 말한다.\",\"relationshipShift\":\"플레이어의 선택에 따라 신뢰와 협력 조건이 바뀐다.\",\"emotionalRange\":\"불안에서 신뢰 또는 반발로 변한다.\",\"knowledgeBoundary\":\"첫 시스템의 현재 변화만 안다.\",\"subtextBehavior\":\"숨기고 싶은 위험을 발언 순서로 드러낸다.\"},{\"character\":\"의례와 호혜 관계의 이해관계자\",\"grammarRegister\":\"규칙과 반작용을 비교해 설명한다.\",\"vocabularyRhythm\":\"사건 이전과 이후를 비교하며 말한다.\",\"relationshipShift\":\"선택 결과에 따라 요구와 제안이 달라진다.\",\"emotionalRange\":\"의심과 설득, 체념 또는 수용을 보인다.\",\"knowledgeBoundary\":\"자신이 관찰한 후속 결과만 안다.\",\"subtextBehavior\":\"정보 부족을 역이용해 다른 협상을 제시한다.\"}],\"sceneBeats\":[{\"scene\":\"첫 진입\",\"purpose\":\"세계의 조건을 알아차리게 한다.\",\"characterGoals\":\"무엇을 지킬지 정한다.\",\"conflict\":\"인물은 플레이어의 이전 선택을 기억하고 신뢰·거래·협력 조건을 변경한다.\",\"informationAsymmetry\":\"두 소재가 서로 다른 원인을 알고 있다.\",\"reversal\":\"첫 선택이 예기치 않은 다른 문제를 일으킨다.\",\"stateChange\":\"A의 상태가 B의 조건을 바꾼다.\"},{\"scene\":\"귀환과 해결\",\"purpose\":\"이전 선택의 결과를 확인한다.\",\"characterGoals\":\"손실과 관계를 재조정한다.\",\"conflict\":\"서로의 비용을 누가 부담할지 충돌한다.\",\"informationAsymmetry\":\"후속 사건의 단서가 플레이어에게만 보인다.\",\"reversal\":\"B의 결과로 A의 옛 선택을 새롭게 해석한다.\",\"stateChange\":\"세계 접근과 위험 상태가 갱신된다.\"}]},\"implementationTraceability\":[{\"designElement\":\"미지 공간과 지도 정보 수집 × 문화·언어와 번역\",\"responsibleSystem\":\"roblox-games/cozy-island/에서 미지 공간과 지도 정보 수집 × 문화·언어와 번역의 기존 Luau 책임 함수와 코드 모듈\",\"validationEvidence\":\"같은 조건의 입력 전후 위험·세계 상태 값과 다음 B의 선택 변화를 비교한다.\"},{\"designElement\":\"상대 기술과 팀 전술 대응 × 의례와 호혜 관계\",\"responsibleSystem\":\"roblox-games/cozy-island/에서 상대 기술과 팀 전술 대응 × 의례와 호혜 관계의 기존 Luau 책임 함수와 코드 모듈\",\"validationEvidence\":\"B의 반작용 이전/이후 A의 다음 경로·비용·행동 가능성을 비교한다.\"},{\"designElement\":\"탐험 목표를 해결하려면 A의 ResourceState 확보와 B의 RouteState 변경을 반복한다. 대전 슈팅 액션 판단에서는 역사적 세력 균형의 단서를 먼저 해석하거나 희극의 오해와 엇갈림의 반작용을 감수해야 B의 대응·A의 재진입 중 하나가 가능하다. 보조 장르를 제거하면 실제 접근 조건이 달라진다.\",\"responsibleSystem\":\"세계 상태·스토리 반응의 기존 책임 시스템\",\"validationEvidence\":\"보조 장르를 제거한 반사실 비교에서 실제 선택과 정보가 달라지는지 재생한다.\"},{\"designElement\":\"문화·언어와 번역의 경로 해독\",\"responsibleSystem\":\"진행·탐색·발견을 연결하는 기존 책임 함수\",\"validationEvidence\":\"숨은 발견 조건 이전/이후의 새로운 선택과 재방문 결과를 검증한다.\"}],\"stabilityPriorityPlan\":{\"signals\":[],\"priorityRule\":\"실제 재현된 진행 막힘·저장 손상·터치 입력 실패·멀티 동기화 오류를 우선 분류하고 원인에 해당하는 기존 책임 함수만 수정한다.\"},\"preservationContract\":{}}\nDESIGN_SOURCE_BUILD_UP: {\"version\":1,\"scope\":\"EXISTING_DESIGN_AND_GAME_BUILD_UP_ONLY\",\"currentDesignFingerprint\":\"87c3e5cee40a9d4316efc1cb1e20f61f9d3a4bc58b8e5616cd8d925684ffc6df\",\"previousDesignFingerprint\":null,\"sameApprovedDesign\":false,\"previousVerifiedOutcome\":false,\"revisionRequiredForNewGameplay\":false,\"nextDesignAction\":\"TRACE_CURRENT_APPROVED_DESIGN_TO_NATIVE_SOURCE\",\"sourceAuthority\":\"LATEST_APPROVED_SAME_GAME_DESIGN_ONLY\",\"referenceA\":null,\"baselineB\":null,\"benchmarkDimensions\":[\"INPUT_AND_PRIMARY_ACTION\",\"HUD_AND_MENU_FLOW\",\"CAMERA_AND_FEEDBACK\",\"COMBAT_OR_CORE_LOOP\",\"WORLD_AND_LEVEL_PROGRESSION\",\"EQUIPMENT_REWARDS_AND_GROWTH\",\"ONBOARDING_AND_FIRST_SESSION\",\"FAILURE_RETRY_SAVE_RECOVERY\",\"MID_LATE_DEPTH\"],\"loop\":[\"REVIEW_GAME_AND_NAMED_REFERENCE_EVIDENCE\",\"REVISE_MAIN_A_B_C_D_AT_DESIGN\",\"STRICT_DESIGN_REVIEW\",\"BIND_RULE_IDS_TO_EXISTING_RESPONSIBLE_SOURCE\",\"BUILD_SOURCE\",\"EXACT_BUILD_RUNTIME_QA\",\"NEXT_DESIGN_REVISION_FROM_VERIFIED_GAPS\"],\"provenanceRule\":\"NAMED_SOURCE_OBSERVED_MECHANICS_OR_UNVERIFIED; NEVER_COPY_DISTINCTIVE_UI_ART_CHAR_TEXT_CODE\",\"confirmedRuntimePass\":false,\"preserves\":[\"OWNER_GAME_IDENTITY\",\"CORE_RULES\",\"BALANCE\",\"ECONOMY\",\"SAVE_KEYS_AND_MEANING\",\"NETWORK_AUTHORITY\"]}\nDESIGN_SOURCE_BUILD_UP_RULE: 설계도 매 BUILD_UP에서 진화해야 한다. 첫 단계는 최신 승인된 MAIN/A/B/C/D/@ 설계와 직전 실제 소스·플레이 증거의 차이를 분석하고 기존 설계기에서 개정을 심사받는 것이다. 승인된 설계 규칙·상태·화면 전개·책임 함수에 추적되는 기능만 기존 소스에서 빌드업한다. 이전 설계가 그대로면 승인되지 않은 새 전투·경제·진행·저장 규칙을 코드에서 먼저 발명하지 말고 기존 설계 사이클의 설계 개정을 요청한다. 버그 수리와 승인된 설계 범위의 표현/편의 수정은 계속 진행한다. 검증된 플레이 결과는 다음 설계 개정의 입력이지 설계/런타임 PASS 자체가 아니다.\nA_REFERENCE_SYSTEM_DEPTH: 비슷한 유명 게임의 조작, HUD, 메뉴/화면 동선, 카메라, 전투·핵심 플레이, 장비/성장/보상, 월드·스테이지 전개, 실패/재시도, 첫 세션/후반 깊이까지 참고한다. 이름·출처·관찰된 작동 원리·우리 게임 B와의 차이·적용/기각·검증 장면을 연결하되 타 게임 고유 UI 표현·그림·캐릭터·문구·코드·에셋 복제 금지.\nDESIGNED_GAME_VOLUME: mode=APPROVED_DESIGN_TO_NATIVE_CONTENT_IMPLEMENTATION; authored=50; sourceNamedCandidates=1; sourceReview=49; runtimeVerified=0; countsAreNotPass=true\nDESIGNED_GAME_VOLUME_ITEMS:\n- PLAYTHROUGH[0] OPENING | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_A | runtime=UNVERIFIED\n- PLAYTHROUGH[1] DEVELOPMENT | source=EXACT_NAME_SOURCE_CANDIDATE_UNVERIFIED | ruleIds=VIBE_B | runtime=UNVERIFIED\n- PLAYTHROUGH[2] RESOLUTION | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_DELVE,VIBE_A | runtime=UNVERIFIED\n- CORE_LOOP[0] A 시작: RouteState·RiskState를 확인한 뒤 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 성공하면 ResourceState·RiskState가 바뀌고, 실패하면 대체 경로를 선택한다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CORE_LOOP[1] B 대응: A의 ResourceState·RiskState를 확인한 뒤 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 성공하면 RouteState·RiskState를 갱신하고 불가능하면 소비 없이 다시 선택한다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CORE_LOOP[2] A 재진입: B가 갱신한 RouteState와 이전 경로를 비교해 미지 공간과 지도 정보 수집의 새 선택을 실행하거나 @ 발견 조건을 시험한다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- SIGNATURE_SYSTEM[0] 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_MAIN,VIBE_A,VIBE_DELVE | runtime=UNVERIFIED\n- SIGNATURE_SYSTEM[1] 미지 공간과 지도 정보 수집 × 문화·언어와 번역 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_MAIN,VIBE_A,VIBE_B,VIBE_DELVE | runtime=UNVERIFIED\n- SIGNATURE_SYSTEM[2] 상대 기술과 팀 전술 대응 × 의례와 호혜 관계 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_A,VIBE_B,VIBE_DELVE | runtime=UNVERIFIED\n- SIGNATURE_SYSTEM[3] 문화·언어와 번역의 경로 해독 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_B,VIBE_DELVE,VIBE_MAIN,VIBE_A | runtime=UNVERIFIED\n- SYSTEM_CONNECTION[0] 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독 → 미지 공간과 지도 정보 수집 × 문화·언어와 번역 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_MAIN,VIBE_A | runtime=UNVERIFIED\n- SYSTEM_CONNECTION[1] 미지 공간과 지도 정보 수집 × 문화·언어와 번역 → 상대 기술과 팀 전술 대응 × 의례와 호혜 관계 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_A,VIBE_B | runtime=UNVERIFIED\n- SYSTEM_CONNECTION[2] 상대 기술과 팀 전술 대응 × 의례와 호혜 관계 → 미지 공간과 지도 정보 수집 × 문화·언어와 번역 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_B,VIBE_A | runtime=UNVERIFIED\n- SYSTEM_CONNECTION[3] 상대 기술과 팀 전술 대응 × 의례와 호혜 관계 → 문화·언어와 번역의 경로 해독 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_B,VIBE_DELVE | runtime=UNVERIFIED\n- SYSTEM_CONNECTION[4] 문화·언어와 번역의 경로 해독 → 문화·언어와 번역·의례와 호혜 관계 탐험×대전 슈팅 액션: 문화·언어와 번역의 경로 해독 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_DELVE,VIBE_MAIN | runtime=UNVERIFIED\n- SYSTEM_CONNECTION[5] 미지 공간과 지도 정보 수집 × 문화·언어와 번역 → 문화·언어와 번역의 경로 해독 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_A,VIBE_DELVE | runtime=UNVERIFIED\n- CONTENT_MILESTONE[0] 초반 선택에 따른 접근 경로와 위험 재구성 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_MAIN,VIBE_A,VIBE_B | runtime=UNVERIFIED\n- CONTENT_MILESTONE[1] 중반 두 시스템의 반작용과 대응 조건 충돌 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_MAIN,VIBE_A,VIBE_B | runtime=UNVERIFIED\n- CONTENT_MILESTONE[2] 숨겨진 세계 인과법칙을 이용한 새로운 접근 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_MAIN,VIBE_A,VIBE_B,VIBE_DELVE | runtime=UNVERIFIED\n- CONTENT_MILESTONE[3] 누적된 관계를 되짚는 재방문과 장기 숙련 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_MAIN,VIBE_A,VIBE_B,VIBE_DELVE | runtime=UNVERIFIED\n- VARIETY_ABILITIES[0] 첫 시스템의 경로 선택 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_A | runtime=UNVERIFIED\n- VARIETY_ABILITIES[1] 두 번째 시스템의 대응 선택 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_B | runtime=UNVERIFIED\n- VARIETY_ENEMIESORCHALLENGES[0] 문화·언어와 번역의 제약 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- VARIETY_ENEMIESORCHALLENGES[1] 의례와 호혜 관계의 반작용 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- VARIETY_OBJECTIVES[0] A의 주요 목표 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- VARIETY_OBJECTIVES[1] B의 반작용 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- VARIETY_REGIONS[0] 문화·언어와 번역의 첫 선택 공간 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_MAIN,VIBE_A | runtime=UNVERIFIED\n- VARIETY_REGIONS[1] 의례와 호혜 관계의 되돌림 공간 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds=VIBE_B,VIBE_DELVE | runtime=UNVERIFIED\n- NARRATIVE_QUESTSTATES[0] 이전 선택 조건을 확인한다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- NARRATIVE_QUESTSTATES[1] 상대의 반작용이 나타나면 다음 선택을 바꾼다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- NARRATIVE_PLOTBEATS[0] 문화·언어와 번역의 원칙을 지키는 인물과 의례와 호혜 관계의 책임을 지려는 인물이 목표를 놓고 충돌한다. A의 RiskState·ResourceState가 B의 의례와 호혜 관계 판정을 바꾸고 B의 RouteState·RiskState가 MAIN의 WorldAccessState를 거쳐 다시 A의 접근 조건이 된다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- NARRATIVE_PLOTBEATS[1] 행동: 새 지역에서 지도 단서와 접근 가능 통로를 조사한다. 선택: 새 ResourceState를 얻기 위해 위험을 감수할지, 현재 RouteState로 안전하게 되돌아갈지 결정한다. 또는 행동: 교전 결과와 팀 상황에 따라 장비·엄폐·협동 공격을 조정한다. 선택: A가 남긴 ResourceState로 대응을 바꿀지, RiskState를 감수하고 다른 경로를 열지 결정한다. 중 무엇을 우선할지 판단한다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- NARRATIVE_PLOTBEATS[2] 문화·언어와 번역의 흔적이 남은 지역은 의례와 호혜 관계의 선택에 따라 새로운 출입·보상 조건을 갖는다. 역사적 세력 균형와 희극의 오해와 엇갈림가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- NARRATIVE_SCENEBEATS[0] NARRATIVE_SCENEBEATS #1 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- NARRATIVE_SCENEBEATS[1] NARRATIVE_SCENEBEATS #2 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_A_SYSTEM_AND_SOURCE[0] 미지 공간과 지도 정보 수집 × 문화·언어와 번역 × 문화·언어와 번역 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_B_SYSTEM_AND_SOURCE[0] 상대 기술과 팀 전술 대응 × 의례와 호혜 관계 × 의례와 호혜 관계 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_C_THEME_FUSION[0] 역사적 세력 균형 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_C_THEME_FUSION[1] 희극의 오해와 엇갈림 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_C_PRIMARY_SECONDARY_GENRE[0] PRIMARY 탐험 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_C_PRIMARY_SECONDARY_GENRE[1] SECONDARY 대전 슈팅 액션 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_C_GENRE_INTERLOCK[0] 메인·보조 장르 플레이 인과 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_AT_DELVE[0] 문화·언어와 번역의 경로 해독: 같은 표현도 문화적 맥락이 달라지면 의미와 반응이 달라질 수 있다. 원리를 A의 선택과 B의 결과를 비교해 발견한다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_AT_DELVE[1] 의례와 호혜 관계의 귀환 흔적: 의례는 보상이 아니라 인간과 세계 사이의 상호 의무를 갱신한다. 원리 때문에 같은 A 행동도 재방문에서는 다른 조건으로 판정됨을 발견한다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_AT_DELVE[2] 역사적 세력 균형·오해와 엇갈림의 이중 단서: 한 세력의 완전한 승리가 오히려 더 큰 불균형과 반발을 만든다. / 서로 다른 정보와 오해가 연쇄적으로 현실의 결과를 만든다. 두 원리가 결합될 때 대전 슈팅 액션의 해석이 다음 행동 허용 여부를 바꾼다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- CREATIVE_AT_DELVE[3] 미지 공간과 지도 정보 수집·상대 기술과 팀 전술 대응의 역전: 문화·언어와 번역의 불리한 결과가 의례와 호혜 관계의 다른 조건에서는 유리해지는 실제 인과를 발견한다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- IMPLEMENTATION_TRACE[0] 미지 공간과 지도 정보 수집 × 문화·언어와 번역 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- IMPLEMENTATION_TRACE[1] 상대 기술과 팀 전술 대응 × 의례와 호혜 관계 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- IMPLEMENTATION_TRACE[2] 탐험 목표를 해결하려면 A의 ResourceState 확보와 B의 RouteState 변경을 반복한다. 대전 슈팅 액션 판단에서는 역사적 세력 균형의 단서를 먼저 해석하거나 희극의 오해와 엇갈림의 반작용을 감수해야 B의 대응·A의 재진입 중 하나가 가능하다. 보조 장르를 제거하면 실제 접근 조건이 달라진다. | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\n- IMPLEMENTATION_TRACE[3] 문화·언어와 번역의 경로 해독 | source=EXACT_SOURCE_OWNER_REVIEW_REQUIRED | ruleIds= | runtime=UNVERIFIED\nDESIGN_TO_PLATFORM_CODING_CHECK: {\"version\":1,\"authority\":\"GAME_DESIGN_TO_EXISTING_PLATFORM_BUILD_UP_LINK\",\"gameId\":\"cozy-island\",\"requestedPlatform\":\"WEB\",\"activePlatform\":\"NOT_SELECTED_NATIVE_PLATFORM\",\"originalSourcePlatform\":\"ROBLOX\",\"originalSourceLanguage\":\"LUAU\",\"unityWebSourceSync\":null,\"designFingerprint\":\"87c3