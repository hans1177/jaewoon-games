ctedExecutableFiles\":[\"roblox-games/monster-adventure/server/Game.server.luau\",\"roblox-games/monster-adventure/shared/RobloxCommonMaterials.luau\"],\"exactRuntimeStateTransitionVerified\":false,\"rule\":\"IDENTIFIER_REFERENCE_AND_ASSIGNMENT_ARE_DIAGNOSTIC_CANDIDATES_NOT_GAMEPLAY_PARITY_PASS\"},\"suggestedExistingOwnerFiles\":[\"roblox-games/monster-adventure/server/Game.server.luau\",\"roblox-games/monster-adventure/shared/GameConfig.luau\",\"roblox-games/monster-adventure/shared/RobloxCommonMaterials.luau\"],\"inspectedSymbols\":[{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler1\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler2\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler3\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler4\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler5\",\"kind\":\"FUNCTION\"}],\"designStatus\":\"AUTHORED\",\"codingStatus\":\"SOURCE_OWNER_CANDIDATE_UNVERIFIED\",\"executableBehaviorVerified\":false,\"actualRuntimeVerified\":false,\"evidenceNeeded\":\"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA\"},{\"role\":\"@\",\"grammarRole\":\"DELVE\",\"systemId\":\"VIBE_DELVE\",\"systemIds\":[\"VIBE_DELVE\"],\"names\":[\"금기와 기회의 교차\"],\"name\":\"금기와 기회의 교차\",\"stateInputs\":[\"RouteState\",\"RiskState\"],\"stateOutputs\":[\"WorldAccessState\",\"IntentState\"],\"connections\":[{\"fromId\":\"VIBE_B\",\"toId\":\"VIBE_DELVE\",\"stateKeys\":[\"RouteState\",\"RiskState\"]},{\"fromId\":\"VIBE_DELVE\",\"toId\":\"VIBE_MAIN\",\"stateKeys\":[\"WorldAccessState\",\"IntentState\"]},{\"fromId\":\"VIBE_A\",\"toId\":\"VIBE_DELVE\",\"stateKeys\":[\"RiskState\"]}],\"nativeStateMapping\":{\"state\":\"SOURCE_STATE_KEYS_NOT_MAPPED\",\"matchedInputKeys\":[],\"matchedWrittenOutputKeys\":[],\"missingInputKeys\":[\"RouteState\",\"RiskState\"],\"missingWrittenOutputKeys\":[\"WorldAccessState\",\"IntentState\"],\"inspectedExecutableFiles\":[\"roblox-games/monster-adventure/server/Game.server.luau\",\"roblox-games/monster-adventure/shared/RobloxCommonMaterials.luau\"],\"exactRuntimeStateTransitionVerified\":false,\"rule\":\"IDENTIFIER_REFERENCE_AND_ASSIGNMENT_ARE_DIAGNOSTIC_CANDIDATES_NOT_GAMEPLAY_PARITY_PASS\"},\"suggestedExistingOwnerFiles\":[\"roblox-games/monster-adventure/server/Game.server.luau\",\"roblox-games/monster-adventure/shared/GameConfig.luau\",\"roblox-games/monster-adventure/shared/RobloxCommonMaterials.luau\"],\"inspectedSymbols\":[{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler1\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler2\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler3\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler4\",\"kind\":\"FUNCTION\"},{\"file\":\"roblox-games/monster-adventure/server/Game.server.luau\",\"symbol\":\"scopeHandler5\",\"kind\":\"FUNCTION\"}],\"designStatus\":\"AUTHORED\",\"codingStatus\":\"SOURCE_OWNER_CANDIDATE_UNVERIFIED\",\"executableBehaviorVerified\":false,\"actualRuntimeVerified\":false,\"evidenceNeeded\":\"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA\"}],\"edgeStateMismatches\":[],\"nativeStateMappingSummary\":{\"authoredRoles\":4,\"mappedStaticCandidates\":0,\"unmappedRoles\":[\"MAIN\",\"A\",\"B\",\"@\"],\"edgeMismatches\":0,\"staticSourceMappingIsNotRuntimeParity\":true},\"creativeCBinding\":{\"themes\":[{\"name\":\"영웅서사의 이름과 평판\",\"gameplayEffect\":\"플레이어의 실제 행동보다 퍼진 이야기와 평판이 적·상점·세력의 규칙을 바꾼다. 그 결과 A와 B가 공유하는 조건이 바뀐다.\"},{\"name\":\"후원과 인맥 관계\",\"gameplayEffect\":\"관계망의 누구를 밀어주고 누구에게 빚지는지가 능력과 콘텐츠 접근을 결정한다. 그 결과 사건의 비용과 다음 선택이 달라진다.\"}],\"genres\":[{\"role\":\"PRIMARY\",\"name\":\"생활\",\"gameplayEffect\":\"사회관계 선택와 생활 공간 탐색를 통한 중심 목표와 위험·보상을 판단한다.\"},{\"role\":\"SECONDARY\",\"name\":\"추리\",\"gameplayEffect\":\"영웅서사의 이름과 평판의 단서와 후원과 인맥 관계의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다.\"}],\"genreInterlock\":\"생활 장르의 주 목표를 진행하는 동안 추리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 추리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.\",\"abGameplayEffect\":\"신화 속 트릭스터의 질서 역전에 의해 바뀐 인물·지역의 상태는 순교와 집단 결속의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 영웅서사의 이름과 평판와 후원과 인맥 관계가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 그 결과 생활 공간 탐색의 가능 행동과 위험이 바뀌며, 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 다시 사회관계 선택의 조건을 바꾼다.\",\"standardVersion\":null,\"dCreations\":[],\"delveDLinks\":[{\"sourceDId\":\"\",\"discovery\":\"금기와 기회의 교차: 약자·광대·사기꾼이 규칙의 빈틈을 이용해 질서를 뒤집는다. 상황을 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 방식으로 해석한다.\",\"experiment\":\"\",\"nextQuestion\":\"\"},{\"sourceDId\":\"\",\"discovery\":\"되돌아온 선택: 개인의 패배나 죽음이 집단의 결속과 운동을 강화할 수 있다. 결과가 과거 선택의 의미를 바꿀 수 있음을 발견한다.\",\"experiment\":\"\",\"nextQuestion\":\"\"},{\"sourceDId\":\"\",\"discovery\":\"두 소재의 숨은 규칙: 실제 힘과 별개로 이름·소문·평판이 타인의 행동을 결정한다. 원리와 개인의 힘보다 후원·인맥·은혜·빚의 연결망이 행동 가능성을 만든다. 원리가 동시에 작동함을 파악한다.\",\"experiment\":\"\",\"nextQuestion\":\"\"},{\"sourceDId\":\"\",\"discovery\":\"역전된 종착점: 한쪽의 불리한 결과가 다른 쪽의 고급 활용 조건이 되는 인과 반전을 학습한다.\",\"experiment\":\"\",\"nextQuestion\":\"\"}],\"designAuthored\":true,\"runtimeVerified\":false},\"observedGameCodeFiles\":[\"roblox-games/monster-adventure/shared/RobloxCommonUI.luau\",\"roblox-games/monster-adventure/shared/GameConfig.luau\",\"roblox-games/monster-adventure/client/Game.client.luau\",\"roblox-games/monster-adventure/server/Game.server.luau\",\"roblox-games/monster-adventure/shared/RobloxCommonMaterials.luau\",\"roblox-games/monster-adventure/client/MaterialPresentation.client.luau\"],\"executableCodeCandidateFiles\":[\"roblox-games/monster-adventure/shared/RobloxCommonUI.luau\",\"roblox-games/monster-adventure/client/Game.client.luau\",\"roblox-games/monster-adventure/server/Game.server.luau\",\"roblox-games/monster-adventure/shared/RobloxCommonMaterials.luau\",\"roblox-games/monster-adventure/client/MaterialPresentation.client.luau\"],\"gapReasons\":[\"DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:MAIN\",\"DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:A\",\"DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:B\",\"DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:@\"],\"codingReviewState\":\"GAME_STAGE_LOCAL_REPAIR_REQUIRED\",\"sourceImplementationPassed\":false,\"actualTwoClientPassed\":false,\"actualWebglRenderPassed\":false,\"independentQaPassed\":false,\"stageLocalAction\":\"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME\",\"schemaAndMarkersAloneCannotPass\":true,\"newPipeline\":false,\"changesDevelopmentAdmission\":false,\"saveBalanceAndExistingMultiplayerMeaningPreserved\":true}\nCODING_IMPLEMENTATION_VERDICT: SOURCE_OWNER_CANDIDATES_ONLY. Do not mark a MAIN/A/B/C/@ role, native platform or 2.5D graphics PASS from design fields or a source marker. Implement and independently replay actual input→authoritative state→result→reconnect, then rerun existing platform QA.\nMULTIPLAYER_IMPLEMENTATION: {\"required\":false,\"policyVersion\":0,\"developmentAdmissionGate\":false,\"missingImplementationAction\":\"EXISTING_BUILD_UP_LOCAL_IMPLEMENTATION_AND_RETRY\",\"otherGamesAndIndependentWorkContinue\":true,\"actualMultiplayerPlayVerified\":false,\"completionEvidence\":null}\nIDENTITY_ONE_LINE_FANTASY: 몬스터 어드벤처의 플레이어는 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.을 결정하고 두 소재가 만드는 반작용을 책임진다.\nIDENTITY_REPRESENTATIVE_ACTION: 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.\nIDENTITY_REPRESENTATIVE_CHOICE: 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다.\nIDENTITY_SIGNATURE_WORLD_RULE: VIBE_MAIN 출력 RouteState → VIBE_A 입력. 후속 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 신화 속 트릭스터의 질서 역전의 제약을 감수할지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\nIDENTITY_SIGNATURE_SYSTEMS: 몬스터 어드벤처,사회관계 선택 × 신화 속 트릭스터의 질서 역전,생활 공간 탐색 × 순교와 집단 결속,금기와 기회의 교차\nIDENTITY_GROWTH: 성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다.\nIDENTITY_THREE_SENTENCE_TEST: WHAT=몬스터 어드벤처. 신화 속 트릭스터의 질서 역전·순교와 집단 결속 생활. 몬스터 어드벤처에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전과 생활 공간 탐색 × 순교와 집단 결속이 서로 결과를 되돌려 바꾸며 생활·추리의 판단이 실제 세계 상태를 변화시킨다. | DIFFERENT=몬스터 어드벤처에서 마을 주민가 사회관계 선택와 생활 공간 탐색의 선택을 통해 신화 속 트릭스터의 질서 역전·순교와 집단 결속의 인과법칙을 바꾸는 생활 복합 게임에서 플레이어는 선택을 누적해 목적을 완수한다. 게임의 반복 목표와 세계의 접근 가능성을 상태로 관리한다. | GROWTH=성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다.\nIDENTITY_BUILD_UP_RULE: EACH_BUILD_UP_MUST_STRENGTHEN_OR_PRESERVE_THE_REPRESENTATIVE_ACTION_CHOICE_WORLD_RULE_SIGNATURE_SYSTEM_OR_GROWTH_IDENTITY; GENERIC_FEATURE_COUNT_DOES_NOT_COUNT\nCAUSAL_GRAMMAR_EVIDENCE: {\"worldRules\":[\"신화 속 트릭스터의 질서 역전에 의해 바뀐 인물·지역의 상태는 순교와 집단 결속의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다.\"],\"causalInspirations\":[{\"titleOrTradition\":\"WORLD_TRICKSTER_MYTH\",\"rightsBasis\":\"ABSTRACT_TECHNIQUE\",\"borrowedTechnique\":\"약자·광대·사기꾼이 규칙의 빈틈을 이용해 질서를 뒤집는다.\",\"transformation\":\"정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.의 구조만 독자적 인물·세계·상호작용으로 재해석한다.\"},{\"titleOrTradition\":\"RELIGION_POLITICAL_HISTORY_ARCHETYPE\",\"rightsBasis\":\"ABSTRACT_TECHNIQUE\",\"borrowedTechnique\":\"개인의 패배나 죽음이 집단의 결속과 운동을 강화할 수 있다.\",\"transformation\":\"특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다.의 구조만 독자적 인물·세계·상호작용으로 재해석한다.\"}],\"systemInterconnections\":[{\"fromId\":\"VIBE_MAIN\",\"toId\":\"VIBE_A\",\"stateKeys\":[\"RouteState\"],\"fromSystem\":\"몬스터 어드벤처\",\"toSystem\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"trigger\":\"몬스터 어드벤처의 선택: 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 기존 선행조건을 만족해 RouteState 출력이 확정됐을 때 사회관계 선택 × 신화 속 트릭스터의 질서 역전이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_MAIN 출력 RouteState → VIBE_A 입력. 후속 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 신화 속 트릭스터의 질서 역전의 제약을 감수할지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_A\",\"toId\":\"VIBE_B\",\"stateKeys\":[\"RiskState\",\"ResourceState\"],\"fromSystem\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"toSystem\":\"생활 공간 탐색 × 순교와 집단 결속\",\"trigger\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전의 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 신화 속 트릭스터의 질서 역전의 제약을 감수할지 결정한다. 기존 선행조건을 만족해 RiskState·ResourceState 출력이 확정됐을 때 생활 공간 탐색 × 순교와 집단 결속이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_A 출력 RiskState·ResourceState → VIBE_B 입력. 후속 선택: 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 순교와 집단 결속의 반작용을 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_B\",\"toId\":\"VIBE_A\",\"stateKeys\":[\"RouteState\",\"RiskState\"],\"fromSystem\":\"생활 공간 탐색 × 순교와 집단 결속\",\"toSystem\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"trigger\":\"생활 공간 탐색 × 순교와 집단 결속의 선택: 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 순교와 집단 결속의 반작용을 선택한다. 기존 선행조건을 만족해 RouteState·RiskState 출력이 확정됐을 때 사회관계 선택 × 신화 속 트릭스터의 질서 역전이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_B 출력 RouteState·RiskState → VIBE_A 입력. 후속 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 신화 속 트릭스터의 질서 역전의 제약을 감수할지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_B\",\"toId\":\"VIBE_DELVE\",\"stateKeys\":[\"RouteState\",\"RiskState\"],\"fromSystem\":\"생활 공간 탐색 × 순교와 집단 결속\",\"toSystem\":\"금기와 기회의 교차\",\"trigger\":\"생활 공간 탐색 × 순교와 집단 결속의 선택: 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 순교와 집단 결속의 반작용을 선택한다. 기존 선행조건을 만족해 RouteState·RiskState 출력이 확정됐을 때 금기와 기회의 교차이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_B 출력 RouteState·RiskState → VIBE_DELVE 입력. 후속 선택: 신화 속 트릭스터의 질서 역전의 제약과 순교와 집단 결속의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_DELVE\",\"toId\":\"VIBE_MAIN\",\"stateKeys\":[\"WorldAccessState\",\"IntentState\"],\"fromSystem\":\"금기와 기회의 교차\",\"toSystem\":\"몬스터 어드벤처\",\"trigger\":\"금기와 기회의 교차의 선택: 신화 속 트릭스터의 질서 역전의 제약과 순교와 집단 결속의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 기존 선행조건을 만족해 WorldAccessState·IntentState 출력이 확정됐을 때 몬스터 어드벤처이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_DELVE 출력 WorldAccessState·IntentState → VIBE_MAIN 입력. 후속 선택: 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"},{\"fromId\":\"VIBE_A\",\"toId\":\"VIBE_DELVE\",\"stateKeys\":[\"RiskState\"],\"fromSystem\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"toSystem\":\"금기와 기회의 교차\",\"trigger\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전의 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 신화 속 트릭스터의 질서 역전의 제약을 감수할지 결정한다. 기존 선행조건을 만족해 RiskState 출력이 확정됐을 때 금기와 기회의 교차이 같은 키를 읽는다.\",\"stateChange\":\"VIBE_A 출력 RiskState → VIBE_DELVE 입력. 후속 선택: 신화 속 트릭스터의 질서 역전의 제약과 순교와 집단 결속의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.\"}],\"expansionPlan\":[{\"milestone\":\"초반 선택에 따른 접근 경로와 위험 재구성\",\"newGameplay\":\"사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.\",\"systemImpact\":\"VIBE_A의 기존 Luau 책임 함수에서 RouteState·RiskState 입력 → RiskState·ResourceState 출력 → VIBE_B의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.\",\"trigger\":\"기존 첫 진입 조건을 만족하고 몬스터 어드벤처의 목표를 확인한 뒤 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 접근 가능한 선택을 제시한다.\",\"playerChoice\":\"인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.\",\"ruleIds\":[\"VIBE_MAIN\",\"VIBE_A\",\"VIBE_B\"],\"stateKeys\":[\"RouteState\",\"RiskState\",\"ResourceState\"],\"failureRecovery\":\"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.\",\"validationEvidence\":\"동일 시작 상태에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다.\"},{\"milestone\":\"중반 두 시스템의 반작용과 대응 조건 충돌\",\"newGameplay\":\"생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.\",\"systemImpact\":\"VIBE_B의 기존 Luau 책임 함수에서 RiskState·ResourceState 입력 → RouteState·RiskState 출력 → VIBE_A의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.\",\"trigger\":\"직전 확장 단계의 행동 결과가 현재 RiskState·ResourceState와 일치할 때 후속 선택을 연다. 기존 해금 조건을 확인하며 임의 수치를 추가하지 않는다.\",\"playerChoice\":\"이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다.\",\"ruleIds\":[\"VIBE_MAIN\",\"VIBE_A\",\"VIBE_B\"],\"stateKeys\":[\"RiskState\",\"ResourceState\",\"RouteState\"],\"failureRecovery\":\"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.\",\"validationEvidence\":\"동일 시작 상태에서 생활 공간 탐색 × 순교와 집단 결속의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다.\"},{\"milestone\":\"숨겨진 세계 인과법칙을 이용한 새로운 접근\",\"newGameplay\":\"영웅서사의 이름과 평판과 후원과 인맥 관계의 조합에 다른 인간 갈등을 연결한다. 숨겨진 규칙의 발견으로 우회 접근과 새로운 대응법을 연다.\",\"systemImpact\":\"VIBE_A의 기존 Luau 책임 함수에서 RouteState·RiskState 입력 → RiskState·ResourceState 출력 → VIBE_B의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.\",\"trigger\":\"직전 확장 단계의 행동 결과가 현재 RouteState·RiskState와 일치할 때 후속 선택을 연다. 기존 해금 조건을 확인하며 임의 수치를 추가하지 않는다.\",\"playerChoice\":\"신화 속 트릭스터의 질서 역전의 제약과 순교와 집단 결속의 대응을 같은 지역에서 순서대로 시험한다.\",\"ruleIds\":[\"VIBE_MAIN\",\"VIBE_A\",\"VIBE_B\",\"VIBE_DELVE\"],\"stateKeys\":[\"RouteState\",\"RiskState\",\"ResourceState\"],\"failureRecovery\":\"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.\",\"validationEvidence\":\"동일 시작 상태에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다.\"},{\"milestone\":\"누적된 관계를 되짚는 재방문과 장기 숙련\",\"newGameplay\":\"발견된 단서와 숙련을 기존 시스템 두 개 이상의 새로운 운용으로 확장한다. 재방문 시 이전 행동이 만든 관계·접근 조건과 결말을 다시 평가한다.\",\"systemImpact\":\"VIBE_B의 기존 Luau 책임 함수에서 RiskState·ResourceState 입력 → RouteState·RiskState 출력 → VIBE_A의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.\",\"trigger\":\"직전 확장 단계의 행동 결과가 현재 RiskState·ResourceState와 일치할 때 후속 선택을 연다. 기존 해금 조건을 확인하며 임의 수치를 추가하지 않는다.\",\"playerChoice\":\"인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.와 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다.를 이전 결과와 비교해 재방문 경로를 고른다.\",\"ruleIds\":[\"VIBE_MAIN\",\"VIBE_A\",\"VIBE_B\",\"VIBE_DELVE\"],\"stateKeys\":[\"RiskState\",\"ResourceState\",\"RouteState\"],\"failureRecovery\":\"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.\",\"validationEvidence\":\"동일 시작 상태에서 생활 공간 탐색 × 순교와 집단 결속의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다.\"}],\"integrityNotes\":[\"이 결과는 정해진 설계 규칙의 도달성 계산이며 실제 게임 실행 결과를 의미하지 않는다.\",\"저장·동기화·실제 조작은 기존 개발 및 독립 QA 과정에서 추가 검증해야 한다.\"],\"formula\":\"MAIN × A × B × C + @\",\"existingGameGrammarMap\":{\"mode\":\"EXISTING_GAME_RECONSTRUCTION_FROM_CURRENT_DESIGN_AND_INSPECTED_SOURCE\",\"formula\":\"MAIN × A × B × C + @\",\"main\":\"몬스터 어드벤처: 몬스터 어드벤처. 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.과 사회관계 선택의 결과를 생활 공간 탐색로 전환하고 달라진 조건을 다시 활용한다.를 반복하는 게임이다.\",\"source\":\"DESIGNER_AUTHORED_ROLE_IDS_AND_STATE_LINKS\",\"roleSystemIds\":{\"MAIN\":\"VIBE_MAIN\",\"A\":\"VIBE_A\",\"B\":\"VIBE_B\",\"c\":[],\"AT\":[\"VIBE_DELVE\"]},\"majorAxes\":[{\"key\":\"A\",\"systemId\":\"VIBE_A\",\"name\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"source\":\"DESIGNER_AUTHORED_ROLE_A\"},{\"key\":\"B\",\"systemId\":\"VIBE_B\",\"name\":\"생활 공간 탐색 × 순교와 집단 결속\",\"source\":\"DESIGNER_AUTHORED_ROLE_B\"}],\"cSubElements\":[],\"sourcedAxes\":{\"A\":{\"system\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"material\":\"신화 속 트릭스터의 질서 역전\",\"materialDomain\":\"world trickster myth의 문화·역사 인과 소재\",\"stateChange\":\"정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 따라서 사회관계 선택의 경로와 비용이 바뀐다. 플레이어가 사회관계 선택을 선택하면 신화 속 트릭스터의 질서 역전의 규칙에 따라 다음 위험과 가능 행동이 변화한다. 그 결과 생활 공간 탐색 × 순교와 집단 결속의 다음 행동 조건이 달라진다.\"},\"B\":{\"system\":\"생활 공간 탐색 × 순교와 집단 결속\",\"material\":\"순교와 집단 결속\",\"materialDomain\":\"religion political history archetype의 문화·역사 인과 소재\",\"stateChange\":\"특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 따라서 생활 공간 탐색의 정보·대응이 바뀐다. 플레이어가 생활 공간 탐색을 선택하면 순교와 집단 결속의 규칙에 따라 처음 선택으로 되돌아갈 비용·정보·접근 조건이 변화한다. 그 결과 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 선택 비용과 경로가 달라진다.\"}},\"cGenreThemes\":[{\"name\":\"영웅서사의 이름과 평판\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"플레이어의 실제 행동보다 퍼진 이야기와 평판이 적·상점·세력의 규칙을 바꾼다. 그 결과 A와 B가 공유하는 조건이 바뀐다.\"},{\"name\":\"후원과 인맥 관계\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"관계망의 누구를 밀어주고 누구에게 빚지는지가 능력과 콘텐츠 접근을 결정한다. 그 결과 사건의 비용과 다음 선택이 달라진다.\"}],\"dCreations\":[],\"cPrimarySecondaryGenres\":[{\"role\":\"PRIMARY\",\"name\":\"생활\",\"gameplayEffect\":\"사회관계 선택와 생활 공간 탐색를 통한 중심 목표와 위험·보상을 판단한다.\"},{\"role\":\"SECONDARY\",\"name\":\"추리\",\"gameplayEffect\":\"영웅서사의 이름과 평판의 단서와 후원과 인맥 관계의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다.\"}],\"cGenreInterlock\":\"생활 장르의 주 목표를 진행하는 동안 추리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 추리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.\",\"cCausalWorldEffect\":\"신화 속 트릭스터의 질서 역전에 의해 바뀐 인물·지역의 상태는 순교와 집단 결속의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 영웅서사의 이름과 평판와 후원과 인맥 관계가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 그 결과 생활 공간 탐색의 가능 행동과 위험이 바뀌며, 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 다시 사회관계 선택의 조건을 바꾼다.\",\"atUnboundedGrowthRule\":\"금기와 기회의 교차 이후 새로운 발견은 A와 B, C 장르 반응의 서로 다른 조건을 실험해 새 길·정보·관계·숙련을 열고 제한 없이 깊어진다.\",\"standardGrammarVersion\":null,\"delveAtEvidence\":[\"금기와 기회의 교차: 약자·광대·사기꾼이 규칙의 빈틈을 이용해 질서를 뒤집는다. 상황을 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 방식으로 해석한다.\",\"되돌아온 선택: 개인의 패배나 죽음이 집단의 결속과 운동을 강화할 수 있다. 결과가 과거 선택의 의미를 바꿀 수 있음을 발견한다.\",\"두 소재의 숨은 규칙: 실제 힘과 별개로 이름·소문·평판이 타인의 행동을 결정한다. 원리와 개인의 힘보다 후원·인맥·은혜·빚의 연결망이 행동 가능성을 만든다. 원리가 동시에 작동함을 파악한다.\",\"역전된 종착점: 한쪽의 불리한 결과가 다른 쪽의 고급 활용 조건이 되는 인과 반전을 학습한다.\",\"금기와 기회의 교차\",\"초반 선택에 따른 접근 경로와 위험 재구성\",\"사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.\",\"중반 두 시스템의 반작용과 대응 조건 충돌\",\"생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.\",\"숨겨진 세계 인과법칙을 이용한 새로운 접근\"],\"sourceTreeFingerprint\":\"2965e871d466d6b079b43fe3210046941b296f231f877e09adbc85647f11cfc7\",\"rule\":\"MAIN_IS_GAME_TOPIC; A_AND_B_EACH_REQUIRE_SYSTEM_AND_SOURCE_MATERIAL; C_HAS_TWO_CREATIVE_MATERIALS_AND_PRIMARY_SECONDARY_DISTINCT_GENRES_WITH_GAMEPLAY_INTERLOCK; A_B_CAUSAL_PLAY_CHANGES_WORLD_STORY; @ IS_UNBOUNDED_DISCOVERY_MASTERY_AND_REVISIT\",\"identityRewriteRequired\":false,\"existingBalanceSaveEconomyAndAuthorityPreserved\":true},\"rule\":\"NEW_CONTENT_MUST_DEEPEN_MAIN_TOPIC_A_B_SOURCED_SYSTEMS_C_CREATIVE_THEMES_AND_PRIMARY_SECONDARY_GENRE_INTERLOCK; OPTIONAL_LEGACY_c_IS_NOT_C_OR_A_MAJOR_AXIS; @ IS_DELVE_LAYER; DECORATIVE_LORE_OR_PARALLEL_FEATURE_STACK_DOES_NOT_COUNT\",\"familiarHumanConflictShouldRemainReadable\":true}\nCAUSAL_GRAMMAR_BUILD_UP_RULE: NEW_CONTENT_MUST_DEEPEN_MAIN_TOPIC_A_B_SOURCED_SYSTEMS_C_CREATIVE_THEMES_AND_PRIMARY_SECONDARY_GENRE_INTERLOCK; OPTIONAL_LEGACY_c_IS_NOT_C_OR_A_MAJOR_AXIS; @ IS_DELVE_LAYER; DECORATIVE_LORE_OR_PARALLEL_FEATURE_STACK_DOES_NOT_COUNT\nEXISTING_GAME_MAIN_A_B_c_AT_MAP: {\"mode\":\"EXISTING_GAME_RECONSTRUCTION_FROM_CURRENT_DESIGN_AND_INSPECTED_SOURCE\",\"formula\":\"MAIN × A × B × C + @\",\"main\":\"몬스터 어드벤처: 몬스터 어드벤처. 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.과 사회관계 선택의 결과를 생활 공간 탐색로 전환하고 달라진 조건을 다시 활용한다.를 반복하는 게임이다.\",\"source\":\"DESIGNER_AUTHORED_ROLE_IDS_AND_STATE_LINKS\",\"roleSystemIds\":{\"MAIN\":\"VIBE_MAIN\",\"A\":\"VIBE_A\",\"B\":\"VIBE_B\",\"c\":[],\"AT\":[\"VIBE_DELVE\"]},\"majorAxes\":[{\"key\":\"A\",\"systemId\":\"VIBE_A\",\"name\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"source\":\"DESIGNER_AUTHORED_ROLE_A\"},{\"key\":\"B\",\"systemId\":\"VIBE_B\",\"name\":\"생활 공간 탐색 × 순교와 집단 결속\",\"source\":\"DESIGNER_AUTHORED_ROLE_B\"}],\"cSubElements\":[],\"sourcedAxes\":{\"A\":{\"system\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"material\":\"신화 속 트릭스터의 질서 역전\",\"materialDomain\":\"world trickster myth의 문화·역사 인과 소재\",\"stateChange\":\"정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 따라서 사회관계 선택의 경로와 비용이 바뀐다. 플레이어가 사회관계 선택을 선택하면 신화 속 트릭스터의 질서 역전의 규칙에 따라 다음 위험과 가능 행동이 변화한다. 그 결과 생활 공간 탐색 × 순교와 집단 결속의 다음 행동 조건이 달라진다.\"},\"B\":{\"system\":\"생활 공간 탐색 × 순교와 집단 결속\",\"material\":\"순교와 집단 결속\",\"materialDomain\":\"religion political history archetype의 문화·역사 인과 소재\",\"stateChange\":\"특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 따라서 생활 공간 탐색의 정보·대응이 바뀐다. 플레이어가 생활 공간 탐색을 선택하면 순교와 집단 결속의 규칙에 따라 처음 선택으로 되돌아갈 비용·정보·접근 조건이 변화한다. 그 결과 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 선택 비용과 경로가 달라진다.\"}},\"cGenreThemes\":[{\"name\":\"영웅서사의 이름과 평판\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"플레이어의 실제 행동보다 퍼진 이야기와 평판이 적·상점·세력의 규칙을 바꾼다. 그 결과 A와 B가 공유하는 조건이 바뀐다.\"},{\"name\":\"후원과 인맥 관계\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"관계망의 누구를 밀어주고 누구에게 빚지는지가 능력과 콘텐츠 접근을 결정한다. 그 결과 사건의 비용과 다음 선택이 달라진다.\"}],\"dCreations\":[],\"cPrimarySecondaryGenres\":[{\"role\":\"PRIMARY\",\"name\":\"생활\",\"gameplayEffect\":\"사회관계 선택와 생활 공간 탐색를 통한 중심 목표와 위험·보상을 판단한다.\"},{\"role\":\"SECONDARY\",\"name\":\"추리\",\"gameplayEffect\":\"영웅서사의 이름과 평판의 단서와 후원과 인맥 관계의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다.\"}],\"cGenreInterlock\":\"생활 장르의 주 목표를 진행하는 동안 추리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 추리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.\",\"cCausalWorldEffect\":\"신화 속 트릭스터의 질서 역전에 의해 바뀐 인물·지역의 상태는 순교와 집단 결속의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 영웅서사의 이름과 평판와 후원과 인맥 관계가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 그 결과 생활 공간 탐색의 가능 행동과 위험이 바뀌며, 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 다시 사회관계 선택의 조건을 바꾼다.\",\"atUnboundedGrowthRule\":\"금기와 기회의 교차 이후 새로운 발견은 A와 B, C 장르 반응의 서로 다른 조건을 실험해 새 길·정보·관계·숙련을 열고 제한 없이 깊어진다.\",\"standardGrammarVersion\":null,\"delveAtEvidence\":[\"금기와 기회의 교차: 약자·광대·사기꾼이 규칙의 빈틈을 이용해 질서를 뒤집는다. 상황을 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 방식으로 해석한다.\",\"되돌아온 선택: 개인의 패배나 죽음이 집단의 결속과 운동을 강화할 수 있다. 결과가 과거 선택의 의미를 바꿀 수 있음을 발견한다.\",\"두 소재의 숨은 규칙: 실제 힘과 별개로 이름·소문·평판이 타인의 행동을 결정한다. 원리와 개인의 힘보다 후원·인맥·은혜·빚의 연결망이 행동 가능성을 만든다. 원리가 동시에 작동함을 파악한다.\",\"역전된 종착점: 한쪽의 불리한 결과가 다른 쪽의 고급 활용 조건이 되는 인과 반전을 학습한다.\",\"금기와 기회의 교차\",\"초반 선택에 따른 접근 경로와 위험 재구성\",\"사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.\",\"중반 두 시스템의 반작용과 대응 조건 충돌\",\"생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.\",\"숨겨진 세계 인과법칙을 이용한 새로운 접근\"],\"sourceTreeFingerprint\":\"2965e871d466d6b079b43fe3210046941b296f231f877e09adbc85647f11cfc7\",\"rule\":\"MAIN_IS_GAME_TOPIC; A_AND_B_EACH_REQUIRE_SYSTEM_AND_SOURCE_MATERIAL; C_HAS_TWO_CREATIVE_MATERIALS_AND_PRIMARY_SECONDARY_DISTINCT_GENRES_WITH_GAMEPLAY_INTERLOCK; A_B_CAUSAL_PLAY_CHANGES_WORLD_STORY; @ IS_UNBOUNDED_DISCOVERY_MASTERY_AND_REVISIT\",\"identityRewriteRequired\":false,\"existingBalanceSaveEconomyAndAuthorityPreserved\":true}\nEXISTING_GAME_GRAMMAR_ACTION: MAIN=A+B+C+D+@ 기준으로 A는 이름 있는 대표 유사 장르 게임의 실제 시스템·플레이 경험을 출처와 함께 추상화하며 B는 우리 기존 게임의 실제 시스템·원본 출처·기존 상태/규칙을 보존한다. A→B와 B→A의 새로운 플레이어 선택·상태 전이를 설계한다. C는 작품 주/보조 장르, D는 고유 장소·존재·사건·규칙, @는 D 연관 연구·실험·새 선택이다. 조작·HUD·메뉴·카메라·월드 진행·성장·실패/재도전까지 원리를 참고하되 고유 화면/그래픽/캐릭터/문구/코드를 복제하지 않는다. 먼저 최신 설계를 빌드업하고 엄격 심사를 통과한 규칙 ID만 기존 책임 소스에 구현한다. 실제 입력→서버/웹 상태→피드백→저장/재접속과 동일 빌드 검증을 수행한다. 구형 C 소재 두 개 요구로 새 기본설계를 거부하지 않는다. 설계 문서는 게임 런타임 PASS가 아니다.\nPRIMARY_GOAL: 몬스터 어드벤처. 신화 속 트릭스터의 질서 역전·순교와 집단 결속 생활. 몬스터 어드벤처에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전과 생활 공간 탐색 × 순교와 집단 결속이 서로 결과를 되돌려 바꾸며 생활·추리의 판단이 실제 세계 상태를 변화시킨다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\nWHY_NOW: 현재 검증 신호와 소스에서 STABILITY를 우선한다. 게임 고유 앵커는 \"몬스터 어드벤처\", 현재 책임 소스는 roblox-games/monster-adventure/client/Game.client.luau::render, roblox-gam