t","artifactIdentity","placeOrSceneId","candidateVersion","platform","viewportOrDevice","scenarioId","inputSequence","observedStateBeforeAfter","captureReferenceAndSha256","remoteRunId","runtimeOrQaStage","failureSignature","responsibleSource","negativeCaseResult","finding","retestResult"],"evidenceRules":["현재 정확한 후보의 실제 플레이 장면만 사용한다. 대표 장면은 시작/로비, 핵심 행동, 위험/다중 적, 인벤/팝업, 지역 경계와 모바일이다. 해당 없는 장면은 설계/소스 이유를 기록한다.","로컬 수동 검수는 요구하지 않는다. 기존 원격 CI/F0~F9/독립 QA/Open Cloud에서 같은 sourceRevision·artifactIdentity·candidateVersion에 결속된 증거만 사용한다. 로컬 결과나 다른 버전의 증거를 합격으로 대체하지 않는다.","각 장면의 remoteAssertions를 기존 검사에서 실제 실행·측정한 뒤 실패/재시도/복구 분기까지 확인한다. F7 멀티는 중앙정책대로 정확한 소스 계약을 검사하며 실측한 다중 접속으로 허위 표시하지 않는다.","같은 카메라·입력·해상도·게임 상태의 전후 이미지와 상태 결과를 비교한다. 모션은 정지 이미지 한 장 대신 연속 프레임/시간 정보가 필요하다.","파일 존재·크기·PNG 서명·썸네일·자산 업로드·소스 마커·테스트 개수·반복 횟수는 시각 품질 합격을 증명하지 않는다.","중앙 정책에서 허용한 관찰 도구만 사용한다. 정확한 화면 관찰 수단이 없으면 시각 품질은 UNVERIFIED로 남기고 증거 수집 책임으로 반환한다. 증거 부재를 관찰된 그래픽 오류로 꾸미지 않는다.","실제 결함은 재현 장면→기존 책임 함수→최소 원인 수정→영향별 QA→정확 후보 재빌드→같은 장면 재검수로 반환한다. 같은 결함이 반복되면 미세 패치 누적 대신 근본 원인을 재평가한다.","검증된 개선만 다음 반복의 기준선으로 사용한다. 적용 항목 전체를 검토하되 실제 변화/실패 영향에 맞춰 검증 범위를 넓히고 다른 게임의 독립 작업을 막지 않는다."]},"experienceBuildUpContract":{"version":1,"status":"ACTIVE_EXECUTABLE_BUILD_UP_CONTRACT","platform":"ROBLOX","focus":"STABILITY","attention":"EXTRA","tracks":[{"track":"MOTION_AND_ACTING","status":"PRESENT"},{"track":"COMBAT_AND_PRIMARY_ACTION_FEEL","status":"PRESENT"},{"track":"UI_HUD_AND_MENU","status":"PRESENT"},{"track":"INVENTORY_AND_EQUIPMENT","status":"PRESENT"},{"track":"AUDIO_MUSIC_AND_FEEDBACK","status":"PRESENT"},{"track":"VFX_CAMERA_AND_IMPACT_SYNC","status":"PRESENT"},{"track":"WORLD_VISUAL_COHESION","status":"PRESENT"},{"track":"MOBILE_TOUCH_AND_ACCESSIBILITY","status":"PRESENT"},{"track":"PERFORMANCE_AND_RUNTIME_STABILITY","status":"PRESENT"}],"priorityOrder":["MOTION_AND_ACTING","AUDIO_MUSIC_AND_FEEDBACK","COMBAT_AND_PRIMARY_ACTION_FEEL","UI_HUD_AND_MENU","INVENTORY_AND_EQUIPMENT","VFX_CAMERA_AND_IMPACT_SYNC","WORLD_VISUAL_COHESION","MOBILE_TOUCH_AND_ACCESSIBILITY","PERFORMANCE_AND_RUNTIME_STABILITY"],"weakestTracks":[],"loop":["OBSERVE_CURRENT_RUNTIME_AND_PLAYER_FLOW","RANK_WEAKEST_APPLICABLE_TRACKS","IMPLEMENT_EXISTING_RESPONSIBLE_SYSTEMS_DIRECTLY","REPLAY_REAL_INPUTS_AND_CAPTURE_SAME_SCENE_BEFORE_AFTER","VERIFY_PLAYER_FACING_EFFECT_AND_NO_SEMANTIC_REGRESSION","PROMOTE_VERIFIED_BASELINE_OR_REPEAT"],"commonRules":["AUDIT_ALL_APPLICABLE_PLAYER_FACING_TRACKS_EVERY_GENERATION","RANK_AND_BUILD_THE_WEAKEST_THREE_BEFORE_ADDING_DECORATIVE_EXTRAS","PRESENCE_OR_MARKER_ONLY_CANNOT_PASS_QUALITY","IMPLEMENT_IN_THE_EXISTING_RESPONSIBLE_SYSTEM_NOT_A_SHADOW_WRAPPER","COMPARE_BEFORE_AFTER_UNDER_THE_SAME_SCENE_INPUT_AND_STATE","VERIFY_INPUT_TO_STATE_TO_MOTION_UI_AUDIO_VFX_CAMERA_FEEDBACK_CAUSALITY","PRESERVE_GAMEPLAY_BALANCE_SAVE_ECONOMY_AND_NETWORK_AUTHORITY","OWNER_INTENTIONALLY_DISABLED_AUDIO_CATEGORIES_MUST_REMAIN_DISABLED","REPEAT_BUILD_UP_UNTIL_NO_CRITICAL_PLAYER_FACING_TRACK_GAP_REMAINS"],"platformProfile":{"attention":"EXTRA","runtimeSurface":"EXACT_REMOTE_ROBLOX_CANDIDATE_F0_F9","requirements":["ARTICULATED_ACTOR_MOTION_WITH_ANIMATOR_MOTOR6D_OR_BONES","ROOT_ONLY_MOTION_CANNOT_PASS","IDLE_WALK_JOG_RUN_START_STOP_TURN_JUMP_LAND_HIT_DEATH_COVERAGE_WHEN_APPLICABLE","ANTICIPATION_IMPACT_RECOVERY_FOR_PRIMARY_ACTIONS","TOUCH_FIRST_UI_WITH_MINIMUM_44PX_EQUIVALENT_TARGETS","INVENTORY_COMPARE_EQUIP_UNEQUIP_REPLACE_FEEDBACK_WHEN_APPLICABLE","SOUNDSERVICE_SOUNDGROUP_MIXING_AND_SPATIAL_ROLLOFF_WHEN_AUDIO_APPLICABLE","REGION_OR_STATE_BGM_TRANSITION_WHEN_MULTIPLE_CONTEXTS_EXIST","VFX_CAMERA_AUDIO_SHARE_AUTHORITATIVE_IMPACT_EVENT","EXACT_SOURCE_ARTIFACT_CLOUD_RUNTIME_BEFORE_AFTER_AND_POST_PUBLISH_VERSION_QA"],"ownerDisabledAudioCategoriesMustRemainDisabled":true,"nativeRuntimeEvidenceRequired":true,"mobileRuntimeEvidenceRequired":true},"robloxExtra":{"priority":"EXTRA_ATTENTION","motion":{"articulatedActorsRequireJointMotion":true,"animatorMotor6dOrBonesRequiredWhenApplicable":true,"rootOnlyLocomotionCannotPass":true,"requiredStateIntent":["IDLE","WALK","JOG","RUN","START","STOP","TURN","JUMP","LAND","ATTACK_ANTICIPATION","IMPACT","RECOVERY","HIT_REACTION","DEATH"],"blendAndSpeedSyncRequired":true,"weightShiftAndSecondaryMotionRequired":true,"ikOrProceduralGroundingPreferred":true},"uiAndInventory":{"touchFirst":true,"minimumTouchTargetPxEquivalent":44,"safeAreaRequired":true,"modalStackBackCloseScrollSelectionPersistenceRequired":true,"inventoryFlowWhenApplicable":["ACQUIRE","COMPARE","SELECT","EQUIP","UNEQUIP_OR_REPLACE","CURRENT_EQUIPPED_INDICATOR","WORLD_OR_CHARACTER_FEEDBACK"]},"audio":{"ownerDisabledCategoriesPreserved":true,"soundServiceLifecycleRequired":true,"soundGroupMixingPreferred":true,"spatialWorldAudioUsesRolloffWhenApplicable":true,"bgmRegionStateCombatTransitionsRequiredWhenMultipleContextsExist":true,"duplicatePlaybackOnRespawnOrResumeForbidden":true,"singleLoopAcrossDistinctContextsCannotClaimMusicBuildUp":true},"runtimeEvidence":{"officialStudioMcpRequired":false,"localManualInspectionRequired":false,"existingF0F9AndIndependentQaRequired":true,"exactPrivateCandidateRemoteEvidenceRequired":true,"exactPublishedPlaceVersionQaRequired":true,"cloudThumbnailMetadataCannotProveRenderedScene":true,"optionalStudioCaptureCannotReplaceCanonicalEvidence":true,"actualInputRequired":true,"beforeAfterCaptureRequired":true,"mobileViewportRequired":true,"runtimeStateObservationRequired":true,"sourceMarkersAloneCannotPass":true}},"webExtra":null,"unityExtra":null,"ownerLocks":{"gameplayBalanceSaveEconomyNetworkMeaningPreserved":true,"intentionallyDisabledAudioCategoriesPreserved":true},"designIdentity":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다."},"uxInputDirectives":["핵심 행동, 위험, 현재 목표, 다음 선택을 모바일 화면에서 우선순위가 명확하게 보이게 한다.","터치 입력은 실제 게임 상태 변화에 연결하고 키보드/검증용 우회 입력이 모바일 PASS를 대신하지 못하게 한다.","실패/재시도/복귀 시 플레이어가 무엇이 유지되고 무엇이 초기화되는지 즉시 알 수 있게 한다.","HUD·메뉴·인벤토리·장비·설정은 같은 UI 디자인 언어와 정보 우선순위를 사용하고 뒤로가기/닫기/스크롤/팝업 중첩을 모바일에서 검증한다.","반복 조작은 편의 기능으로 줄이되 핵심 플레이 선택과 위험/보상 판단을 자동화하지 않는다."],"platformAdaptationDirectives":{"WEB":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.: \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"의 기본 설계 문법은 MAIN = A + B + C + D + @다. A/B 시스템과 C 주·보조 장르, D 구체 창작물, @의 D 기반 조사·선택을 공통 승인 설계의 상태·규칙·진행과 함께 연결한다. 일반 웹게임은 기존 web-games/<gameId> 책임 소스에서 실제 메시·삼각형·깊이 테스트·카메라가 있는 네이티브 3D 월드를 구현한다. 2D·2.5D·DOM 카드·평면 캔버스·표시 문자열은 최종 3D 통과로 인정하지 않는다. 신규 웹 원본은 PlayCanvas와 WebGL2 모바일 호환을 우선 검토하되 이미 실제로 동작하는 Three.js·Babylon.js·WebGL 엔진은 기존 코드·에셋·저장 보존을 위해 재사용하고 중복 렌더 파이프라인을 만들지 않는다. 기존 등록 GLB/glTF 3D 에셋과 라이선스를 재사용하고 터치·카메라 조작·리사이즈·프레임·발열·배터리·메모리·재시작·저장 복원과 실제 WebGL 드로우를 동일 버전의 모바일 브라우저에서 검증한다. 원래 규칙·전투 수치·드랍·재화·멀티 서버 권한·저장 키를 임의로 변경하지 않는다. 플랫폼별 재설계는 금지하고 게임 규칙 확장은 승인된 공통 원본 개정으로만 반영한다. Unity Web/Android는 별도 OWNER_HOLD를 유지하며 일반 WEB 허용을 Unity 권한으로 확장하지 않는다. 새 큐·파이프라인은 생성하지 않고 기존 BUILD_UP과 F0~F9 및 독립 브라우저 QA로만 진행한다. 런타임 증거가 없으면 미검증으로 남기고 기존 2D 게임은 검증된 3D 교체 전까지 보존한다.","ROBLOX":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.: 동일 공통 목표 \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"를 Roblox 네이티브 Luau/server-client/Remote/touch/3D presentation 구조로 구현한다. 게임 원본은 roblox-games/<gameId>/의 Roblox Luau다. 설계 생성부터 MAIN = A + B + C + D + @의 상태 입력·출력·시스템 연결을 기존 Luau 서버·공유·클라이언트 책임 함수에 연결한다. 유니티 웹·안드로이드는 보류이며 C#를 원본이나 필수 변환 입력으로 요구하지 않는다. 남아 있는 유니티 소스는 선택적 호환 비교 자료일 뿐 규칙 권한이 없다. 설계 문법 → 실제 시스템 구현 → 연결된 콘텐츠 확장 → 내부 자산 적용 → 원본 소스 변경 → 기존 F0~F9 검증 → 다음 빌드업으로 이어간다. 각 시스템·콘텐츠는 실제 함수와 상태 변경 및 런타임 행동 결과로 확인한다. MAIN = A + B + C + D + @·규칙·상태·진행·멀티는 공통 원본을 따른다. C는 메인·보조 장르의 인과이며 D는 출처를 가진 구체 창작, @는 D와 연결된 연구·실험·다음 선택이다. 이전 C 소재 2개는 구형 설계 호환에서만 검증하며 소문자 c도 기존 원본에 있을 때만 보존한다. 플랫폼별 재설계는 금지하고 게임 규칙 확장은 공통 원본 개정으로 돌아간다. 현재 개발 대상은 Roblox와 일반 WEB이며 Roblox 원본 언어는 Luau다. 플레이어/NPC/크리처의 관절 기반 Animator·Motor6D/Bone 모션, idle/walk/jog/run/start/stop/turn/jump/land/attack anticipation-impact-recovery/hit/death 전환, 무게 이동·보조 모션을 실제 상태에 연결하고 root/CFrame 전체 이동만으로 모션 PASS를 주장하지 않는다. HUD/메뉴/인벤은 44px 상당 터치 타깃·safe area·스크롤·닫기·선택 유지·장착 표시·교체 피드백을 검증한다. 오디오는 owner가 끈 카테고리는 되살리지 않되 SoundService/SoundGroup 수명주기, 월드 3D rolloff, 지역/상태/전투 BGM 전환과 중복 재생 방지를 실제 Roblox 클라우드 API 런타임에서 확인한다. VFX·카메라·오디오는 authoritative impact에 동기화하고 중앙 정책의 Roblox 클라우드 API 전후 증거와 실제 행동 결과가 없으면 체감 품질 완료로 계산하지 않는다. 다른 플랫폼 구현을 그대로 복사하지 않는다.","UNITY":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.: MAIN = A + B + C + D + @ 공통 원본의 규칙과 상태를 보존하며 \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"를 Unity 네이티브 코드로 구현한다. 플랫폼별 재설계는 금지하고 입력·물리 표현·카메라·애니메이션·UI·성능·저장 전송을 같은 원본에 맞게 적용한다. 게임 규칙 확장은 공통 원본 개정으로 돌아간다. Animator/BlendTree 또는 동등 상태 모션, Canvas safe area와 인벤/메뉴 흐름, AudioMixer/AudioSource 상태 전환, Android 터치 런타임과 프레임·메모리 예산을 Unity 특성에 맞게 응용한다.","FORTNITE_UEFN":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.: MAIN = A + B + C + D + @ 동일 공통 목표 \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"를 Fortnite UEFN의 Verse/device/world/replication 구조와 플레이 공간에 맞게 구현한다. Roblox/Unity/Web 코드를 직역하지 말고 UEFN 네이티브 책임과 멀티플레이 권한을 사용한다.","UNITY_WEB":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.: \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"의 기본 설계 문법은 MAIN = A + B + C + D + @다. A/B 시스템과 C 주·보조 장르, D 구체 창작물, @의 D 기반 조사·선택을 공통 승인 설계의 상태·규칙·진행과 함께 연결한다. 일반 웹게임은 기존 web-games/<gameId> 책임 소스에서 실제 메시·삼각형·깊이 테스트·카메라가 있는 네이티브 3D 월드를 구현한다. 2D·2.5D·DOM 카드·평면 캔버스·표시 문자열은 최종 3D 통과로 인정하지 않는다. 신규 웹 원본은 PlayCanvas와 WebGL2 모바일 호환을 우선 검토하되 이미 실제로 동작하는 Three.js·Babylon.js·WebGL 엔진은 기존 코드·에셋·저장 보존을 위해 재사용하고 중복 렌더 파이프라인을 만들지 않는다. 기존 등록 GLB/glTF 3D 에셋과 라이선스를 재사용하고 터치·카메라 조작·리사이즈·프레임·발열·배터리·메모리·재시작·저장 복원과 실제 WebGL 드로우를 동일 버전의 모바일 브라우저에서 검증한다. 원래 규칙·전투 수치·드랍·재화·멀티 서버 권한·저장 키를 임의로 변경하지 않는다. 플랫폼별 재설계는 금지하고 게임 규칙 확장은 승인된 공통 원본 개정으로만 반영한다. Unity Web/Android는 별도 OWNER_HOLD를 유지하며 일반 WEB 허용을 Unity 권한으로 확장하지 않는다. 새 큐·파이프라인은 생성하지 않고 기존 BUILD_UP과 F0~F9 및 독립 브라우저 QA로만 진행한다. 런타임 증거가 없으면 미검증으로 남기고 기존 2D 게임은 검증된 3D 교체 전까지 보존한다.","UNITY_APP":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.: MAIN = A + B + C + D + @ 공통 원본의 규칙과 상태를 보존하며 \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"를 Unity 네이티브 코드로 구현한다. 플랫폼별 재설계는 금지하고 입력·물리 표현·카메라·애니메이션·UI·성능·저장 전송을 같은 원본에 맞게 적용한다. 게임 규칙 확장은 공통 원본 개정으로 돌아간다. Animator/BlendTree 또는 동등 상태 모션, Canvas safe area와 인벤/메뉴 흐름, AudioMixer/AudioSource 상태 전환, Android 터치 런타임과 프레임·메모리 예산을 Unity 특성에 맞게 응용한다.","UNREAL":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.: MAIN = A + B + C + D + @ 동일 공통 목표 \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"를 Fortnite UEFN의 Verse/device/world/replication 구조와 플레이 공간에 맞게 구현한다. Roblox/Unity/Web 코드를 직역하지 말고 UEFN 네이티브 책임과 멀티플레이 권한을 사용한다.","UEFN":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.: MAIN = A + B + C + D + @ 동일 공통 목표 \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"를 Fortnite UEFN의 Verse/device/world/replication 구조와 플레이 공간에 맞게 구현한다. Roblox/Unity/Web 코드를 직역하지 말고 UEFN 네이티브 책임과 멀티플레이 권한을 사용한다."},"robloxNativeExecution":{"version":1,"required":true,"responsibleFiles":["roblox-games/fantasy-survival/client/Game.client.luau","roblox-games/fantasy-survival/client/MaterialPresentation.client.luau","roblox-games/fantasy-survival/shared/RobloxCommonUI.luau","roblox-games/fantasy-survival/server/Game.server.luau","roblox-games/fantasy-survival/shared/GameConfig.luau","roblox-games/fantasy-survival/shared/RobloxCommonMaterials.luau","roblox-games/fantasy-survival/default.project.json"],"sourceSymbolsOrStateAnchors":[{"file":"roblox-games/fantasy-survival/shared/RobloxCommonUI.luau","line":3921,"kind":"FUNCTION","symbol":"sync","currentBehavior":"local function sync(state)","intendedBehavior":"STABILITY primary goal \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"에 맞춰 sync의 입력/조건→상태 변화→피드백 연결을 직접 심화하고, 플레이어 관찰 결과가 \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.에서 동일 입력과 상태가 반복 가능한 결과를 만들고 진행 차단·복구 실패가 사라진다.\"가 되게 한다.","observableAcceptance":"roblox-games/fantasy-survival/shared/RobloxCommonUI.luau에 실제 source delta가 있고 관련 QA/runtime에서 STABILITY 상태 변화와 expected player effect가 관찰되어야 함"},{"file":"roblox-games/fantasy-survival/shared/RobloxCommonUI.luau","line":3960,"kind":"FUNCTION","symbol":"sync","currentBehavior":"local function sync(state)","intendedBehavior":"STABILITY primary goal \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.\"에 맞춰 sync의 입력/조건→상태 변화→피드백 연결을 직접 심화하고, 플레이어 관찰 결과가 \"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.에서 동일 입력과 상태가 반복 가능한 결과를 만들고 진행 차단·복구 실패가 사라진다.\"가 되게 한다.","observableAcceptance":"roblox-games/fantasy-survival/shared/RobloxCommonUI.luau에 실제 source delta가 있고 관련 QA/runtime에서 STABILITY 상태 변화와 expected player effect가 관찰되어야 함"},{"file":"roblox-games/fantasy-survival/shared/RobloxCommonUI.luau","line":3976,"kind":"FUNCTION","symbol":"sync","currentBehavior":"local function sync(sta