TATE","authorityRule":"damage/reward/currency/inventory/progression/save authoritative mutation remains server-owned when applicable"}],"expectedPlayerEffect":"기존 마력숲 생존기의 세계관·지역·스토리·퀘스트·전투·제작·진행·세이브 의미를 그대로 보존하고 표현 품질만 단계적으로 높이는 보존형 Vibe 파일럿이다.에서 동일 입력과 상태가 반복 가능한 결과를 만들고 진행 차단·복구 실패가 사라진다.","observableAcceptanceScenario":"input/touch -> local handler -> RemoteEvent/RemoteFunction when required -> server validation -> authoritative state change -> client feedback","sourceInspectionChecklist":["SERVER_AUTHORITY","CLIENT_PRESENTATION","REMOTE_EVENTS_AND_FUNCTIONS","TOUCH_INPUT","CHARACTER_RESPAWN","DATASTORE_SAVE_LOAD","UI_STATE","CORE_STATE_MACHINE","MULTIPLAYER_SYNC"],"codeQualityChecks":["NO_UNBOUNDED_WHILE_LOOP","NO_LEAKED_CONNECTIONS","NO_DUPLICATE_REMOTE_PATH","NO_CLIENT_AUTHORITATIVE_GAMEPLAY_MUTATION","BOUNDED_DATASTORE_RETRY","REMOTE_INPUT_VALIDATION","NO_STALE_CHARACTER_REFERENCE_AFTER_RESPAWN"],"implementationRule":"read existing Roblox responsibilities first; modify the existing responsible function/module directly; do not translate Unity/Web code literally","actualPlayRule":"after the changed behavior becomes executable and the existing runtime-foundation gate passes, replay the exact changed scenario through official Studio MCP and feed the observed result back into causal repair"},"productionPlan":null,"robloxProductionPlan":null,"internalAlgorithmUse":{"mode":"MAXIMIZE_TASK_RELEVANT_VERIFIED_INTERNAL_ALGORITHMS","priority":["SAME_GAME_SAME_FAILURE_VERIFIED_CAUSAL_AND_CODE_PATTERN","SAME_GAME_VERIFIED_IMPLEMENTATION_AND_RESPONSIBILITY","EXISTING_VIBE2_VIBE3_ANALYSIS_STRATEGY_RECOMBINATION_AND_GAMEPLAY_TOOLS","EXISTING_VERIFIED_GAME_MECHANICS_ASSETS_AND_SOURCE_COMPOSITION","AUTHORIZED_AI_COLLABORATION_ON_DISJOINT_RESPONSIBILITY_WITH_CANDIDATE_BRANCH_QA"],"relevantAlgorithmsOnly":true,"aiCollaboration":{"authority":"company-learning/platform-release-roadmap.json#externalAiVibeFullProcessCollaboration","vibePrimaryIntegrationAndLearning":true,"approvedExternalAiMayImplementOnIsolatedCandidateBranch":true,"existingAuthorizedAiRoles":["PLANNING","DESIGN","IMPLEMENTATION","REPAIR","QA","ASSETS","PLATFORM_ADAPTATION"],"sameResponsibleFileConflictSerialized":true,"disjointResponsibleFilesMayRunParallel":true,"externalAiUseRequiresExistingOptInAndAuthorization":true,"deterministicallyVerifiedOutcomesFeedExistingLearningMotor":true,"externalAiCannotWriteMainOrCentralPolicyOrApproveOwnWork":true},"noDuplicateSubsystemsOrNewPipeline":true,"noUnverifiedCapabilityClaims":true,"preserveApprovedGameplaySaveEconomyAndServerAuthority":true,"qaReleaseSecurityGatesUnchanged":true,"rule":"AI_COLLABORATION_VIBE_PRIMARY_INTEGRATION_AND_LEARNING; MAXIMIZE_RELEVANT_VERIFIED_INTERNAL_ALGORITHMS_AND_SAME_GAME_SAME_FAILURE_PATTERNS; AUTHORIZED_EXTERNAL_AI_MAY_DEVELOP_AND_REPAIR_ON_ISOLATED_CANDIDATE_BRANCHES_WITH_RESPONSIBLE_FILE_SCOPE_WHEN_ENABLED; PARALLEL_DISJOINT_FILES_SERIALIZE_CONFLICTS; DETERMINISTIC_QA_SECURITY_AND_CANONICAL_RELEASE_REQUIRED; FEED_VERIFIED_RESULTS_TO_EXISTING_LEARNING_MOTOR; NEVER_CREATE_SHADOW_PIPELINE_OR_FABRICATE_PASS"},"preserveConstraints":["게임 제작은 Vibe와 승인된 AI 협업으로 진행한다. 검증된 내부 분석·게임 로직·전략선택·재조합·에셋 재사용 알고리즘을 과제 관련 범위에서 최대 활용한다. 외부 AI는 기존 승인·활성화 조건 아래 격리 후보 브랜치의 독립 책임 파일에 직접 구현·수리 가능하며 Vibe가 통합·학습한다. 중앙정책·QA·보안·배포 게이트를 유지하고 중복 파이프라인·미검증 주장은 금지한다.","기존 세이브 키와 의미를 명시적 마이그레이션 없이 변경하지 않는다.","승인 없는 밸런스/경제/보상/드랍/쿨다운/히트 의미 변경 금지.","멀티플레이 권한과 authoritative state를 프레젠테이션 이유로 클라이언트로 이동하지 않는다.","wrapper/shadow/temporary override 대신 기존 책임 시스템을 직접 수정한다."],"responsibleSystemsAndFiles":{"files":["roblox-games/fantasy-survival/client/Game.client.luau","roblox-games/fantasy-survival/client/MaterialPresentation.client.luau","roblox-games/fantasy-survival/shared/RobloxCommonUI.luau","roblox-games/fantasy-survival/server/Game.server.luau","roblox-games/fantasy-survival/shared/GameConfig.luau","roblox-games/fantasy-survival/shared/RobloxCommonMaterials.luau","roblox-games/fantasy-survival/default.project.json"],"sourceAnchors":[{"f