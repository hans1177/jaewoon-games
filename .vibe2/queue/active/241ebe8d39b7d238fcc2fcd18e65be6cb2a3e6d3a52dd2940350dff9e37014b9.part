-games/fantasy-survival/shared/RobloxCommonUI.luau\"]}],\"worldGraph\":{\"enabled\":true,\"biomeSourceFiles\":[],\"housingSourceFiles\":[\"roblox-games/fantasy-survival/shared/RobloxCommonUI.luau\"]},\"sourceOnlyEvidence\":true,\"implementationProven\":false,\"runtimeVerified\":false}\nAUTO_COMPOSITION_RULE: For every present feature, edit its real game owner only. Connect existing lobby/customization/material/inventory/equipment/UI/world/biome/housing/motion/action and source-grounded NPC AI/quest/dialogue/crafting/economy/progression/farming/weather/physics/camera/audio/skill effects/network only when game source and approved design contain them. Biomes must map approved regions to real native terrain/navigation/streaming; housing must preserve placement/cost/ownership/save/rejoin; customization must use actual character model and saved identity; motion must drive existing actions and approved hit events; NPC decisions must not grant economy/save/combat authority; crafting and shopping use actual items/currency/state. Use applicable moduleConnections as source-only QA work units, never completed features. Mobile HUD must use real input/state; no dead controls. Trace acquisition→store→equip→visual/stat→save→reconnect with authoritative state; source signatures never pass QA. No new asset generation or shadow system.\nPLAYER_FACING_INSPECTION_CONTRACT:\ninspectionContract=EVERY_CYCLE; REMOTE_AUTOMATED_F0_F9_AND_INDEPENDENT_QA_ONLY; LOCAL_MANUAL_INSPECTION_NOT_REQUIRED; CHECKLIST_NOT_EXECUTED; QUALITY_UNVERIFIED; inspect all applicable surfaces, expand current details from playerFacingInspectionContract; not-applicable needs design/source reason.\ninspectionIndex=UI_LAYOUT:INSPECT_EXISTING_OR_APPROVED_SURFACE|UI_INTERACTION:INSPECT_EXISTING_OR_APPROVED_SURFACE|CHARACTER_RENDER:INSPECT_EXISTING_OR_APPROVED_SURFACE|MONSTER_READABILITY:INSPECT_EXISTING_OR_APPROVED_SURFACE|MOTION_TRANSITIONS:INSPECT_EXISTING_OR_APPROVED_SURFACE\ninspectionRemoteMatrix=UI_LAYOUT:MOBILE_VIEWPORT_SAFE_AREA/TEXT_OVERFLOW_AND_HUD_OCCLUSION/RESIZE_AND_ORIENTATION|UI_INTERACTION:TOUCH_EVENT_TO_ONE_SERVER_OR_UI_ACTION/SCROLL_MODAL_FOCUS/CLOSE_REOPEN_SELECTION|CHARACTER_RENDER:REGISTERED_ASSET_AND_ORIGINAL_HASH/MESH_RIG_ATTACHMENT/MOVEMENT_GROUND_CONTACT|MONSTER_READABILITY:DISTINCT_ENEMY_ROLE_AND_TELEGRAPH/ATTACK_HIT_DEATH_STATE_SEQUENCE/DESPAWN_CLEANUP|MOTION_TRANSITIONS:TIME_ORDERED_IDLE_MOVE_TURN_JUMP/JOINT_ANIMATION_AND_BLEND/ATTACK_HIT_DEATH_NO_STALE_TRACK\ninspectionIndex=ACTION_IMPACT:INSPECT_EXISTING_OR_APPROVED_SURFACE|CAMERA_COMPOSITION:INSPECT_EXISTING_OR_APPROVED_SURFACE|WORLD_BACKGROUND:INSPECT_EXISTING_OR_APPROVED_SURFACE|GRAPHICS_INTEGRITY:INSPECT_EXISTING_OR_APPROVED_SURFACE|NAVIGATION_BLOCKERS:INSPECT_EXISTING_OR_APPROVED_SURFACE\ninspectionRemoteMatrix=ACTION_IMPACT:AUTHORITATIVE_HIT_EVENT_ORDER/MISS_CANCEL_COOLDOWN_REPLAY/VFX_AUDIO_DAMAGE_ALIGNMENT|CAMERA_COMPOSITION:WALL_AND_CORNER_OCCLUSION/TARGET_AND_PLAYER_READABILITY/MOBILE_CAMERA_INPUT|WORLD_BACKGROUND:SPAWN_TO_OBJECTIVE_WORLD_ROUTE/LANDMARK_AND_TERRAIN_BINDING/LIGHTING_AND_REGION_STATE|GRAPHICS_INTEGRITY:EXACT_MODEL_TEXTURE_LOAD/VISIBLE_RENDERED_DELTA/LOD_AND_RELOAD_RECOVERY|NAVIGATION_BLOCKERS:SPAWN_GROUND_CONTACT/PORTAL_DOOR_ROUTE_REACHABILITY/RESPAWN_SAFE_RECOVERY\ninspectionIndex=PROGRESSION_BLOCKERS:INSPECT_EXISTING_OR_APPROVED_SURFACE|RECOVERY_SAVE:INSPECT_EXISTING_OR_APPROVED_SURFACE|MULTIPLAYER_CONSISTENCY:INSPECT_EXISTING_OR_APPROVED_SURFACE|MOBILE_PERFORMANCE:INSPECT_EXISTING_OR_APPROVED_SURFACE|LOBBY_SPACES:INSPECT_EXISTING_OR_APPROVED_SURFACE\ninspectionRemoteMatrix=PROGRESSION_BLOCKERS:CORE_LOOP_ACTION_TO_REWARD/UNLOCK_NEXT_OBJECTIVE/RETRY_IDEMPOTENT_REWARDS|RECOVERY_SAVE:SAVE_EXIT_REJOIN_RESTORE/OLD_SAVE_COMPATIBILITY/NO_DUPLICATION_OR_LOSS|MULTIPLAYER_CONSISTENCY:EXACT_SOURCE_F7_SERVER_AUTHORITY_CONTRACT/REPLICATION_AND_RECONNECT_SOURCE_QA/NO_UNVERIFIED_MULTI_CLIENT_PASS|MOBILE_PERFORMANCE:INPUT_LATENCY_AND_FRAME_BUDGET/PARTICLE_OBJECT_LIFETIME/MEMORY_AND_MOBILE_VIEWPORT|LOBBY_SPACES:EXISTING_LOBBY_ENTRY_AND_EXIT/SPAWN_INTERACTION_ROUTE/NO_GAMEPLAY_OR_SAVE_SIDE_EFFECT\ninspectionEvidence=EXACT_GAME_SOURCE_TREE_ARTIFACT_VERSION_SCENE_VIEWPORT_INPUT_STATE_CAPTURE_SHA256_REMOTE_RUN_STAGE_NEGATIVE_CASE_FINDING_OWNER_RETEST; compare same scene before/after; motion needs timed frames. Thumbnail/transport/static QA/counts never prove visual quality.\ninspectionRule=Use centrally allowed observation only. Missing exact render stays UNVERIFIED, not an invented defect/PASS. Reproduce real failure, repair existing owner, run impact QA, rebuild/replay same scene; preserve save/balance/server authority.\ninspectionScene=RECOVERY_SAVE:사망→재시작→로비 복귀, 기존 저장→이탈→재접속, 로드/네트워크 실패\ninspectionFailure=RECOVERY_SAVE:세이브 초기화·아이템 소실/복제·옛 UI 상태·영구 로딩·오류 숨김·복구 버튼 무효\ninspectionOwner=RECOVERY_SAVE:기존 저장 키·세션 수명·오류 처리·재접속\ninspectionRetest=RECOVERY_SAVE:같은 저장 의미와 권한으로 복구; 기존 데이터/보상 보존\ninspectionRemoteChecks=RECOVERY_SAVE:SAVE_EXIT_REJOIN_RESTORE,OLD_SAVE_COMPATIBILITY,NO_DUPLICATION_OR_LOSS; result=UNVERIFIED_UNTIL_EXACT_REMOTE_PROOF\nEXPERIENCE_BUILD_UP: {\"version\":1,\"platform\":\"ROBLOX\",\"attention\":\"EXTRA\",\"runtimeSurface\":\"EXACT_REMOTE_ROBLOX_CANDIDATE_F0_F9\",\"weakestTracks\":[],\"loop\":[\"OBSERVE_CURRENT_RUNTIME_AND_PLAYER_FLOW\",\"RANK_WEAKEST_APPLICABLE_TRACKS\",\"IMPLEMENT_EXISTING_RESPONSIBLE_SYSTEMS_DIRECTLY\",\"REPLAY_REAL_INPUTS_AND_CAPTURE_SAME_SCENE_BEFORE_AFTER\",\"VERIFY_PLAYER_FACING_EFFECT_AND_NO_SEMANTIC_REGRESSION\",\"PROMOTE_VERIFIED_BASELINE_OR_REPEAT\"],\"rules\":[\"EXACT_REMOTE_CANDIDATE_EVIDENCE\",\"INPUT_TO_STATE_TO_PLAYER_FEEDBACK\",\"NO_SOURCE_OR_THUMBNAIL_PASS\",\"SAME_SCENE_BEFORE_AFTER\",\"PRESERVE_SAVE_BALANCE_ECONOMY_AND_AUTHORITY\"],\"robloxRemoteProof\":{\"officialStudioMcpRequired\":false,\"localManualInspectionRequired\":false,\"existingF0F9AndIndependentQaRequired\":true,\"exactPrivateCandidateRemoteEvidenceRequired\":true,\"exactPublishedPlaceVersionQaRequired\":true,\"cloudThumbnailMetadataCannotProveRenderedScene\":true,\"optionalStudioCaptureCannotReplaceCanonicalEvidence\":true,\"actualInputRequired\":true,\"beforeAfterCaptureRequired\":true,\"mobileViewportRequired\":true,\"runtimeStateObservationRequired\":true,\"sourceMarkersAloneCannotPass\":true},\"details\":\"Full source-grounded experienceBuildUpContract and playerFacingInspectionContract remain canonical for each existing BUILD_UP task\"}\nUX_INPUT: 핵심 행동, 위험, 현재 목표, 다음 선택을 모바일 화면에서 우선순위가 명확하게 보이게 한다. | 터치 입력은 실제 게임 상태 변화에 연결하고 키보드/검증용 우회 입력이 모바일 PASS를 대신하지 못하게 한다. | 실패/재시도/복귀 시 플레이어가 무엇이 유지되고 무엇이 초기화되는지 즉시 알 수 있게 한다. | HUD·메뉴·인벤토리·장비·설정은 같은 UI 디자인 언어와 정보 우선순위를 사용하고 뒤로가기/닫기/스크롤/팝업 중첩을 모바일에서 검증한다. | 반복 조작은 편의 기능으로 줄이되 핵심 플레이 선택과 위험/보상 판단을 자동화하지 않는다.\nROBLOX_NATIVE_RESPONSIBLE_FILES: roblox-games/fantasy-survival/client/Game.client.luau | roblox-games/fantasy-survival/client/MaterialPresentation.client.luau | roblox-games/fantasy-survival/shared/RobloxCommonUI.luau | roblox-games/fantasy-survival/server/Game.server.luau | roblox-games/fantasy-survival/shared/GameConfig.luau | roblox-games/fantasy-survival/shared/RobloxCommonMaterials.luau | roblox-games/fantasy-survival/default.project.json\nROBLOX_NATIVE_SERVER_CLIENT: roblox-games/fantasy-survival/shared/RobloxCommonUI.luau:sync:SHARED_MODULE_OR_STATE | roblox-games/fantasy-survival/shared/RobloxCommonUI.luau:sync:SHARED_MODULE_OR_STATE | roblox-games/fantasy-survival/shared/RobloxCommonUI.luau:sync:SHARED_MODULE_OR_STATE | roblox-games/fantasy-survival/shared/RobloxCommonUI.luau:sync:SHARED_MODULE_OR_STATE | roblox-games/fantasy-survival/shared/RobloxCommonUI.luau:sync:SHARED_MODULE_OR_STATE | roblox-games/fantasy-survival/shared/RobloxCommonUI.luau:sync:SHARED_MODULE_OR_STATE | roblox-games/fantasy-survival/client/Game.client.luau:render:CLIENT_INPUT_OR_PRESENTATION | roblox-games/fantasy-survival/shared/RobloxCommonUI.luau:sync:SHARED_MODULE_OR_STATE\nROBLOX_NATIVE_FUNCTIONAL_ACCEPTANCE: input/touch -> local handler -> RemoteEvent/RemoteFunction when required -> server validation -> authoritative state change -> client feedback\nROBLOX_NATIVE_SOURCE_INSPECTION: SERVER_AUTHORITY,CLIENT_PRESENTATION,REMOTE_EVENTS_AND_FUNCTIONS,TOUCH_INPUT,CHARACTER_RESPAWN,DATASTORE_SAVE_LOAD,UI_STATE,CORE_STATE_MACHINE,MULTIPLAYER_SYNC\nROBLOX_NATIVE_CODE_QUALITY: NO_UNBOUNDED_WHILE_LOOP,NO_LEAKED_CONNECTIONS,NO_DUPLICATE_REMOTE_PATH,NO_CLIENT_AUTHORITATIVE_GAMEPLAY_MUTATION,BOUNDED_DATASTORE_RETRY,REMOTE_INPUT_VALIDATION,NO_STALE_CHARACTER_REFERENCE_AFTER_RESPAWN\nPRESERVE: 게임 제작은 Vibe와 승인된 AI 협업으로 진행한다. 검증된 내부 분석·게임 로직·전략선택·재조합·에셋 재사용 알고리즘을 과제 관련 범위에서 최대 활용한다. 외부 AI는 기존 승인·활성화 조건 아래 격리 후보 브랜치의 독립 책임 파일에 직접 구현·수리 가능하며 Vibe가 통합·학습한다. 중앙정책·QA·보안·배포 게이트를 유지하고 중복 파이프라인·미검증 주장은 금지한다. | 기존 세이브 키와 의미를 명시적 마이그레이션 없이 변경하지 않는다. | 승인 없는 밸런스/경제/보상/드랍/쿨다운/히트 의미 변경 금지. | 멀티플레이 권한과 authoritative state를 프레젠테이션 이유로 클라이언트로 이동하지 않는다. | wrapper/shadow/temporary override 대신 기존 책임 시스템을 직접 수정한다.\nACCEPTANCE: CURRENT_GAME_SOURCE_CHANGED_IN_RESPONSIBLE_SYSTEM | WORKFLOW_QA_HOMEPAGE_ONLY_CHANGE_DOES_NOT_COUNT | GAMEPLAY_CLAIM_REQUIRES_OBSERVABLE_GAME_STATE_DELTA | VISUAL_CLAIM_REQUIRES_ACTUAL_RENDERED_DELTA | BEFORE_AFTER_OR_VERIFIED_BASELINE_COMPARISON | NO_PROTECTED_SAVE_BALANCE_ECONOMY_NETWORK_SEMANTIC_REGRESSION | FOUNDATION_ONLY_REPAIR_COUNTS_ONLY_WHEN_FOUNDATION_IS_THIS_DIRECTIVE_PRIMARY_VERIFIED_GAP | HOLISTIC_CORE_DOMAINS_CLASSIFIED_PASS_GAP_OR_NOT_APPLICABLE | EXISTING_APPLICABLE_GAP_CANNOT_BE_SILENTLY_SKIPPED | FIRST_10_MINUTES_AND_SESSION_FLOW_REVIEWED | MAP_INVENTORY_UI_CONVENIENCE_AND_SYSTEM_CONNECTION_REVIEWED_WHEN_APPLICABLE | MOTION_UI_INVENTORY_AUDIO_VFX_CAMERA_WORLD_MOBILE_PERFORMANCE_TRACKS_REVIEWED | PRESENCE_ONLY_OR_MARKER_ONLY_CANNOT_CLOSE_PLAYER_FACING_QUALITY | SAME_SCENE_BEFORE_AFTER_RUNTIME_REOBSERVATION_REQUIRED_FOR_EXPERIENCE_BUILD_UP | ROBLOX_EXPERIENCE_BUILD_UP_REQUIRES_EXACT_REMOTE_EVIDENCE_NO_LOCAL_MANUAL_INSPECTION | AUTONOMOUS_CONTENT_EXPANSION_STAYS_INSIDE_EXISTING_BUILD_UP | CONTENT_EXPANSION_MUST_BE_COHERENT_CONNECTE