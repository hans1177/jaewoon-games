"directiveId":"daechung-rpg-build-up-g1-e9147e2aebab","directiveFingerprint":"e9147e2aebab5454925fae37e29c6a9b5ee9ef1eb161f6afc6a5814ec025020e","previousDirectiveFingerprint":"e7c8f53f47a04efb1c4d87631d058ff57a3666c8d804b0e745468abe8256145b","forbiddenRepeatFingerprint":"e7c8f53f47a04efb1c4d87631d058ff57a3666c8d804b0e745468abe8256145b","gameId":"daechung-rpg","gameName":"5포탈 RPG: 던전 파티","generation":1,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","escalationMode":"CONTINUE_UNVERIFIED_DEPTH","previousDirectiveOutcome":"cancelled","designContextMode":"APPROVED_OR_MINIMUM_DESIGN","platform":"WEB","sourceRoot":"web-games/daechung-rpg","sourceTreeFingerprint":"e3dd79f7bbc16ad2cfa3acb27354ebd2f1ee223f396463a4be6c69ebf4f0a1c7","designFingerprint":"726a3717a2962a12fb3a5af7da4b0e4fcd65836b96f98751c6f7e22031c6763b","gameIdentityAndNonNegotiables":{"identity":"스토리에서 동료를 만나 영입하고, 수십·수백 명까지 확장되는 AI 동료 풀에서 4인 파티를 구성해 직접 전투·장비 세팅·관계 조합을 연구하는 3D 파티 액션 RPG.","coreFun":"4인 파티 조합과 장비 세팅을 계속 바꿔 보며 서로 다른 AI 행동·관계·합동기·직업 능력이 맞물리는 순간을 찾는 재미. 희귀도보다 조합과 세팅이 더 중요하다.","coreLoop":["마을과 지역 스토리를 진행해 새로운 AI 동료와 사건을 발견한다.","보유 동료 중 4명을 골라 파티를 만들고 각 동료의 장비, AI 성향, 스킬을 세팅한다.","필드·던전·보스에서 직접 전투하며 파티 조합과 장비가 실제 전투에서 어떻게 맞물리는지 확인한다.","동료 전용 퀘스트, 숙명 관계, 히든 조건, 보스 포섭을 통해 새로운 동료·합동기·전용장비를 얻고 다른 4인 조합을 시험한다."],"signatureSystems":[{"name":"4인 파티 고정","purpose":"파티 슬롯은 항상 4명이며 탱·딜·힐 강제를 없애고 여러 조합이 실전에서 성립하도록 밸런스를 맞춘다.","playerChoice":""},{"name":"무한 확장 AI 동료","purpose":"새 지역·스토리 업데이트마다 동료를 계속 추가할 수 있고 각 동료는 전용 스토리, AI 행동, 스킬과 장비 방향을 가진다.","playerChoice":""},{"name":"숙명 관계","purpose":"특정 동료 조합이 함께 사건을 겪으면 전용 대사, 관계 변화, 합동기 또는 전투 규칙 변화가 열린다.","playerChoice":""},{"name":"파티 기억","purpose":"같은 4인으로 중요한 사건·보스·역전을 겪은 기록이 파티 정체성으로 남고 특수 대사·행동·지원 효과를 연다.","playerChoice":""},{"name":"보스·히든 동료","purpose":"특정 보스를 죽이는 대신 조건을 만족해 포섭하거나 숨겨진 시간·아이템·동료 조합으로 레어 동료를 발견한다.","playerChoice":""},{"name":"장비가 AI를 바꿈","purpose":"장비는 수치뿐 아니라 공격성, 보호 우선, 상태이상 활용 같은 AI 행동 우선순위와 스킬 운용을 바꾼다.","playerChoice":""},{"name":"라이벌 AI 파티","purpose":"다른 AI 4인 파티도 세계에서 성장하고 보스·보물·사건을 경쟁하거나 때로 협력한다.","playerChoice":""},{"name":"조합 엔딩","purpose":"특정 4인 조합으로 주요 스토리를 끝내면 그 조합만의 후일담·비밀 엔딩을 볼 수 있다.","playerChoice":""}],"progressionDirection":"초기 4인 동료 확보 → 지역 스토리와 장비 파밍 → 숙명 관계·전용 퀘스트 → 히든/보스 동료 → 고난도 조합전투 → 라이벌 파티 경쟁 → 조합별 엔딩과 계속 추가되는 새 동료.","multiplayerMode":"SINGLE_OR_COOP","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=20","GAME_FEEL_SPARSE","CAMERA_LANGUAGE_SPARSE","AUDIO_STATE_TRANSITION_SPARSE","UI_MENU_FLOW_SPARSE","SETTINGS_ACCESSIBILITY_SPARSE"],"signals":{"combat":424,"progression":252,"ai":57,"save":55,"multiplayer":56,"animation":4,"motionStates":318,"gameFeel":0,"vfx":4,"camera":0,"audio":159,"audioDynamics":0,"ui":165,"uiFlow":24,"entryFlow":0,"loadingFlow":0,"input":52,"map":321,"landmark":53,"interaction":28,"inventory":12,"equipment":95,"settings":0,"feedback":81,"session":32,"content":415,"choice":29,"connection":12,"performance":14,"lighting":41,"primitive":0,"todo":0,"errorRecovery":8},"topFiles":[{"file":"web-games/daechung-rpg/index.html","score":306},{"file":"web-games/daechung-rpg/patch-v15.js","score":167},{"file":"web-games/daechung-rpg/unity-web-gameplay-validation.json","score":66},{"file":"web-games/daechung-rpg/patch-v16.js","score":15},{"file":"web-games/daechung-rpg/patch-core18.js","score":9},{"file":"web-games/daechung-rpg/TemplateData/style.css","score":5},{"file":"web-games/daechung-rpg/patch-v17.js","score":4},{"file":"web-games/daechung-rpg/TemplateData/profiler.js","score":4},{"file":"web-games/daechung-rpg/patch-v18.js","score":3},{"file":"web-games/daechung-rpg/unity-web-build.json","score":2},{"file":"web-games/daechung-rpg/TemplateData/fullscreen-button.png","score":0},{"file":"web-games/daechung-rpg/TemplateData/MemoryProfiler.png","score":0}],"sourceAnchors":[{"f