 shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"FIRST_10_MINUTES","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"INPUT","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"MOBILE_UX","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"SETTINGS_ACCESSIBILITY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"MENU_FLOW","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"CONVENIENCE","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"UI_INFORMATION_PRIORITY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"FEEDBACK_CLARITY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"GAME_FEEL","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"AUDIO_MUSIC_SFX","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"LIGHTING","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"ANIMATION","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"SECONDARY_MOTION","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"VFX","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"CAMERA","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"AUDIO_VISUAL_TIMING","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"PERFORMANCE","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"PERFORMANCE_BUDGET","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"RUNTIME_STABILITY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"ERROR_RECOVERY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"}],"primaryFocus":"CORE_FUN","thisLoopPrimaryGoal":"나의 생존기는 극한의 환경에서 매일의 생존 기록을 남기는 액션 서바이벌 로그라이트 게임입니다. 플레이어는 매일 밤 몰려오는 적들을 막아내며, 낮 동안 수집한 자원으로 장비를 제작하고 생존 전략을 수정하여 다음 날의 생존 가능성을 높여가는 '기록과 선택의 순환'을 경험합니다.의 일일 생존 기록 시스템를 입력→판단→상태 변화→피드백→다음 선택까지 실제 플레이에서 더 깊고 명확하게 만든다.","primaryGoalReason":"현재 검증 신호와 소스에서 CORE_FUN를 우선한다. 게임 고유 앵커는 \"일일 생존 기록 시스템\", 현재 책임 소스는 web-games/survival/index.html이며 실제 source delta와 효과 증거가 다음 결정을 좌우한다.","gameplayImplementationDirectives":["우선 책임 소스 앵커 web-games/survival/index.html에서 현재 행동→상태 변화→피드백 연결을 직접 수정하고 wrapper나 우회 경로를 추가하지 않는다.","일일 생존 기록 시스템를 설명/마커가 아니라 실제 authoritative game state와 플레이어 입력에 연결하고 성공·실패·재시도 경로를 완성한다.","즉석 제작 및 개조 시스템가 다음 선택을 바꾸도록 상태 변화와 피드백을 연결한다.","기획 루프 1 \"낮 시간 동안 제한된 구역을 탐색하여 자원을 채집하고 생존에 필요한 도구와 무기를 제작합니다.\": 현재 책임 함수와 실제 조작 경로를 대조한다. 누락되면 기존 구현에서 보강하고, 입력 전 조건→실제 입력→장르에 맞는 상태/화면 변화→다음 단계 연결을 같은 플랫폼에서 재현한다. 버튼 제목이나 공통 점수 증가만으로 이 단계를 구현했다고 판정하지 않는다.","기획 루프 2 \"밤이 되면 몰려오는 적의 파상공세를 실시간 액션으로 방어하며 생존합니다.\": 현재 책임 함수와 실제 조작 경로를 대조한다. 누락되면 기존 구현에서 보강하고, 입력 전 조건→실제 입력→장르에 맞는 상태/화면 변화→다음 단계 연결을 같은 플랫폼에서 재현한다. 버튼 제목이나 공통 점수 증가만으로 이 단계를 구현했다고 판정하지 않는다.","기획 루프 3 \"전투 종료 후 획득한 경험치와 자원으로 캐릭터의 능력치를 강화하거나 새로운 제작법을 해금합니다.\": 현재 책임 함수와 실제 조작 경로를 대조한다. 누락되면 기존 구현에서 보강하고, 입력 전 조건→실제 입력→장르에 맞는 상태/화면 변화→다음 단계 연결을 같은 플랫폼에서 재현한다. 버튼 제목이나 공통 점수 증가만으로 이 단계를 구현했다고 판정하지 않는다.","기획 루프 4 \"생존 기록을 바탕으로 다음 날의 탐색 우선순위와 제작 전략을 재설정합니다.\": 현재 책임 함수와 실제 조작 경로를 대조한다. 누락되면 기존 구현에서 보강하고, 입력 전 조건→실제 입력→장르에 맞는 상태/화면 변화→다음 단계 연결을 같은 플랫폼에서 재현한다. 버튼 제목이나 공통 점수 증가만으로 이 단계를 구현했다고 판정하지 않는다.","고유 시스템 \"일일 생존 기록 시스템\": 플레이어 선택 \"어제 실패했던 구역을 다시 도전할지, 새로운 자원을 찾아 위험한 지역으로 이동할지 결정합니다.\"이 실제 결과를 달리 만드는지 두 선택의 결과를 비교한다. 코드 키워드·설명·자체 PASS 로그는 증거가 아니며, 실측하지 못하면 미확인으로 남기고 완료/효과 확인에 포함하지 않는다.","고유 시스템 \"즉석 제작 및 개조 시스템\": 플레이어 선택 \"공격력을 높이는 무기 강화에 집중할지, 방어적인 함정 설치에 자원을 투자할지 선택합니다.\"이 실제 결과를 달리 만드는지 두 선택의 결과를 비교한다. 코드 키워드·설명·자체 PASS 로그는 증거가 아니며, 실측하지 못하면 미확인으로 남기고 완료/효과 확인에 포함하지 않는다.","고유 시스템 일일 생존 기록 시스템, 즉석 제작 및 개조 시스템 중 이번 목표와 직접 연결된 시스템을 기존 책임 코드에서 심화한다.","주요 적/대상/상호작용이 행동·타이밍·카운터플레이 중 최소 두 축에서 구별되게 한다."],"progressionContentWorldDirectives":["로그라이트 요소인 영구적 능력치 강화와 매 세션의 빌드 최적화를 병행합니다. 생존 일수가 늘어날수록 더 희귀한 자원과 강력한 적이 등장하며, 플레이어는 점차 복잡한 제작 트리를 해금하여 자신만의 생존 스타일을 구축합니다.을 현재 루프의 실제 목표·보상·해금·콘텐츠 연결로 구현/심화한다.","새 콘텐츠는 기존 핵심 루프와 연결되어야 하며 단순 수량 복제나 색/수치만 다른 변형으로 채우지 않는다.","맵/지역이 있는 게임은 면적만 늘리지 말고 새 지역 역할·연결 경로·잠금/해금·랜드마크·조우/자원 역할·발견 피드백이 구별되도록 확장한다.","인벤토리/장비/제작/상점/퀘스트가 존재하면 서로 같은 authoritative 상태를 사용해 실제 플레이와 연결하고 고립된 메뉴 기능으로 남기지 않는다.","초반 10분과 중후반을 각각 점검해 초반 학습·첫 보상과 중후반 전략/콘텐츠 확장이 모두 실제 소스와 플레이 흐름에 존재하게 한다.","콘텐츠 확장은 배경·지역·몹·아이템·퀘스트·스토리·보상·규칙 중 관련 요소를 서로 연결된 묶음으로 설계하고, 한 요소만 고립해서 개수만 늘리는 업데이트를 피한다.","이전 세대와 이름·색·수치만 다른 복제 콘텐츠를 추가하지 말고 역할·행동·플레이어 선택·세계 이유·결과/보상·시스템 연결 중 최소 두 축 이상에서 실제 차이를 만든다.","새 스토리·퀘스트·지역·규칙은 이전 상태에서 왜 발생하고 완료 후 무엇이 달라지는지 게임 상태와 세계 흐름에 남겨 개연성과 진행 연결을 유지한다."],"autonomousContentExpansion":{"version":2,"policySource":"company-learning/vibe-autonomous-content-expansion-policy.json","policyStatus":"ACTIVE","executionBoundary":"EXISTING_BUILD_UP_ONLY","autonomousDecisionOwner":"VIBE","assistantManualIdeaDependencyForbidden":true,"newWorkflowForbidden":true,"newStageForbidden":true,"ownerPromptPerExpansionForbidden":true,"platformScope":["WEB","ROBLOX","UNITY"],"requestedPlatform":"WEB","executionMode":"AUTONOMOUS_CONTENT_BUILD_UP","dataCapacityBudget":{"state":"NORMAL","limits":{"savePersistedDataBytes":2097152,"webDownloadBytes":104857600,"singleFileBytes":26214400,"mobileMemoryTargetBytes":314572800,"mobileMinimumFps":30},"warningRatio":0.8,"measured":{"sourceBytes":1287,"largestFileBytes":1287,"savePersistedDataBytes":0,"mobileMemoryBytes":0,"mobileFps":0},"warning":[],"exceeded":[],"strategy":"CONTINUE_HIGHEST_VALUE_COHERENT_BUILD_UP","generationLimit":null,"contentCountLimit":null,"buildUpMustContinue":true,"protectedStateDeletionForbidden":true},"existingCompletenessReview":{"requiredEveryBuildUp":true,"mode":"CHECK_EXISTING_AND_EXPAND_OR_IMPROVE_WHICHEVER_HAS_HIGHER_PLAYER_VALUE","dimensions":["CORE_LOOP_COMPLETENESS","QUEST_AND_GOAL_FLOW","WORLD_AND_REGION_FLOW","MONSTER_ENEMY_ROLE_COVERAGE","ITEM_EQUIPMENT_REWARD_PURPOSE","STORY_WORLD_CAUSALITY","GAMEPLAY_RULE_CONNECTIONS","PROGRESSION_PACING","MID_LATE_ENDGAME_DEPTH","MULTIPLAYER_WHEN_APPLICABLE","PRESENTATION_AND_FEEDBACK"],"weakExistingContentMayPreemptNewContent":true},"selectedTheme":"WORLD_ECOLOGY_STORY_CHAIN","themeDepth":1,"selectedThemeReason":"5 explicit GAP(s) and 6 applicable domain(s); focus=CORE_FUN; previousTheme=NONE; previousEffect=NO_PREVIOUS_GENERATION; previousCoverage=0; uncoveredBefore=7.","themeCoverageLedger":{"version":1,"counts":{"WORLD_ECOLOGY_STORY_CHAIN":1,"ENEMY_BOSS_COMBAT_ECOLOGY":0,"QUEST_STORY_PROGRESSION_CHAIN":0,"ITEM_EQUIPMENT_CRAFT_SYSTEM_CHAIN":0,"RULES_EVENTS_REPLAYABILITY_SYSTEM":0,"MID_LATE_ENDGAME_COMPLETION":0,"PRESENTATION_WORLD_COHESION":0},"sequence":["WORLD_ECOLOGY_STORY_CHAIN"],"requiredThemes":["