{"id":"internal-motion-pocong-walk-v1","gameId":"horror-escape-room","target":"roblox","unityWebDevelopment":false,"department":"graphics","type":"implementation","designChange":false,"designScope":null,"proposedDesignChanges":[],"designFields":[],"assetProductionLane":true,"presentationPass":null,"graphicsReplacementContract":null,"motionRepairWorkUnit":{"scope":"INTERNAL_ASSET_LIBRARY","objectId":"roblox-world-ghost-pocong","clipId":"walk","sourcePath":"init.luau","sourceHash":"64d309bcfe4871f8d9fb9898d8d5849d44259a3dcd322c3b8e4e90001fd21fee","sourceWindow":"function Motion.walk(form,bones,time)\n local state=\"walk\"\n local result={}\n for name in pairs(bones)do result[name]={x=0,y=0,z=0,rx=0,ry=0,rz=0}end\n local function pose(name,x,y,z,rx,ry,rz)\n  if result[name]then result[name]={x=x or 0,y=y or 0,z=z or 0,rx=rx or 0,ry=ry or 0,rz=rz or 0}end\n end\n local moving=state==\"walk\" or state==\"chase\"\n local speed=state==\"chase\" and 10 or moving and 6 or 2\n local phase=time*speed;local wave=math.sin(phase);local breathe=math.sin(time*2)\n local floating=form==\"SHROUD\" or form==\"FLOATING_HEAD\" or form==\"OBJECT_SWARM\" or form==\"RIBBON\" or form==\"LANTERN\"\n pose(\"Torso\",0,floating and math.sin(time*2.4)*.13 or .03*breathe,0,0,moving and wave*.025 or breathe*.015,0)\n pose(\"Head\",0,0,0,breathe*.035,math.sin(time*.9)*.07,0)\n if moving then\n  if form==\"BEAST\" or form==\"CENTAUR\"then\n   pose(\"FrontLeftLeg\",0,0,0,wave*.48);pose(\"BackRightLeg\",0,0,0,wave*.48)\n   pose(\"FrontRightLeg\",0,0,0,-wave*.48);pose(\"BackLeftLeg\",0,0,0,-wave*.48)\n  elseif form==\"ARACHNID\"then\n   for i=1,4 do for _,side in ipairs({\"Left\",\"Right\"})do\n    local sign=side==\"Left\" and -1 or 1;local cycle=math.sin(phase+(i%2)*math.pi+(sign<0 and 0 or math.pi))\n    pose(\"Spider\"..side..i,0,0,0,0,cycle*.2,sign*math.max(0,cycle)*.12)\n    pose(\"Spider\"..side..i..\"Knee\",0,0,0,0,0,sign*math.max(0,cycle)*.25)\n   end end\n  elseif form==\"WHEEL\"then pose(\"Torso\",0,0,0,0,0,-(time*2.8)%(math.pi*2))\n  elseif not floating and form~=\"SERPENT\" and form~=\"WALL\" and form~=\"BOUND\"then\n   pose(\"LeftLeg\",0,0,0,wave*.4);pose(\"RightLeg\",0,0,0,-wave*.4)\n   pose(\"LeftArm\",0,0,0,-wave*.3);pose(\"RightArm\",0,0,0,wave*.3)\n  elseif form==\"BOUND\"then pose(\"Torso\",0,math.abs(wave)*.16,0,0,0,wave*.03)end\n end\n for name in pairs(bones)do\n  local coil=tonumber(string.match(name,\"^Coil(%d+)$\"))\n  local tail=tonumber(string.match(name,\"^TailFan(%d+)$\"))\n  if coil then pose(name,math.sin(phase-coil*.55)*.045,0,0,0,math.sin(phase-coil*.55)*.12,0)\n  elseif tail then pose(name,0,0,0,math.sin(time*2-tail*.4)*.07,math.sin(time*2-tail*.4)*.11,0)end\n end\n pose(\"LeftWing\",0,0,0,0,math.sin(phase)*.3,-.06)\n pose(\"RightWing\",0,0,0,0,-math.sin(phase)*.3,.06)\n return result\nend","objectBindingEvidence":"Motion.AssetId = \"pocong\"","clipBindingEvidence":"function Motion.walk(form,bones,time)","objectCount":1,"motionCount":1,"estimatedModificationMinutes":60,"lockedSource":["Motion.AssetId = \"pocong\"","function Motion.walk(form,bones,time)","local state=\"walk\""],"preservedAxes":{}},"executionLane":"ASSET_DEVELOPMENT","goal":"[INTERNAL ASSET MOTION REPAIR] roblox-world-ghost-pocong의 기존 walk 동작 하나를 약 60분의 실제 수정 작업량으로 깊게 개선한다. 원본을 읽고 자세·중심 이동·관절 곡선·접촉·후행 움직임·복귀와 루프를 검토한다. 같은 오브젝트와 같은 동작만 수정하며 다른 모션, 루트 이동, 판정, 게임 소스는 변경하지 않는다. 변경하지 않는 축은 소스 근거로 보존한다. 전후 실제 native 재생과 검수 전에는 품질 통과를 주장하지 않는다. 실패는 같은 대상의 기존 수리 흐름에서 반복 수정한다.","responsibleFiles":["assets/roblox/world-ghosts/motions/pocong/init.luau"],"retainedResponsibleFileLocks":[],"dependencies":[],"priority":"critical","portfolioValueScore":0,"ownerDevelopmentHold":false,"releaseState":"development-confirmed","status":"running","retries":0,"retryPolicy":"UNLIMITED","maxRetries":2,"ownerDirective":true,"requiresOwnerDecision":false,"protectedChange":false,"paidResourceRequired":false,"productionMode":"AUTONOMOUS_VIBE","supervisionApproved":false,"supervisionContract":null,"supervisionReview":null,"blocker":null,"evidence":["asset-production-parallel:v1","single-object-motion-repair:v1","internal-asset-only:v1","owner-motion-depth-request:2026-10-05","native-before-after-qa:required","work-package:horror-escape-room-wp-ivqz3o","task-work-units:6","package-work-units:6","package-related-improvements:0","package-role-separation:exploration|implementation|test|performance|regression|review","package-quantity-goal:FEATURE_COMPLETION","atomic-neuron-stream:presentation","atomic-neuron-micro-fanin:per-task","graphics-atomic-candidate-isolation-required","portfolio-decision:FOCUSED_REPAIR","portfolio-reason:CURRENT_CRITICAL_OR_REPEATED_CAUSAL_BLOCKER","learning-motor-candidate-tournament:repeated-verified-failure","recovery-queue:recovery-ticket-bug-97439712d416497ffce0","recovery-strategy:REPAIR_REPRODUCIBLE_TESTER_BUG_AND_RERUN_EXACT_FAILED_STAGE","recovery-exact-stage:TARGET_PLATFORM_BUILD_OR_PACKAGE","source-mutation-required:YES","game-repair-mode:ROOT_CAUSE_MODE","game-repair-repeat-count:4","game-repair-user-assistance-required:NO","game-repair-save-migration:NOT_APPLICABLE","game-repair-multiplayer-lifecycle:NOT_APPLICABLE","recovery-queue:recovery-ticket-bug-b021616100dca0c3a206","recovery-exact-stage:F0_SOURCE_INTEGRITY","game-repair-repeat-count:49","recovery-queue:recovery-ticket-bug-99f6b8c5bbd5d227e80c","recovery-exact-stage:TARGET_PLATFORM_SOURCE_BIND","game-repair-repeat-count:27","recovery-queue:recovery-ticket-bug-51e28af235567cbda4cf","recovery-exact-stage:PUBLIC_RELEASE_RUNTIME_FINDING","game-repair-repeat-count:7","game-repair-save-migration:REQUIRED","game-repair-multiplayer-lifecycle:MACHINE_REQUIRED","recovery-queue:recovery-ticket-bug-3207b3c9f6737f1e55f3","game-repair-repeat-count:237","system-steward:stale-running-reservation-recovered","base-main:389f3e2cbece091809f72f9f16b74dbbebadae78","role-result:exploration:PASS","role-result:implementation:FAIL","role-result:test:FAIL","role-result:performance:FAIL","rol