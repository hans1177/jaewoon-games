 경로와 선택을 연다.","exitState":"한 판의 결과와 다음 선택을 기록한다.","nextDecision":"이전에 변한 세계 상태와 발견 정보를 비교하고 새로운 접근 경로 또는 재시작 방법을 고른다.","startSeconds":200,"endSeconds":240,"timeReason":"RESOLUTION에서 RouteState·RiskState 입력과 WorldAccessState·IntentState 출력의 설계 전이를 관찰하는 구간이다. 실제 실행 시간은 미검증이다.","before":[{"key":"WorldAccessState","value":0},{"key":"IntentState","value":0},{"key":"HumanCount","value":3},{"key":"MonsterCount","value":4},{"key":"EliminatedCount","value":1},{"key":"RouteState","value":4},{"key":"RiskState","value":5},{"key":"ResourceState","value":1}],"after":[{"key":"WorldAccessState","value":1},{"key":"IntentState","value":1},{"key":"HumanCount","value":3},{"key":"MonsterCount","value":4},{"key":"EliminatedCount","value":1},{"key":"RouteState","value":4},{"key":"RiskState","value":5},{"key":"ResourceState","value":1}],"actions":[{"abilityId":"OVERLOAD","actorId":"H_ELECTRICIAN","targetId":"M_DRACULA","atSeconds":220,"distance":0,"energyBefore":30,"energyAfter":0,"hit":false,"response":"H_ELECTRICIAN가 과전류을 사용한다. 상대 대응을 관찰하고 확정 타격 없이 다음 선택으로 이어진다. 금기와 기회의 교차의 상태 출력 WorldAccessState·IntentState가 다음 시스템의 선택 조건에 전달된다."}],"ruleIds":["VIBE_DELVE","VIBE_B"],"outcome":"DRAW"},"playerChoice":"증언과 합의된 현실의 제약과 오만과 응보의 대응을 같은 지역에서 순서대로 시험한다.","trigger":"다음 단계 RESOLUTION의 입장 조건과 세계 상태가 결정된다.","stateChange":"입력: 원본 OVERLOAD 능력의 입력 조건을 충족할 때 기존 책임 시스템이 수행한다. 판정: RouteState·RiskState의 기존 접근·비용 조건을 확인한다. 성공: WorldAccessState·IntentState 출력과 금기와 기회의 교차의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 기존 회피 입력과 반응 규칙을 보존한다. 진영 전환과 추격 경로에서 평소에는 불가능했던 대안 경로와 선택을 연다.","linkedRuleIds":["VIBE_DELVE","VIBE_B"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["ENTRY_FIRST_INPUT_CONDITION_FEEDBACK_RESULT_NEXT_CHOICE_CONNECTED","CANCEL_FAILURE_AND_RETRY_PRESERVE_EXISTING_STATE_AND_SAVE","PLANNED_BEFORE_AFTER_VALUES_ARE_NOT_RUNTIME_EVIDENCE"],"buildUpStatu