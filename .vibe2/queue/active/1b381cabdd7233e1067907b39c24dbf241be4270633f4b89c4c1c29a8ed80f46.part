"},{"humanId":"SECURITY","humanTool":"충격봉","humanAbilityId":"SHOCK_BATON","infectedAbilityId":"BREACH","retainedState":"플레이어의 연결된 진행·위치·저장 상태를 서버 권한 아래 유지한다.","removedState":"인간 도구 충격봉의 행동 권한과 진압 충격 사용 가능 상태를 제거한다.","changedChoice":"진압 충격으로 인간 목표를 수행하던 선택이 돌파을 사용해 반대 진영을 추격하는 선택으로 전환된다."}]},"narrativeDialoguePlan":{"applicable":true,"worldRules":["증언과 합의된 현실에 의해 바뀐 인물·지역의 상태는 오만과 응보의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다."],"characterGoals":["증언과 합의된 현실의 원칙을 지키는 인물과 오만과 응보의 책임을 지려는 인물이 목표를 놓고 충돌한다."],"plotBeats":["증언과 합의된 현실의 원칙을 지키는 인물과 오만과 응보의 책임을 지려는 인물이 목표를 놓고 충돌한다. 증언과 합의된 현실에 의해 바뀐 인물·지역의 상태는 오만과 응보의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다.","상대 진영과 이동 경로를 읽고 감염 또는 회피의 시점과 대상을 선택하면서 플레이어가 채택한 기록과 증언이 월드 규칙·NPC 기억·접근 가능성을 바꾼다. 또는 바뀐 인원과 역할을 읽고 정화·지원·반격의 우선순위를 선택하면서 강해질수록 특정 세계 압력·적응·반작용이 증가해 성공 방식 자체를 바꾼다. 중 무엇을 우선할지 판단한다.","증언과 합의된 현실의 흔적이 남은 지역은 오만과 응보의 선택에 따라 새로운 출입·보상 조건을 갖는다. 역사적 세력 균형와 업보와 인과응보가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다."],"questStates":["이전 선택 조건을 확인한다.","상대의 반작용이 나타나면 다음 선택을 바꾼다."],"foreshadowing":["증언과 합의된 현실의 작은 변화가 오만과 응보의 큰 반작용을 예고한다."],"payoffs":["오만과 응보의 결과가 다시 증언과 합의된 현실의 앞선 의미를 바꾼다."],"twists":["A/B 중 어느 하나나 C의 보조 장르를 제거하면 정보·동선·세계 반응이 달라지므로 장식으로 대체할 수 없다."],"dialogueRules":["현재 인물의 지식 범위와 플레이어의 지난 행동을 넘는 정보는 대사에 넣지 않는다."],"characterVoiceProfiles":[{"character":"증언과 합의된 현실의 이해관계자","grammarRegister":"경험을 중심으로 짧게 이야기한다.","vocabularyRhythm":"경고와 선택 비용을 구체적으로 말한다.","relationshipShift":"플레이어의 선택에 따라 신뢰와 협력 조건이 바뀐다.","emotionalRange":"불안에서 신뢰 또는 반발로 변한다.","knowledgeBoundary":"첫 시스템의 현재 변화만 안다.","subtextBehavior":"숨기고 싶은 위험을 발언 순서로 드러낸다."},{"character":"오만과 응보의 이해관계자","grammarRegister":"규칙과 반작용을 비교해 설명한다.","vocabularyRhythm":"사건 이전과 이후를 비교하며 말한다.","relationshipShift":"선택 결과에 따라 요구와 제안이 달라진다.","emotionalRange":"의심과 설득, 체념 또는 수용을 보인다.","knowledgeBoundary":"자신이 관찰한 후속 결과만 안다.","subtextBehavior":"정보 부족을 역이용해 다른 협상을 제시한다."}],"sceneBeats":[{"scene":"첫 진입","purpose":"세계의 조건을 알아차리게 한다.","characterGoals":"무엇을 지킬지 정한다.","conflict":"인물은 플레이어의 이전 선택을 기억하고 신뢰·거래·협력 조건을 변경한다.","informationAsymmetry":"두 소재가 서로 다른 원인을 알고 있다.","reversal":"첫 선택이 예기치 않은 다른 문제를 일으킨다.","stateChange":"A의 상태가 B의 조건을 바꾼다."},{"scene":"귀환과 해결","purpose":"이전 선택의 결과를 확인한다.","characterGoals":"손실과 관계를 재조정한다.","conflict":"서로의 비용을 누가 부담할지 충돌한다.","informationAsymmetry":"후속 사건의 단서가 플레이어에게만 보인다.","reversal":"B의 결과로 A의 옛 선택을 새롭게 해석한다.","stateChange":"세계 접근과 위험 상태가 갱신된다."}]},"implementationTraceability":[{"designElement":"진영 전환과 추격 경로 × 증언과 합의된 현실","responsibleSystem":"roblox-games/horror-escape-room/에서 진영 전환과 추격 경로 × 증언과 합의된 현실의 기존 Luau 책임 함수와 코드 모듈","validationEvidence":"같은 조건의 입력 전후 위험·세계 상태 값과 다음 B의 선택 변화를 비교한다."},{"designElement":"정화와 팀 대응 × 오만과 응보","responsibleSystem":"roblox-games/horror-escape-room/에서 정화와 팀 대응 × 오만과 응보의 기존 Luau 책임 함수와 코드 모듈","validationEvidence":"B의 반작용 이전/이후 A의 다음 경로·비용·행동 가능성을 비교한다."},{"designElement":"감염 추격 장르의 주 목표를 진행하는 동안 미스터리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 미스터리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.","responsibleSystem":"세계 상태·스토리 반응의 기존 책임 시스템","validationEvidence":"보조 장르를 제거한 반사실 비교에서 실제 선택과 정보가 달라지는지 재생한다."},{"designElement":"금기와 기회의 교차","responsibleSystem":"진행·탐색·발견을 연결하는 기존 책임 함수","validationEvidence":"숨은 발견 조건 이전/이후의 새로운 선택과 재방문 결과를 검증한다."}],"stabilityPriorityPlan":{"signals":[],"priorityRule":"실제 재현된 진행 막힘·저장 손상·터치 입력 실패·멀티 동기화 오류를 우선 분류하고 원인에 해당하는 기존 책임 함수만 수정한다."},"preservationContract":{}},"gameIdentityAndNonNegotiables":{"identity":"심야 대탈출. 증언과 합의된 현실·오만과 응보 감염 추격. 심야 대탈출에서 진영 전환과 추격 경로 × 증언과 합의된 현실과 정화와 팀 대응 × 오만과 응보이 서로 결과를 되돌려 바꾸며 감염 추격·미스터리의 판단이 실제 세계 상태를 변화시킨다.","coreFun":"진영 전환과 추격 경로의 결과를 정화와 팀 대응로 전환하고 달라진 조건을 다시 활용한다. 상대 진영과 이동 경로를 읽고 감염 또는 회피의 시점과 대상을 선택하면서 플레이어가 채택한 기록과 증언이 월드 규칙·NPC 기억·접근 가능성을 바꾼다. 이후 플레이어가 진영 전환과 추격 경로을 선택하면 증언과 합의된 현실의 규칙에 따라 다음 위험과 가능 행동이 변화한다. 그 결과 바뀐 인원과 역할을 읽고 정화·지원·반격의 우선순위를 선택하면서 강해질수록 특정 세계 압력·적응·반작용이 증가해 성공 방식 자체를 바꾼다.가 바뀌고 플레이어가 정화와 팀 대응을 선택하면 오만과 응보의 규칙에 따라 처음 선택으로 되돌아갈 비용·정보·접근 조건이 변화한다. 다시 A의 선택 조건이 달라진다. 감염 추격 장르의 주 목표를 진행하는 동안 미스터리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 미스터리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.","coreLoop":["진영 전환과 추격 경로: 상대 진영과 이동 경로를 읽고 감염 또는 회피의 시점과 대상을 선택하면서 플레이어가 채택한 기록과 증언이 월드 규칙·NPC 기억·접근 가능성을 바꾼다.","정화와 팀 대응: 바뀐 인원과 역할을 읽고 정화·지원·반격의 우선순위를 선택하면서 강해질수록 특정 세계 압력·적응·반작용이 증가해 성공 방식 자체를 바꾼다.","진영 전환과 추격 경로로 되돌아가 변한 세계 상태·관계·위험을 비교하고 다음 목표를 선택한다."],"signatureSystems":[{"id":"VIBE_MAIN","grammarRole":"MAIN","name":"심야 대탈출","purpose":"심야 대탈출에서 감염 추격전 참가자가 진영 전환과 추격 경로와 정화와 팀 대응의 선택을 통해 증언과 합의된 현실·오만과 응보의 인과법칙을 바꾸는 감염 추격 복합 게임에서 플레이어는 선택을 누적해 목적을 완수한다. 게임의 반복 목표와 세계의 접근 가능성을 상태로 관리한다.","playerChoice":"진영 전환과 추격 경로: 상대 진영과 이동 경로를 읽고 감염 또는 회피의 시점과 대상을 선택하면서 플레이어가 채택한 기록과 증언이 월드 규칙·NPC 기억·접근 가능성을 바꾼다. 이후 다음 행동의 위험과 보상을 직접 선택한다.","stateInputs":["WorldAccessState","IntentState","HumanCount","MonsterCount","EliminatedCount"],"stateOutputs":["RouteState","WorldAccessState","HumanCount","MonsterCount","EliminatedCount"]},{"id":"VIBE_A","grammarRole":"A","name":"진영 전환과 추격 경로 × 증언과 합의된 현실","purpose":"플레이어가 진영 전환과 추격 경로을 선택하면 증언과 합의된 현실의 규칙에 따라 다음 위험과 가능 행동이 변화한다. 플레이어가 채택한 기록과 증언이 월드 규칙·NPC 기억·접근 가능성을 바꾼다. 따라서 진영 전환과 추격 경로의 경로와 비용이 바뀐다. 선택의 결과를 위험과 자원 경로에 반영한다.","playerChoice":"상대 진영과 이동 경로를 읽고 감염 또는 회피의 시점과 대상을 선택하면서 플레이어가 채택한 기록과 증언이 월드 규칙·NPC 기억·접근 가능성을 바꾼다. 증언과 합의된 현실의 제약을 감수할지 결정한다.","stateInputs":["RouteState","RiskState","HumanCount","MonsterCount","EliminatedCount"],"stateOutputs":["RiskState","ResourceState","HumanCount","MonsterCount","EliminatedCount"]},{"id":"VIBE_B","grammarRole":"B","name":"정화와 팀 대응 × 오만과 응보","purpose":"플레이어가 정화와 팀 대응을 선택하면 오만과 응보의 규칙에 따라 처음 선택으로 되돌아갈 비용·정보·접근 조건이 변화한다. 강해질수록 특정 세계 압력·적응·반작용이 증가해 성공 방식 자체를 바꾼다. 따라서 정화와 팀 대응의 정보·대응이 바뀐다. 앞선 행동의 결과를 다음 접근 조건으로 되돌린다.","playerChoice":"바뀐 인원과 역할을 읽고 정화·지원·반격의 우선순위를 선택하면서 강해질수록 특정 세계 압력·적응·반작용이 증가해 성공 방식 자체를 바꾼다. 오만과 응보의 반작용을 선택한다.","stateInputs":["RiskState","ResourceState","HumanCount","MonsterCount","EliminatedCount"],"stateOutputs":["RouteState","RiskState","HumanCount","MonsterCount","EliminatedCount"]},{"id":"VIBE_DELVE","grammarRole":"DELVE","name":"금기와 기회의 교차","purpose":"무엇이 사실로 인정되는가는 기록·증언·권력의 합의와 충돌한다. 상황을 강해질수록 특정 세계 압력·적응·반작용이 증가해 성공 방식 자체를 바꾼다. 방식으로 해석한다. 숨겨진 조건을 실험한 뒤 새로운 선택과 경로를 연다.","playerChoice":"증언과 합의된 현실의 제약과 오만과 응보의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다.","stateInputs":["RouteState","RiskState"],"stateOutputs":["WorldAccessState","IntentState"]}],"progressionDirection":"성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 진영 전환과 추격 경로의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 정화와 팀 대응의 새 상대는 기존 상태를 증폭하거나 반전한다.","multiplayerMode":"COMPETITIVE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=16","PLACEHOLDER_OR_PRIMITIVE_USAGE_HIGH"],"signals":{"combat":401,"progression":728,"ai":315,"save":335,"multiplayer":33,"animation":168,"motionStates":1470,"gameFeel":46,"vfx":288,"camera":183,"audio":102,"audioDynamics":115,"ui":1443,"uiFlow":1571,"entryFlow":308,"loadingFlow":3,"input":179,"map":2026,"landmark":442,"interaction":597,"inventory":358,"equipment":118,"settings":33,"feedback":422,"session":283,"content":1662,"choice":1811,"connection":10,"performance":121,"lighting":348,"primitive":60,"todo":0,"errorRecovery":131},"topFiles":[{"file":"roblox-games/horror-escape-room/shared/RobloxCommonUI.luau","score":1517},{"file":"roblox-games/horror-escape-room/server/Game.server.luau","score":1026},{"file":"roblox-games/horror-escape-room/client/Game.client.luau","score":1016},{"file":"roblox-games/horror-escape-room/shared/GameConfig.luau","score":298},{"file":"roblox-games/horror-escape-room/client/ManorLobby.client.luau","score":231},{"file":"roblox-games/horror-escape-room/launch-mvp.json","score":114},{"file":"roblox-games/horror-escape-room/server/ManorLobby.luau","score":112},{"file":"roblox-games/horror-escape-room/shared/QACamera.luau","score":89},{"file":"roblox-games/horror-escape-room/default.project.json","score":78},{"file":"roblox-gam