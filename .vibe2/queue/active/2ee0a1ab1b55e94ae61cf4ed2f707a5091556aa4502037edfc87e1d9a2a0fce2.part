INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"CORE_LOOP[2]","family":"CORE_LOOP","index":2,"title":"방어 시설 배치로 되돌아가 변한 세계 상태·관계·위험을 비교하고 다음 목표를 선택한다.","authoredId":null,"designDetail":{"step":"방어 시설 배치로 되돌아가 변한 세계 상태·관계·위험을 비교하고 다음 목표를 선택한다."},"playerChoice":null,"trigger":null,"stateChange":null,"linkedRuleIds":[],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["CURRENT_STEP_IS_REACHABLE_FROM_PREVIOUS_SESSION_OR_LOOP_STATE","PLAYER_ACTION_TRANSITIONS_TO_NEXT_AUTHORED_LOOP_STEP","SUCCESS_FAILURE_AND_RETRY_FEEDBACK_OBSERVABLE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 방어 시설 배치로 되돌아가 변한 세계 상태·관계·위험을 비교하고 다음 목표를 선택한다. 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SIGNATURE_SYSTEM[0]","family":"SIGNATURE_SYSTEM","index":0,"title":"숲길 디펜스","authoredId":"VIBE_MAIN","designDetail":{"id":"VIBE_MAIN","grammarRole":"MAIN","name":"숲길 디펜스","purpose":"숲길 디펜스에서 방어 지휘관가 방어 시설 배치와 적 패턴과 자원 대응의 선택을 통해 역사적 세력 균형·왕조의 정통성과 민심의 인과법칙을 바꾸는 전략 복합 게임에서 플레이어는 선택을 누적해 목적을 완수한다. 게임의 반복 목표와 세계의 접근 가능성을 상태로 관리한다.","playerChoice":"방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다.","stateInputs":["WorldAccessState","IntentState"],"stateOutputs":["RouteState","WorldAccessState"]},"playerChoice":"방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다.","trigger":null,"stateChange":null,"linkedRuleIds":["VIBE_MAIN","VIBE_A","VIBE_DELVE"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["DESIGNED_RULE_ID_INPUT_OUTPUT_STATE_KEYS_BOUND_TO_EXISTING_GAME_SYSTEM","ALTERNATIVE_PLAYER_CHOICES_CHANGE_AUTHORED_STATE_OR_CONSEQUENCE","CORE_LOOP_AND_OTHER_SIGNATURE_SYSTEMS_SHARE_AUTHORITATIVE_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 숲길 디펜스 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SIGNATURE_SYSTEM[1]","family":"SIGNATURE_SYSTEM","index":1,"title":"방어 시설 배치 × 역사적 세력 균형","authoredId":"VIBE_A","designDetail":{"id":"VIBE_A","grammarRole":"A","name":"방어 시설 배치 × 역사적 세력 균형","purpose":"플레이어가 방어 시설 배치을 선택하면 역사적 세력 균형의 규칙에 따라 다음 위험과 가능 행동이 변화한다. 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 따라서 방어 시설 배치의 경로와 비용이 바뀐다. 선택의 결과를 위험과 자원 경로에 반영한다.","playerChoice":"접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다.","stateInputs":["RouteState","RiskState"],"stateOutputs":["RiskState","ResourceState"]},"playerChoice":"접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다.","trigger":null,"stateChange":null,"linkedRuleIds":["VIBE_MAIN","VIBE_A","VIBE_B","VIBE_DELVE"],"designResponsibleSystem":"roblox-games/defense/에서 방어 시설 배치 × 역사적 세력 균형의 기존 Luau 책임 함수와 코드 모듈","sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["DESIGNED_RULE_ID_INPUT_OUTPUT_STATE_KEYS_BOUND_TO_EXISTING_GAME_SYSTEM","ALTERNATIVE_PLAYER_CHOICES_CHANGE_AUTHORED_STATE_OR_CONSEQUENCE","CORE_LOOP_AND_OTHER_SIGNATURE_SYSTEMS_SHARE_AUTHORITATIVE_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"같은 조건의 입력 전후 위험·세계 상태 값과 다음 B의 선택 변화를 비교한다.","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SIGNATURE_SYSTEM[2]","family":"SIGNATURE_SYSTEM","index":2,"title":"적 패턴과 자원 대응 × 왕조의 정통성과 민심","authoredId":"VIBE_B","designDetail":{"id":"VIBE_B","grammarRole":"B","name":"적 패턴과 자원 대응 × 왕조의 정통성과 민심","purpose":"플레이어가 적 패턴과 자원 대응을 선택하면 왕조의 정통성과 민심의 규칙에 따라 처음 선택으로 되돌아갈 비용·정보·접근 조건이 변화한다. 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 따라서 적 패턴과 자원 대응의 정보·대응이 바뀐다. 앞선 행동의 결과를 다음 접근 조건으로 되돌린다.","playerChoice":"웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 왕조의 정통성과 민심의 반작용을 선택한다.","stateInputs":["RiskState","ResourceState"],"stateOutputs":["RouteState","RiskState"]},"playerChoice":"웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 왕조의 정통성과 민심의 반작용을 선택한다.","trigger":null,"stateChange":null,"linkedRuleIds":["VIBE_A","VIBE_B","VIBE_DELVE"],"designResponsibleSystem":"roblox-games/defense/에서 적 패턴과 자원 대응 × 왕조의 정통성과 민심의 기존 Luau 책임 함수와 코드 모듈","sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["DESIGNED_RULE_ID_INPUT_OUTPUT_STATE_KEYS_BOUND_TO_EXISTING_GAME_SYSTEM","ALTERNATIVE_PLAYER_CHOICES_CHANGE_AUTHORED_STATE_OR_CONSEQUENCE","CORE_LOOP_AND_OTHER_SIGNATURE_SYSTEMS_SHARE_AUTHORITATIVE_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"B의 반작용 이전/이후 A의 다음 경로·비용·행동 가능성을 비교한다.","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SIGNATURE_SYSTEM[3]","family":"SIGNATURE_SYSTEM","index":3,"title":"금기와 기회의 교차","authoredId":"VIBE_DELVE","designDetail":{"id":"VIBE_DELVE","grammarRole":"DELVE","name":"금기와 기회의 교차","purpose":"한 세력의 완전한 승리가 오히려 더 큰 불균형과 반발을 만든다. 상황을 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 방식으로 해석한다. 숨겨진 조건을 실험한 뒤 새로운 선택과 경로를 연다.","playerChoice":"역사적 세력 균형의 제약과 왕조의 정통성과 민심의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다.","stateInputs":["RouteState","RiskState"],"stateOutputs":["WorldAccessState","IntentState"]},"playerChoice":"역사적 세력 균형의 제약과 왕조의 정통성과 민심의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다.","trigger":null,"stateChange":null,"linkedRuleIds":["VIBE_B","VIBE_DELVE","VIBE_MAIN","VIBE_A"],"designResponsibleSystem":"진행·탐색·발견을 연결하는 기존 책임 함수","sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["DESIGNED_RULE_ID_INPUT_OUTPUT_STATE_KEYS_BOUND_TO_EXISTING_GAME_SYSTEM","ALTERNATIVE_PLAYER_CHOICES_CHANGE_AUTHORED_STATE_OR_CONSEQUENCE","CORE_LOOP_AND_OTHER_SIGNATURE_SYSTEMS_SHARE_AUTHORITATIVE_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"숨은 발견 조건 이전/이후의 새로운 선택과 재방문 결과를 검증한다.","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SYSTEM_CONNECTION[0]","family":"SYSTEM_CONNECTION","index":0,"title":"숲길 디펜스 → 방어 시설 배치 × 역사적 세력 균형","authoredId":null,"designDetail":{"fromId":"VIBE_MAIN","toId":"VIBE_A","stateKeys":["RouteState"],"fromSystem":"숲길 디펜스","toSystem":"방어 시설 배치 × 역사적 세력 균형","trigger":"숲길 디펜스의 선택: 방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 기존 선행조건을 만족해 RouteState 출력이 확정됐을 때 방어 시설 배치 × 역사적 세력 균형이 같은 키를 읽는다.","stateChange":"VIBE_MAIN 출력 RouteState → VIBE_A 입력. 후속 선택: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다."},"playerChoice":null,"trigger":"숲길 디펜스의 선택: 방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 기존 선행조건을 만족해 RouteState 출력이 확정됐을 때 방어 시설 배치 × 역사적 세력 균형이 같은 키를 읽는다.","stateChange":"VIBE_MAIN 출력 RouteState → VIBE_A 입력. 후속 선택: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.","linkedRuleIds":["VIBE_MAIN","VIBE_A"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["FROM_SYSTEM_EMITS_DECLARED_STATE_KEYS","TO_SYSTEM_CONSUMES_SAME_STATE_KEYS_WITHOUT_DUPLICATE_SHADOW_STATE","TRIGGER_AND_RESULT_VERIFIED_BOTH_SIDES","SUCCESS_ALTERNATIVE_CANCEL_AND_REVERSE_HANDOFF_USE_EXISTING_STATE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 숲길 디펜스 → 방어 시설 배치 × 역사적 세력 균형 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"SYSTEM_CONNECTION[1]","family":"SYSTEM_CONNECTION","index":1,"title":"방어 시설 배치 × 역사적 세력 균형 → 적 패턴과 자원 대응 × 왕조의 정통성과 민심","authoredId":null,"designDetail":{"fromId":"VIBE_A","toId":"VIBE_B","stateKeys":["RiskState","ResourceState"],"fromSystem":"방어 시설 배치 × 역사적 세력 균형","toSystem":"적 패턴과 자원 대응 × 왕조의 정통성과 민심","trigger":"방어 시설 배치 × 역사적 세력 균형의 선택: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다. 기존 선행조건을 만족해 RiskState·ResourceState 출력이 확정됐을 때 적 패턴과 자원 대응 × 왕조의 정통성과 민심이 같은 키를 읽는다.","stateChange":"VIBE_A 출력 RiskState·Re