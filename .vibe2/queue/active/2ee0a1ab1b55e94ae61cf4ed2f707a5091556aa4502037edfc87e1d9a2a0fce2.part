T_SELECTED","executableBehaviorVerified":false,"actualRuntimeVerified":false,"evidenceNeeded":"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA"},{"role":"@","grammarRole":"DELVE","systemId":"VIBE_DELVE","systemIds":["VIBE_DELVE"],"names":["금기와 기회의 교차"],"name":"금기와 기회의 교차","stateInputs":["RouteState","RiskState"],"stateOutputs":["WorldAccessState","IntentState"],"connections":[{"fromId":"VIBE_B","toId":"VIBE_DELVE","stateKeys":["RouteState","RiskState"]},{"fromId":"VIBE_DELVE","toId":"VIBE_MAIN","stateKeys":["WorldAccessState","IntentState"]},{"fromId":"VIBE_A","toId":"VIBE_DELVE","stateKeys":["RiskState"]}],"nativeStateMapping":{"state":"EXECUTABLE_SOURCE_REQUIRED","matchedInputKeys":[],"matchedWrittenOutputKeys":[],"missingInputKeys":["RouteState","RiskState"],"missingWrittenOutputKeys":["WorldAccessState","IntentState"],"inspectedExecutableFiles":[],"exactRuntimeStateTransitionVerified":false,"rule":"IDENTIFIER_REFERENCE_AND_ASSIGNMENT_ARE_DIAGNOSTIC_CANDIDATES_NOT_GAMEPLAY_PARITY_PASS"},"suggestedExistingOwnerFiles":[],"inspectedSymbols":[],"designStatus":"AUTHORED","codingStatus":"PLATFORM_NOT_SELECTED","executableBehaviorVerified":false,"actualRuntimeVerified":false,"evidenceNeeded":"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA"}],"edgeStateMismatches":[],"nativeStateMappingSummary":{"authoredRoles":4,"mappedStaticCandidates":0,"unmappedRoles":[],"edgeMismatches":0,"staticSourceMappingIsNotRuntimeParity":true},"creativeCBinding":{"themes":[{"name":"서사시의 맹세와 계약","gameplayEffect":"보상 획득이 동시에 행동 제한·동맹 의무·위험을 생성한다. 그 결과 A와 B가 공유하는 조건이 바뀐다."},{"name":"비극과 희극의 운명 반전","gameplayEffect":"큰 성공이 다음 위험의 재료가 되고 실패가 새로운 기회의 자원이 된다. 그 결과 사건의 비용과 다음 선택이 달라진다."}],"genres":[{"role":"PRIMARY","name":"전략","gameplayEffect":"방어 시설 배치와 적 패턴과 자원 대응를 통한 중심 목표와 위험·보상을 판단한다."},{"role":"SECONDARY","name":"추리","gameplayEffect":"서사시의 맹세와 계약의 단서와 비극과 희극의 운명 반전의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다."}],"genreInterlock":"전략 장르의 주 목표를 진행하는 동안 추리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 추리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.","abGameplayEffect":"역사적 세력 균형에 의해 바뀐 인물·지역의 상태는 왕조의 정통성과 민심의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 서사시의 맹세와 계약와 비극과 희극의 운명 반전가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 그 결과 적 패턴과 자원 대응의 가능 행동과 위험이 바뀌며, 웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 다시 방어 시설 배치의 조건을 바꾼다.","standardVersion":null,"dCreations":[],"delveDLinks":[{"sourceDId":"","discovery":"금기와 기회의 교차: 한 세력의 완전한 승리가 오히려 더 큰 불균형과 반발을 만든다. 상황을 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 방식으로 해석한다.","experiment":"","nextQuestion":""},{"sourceDId":"","discovery":"되돌아온 선택: 통치 권한은 힘만이 아니라 인정·질서·민심에 의해 유지된다. 결과가 과거 선택의 의미를 바꿀 수 있음을 발견한다.","experiment":"","nextQuestion":""},{"sourceDId":"","discovery":"두 소재의 숨은 규칙: 맹세와 계약은 권리와 동시에 구속을 만든다. 원리와 최고점과 최저점이 서로의 원인이 되어 운명이 반전된다. 원리가 동시에 작동함을 파악한다.","experiment":"","nextQuestion":""},{"sourceDId":"","discovery":"역전된 종착점: 한쪽의 불리한 결과가 다른 쪽의 고급 활용 조건이 되는 인과 반전을 학습한다.","experiment":"","nextQuestion":""}],"designAuthored":true,"runtimeVerified":false},"observedGameCodeFiles":[],"executableCodeCandidateFiles":[],"gapReasons":["PLATFORM_SOURCE_NOT_SELECTED"],"codingReviewState":"GAME_STAGE_LOCAL_REPAIR_REQUIRED","sourceImplementationPassed":false,"actualTwoClientPassed":false,"actualWebglRenderPassed":false,"independentQaPassed":false,"stageLocalAction":"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME","schemaAndMarkersAloneCannotPass":true,"newPipeline":false,"changesDevelopmentAdmission":false,"saveBalanceAndExistingMultiplayerMeaningPreserved":true},"designedGameVolume":{"version":1,"boundary":"EXISTING_GAME_SPECIFIC_BUILD_UP_DIRECTIVE_ONLY","sourceTreeFingerprint":"1d0025990d856d7575da7ce5472a4aaa2d2764376d7b26dc51c9d5ec0a208df9","mode":"APPROVED_DESIGN_TO_NATIVE_CONTENT_IMPLEMENTATION","authoredItemCount":50,"authoredCounts":{"PLAYTHROUGH":3,"CORE_LOOP":3,"SIGNATURE_SYSTEM":4,"SYSTEM_CONNECTION":6,"CONTENT_MILESTONE":4,"VARIETY_ABILITIES":2,"VARIETY_ENEMIESORCHALLENGES":2,"VARIETY_OBJECTIVES":2,"VARIETY_REGIONS":2,"NARRATIVE_QUESTSTATES":2,"NARRATIVE_PLOTBEATS":3,"NARRATIVE_SCENEBEATS":2,"CREATIVE_A_SYSTEM_AND_SOURCE":1,"CREATIVE_B_SYSTEM_AND_SOURCE":1,"CREATIVE_C_THEME_FUSION":2,"CREATIVE_C_PRIMARY_SECONDARY_GENRE":2,"CREATIVE_C_GENRE_INTERLOCK":1,"CREATIVE_AT_DELVE":4,"IMPLEMENTATION_TRACE":4},"namedSourceCandidateCount":0,"sourceReviewRequiredCount":50,"implementationVerifiedCount":0,"runtimeVerifiedCount":0,"authoredCountsAreNotImplementedOrPlayableCounts":true,"noArbitraryContentQuota":true,"coverageState":"DESIGN_CONTENT_INDEXED_NATIVE_IMPLEMENTATION_AND_RUNTIME_PENDING","absenceOfNameMatchIsNotProofOfMissingImplementation":true,"existingSaveBalanceEconomyNetworkAuthorityPreserved":true,"action":"BIND_EACH_APPROVED_ITEM_TO_EXISTING_RESPONSIBLE_SOURCE_AND_PROVE_CONNECTED_PLAYER_FACING_RESULT","acceptance":["EACH_AUTHORED_ITEM_REQUIRES_EXACT_DESIGN_SOURCE_AND_PLAYER_EVIDENCE","CONTENT_REQUIRES_TRIGGER_STATE_PLAYER_CHOICE_NEXT_GOAL_CONNECTION_WHEN_APPLICABLE","SOURCE_NAMES_OR_SYMBOLS_ARE_NOT_IMPLEMENTATION_PASS","NATIVE_ACTION_STATE_RESULT_FAILURE_AND_RETRY_QA_REQUIRED","SPATIAL_CONTENT_REQUIRES_REAL_NATIVE_3D_AND_MOBILE_RUNTIME_QA","PRESERVE_EXISTING_BALANCE_SAVE_ECONOMY_AND_NETWORK_AUTHORITY"],"items":[{"ref":"PLAYTHROUGH[0]","family":"PLAYTHROUGH","index":0,"title":"OPENING","authoredId":null,"designDetail":{"phase":"OPENING","entryState":"시작 위치: 역사적 세력 균형의 첫 선택 공간. 안내: 역사적 세력 균형의 변화가 드러나는 고유 랜드마크를 첫 진입 때 표시한다. 현재 목표와 가능한 첫 행동을 확인한다.","playerChoice":"접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다.","actionAndResponse":"입력: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 실행 전에 접근 가능성과 비용을 확인한다. 판정: RouteState·RiskState의 기존 접근·비용 조건을 확인한다. 성공: RiskState·ResourceState 출력과 방어 시설 배치 × 역사적 세력 균형의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 다른 경로를 선택하거나 실행하지 않고 되돌아간다. 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 따라서 방어 시설 배치의 경로와 비용이 바뀐다.","exitState":"다음 단계 DEVELOPMENT의 입장 조건과 세계 상태가 결정된다.","nextDecision":"DEVELOPMENT에서 변경된 RiskState·ResourceState가 다음 행동의 접근·위험 조건을 바꾸는지 시험한다.","startSeconds":0,"endSeconds":60,"timeReason":"OPENING에서 RouteState·RiskState 입력과 RiskState·ResourceState 출력의 설계 전이를 관찰하는 구간이다. 실제 실행 시간은 미검증이다.","before":[{"key":"WorldAccessState","value":0},{"key":"IntentState","value":0},{"key":"RouteState","value":0},{"key":"RiskState","value":0},{"key":"ResourceState","value":0}],"after":[{"key":"WorldAccessState","value":0},{"key":"IntentState","value":0},{"key":"RouteState","value":0},{"key":"RiskState","value":1},{"key":"ResourceState","value":1}],"actions":[{"abilityId":"VIBE_CHOOSE","actorId":"PLAYER","targetId":"WORLD","atSeconds":30,"distance":0,"energyBefore":10,"energyAfter":10,"hit":false,"response":"PLAYER가 첫 시스템의 경로 선택을 사용한다. 상대 대응을 관찰하고 확정 타격 없이 다음 선택으로 이어진다. 방어 시설 배치 × 역사적 세력 균형의 상태 출력 RiskState·ResourceState가 다음 시스템의 선택 조건에 전달된다."}],"ruleIds":["VIBE_A"],"outcome":"ONGOING"},"playerChoice":"접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다.","trigger":"시작 위치: 역사적 세력 균형의 첫 선택 공간. 안내: 역사적 세력 균형의 변화가 드러나는 고유 랜드마크를 첫 진입 때 표시한다. 현재 목표와 가능한 첫 행동을 확인한다.","stateChange":"입력: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 실행 전에 접근 가능성과 비용을 확인한다. 판정: RouteState·RiskState의 기존 접근·비용 조건을 확인한다. 성공: RiskState·ResourceState 출력과 방어 시설 배치 × 역사적 세력 균형의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 다른 경로를 선택하거나 실행하지 않고 되돌아간다. 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 따라서 방어 시설 배치의 경로와 비용이 바뀐다.","linkedRuleIds":["VIBE_A"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["ENTRY_FIRST_INPUT_CONDITION_FEEDBACK_RESULT_NEXT_CHOICE_CONNECTED","CANCEL_FAILURE_AND_RETRY_PRESERVE_EXISTING_STATE_AND_SAVE","PLANNED_BEFORE_AFTER_VALUES_ARE_NOT_RUNTIME_EVIDENCE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 OPENING 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"PLAYTHROUGH[1]","family":"PLAYTHROUGH","index":1,"title":"DEVELOPMENT","authoredId":null,"designDetail":{"phase":"DEVELOPMENT","entryState":"다음 단계 DEVELOPMENT의 입장 조건과 세계 상태가 결정된다.","playerChoice":"웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다.","actionAndResponse":"입력: 웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 실행 전에 A의 이전 결과를 읽는다. 판정: RiskState·ResourceState의 기존 접근·비용 조건을 확인한다. 성공: RouteState·RiskState 출력과 적 패턴과 자원 대응 × 왕조의 정통성과 민심의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 대응을 취소하고 이전 안전 단계로 돌아간다. 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 따라서 적 패턴과 자원 대응의 정보·대응이 바뀐다.","exitState":"다음 단계 RESOLUTION의 입장 조건과 세계 상태가 결정된다.","nextDecision":"RESOLUTION에서 변경된 RouteState·RiskState가 다음 행동의 접근·위험 조건을 바꾸는지 시험한다.","startSeconds":60,"endSeconds":120,"timeReason":"DEVELOPMENT에서 RiskState·ResourceState 입력과 RouteState·RiskState 출력의 설계 전이를 관찰하는 구간이다. 실제 실행 시간은 미검증이다.","before":[{"key":"WorldAccessState","value":0},{"key":"IntentState","value":0},{"key":"RouteState","value":0},{"key":"RiskState","value":1},{"key":"ResourceState","value":1}],"after":[{"key":"WorldAccessState","value":0},{"key":"IntentState","value":0},{"key":"RouteState","value":1},{"key":"RiskState","value":2},{"key":"ResourceState","value":1}],"actions":[{"abilityId":"VIBE_RESPOND","actorId":"PLAYER","targetId":"WORLD","atSeconds":90,"distance":0,"energyBefore":10,"energyAfter":10,"hit":false,"response":"PLAYER가 두 번째 시스템의 대응 선택을 사용한다. 상대 대응을 관찰하고 확정 타격 없이 다음 선택으로 이어진다. 적 패턴과 자원 대응 × 왕조의 정통성과 민심의 상태 출력 RouteState·RiskState가 다음 시스템의 선택 조건에 전달된다."}],"ruleIds":["VIBE_B"],"outcome":"ONGOING"},"playerChoice":"웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다.","trigger":"다음 단계 DEVELOPMENT의 입장 조건과 세계 상태가 결정된다.","stateChange":"입력: 웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 실행 전에 A의 이전 결과를 읽는다. 판정: RiskState·ResourceState의 기존 접근·비용 조건을 확인한다. 성공: RouteState·RiskState 출력과 적 패턴과 자원 대응 × 왕조의 정통성과 민심의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 대응을 취소하고 이전 안전 단계로 돌아간다. 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 따라서 적 패턴과 자원 대응의 정보·대응이 바뀐다.","linkedRuleIds":["VIBE_B"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["ENTRY_FIRST_INPUT_CONDITION_FEEDBACK_RESULT_NEXT_CHOICE_CONNECTED","CANCEL_FAILURE_AND_RETRY_PRESERVE_EXISTING_STATE_AND_SAVE","PLANNED_BEFORE_AFTER_VALUES_ARE_NOT_RUNTIME_EVIDENCE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 DEVELOPMENT 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"PLAYTHROUGH[2]","family":"PLAYTHROUGH","index":2,"title":"RESOLUTION","authoredId":null,"designDetail":{"phase":"RESOLUTION","entryState":"다음 단계 RESOLUTION의 입장 조건과 세계 상태가 결정된다.","playerChoice":"역사적 세력 균형의 제약과 왕조의 정통성과 민심의 대응을 같은 지역에서 순서대로 시험한다.","actionAndResponse":"입력: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 실행 전에 접근 가능성과 비용을 확인한다. 판정: RouteState·RiskState의 기존 접근·비용 조건을 확인한다. 성공: WorldAccessState·IntentState 출력과 금기와 기회의 교차의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 다른 경로를 선택하거나 실행하지 않고 되돌아간다. 방어 시설 배치에서 평소에는 불가능했던 대안 경로와 선택을 연다.","exitState":"한 판의 결과와 다음 선택을 기록한다.","nextDecision":"이전에 변한 세계 상태와 발견 정보를 비교하고 새로운 접근 경로 또는 재시작 방법을 고른다.","startSeconds":120,"endSeconds":180,"timeReason":"RESOLUTION에서 RouteState·RiskState 입력과 WorldAccessState·IntentState 출력의 설계 전이를 관찰하는 구간이다. 실제 실행 시간은 미검증이다.","before":[{"key":"WorldAccessState","value":0},{"key":"IntentState","value":0},{"key":"RouteState","value":1},{"key":"RiskState","value":2},{"key":"ResourceState","value":1}],"after":[{"key":"WorldAccessState","value":1},{"key":"IntentState","value":1},{"key":"RouteState","value":1},{"key":"RiskState","value":2},{"key":"ResourceState","value":1}],"actions":[{"abilityId":"VIBE_CHOOSE","actorId":"PLAYER","targetId":"WORLD","atSeconds":150,"distance":0,"energyBefore":10,"energyAfter":10,"hit":false,"response":"PLAYER가 첫 시스템의 경로 선택을 사용한다. 상대 대응을 관찰하고 확정 타격 없이 다음 선택으로 이어진다. 금기와 기회의 교차의 상태 출력 WorldAccessState·IntentState가 다음 시스템의 선택 조건에 전달된다."}],"ruleIds":["VIBE_DELVE","VIBE_A"],"outcome":"SUCCESS"},"playerChoice":"역사적 세력 균형의 제약과 왕조의 정통성과 민심의 대응을 같은 지역에서 순서대로 시험한다.","trigger":"다음 단계 RESOLUTION의 입장 조건과 세계 상태가 결정된다.","stateChange":"입력: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 실행 전에 접근 가능성과 비용을 확인한다. 판정: RouteState·RiskState의 기존 접근·비용 조건을 확인한다. 성공: WorldAccessState·IntentState 출력과 금기와 기회의 교차의 피드백을 함께 보여준다. 실패·취소: 기존 상태를 보존하고 다른 경로를 선택하거나 실행하지 않고 되돌아간다. 방어 시설 배치에서 평소에는 불가능했던 대안 경로와 선택을 연다.","linkedRuleIds":["VIBE_DELVE","VIBE_A"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["ENTRY_FIRST_INPUT_CONDITION_FEEDBACK_RESULT_NEXT_CHOICE_CONNECTED","CANCEL_FAILURE_AND_RETRY_PRESERVE_EXISTING_STATE_AND_SAVE","PLANNED_BEFORE_AFTER_VALUES_ARE_NOT_RUNTIME_EVIDENCE"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 RESOLUTION 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"CORE_LOOP[0]","family":"CORE_LOOP","index":0,"title":"방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보