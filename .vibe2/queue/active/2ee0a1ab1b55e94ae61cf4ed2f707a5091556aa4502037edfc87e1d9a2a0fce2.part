Id":"defense-build-up-g2-8b5c5698bb02","directiveFingerprint":"8b5c5698bb02140c89d8f5c645ed7267d3cac7b73c73e6b2fa7285af3d75e21d","previousDirectiveFingerprint":"0118e60314320b8999946dd660a303bce58df213bd1ab9ca98b37f6959bfdfe0","forbiddenRepeatFingerprint":"0118e60314320b8999946dd660a303bce58df213bd1ab9ca98b37f6959bfdfe0","gameId":"defense","gameName":"숲길 디펜스","generation":2,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","escalationMode":"CONTINUE_UNVERIFIED_DEPTH","previousDirectiveOutcome":"blocked","designContextMode":"APPROVED_OR_MINIMUM_DESIGN","platform":"WEB","sourceRoot":"web-games/defense","sourceTreeFingerprint":"1d0025990d856d7575da7ce5472a4aaa2d2764376d7b26dc51c9d5ec0a208df9","designFingerprint":"2e4c917d72ee812bd324c3eb097c03ef4c83ad879084ed11312192f4f62e8c56","designSourceBuildUp":{"version":1,"scope":"EXISTING_DESIGN_AND_GAME_BUILD_UP_ONLY","currentDesignFingerprint":"2e4c917d72ee812bd324c3eb097c03ef4c83ad879084ed11312192f4f62e8c56","previousDesignFingerprint":"2e4c917d72ee812bd324c3eb097c03ef4c83ad879084ed11312192f4f62e8c56","sameApprovedDesign":true,"previousVerifiedOutcome":false,"revisionRequiredForNewGameplay":false,"nextDesignAction":"TRACE_CURRENT_APPROVED_DESIGN_TO_NATIVE_SOURCE","sourceAuthority":"LATEST_APPROVED_SAME_GAME_DESIGN_ONLY","referenceA":null,"baselineB":null,"benchmarkDimensions":["INPUT_AND_PRIMARY_ACTION","HUD_AND_MENU_FLOW","CAMERA_AND_FEEDBACK","COMBAT_OR_CORE_LOOP","WORLD_AND_LEVEL_PROGRESSION","EQUIPMENT_REWARDS_AND_GROWTH","ONBOARDING_AND_FIRST_SESSION","FAILURE_RETRY_SAVE_RECOVERY","MID_LATE_DEPTH"],"loop":["REVIEW_GAME_AND_NAMED_REFERENCE_EVIDENCE","REVISE_MAIN_A_B_C_D_AT_DESIGN","STRICT_DESIGN_REVIEW","BIND_RULE_IDS_TO_EXISTING_RESPONSIBLE_SOURCE","BUILD_SOURCE","EXACT_BUILD_RUNTIME_QA","NEXT_DESIGN_REVISION_FROM_VERIFIED_GAPS"],"provenanceRule":"NAMED_SOURCE_OBSERVED_MECHANICS_OR_UNVERIFIED; NEVER_COPY_DISTINCTIVE_UI_ART_CHAR_TEXT_CODE","confirmedRuntimePass":false,"preserves":["OWNER_GAME_IDENTITY","CORE_RULES","BALANCE","ECONOMY","SAVE_KEYS_AND_MEANING","NETWORK_AUTHORITY"]},"identityReinforcement":{"appliesToAllGenres":true,"genre":"Strategy","oneLineFantasy":"숲길 디펜스의 플레이어는 방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다.을 결정하고 두 소재가 만드는 반작용을 책임진다.","representativeAction":"방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다.","representativeChoice":"방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다.","signatureWorldRule":"VIBE_MAIN 출력 RouteState → VIBE_A 입력. 후속 선택: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다.","signatureSystems":["숲길 디펜스","방어 시설 배치 × 역사적 세력 균형","적 패턴과 자원 대응 × 왕조의 정통성과 민심","금기와 기회의 교차"],"growthIdentity":"성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 방어 시설 배치의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 적 패턴과 자원 대응의 새 상대는 기존 상태를 증폭하거나 반전한다.","threeSentenceTest":{"whatGame":"숲길 디펜스. 역사적 세력 균형·왕조의 정통성과 민심 전략. 숲길 디펜스에서 방어 시설 배치 × 역사적 세력 균형과 적 패턴과 자원 대응 × 왕조의 정통성과 민심이 서로 결과를 되돌려 바꾸며 전략·추리의 판단이 실제 세계 상태를 변화시킨다.","whatDifferent":"숲길 디펜스에서 방어 지휘관가 방어 시설 배치와 적 패턴과 자원 대응의 선택을 통해 역사적 세력 균형·왕조의 정통성과 민심의 인과법칙을 바꾸는 전략 복합 게임에서 플레이어는 선택을 누적해 목적을 완수한다. 게임의 반복 목표와 세계의 접근 가능성을 상태로 관리한다.","whatGrowthUnlocks":"성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 방어 시설 배치의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 적 패턴과 자원 대응의 새 상대는 기존 상태를 증폭하거나 반전한다."},"causalGrammarEvidence":{"worldRules":["역사적 세력 균형에 의해 바뀐 인물·지역의 상태는 왕조의 정통성과 민심의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다."],"causalInspirations":[{"titleOrTradition":"POLITICAL_HISTORY_DIPLOMACY","rightsBasis":"ABSTRACT_TECHNIQUE","borrowedTechnique":"한 세력의 완전한 승리가 오히려 더 큰 불균형과 반발을 만든다.","transformation":"적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다.의 구조만 독자적 인물·세계·상호작용으로 재해석한다."},{"titleOrTradition":"EAST_ASIAN_POLITICAL_HISTORY","rightsBasis":"ABSTRACT_TECHNIQUE","borrowedTechnique":"통치 권한은 힘만이 아니라 인정·질서·민심에 의해 유지된다.","transformation":"영토보다 정당성과 지지가 실제 통치 가능성을 결정한다.의 구조만 독자적 인물·세계·상호작용으로 재해석한다."}],"systemInterconnections":[{"fromId":"VIBE_MAIN","toId":"VIBE_A","stateKeys":["RouteState"],"fromSystem":"숲길 디펜스","toSystem":"방어 시설 배치 × 역사적 세력 균형","trigger":"숲길 디펜스의 선택: 방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 기존 선행조건을 만족해 RouteState 출력이 확정됐을 때 방어 시설 배치 × 역사적 세력 균형이 같은 키를 읽는다.","stateChange":"VIBE_MAIN 출력 RouteState → VIBE_A 입력. 후속 선택: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다."},{"fromId":"VIBE_A","toId":"VIBE_B","stateKeys":["RiskState","ResourceState"],"fromSystem":"방어 시설 배치 × 역사적 세력 균형","toSystem":"적 패턴과 자원 대응 × 왕조의 정통성과 민심","trigger":"방어 시설 배치 × 역사적 세력 균형의 선택: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다. 기존 선행조건을 만족해 RiskState·ResourceState 출력이 확정됐을 때 적 패턴과 자원 대응 × 왕조의 정통성과 민심이 같은 키를 읽는다.","stateChange":"VIBE_A 출력 RiskState·ResourceState → VIBE_B 입력. 후속 선택: 웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 왕조의 정통성과 민심의 반작용을 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다."},{"fromId":"VIBE_B","toId":"VIBE_A","stateKeys":["RouteState","RiskState"],"fromSystem":"적 패턴과 자원 대응 × 왕조의 정통성과 민심","toSystem":"방어 시설 배치 × 역사적 세력 균형","trigger":"적 패턴과 자원 대응 × 왕조의 정통성과 민심의 선택: 웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 왕조의 정통성과 민심의 반작용을 선택한다. 기존 선행조건을 만족해 RouteState·RiskState 출력이 확정됐을 때 방어 시설 배치 × 역사적 세력 균형이 같은 키를 읽는다.","stateChange":"VIBE_B 출력 RouteState·RiskState → VIBE_A 입력. 후속 선택: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다."},{"fromId":"VIBE_B","toId":"VIBE_DELVE","stateKeys":["RouteState","RiskState"],"fromSystem":"적 패턴과 자원 대응 × 왕조의 정통성과 민심","toSystem":"금기와 기회의 교차","trigger":"적 패턴과 자원 대응 × 왕조의 정통성과 민심의 선택: 웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 왕조의 정통성과 민심의 반작용을 선택한다. 기존 선행조건을 만족해 RouteState·RiskState 출력이 확정됐을 때 금기와 기회의 교차이 같은 키를 읽는다.","stateChange":"VIBE_B 출력 RouteState·RiskState → VIBE_DELVE 입력. 후속 선택: 역사적 세력 균형의 제약과 왕조의 정통성과 민심의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다."},{"fromId":"VIBE_DELVE","toId":"VIBE_MAIN","stateKeys":["WorldAccessState","IntentState"],"fromSystem":"금기와 기회의 교차","toSystem":"숲길 디펜스","trigger":"금기와 기회의 교차의 선택: 역사적 세력 균형의 제약과 왕조의 정통성과 민심의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 기존 선행조건을 만족해 WorldAccessState·IntentState 출력이 확정됐을 때 숲길 디펜스이 같은 키를 읽는다.","stateChange":"VIBE_DELVE 출력 WorldAccessState·IntentState → VIBE_MAIN 입력. 후속 선택: 방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다."},{"fromId":"VIBE_A","toId":"VIBE_DELVE","stateKeys":["RiskState"],"fromSystem":"방어 시설 배치 × 역사적 세력 균형","toSystem":"금기와 기회의 교차","trigger":"방어 시설 배치 × 역사적 세력 균형의 선택: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 역사적 세력 균형의 제약을 감수할지 결정한다. 기존 선행조건을 만족해 RiskState 출력이 확정됐을 때 금기와 기회의 교차이 같은 키를 읽는다.","stateChange":"VIBE_A 출력 RiskState → VIBE_DELVE 입력. 후속 선택: 역사적 세력 균형의 제약과 왕조의 정통성과 민심의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 가능 여부·위험을 전후 비교한다. 취소·조건 미충족이면 출력과 후속 선택을 보존한다. 결과는 연결된 다음 규칙으로 전달하며 기존 저장·보상 수치는 유지한다."}],"expansionPlan":[{"milestone":"초반 선택에 따른 접근 경로와 위험 재구성","newGameplay":"방어 시설 배치의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.","systemImpact":"VIBE_A의 기존 Luau 책임 함수에서 RouteState·RiskState 입력 → RiskState·ResourceState 출력 → VIBE_B의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.","trigger":"기존 첫 진입 조건을 만족하고 숲길 디펜스의 목표를 확인한 뒤 방어 시설 배치 × 역사적 세력 균형의 접근 가능한 선택을 제시한다.","playerChoice":"접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다.","ruleIds":["VIBE_MAIN","VIBE_A","VIBE_B"],"stateKeys":["RouteState","RiskState","ResourceState"],"failureRecovery":"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.","validationEvidence":"동일 시작 상태에서 방어 시설 배치 × 역사적 세력 균형의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다."},{"milestone":"중반 두 시스템의 반작용과 대응 조건 충돌","newGameplay":"적 패턴과 자원 대응의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.","systemImpact":"VIBE_B의 기존 Luau 책임 함수에서 RiskState·ResourceState 입력 → RouteState·RiskState 출력 → VIBE_A의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.","trigger":"직전 확장 단계의 행동 결과가 현재 RiskState·ResourceState와 일치할 때 후속 선택을 연다. 기존 해금 조건을 확인하며 임의 수치를 추가하지 않는다.","playerChoice":"웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다.","ruleIds":["VIBE_MAIN","VIBE_A","VIBE_B"],"stateKeys":["RiskState","ResourceState","RouteState"],"failureRecovery":"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.","validationEvidence":"동일 시작 상태에서 적 패턴과 자원 대응 × 왕조의 정통성과 민심의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다."},{"milestone":"숨겨진 세계 인과법칙을 이용한 새로운 접근","newGameplay":"서사시의 맹세와 계약과 비극과 희극의 운명 반전의 조합에 다른 인간 갈등을 연결한다. 숨겨진 규칙의 발견으로 우회 접근과 새로운 대응법을 연다.","systemImpact":"VIBE_A의 기존 Luau 책임 함수에서 RouteState·RiskState 입력 → RiskState·ResourceState 출력 → VIBE_B의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.","trigger":"직전 확장 단계의 행동 결과가 현재 RouteState·RiskState와 일치할 때 후속 선택을 연다. 기존 해금 조건을 확인하며 임의 수치를 추가하지 않는다.","playerChoice":"역사적 세력 균형의 제약과 왕조의 정통성과 민심의 대응을 같은 지역에서 순서대로 시험한다.","ruleIds":["VIBE_MAIN","VIBE_A","VIBE_B","VIBE_DELVE"],"stateKeys":["RouteState","RiskState","ResourceState"],"failureRecovery":"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.","validationEvidence":"동일 시작 상태에서 방어 시설 배치 × 역사적 세력 균형의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다."},{"milestone":"누적된 관계를 되짚는 재방문과 장기 숙련","newGameplay":"발견된 단서와 숙련을 기존 시스템 두 개 이상의 새로운 운용으로 확장한다. 재방문 시 이전 행동이 만든 관계·접근 조건과 결말을 다시 평가한다.","systemImpact":"VIBE_B의 기존 Luau 책임 함수에서 RiskState·ResourceState 입력 → RouteState·RiskState 출력 → VIBE_A의 다음 선택으로 연결한다. 저장·밸런스·보상 의미를 유지한다.","trigger":"직전 확장 단계의 행동 결과가 현재 RiskState·ResourceState와 일치할 때 후속 선택을 연다. 기존 해금 조건을 확인하며 임의 수치를 추가하지 않는다.","playerChoice":"접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다.와 웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다.를 이전 결과와 비교해 재방문 경로를 고른다.","ruleIds":["VIBE_MAIN","VIBE_A","VIBE_B","VIBE_DELVE"],"stateKeys":["RiskState","ResourceState","RouteState"],"failureRecovery":"조건 미충족·취소·재접속 시 기존 진행과 저장을 보존하고 기존 재시도 경로로 복귀한다. 보상 중복 지급과 선행조건 건너뛰기를 검사한다.","validationEvidence":"동일 시작 상태에서 적 패턴과 자원 대응 × 왕조의 정통성과 민심의 실행·대안 선택·취소를 각각 비교해 새 선택과 후속 상태가 달라지는지 확인한다. 기존 책임 함수의 실제 소스 변경과 정확한 개정의 F0~F9 증거로 확인하며 설계 숫자를 런타임 증거로 사용하지 않는다."}],"integrityNotes":["이 결과는 정해진 설계 규칙의 도달성 계산이며 실제 게임 실행 결과를 의미하지 않는다.","저장·동기화·실제 조작은 기존 개발 및 독립 QA 과정에서 추가 검증해야 한다."],"formula":"MAIN × A × B × C + @","existingGameGrammarMap":{"mode":"EXISTING_GAME_RECONSTRUCTION_FROM_CURRENT_DESIGN_AND_INSPECTED_SOURCE","formula":"MAIN × A × B × C + @","main":"숲길 디펜스: 숲길 디펜스. 방어 시설 배치: 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다.과 방어 시설 배치의 결과를 적 패턴과 자원 대응로 전환하고 달라진 조건을 다시 활용한다.를 반복하는 게임이다.","source":"DESIGNER_AUTHORED_ROLE_IDS_AND_STATE_LINKS","roleSystemIds":{"MAIN":"VIBE_MAIN","A":"VIBE_A","B":"VIBE_B","c":[],"AT":["VIBE_DELVE"]},"majorAxes":[{"key":"A","systemId":"VIBE_A","name":"방어 시설 배치 × 역사적 세력 균형","source":"DESIGNER_AUTHORED_ROLE_A"},{"key":"B","systemId":"VIBE_B","name":"적 패턴과 자원 대응 × 왕조의 정통성과 민심","source":"DESIGNER_AUTHORED_ROLE_B"}],"cSubElements":[],"sourcedAxes":{"A":{"system":"방어 시설 배치 × 역사적 세력 균형","material":"역사적 세력 균형","materialDomain":"political history diplomacy의 문화·역사 인과 소재","stateChange":"적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 따라서 방어 시설 배치의 경로와 비용이 바뀐다. 플레이어가 방어 시설 배치을 선택하면 역사적 세력 균형의 규칙에 따라 다음 위험과 가능 행동이 변화한다. 그 결과 적 패턴과 자원 대응 × 왕조의 정통성과 민심의 다음 행동 조건이 달라진다."},"B":{"system":"적 패턴과 자원 대응 × 왕조의 정통성과 민심","material":"왕조의 정통성과 민심","materialDomain":"east asian political history의 문화·역사 인과 소재","stateChange":"영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 따라서 적 패턴과 자원 대응의 정보·대응이 바뀐다. 플레이어가 적 패턴과 자원 대응을 선택하면 왕조의 정통성과 민심의 규칙에 따라 처음 선택으로 되돌아갈 비용·정보·접근 조건이 변화한다. 그 결과 방어 시설 배치 × 역사적 세력 균형의 선택 비용과 경로가 달라진다."}},"cGenreThemes":[{"name":"서사시의 맹세와 계약","kind":"MATERIAL","gameplayEffect":"보상 획득이 동시에 행동 제한·동맹 의무·위험을 생성한다. 그 결과 A와 B가 공유하는 조건이 바뀐다."},{"name":"비극과 희극의 운명 반전","kind":"MATERIAL","gameplayEffect":"큰 성공이 다음 위험의 재료가 되고 실패가 새로운 기회의 자원이 된다. 그 결과 사건의 비용과 다음 선택이 달라진다."}],"dCreations":[],"cPrimarySecondaryGenres":[{"role":"PRIMARY","name":"전략","gameplayEffect":"방어 시설 배치와 적 패턴과 자원 대응를 통한 중심 목표와 위험·보상을 판단한다."},{"role":"SECONDARY","name":"추리","gameplayEffect":"서사시의 맹세와 계약의 단서와 비극과 희극의 운명 반전의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다."}],"cGenreInterlock":"전략 장르의 주 목표를 진행하는 동안 추리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 추리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.","cCausalWorldEffect":"역사적 세력 균형에 의해 바뀐 인물·지역의 상태는 왕조의 정통성과 민심의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 서사시의 맹세와 계약와 비극과 희극의 운명 반전가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 접근 경로와 적의 사거리 사이에서 배치 위치를 선택하면서 적 제거보다 세력 간 힘의 비율을 조절하는 것이 장기 승리 조건이 된다. 그 결과 적 패턴과 자원 대응의 가능 행동과 위험이 바뀌며, 웨이브와 자원 상태에 따라 강화·수리·대응 대상을 결정하면서 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 다시 방어 시설 배치의 조건을 바꾼다.","atUnboundedGrowthRule":"금기와 기회의 교차 이후 새로운 발견은 A와 B, C 장르 반응의 서로 다른 조건을 실험해 새 길·정보·관계·숙련을 열고 제한 없이 깊어진다.","standardGrammarVersion":null,"delveAtEvidence":["금기와 기회의 교차: 한 세력의 완전한 승리가 오히려 더 큰 불균형과 반발을 만든다. 상황을 영토보다 정당성과 지지가 실제 통치 가능성을 결정한다. 방식으로 해석한다.","되돌아온 선택: 통치 권한은 힘만이 아니라 인정·질서·민심에 의해 유지된다. 결과가 과거 선택의 의미를 바꿀 수 있음을 발견한다.","두 소재의 숨은 규칙: 맹세와 계약은 권리와 동시에 구속을 만든다. 원리와 최고점과 최저점이 서로의 원인이 되어 운명이 반전된다. 원리가 동시에 작동함을 파악한다.","역전된 종착점: 한쪽의 불리한 결과가 다른 쪽의 고급 활용 조건이 되는 인과 반전을 학습한다.","금기와 기회의 교차","초반 선택에 따른 접근 경로와 위험 재구성","방어 시설 배치의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.","중반 두 시스템의 반작용과 대응 조건 충돌","적 패턴과 자원 대응의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.","숨겨진 세계 인과법칙을 이용한 새로운 접근"],"sourceTreeFingerprint":"1d0025990d856d7575da7ce5472a4aaa2d2764376d7b26dc51c9d5ec0a208df9","rule":"MAIN_IS_GAME_TOPIC; A_AND_B_EACH_REQUIRE_SYSTEM_AND_SOURCE_MATERIAL; C_HAS_TWO_CREATIVE_MATERIALS_AND_PRIMARY_SECONDARY_DISTINCT_GENRES_WITH_GAMEPLAY_INTERLOCK; A_B_CAUSAL_PLAY_CHANGES_WORLD_STORY; @ IS_UNBOUNDED_DISCOVERY_MASTERY_AND_REVISIT","identityRewriteRequired":false,"existingBalanceSaveEconomyAndAuthorityPreserved":true},"rule":"NEW_CONTENT_MUST_DEEPEN_MAIN_TOPIC_A_B_SOURCED_SYSTEMS_C_CREATIVE_THEMES_AND_PRIMARY_SECONDARY_GENRE_INTERLOCK; OPTIONAL_LEGACY_c_IS_NOT_C_OR_A_MAJOR_AXIS; @ IS_DELVE_LAYER; DECORATIVE_LORE_OR_PARALLEL_FEATURE_STACK_DOES_NOT_COUNT","familiarHumanConflictShouldRemainReadable":true},"buildUpRule":"EACH_BUILD_UP_MUST_STRENGTHEN_OR_PRESERVE_THE_REPRESENTATIVE_ACTION_CHOICE_WORLD_RULE_SIGNATURE_SYSTEM_OR_GROWTH_IDENTITY; GENERIC_FEATURE_COUNT_DOES_NOT_COUNT","genreAdaptationRule":"PRESERVE_THE_GENRE_PRIMARY_ACTION; DO_NOT_FORCE_RPG_STYLE_SYSTEMS_ON_PUZZLE_RACING_TYCOON_DEFENSE_SURVIVAL_ACTION_CARD_BOARD_STRATEGY_CASUAL_OR_OTHER_GENRES"},"designToPlatformCodingTrace":{"version":1,"authority":"GAME_DESIGN_TO_EXISTING_PLATFORM_BUILD_UP_LINK","gameId":"defense","requestedPlatform":"WEB","activePlatform":"NOT_SELECTED_NATIVE_PLATFORM","originalSourcePlatform":"ROBLOX","originalSourceLanguage":"LUAU","unityWebSourceSync":null,"designFingerprint":"2e4c917d72ee812bd324c3eb097c03ef4c83ad879084ed11312192f4f62e8c56","sourceTreeFingerprint":"1d0025990d856d7575da7ce5472a4aaa2d2764376d7b26dc51c9d5ec0a208df9","multiplayerMode":"COOP","multiplayerRequired":false,"minimumParticipants":1,"platformCodingPlans":[{"platform":"ROBLOX","canonicalGameSourceRoot":"roblox-games/defense","sharedUnitySource":false,