easons":["static-review-report-missing-or-invalid"]},"buildUpDirective":{"version":2,"directiveId":"village-dungeons-build-up-g34-b1e940c9b70e","directiveFingerprint":"b1e940c9b70e9515f410d2f2e31b554c2f92bf7cea1f71f77a1d7ab784b45830","previousDirectiveFingerprint":"cfa51495cec76cf5728a44382bbd5e0be003125ac28ba9261f7e1ee83592e29e","forbiddenRepeatFingerprint":"cfa51495cec76cf5728a44382bbd5e0be003125ac28ba9261f7e1ee83592e29e","gameId":"village-dungeons","gameName":"마을 던전 RPG","generation":34,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","escalationMode":"CONTINUE_UNVERIFIED_DEPTH","previousDirectiveOutcome":"queued","designContextMode":"APPROVED_OR_MINIMUM_DESIGN","platform":"ROBLOX","sourceRoot":"roblox-games/village-dungeons","sourceTreeFingerprint":"f04cd812f5161ea07d86c61116d705c6da43f8c0cd6f60dbd83d4713cc4c914d","designFingerprint":"66c3672e92a3f54e4c59730d533a07721548e7f0f7ff5e4a112dc632bb01d59e","identityReinforcement":{"appliesToAllGenres":true,"genre":"RPG","oneLineFantasy":"플레이어는 몰락 직전의 개척 마을을 지키는 모험가가 되어 위험한 던전 심층부를 돌파하고 강력한 몬스터를 격퇴하며 회수한 고대 유물과 자원으로 마을 대장간과 연금술소를 재건해 전설적인 장비를 갖춘 수호자로 거듭나는 환상을 경험한다.","representativeAction":"마을 의뢰 게시판에서 자원 채취 및 특정 던전 몬스터 토벌 퀘스트를 수락하고 장비를 점검한다.","representativeChoice":"즉시 전투력을 높이는 무기 제련 시설을 우선 복구할 것인지, 소비 물약 효율과 던전 내 추가 부활 기회를 부여하는 연금소를 먼저 지을지 선택한다.","signatureWorldRule":"마을 대장간의 해금 레벨이 1단계 상승하며 기존 무기의 공격력 배율이 15% 영구 증가하고 화염 속성 인챈트가 활성화된다.","signatureSystems":["마을 재건 시설 연동 시스템","리스크 배낭 정밀 적재 시스템"],"growthIdentity":"초반 세션에서는 단순 타격과 짧은 3분 던전 탐색으로 기초 장비를 맞추게 하며, 중반에는 5대 던전의 상성 속성(화염, 냉기, 독, 암흑, 번개)에 맞춘 장비 세트 파밍과 마을 상위 시설 건설로 전략적 깊이를 확장하고, 종반에는 심층 보스 타임어택과 극한의 장비 옵션 튜닝을 통해 지속적인 육성 만족도를 제공한다.","threeSentenceTest":{"whatGame":"마을 던전 RPG는 위기 상황에 놓인 마을의 의뢰를 해결하기 위해 5개 던전의 자원과 위험 속으로 진입하여 직관적인 원서클 모바일 액션 전투를 수행하고 수집품을 마을 복구 시설에 환원하여 전투 빌드를 고유하게 완성해 나가는 루프 중심의 캐주얼 모바일 액션 롤플레잉 게임이다.","whatDifferent":"던전에서 획득한 고유 건축 목재와 광석을 마을 대장간·주점·연금 공방에 투자하여 영구적인 스탯 버프와 신규 스킬 트리를 해금한다.","whatGrowthUnlocks":"초반 세션에서는 단순 타격과 짧은 3분 던전 탐색으로 기초 장비를 맞추게 하며, 중반에는 5대 던전의 상성 속성(화염, 냉기, 독, 암흑, 번개)에 맞춘 장비 세트 파밍과 마을 상위 시설 건설로 전략적 깊이를 확장하고, 종반에는 심층 보스 타임어택과 극한의 장비 옵션 튜닝을 통해 지속적인 육성 만족도를 제공한다."},"causalGrammarEvidence":{"worldRules":[],"causalInspirations":[],"systemInterconnections":[{"fromSystem":"던전 전리품 수확 및 배낭 관리 시스템","toSystem":"마을 대장간 시설 업그레이드 시스템","trigger":"던전에서 특정 몬스터를 격퇴하고 고급 주괴를 배낭에 보관한 채 안전하게 마을로 귀환할 때 발생한다.","stateChange":"마을 대장간의 해금 레벨이 1단계 상승하며 기존 무기의 공격력 배율이 15% 영구 증가하고 화염 속성 인챈트가 활성화된다."},{"fromSystem":"마을 주점 의뢰 완료 및 명성 관리 시스템","toSystem":"5개 던전 심층 게이트 개방 시스템","trigger":"주점 NPC가 제시한 던전 정찰 퀘스트 3종을 모두 클리어하여 마을 평판 수치가 임계치에 도달할 때 발생한다.","stateChange":"폐쇄되었던 지하 용암 동굴 던전의 제2계층 진입 잠금이 해제되고 해당 구역의 적 등장 테이블이 엘리트 등급으로 갱신된다."},{"fromSystem":"전투 회피 성공 판정 및 콤보 시스템","toSystem":"던전 내 필살기 게이지 충전 시스템","trigger":"적의 붉은색 장판 공격 타이밍에 맞춰 플레이어가 회피 제스처를 성공적으로 수행할 때 발생한다.","stateChange":"플레이어의 회피 카운터가 1 누적되며 즉시 궁극기 분노 게이지가 25% 충전되고 다음 일반 타격 3회에 100% 치명타가 적용된다."}],"expansionPlan":[{"milestone":"1단계: 5대 던전 기초 탐험 구역 및 마을 3대 기본 시설 오픈","newGameplay":"단일 무기 액션과 기본 회피, 슬라임 및 고블린 계열 몬스터와의 전투 패턴 학습 및 배낭 수납 규칙을 체험한다.","systemImpact":"대장간 무기 강화 시스템과 주점 퀘스트 리프레시 시스템의 기본 데이터베이스가 활성화된다."},{"milestone":"2단계: 심층 보스 레이드 및 던전 속성 저항 장비 크래프팅 추가","newGameplay":"용암 지대와 얼음 계곡 던전이 열리며 장판 회피 기믹과 속성 스왑 공격 메커니즘이 새롭게 요구된다.","systemImpact":"연금술소 시설이 확장되어 속성 물약 제조와 무기 인챈트 슬롯 시스템이 메인 전투 루프에 편입된다."},{"milestone":"3단계: 무한의 미궁 시련 모드 및 고대 유물 연구소 콘텐츠 개방","newGameplay":"층마다 무작위 페널티와 버프가 부여되는 엔드게임 로그라이트형 연속 던전 돌파 콘텐츠가 도입된다.","systemImpact":"마을 중앙 고대 제단 시스템이 작동하여 캐릭터의 특성 포인트를 자유롭게 재분배할 수 있게 된다."}],"integrityNotes":[],"formula":"MATERIAL_CAUSAL_GRAMMAR × (MAIN × A × B × c) + @","existingGameGrammarMap":{"mode":"EXISTING_GAME_RECONSTRUCTION_FROM_CURRENT_DESIGN_AND_INSPECTED_SOURCE","formula":"MAIN × A × B × c + @","main":"마을 의뢰 게시판에서 자원 채취 및 특정 던전 몬스터 토벌 퀘스트를 수락하고 장비를 점검한다.","source":"LEGACY_DESIGN_HEURISTIC_NOT_IMPLEMENTATION_EVIDENCE","roleSystemIds":{"MAIN":null,"A":null,"B":null,"c":[],"AT":[]},"majorAxes":[{"key":"A","systemId":null,"name":"마을 재건 시설