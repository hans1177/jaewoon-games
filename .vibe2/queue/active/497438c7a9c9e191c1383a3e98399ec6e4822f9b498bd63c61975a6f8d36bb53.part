ymbols":[{"file":"roblox-games/village-dungeons/server/Game.server.luau","symbol":"addItemToInventory","kind":"FUNCTION"},{"file":"roblox-games/village-dungeons/server/Game.server.luau","symbol":"spawnBoss","kind":"FUNCTION"},{"file":"roblox-games/village-dungeons/server/Game.server.luau","symbol":"reviewDungeonState","kind":"FUNCTION"},{"file":"roblox-games/village-dungeons/server/Game.server.luau","symbol":"damageMonster","kind":"FUNCTION"},{"file":"roblox-games/village-dungeons/client/Game.client.luau","symbol":"render","kind":"FUNCTION"}],"designStatus":"DESIGN_REPAIR_REQUIRED","codingStatus":"SOURCE_OWNER_CANDIDATE_UNVERIFIED","executableBehaviorVerified":false,"actualRuntimeVerified":false,"evidenceNeeded":"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA"}],"observedGameCodeFiles":["roblox-games/village-dungeons/server/Game.server.luau","roblox-games/village-dungeons/shared/GameConfig.luau","roblox-games/village-dungeons/client/Game.client.luau"],"executableCodeCandidateFiles":["roblox-games/village-dungeons/server/Game.server.luau","roblox-games/village-dungeons/client/Game.client.luau"],"gapReasons":["DESIGN_MAIN_A_B_c_AT_INCOMPLETE","MULTIPLAYER_DESIGN_MODE_MISSING","DESIGN_ROLE_NOT_AUTHORED:MAIN","DESIGN_ROLE_NOT_AUTHORED:A","DESIGN_ROLE_NOT_AUTHORED:B","DESIGN_ROLE_NOT_AUTHORED:c","DESIGN_ROLE_NOT_AUTHORED:@"],"codingReviewState":"GAME_STAGE_LOCAL_REPAIR_REQUIRED","sourceImplementationPassed":false,"actualTwoClientPassed":false,"actualWebglRenderPassed":false,"independentQaPassed":false,"stageLocalAction":"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME","schemaAndMarkersAloneCannotPass":true,"newPipeline":false,"changesDevelopmentAdmission":false,"saveBalanceAndExistingMultiplayerMeaningPreserved":true},"designImplementationContext":{"source":"LATEST_VERIFIED_DESIGN_FIELDS","coreFun":"적의 공격 궤적을 직관적으로 회피하고 연타 공격을 적중시키는 순간의 즉각적인 손맛과 제한된 던전 인벤토리에 어떤 전리품을 챙길지 결정하여 마을 시설의 기술 트리로 환원할 때 일어나는 명확한 전투 스펙 향상의 쾌감이다.","coreLoop":["마을 의뢰 게시판에서 자원 채취 및 특정 던전 몬스터 토벌 퀘스트를 수락하고 장비를 점검한다.","5개로 분기된 던전 중 하나를 선택 진입하여 한 손 조작 기반의 실시간 회피 및 평타/스킬 연계로 몬스터를 격퇴한다.","한정된 던전 배낭 슬롯에 귀환용 고가치 자원과 장비 강화 재료를 취사선택하여 보관한다.","포털을 통해 안전하게 마을로 귀환하여 의뢰를 완료하고 수집 자원으로 대장간과 주점을 업그레이드한다.","확장된 시설 버프와 신규 제작 무기를 바탕으로 더 깊은 던전 층계 및 보스전에 도전한다."],"signatureSystems":[{"name":"마을 재건 시설 연동 시스템","purpose":"던전에서 획득한 고유 건축 목재와 광석을 마을 대장간·주점·연금 공방에 투자하여 영구적인 스탯 버프와 신규 스킬 트리를 해금한다.","playerChoice":"즉시 전투력을 높이는 무기 제련 시설을 우선 복구할 것인지, 소비 물약 효율과 던전 내 추가 부활 기회를 부여하는 연금소를 먼저 지을지 선택한다."},{"name":"리스크 배낭 정밀 적재 시스템","purpose":"던전 내 인벤토리 슬롯을 극도로 제한하여 플레이어가 매 전투 승리 시마다 리스크와 리턴을 저울질하도록 유도한다.","playerChoice":"안전한 마을 귀환 주문서를 유지하기 위해 회복 물약을 버릴 것인지, 희귀 보스 드롭 재료를 위해 체력 회복 수단을 포기할 것인지 결정한다."}],"systemInterconnections":[{"fromSystem":"던전 전리품 수확 및 배낭 관리 시스템","toSystem":"마을 대장간 시설 업그레이드 시스템","trigger":"던전에서 특정 몬스터를 격퇴하고 고급 주괴를 배낭에 보관한 채 안전하게 마을로 귀환할 때 발생한다.","stateChange":"마을 대장간의 해금 레벨이 1단계 상승하며 기존 무기의 공격력 배율이 15% 영구 증가하고 화염 속성 인챈트가 활성화된다."},{"fromSystem":"마을 주점 의뢰 완료 및 명성 관리 시스템","toSystem":"5개 던전 심층 게이트 개방 시스템","trigger":"주점 NPC가 제시한 던전 정찰 퀘스트 3종을 모두 클리어하여 마을 평판 수치가 임계치에 도달할 때 발생한다.","stateChange":"폐쇄되었던 지하 용암 동굴 던전의 제2계층 진입 잠금이 해제되고 해당 구역의 적 등장 테이블이 엘리트 등급으로 갱신된다."},{"fromSystem":"전투 회피 성공 판정 및 콤보 시스템","toSystem":"던전 내 필살기 게이지 충전 시스템","trigger":"적의 붉은색 장판 공격 타이밍에 맞춰 플레이어가 회피 제스처를 성공적으로 수행할 때 발생한다.","stateChange":"플레이어의 회피 카운터가 1 누적되며 즉시 궁극기 분노 게이지가 25% 충전되고 다음 일반 타격 3회에 100% 치명타가 적용된다."}],"progressionDirection":"초반 세션에서는 단순 타격과 짧은 3분 던전 탐색으로 기초 장비를 맞추게 하며, 중반에는 5대 던전의 상성 속성(화염, 냉기, 독, 암흑, 번개)에 맞춘 장비 세트 파밍과 마을 상위 시설 건설로 전략적 깊이를 확장하고, 종반에는 심층 보스 타임어택과 극한의 장비 옵션 튜닝을 통해 지속적인 육성 만족도를 제공한다.","progressionEconomyBalance":{"progressionLoop":"마을 퀘스트 수락 -> 3분 던전 런 파밍 -> 마을 복구 기여 -> 상위 장비 제작 및 다음 난이도 던전 해금의 선순환 구조를 확립한다.","resourceFlow":"일반 던전 몬스터는 기본 골드와 기초 목재를 산출하고, 엘리트 및 보스 몬스터는 특수 주괴와 영혼석을 드롭하며, 마을 시설 강화 시 자원을 소모하여 영구적 능력치를 보상으로 돌려준다.","balanceRules":"사망 시 던전에서 획득한 배낭 자원의 50%만 보존되며, 마을 시설 업그레이드 비용은 지수 함수 형태가 아닌 계단식 로그 곡선으로 설정해 무의미한 노가다를 방지한다."},"contentExpansionPlan":[{"milestone":"1단계: 5대 던전 기초 탐험 구역 및 마을 3대 기본 시설 오픈","newGameplay":"단일 무기 액션과 기본 회피, 슬라임 및 고블린 계열 몬스터와의 전투 패턴 학습 및 배낭 수납 규칙을 체험한다.","systemImpact":"대장간 무기 강화 시스템과 주점 퀘스트 리프레시 시스템의 기본 데이터베이스가 활성화된다."},{"milestone":"2단계: 심층 보스 레이드 및 던전 속성 저항 장비 크래프팅 추가","newGameplay":"용암 지대와 얼음 계곡 던전이 열리며 장판 회피 기믹과 속성 스왑 공격 메커니즘이 새롭게 요구된다.","systemImpact":"연금술소 시설이 확장되어 속성 물약 제조와 무기 인챈트 슬롯 시스템이 메인 전투 루프에 편입된다."},{"milestone":"3단계: 무한의 미궁 시련 모드 및 고대 유물 연구소 콘텐츠 개방","newGameplay":"층마다 무작위 페널티와 버프가 부여되는 엔드게임 로그라이트형 연속 던전 돌파 콘텐츠가 도입된다.","systemImpact":"마을 중앙 고대 제단 시스템이 작동하여 캐릭터의 특성 포인트를 자유롭게 재분배할 수 있게 된다."}],"failureRetryRisk":{"failureStates":["던전 탐험 중 플레이어 캐릭터의 체력이 0에 도달하여 쓰러짐","던전 탈출 포털 생성 전 보스 제한 시간 5분이 초과되어 붕괴에 휘말림"],"retryFlow":"패배 즉시 마을 의무실로 후송되며 던전 진행 상태와 획득 재료의 결산 창이 노출된 후 5초 이내에 마을 광장에서 다시 이동할 수 있도록 불필요한 대기 화면을 배제한다.","riskPressure":"사망 시 던전에서 획득한 미확인 보석과 희귀 재료의 50%를 소실하지만 이미 완료한 퀘스트 진행 카운트는 유지하여 불쾌감을 완화한다.","recoveryRules":"마을 의무실에서 즉시 무료로 체력을 100% 완충해 주며, 주점에서 하급 모험가 버프 물약을 제공하여 직후 재도전 시 1회에 한해 공격력 10% 보너스를 부여한다."},"platformFitPlan":{"targetPlatform":"UNITY","inputModel":"모바일 세로형 원서클 가상 조이스틱과 단일 다기능 탭/스와이프 액션 버튼을 채택하여 한 손 엄지손가락만으로 이동, 공격, 완벽 회피를 전부 구사할 수 있게 설계한다.","performanceBudget":"중저사양 모바일 기기(Snapdragon 680급) 기준 60fps 유지를 위해 씬 내 동시 렌더링 드로우콜을 65회 이하, 단일 던전 씬 정점 수를 7만 개 이하로 통제한다.","sessionConstraints":"모바일 사용자의 통근 시간과 짧은 휴식 시간에 맞춰 1개 던전 런의 소요 시간을 3분에서 최대 5분 내로 타이트하게 완결되도록 스테이지 길이를 조절한다."},"platformProfiles":{"ROBLOX":{"platform":"ROBLOX","inputModel":"Roblox touch controls first, with keyboard and gamepad parity through ContextActionService and Activated-based UI actions.","sessionModel":"Fast Roblox experience sessions with spawn, respawn, join-in-progress, and social re-entry semantics matched to the common game loop.","multiplayerRuntime":"single-player server boundary with local presentation; no fake multiplayer claims","performanceBudget":"Roblox mobile-first budget: bounded parts and effects, pooled transient objects, limited expensive per-frame work, and stable low-end frame pacing.","uiUx":"Roblox ScreenGui touch-safe layout with readable mobile controls, controller focus support, observable state feedback, and platform-native social affordances.","saveAndNetwork":"Server-validated RemoteEvents plus DataStore-backed persistent state only for approved save meaning; clients never own authoritative rewards or progression.","platformContentAdaptation":"Adapt \"마을 던전 RPG는 위기 상황에 놓인 마을의 의뢰를 해결하기 위해 5개 던전의 자원과 위험 속으로 진입하여 직관적인 원서클 모바일 액션 전투를 수행하고 수집품을 마을 복구 시설에 환원하여 전투 빌드를 고유하게 완성해 나가는 루프 중심의 캐주얼 모바일 액션 롤플레잉 게임이다.\" and its loop \"마을 의뢰 게시판에서 자원 채취 및 특정 던전 몬스터 토벌 퀘스트를 수락하고 장비를 점검한다. → 5개로 분기된 던전 중 하나를 선택 진입하여 한 손 조작 기반의 실시간 회피 및 평타/스킬 연계로 몬스터를 격퇴한다. → 한정된 던전 배낭 슬롯에 귀환용 고가치 자원과 장비 강화 재료를 취사선택하여 보관한다. → 포털을 통해 안전하게 마을로 귀환하여 의뢰를 완료하고 수집 자원으로 대장간과 주점을 업그레이드한다.\" to Roblox avatar scale, server/client authority, social sessions, and Roblox-native interaction without changing common gameplay meaning.","internalReleaseTarget":"Private or restricted Roblox experience published to Roblox servers so the owner and explicitly allowed testers can play before public release.","validationEvidence":"Exact published Roblox place and source revision, real Roblox runtime play, mobile controls, server/client boundary, save/rejoin when required, independent QA, and regression evidence."},"UNITY":{"platform":"UNITY","inputModel":"Unity Input System with touch-first on-screen controls, safe-area handling, keyboard and gamepad parity, and app pause/resume input recovery.","sessionModel":"Native mobile app sessions with cold start, suspend/resume, background/foreground transitions, process restart, and deterministic save restoration.","multiplayerRuntime":"single-player app session with local gameplay authority; networking remains disabled until design requires it","performanceBudget":"Android mobile budget covering memory, GPU, thermal load, battery, draw calls, shaders, particles, audio, pooling, GC pressure, and low-end frame pacing.","uiUx":"Unity UI safe-area responsive layout with touch targets, scalable HUD, controller navigation where relevant, and app-native loading/error/recovery states.","saveAndNetwork":"Versioned local save with explicit migration plus validated backend synchronization only when required; app lifecycle cannot silently corrupt progress.","platformContentAdaptation":"Adapt \"마을 던전 RPG는 위기 상황에 놓인 마을의 의뢰를 해결하기 위해 5개 던전의 자원과 위험 속으로 진입하여 직관적인 원서클 모바일 액션 전투를 수행하고 수집품을 마을 복구 시설에 환원하여 전투 빌드를 고유하게 완성해 나가는 루프 중심의 캐주얼 모바일 액션 롤플레잉 게임이다.\" and its loop \"마을 의뢰 게시판에서 자원 채취 및 특정 던전 몬스터 토벌 퀘스트를 수락하고 장비를 점검한다. → 5개로 분기된 던전 중 하나를 선택 진입하여 한 손 조작 기반의 실시간 회피 및 평타/스킬 연계로 몬스터를 격퇴한다. → 한정된 던전 배낭 슬롯에 귀환용 고가치 자원과 장비 강화 재료를 취사선택하여 보관한다. → 포털을 통해 안전하게 마을로 귀환하여 의뢰를 완료하고 수집 자원으로 대장간과 주점을 업그레이드한다.\" to Unity scenes, prefabs, mobile app lifecycle, touch UX, and Android packaging without changing common gameplay meaning.","internalReleaseTarget":"Internal or closed Android test build that can be installed and launched by the owner/testers before any public store release.","validationEvidence":"Exact APK/AAB source revision, install and launch, real touch gameplay, pause/resume, save/restore, performance, independent QA, regression, and package identity evidence."}},"webCanonicalDesign":{"role":"SHARED_DESIGN_WEB_APPLICATION","designAuthority":"GAME_DESIGN_REFERENCE_NOT_SOURCE_CODE_AUTHORITY","playerFlow":["마을 의뢰 게시판에서 자원 채취 및 특정 던전 몬스터 토벌 퀘스트를 수락하고 장비를 점검한다.","5개로 분기된 던전 중 하나를 선택 진입하여 한 손 조작 기반의 실시간 회피 및 평타/스킬 연계로 몬스터를 격퇴한다.","한정된 던전 배낭 슬롯에 귀환용 고가치 자원과 장비 강화 재료를 취사선택하여 보관한다.","포털을 통해 안전하게 마을로 귀환하여 의뢰를 완료하고 수집 자원으로 대장간과 주점을 업그레이드한다.","확장된 시설 버프와 신규 제작 무기를 바탕으로 더 깊은 던전 층계 및 보스전에 도전한다."],"worldAndTraversal":"","systemsAndContent":"name: 마을 재건 시설 연동 시스템; purpose: 던전에서 획득한 고유 건축 목재와 광석을 마을 대장간·주점·연금 공방에 투자하여 영구적인 스탯 버프와 신규 스킬 트리를 해금한다.; playerChoice: 즉시 전투력을 높이는 무기 제련 시설을 우선 복구할 것인지, 소비 물약 효율과 던전 내 추가 부활 기회를 부여하는 연금소를 먼저 지을지 선택한다. / name: 리스크 배낭 정밀 적재 시스템; purpose: 던전 내 인벤토리 슬롯을 극도로 제한하여 플레이어가 매 전투 승리 시마다 리스크와 리턴을 저울질하도록 유도한다.; playerChoice: 안전한 마을 귀환 주문서를 유지하기 위해 회복 물약을 버릴 것인지, 희귀 보스 드롭 재료를 위해 체력 회복 수단을 포기할 것인지 결정한다.","combatAndInteraction":"적의 공격 궤적을 직관적으로 회피하고 연타 공격을 적중시키는 순간의 즉각적인 손맛과 제한된 던전 인벤토리에 어떤 전리품을 챙길지 결정하여 마을 시설의 기술 트리로 환원할 때 일어나는 명확한 전투 스펙 향상의 쾌감이다.","progressionAndEconomy":"progressionLoop: 마을 퀘스트 수락 -> 3분 던전 런 파밍 -> 마을 복구 기여 -> 상위 장비 제작 및 다음 난이도 던전 해금의 선순환 구조를 확립한다.; resourceFlow: 일반 던전 몬스터는 기본 골드와 기초 목재를 산출하고, 엘리트 및 보스 몬스터는 특수 주괴와 영혼석을 드롭하며, 마을 시설 강화 시 자원을 소모하여 영구적 능력치를 보상으로 돌려준다.; balanceRules: 사망 시 던전에서 획득한 배낭 자원의 50%만 보존되며, 마을 시설 업그레이드 비용은 지수 함수 형태가 아닌 계단식 로그 곡선으로 설정해 무의미한 노가다를 방지한다.","sessionFailureRecovery":"failureStates: 던전 탐험 중 플레이어 캐릭터의 체력이 0에 도달하여 쓰러짐 / 던전 탈출 포털 생성 전 보스 제한 시간 5분이 초과되어 붕괴에 휘말림; retryFlow: 패배 즉시 마을 의무실로 후송되며 던전 진행 상태와 획득 재료의 결산 창이 노출된 후 5초 이내에 마을 광장에서 다시 이동할 수 있도록 불필요한 대기 화면을 배제한다.; riskPressure: 사망 시 던전에서 획득한 미확인 보석과 희귀 재료의 50%를 소실하지만 이미 완료한 퀘스트 진행 카운트는 유지하여 불쾌감을 완화한다.; recoveryRules: 마을 의무실에서 즉시 무료로 체력을 100% 완충해 주며, 주점에서 하급 모험가 버프 물약을 제공하여 직후 재도전 시 1회에 한해 공격력 10% 보너스를 부여한다.","uiMenuAndOnboarding":"hudPriorities: 1순위 플레이어/보스 체력 바, 2순위 회피 쿨다운 인디케이터, 3순위 배낭 잔여 용량 순으로 배치하여 시선 이동을 최소화한다.; touchAndInput: 모바일 터치 미스 방지를 위해 모든 인터랙션 버튼의 히트박스를 최소 48x48dp 이상으로 확보하고 조작 감도 조절 옵션을 제공한다.; readability: 색약 모드를 기본 지원하여 위험 장판의 붉은색을 고대비 노란색/청색 계통으로 즉시 치환할 수 있도록 설정한다.; accessibility: 화면 진동 햅틱 피드백의 강도를 3단계로 조절 가능하게 하고 텍스트 폰트 크기 확대 옵션을 UI 전반에 적용한다.","inputCameraAccessibility":"모바일 세로형 원서클 가상 조이스틱과 단일 다기능 탭/스와이프 액션 버튼을 채택하여 한 손 엄지손가락만으로 이동, 공격, 완벽 회피를 전부 구사할 수 있게 설계한다.","presentationAndAudio":"visualIdentity: 아기자기하지만 결코 가볍지 않은 정통 판타지 분위기의 스타일라이즈드 3D 아트를 지향하며 마을의 따뜻한 호박색 조명과 던전의 서늘한 청록색 톤을 극명하게 대비시킨다.; audioIdentity: 마을에서는 어쿠스틱 기타와 플루트 위주의 평화로운 BGM을 재생하고 던전에 들어서면 타악기와 오케스트라 현악기 중심의 긴박한 템포로 자연스럽게 크로스페이드한다.; gameplayFeedbackSync: 정밀 회피 성공 시 경쾌한 슬로모션 효과음과 쨍한 금속음을 출력하고, 콤보 타격 시 묵직한 타격 타점 사운드를 0.05초 단위로 정확히 동기화한다.","multiplayerPersistence":"SINGLE; 론칭 시점에는 완결성 높은 싱글 플레이어 액션과 마을 건설 루프에 집중하고, 유저 층이 안정화된 이후 비동기 던전 공략 기록 경쟁인 타임어택 랭킹 고스트 시스템을 우선 확장 도입한다.","expansionSpace":"milestone: 1단계: 5대 던전 기초 탐험 구역 및 마을 3대 기본 시설 오픈; newGameplay: 단일 무기 액션과 기본 회피, 슬라임 및 고블린 계열 몬스터와의 전투 패턴 학습 및 배낭 수납 규칙을 체험한다.; systemImpact: 대장간 무기 강화 시스템과 주점 퀘스트 리프레시 시스템의 기본 데이터베이스가 활성화된다. / milestone: 2단계: 심층 보스 레이드 및 던전 속성 저항 장비 크래프팅 추가; newGameplay: 용암 지대와 얼음 계곡 던전이 열리며 장판 회피 기믹과 속성 스왑 공격 메커니즘이 새롭게 요구된다.; systemImpact: 연금술소 시설이 확장되어 속성 물약 제조와 무기 인챈트 슬롯 시스템이 메인 전투 루프에 편입된다. / milestone: 3단계: 무한의 미궁 시련 모드 및 고대 유물 연구소 콘텐츠 개방; newGameplay: 층마다 무작위 페널티와 버프가 부여되는 엔드게임 로그라이트형 연속 던전 돌파 콘텐츠가 도입된다.; systemImpact: 마을 중앙 고대 제단 시스템이 작동하여 캐릭터의 특성 포인트를 자유롭게 재분배할 수 있게 된다."},"platformExpansionPolicy":{"mode":"SINGLE_ORIGINAL_PLATFORM_IMPLEMENTATION","sharedLargeFrame":["CORE_IDENTITY","CORE_FUN_AND_REPRESENTATIVE_LOOP","WORLD_AND_PROGRESSION_DIRECTION","SAVE_PERSISTENCE_MEANING","MULTIPLAYER_INTENT"],"expansionLimit":"GAMEPLAY_CHANGES_REQUIRE_SHARED_ORIGINAL_REVISION","webRule":"게임당 하나의 공통 설계 원본을 사용한다. WEB은 같은 MAIN/A/B/c/@·규칙·상태·진행·멀티를 입력·화면·성능·저장 전송에 맞게 구현한다. 별도 원본을 생성하지 않으며 Unity WebGL은 같은 Unity 프로젝트를 사용한다.","unityRule":"동일 공통 원본과 디자이너가 작성한 규칙을 Unity에서 구현한다. 입력·물리 표현·카메라·UI·성능·저장 전송·런타임 검증만 플랫폼에 맞게 적용한다. 게임 규칙 확장은 공통 원본 개정으로 돌아간다.","robloxRule":"기존 Roblox 원본의 규칙과 사용자 요청을 공통 원본에 보존한다. platformProfiles.ROBLOX와 robloxBuildProfile은 같은 원본의 구현·배포·검증 방식이며 독립 게임 설계가 아니다. 다른 플랫폼 실패는 해당 플랫폼의 수정·재시도로 분리한다."},"visualDirection":"가독성이 뛰어난 로우폴리 카툰 렌더링 스타일을 채택하여 화려한 배경 속에서도 플레이어와 몬스터의 실루엣이 명확히 구별되도록 굵은 외곽선과 채도 대비를 준다. 적의 피격 및 장판 공격 궤적은 형광 주황색과 자홍색 데칼로 선명하게 바닥에 표시하여 한눈에 위협 범위를 인지할 수 있게 한다.","mobileUx":"모바일 화면 하단 30% 영역을 입력 안전 구역으로 설정하여 화면 어느 곳을 터치해도 가상 조이스틱이 즉시 생성되도록 지원한다. 중요한 던전 보스 체력바와 남은 시간, 배낭 용량은 화면 상단 중앙에 고대비 폰트로 고정 배치하여 엄지손가락 조작에 시야가 가려지지 않도록 설계한다.","uxAccessibilityPlan":{"hudPriorities":"1순위 플레이어/보스 체력 바, 2순위 회피 쿨다운 인디케이터, 3순위 배낭 잔여 용량 순으로 배치하여 시선 이동을 최소화한다.","touchAndInput":"모바일 터치 미스 방지를 위해 모든 인터랙션 버튼의 히트박스를 최소 48x48dp 이상으로 확보하고 조작 감도 조절 옵션을 제공한다.","readability":"색약 모드를 기본 지원하여 위험 장판의 붉은색을 고대비 노란색/청색 계통으로 즉시 치환할 수 있도록 설정한다.","accessibility":"화면 진동 햅틱 피드백의 강도를 3단계로 조절 가능하게 하고 텍스트 폰트 크기 확대 옵션을 UI 전반에 적용한다."},"artAudioDirection":{"visualIdentity":"아기자기하지만 결코 가볍지 않은 정통 판타지 분위기의 스타일라이즈드 3D 아트를 지향하며 마을의 따뜻한 호박색 조명과 던전의 서늘한 청록색 톤을 극명하게 대비시킨다.","audioIdentity":"마을에서는 어쿠스틱 기타와 플루트 위주의 평화로운 BGM을 재생하고 던전에 들어서면 타악기와 오케스트라 현악기 중심의 긴박한 템포로 자연스럽게 크로스페이드한다.","gameplayFeedbackSync":"정밀 회피 성공 시 경쾌한 슬로모션 효과음과 쨍한 금속음을 출력하고, 콤보 타격 시 묵직한 타격 타점 사운드를 0.05초 단위로 정확히 동기화한다."},"selectedDesignPlan":{},"contentVarietyPlan":{},"narrativeDialoguePlan":{},"implementationTraceability":[{"designElement":"한 손 전용 원서클 가상 조이스틱 및 직관적 원터치 회피 콤보 조작계","responsibleSystem":"모바일 전용 플레이어 캐릭터 통합 모션 컨트롤러 컴포넌트","validationEvidence":"화면 드래그 속도와 방향 벡터를 분석하여 0.15초 이내 급격한 드래그 시 회피 기동이 100% 정상 발동하는지 터치 입력 자동화 테스트 스크립트로 검증한다."},{"designElement":"던전 사망 시 획득 재료의 50%를 회수 및 보존 처리하는 리스크 정산 규칙","responsibleSystem":"던전 인스턴스 세션 종료 및 인벤토리 결산 보상 관리 매니저","validationEvidence":"플레이어 HP가 0이 되는 이벤트 발생 시 획득 아이템 배열의 홀수 인덱스 품목을 제거하고 마을 저장소로 안전하게 이전되는지 단위 테스트로 확인한다."},{"designElement":"마을 대장간 및 주점 시설 단계별 스탯 버프 부여 및 연동 시스템","responsibleSystem":"플레이어 데이터베이스 영구 스탯 계산기 및 마을 메타데이터 서비스","validationEvidence":"대장간 강화 레벨이 1에서 2로 갱신될 때 캐릭터 기본 공격력 필드가 즉각 실시간으로 반영되어 다음 던전 진입 씬에서 올바르게 적용되는지 데이터 로그를 추적 검증한다."}],"stabilityPriorityPlan":{}},"gameIdentityAndNonNegotiables":{"identity":"마을 던전 RPG는 위기 상황에 놓인 마을의 의뢰를 해결하기 위해 5개 던전의 자원과 위험 속으로 진입하여 직관적인 원서클 모바일 액션 전투를 수행하고 수집품을 마을 복구 시설에 환원하여 전투 빌드를 고유하게 완성해 나가는 루프 중심의 캐주얼 모바일 액션 롤플레잉 게임이다.","coreFun":"적의 공격 궤적을 직관적으로 회피하고 연타 공격을 적중시키는 순간의 즉각적인 손맛과 제한된 던전 인벤토리에 어떤 전리품을 챙길지 결정하여 마을 시설의 기술 트리로 환원할 때 일어나는 명확한 전투 스펙 향상의 쾌감이다.","coreLoop":["마을 의뢰 게시판에서 자원 채취 및 특정 던전 몬스터 토벌 퀘스트를 수락하고 장비를 점검한다.","5개로 분기된 던전 중 하나를 선택 진입하여 한 손 조작 기반의 실시간 회피 및 평타/스킬 연계로 몬스터를 격퇴한다.","한정된 던전 배낭 슬롯에 귀환용 고가치 자원과 장비 강화 재료를 취사선택하여 보관한다.","포털을 통해 안전하게 마을로 귀환하여 의뢰를 완료하고 수집 자원으로 대장간과 주점을 업그레이드한다.","확장된 시설 버프와 신규 제작 무기를 바탕으로 더 깊은 던전 층계 및 보스전에 도전한다."],"signatureSystems":[{"name":"마을 재건 시설 연동 시스템","purpose":"던전에서 획득한 고유 건축 목재와 광석을 마을 대장간·주점·연금 공방에 투자하여 영구적인 스탯 버프와 신규 스킬 트리를 해금한다.","playerChoice":"즉시 전투력을 높이는 무기 제련 시설을 우선 복구할 것인지, 소비 물약 효율과 던전 내 추가 부활 기회를 부여하는 연금소를 먼저 지을지 선택한다."},{"name":"리스크 배낭 정밀 적재 시스템","purpose":"던전 내 인벤토리 슬롯을 극도로 제한하여 플레이어가 매 전투 승리 시마다 리스크와 리턴을 저울질하도록 유도한다.","playerChoice":"안전한 마을 귀환 주문서를 유지하기 위해 회복 물약을 버릴 것인지, 희귀 보스 드롭 재료를 위해 체력 회복 수단을 포기할 것인지 결정한다."}],"progressionDirection":"초반 세션에서는 단순 타격과 짧은 3분 던전 탐색으로 기초 장비를 맞추게 하며, 중반에는 5대 던전의 상성 속성(화염, 냉기, 독, 암흑, 번개)에 맞춘 장비 세트 파밍과 마을 상위 시설 건설로 전략적 깊이를 확장하고, 종반에는 심층 보스 타임어택과 극한의 장비 옵션 튜닝을 통해 지속적인 육성 만족도를 제공한다.","multiplayerMode":"SINGLE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=4","PLACEHOLDER_OR_PRIMITIVE_USAGE_HIGH","UI_MENU_FLOW_SPARSE"],"signals":{"combat":185,"progression":246,"ai":27,"save":76,"multiplayer":31,"animation":29,"motionStates":222,"gameFeel":33,"vfx":31,"camera":33,"audio":4,"audioDynamics":16,"ui":62,"uiFlow":47,"entryFlow":6,"loadingFlow":0,"input":60,"map":339,"landmark":9,"interaction":41,"inventory":65,"equipment":17,"settings":2,"feedback":74,"session":147,"content":304,"choice":32,"connection":2,"performance":23,"lighting":39,"primitive":19,"todo":0,"errorRecovery":22},"topFiles":[{"file":"roblox-games/village-dungeons/server/Game.server.luau","score":738},{"file":"roblox-games/village-dungeons/shared/GameConfig.luau","score":300},{"file":"roblox-games/village-dungeons/client/Game.client.luau","score":183},{"file":"roblox-games/village-dungeons/default.project.json","score":2}],"sourceAnchors":[{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":317,"kind":"FUNCTION","symbol":"addItemToInventory","context":"local function addItemToInventory(player, itemId, amount)","score":130},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":565,"kind":"FUNCTION","symbol":"spawnBoss","context":"local function spawnBoss(player)","score":122},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":719,"kind":"FUNCTION","symbol":"reviewDungeonState","context":"local function reviewDungeonState(player)","score":122},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":461,"kind":"FUNCTION","symbol":"damageMonster","context":"local function damageMonster(player, enemy, amount)","score":114},{"file":"roblox-games/village-dungeons/client/Game.client.luau","line":464,"kind":"FUNCTION","symbol":"render","context":"local function render()","score":106},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":332,"kind":"FUNCTION","symbol":"removeInventoryItem","context":"local function removeInventoryItem(player, itemId, amount)","score":106},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":371,"kind":"FUNCTION","symbol":"equipWeapon","context":"local function equipWeapon(player, weaponId, power)","score":106},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":392,"kind":"FUNCTION","symbol":"consumeFacilityMaterial","context":"local function consumeFacilityMaterial(player)","score":106},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":425,"kind":"FUNCTION","symbol":"completeQuest","context":"local function completeQuest(player)","score":106},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":434,"kind":"FUNCTION","symbol":"currentEnemy","context":"local function currentEnemy(player)","score":106},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":678,"kind":"FUNCTION","symbol":"manageDungeonBag","context":"local function manageDungeonBag(player)","score":106},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":377,"kind":"FUNCTION","symbol":"craftWeapon","context":"local function craftWeapon(player)","score":98},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":671,"kind":"FUNCTION","symbol":"enterSelectedDungeon","context":"local function enterSelectedDungeon(player)","score":98},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":278,"kind":"FUNCTION","symbol":"getSession","context":"local function getSession(player)","score":90},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":347,"kind":"FUNCTION","symbol":"preserveHalfDungeonInventory","context":"local function preserveHalfDungeonInventory(player)","score":90},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":416,"kind":"FUNCTION","symbol":"startQuest","context":"local function startQuest(player)","score":90},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":493,"kind":"FUNCTION","symbol":"runEnemyAI","context":"local function runEnemyAI(player, enemy)","score":90},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":665,"kind":"FUNCTION","symbol":"acceptVillageQuest","context":"local function acceptVillageQuest(player)","score":90},{"file":"roblox-games/village-dungeons/client/Game.client.luau","line":493,"kind":"FUNCTION","symbol":"reportNativeFoundationReady","context":"local function reportNativeFoundationReady()","score":82},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":303,"kind":"FUNCTION","symbol":"updateBagSummary","context":"local function updateBagSummary(player)","score":82},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":525,"kind":"FUNCTION","symbol":"spawnMonster","context":"local function spawnMonster(player, monsterKind, index)","score":82},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":588,"kind":"FUNCTION","symbol":"attackMonster","context":"local function attackMonster(player)","score":82},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":656,"kind":"FUNCTION","symbol":"performCombatAction","context":"local function performCombatAction(player)","score":82},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":705,"kind":"FUNCTION","symbol":"challengeDeeperDungeon","context":"local function challengeDeeperDungeon(player)","score":82},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":738,"kind":"FUNCTION","symbol":"loadPlayer","context":"local function loadPlayer(player)","score":82},{"file":"roblox-games/village-dungeons/server/Game.server.luau","line":52,"kind":"FUNCTION","symbol":"initializeTransientState","context":"local function initializeTransientState(player)","score":74},{"file":"roblox-games/village-dungeons/client/Game.client.luau","line":210,"kind":"FUNCTION","symbol":"playVerifiedLearningActionFeedback","context":"local function playVerifiedLearningActionFeedback(control)","score":66},{"file":"roblox-games/village-dungeons/client/Game.client.luau","line":287,"kind":"FUNCTION","symbol":"bindVerifiedLearningControl","context":"local function bindVerifiedLearningControl(control)","score":50},{"file":"roblox-games/village-dungeons/client/Game.client.luau","line":140,"kind":"FUNCTION","symbol":"syncVerifiedLearningCharacterMotion","context":"local function syncVerifiedLearningCharacterMotion(character)","score":42},{"file":"roblox-games/village-dungeons/client/Game.client.luau","line":352,"kind":"FUNCTION","symbol":"applyCreaturePresentation","context":"local function applyCreaturePresentation(instance)","score":42},{"file":"roblox-games/village-dungeons/client/Game.client.luau","line":27,"kind":"FUNCTION","symbol":"hasStudioAssetAtom","context":"local function hasStudioAssetAtom(familyOrAtom, atom)","score":34},{"file":"roblox-games/village-dungeons/client/Game.client.luau","line":23,"kind":"FUNCTION","symbol":"studioAssetFamily","context":"local function studioAssetFamily(family)","score":26}]},"previousVersionDelta":{"previousGoal":"마을 던전 RPG는 위기 상황에 놓인 마을의 의뢰를 해결하기 위해 5개 던전의 자원과 위험 속으로 진입하여 직관적인 원서클 모바일 액션 전투를 수행하고 수집품을 마을 복구 시설에 환원하여 전투 빌드를 고유하게 완성해 나가는 루프 중심의 캐주얼 모바일 액션 롤플레잉 게임이다.의 현재 실패 근거를 원인 시스템에서 제거하고 핵심 루프·저장·복구가 같은 상태에서 반복 가능하게 만든다.","