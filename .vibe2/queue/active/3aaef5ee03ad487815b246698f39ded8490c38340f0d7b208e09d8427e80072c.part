llaboration","vibePrimaryIntegrationAndLearning":true,"approvedExternalAiMayImplementOnIsolatedCandidateBranch":true,"existingAuthorizedAiRoles":["PLANNING","DESIGN","IMPLEMENTATION","REPAIR","QA","ASSETS","PLATFORM_ADAPTATION"],"sameResponsibleFileConflictSerialized":true,"disjointResponsibleFilesMayRunParallel":true,"externalAiUseRequiresExistingOptInAndAuthorization":true,"deterministicallyVerifiedOutcomesFeedExistingLearningMotor":true,"externalAiCannotWriteMainOrCentralPolicyOrApproveOwnWork":true},"noDuplicateSubsystemsOrNewPipeline":true,"noUnverifiedCapabilityClaims":true,"preserveApprovedGameplaySaveEconomyAndServerAuthority":true,"qaReleaseSecurityGatesUnchanged":true,"rule":"AI_COLLABORATION_VIBE_PRIMARY_INTEGRATION_AND_LEARNING; MAXIMIZE_RELEVANT_VERIFIED_INTERNAL_ALGORITHMS_AND_SAME_GAME_SAME_FAILURE_PATTERNS; AUTHORIZED_EXTERNAL_AI_MAY_DEVELOP_AND_REPAIR_ON_ISOLATED_CANDIDATE_BRANCHES_WITH_RESPONSIBLE_FILE_SCOPE_WHEN_ENABLED; PARALLEL_DISJOINT_FILES_SERIALIZE_CONFLICTS; DETERMINISTIC_QA_SECURITY_AND_CANONICAL_RELEASE_REQUIRED; FEED_VERIFIED_RESULTS_TO_EXISTING_LEARNING_MOTOR; NEVER_CREATE_SHADOW_PIPELINE_OR_FABRICATE_PASS"},"preserveConstraints":["게임 제작은 Vibe와 승인된 AI 협업으로 진행한다. 검증된 내부 분석·게임 로직·전략선택·재조합·에셋 재사용 알고리즘을 과제 관련 범위에서 최대 활용한다. 외부 AI는 기존 승인·활성화 조건 아래 격리 후보 브랜치의 독립 책임 파일에 직접 구현·수리 가능하며 Vibe가 통합·학습한다. 중앙정책·QA·보안·배포 게이트를 유지하고 중복 파이프라인·미검증 주장은 금지한다.","기존 세이브 키와 의미를 명시적 마이그레이션 없이 변경하지 않는다.","승인 없는 밸런스/경제/보상/드랍/쿨다운/히트 의미 변경 금지.","멀티플레이 권한과 authoritative state를 프레젠테이션 이유로 클라이언트로 이동하지 않는다.","wrapper/shadow/temporary override 대신 기존 책임 시스템을 직접 수정한다."],"responsibleSystemsAndFiles":{"files":["web-games/wild-survival/index.html","web-games/wild-survival/wild3d.mjs"],"sourceAnchors":[{"file":"web-games/wild-survival/index.html","line":233,"kind":"FUNCTION","symbol":"eat","context":"function eat(){","score":114,"currentBehavior":"function eat(){","intendedBehavior":"CORE_FUN primary goal \"예술·남아시아사 스포츠×모험: 중계기: 중계 지점 사이 연결이 확보됨의 성립. MAIN은 A(플레이 선택과 공간 점유 × 예술)