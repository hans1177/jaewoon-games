enchmarkDimensions":["INPUT_AND_PRIMARY_ACTION","HUD_AND_MENU_FLOW","CAMERA_AND_FEEDBACK","COMBAT_OR_CORE_LOOP","WORLD_AND_LEVEL_PROGRESSION","EQUIPMENT_REWARDS_AND_GROWTH","ONBOARDING_AND_FIRST_SESSION","FAILURE_RETRY_SAVE_RECOVERY","MID_LATE_DEPTH"],"loop":["REVIEW_GAME_AND_NAMED_REFERENCE_EVIDENCE","REVISE_MAIN_A_B_C_D_AT_DESIGN","STRICT_DESIGN_REVIEW","BIND_RULE_IDS_TO_EXISTING_RESPONSIBLE_SOURCE","BUILD_SOURCE","EXACT_BUILD_RUNTIME_QA","NEXT_DESIGN_REVISION_FROM_VERIFIED_GAPS"],"provenanceRule":"NAMED_SOURCE_OBSERVED_MECHANICS_OR_UNVERIFIED; NEVER_COPY_DISTINCTIVE_UI_ART_CHAR_TEXT_CODE","confirmedRuntimePass":false,"preserves":["OWNER_GAME_IDENTITY","CORE_RULES","BALANCE","ECONOMY","SAVE_KEYS_AND_MEANING","NETWORK_AUTHORITY"]},"identityReinforcement":{"appliesToAllGenres":true,"genre":"GAME_SPECIFIC","oneLineFantasy":"마력숲 생존기의 플레이어는 전투와 획득 장비의 조합 운용: 적 특성과 획득한 장비를 비교해 전투 방식과 다음 탐험 준비를 선택한다하면서 선택의 책임: 정해진 역할을 따르거나 다른 행동을 택한다. 자신이 선택한 이유와 결과를 인정함일 때 인물의 관계와 이후 목표가 달라진다을 결정하고 두 소재가 만드는 반작용을 책임진다.","representativeAction":"전투와 획득 장비의 조합 운용: 적 특성과 획득한 장비를 비교해 전투 방식과 다음 탐험 준비를 선택한다하면서 선택의 책임: 정해진 역할을 따르거나 다른 행동을 택한다. 자신이 선택한 이유와 결과를 인정함일 때 인물의 관계와 이후 목표가 달라진다","representativeChoice":"전투와 획득 장비의 조합 운용: 적 특성과 획득한 장비를 비교해 전투 방식과 다음 탐험 준비를 선택한다하면서 선택의 책임: 정해진 역할을 따르거나 다른 행동을 택한다. 자신이 선택한 이유와 결과를 인정함일 때 인물의 관계와 이후 목표가 달라진다 이후 다음 행동의 위험과 보상을 직접 선택한다.","signatureWorldRule":"마력숲 생존기의 결과가 다음 월드·목표·위험·보상 상태를 바꾼다.","signatureSystems":["마력숲 생존기","전투와 획득 장비의 조합 운용 × 철학·사상","제작과 방어 거점 관리 × 공성전","암호문: 독립된 단서가 같은 의미를 지지함의 성립"],"growthIdentity":"세션 성장: 현재 플레이에서 자원·위치·장비·전술 선택이 즉시 다음 행동 가능성을 바꾼다 중기 성장: 해금·지역·시스템 연결 또는 빌드 선택이 새로운 전략 경로를 연다 장기 성장: 숙련·월드 상태·수집·관계·메타 목표 중 장르에 맞는 축이 다음 세션의 선택 폭을 넓힌다","threeSentenceTest":{"whatGame":"마력숲 생존기. 철학·사상·공성전 역할수행. 마력숲 생존기에서 전투와 획득 장비의 조합 운용 × 철학·사상과 제작과 방어 거점 관리 × 공성전이 서로 결과를 되돌려 바꾸며 스릴러·공상과학의 판단이 실제 세계 상태를 변화시킨다.","whatDifferent":"마력숲 생존기에서 생존자가 전투와 획득 장비의 조합 운용와 제작과 방어 거점 관리의 선택을 통해 철학·사상·공성전의 인과법칙을 바꾸는 역할수행 복합 게임에서 플레이어는 선택을 누적해 목적을 완수한다. 게임의 반복 목표와 세계의 접근 가능성을 상태로 관리한다.","whatGrowthUnlocks":"세션 성장: 현재 플레이에서 자원·위치·장비·전술 선택이 즉시 다음 행동 가능성을 바꾼다 중기 성장: 해금·지역·시스템 연결 또는 빌드 선택이 새로운 전략 경로를 연다 장기 성장: 숙련·월드 상태·수집·관계·메타 목표 중 장르에 맞는 축이 다음 세션의 선택 폭을 넓힌다"},"causalGrammarEvidence":{"worldRules":[],"causalInspirations":[],"systemInterconnections":[],"expansionPlan":[],"integrityNotes":[],"formula":"MAIN = A + B + C + D + @","existingGameGrammarMap":{"mode":"EXISTING_GAME_RECONSTRUCTION_FROM_CURRENT_DESIGN_AND_INSPECTED_SOURCE","formula":"MAIN = A + B + C + D + @","main":"마력숲 생존기: 마력숲 생존기. 전투와 획득 장비의 조합 운용: 적 특성과 획득한 장비를 비교해 전투 방식과 다음 탐험 준비를 선택한다하면서 선택의 책임: 정해진 역할을 따르거나 다른 행동을 택한다. 자신이 선택한 이유와 결과를 인정함일 때 인물의 관계와 이후 목표가 달라진다과 전투와 획득 장비의 조합 운용의 결과를 제작과 방어 거점 관리로 전환하고 달라진 조건을 다시 활용한다.를 반복하는 게임이다.","source":"DESIGNER_AUTHORED_ROLE_IDS_AND_STATE_LINKS","roleSystemIds":{"MAIN":"VIBE_MAIN","A":"VIBE_A","B":"VIBE_B","c":[],"AT":["VIBE_DELVE"]},"majorAxes":[{"key":"A","systemId":"VIBE_A","name":"전투와 획득 장비의 조합 운용 × 철학·사상","source":"DESIGNER_AUTHORED_ROLE_A"},{"key":"B","systemId":"VIBE_B","name":"제작과 방어 거점 관리 × 공성전","source":"DESIGNER_AUTHORED_ROLE_B"}],"cSubElements":[],"sourcedAxes":{"A":{"system":"전투와 획득 장비의 조합 운용","material":"철학·사상","materialDomain":"철학·사상","stateChange":"선택의 책임: 정해진 역할을 따르거나 다른 행동을 택한다. 자신이 선택한 이유와 결과를 인정함일 때 인물의 관계와 이후 목표가 달라진다 따라서 전투와 획득 장비의 조합 운용의 경로와 비용이 바뀐다. 플레이어가 전투와 획득 장비의 조합 운용을 선택하면 철학·사상의 규칙에 따라 다음 위험과 가능 행동이 변화한다. 그 결과 제작과 방어 거점 관리 × 공성전의 다음 행동 조건이 달라진다.","gameGenre":"역할수행","gameRole":"PRIMARY","referenceGame":{"gameGenre":"역할수행","name":"디아블로","systemFamily":"전투와 획득 장비의 조합 운용","playerChoice":"적 특성과 획득한 장비를 비교해 전투 방식과 다음 탐험 준비를 선택한다","source":"중앙 기본설계 참고게임 예시"}},"B":{"system":"제작과 방어 거점 관리","material":"공성전","materialDomain":"전쟁·군사→공성전","stateChange":"공성탑: 탑을 이동시키거나 성문을 우회한다. 이동로가 확보되고 방어 위치를 확인함일 때 성벽의 공격과 진입 방향이 바뀐다 따라서 제작과 방어 거점 관리의 정보·대응이 바뀐다. 플레이어가 제작과 방어 거점 관리을 선택하면 공성전의 규칙에 따라 처음 선택으로 되돌아갈 비용·정보·접근 조건이 변화한다. 그 결과 전투와 획득 장비의 조합 운용 × 철학·사상의 선택 비용과 경로가 달라진다.","existingSystemReference":{"scope":"B_NEW_GAME_INITIAL_SYSTEMS","systemFamily":"제작과 방어 거점 관리","playerChoice":"남은 자원으로 장비와 거점을 보강해 다음 탐색 위험을 낮출 방법을 선택","source":"신규 기본설계:fantasy-survival"},"gameGenreRepresentative":"시뮬레이션","gameGenre":"생활","gameRole":"SUPPORTING","materialPath":["전쟁·군사","공성전"],"supportingReason":"제작과 방어 거점 관리는 전투와 획득 장비의 조합 운용의 결과를 읽는 보조 판단이다. 결과가 중심 전투와 획득 장비의 조합 운용의 다음 경로와 위험으로 돌아온다."}},"cGenreThemes":[],"dCreations":[{"id":"D_1","materialPath":["전쟁·군사","정보전","암호문"],"pathReason":"전쟁·군사→정보전→암호문의 실제 분류 연결을 사용한다. 소재 특징은 정보의 은폐와 해석이며 행동·조건·결과는 게임용 창작 해석이다.","sourceFeature":"정보의 은폐와 해석","action":"전달 경로와 해독 단서를 비교한다","condition":"독립된 단서가 같은 의미를 지지함","consequence":"다음 대응과 기만 경로를 선택한다","risk":"잘못 해독하면 상대의 유인에 걸린다","genreRoles":["PRIMARY","SECONDARY"],"linkedElements":["A","B"],"creation":"철학·사상의 첫 선택 공간의 암호문는 정보의 은폐와 해석를 세계의 지속 규칙으로 만든 창작이다. 플레이어가 전달 경로와 해독 단서를 비교한다 행동을 고른다. 스릴러: 스릴러: 암호문의 정보의 은폐와 해석를 작품의 경험·정보·갈등·선택에 연결한다. 독립된 단서가 같은 의미를 지지함 조건에서 전달 경로와 해독 단서를 비교한다 행동을 판정하며 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다. 공상과학: 공상과학: 가면 의식의 역할과 일시적 전환를 작품의 경험·정보·갈등·선택에 연결한다. 의식의 역할과 행동 조건이 맞음 조건에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정하며 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다.","gameplayEffect":"A의 전투와 획득 장비의 조합 운용에서 독립된 단서가 같은 의미를 지지함 조건을 확인한 뒤 B의 제작과 방어 거점 관리에서 전달 경로와 해독 단서를 비교한다 행동을 판정한다. 성공하면 다음 대응과 기만 경로를 선택한다 결과가 A의 다음 선택에 돌아온다. 위험: 잘못 해독하면 상대의 유인에 걸린다. 실패·취소 때 기존 상태와 다른 선택을 보존한다."},{"id":"D_2","materialPath":["사회·문화","축제 문화","가면 의식"],"pathReason":"사회·문화→축제 문화→가면 의식의 실제 분류 연결을 사용한다. 소재 특징은 역할과 일시적 전환이며 행동·조건·결과는 게임용 창작 해석이다.","sourceFeature":"역할과 일시적 전환","action":"가면의 역할을 맡거나 본래 신분을 드러낸다","condition":"의식의 역할과 행동 조건이 맞음","consequence":"평소 닫힌 교류와 부탁이 열린다","risk":"역할과 실제 책임을 혼동하면 갈등이 생긴다","genreRoles":["PRIMARY","SECONDARY"],"linkedElements":["A","B"],"creation":"공성전의 되돌림 공간의 가면 의식는 역할과 일시적 전환를 세계의 지속 규칙으로 만든 창작이다. 플레이어가 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 고른다. 스릴러: 스릴러: 암호문의 정보의 은폐와 해석를 작품의 경험·정보·갈등·선택에 연결한다. 독립된 단서가 같은 의미를 지지함 조건에서 전달 경로와 해독 단서를 비교한다 행동을 판정하며 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다. 공상과학: 공상과학: 가면 의식의 역할과 일시적 전환를 작품의 경험·정보·갈등·선택에 연결한다. 의식의 역할과 행동 조건이 맞음 조건에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정하며 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다.","gameplayEffect":"A의 전투와 획득 장비의 조합 운용에서 의식의 역할과 행동 조건이 맞음 조건을 확인한 뒤 B의 제작과 방어 거점 관리에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정한다. 성공하면 평소 닫힌 교류와 부탁이 열린다 결과가 A의 다음 선택에 돌아온다. 위험: 역할과 실제 책임을 혼동하면 갈등이 생긴다. 실패·취소 때 기존 상태와 다른 선택을 보존한다."}],"cPrimarySecondaryGenres":[{"role":"PRIMARY","name":"스릴러","gameplayEffect":"스릴러: 암호문의 정보의 은폐와 해석를 작품의 경험·정보·갈등·선택에 연결한다. 독립된 단서가 같은 의미를 지지함 조건에서 전달 경로와 해독 단서를 비교한다 행동을 판정하며 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다."},{"role":"SECONDARY","name":"공상과학","gameplayEffect":"공상과학: 가면 의식의 역할과 일시적 전환를 작품의 경험·정보·갈등·선택에 연결한다. 의식의 역할과 행동 조건이 맞음 조건에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정하며 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다."}],"cGenreInterlock":"스릴러: 스릴러: 암호문의 정보의 은폐와 해석를 작품의 경험·정보·갈등·선택에 연결한다. 독립된 단서가 같은 의미를 지지함 조건에서 전달 경로와 해독 단서를 비교한다 행동을 판정하며 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다. 공상과학: 공상과학: 가면 의식의 역할과 일시적 전환를 작품의 경험·정보·갈등·선택에 연결한다. 의식의 역할과 행동 조건이 맞음 조건에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정하며 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다. 보조 장르가 없으면 같은 대상의 관찰·책임·행동 판단이 사라져 A의 다음 선택이 달라진다.","cCausalWorldEffect":"철학·사상에 의해 바뀐 인물·지역의 상태는 공성전의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 암호문와 가면 의식가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 적 특성과 획득한 장비를 비교해 전투 방식과 다음 탐험 준비를 선택한다하면서 선택의 책임: 정해진 역할을 따르거나 다른 행동을 택한다. 자신이 선택한 이유와 결과를 인정함일 때 인물의 관계와 이후 목표가 달라진다 그 결과 제작과 방어 거점 관리의 가능 행동과 위험이 바뀌며, 남은 자원으로 장비와 거점을 보강해 다음 탐색 위험을 낮출 방법을 선택하면서 공성탑: 탑을 이동시키거나 성문을 우회한다. 이동로가 확보되고 방어 위치를 확인함일 때 성벽의 공격과 진입 방향이 바뀐다 다시 전투와 획득 장비의 조합 운용의 조건을 바꾼다.","atUnboundedGrowthRule":"@의 주된 목적은 C·D에 연관된 콘텐츠를 깊이 파고들어 연구하고, 그 연구를 바탕으로 새로운 콘텐츠를 창작·개발하는 것이다. 초기 서로 다른 사례 최소 4개는 출발점이며 총개수 상한은 없다. 이름·번호·수치만 바꾼 반복은 새 사례가 아니다. @는 C의 작품 주·보조 장르와 D의 창작 세계·존재·장소·사건·문화·규칙에서 나온 연관 콘텐츠를 A의 참고 시스템과 B의 기존 시스템에 복합적으로 연결해 새로 창작한다. 각 사례에 D 출처, 관찰한 차이, 실제 입력과 조건, 성공·실패·취소·복구, 달라지는 행동과 결과를 작성한다.","standardGrammarVersion":2,"delveAtEvidence":["암호문의 성립 조건을 바꿔 비교 실험으로 독립된 단서가 같은 의미를 지지함 조건과 다음 대응과 기만 경로를 선택한다 결과의 연결을 발견한다.","가면 의식의 성립 조건을 바꿔 비교 실험으로 의식의 역할과 행동 조건이 맞음 조건과 평소 닫힌 교류와 부탁이 열린다 결과의 연결을 발견한다.","암호문의 위험을 감수한 대안과 비교 실험으로 독립된 단서가 같은 의미를 지지함 조건과 다음 대응과 기만 경로를 선택한다 결과의 연결을 발견한다.","가면 의식의 위험을 감수한 대안과 비교 실험으로 의식의 역할과 행동 조건이 맞음 조건과 평소 닫힌 교류와 부탁이 열린다 결과의 연결을 발견한다.","암호문: 독립된 단서가 같은 의미를 지지함의 성립"],"sourceTreeFingerprint":"bffc67c5835da0267e41809559f1023a940d86e9ffe6a95614602491c1603b04","rule":"MAIN_A_NAMED_GAME_SYSTEM_B_EXISTING_GAME_SYSTEMS; C_IS_PRIMARY_SECONDARY_STORY_GENRES; D_IS_SPECIFIC_CREATIONS; AT_RESEARCH_LINKS_TO_D; ROBLOX_LUAU_CANONICAL","identityRewriteRequired":false,"existingBalanceSaveEconomyAndAuthorityPreserved":true},"rule":"NEW_CONTENT_MUST_CONNECT_A_PRIMARY_B_SUPPORTING_C_STORY_GENRES_D_CREATIONS_AND_AT_D_RESEARCH_TO_EXACT_GAME_STATE; LUAU_OWNER_REQUIRED; DESIGN_IS_NOT_RUNTIME_PASS","familiarHumanConflictShouldRemainReadable":true},"buildUpRule":"EACH_BUILD_UP_MUST_STRENGTHEN_OR_PRESERVE_THE_REPRESENTATIVE_ACTION_CHOICE_WORLD_RULE_SIGNATURE_SYSTEM_OR_GROWTH_IDENTITY; GENERIC_FEATURE_COUNT_DOES_NOT_COUNT","genreAdaptationRule":"PRESERVE_THE_GENRE_PRIMARY_ACTION; DO_NOT_FORCE_RPG_STYLE_SYSTEMS_ON_PUZZLE_RACING_TYCOON_DEFENSE_SURVIVAL_ACTION_CARD_BOARD_STRATEGY_CASUAL_OR_OTHER_GENRES"},"designToPlatformCodingTrace":{"version":1,"authority":"GAME_DESIGN_TO_EXISTING_PLATFORM_BUILD_UP_LINK","gameId":"fantasy-survival","requestedPlatform":"WEB","activePlatform":"NOT_SELECTED_NATIVE_PLATFORM","originalSourcePlatform":"ROBLOX","originalSourceLanguage":"LUAU","unityWebSourceSync":null,"designFingerprint":"62953d8cd5706df4f1fbb8a78e70fd120d17174a120d7ebb314dab9c7c520118","sourceTreeFingerprint":"bffc67c5835da0267e41809559f1023a940d86e9ffe6a95614602491c1603b04","multiplayerMode":"HYBRID","multiplayerRequired":false,"minimumParticipants":1,"platformCodingPlans":[{"platform":"ROBLOX","canonicalGameSourceRoot":"roblox-games/fantasy-survival","sharedUnitySource":false,"gameCodePlatformProfile":"ROBLOX","requiresSameServerTwoClientPlay":false,"requiresNativeRuntimeResult":true,"minimumRenderedDimension":"3D","inspectedInThisDirective":false},{"platform":"UNITY_WEB","canonicalGameSourceRoot":"unity-games/fantasy-survival","sharedUnitySource":true,"gameCodePlatformProfile":"UNITY","requiresSameServerTwoClientPlay":false,"requiresNativeRuntimeResult":true,"minimumRenderedDimension":"3D","spatialDesignReady":false,"inspectedInThisDirective":false},{"platform":"UNITY_APP","canonicalGameSourceRoot":"unity-games/fantasy-survival","sharedUnitySource":true,"gameCodePlatformProfile":"UNITY","requiresSameServerTwoClientPlay":false,"requiresNativeRuntimeResult":true,"minimumRenderedDimension":"3D","inspectedInThisDirective":false}],"roleBindings":[{"role":"MAIN","grammarRole":"MAIN","systemId":"VIBE_MAIN","systemIds":["VIBE_MAIN"],"names":["마력숲 생존기"],"name":"마력숲 생존기","stateInputs":["WorldAccessState","IntentState"],"stateOutputs":["RouteState","WorldAccessState"],"connections":[],"nativeStateMapping":{"state":"EXECUTABLE_SOURCE_REQUIRED","matchedInputKeys":[],"matchedWrittenOutputKeys":[],"missingInputKeys":["WorldAccessState","IntentState"],"missingWrittenOutputKeys":["RouteState","WorldAccessState"],"inspectedExecutableFiles":[],"exactRuntimeStateTransitionVerified":false,"rule":"IDENTIFIER_REFERENCE_AND_ASSIGNMENT_ARE_DIAGNOSTIC_CANDIDATES_NOT_GAMEPLAY_PARITY_PASS"},"suggestedExistingOwnerFiles":[],"inspectedSymbols":[],"designStatus":"AUTHORED","codingStatus":"PLATFORM_NOT_SELECTED","executableBehaviorVerified":false,"actualRuntimeVerified":false,"evidenceNeeded":"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA"},{"role":"A","grammarRole":"A","systemId":"VIBE_A","systemIds":["VIBE_A"],"names":["전투와 획득 장비의 조합 운용 × 철학·사상"],"name":"전투와 획득 장비의 조합 운용 × 철학·사상","stateInputs":["RouteState","RiskState"],"stateOutputs":["RiskState","ResourceState"],"connections":[],"nativeStateMapping":{"state":"EXECUTABLE_SOURCE_REQUIRED","matchedInputKeys":[],"matchedWrittenOutputKeys":[],"missingInputKeys":["RouteState","RiskState"],"missingWrittenOutputKeys":["RiskState","ResourceState"],"inspectedExecutableFiles":[],"exactRuntimeStateTransitionVerified":false,"rule":"IDENTIFIER_REFERENCE_AND_ASSIGNMENT_ARE_DIAGNOSTIC_CANDIDATES_NOT_GAMEPLAY_PARITY_PASS"},"suggestedExistingOwnerFiles":[],"inspectedSymbols":[],"designStatus":"AUTHORED","codingStatus":"PLATFORM_NOT_SELECTED","executableBehaviorVerified":false,"actualRuntimeVerified":false,"evidenceNeeded":"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA"},{"role":"B","grammarRole":"B","systemId":"VIBE_B","systemIds":["VIBE_B"],"names":["제작과 방어 거점 관리 × 공성전"],"name":"제작과 방어 거점 관리 × 공성전","stateInputs":["RiskState","ResourceState"],"stateOutputs":["RouteState","RiskState"],"connections":[],"nativeStateMapping":{"state":"EXECUTABLE_SOURCE_REQUIRED","matchedInputKeys":[],"matchedWrittenOutputKeys":[],"missingInputKeys":["RiskState","ResourceState"],"missingWrittenOutputKeys":["RouteState","RiskState"],"inspectedExecutableFiles":[],"exactRuntimeStateTransitionVerified":false,"rule":"IDENTIFIER_REFERENCE_AND_ASSIGNMENT_ARE_DIAGNOSTIC_CANDIDATES_NOT_GAMEPLAY_PARITY_PASS"},"suggestedExistingOwnerFiles":[],"inspectedSymbols":[],"designStatus":"AUTHORED","codingStatus":"PLATFORM_NOT_SELECTED","executableBehaviorVerified":false,"actualRuntimeVerified":false,"evidenceNeeded":"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA"},{"role":"@","grammarRole":"DELVE","systemId":"VIBE_DELVE","systemIds":["VIBE_DELVE"],"names":["암호문: 독립된 단서가 같은 의미를 지지함의 성립"],"name":"암호문: 독립된 단서가 같은 의미를 지지함의 성립","stateInputs":["RouteState","RiskState"],"stateOutputs":["WorldAccessState","IntentState"],"connections":[],"nativeStateMapping":{"state":"EXECUTABLE_SOURCE_REQUIRED","matchedInputKeys":[],"matchedWrittenOutputKeys":[],"missingInputKeys":["RouteState","RiskState"],"missingWrittenOutputKeys":["WorldAccessState","IntentState"],"inspectedExecutableFiles":[],"exactRuntimeStateTransitionVerified":false,"rule":"IDENTIFIER_REFERENCE_AND_ASSIGNMENT_ARE_DIAGNOSTIC_CANDIDATES_NOT_GAMEPLAY_PARITY_PASS"},"suggestedExistingOwnerFiles":[],"inspectedSymbols":[],"designStatus":"AUTHORED","codingStatus":"PLATFORM_NOT_SELECTED","executableBehaviorVerified":false,"actualRuntimeVerified":false,"evidenceNeeded":"EXACT_RESPONSIBLE_FUNCTION_AND_STATE_CHANGE + ACTUAL_PLATFORM_ACTION_RESULT_QA"}],"edgeStateMismatches":[],"nativeStateMappingSummary":{"authoredRoles":4,"mappedStaticCandidates":0,"unmappedRoles":[],"edgeMismatches":0,"staticSourceMappingIsNotRuntimeParity":true},"creativeCBinding":{"themes":[],"genres":[{"role":"PRIMARY","name":"스릴러","gameplayEffect":"스릴러: 암호문의 정보의 은폐와 해석를 작품의 경험·정보·갈등·선택에 연결한다. 독립된 단서가 같은 의미를 지지함 조건에서 전달 경로와 해독 단서를 비교한다 행동을 판정하며 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다."},{"role":"SECONDARY","name":"공상과학","gameplayEffect":"공상과학: 가면 의식의 역할과 일시적 전환를 작품의 경험·정보·갈등·선택에 연결한다. 의식의 역할과 행동 조건이 맞음 조건에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정하며 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다."}],"genreInterlock":"스릴러: 스릴러: 암호문의 정보의 은폐와 해석를 작품의 경험·정보·갈등·선택에 연결한다. 독립된 단서가 같은 의미를 지지함 조건에서 전달 경로와 해독 단서를 비교한다 행동을 판정하며 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다. 공상과학: 공상과학: 가면 의식의 역할과 일시적 전환를 작품의 경험·정보·갈등·선택에 연결한다. 의식의 역할과 행동 조건이 맞음 조건에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정하며 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다. 보조 장르가 없으면 같은 대상의 관찰·책임·행동 판단이 사라져 A의 다음 선택이 달라진다.","abGameplayEffect":"철학·사상에 의해 바뀐 인물·지역의 상태는 공성전의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 암호문와 가면 의식가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 적 특성과 획득한 장비를 비교해 전투 방식과 다음 탐험 준비를 선택한다하면서 선택의 책임: 정해진 역할을 따르거나 다른 행동을 택한다. 자신이 선택한 이유와 결과를 인정함일 때 인물의 관계와 이후 목표가 달라진다 그 결과 제작과 방어 거점 관리의 가능 행동과 위험이 바뀌며, 남은 자원으로 장비와 거점을 보강해 다음 탐색 위험을 낮출 방법을 선택하면서 공성탑: 탑을 이동시키거나 성문을 우회한다. 이동로가 확보되고 방어 위치를 확인함일 때 성벽의 공격과 진입 방향이 바뀐다 다시 전투와 획득 장비의 조합 운용의 조건을 바꾼다.","standardVersion":2,"dCreations":[{"id":"D_1","materialPath":["전쟁·군사","정보전","암호문"],"creation":"철학·사상의 첫 선택 공간의 암호문는 정보의 은폐와 해석를 세계의 지속 규칙으로 만든 창작이다. 플레이어가 전달 경로와 해독 단서를 비교한다 행동을 고른다. 스릴러: 스릴러: 암호문의 정보의 은폐와 해석를 작품의 경험·정보·갈등·선택에 연결한다. 독립된 단서가 같은 의미를 지지함 조건에서 전달 경로와 해독 단서를 비교한다 행동을 판정하며 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다. 공상과학: 공상과학: 가면 의식의 역할과 일시적 전환를 작품의 경험·정보·갈등·선택에 연결한다. 의식의 역할과 행동 조건이 맞음 조건에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정하며 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다.","gameplayEffect":"A의 전투와 획득 장비의 조합 운용에서 독립된 단서가 같은 의미를 지지함 조건을 확인한 뒤 B의 제작과 방어 거점 관리에서 전달 경로와 해독 단서를 비교한다 행동을 판정한다. 성공하면 다음 대응과 기만 경로를 선택한다 결과가 A의 다음 선택에 돌아온다. 위험: 잘못 해독하면 상대의 유인에 걸린다. 실패·취소 때 기존 상태와 다른 선택을 보존한다.","genreRoles":["PRIMARY","SECONDARY"],"linkedElements":["A","B"]},{"id":"D_2","materialPath":["사회·문화","축제 문화","가면 의식"],"creation":"공성전의 되돌림 공간의 가면 의식는 역할과 일시적 전환를 세계의 지속 규칙으로 만든 창작이다. 플레이어가 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 고른다. 스릴러: 스릴러: 암호문의 정보의 은폐와 해석를 작품의 경험·정보·갈등·선택에 연결한다. 독립된 단서가 같은 의미를 지지함 조건에서 전달 경로와 해독 단서를 비교한다 행동을 판정하며 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다. 공상과학: 공상과학: 가면 의식의 역할과 일시적 전환를 작품의 경험·정보·갈등·선택에 연결한다. 의식의 역할과 행동 조건이 맞음 조건에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정하며 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 A의 중심 행동과 B의 보조 판단을 바꾼다.","gameplayEffect":"A의 전투와 획득 장비의 조합 운용에서 의식의 역할과 행동 조건이 맞음 조건을 확인한 뒤 B의 제작과 방어 거점 관리에서 가면의 역할을 맡거나 본래 신분을 드러낸다 행동을 판정한다. 성공하면 평소 닫힌 교류와 부탁이 열린다 결과가 A의 다음 선택에 돌아온다. 위험: 역할과 실제 책임을 혼동하면 갈등이 생긴다. 실패·취소 때 기존 상태와 다른 선택을 보존한다.","genreRoles":["PRIMARY","SECONDARY"],"linkedElements":["A","B"]}],"delveDLinks":[{"sourceDId":"D_1","discovery":"암호문의 성립 조건을 바꿔 비교 실험으로 독립된 단서가 같은 의미를 지지함 조건과 다음 대응과 기만 경로를 선택한다 결과의 연결을 발견한다.","experiment":"암호문에서 성립 조건을 바꿔 비교한다. 전달 경로와 해독 단서를 비교한다 행동 전후의 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험을 다른 지역에서 비교한다.","nextQuestion":"암호문에서 잘못 해독하면 상대의 유인에 걸린다 위험이 실제로 발생하면 독립된 단서가 같은 의미를 지지함 조건이 어떻게 달라지는지 다음 방문에서 시험한다."},{"sourceDId":"D_2","discovery":"가면 의식의 성립 조건을 바꿔 비교 실험으로 의식의 역할과 행동 조건이 맞음 조건과 평소 닫힌 교류와 부탁이 열린다 결과의 연결을 발견한다.","experiment":"가면 의식에서 성립 조건을 바꿔 비교한다. 가면의 역할을 맡거나 본래 신분을 드러낸다 행동 전후의 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험을 다른 지역에서 비교한다.","nextQuestion":"가면 의식에서 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 실제로 발생하면 의식의 역할과 행동 조건이 맞음 조건이 어떻게 달라지는지 다음 방문에서 시험한다."},{"sourceDId":"D_1","discovery":"암호문의 위험을 감수한 대안과 비교 실험으로 독립된 단서가 같은 의미를 지지함 조건과 다음 대응과 기만 경로를 선택한다 결과의 연결을 발견한다.","experiment":"암호문에서 위험을 감수한 대안과 비교한다. 전달 경로와 해독 단서를 비교한다 행동 전후의 다음 대응과 기만 경로를 선택한다 결과와 잘못 해독하면 상대의 유인에 걸린다 위험을 다른 지역에서 비교한다.","nextQuestion":"암호문에서 잘못 해독하면 상대의 유인에 걸린다 위험이 실제로 발생하면 독립된 단서가 같은 의미를 지지함 조건이 어떻게 달라지는지 다음 방문에서 시험한다."},{"sourceDId":"D_2","discovery":"가면 의식의 위험을 감수한 대안과 비교 실험으로 의식의 역할과 행동 조건이 맞음 조건과 평소 닫힌 교류와 부탁이 열린다 결과의 연결을 발견한다.","experiment":"가면 의식에서 위험을 감수한 대안과 비교한다. 가면의 역할을 맡거나 본래 신분을 드러낸다 행동 전후의 평소 닫힌 교류와 부탁이 열린다 결과와 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험을 다른 지역에서 비교한다.","nextQuestion":"가면 의식에서 역할과 실제 책임을 혼동하면 갈등이 생긴다 위험이 실제로 발생하면 의식의 역할과 행동 조건이 맞음 조건이 어떻게 달라지는지 다음 방문에서 시험한다."}],"designAuthored":true,"runtimeVerified":false},"observedGameCodeFiles":[],"executableCodeCandidateFiles":[],"gapReasons":["PLATFORM_SOURCE_NOT_SELECTED"],"codingReviewState":"GAME_STAGE_LOCAL_REPAIR_REQUIRED","sourceImplementationPassed":false,"actualTwoClientPassed":false,"actualWebglRenderPassed":false,"independentQaPassed":false,"stageLocalAction":"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME","schemaAndMarkersAloneCannotPass":true,"newPipeline":false,"changesDevelopmentAdmission":false,"saveBalanceAndExistingMultiplayerMeaningPreserved":true},"designedGameVolume":{"version":1,"boundary":"EXISTING_GAME_SPECIFIC_BUILD_UP_DIRECTIVE_ONLY","sourceTreeFingerprint":"bffc67c5835da0267e41809559f1023a940d86e9ffe6a95614602491c1603b04","mode":"APPROVED_DESIGN_