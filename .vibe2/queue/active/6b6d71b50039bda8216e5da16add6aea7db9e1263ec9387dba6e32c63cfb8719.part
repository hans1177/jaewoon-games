"AUDIO"],"state":"EXISTING_SOURCE_CONNECTION_CANDIDATE","missingRoles":[],"responsibleFiles":["web-games/fantasy-survival/index.html","web-games/fantasy-survival/world3d.mjs","web-games/fantasy-survival/research-log-3.html","web-games/fantasy-survival/tier.html","web-games/fantasy-survival/research-log-2.html","web-games/fantasy-survival/research-log.html"],"checks":["SKILL_ACTUAL_EVENT_TO_EFFECT","AUDIO_STATE_AND_CLEANUP","MOBILE_EFFECT_BUDGET"],"gameSourceMutationPerformed":false,"passed":false,"runtimeVerified":false}],"sharedAssetSelection":{"registry":"company-asset-library.json","archives":"assets/asset-manifest.json#sharedOriginalArchives","ui":"assets/roblox/common-ui-v1/catalog.json","materials":"assets/roblox/common-materials-v1/catalog.json","equipment":"assets/roblox/common-character-gear-v1/catalog.json","originalAssetsOnly":true,"sourceHashAndLicenseRequired":true,"noNewAssetGeneration":true,"roleAndTargetCompatibilityRequired":true,"gameBindingAndNativeRuntimeQaRequired":true},"editRule":"EDIT_EXISTING_RESPONSIBLE_GAME_FILES_ONLY","requiredProof":["SOURCE_ANCHOR","EXISTING_GAME_STATE","REAL_EVENT_HANDLER","SERVER_AUTHORITY_WHERE_APPLICABLE","NATIVE_PLATFORM_AND_MOBILE_QA","MOTION_ACTION_SAME_APPROVED_HIT_EVENT","ACTUAL_CHARACTER_MODEL_AND_SAVE_RESTORE"],"implementationProven":false,"runtimeVerified":false,"passed":false},"visualBuildUpDirective":{"nativeOptimization":null,"primitiveReplacement":null,"artDirection":{"identity":"마력숲 생존기. 철학·사상·공성전 역할수행. 마력숲 생존기에서 전투와 획득 장비의 조합 운용 × 철학·사상과 제작과 방어 거점 관리 × 공성전이 서로 결과를 되돌려 바꾸며 스릴러·공상과학의 판단이 실제 세계 상태를 변화시킨다.","visualPurpose":"마력숲 생존기. 철학·사상·공성전 역할수행. 마력숲 생존기에서 전투와 획득 장비의 조합 운용 × 철학·사상과 제작과 방어 거점 관리 × 공성전이 서로 결과를 되돌려 바꾸며 스릴러·공상과학의 판단이 실제 세계 상태를 변화시킨다.의 플레이 판단과 마력숲 생존기가 화면만 보고도 구별되도록 시각 언어를 통일한다.","distinctnessRule":"전투와 획득 장비의 조합 운용 × 철학·사상와 연결되지 않는 장식 추가보다 실루엣·동작·환경 맥락으로 게임 고유성을 강화한다.","placeholderDebt":"HIGH","libraryRenewal":"기존 게임의 자산 적용 여부를 품질 합격으로 간주하지 않는다. 현재 화면의 캐릭터·몬스터·건물·가구·식생·음원·UI와 로비를 게임 설계 기준으로 다시 검토하고 낮은 품질 축은 교체한다. 품질 좋은 내부 범용 원본을 우선 선택해 원본을 보존하고 별도 플랫폼 파생본을 만든다. 공간 모델은 실제 메시·리그·재질·모션과 업로드 ID를 연결하고, 음원은 기존 오디오 처리 경로를 사용한다. 단순 부품 재조합만으로 최종 품질을 주장하지 않는다.","lobbyRenewal":"로비가 있는 게임은 기존 진입·파티·상점·포탈 기능과 저장·서버 권한을 보존하면서 현재 게임 컨셉에 맞게 시야·동선·상호작용 구역·배경을 재구성한다. 로비가 없는 게임에 새 로비를 강제하지 않는다. 실제 전후 화면·모바일 조작·접지·실행 확인 후에만 품질 통과로 기록한다."},"domains":{"CHARACTER":"마력숲 생존기. 철학·사상·공성전 역할수행. 마력숲 생존기에서 전투와 획득 장비의 조합 운용 × 철학·사상과 제작과 방어 거점 관리 × 공성전이 서로 결과를 되돌려 바꾸며 스릴러·공상과학의 판단이 실제 세계 상태를 변화시킨다. 플레이어의 역할이 실루엣·장비·자세에서 읽히게 만들고 idle/이동/핵심행동 사이 포즈 차이를 명확히 한다.","ENEMY_CREATURE":"마력숲 생존기의 상대 역할마다 색만 바꾸지 말고 크기·실루엣·이동 리듬·공격 전조·피격/사망 반응을 다르게 만든다.","WEAPON_EQUIPMENT":"장비가 실제 기능과 연결되어 손에 쥔 형태, 공격 궤적, impact/recovery, 장착 피드백이 서로 일치하게 만든다.","BUILDING_PROP":"상호작용 가능한 구조물과 장식물을 형태·배치·상태 변화로 구분하고 플레이 동선을 가리는 무의미한 소품 반복을 피한다.","ENVIRONMENT_TERRAIN":"마력숲 생존기. 철학·사상·공성전 역할수행. 마력숲 생존기에서 전투와 획득 장비의 조합 운용 × 철학·사상과 제작과 방어 거점 관리 × 공성전이 서로 결과를 되돌려 바꾸며 스릴러·공상과학의 판단이 실제 세계 상태를 변화시킨다.의 세계 역할을 지역별 지형·랜드마크·전경/중경/후경·높낮이·환경 움직임으로 구분한다.","MATERIAL_SURFACE":"나무/돌/금속 등 이름 등록만 하지 말고 실제 표면 반응·거칠기·광택·마모·발광을 장면 조명과 맞춘다.","PALETTE":"위험·안전·보상·상호작용 상태가 게임 팔레트 안에서 즉시 읽히게 하고 단순 색 교체를 정체성 개선으로 계산하지 않는다.","LIGHTING":"핵심 동선·위험·랜드마크를 조명으로 유도하고 캐릭터와 적 실루엣이 배경에 묻히지 않게 한다.","ANIMATION":"주요 액션을 ANTICIPATION→ACCELERATION→IMPACT→RECOVERY로 구성하고 idle/walk/run/attack/hit/death 전환을 실제 상태에 연결한다.","SECONDARY_MOTION":"무기·장비·머리·의상·식생 등 해당 오브젝트에 지연/흔들림을 추가하되 판정과 충돌 권한은 바꾸지 않는다.","VFX":"일반 타격·강한 타격·위험 예고·상태이상·보상 VFX의 형태와 타이밍을 분리하고 실제 impact 이벤트에 동기화한다.","CAMERA":"기본 시야와 모바일 가독성을 보존하면서 핵심행동·강공격·보스/시그니처 순간에 강도가 다른 짧은 카메라 반응을 준다.","UI_HUD":"마력숲 생존기. 철학·사상·공성전 역할수행. 마력숲 생존기에서 전투와 획득 장비의 조합 운용 × 철학·사상과 제작과 방어 거점 관리 × 공성전이 서로 결과를 되돌려 바꾸며 스릴러·공상과학의 판단이 실제 세계 상태를 변화시킨다.의 핵심 목표·자원·위험·다음 선택이 한눈에 보이게 하고 게임 세계관과 맞는 패널/아이콘/피드백 언어를 사용한다.","INVENTORY_EQUIPMENT_UI":"인벤토리와 장비 UI는 획득→비교→장착/교체→현재 장착 표시→실제 외형/행동 반영까지 같은 상태를 사용하고 모바일에서도 한 손 조작과 스크롤/닫기/선택 유지가 명확해야 한다.","AUDIO_MUSIC":"BGM·환경음·행동 피드백은 현재 지역/상태/전투 강도와 연결하고, 소리가 의도적으로 비활성화된 카테고리는 되살리지 않는다. 여러 음악 맥락이 있으면 같은 한 곡 단순 반복 대신 전환·크로스페이드·믹스 변화로 상태가 들리게 한다.","AUDIO_VISUAL_SYNC":"damage/VFX/animation/camera/audio가 같은 authoritative impact 순간을 공유하게 하며 소리만 먼저/늦게 나오는 불일치를 제거한다.","ENVIRONMENTAL_MOTION":"정적인 배경을 피하고 식생·빛·파티클·기계/건축 요소 중 세계에 맞는 미세 움직임을 지속시킨다.","SCENE_DENSITY":"빈 공간과 반복 오브젝트 밀도를 실제 플레이 동선 기준으로 조정하고 중요 영역에는 의미 있는 시각 정보가 있게 한다.","LANDMARK_READABILITY":"플레이어가 지도 없이도 방향과 지역 역할을 기억할 수 있는 실루엣이 다른 랜드마크를 유지·강화한다."},"requiredActorStates":["IDLE","LOCOMOTION","ATTACK_ANTICIPATION","IMPACT","RECOVERY","HIT_REACTION","DEATH"],"completionRules":["ACTUAL_RENDERED_CHANGE_REQUIRED","MARKER_CONFIG_ATOM_ONLY_FORBIDDEN","COLOR_ONLY_NOT_FULL_IDENTITY_UPGRADE","PRIMARY_PLACEHOLDER_PRIMITIVE_CANNOT_CLOSE_VISUAL_BUILD_UP","UI_INVENTORY_AUDIO_MOTION_PRESENCE_ALONE_CANNOT_CLOSE_BUILD_UP","BEFORE_AFTER_COMPARISON_REQUIRED","SAME_SCENE_RUNTIME_REOBSERVATION_REQUIRED"],"focus":"USABILITY"},"playerFacingInspectionContract":{"version":1,"gameId":"fantasy-survival","requiredEveryBuildUpCycle":true,"executionBoundary":"EXISTING_BUILD_UP_AND_F0_F9_ONLY","sourceTreeFingerprint":"bffc67c5835da0267e41809559f1023a940d86e9ffe6a95614602491c1603b04","checklistIsNotExecutedEvidence":true,"evidenceState":"UNVERIFIED","technicalPassIsNotVisualQualityPass":true,"thumbnailTransportIsNotRenderedQuality":true,"validationMode":"REMOTE_AUTOMATED_EXISTING_F0_F9_AND_INDEPENDENT_QA","localManualInspectionRequired":false,"neverTreatSourceOrThumbnailAsRuntimePass":true,"exactCandidateBindingRequired":true,"postPublishVersionMatchRequired":false,"negativeAndRecoveryScenariosRequired":true,"applicabilityRule":"CHECK_EXISTING_OR_APPROVED_SURFACE; NOT_APPLICABLE_REQUIRES_DESIGN_AND_SOURCE_REASON; NEVER_ADD_UNAPPROVED_GAMEPLAY","cases":[{"id":"UI_LAYOUT","domain":"UI_HUD","impact":"UI","applicability":"INSPECT_EXISTING_OR_APPROVED_SURFACE","applicabilityReason":null,"scene":"HUD·메뉴·팝업·인벤을 작은/큰 화면과 가로/세로에서 열고 긴 한글·최대 보유량·위험 경고를 표시","failureCriteria":"글자 잘림·겹침·safe area 침범·체력/목표 가림·초점 소실·색만으로 상태 구분","responsibility":"레이아웃·텍스트