":0,"staticSourceMappingIsNotRuntimeParity":true},"creativeCBinding":{"themes":[{"name":"영웅서사의 이름과 평판","gameplayEffect":"플레이어의 실제 행동보다 퍼진 이야기와 평판이 적·상점·세력의 규칙을 바꾼다. 그 결과 A와 B가 공유하는 조건이 바뀐다."},{"name":"후원과 인맥 관계","gameplayEffect":"관계망의 누구를 밀어주고 누구에게 빚지는지가 능력과 콘텐츠 접근을 결정한다. 그 결과 사건의 비용과 다음 선택이 달라진다."}],"genres":[{"role":"PRIMARY","name":"생활","gameplayEffect":"사회관계 선택와 생활 공간 탐색를 통한 중심 목표와 위험·보상을 판단한다."},{"role":"SECONDARY","name":"추리","gameplayEffect":"영웅서사의 이름과 평판의 단서와 후원과 인맥 관계의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다."}],"genreInterlock":"생활 장르의 주 목표를 진행하는 동안 추리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 추리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.","abGameplayEffect":"신화 속 트릭스터의 질서 역전에 의해 바뀐 인물·지역의 상태는 순교와 집단 결속의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 영웅서사의 이름과 평판와 후원과 인맥 관계가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 그 결과 생활 공간 탐색의 가능 행동과 위험이 바뀌며, 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 다시 사회관계 선택의 조건을 바꾼다.","designAuthored":true,"runtimeVerified":false},"observedGameCodeFiles":["unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs","unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs"],"executableCodeCandidateFiles":["unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs","unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs"],"gapReasons":["DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:MAIN","DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:A","DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:B","DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:@"],"codingReviewState":"GAME_STAGE_LOCAL_REPAIR_REQUIRED","sourceImplementationPassed":false,"actualTwoClientPassed":false,"actualWebglRenderPassed":false,"independentQaPassed":false,"stageLocalAction":"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME","schemaAndMarkersAloneCannotPass":true,"newPipeline":false,"changesDevelopmentAdmission":false,"saveBalanceAndExistingMultiplayerMeaningPreserved":true},"designedGameVolume":{"versi