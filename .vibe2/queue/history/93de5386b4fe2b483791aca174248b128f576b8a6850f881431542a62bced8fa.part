evelopmentDepth":1,"directive":"넓은 공간이 비지 않게 탐색 거리마다 기능성 소품·상호작용·조우·자원·환경 이야기 중 게임에 맞는 요소를 배치하고 반복 복제 밀도를 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"WORLD_NAVIGATION","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"지도/미니맵/방향 표식/랜드마크/목표 추적 중 게임에 맞는 수단으로 현재 위치·목적지·잠금 경로를 읽게 하며 모바일에서도 길을 잃는 비용을 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"LANDMARKS","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"주요 랜드마크는 거리에서도 실루엣과 기능이 구별되고 탐색·방향 판단·목표 기억에 쓰이도록 배치하며 단순 장식물로 끝내지 않는다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"TRAVERSAL","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"이동은 속도만이 아니라 지형·장애물·경로 선택·위험 회피와 연결하고 모바일 입력에서 의도한 방향/행동이 안정적으로 유지되게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"INTERACTION_DISCOVERABILITY","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"줍기·열기·대화·제작·장착·구매·사용 가능한 대상은 접근 전후에 형태/프롬프트/상태 피드백으로 구별되고 상호작용 실패 이유도 즉시 보이게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"ECONOMY","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"재화의 획득원·사용처·가격 단계·손실/회수 규칙을 성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다.과 연결하고 무한 축적 또는 의미 없는 구매가 생기지 않게 한다. 승인 없는 기존 수치 변경은 금지한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"INVENTORY","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"인벤토리는 획득·정렬/표시·장착/사용·교체·버리기/보존 상태를 명확히 하고 실제 캐릭터/전투/진행 상태와 동기화한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"INVENTORY_USABILITY","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"인벤토리의 획득·스택·정렬·선택·사용·장착·교체·버리기/보존·가득 참 처리를 모바일 터치에서 끊김 없이 연결하고 현재 장착 상태를 명확히 표시한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"EQUIPMENT_LOADOUT","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"장비/무기 슬롯, 교체, 비교, 장착 표시, 캐릭터 외형/스탯/행동 반영이 같은 authoritative 장착 상태를 사용하도록 연결한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"CRAFTING","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"제작이 적용되는 게임이면 재료 발견→레시피 이해→제작 조건→대기/완료→인벤토리 반영→실제 사용까지 끊김 없이 연결하고 중복 레시피를 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"SYSTEM_CONNECTION","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"드랍→인벤토리→제작/장착→전투/탐색→보상/해금처럼 현재 게임의 주요 시스템들이 실제 상태를 주고받게 하고 서로 고립된 메뉴 기능을 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"SESSION_FLOW","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"접속→준비→첫 행동→목표/실패→결과/보상→재시도→다음 선택을 연결한다. 확인된 실패 수리 후 첫 플레이·재도전·적용 가능한 친구 참가·연출 순으로 한 흐름씩 구현·검수한다. 결과는 달성 내용·실제 실패 원인/성공 선택·재도전/다음 단계/로비를 보여주고 서버 확정 보상만 표시한다. 재도전 연타도 한 번만 시작되며 입력·판정·상태·피드백·실패 복귀가 연결되어야 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"FIRST_10_MINUTES","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"첫 10분 안에 이동/기본 입력, 핵심 상호작용, 첫 성공 피드백, 첫 보상 또는 성장, 다음 목표를 실제 플레이로 경험하게 하고 설명문만으로 대체하지 않는다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"FAILURE_RESPAWN_CHECKPOINTS","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"사망/실패/런 종료 시 기존 손실·보존·체크포인트·리스폰 규칙을 유지하고 빠르게 재시작하게 한다. 실제 기록에 있는 원인만 시각화한다: 퍼즐의 잘못된 연결, 방어의 뚫린 경로, 생존의 사망 원인 등 해당 장르에 맞게 표시하며 근거가 없으면 추측하지 않는다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"SAVE_AND_RECOVERY","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"기존 저장 키·구조·의미를 보존하고 진행·장비·해금을 재접속 후 복구한다. 불러오기 실패를 신규 사용자로 처리하거나 기본값으로 덮어쓰지 말고 재시도·안전 복귀를 제공한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"SAVE_COMPLETENESS","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"현재 게임에서 저장돼야 하는 진행·인벤토리·장비·해금·퀘스트·발견 지역·설정 상태를 기존 save 의미를 깨지 않고 재접속 후 일관되게 복구한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"RECONNECT_RECOVERY","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"재접속/late join/네트워크 실패 후 권위 상태를 재동기화하고 중복 보상·장비 유실·퀘스트 되감기 없이 복구한다. 복구된 실제 진행·현재 목표·다음 행동을 짧게 안내하며 복구 전 상태를 확정해 표시하지 않는다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"MULTIPLAYER_AND_SYNC","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"모든 게임은 멀티 구현이 필수다. 기존 SINGLE 원본은 디자이너가 COOP/COMPETITIVE/HYBRID 중 게임에 맞는 확장을 작성하며 기존 멀티 규칙은 보존한다. 기존 방 생성·참가·준비·시작·이탈을 서버 판정으로 연결한다. 참가자·준비·기존 모드를 표시하고 대기 중 안전한 공동 연습을 제공한다. 결과 화면에 각자 재도전 의사를 표시하고 기존 참가 규칙으로 인원을 유지하되 이탈자 때문에 무한 대기하지 않게 한다. 방장 이탈·late join·재접속을 기존 규칙으로 복구하고 실제 2인 이상의 행동·목표·승패·보상 일치와 중복 지급 방지를 검수한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"INPUT","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"핵심 행동마다 터치 우선 입력과 키보드/패드 대체 입력을 동일 게임 상태에 연결하고 중복 입력·길게 누름·드래그·취소 경계를 명확히 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"MOBILE_UX","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"작은 화면에서 핵심 행동 버튼을 크게, 설정·도움말을 접어서 배치하고 HUD·위험 경고가 손가락에 가리지 않게 한다. safe area·스크롤·가로/세로를 검수하고 팝업 닫기 터치가 뒤쪽 이동·공격으로 전달되지 않게 입력을 소비한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"ACCESSIBILITY","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"색만으로 상태를 구분하지 않고 형태/아이콘/텍스트/모션을 함께 쓰며, 중요한 피드백은 크기·대비·지속시간을 확보해 정보 누락을 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"SETTINGS_ACCESSIBILITY","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"음량·카메라/흔들림·감도·UI 크기/가독성 등 현재 게임에 필요한 설정을 접근 가능한 메뉴에 두고 설정 변경이 즉시 반영·저장되게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"MENU_FLOW","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"몬스터 어드벤처를 연습하는 로비/허브를 기존 UI에 연결한다. 승인된 장르에 맞게 퍼즐은 작은 연습판, 방어는 적 하나에 배치·회수, 생존은 안전한 채집·제작·장착을 활용한다. 연습은 건너뛸 수 있고 기존 재화·보상·저장에 영향을 주지 않는다. 로딩은 실제 월드·저장·참가 준비 단계와 실패 이유·재시도/안전 복귀를 표시한다. 시작은 준비 확인 후 한 번만 처리하고 스폰·카메라·목표까지 연결한다. 기존 메뉴의 뒤로가기·닫기·스크롤·팝업·선택 유지를 모바일에서 검수하며 중복 화면·가짜 진행률·장식용 버튼을 금지한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"CONVENIENCE","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"반복 조작을 줄일 수 있는 빠른 사용/장착, 제작 가능 표시, 부족 재료 표시, 목표 추적, 비교 정보 등 현재 게임에 맞는 편의 기능을 추가하되 플레이 선택 자체를 자동화하지 않는다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"UI_DESIGN_SYSTEM","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"HUD와 메뉴가 공통 타이포·패널·아이콘·간격·상태 색/형태 규칙을 공유하고 게임 세계의 아트 언어와 연결되며 기능마다 제각각인 임시 UI를 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"UI_INFORMATION_PRIORITY","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"현재 목표, 생존/위험, 핵심 자원, 장비/쿨다운, 다음 행동 순으로 실제 플레이 중요도에 맞게 정보 위계를 정하고 작은 화면에서 비핵심 정보가 핵심 HUD를 밀어내지 않게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"FEEDBACK_CLARITY","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"획득·구매·제작·장착·레벨업·퀘스트·실패·사용 불가 등 중요한 상태 변화에 즉시 읽히는 UI/음향/시각 피드백과 실패 이유를 연결한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"TUTORIAL_ONBOARDING","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"몬스터 어드벤처의 첫 입력·결과·목표를 필요한 순간 한 줄과 실습으로 안내한다. 같은 실패 반복 시 목표 확인→관련 위치→행동 예시의 선택형 힌트를 단계적으로 제공하되 정답 자동 처리·난이도 변경은 금지한다. 설명 닫기는 학습 완료가 아니며 건너뛰기·도움말 다시 열기를 제공한다. 재접속은 초기 설명 대신 현재 목표를 보여준다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"DIFFICULTY_PACING","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"초반 진입, 중반 선택 압박, 후반 숙련 요구가 갑자기 튀지 않게 적/자원/목표/보상의 복잡도를 단계적으로 올리고 실패 원인이 학습 가능한 형태로 보이게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"GAME_FEEL","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"핵심 입력의 반응 지연, anticipation, impact, hit-stop/반동/화면 반응, recovery를 장르와 몬스터 어드벤처에 맞춰 조정해 버튼 입력과 결과 사이의 손맛을 강화한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"SPAWN_ENCOUNTER_DIRECTOR","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"적·자원·이벤트·조우의 생성 위치/빈도/조합/안전거리/재생성 규칙을 지역 역할과 난이도에 맞추고 불공정한 즉시 피격·과밀·공백을 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"NPC_SOCIAL_BEHAVIOR","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"NPC가 적용되는 게임이면 idle 순환뿐 아니라 이동 목적, 상호작용 반응, 시간/지역/퀘스트 상태에 따른 행동 변화가 세계 역할과 연결되게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"NARRATIVE_STORY","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"스토리가 적용되는 게임이면 세계 설정·NPC 대사·환경 단서·퀘스트 결과가 서로 모순되지 않고 플레이 행동으로 드러나며 긴 설명이 핵심 루프를 끊지 않게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"AUDIO_MUSIC_SFX","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"배경음악은 지역/상태/전투 강도 전환과 연결하고, 핵심 행동·위험 전조·피격·보상·UI SFX를 서로 구별해 화면을 보지 않아도 중요한 사건을 인지할 수 있게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"REPLAYABILITY_VARIATION","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"반복 플레이가 적용되는 게임이면 조우 조합·지역 경로·보상 선택·빌드/전략·이벤트 중 게임에 맞는 변주를 제공해 같은 정답만 반복되지 않게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"CHARACTER_VISUALS","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"몬스터 어드벤처. 신화 속 트릭스터의 질서 역전·순교와 집단 결속 생활. 몬스터 어드벤처에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전과 생활 공간 탐색 × 순교와 집단 결속이 서로 결과를 되돌려 바꾸며 생활·추리의 판단이 실제 세계 상태를 변화시킨다. 플레이어/NPC의 역할·등급·장비가 실루엣, 비율, 자세, 재질에서 구별되고 핵심 행동 모션과 연결되게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"ENEMY_VISUALS","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"적 종류와 위험도가 색상만이 아니라 실루엣·크기·이동 리듬·공격 전조·피격/사망 반응으로 구별되게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"WEAPONS_AND_EQUIPMENT","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"무기/장비 외형이 실제 기능·사거리·무게감·공격 궤적·장착 상태와 맞고 플레이어 손/몸에 자연스럽게 연결되게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"BUILDINGS_AND_PROPS","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"건물·상호작용 오브젝트·장식물은 기능과 상태가 형태/배치/재질로 구별되고 플레이 동선과 충돌하지 않게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"ENVIRONMENT","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"전경/중경/배경, 식생/소품, 위험/안전 신호, 환경 스토리텔링을 몬스터 어드벤처. 신화 속 트릭스터의 질서 역전·순교와 집단 결속 생활. 몬스터 어드벤처에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전과 생활 공간 탐색 × 순교와 집단 결속이 서로 결과를 되돌려 바꾸며 생활·추리의 판단이 실제 세계 상태를 변화시킨다. 아트 방향 안에서 통일하고 빈 장식면을 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"TERRAIN","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"지형 높낮이·경계·통로·전투/상호작용 공간이 플레이 기능과 맞고 반복 평면/단일 primitive 위주 구성을 실제 지형 형태로 교체한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"MATERIALS","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"재질은 이름 등록이 아니라 거칠기·광택·마모·투명/발광·빛 반응이 표면 역할과 맞게 실제 렌더에 적용되도록 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"PALETTE","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"팔레트는 지역/진영/위험/보상/상호작용 상태를 구분하면서 전체 게임 정체성을 유지하고 단순 색상 교체만으로 개선 완료를 주장하지 않는다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"LIGHTING","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"조명은 시간/분위기뿐 아니라 플레이 동선, 적 전조, 상호작용 대상, 랜드마크 가독성을 지원하고 캐릭터 실루엣을 배경에서 분리한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"ANIMATION","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"주요 캐릭터/적 행동을 idle→locomotion→anticipation→impact→recovery→hit/death 상태와 실제 게임 이벤트에 연결하고 정지 모델 판정을 금지한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"SECONDARY_MOTION","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"장비·의상·머리·꼬리·식생·기계 등 적합한 요소에 지연/관성/반동을 추가해 무게감과 생동감을 주되 판정/권한은 바꾸지 않는다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"VFX","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"일반 타격, 강공격, 위험 전조, 상태이상, 보상, 보스/시그니처 이벤트의 VFX 형태·강도·지속시간을 분리하고 실제 상태 변화 시점에 동기화한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"CAMERA","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"기본 시야·FOV·추적을 모바일 가독성에 맞추고 강한 타격/대시/보스/탐색 포인트에 짧고 단계적인 카메라 반응을 적용해 멀미와 과도한 흔들림을 피한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"UI_HUD","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"HUD는 현재 목표·체력/위험·핵심 자원·쿨다운/상태·다음 선택의 우선순위를 명확히 하고 게임 아트 언어와 일치하는 패널/아이콘/상태 피드백을 사용한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"AUDIO_VISUAL_TIMING","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"핵심 action의 animation impact, damage/state change, VFX, camera, audio가 같은 사건 타임라인에 맞게 발생하도록 오프셋을 정리한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"ENVIRONMENTAL_MOTION","state":"PASS","priority":"BUILD_UP_NOW","developmentDepth":1,"directive":"세계에 맞는 바람/식생/물/빛/먼지/기계 등 미세 환경 움직임을 추가해 정적인 무대를 피하되 플레이 정보와 성능을 방해하지 않는다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"PERFORMANCE","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"실제 병목 근거를 기준으로 update/tick 빈도, 객체/파티클 수명, draw/instance 수, GC/할당, 네트워크 빈도, 모바일 열/메모리 비용을 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"PERFORMANCE_BUDGET","state":"PASS","priority":"MONITOR_OR_CONNECT","developmentDepth":1,"directive":"맵·에셋·NPC·VFX를 늘릴 때 객체 수명, 동시 NPC/파티클, 업데이트 빈도, 스트리밍/LOD, 메모리·모바일 프레임 예산을 함께 정의하고 초과 시 표현 비용부터 줄인다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"RUNTIME_STABILITY","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"핵심 루프를 반복 실행해도 상태 누수·중복 이벤트·고착·크래시 없이 시작→플레이→실패/성공→재시작/복귀가 유지되게 한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"},{"domain":"ERROR_RECOVERY","state":"GAP","priority":"FIX_NOW","developmentDepth":1,"directive":"재현된 오류는 숨기지 말고 책임 시스템에서 원인을 제거하고 실패 시 안전한 복구/재시도/사용자 피드백 경로를 제공한다.","implementationContract":"WHAT→TRIGGER/CONDITION→STATE_CHANGE→PLAYER_FEEDBACK→SYSTEM_CONNECTION→OBSERVABLE_ACCEPTANCE","acceptance":"REAL_GAME_SOURCE_AND_RUNTIME_OR_PLAY_EVIDENCE_REQUIRED"}],"detectedGaps":[{"domain":"MAP_EXPANSION","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"WORLD_DENSITY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"WORLD_NAVIGATION","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"LANDMARKS","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"INVENTORY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"INVENTORY_USABILITY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"SYSTEM_CONNECTION","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"SAVE_COMPLETENESS","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"RECONNECT_RECOVERY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"MULTIPLAYER_AND_SYNC","state":"GAP","reason":"required multiplayer implementation or reconnect recovery is incomplete; continue existing BUILD_UP"},{"domain":"MENU_FLOW","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"GAME_FEEL","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"AUDIO_MUSIC_SFX","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"AUDIO_VISUAL_TIMING","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"RUNTIME_STABILITY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"},{"domain":"ERROR_RECOVERY","state":"GAP","reason":"current source signals indicate shallow, missing, disconnected, or placeholder-heavy implementation"}],"primaryFocus":"PRESENTATION","thisLoopPrimaryGoal":"몬스터 어드벤처. 신화 속 트릭스터의 질서 역전·순교와 집단 결속 생활. 몬스터 어드벤처에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전과 생활 공간 탐색 × 순교와 집단 결속이 서로 결과를 되돌려 바꾸며 생활·추리의 판단이 실제 세계 상태를 변화시킨다.의 몬스터 어드벤처와 사회관계 선택 × 신화 속 트릭스터의 질서 역전가 캐릭터·적·환경·모션·VFX·카메라·UI 전체에서 한눈에 구별되도록 비주얼 정체성을 높인다.","primaryGoalReason":"현재 검증 신호와 소스에서 PRESENTATION를 우선한다. 게임 고유 앵커는 \"몬스터 어드벤처\", 현재 책임 소스는 unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::LoadState, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::BuildWeb, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::Build, unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::LogState, unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::BuildWorld, unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::StartGameplay, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::UnityWebFloorBuild, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::BindModel이며 실제 source delta와 효과 증거가 다음 결정을 좌우한다.","gameplayImplementationDirectives":["우선 책임 소스 앵커 unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::LoadState, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::BuildWeb, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::Build, unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::LogState, unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::BuildWorld, unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::StartGameplay, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::UnityWebFloorBuild, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::BindModel에서 현재 행동→상태 변화→피드백 연결을 직접 수정하고 wrapper나 우회 경로를 추가하지 않는다.","몬스터 어드벤처를 설명/마커가 아니라 실제 authoritative game state와 플레이어 입력에 연결하고 성공·실패·재시도 경로를 완성한다.","사회관계 선택 × 신화 속 트릭스터의 질서 역전가 다음 선택을 바꾸도록 상태 변화와 피드백을 연결한다.","기획 루프 1 \"Start immediately with simple one-thumb tap or swipe input and a clear score, distance, or short-session goal.\": 현재 책임 함수와 실제 조작 경로를 대조한다. 누락되면 기존 구현에서 보강하고, 입력 전 조건→실제 입력→장르에 맞는 상태/화면 변화→다음 단계 연결을 같은 플랫폼에서 재현한다. 버튼 제목이나 공통 점수 증가만으로 이 단계를 구현했다고 판정하지 않는다.","기획 루프 2 \"Play a brief run with readable feedback, collect rewards, and make a small risk or route choice before the run ends.\": 현재 책임 함수와 실제 조작 경로를 대조한다. 누락되면 기존 구현에서 보강하고, 입력 전 조건→실제 입력→장르에 맞는 상태/화면 변화→다음 단계 연결을 같은 플랫폼에서 재현한다. 버튼 제목이나 공통 점수 증가만으로 이 단계를 구현했다고 판정하지 않는다.","기획 루프 3 \"Finish or fail, receive a score or reward, unlock a small progression benefit, and retry quickly with minimal friction.\": 현재 책임 함수와 실제 조작 경로를 대조한다. 누락되면 기존 구현에서 보강하고, 입력 전 조건→실제 입력→장르에 맞는 상태/화면 변화→다음 단계 연결을 같은 플랫폼에서 재현한다. 버튼 제목이나 공통 점수 증가만으로 이 단계를 구현했다고 판정하지 않는다.","고유 시스템 \"몬스터 어드벤처\": 플레이어 선택 \"사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다.\"이 실제 결과를 달리 만드는지 두 선택의 결과를 비교한다. 코드 키워드·설명·자체 PASS 로그는 증거가 아니며, 실측하지 못하면 미확인으로 남기고 완료/효과 확인에 포함하지 않는다.","고유 시스템 \"사회관계 선택 × 신화 속 트릭스터의 질서 역전\": 플레이어 선택 \"인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 신화 속 트릭스터의 질서 역전의 제약을 감수할지 결정한다.\"이 실제 결과를 달리 만드는지 두 선택의 결과를 비교한다. 코드 키워드·설명·자체 PASS 로그는 증거가 아니며, 실측하지 못하면 미확인으로 남기고 완료/효과 확인에 포함하지 않는다.","고유 시스템 \"생활 공간 탐색 × 순교와 집단 결속\": 플레이어 선택 \"이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 순교와 집단 결속의 반작용을 선택한다.\"이 실제 결과를 달리 만드는지 두 선택의 결과를 비교한다. 코드 키워드·설명·자체 PASS 로그는 증거가 아니며, 실측하지 못하면 미확인으로 남기고 완료/효과 확인에 포함하지 않는다.","고유 시스템 \"금기와 기회의 교차\": 플레이어 선택 \"신화 속 트릭스터의 질서 역전의 제약과 순교와 집단 결속의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다.\"이 실제 결과를 달리 만드는지 두 선택의 결과를 비교한다. 코드 키워드·설명·자체 PASS 로그는 증거가 아니며, 실측하지 못하면 미확인으로 남기고 완료/효과 확인에 포함하지 않는다.","고유 시스템 몬스터 어드벤처, 사회관계 선택 × 신화 속 트릭스터의 질서 역전, 생활 공간 탐색 × 순교와 집단 결속, 금기와 기회의 교차 중 이번 목표와 직접 연결된 시스템을 기존 책임 코드에서 심화한다.","핵심 게임플레이 의미는 보존하면서 이번 품질축에 필요한 연결만 수정한다."],"progressionContentWorldDirectives":["성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다.을 현재 루프의 실제 목표·보상·해금·콘텐츠 연결로 구현/심화한다.","새 콘텐츠는 기존 핵심 루프와 연결되어야 하며 단순 수량 복제나 색/수치만 다른 변형으로 채우지 않는다.","맵/지역이 있는 게임은 면적만 늘리지 말고 새 지역 역할·연결 경로·잠금/해금·랜드마크·조우/자원 역할·발견 피드백이 구별되도록 확장한다.","인벤토리/장비/제작/상점/퀘스트가 존재하면 서로 같은 authoritative 상태를 사용해 실제 플레이와 연결하고 고립된 메뉴 기능으로 남기지 않는다.","초반 10분과 중후반을 각각 점검해 초반 학습·첫 보상과 중후반 전략/콘텐츠 확장이 모두 실제 소스와 플레이 흐름에 존재하게 한다.","콘텐츠 확장은 배경·지역·몹·아이템·퀘스트·스토리·보상·규칙 중 관련 요소를 서로 연결된 묶음으로 설계하고, 한 요소만 고립해서 개수만 늘리는 업데이트를 피한다.","이전 세대와 이름·색·수치만 다른 복제 콘텐츠를 추가하지 말고 역할·행동·플레이어 선택·세계 이유·결과/보상·시스템 연결 중 최소 두 축 이상에서 실제 차이를 만든다.","새 스토리·퀘스트·지역·규칙은 이전 상태에서 왜 발생하고 완료 후 무엇이 달라지는지 게임 상태와 세계 흐름에 남겨 개연성과 진행 연결을 유지한다.","승인된 인과 문법이 있으면 새 지역·몬스터·NPC·아이템·세력은 같은 법칙을 복제하지 말고 서로 다른 방식으로 전달·왜곡·상속·분산·역전시켜 새 선택 구조를 만든다.","가벼운 D1 엽기/코믹 문법은 억지로 장대한 신화·정치 구조로 키우지 않는다. 단순한 농담 규칙이라도 실제 상태 변화와 후폭풍이 반복 가능하면 깊이 있는 정체성으로 인정한다."],"autonomousContentExpansion":{"version":2,"policySource":"company-learning/vibe-autonomous-content-expansion-policy.json","policyStatus":"ACTIVE","executionBoundary":"EXISTING_BUILD_UP_ONLY","autonomousDecisionOwner":"VIBE","assistantManualIdeaDependencyForbidden":true,"newWorkflowForbidden":true,"newStageForbidden":true,"ownerPromptPerExpansionForbidden":true,"platformScope":["WEB","ROBLOX","UNITY"],"requestedPlatform":"WEB","executionMode":"AUTONOMOUS_CONTENT_BUILD_UP","contentExpansionDeferredUntilRuntimeRepairPass":false,"themeCoverageAdvanced":true,"dataCapacityBudget":{"state":"NORMAL","limits":{"savePersistedDataBytes":2097152,"webDownloadBytes":104857600,"singleFileBytes":26214400,"mobileMemoryTargetBytes":314572800,"mobileMinimumFps":30},"warningRatio":0.8,"measured":{"sourceBytes":560741,"largestFileBytes":55470,"savePersistedDataBytes":0,"mobileMemoryBytes":0,"mobileFps":0},"warning":[],"exceeded":[],"strategy":"CONTINUE_HIGHEST_VALUE_COHERENT_BUILD_UP","generationLimit":null,"contentCountLimit":null,"buildUpMustContinue":true,"protectedStateDeletionForbidden":true},"existingCompletenessReview":{"requiredEveryBuildUp":true,"mode":"CHECK_EXISTING_AND_EXPAND_OR_IMPROVE_WHICHEVER_HAS_HIGHER_PLAYER_VALUE","dimensions":["CORE_LOOP_COMPLETENESS","QUEST_AND_GOAL_FLOW","WORLD_AND_REGION_FLOW","MONSTER_ENEMY_ROLE_COVERAGE","ITEM_EQUIPMENT_REWARD_PURPOSE","STORY_WORLD_CAUSALITY","GAMEPLAY_RULE_CONNECTIONS","PROGRESSION_PACING","MID_LATE_ENDGAME_DEPTH","MULTIPLAYER_WHEN_APPLICABLE","PRESENTATION_AND_FEEDBACK"],"weakExistingContentMayPreemptNewContent":true},"selectedTheme":"PRESENTATION_WORLD_COHESION","themeDepth":6,"selectedThemeReason":"1 explicit GAP(s) and 10 applicable domain(s); focus=PRESENTATION; previousTheme=PRESENTATION_WORLD_COHESION; previousEffect=UNKNOWN_RUNTIME_EFFECT; previousCoverage=5; uncoveredBefore=6.","themeCoverageLedger":{"version":1,"counts":{"WORLD_ECOLOGY_STORY_CHAIN":0,"ENEMY_BOSS_COMBAT_ECOLOGY":0,"QUEST_STORY_PROGRESSION_CHAIN":0,"ITEM_EQUIPMENT_CRAFT_SYSTEM_CHAIN":0,"RULES_EVENTS_REPLAYABILITY_SYSTEM":0,"MID_LATE_ENDGAME_COMPLETION":0,"PRESENTATION_WORLD_COHESION":6},"sequence":["PRESENTATION_WORLD_COHESION","PRESENTATION_WORLD_COHESION","PRESENTATION_WORLD_COHESION","PRESENTATION_WORLD_COHESION","PRESENTATION_WORLD_COHESION","PRESENTATION_WORLD_COHESION"],"requiredThemes":["WORLD_ECOLOGY_STORY_CHAIN","ENEMY_BOSS_COMBAT_ECOLOGY","QUEST_STORY_PROGRESSION_CHAIN","ITEM_EQUIPMENT_CRAFT_SYSTEM_CHAIN","RULES_EVENTS_REPLAYABILITY_SYSTEM","MID_LATE_ENDGAME_COMPLETION","PRESENTATION_WORLD_COHESION"],"distinctCovered":1,"totalThemes":7,"breadthCycleComplete":false,"missingThemes":["WORLD_ECOLOGY_STORY_CHAIN","ENEMY_BOSS_COMBAT_ECOLOGY","QUEST_STORY_PROGRESSION_CHAIN","ITEM_EQUIPMENT_CRAFT_SYSTEM_CHAIN","RULES_EVENTS_REPLAYABILITY_SYSTEM","MID_LATE_ENDGAME_COMPLETION"],"leastCoveredThemes":["WORLD_ECOLOGY_STORY_CHAIN","ENEMY_BO