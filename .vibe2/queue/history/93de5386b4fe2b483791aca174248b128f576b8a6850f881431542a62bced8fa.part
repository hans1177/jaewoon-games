y-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\"],\"expectedNativeBehavior\":\"PLAYER_ACTION_CAUSES_AUTHORED_LOOP_STATE_AND_NEXT_CHOICE\"},{\"id\":\"CONTENT:0\",\"kind\":\"DESIGNED_CONTENT_MILESTONE\",\"title\":\"초반 선택에 따른 접근 경로와 위험 재구성\",\"weight\":80,\"designedGameplay\":\"사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.\",\"designedSystemImpact\":\"이전 생활 공간 탐색 × 순교와 집단 결속 상태에 입력·피드백을 연결하고 저장 및 진행의 원래 의미를 유지한다.\",\"sourceOwnerCandidates\":[\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\",\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\"],\"expectedNativeBehavior\":\"REAL_UNLOCK_OR_CONTENT_STATE_REACHABLE_AND_PLAYER_CONSEQUENCE\"},{\"id\":\"CONTENT:1\",\"kind\":\"DESIGNED_CONTENT_MILESTONE\",\"title\":\"중반 두 시스템의 반작용과 대응 조건 충돌\",\"weight\":80,\"designedGameplay\":\"생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.\",\"designedSystemImpact\":\"이전 사회관계 선택 × 신화 속 트릭스터의 질서 역전 상태에 입력·피드백을 연결하고 저장 및 진행의 원래 의미를 유지한다.\",\"sourceOwnerCandidates\":[\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\",\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\"],\"expectedNativeBehavior\":\"REAL_UNLOCK_OR_CONTENT_STATE_REACHABLE_AND_PLAYER_CONSEQUENCE\"},{\"id\":\"CONTENT:2\",\"kind\":\"DESIGNED_CONTENT_MILESTONE\",\"title\":\"숨겨진 세계 인과법칙을 이용한 새로운 접근\",\"weight\":80,\"designedGameplay\":\"영웅서사의 이름과 평판과 후원과 인맥 관계의 조합에 다른 인간 갈등을 연결한다. 숨겨진 규칙의 발견으로 우회 접근과 새로운 대응법을 연다.\",\"designedSystemImpact\":\"이전 생활 공간 탐색 × 순교와 집단 결속 상태에 입력·피드백을 연결하고 저장 및 진행의 원래 의미를 유지한다.\",\"sourceOwnerCandidates\":[\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\",\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\"],\"expectedNativeBehavior\":\"REAL_UNLOCK_OR_CONTENT_STATE_REACHABLE_AND_PLAYER_CONSEQUENCE\"},{\"id\":\"CONTENT:3\",\"kind\":\"DESIGNED_CONTENT_MILESTONE\",\"title\":\"누적된 관계를 되짚는 재방문과 장기 숙련\",\"weight\":80,\"designedGameplay\":\"발견된 단서와 숙련을 기존 시스템 두 개 이상의 새로운 운용으로 확장한다. 재방문 시 이전 행동이 만든 관계·접근 조건과 결말을 다시 평가한다.\",\"designedSystemImpact\":\"이전 사회관계 선택 × 신화 속 트릭스터의 질서 역전 상태에 입력·피드백을 연결하고 저장 및 진행의 원래 의미를 유지한다.\",\"sourceOwnerCandidates\":[\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\",\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\"],\"expectedNativeBehavior\":\"REAL_UNLOCK_OR_CONTENT_STATE_REACHABLE_AND_PLAYER_CONSEQUENCE\"},{\"id\":\"CREATIVE_C_CAUSALITY\",\"kind\":\"DESIGN_CREATIVE_INTERLOCK\",\"title\":\"A_B_C_PRIMARY_SECONDARY_GAMEPLAY_EFFECT\",\"weight\":75,\"sourceOwnerCandidates\":[\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\",\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\"],\"expectedNativeBehavior\":\"ACTUAL_GAMEPLAY_STATE_AND_PLAYER_DECISION_CHANGE_FROM_CREATIVE_C\"},{\"id\":\"NATIVE_3D_VISUAL\",\"kind\":\"UNITY_WEB_SPATIAL_PRESENTATION\",\"weight\":65,\"sourceOwnerCandidates\":[\"unity-games/monster-adventure/Assets/Art/bat.obj\",\"unity-games/monster-adventure/Assets/Art/bird.obj\",\"unity-games/monster-adventure/Assets/Art/boar.obj\",\"unity-games/monster-adventure/Assets/Art/chest.obj\",\"unity-games/monster-adventure/Assets/Art/flamefox.obj\",\"unity-games/monster-adventure/Assets/Art/foundation_rect.obj\",\"unity-games/monster-adventure/Assets/Art/hornbull.obj\"],\"expectedNativeBehavior\":\"REAL_NATIVE_UNITY_3D_MESH_CAMERA_MOTION_MATERIAL_AND_MOBILE_BROWSER_PIXELS\"},{\"id\":\"MULTIPLAYER_SYNC\",\"kind\":\"NATIVE_MULTIPLAYER\",\"weight\":110,\"sourceOwnerCandidates\":[\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\",\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\"],\"expectedNativeBehavior\":\"TWO_REAL_BROWSER_CLIENTS_SHARED_AUTHORITATIVE_SESSION_AND_RECONNECT_QA\"}],\"developmentPackages\":[{\"sequence\":1,\"responsibleFiles\":[\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\"],\"designRequirementIds\":[\"MULTIPLAYER_SYNC\",\"ROLE:@\",\"ROLE:A\",\"ROLE:B\",\"ROLE:MAIN\",\"LOOP:0\",\"LOOP:1\",\"LOOP:2\",\"CONTENT:0\",\"CONTENT:1\",\"CONTENT:2\",\"CONTENT:3\",\"CREATIVE_C_CAUSALITY\",\"EDGE:VIBE_A->VIBE_B\",\"EDGE:VIBE_A->VIBE_DELVE\",\"EDGE:VIBE_B->VIBE_A\",\"EDGE:VIBE_B->VIBE_DELVE\",\"EDGE:VIBE_DELVE->VIBE_MAIN\",\"EDGE:VIBE_MAIN->VIBE_A\"],\"priorityWeight\":1590,\"method\":\"DIRECT_EDIT_EXISTING_CSHARP_OR_UNITY_ASSET_OWNER\",\"acceptance\":\"REAL_NATIVE_SOURCE_DIFF_THEN_EXACT_WEBGL_MOBILE_BROWSER_PLAY_AND_STATE_REGRESSION\",\"sourceEvidenceOnly\":true,\"runtimeVerified\":false},{\"sequence\":2,\"responsibleFiles\":[\"unity-games/monster-adventure/Assets/Art/bat.obj\"],\"designRequirementIds\":[\"NATIVE_3D_VISUAL\"],\"priorityWeight\":65,\"method\":\"DIRECT_EDIT_EXISTING_CSHARP_OR_UNITY_ASSET_OWNER\",\"acceptance\":\"REAL_NATIVE_SOURCE_DIFF_THEN_EXACT_WEBGL_MOBILE_BROWSER_PLAY_AND_STATE_REGRESSION\",\"sourceEvidenceOnly\":true,\"runtimeVerified\":false}],\"unresolvedRequirements\":[],\"sequence\":[\"LOAD_LATEST_VERIFIED_DESIGN_AND_CURRENT_CANONICAL_UNITY_SOURCE\",\"TRACE_DESIGN_STATE_INPUT_OUTPUT_AND_DEPENDENCY_GRAPH\",\"RANK_UNRESOLVED_PLAYER_VALUE_GAPS_WITH_WEIGHTED_COVERAGE\",\"DIRECTLY_EDIT_EXISTING_RESPONSIBLE_UNITY_SCRIPTS_SCENES_PREFABS_AND_ASSET_BINDINGS\",\"RUN_EXISTING_FOCUSED_SOURCE_AND_PRESERVATION_QA\",\"FOLLOW_LOCKED_F0_THROUGH_F9_CANONICAL_WEBGL_VALIDATION\",\"REPLAY_REAL_WEBGL_MOBILE_TOUCH_STATE_REWARD_3D_SAVE_AND_INDEPENDENT_REGRESSION\",\"DIFF_AGAINST_PREVIOUS_MAIN_VERIFIED_UNITY_WEB_GROWTH_EVIDENCE\",\"REPAIR_FIRST_FAILED_CAUSAL_RESPONSIBILITY_OR_CONTINUE_NEXT_BUILD_UP\"],\"designItemsNeverCountAsImplementation\":true,\"sourceCandidatesNeverCountAsRuntimePass\":true,\"unlimitedGenerations\":true,\"existingF0F9SequencePreserved\":true,\"existingSaveBalanceEconomyNetworkAuthorityPreserved\":true},\"edgeStateMismatches\":[],\"nativeStateMappingSummary\":{\"authoredRoles\":4,\"mappedStaticCandidates\":0,\"unmappedRoles\":[\"MAIN\",\"A\",\"B\",\"@\"],\"edgeMismatches\":0,\"staticSourceMappingIsNotRuntimeParity\":true},\"creativeCBinding\":{\"themes\":[{\"name\":\"영웅서사의 이름과 평판\",\"gameplayEffect\":\"플레이어의 실제 행동보다 퍼진 이야기와 평판이 적·상점·세력의 규칙을 바꾼다. 그 결과 A와 B가 공유하는 조건이 바뀐다.\"},{\"name\":\"후원과 인맥 관계\",\"gameplayEffect\":\"관계망의 누구를 밀어주고 누구에게 빚지는지가 능력과 콘텐츠 접근을 결정한다. 그 결과 사건의 비용과 다음 선택이 달라진다.\"}],\"genres\":[{\"role\":\"PRIMARY\",\"name\":\"생활\",\"gameplayEffect\":\"사회관계 선택와 생활 공간 탐색를 통한 중심 목표와 위험·보상을 판단한다.\"},{\"role\":\"SECONDARY\",\"name\":\"추리\",\"gameplayEffect\":\"영웅서사의 이름과 평판의 단서와 후원과 인맥 관계의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다.\"}],\"genreInterlock\":\"생활 장르의 주 목표를 진행하는 동안 추리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 추리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.\",\"abGameplayEffect\":\"신화 속 트릭스터의 질서 역전에 의해 바뀐 인물·지역의 상태는 순교와 집단 결속의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 영웅서사의 이름과 평판와 후원과 인맥 관계가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 그 결과 생활 공간 탐색의 가능 행동과 위험이 바뀌며, 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 다시 사회관계 선택의 조건을 바꾼다.\",\"designAuthored\":true,\"runtimeVerified\":false},\"observedGameCodeFiles\":[\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\",\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\"],\"executableCodeCandidateFiles\":[\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\",\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\"],\"gapReasons\":[\"DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:MAIN\",\"DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:A\",\"DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:B\",\"DESIGN_TO_CODE_STATE_KEYS_NOT_MAPPED:@\"],\"codingReviewState\":\"GAME_STAGE_LOCAL_REPAIR_REQUIRED\",\"sourceImplementationPassed\":false,\"actualTwoClientPassed\":false,\"actualWebglRenderPassed\":false,\"independentQaPassed\":false,\"stageLocalAction\":\"IMPLEMENT_IN_EXISTING_GAME_SOURCE_THEN_VALIDATE_WITH_EXISTING_F0_TO_F9_AND_PLATFORM_RUNTIME\",\"schemaAndMarkersAloneCannotPass\":true,\"newPipeline\":false,\"changesDevelopmentAdmission\":false,\"saveBalanceAndExistingMultiplayerMeaningPreserved\":true}\nUNITY_WEB_NATIVE_DEVELOPMENT_ALGORITHMS: {\"algorithms\":[\"DEPENDENCY_GRAPH_KAHN_TOPOLOGICAL_ORDER\",\"WEIGHTED_GREEDY_SET_COVER_FOR_RESPONSIBLE_SOURCE_FILES\",\"PREVIOUS_VERIFIED_RUNTIME_DIFFERENTIAL_GROWTH\"],\"designRequirements\":20,\"packageCount\":2,\"unresolved\":[],\"implementationVerified\":false,\"runtimeVerified\":false}\nCODING_IMPLEMENTATION_VERDICT: SOURCE_OWNER_CANDIDATES_ONLY. Do not mark a MAIN/A/B/C/@ role, native platform, multiplayer session or 2.5D graphics PASS from design fields or a source marker. Implement and independently replay actual input→authoritative state→result→reconnect, then rerun existing platform QA.\nMULTIPLAYER_IMPLEMENTATION: {\"required\":true,\"policyVersion\":1,\"developmentAdmissionGate\":false,\"missingImplementationAction\":\"EXISTING_BUILD_UP_LOCAL_IMPLEMENTATION_AND_RETRY\",\"otherGamesAndIndependentWorkContinue\":true,\"actualMultiplayerPlayVerified\":false,\"completionEvidence\":\"ACTUAL_TWO_OR_MORE_CLIENTS_SAME_SESSION_ACTION_STATE_RESULT_AND_RECONNECT\"}\n전 게임 멀티 필수: 기존 서버 권한·클라이언트 입력/동기화 책임 소스에서 접속·참가·준비·시작·이탈·재접속과 목표·승패·보상 일치를 구현한다. 로컬 시뮬레이션이나 플래그만으로 구현 완료라 하지 않는다. 빠진 구현은 기존 BUILD_UP에서 계속 수정·재시도하며 다른 게임과 독립 작업은 계속 진행한다. 실제 2인 이상 같은 세션의 증거를 별도로 남긴다.\nIDENTITY_ONE_LINE_FANTASY: 몬스터 어드벤처의 플레이어는 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.을 결정하고 두 소재가 만드는 반작용을 책임진다.\nIDENTITY_REPRESENTATIVE_ACTION: Start immediately with simple one-thumb tap or swipe input and a clear score, distance, or short-session goal.\nIDENTITY_REPRESENTATIVE_CHOICE: 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다.\nIDENTITY_SIGNATURE_WORLD_RULE: RouteState의 결과를 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 입력으로 전달해 대응 비용과 다음 선택이 변한다.\nIDENTITY_SIGNATURE_SYSTEMS: 몬스터 어드벤처,사회관계 선택 × 신화 속 트릭스터의 질서 역전,생활 공간 탐색 × 순교와 집단 결속,금기와 기회의 교차\nIDENTITY_GROWTH: 성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다.\nIDENTITY_THREE_SENTENCE_TEST: WHAT=몬스터 어드벤처. 신화 속 트릭스터의 질서 역전·순교와 집단 결속 생활. 몬스터 어드벤처에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전과 생활 공간 탐색 × 순교와 집단 결속이 서로 결과를 되돌려 바꾸며 생활·추리의 판단이 실제 세계 상태를 변화시킨다. | DIFFERENT=몬스터 어드벤처에서 마을 주민가 사회관계 선택와 생활 공간 탐색의 선택을 통해 신화 속 트릭스터의 질서 역전·순교와 집단 결속의 인과법칙을 바꾸는 생활 복합 게임에서 플레이어는 선택을 누적해 목적을 완수한다. 게임의 반복 목표와 세계의 접근 가능성을 상태로 관리한다. | GROWTH=성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다.\nIDENTITY_BUILD_UP_RULE: EACH_BUILD_UP_MUST_STRENGTHEN_OR_PRESERVE_THE_REPRESENTATIVE_ACTION_CHOICE_WORLD_RULE_SIGNATURE_SYSTEM_OR_GROWTH_IDENTITY; GENERIC_FEATURE_COUNT_DOES_NOT_COUNT\nCAUSAL_GRAMMAR_EVIDENCE: {\"worldRules\":[\"신화 속 트릭스터의 질서 역전에 의해 바뀐 인물·지역의 상태는 순교와 집단 결속의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다.\"],\"causalInspirations\":[{\"titleOrTradition\":\"WORLD_TRICKSTER_MYTH\",\"rightsBasis\":\"ABSTRACT_TECHNIQUE\",\"borrowedTechnique\":\"약자·광대·사기꾼이 규칙의 빈틈을 이용해 질서를 뒤집는다.\",\"transformation\":\"정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.의 구조만 독자적 인물·세계·상호작용으로 재해석한다.\"},{\"titleOrTradition\":\"RELIGION_POLITICAL_HISTORY_ARCHETYPE\",\"rightsBasis\":\"ABSTRACT_TECHNIQUE\",\"borrowedTechnique\":\"개인의 패배나 죽음이 집단의 결속과 운동을 강화할 수 있다.\",\"transformation\":\"특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다.의 구조만 독자적 인물·세계·상호작용으로 재해석한다.\"}],\"systemInterconnections\":[{\"fromId\":\"VIBE_MAIN\",\"toId\":\"VIBE_A\",\"stateKeys\":[\"RouteState\"],\"fromSystem\":\"몬스터 어드벤처\",\"toSystem\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"trigger\":\"사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 이후 다음 행동의 위험과 보상을 직접 선택한다. 때문에 RouteState가 변한 순간 다음 시스템이 반응한다.\",\"stateChange\":\"RouteState의 결과를 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 입력으로 전달해 대응 비용과 다음 선택이 변한다.\"},{\"fromId\":\"VIBE_A\",\"toId\":\"VIBE_B\",\"stateKeys\":[\"RiskState\"],\"fromSystem\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"toSystem\":\"생활 공간 탐색 × 순교와 집단 결속\",\"trigger\":\"인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 신화 속 트릭스터의 질서 역전의 제약을 감수할지 결정한다. 때문에 RiskState가 변한 순간 다음 시스템이 반응한다.\",\"stateChange\":\"RiskState의 결과를 생활 공간 탐색 × 순교와 집단 결속의 입력으로 전달해 대응 비용과 다음 선택이 변한다.\"},{\"fromId\":\"VIBE_B\",\"toId\":\"VIBE_A\",\"stateKeys\":[\"RouteState\"],\"fromSystem\":\"생활 공간 탐색 × 순교와 집단 결속\",\"toSystem\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"trigger\":\"이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 순교와 집단 결속의 반작용을 선택한다. 때문에 RouteState가 변한 순간 다음 시스템이 반응한다.\",\"stateChange\":\"RouteState의 결과를 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 입력으로 전달해 대응 비용과 다음 선택이 변한다.\"},{\"fromId\":\"VIBE_B\",\"toId\":\"VIBE_DELVE\",\"stateKeys\":[\"RouteState\"],\"fromSystem\":\"생활 공간 탐색 × 순교와 집단 결속\",\"toSystem\":\"금기와 기회의 교차\",\"trigger\":\"이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 순교와 집단 결속의 반작용을 선택한다. 때문에 RouteState가 변한 순간 다음 시스템이 반응한다.\",\"stateChange\":\"RouteState의 결과를 금기와 기회의 교차의 입력으로 전달해 대응 비용과 다음 선택이 변한다.\"},{\"fromId\":\"VIBE_DELVE\",\"toId\":\"VIBE_MAIN\",\"stateKeys\":[\"WorldAccessState\"],\"fromSystem\":\"금기와 기회의 교차\",\"toSystem\":\"몬스터 어드벤처\",\"trigger\":\"신화 속 트릭스터의 질서 역전의 제약과 순교와 집단 결속의 대응을 같은 지역에서 순서대로 시험한다. 실제 발견 결과에 따라 원래 목표로 돌아갈 방법을 선택한다. 때문에 WorldAccessState가 변한 순간 다음 시스템이 반응한다.\",\"stateChange\":\"WorldAccessState의 결과를 몬스터 어드벤처의 입력으로 전달해 대응 비용과 다음 선택이 변한다.\"},{\"fromId\":\"VIBE_A\",\"toId\":\"VIBE_DELVE\",\"stateKeys\":[\"RiskState\"],\"fromSystem\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"toSystem\":\"금기와 기회의 교차\",\"trigger\":\"인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 신화 속 트릭스터의 질서 역전의 제약을 감수할지 결정한다. 때문에 RiskState가 변한 순간 다음 시스템이 반응한다.\",\"stateChange\":\"RiskState의 결과를 금기와 기회의 교차의 입력으로 전달해 대응 비용과 다음 선택이 변한다.\"}],\"expansionPlan\":[{\"milestone\":\"초반 선택에 따른 접근 경로와 위험 재구성\",\"newGameplay\":\"사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.\",\"systemImpact\":\"이전 생활 공간 탐색 × 순교와 집단 결속 상태에 입력·피드백을 연결하고 저장 및 진행의 원래 의미를 유지한다.\"},{\"milestone\":\"중반 두 시스템의 반작용과 대응 조건 충돌\",\"newGameplay\":\"생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.\",\"systemImpact\":\"이전 사회관계 선택 × 신화 속 트릭스터의 질서 역전 상태에 입력·피드백을 연결하고 저장 및 진행의 원래 의미를 유지한다.\"},{\"milestone\":\"숨겨진 세계 인과법칙을 이용한 새로운 접근\",\"newGameplay\":\"영웅서사의 이름과 평판과 후원과 인맥 관계의 조합에 다른 인간 갈등을 연결한다. 숨겨진 규칙의 발견으로 우회 접근과 새로운 대응법을 연다.\",\"systemImpact\":\"이전 생활 공간 탐색 × 순교와 집단 결속 상태에 입력·피드백을 연결하고 저장 및 진행의 원래 의미를 유지한다.\"},{\"milestone\":\"누적된 관계를 되짚는 재방문과 장기 숙련\",\"newGameplay\":\"발견된 단서와 숙련을 기존 시스템 두 개 이상의 새로운 운용으로 확장한다. 재방문 시 이전 행동이 만든 관계·접근 조건과 결말을 다시 평가한다.\",\"systemImpact\":\"이전 사회관계 선택 × 신화 속 트릭스터의 질서 역전 상태에 입력·피드백을 연결하고 저장 및 진행의 원래 의미를 유지한다.\"}],\"integrityNotes\":[\"이 결과는 정해진 설계 규칙의 도달성 계산이며 실제 게임 실행 결과를 의미하지 않는다.\",\"저장·동기화·실제 조작은 기존 개발 및 독립 QA 과정에서 추가 검증해야 한다.\"],\"formula\":\"MAIN × A × B × C + @\",\"existingGameGrammarMap\":{\"mode\":\"EXISTING_GAME_RECONSTRUCTION_FROM_CURRENT_DESIGN_AND_INSPECTED_SOURCE\",\"formula\":\"MAIN × A × B × C + @\",\"main\":\"몬스터 어드벤처: 몬스터 어드벤처. 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.과 사회관계 선택의 결과를 생활 공간 탐색로 전환하고 달라진 조건을 다시 활용한다.를 반복하는 게임이다.\",\"source\":\"DESIGNER_AUTHORED_ROLE_IDS_AND_STATE_LINKS\",\"roleSystemIds\":{\"MAIN\":\"VIBE_MAIN\",\"A\":\"VIBE_A\",\"B\":\"VIBE_B\",\"c\":[],\"AT\":[\"VIBE_DELVE\"]},\"majorAxes\":[{\"key\":\"A\",\"systemId\":\"VIBE_A\",\"name\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"source\":\"DESIGNER_AUTHORED_ROLE_A\"},{\"key\":\"B\",\"systemId\":\"VIBE_B\",\"name\":\"생활 공간 탐색 × 순교와 집단 결속\",\"source\":\"DESIGNER_AUTHORED_ROLE_B\"}],\"cSubElements\":[],\"sourcedAxes\":{\"A\":{\"system\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"material\":\"신화 속 트릭스터의 질서 역전\",\"materialDomain\":\"world trickster myth의 문화·역사 인과 소재\",\"stateChange\":\"정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 따라서 사회관계 선택의 경로와 비용이 바뀐다. 플레이어가 사회관계 선택을 선택하면 신화 속 트릭스터의 질서 역전의 규칙에 따라 다음 위험과 가능 행동이 변화한다. 그 결과 생활 공간 탐색 × 순교와 집단 결속의 다음 행동 조건이 달라진다.\"},\"B\":{\"system\":\"생활 공간 탐색 × 순교와 집단 결속\",\"material\":\"순교와 집단 결속\",\"materialDomain\":\"religion political history archetype의 문화·역사 인과 소재\",\"stateChange\":\"특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 따라서 생활 공간 탐색의 정보·대응이 바뀐다. 플레이어가 생활 공간 탐색을 선택하면 순교와 집단 결속의 규칙에 따라 처음 선택으로 되돌아갈 비용·정보·접근 조건이 변화한다. 그 결과 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 선택 비용과 경로가 달라진다.\"}},\"cGenreThemes\":[{\"name\":\"영웅서사의 이름과 평판\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"플레이어의 실제 행동보다 퍼진 이야기와 평판이 적·상점·세력의 규칙을 바꾼다. 그 결과 A와 B가 공유하는 조건이 바뀐다.\"},{\"name\":\"후원과 인맥 관계\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"관계망의 누구를 밀어주고 누구에게 빚지는지가 능력과 콘텐츠 접근을 결정한다. 그 결과 사건의 비용과 다음 선택이 달라진다.\"}],\"cPrimarySecondaryGenres\":[{\"role\":\"PRIMARY\",\"name\":\"생활\",\"gameplayEffect\":\"사회관계 선택와 생활 공간 탐색를 통한 중심 목표와 위험·보상을 판단한다.\"},{\"role\":\"SECONDARY\",\"name\":\"추리\",\"gameplayEffect\":\"영웅서사의 이름과 평판의 단서와 후원과 인맥 관계의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다.\"}],\"cGenreInterlock\":\"생활 장르의 주 목표를 진행하는 동안 추리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 추리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.\",\"cCausalWorldEffect\":\"신화 속 트릭스터의 질서 역전에 의해 바뀐 인물·지역의 상태는 순교와 집단 결속의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 영웅서사의 이름과 평판와 후원과 인맥 관계가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 그 결과 생활 공간 탐색의 가능 행동과 위험이 바뀌며, 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 다시 사회관계 선택의 조건을 바꾼다.\",\"atUnboundedGrowthRule\":\"금기와 기회의 교차 이후 새로운 발견은 A와 B, C 장르 반응의 서로 다른 조건을 실험해 새 길·정보·관계·숙련을 열고 제한 없이 깊어진다.\",\"delveAtEvidence\":[\"금기와 기회의 교차: 약자·광대·사기꾼이 규칙의 빈틈을 이용해 질서를 뒤집는다. 상황을 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 방식으로 해석한다.\",\"되돌아온 선택: 개인의 패배나 죽음이 집단의 결속과 운동을 강화할 수 있다. 결과가 과거 선택의 의미를 바꿀 수 있음을 발견한다.\",\"두 소재의 숨은 규칙: 실제 힘과 별개로 이름·소문·평판이 타인의 행동을 결정한다. 원리와 개인의 힘보다 후원·인맥·은혜·빚의 연결망이 행동 가능성을 만든다. 원리가 동시에 작동함을 파악한다.\",\"역전된 종착점: 한쪽의 불리한 결과가 다른 쪽의 고급 활용 조건이 되는 인과 반전을 학습한다.\",\"금기와 기회의 교차\",\"초반 선택에 따른 접근 경로와 위험 재구성\",\"사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.\",\"중반 두 시스템의 반작용과 대응 조건 충돌\",\"생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.\",\"숨겨진 세계 인과법칙을 이용한 새로운 접근\"],\"sourceTreeFingerprint\":\"ae67ed5e88c16ca5614f0a1c8b14c7897a27a06eea255302ce23e190cdc59eaf\",\"rule\":\"MAIN_IS_GAME_TOPIC; A_AND_B_EACH_REQUIRE_SYSTEM_AND_SOURCE_MATERIAL; C_HAS_TWO_CREATIVE_MATERIALS_AND_PRIMARY_SECONDARY_DISTINCT_GENRES_WITH_GAMEPLAY_INTERLOCK; A_B_CAUSAL_PLAY_CHANGES_WORLD_STORY; @ IS_UNBOUNDED_DISCOVERY_MASTERY_AND_REVISIT\",\"identityRewriteRequired\":false,\"existingBalanceSaveEconomyAndAuthorityPreserved\":true},\"rule\":\"NEW_CONTENT_MUST_DEEPEN_MAIN_TOPIC_A_B_SOURCED_SYSTEMS_C_CREATIVE_THEMES_AND_PRIMARY_SECONDARY_GENRE_INTERLOCK; OPTIONAL_LEGACY_c_IS_NOT_C_OR_A_MAJOR_AXIS; @ IS_DELVE_LAYER; DECORATIVE_LORE_OR_PARALLEL_FEATURE_STACK_DOES_NOT_COUNT\",\"familiarHumanConflictShouldRemainReadable\":true}\nCAUSAL_GRAMMAR_BUILD_UP_RULE: NEW_CONTENT_MUST_DEEPEN_MAIN_TOPIC_A_B_SOURCED_SYSTEMS_C_CREATIVE_THEMES_AND_PRIMARY_SECONDARY_GENRE_INTERLOCK; OPTIONAL_LEGACY_c_IS_NOT_C_OR_A_MAJOR_AXIS; @ IS_DELVE_LAYER; DECORATIVE_LORE_OR_PARALLEL_FEATURE_STACK_DOES_NOT_COUNT\nEXISTING_GAME_MAIN_A_B_c_AT_MAP: {\"mode\":\"EXISTING_GAME_RECONSTRUCTION_FROM_CURRENT_DESIGN_AND_INSPECTED_SOURCE\",\"formula\":\"MAIN × A × B × C + @\",\"main\":\"몬스터 어드벤처: 몬스터 어드벤처. 사회관계 선택: 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.과 사회관계 선택의 결과를 생활 공간 탐색로 전환하고 달라진 조건을 다시 활용한다.를 반복하는 게임이다.\",\"source\":\"DESIGNER_AUTHORED_ROLE_IDS_AND_STATE_LINKS\",\"roleSystemIds\":{\"MAIN\":\"VIBE_MAIN\",\"A\":\"VIBE_A\",\"B\":\"VIBE_B\",\"c\":[],\"AT\":[\"VIBE_DELVE\"]},\"majorAxes\":[{\"key\":\"A\",\"systemId\":\"VIBE_A\",\"name\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"source\":\"DESIGNER_AUTHORED_ROLE_A\"},{\"key\":\"B\",\"systemId\":\"VIBE_B\",\"name\":\"생활 공간 탐색 × 순교와 집단 결속\",\"source\":\"DESIGNER_AUTHORED_ROLE_B\"}],\"cSubElements\":[],\"sourcedAxes\":{\"A\":{\"system\":\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"material\":\"신화 속 트릭스터의 질서 역전\",\"materialDomain\":\"world trickster myth의 문화·역사 인과 소재\",\"stateChange\":\"정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 따라서 사회관계 선택의 경로와 비용이 바뀐다. 플레이어가 사회관계 선택을 선택하면 신화 속 트릭스터의 질서 역전의 규칙에 따라 다음 위험과 가능 행동이 변화한다. 그 결과 생활 공간 탐색 × 순교와 집단 결속의 다음 행동 조건이 달라진다.\"},\"B\":{\"system\":\"생활 공간 탐색 × 순교와 집단 결속\",\"material\":\"순교와 집단 결속\",\"materialDomain\":\"religion political history archetype의 문화·역사 인과 소재\",\"stateChange\":\"특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 따라서 생활 공간 탐색의 정보·대응이 바뀐다. 플레이어가 생활 공간 탐색을 선택하면 순교와 집단 결속의 규칙에 따라 처음 선택으로 되돌아갈 비용·정보·접근 조건이 변화한다. 그 결과 사회관계 선택 × 신화 속 트릭스터의 질서 역전의 선택 비용과 경로가 달라진다.\"}},\"cGenreThemes\":[{\"name\":\"영웅서사의 이름과 평판\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"플레이어의 실제 행동보다 퍼진 이야기와 평판이 적·상점·세력의 규칙을 바꾼다. 그 결과 A와 B가 공유하는 조건이 바뀐다.\"},{\"name\":\"후원과 인맥 관계\",\"kind\":\"MATERIAL\",\"gameplayEffect\":\"관계망의 누구를 밀어주고 누구에게 빚지는지가 능력과 콘텐츠 접근을 결정한다. 그 결과 사건의 비용과 다음 선택이 달라진다.\"}],\"cPrimarySecondaryGenres\":[{\"role\":\"PRIMARY\",\"name\":\"생활\",\"gameplayEffect\":\"사회관계 선택와 생활 공간 탐색를 통한 중심 목표와 위험·보상을 판단한다.\"},{\"role\":\"SECONDARY\",\"name\":\"추리\",\"gameplayEffect\":\"영웅서사의 이름과 평판의 단서와 후원과 인맥 관계의 반응 때문에 같은 목표의 정보·행동·결과가 달라진다.\"}],\"cGenreInterlock\":\"생활 장르의 주 목표를 진행하는 동안 추리 장르의 판단 때문에 정보·접근 비용과 다음 선택이 달라진다. 추리를 제거하면 같은 경로를 선택해도 인물 반응과 결과가 달라진다.\",\"cCausalWorldEffect\":\"신화 속 트릭스터의 질서 역전에 의해 바뀐 인물·지역의 상태는 순교와 집단 결속의 선택으로 되돌아오며 다음 사건의 입장 조건을 결정한다. 영웅서사의 이름과 평판와 후원과 인맥 관계가 충돌하면 지역의 접근·인물의 입장과 목표가 갱신된다. 인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 그 결과 생활 공간 탐색의 가능 행동과 위험이 바뀌며, 이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 다시 사회관계 선택의 조건을 바꾼다.\",\"atUnboundedGrowthRule\":\"금기와 기회의 교차 이후 새로운 발견은 A와 B, C 장르 반응의 서로 다른 조건을 실험해 새 길·정보·관계·숙련을 열고 제한 없이 깊어진다.\",\"delveAtEvidence\":[\"금기와 기회의 교차: 약자·광대·사기꾼이 규칙의 빈틈을 이용해 질서를 뒤집는다. 상황을 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 방식으로 해석한다.\",\"되돌아온 선택: 개인의 패배나 죽음이 집단의 결속과 운동을 강화할 수 있다. 결과가 과거 선택의 의미를 바꿀 수 있음을 발견한다.\",\"두 소재의 숨은 규칙: 실제 힘과 별개로 이름·소문·평판이 타인의 행동을 결정한다. 원리와 개인의 힘보다 후원·인맥·은혜·빚의 연결망이 행동 가능성을 만든다. 원리가 동시에 작동함을 파악한다.\",\"역전된 종착점: 한쪽의 불리한 결과가 다른 쪽의 고급 활용 조건이 되는 인과 반전을 학습한다.\",\"금기와 기회의 교차\",\"초반 선택에 따른 접근 경로와 위험 재구성\",\"사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 첫 진입에서는 위험을 읽고 다음 행동에 필요한 단서를 얻는다.\",\"중반 두 시스템의 반작용과 대응 조건 충돌\",\"생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다. 중간 갈등에서는 서로 다른 대가를 비교해 반대 선택을 실험한다.\",\"숨겨진 세계 인과법칙을 이용한 새로운 접근\"],\"sourceTreeFingerprint\":\"ae67ed5e88c16ca5614f0a1c8b14c7897a27a06eea255302ce23e190cdc59eaf\",\"rule\":\"MAIN_IS_GAME_TOPIC; A_AND_B_EACH_REQUIRE_SYSTEM_AND_SOURCE_MATERIAL; C_HAS_TWO_CREATIVE_MATERIALS_AND_PRIMARY_SECONDARY_DISTINCT_GENRES_WITH_GAMEPLAY_INTERLOCK; A_B_CAUSAL_PLAY_CHANGES_WORLD_STORY; @ IS_UNBOUNDED_DISCOVERY_MASTERY_AND_REVISIT\",\"identityRewriteRequired\":false,\"existingBalanceSaveEconomyAndAuthorityPreserved\":true}\nEXISTING_GAME_GRAMMAR_ACTION: 과거 MAIN 소재뿐인 설계를 정식 설계로 보존하지 않는다. 현재 실행 게임의 실제 행동·저장·밸런스·권한을 읽고 MAIN 게임 정체성, A/B 각각 시스템×창작 소재, C 두 소재와 메인·보조 장르, @ 발견·숙련을 새로 설계해 서로 실제 상태를 바꾸게 한다. 설계 문서만으로 구현 완료나 런타임 PASS를 인정하지 않는다.\nPRIMARY_GOAL: 몬스터 어드벤처. 신화 속 트릭스터의 질서 역전·순교와 집단 결속 생활. 몬스터 어드벤처에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전과 생활 공간 탐색 × 순교와 집단 결속이 서로 결과를 되돌려 바꾸며 생활·추리의 판단이 실제 세계 상태를 변화시킨다.의 몬스터 어드벤처와 사회관계 선택 × 신화 속 트릭스터의 질서 역전가 캐릭터·적·환경·모션·VFX·카메라·UI 전체에서 한눈에 구별되도록 비주얼 정체성을 높인다.\nWHY_NOW: 현재 검증 신호와 소스에서 PRESENTATION를 우선한다. 게임 고유 앵커는 \"몬스터 어드벤처\", 현재 책임 소스는 unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::LoadState, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::BuildWeb, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::Build, unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::LogState, unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::BuildWorld, unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs::StartGameplay, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::UnityWebFloorBuild, unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs::BindModel이며 실제 source delta와 효과 증거가 다음 결정을 좌우한다.\nUNITY_PRODUCTION_CONCEPT={\"genre\":\"DESIGN_DEFINED\",\"identity\":\"몬스터 어드벤처. 신화 속 트릭스터의 질서 역전·순교와 집단 결속 생활. 몬스터 어드벤처에서 사회관계 선택 × 신화 속 트릭스터의 질서 역전과 생활 공간 탐색 × 순교와 집단 결속이 서로 결과를 되돌려 바꾸며 생활·추리의 판단이 실제 세계 상태를 변화시킨다.\",\"mode\":\"EXISTING_PLAY_PRESENTATION\",\"coreAction\":\"Start immediately with simple one-thumb tap or swipe input and a clear score, distance, or short-session goal.\"}\nUNITY_PRODUCTION_IDEA={\"id\":\"DESIGN_DEFINED:PLAY_READABILITY\",\"implementation\":\"현재 핵심 행동과 결과가 월드·모션·터치 UI에서 명확하게 읽히도록 연결한다.\",\"distinction\":\"판정·보상·저장 규칙은 유지하고 표현만 개선한다.\"}\nUNITY_PRODUCTION_CONNECTION={\"flow\":\"기존 행동 → 상태별 표현/입력 피드백\",\"coreLoop\":[\"Start immediately with simple one-thumb tap or swipe input and a clear score, distance, or short-session goal.\",\"Play a brief run with readable feedback, collect rewards, and make a small risk or route choice before the run ends.\",\"Finish or fail, receive a score or reward, unlock a small progression benefit, and retry quickly with minimal friction.\"],\"systems\":[\"몬스터 어드벤처\",\"사회관계 선택 × 신화 속 트릭스터의 질서 역전\",\"생활 공간 탐색 × 순교와 집단 결속\",\"금기와 기회의 교차\"],\"nextGoal\":\"성장하면 과거의 선택을 재해석하고 새로운 우회 경로·관계·숙련 조합을 연다. 사회관계 선택의 새로운 지역에서 이전 인과 선택을 다시 해석한다. 생활 공간 탐색의 새 상대는 기존 상태를 증폭하거나 반전한다.\"}\nUNITY_PRODUCTION_FILES=[{\"role\":\"GAMEPLAY_STATE\",\"files\":[\"unity-games/monster-adventure/Assets/Scripts/GameCore.cs\",\"unity-games/monster-adventure/Assets/Scripts/RuntimeBootstrap.cs\",\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\",\"unity-games/monster-adventure/Assets/Editor/UnityWebFloorBuild.cs\"],\"implementation\":\"이 파일의 기존 입력·렌더·모션·UI 책임 블록만 개선하고 게임 상태·보상·저장 의미는 유지한다.\"},{\"role\":\"CLIENT_PRESENTATION\",\"files\":[\"unity-games/monster-adventure/Assets/Materials/LibrarySurface.shader\"],\"implementation\":\"이 파일의 기존 입력·렌더·모션·UI 책임 블록만 개선하고 게임 상태·보상·저장 의미는 유지한다.\"}]\nUNITY_PRODUCTION_LIBRARY_MATCH={\"firstPartyLibraryCount\":37,\"candidates\":[{\"id\":\"ANIMATION_STATE\",\"library\":\"assets/animation-state.js\",\"sourceFiles\":[\"unity-games/monster-adventure/Assets/Scripts/UnityWebFloorGame.cs\"],\"status\":\"SOURCE_SIGNAL_MATCH_UNVERIFIED\",\"matchEvidence\":{\"design\":true,\"source\":true},\"optional\":true,\"firstParty\":t