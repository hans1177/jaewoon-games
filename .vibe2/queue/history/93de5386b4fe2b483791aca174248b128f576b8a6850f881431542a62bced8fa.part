 캐릭터·적·환경·모션·VFX·카메라·UI 전체에서 한눈에 구별되도록 비주얼 정체성을 높인다.","lastAchievedGoal":null,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","buildUpNextAction":"REQUEST_REQUIRED_RUNTIME_OBSERVATION","buildUpNextActionReason":"effect cannot be promoted until relevant runtime or deterministic gameplay evidence is observed","nextEscalationRequired":true,"companyContext":null,"sourceRoot":"unity-games/monster-adventure","speculativeEligible":true,"estimatedRisk":"high","atomicNeuronMode":"PER_TASK_MICRO_FANIN","atomicCompletionRequired":true,"taskWorkUnits":6,"packageId":"monster-adventure-wp-1uwnwd6","packageGoal":"몬스터 어드벤처: 관련 구현·품질 개선을 기능 단위로 묶어 끝까지 완료한다.","packageRole":"implementation-owner","packageOwner":"feature-owner:monster-adventure","packageWorkUnits":6,"packageSize":1,"packageMinWorkUnits":6,"packageLongWorkProtected":true,"focusedCaretaker":false,"caretakerStickyOwnership":false,"focusCompletionContract":null,"postReleaseFocused":false,"historicalDeploymentRecovery":false,"focusCycle":0,"focusPolicyRef":null,"recoveryGeneration":0,"systemSteward":false,"ownerFocusedCaretaker":false,"packageContext":{"explorationMode":"task-local-exploration-handoff","explorationRequired":true,"sharedPreparation":false,"sourceRoot":"unity-games/monster-adventure","responsibleFiles":["unity-games/monster-adventure/Assets/Scripts/GameCore.cs","unity-games/monster-adventure/Assets/Scripts/RuntimeBootstrap.cs"],"diagnosticEvidence":[],"roles":{"owner":"work-package-owner","exploration":"read-only-exploration-worker","implementation":"parallel-implementation-workers","test":"incremental-qa-worker","performance":"performance-sanity-worker","regression":"single-fan-in-regression-worker","review":"fan-in-package-review-worker"},"studioQualityEvolution":null},"studioQualityEvolution":null,"completionCriteria":["task-local-exploration-handoff-produced-and-reused","functional-scope-implemented","all-package-task-incremental-qa-pass","performance-sanity-pass","full-core-regression-on