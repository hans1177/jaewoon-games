SPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"VARIETY_REGIONS[0]","family":"VARIETY_REGIONS","index":0,"title":"신화 속 트릭스터의 질서 역전의 첫 선택 공간","authoredId":"VIBE_ORIGIN","designDetail":{"id":"VIBE_ORIGIN","ruleIds":["VIBE_MAIN","VIBE_A"],"name":"신화 속 트릭스터의 질서 역전의 첫 선택 공간","traversal":"인물과 대상의 요청 가운데 우선순위를 결정하면서 정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다.를 시작하는 출발 위치와 복귀 동선을 제공한다.","riskReward":"안전한 진행을 선택하면 발견 속도가 늦어지고 어려운 경로에서는 다른 단서를 얻는다.","landmark":"신화 속 트릭스터의 질서 역전의 변화가 드러나는 고유 랜드마크를 첫 진입 때 표시한다.","encounterPattern":"정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 따라서 사회관계 선택의 경로와 비용이 바뀐다. 결과를 읽고 위험·정보 반응이 변화한다.","resourcePressure":"선택 결과에 따른 자원 접근 가능성과 기회비용을 분리해 보여준다.","storyContext":"신화 속 트릭스터의 질서 역전의 흔적이 남은 지역은 순교와 집단 결속의 선택에 따라 새로운 출입·보상 조건을 갖는다."},"playerChoice":"안전한 진행을 선택하면 발견 속도가 늦어지고 어려운 경로에서는 다른 단서를 얻는다.","trigger":"정면 승리보다 규칙 해석·오용·역이용이 핵심 능력이 된다. 따라서 사회관계 선택의 경로와 비용이 바뀐다. 결과를 읽고 위험·정보 반응이 변화한다.","stateChange":null,"linkedRuleIds":["VIBE_MAIN","VIBE_A"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["NATIVE_3D_REGION_ENTRY_EXIT_AND_ROUTE_REACHABLE","TRAVERSAL_LANDMARK_RISK_RESOURCE_AND_ENCOUNTER_ROLES_DISTINCT","DISCOVERY_NEXT_OBJECTIVE_AND_RETURN_REASON_CONNECTED"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 신화 속 트릭스터의 질서 역전의 첫 선택 공간 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"VARIETY_REGIONS[1]","family":"VARIETY_REGIONS","index":1,"title":"순교와 집단 결속의 되돌림 공간","authoredId":"VIBE_REVISIT","designDetail":{"id":"VIBE_REVISIT","ruleIds":["VIBE_B","VIBE_DELVE"],"name":"순교와 집단 결속의 되돌림 공간","traversal":"이전 관계의 결과로 열린 장소와 상호작용을 탐색하면서 특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다.의 결과가 이전 구역의 통로를 열거나 닫는다.","riskReward":"이전 상태를 역이용한 고급 대응은 짧은 경로와 추가 위험 중 하나를 선택하게 한다.","landmark":"순교와 집단 결속의 반작용과 발견 단서를 시각적으로 구분한다.","encounterPattern":"특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 따라서 생활 공간 탐색의 정보·대응이 바뀐다. 결과를 기준으로 다른 대응법을 요구한다.","resourcePressure":"처음 얻은 자원을 유지할지 새로운 접근에 재투자할지 기회비용을 제시한다.","storyContext":"관계의 갈등이 플레이어의 실제 선택을 통해 해결되거나 심화되고, 그 결과가 다음 사건의 원인이 된다."},"playerChoice":"이전 상태를 역이용한 고급 대응은 짧은 경로와 추가 위험 중 하나를 선택하게 한다.","trigger":"특정 실패가 즉시 손실이면서 동시에 새로운 세력·능력·위기를 생성한다. 따라서 생활 공간 탐색의 정보·대응이 바뀐다. 결과를 기준으로 다른 대응법을 요구한다.","stateChange":null,"linkedRuleIds":["VIBE_B","VIBE_DELVE"],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["NATIVE_3D_REGION_ENTRY_EXIT_AND_ROUTE_REACHABLE","TRAVERSAL_LANDMARK_RISK_RESOURCE_AND_ENCOUNTER_ROLES_DISTINCT","DISCOVERY_NEXT_OBJECTIVE_AND_RETURN_REASON_CONNECTED"],"buildUpStatus":"AUTHORED_REQUIREMENTS_NOT_YET_NATIVE_IMPLEMENTATION_VERIFIED","observableAcceptance":"실제 순교와 집단 결속의 되돌림 공간 입력/조건→권위 상태 변화→피드백→다음 선택의 정상·실패·재시도 경로를 검증","requiredStages":["INSPECT_EXISTING_RESPONSIBLE_FUNCTION","IMPLEMENT_AUTHORED_BEHAVIOR_AND_CONNECTED_STATE","VERIFY_ACTUAL_PLAYER_ACTION_AND_RESULT","REPLAY_PLATFORM_QA_SAVE_AND_RUNTIME"]},{"ref":"NARRATIVE_QUESTSTATES[0]","family":"NARRATIVE_QUESTSTATES","index":0,"title":"이전 선택 조건을 확인한다.","authoredId":null,"designDetail":{"step":"이전 선택 조건을 확인한다."},"playerChoice":null,"trigger":null,"stateChange":null,"linkedRuleIds":[],"designResponsibleSystem":null,"sourceCandidates":[],"sourceEvidenceState":"EXACT_SOURCE_OWNER_REVIEW_REQUIRED","implementationVerified":false,"runtimeVerified":false,"designReviewNeeded":[],"requiredBehavior":["STORY_BEAT_OR_QUEST_STATE_TRIGGERED_BY_REAL_GAME_ACTION","WORLD_OR_OBJECTIVE