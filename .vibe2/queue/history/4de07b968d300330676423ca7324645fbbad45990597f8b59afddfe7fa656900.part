llowed%22%3Afalse%2C%22automaticLearningAllowed%22%3Afalse%2C%22authorityPromotionAllowed%22%3Afalse%7D"],"lastOutcome":"CANCELLED_BY_CENTRAL_PRODUCTION_AUTHORITY","reservationId":null,"reservationRunId":null,"reservationRunAttempt":0,"reservedAt":null,"neuronExpectedVariants":0,"neuronResults":[],"runtimeEvidenceCandidate":null,"buildUpDirective":{"version":2,"directiveId":"bug-defense-build-up-g2-5882b75fb5e0","directiveFingerprint":"5882b75fb5e01175f1ecd362a41b88f4dceb53fd44f9c2268bfaa51cabccfd33","previousDirectiveFingerprint":"3efedd5f8a16134033d9091254a4f8b1ecd3e265c76982deb472a69e410a2238","forbiddenRepeatFingerprint":"3efedd5f8a16134033d9091254a4f8b1ecd3e265c76982deb472a69e410a2238","gameId":"bug-defense","gameName":"곤충 디펜스","generation":2,"developmentDepth":1,"escalationStage":"FOUNDATION_COMPLETENESS","escalationMode":"CONTINUE_UNVERIFIED_DEPTH","previousDirectiveOutcome":"cancelled","designContextMode":"APPROVED_OR_MINIMUM_DESIGN","platform":"WEB","sourceRoot":"unity-games/bug-defense","sourceTreeFingerprint":"4d9f1c58b157a817b79e95a94740728a3e1415b7f832e2c6c9f0dcbeb443d7fe","designFingerprint":"dc0d3a88bdb8dc41fc2458176ef52aa3e64af9da727e556a5b5d17d09aa6d393","gameIdentityAndNonNegotiables":{"identity":"곤충 디펜스는 생태계의 먹이사슬과 곤충의 고유한 생물학적 특성을 전략적 상성으로 치환한 하드코어 타워 디펜스 게임입니다. 플레이어는 정원이라는 제한된 공간에서 침입하는 해충 군단을 막기 위해 포식자 곤충을 배치하며, 각 곤충의 공격 방식과 환경 상성을 고려한 배치 선택이 게임의 핵심 상태 변화를 주도합니다. 기존 디펜스 게임의 단순 수치 싸움을 넘어, 곤충의 서식지 적응도와 포식 패턴이라는 시그니처 시스템을 통해 매 웨이브마다 완전히 다른 전략적 선택을 강제하는 독자적인 정체성을 구축합니다.","coreFun":"곤충의 공격 속성(독, 물리, 범위)과 적의 방어 속성(갑각, 비행, 군집)을 실시간으로 관찰하고, 가장 효율적인 포식자를 배치하여 적을 무력화하는 즉각적인 전략적 쾌감을 제공합니다. 배치 후 적이 상성에 따라 녹아내리는 시각적 피드백이 핵심 재미입니다.","coreLoop":["웨이브 시작 전 적의 침입 경로와 곤충 유형을 분석하여 방어 전략을 수립합니다.","보유한 자원을 사용하여 최적의 위치에 포식자 곤충을 배치하거나 기존 곤충을 진화시킵니다.","실시간 전투를 관찰하며 적의 돌파 시도에 대응해 스킬을 사용하거나 배치를 수정합니다.","웨이브 종료 후 획득한 자원으로 곤충의 생태적 특성을 강화하고 다음 웨이브를 준비합니다."],"signatureSystems":[{"name":"생태 상성 시스템","purpose":"곤충 간의 먹이사슬 관계를 게임 내 공격/방어 상성으로 구현하여 단순한 화력 집중이 아닌 전략적 배치를 유도합니다.","playerChoice":"플레이어는 적의 속성에 맞춰 특정 곤충을 배치할지, 아니면 범용적인 곤충을 다수 배치할지 결정해야 하며, 이 선택이 웨이브의 성공 여부를 결정합니다."},{"name":"서식지 적응 시스템","purpose":"배치된 위치의 환경(잎, 줄기, 꽃)에 따라 곤충의 공격력이나 사거리가 변화하는 시스템으로 지형 활용의 중요성을 극대화합니다.","playerChoice":"플레이어는 곤충의 고유 능력과 지형 보너스를 결합하여 최적의 효율을 내는 위치를 선정해야 하며, 이는 고정된 타워 배치를 방지합니다."}],"progressionDirection":"초반에는 단순한 해충을 막으며 기본 상성을 익히고, 중반부터는 복합 속성을 가진 보스급 해충이 등장하여 기존 배치를 재조정하게 만듭니다. 후반부에는 곤충의 진화 트리를 통해 플레이어만의 특화된 방어 라인을 구축하는 성장을 지향합니다.","multiplayerMode":"SINGLE","preserve":["CORE_IDENTITY","APPROVED_RULE_SEMANTICS","BALANCE_VALUES_UNLESS_AUTHORIZED","ECONOMY_MEANING_UNLESS_AUTHORIZED","SAVE_MEANING","NETWORK_AUTHORITY"]},"currentImplementationFindings":{"sourceObservations":["CURRENT_SOURCE_FILES=6","PLACEHOLDER_OR_PRIMITIVE_USAGE_HIGH","GAME_FEEL_SPARSE","VFX_IMPLEMENTATION_SPARSE","AUDIO_IMPLEMENTATION_SPARSE","UI_MENU_FLOW_SPARSE","PERFORMANCE_BUDGET_SPARSE"],"signals":{"combat":12,"progression":24,"ai":18,"save":25,"multiplayer":0,"animation":2,"motionStates":16,"gameFeel":0,"vfx":0,"camera":8,"audio":0,"audioDynamics":0,"ui":5,"uiFlow":5,"entryFlow":4,"loadingFlow":0,"input":7,"map":14,"landmark":4,"interaction":3,"inventory":0,"equipment":10,"settings":12,"feedback":5,"session":10,"content":14,"choice":41,"connection":0,"performance":0,"lighting":6,"primitive":13,"todo":0,"errorRecovery":0},"topFiles":[{"file":"unity-games/bug-defense/Assets/Scripts/UnityWebFloorGame.cs","score":86},{"file":"unity-games/bug-defense/Assets/Editor/UnityWebFloorBuild.cs","score":60},{"file":"unity-games/bug-defense/Assets/Art/unity-web-floor-domain.json","score":2},{"file":"unity-games/bug-defense/Assets/Animations/unity-web-floor-domain.json","score":1},{"file":"unity-games/bug-defense/Assets/Materials/unity-web-floor-domain.json","score":0},{"file":"unity-games/bug-defense/Assets/Prefabs/unity-web-floor-domain.json","score":0}],"sourceAnchors":[{"file":"unity-games/bug-defense/Assets/Scripts/UnityWebFloorGame.cs","line":142,"kind":"METHOD","symbol":"LoadState","