{
  "name": "seed-roblox-simulator-tycoon-i-adopt-me",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "shared"
      }
    },
    "ServerScriptService": {
      "GameServer": {
        "$path": "server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "GameClient": {
          "$path": "client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Voxel",
        "LightingStyle": "Soft",
        "PrioritizeLightingQuality": false
      },
      "CompatibilityToneMap": {
        "$className": "ColorGradingEffect",
        "$properties": {
          "TonemapperPreset": "Retro"
        }
      }
    }
  }
}
