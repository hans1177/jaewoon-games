{
  "name": "대충알피지",
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "GlobalShadows": true
      },
      "CompatibilityToneMap": {
        "$className": "ColorGradingEffect",
        "$properties": {
          "TonemapperPreset": "Retro"
        }
      },
      "CivilizationAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.27,
          "Offset": 0.08,
          "Haze": 1.4,
          "Glare": 0.08
        }
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "shared",
        "CommonMotion": {
          "$path": "../../assets/roblox/common-motion-v1/RobloxCommonMotion.luau"
        },
        "CreatureModels": {
          "$className": "Folder"
        }
      }
    },
    "ServerScriptService": {
      "GameServer": {
        "$path": "server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "GameClient": {
          "$path": "client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 256
      }
    }
  }
}
