	{ "geo_pirate_waters", "해적이 즐겨 숨는 바다", "Geography", "Uncommon", "은퇴한 해적이 알려 준, 무리 지어 매복하기 좋은 해역과 섬 그림자 표시.", "이야기: 마르세유의 퇴역 해적", 20, 60 },
	{ "bot_lavender", "라벤더", "Botany", "Common", "프로방스 언덕의 보랏빛 꽃. 향이 좋아 약과 향료로 쓰였다.", "들판 채집", 5, 12 },
	{ "bot_olive", "올리브 나무", "Botany", "Common", "지중해 연안의 대표 작물. 열매로 기름을 짜 요리와 등불에 썼다.", "정원 채집", 5, 12 },
	{ "bot_potato", "감자", "Botany", "Uncommon", "아메리카에서 건너온 작물. 척박한 땅에서도 자라 사람들의 식탁을 바꿔 놓았다.", "들판 채집", 15, 40 },
	{ "bot_tea_plant", "차나무", "Botany", "Rare", "먼 동쪽에서 온 상록수. 잎을 말려 우리는 차가 부유한 상인들 사이에서 유행했다.", "식물원 방문", 35, 110 },
	{ "zoo_seal", "바다표범", "Zoology", "Common", "차가운 해안 바위 위에서 쉬는 포유류. 어부들에게는 오래된 이웃이다.", "해안 관찰", 5, 12 },
	{ "zoo_salmon", "대서양 연어", "Zoology", "Common", "강에서 태어나 바다로 갔다가 다시 강으로 돌아오는 물고기.", "해안 관찰", 5, 12 },
	{ "zoo_whale", "고래", "Zoology", "Rare", "북쪽 바다를 오가는 거대한 포유류. 기름과 뼈를 얻으려는 포경선이 따라다녔다.", "해안 관찰", 35, 110 },
	{ "zoo_barbary_ape", "바버리 원숭이", "Zoology", "Rare", "지브롤터 근처 바위산에 사는 꼬리 없는 원숭이. 유럽에 사는 몇 안 되는 야생 원숭이다.", "숲 관찰", 30, 95 },
	{ "min_marble", "카라라 대리석", "Mineral", "Uncommon", "토스카나 산에서 캐는 흰 대리석. 조각과 건축에 쓰이며 배로 실려 나갔다.", "채석장 조사", 15, 40 },
	{ "min_rock_salt", "암염", "Mineral", "Common", "땅속 소금층에서 캔 결정. 생선과 고기를 오래 보관하는 데 꼭 필요했다.", "해안 조사", 5, 12 },
	{ "min_swedish_iron", "스웨덴 철광석", "Mineral", "Uncommon", "질 좋은 철로 이름난 북유럽 광석. 대포와 닻의 재료가 되었다.", "광산 조사", 15, 45 },
	{ "relic_astrolabe", "아스트롤라베", "Relic", "Rare", "별의 높이를 재어 위도를 알려 주는 놋쇠 관측기구.", "수집가의 진열실", 35, 110 },
	{ "relic_compass", "마른 나침반", "Relic", "Uncommon", "자침이 북쪽을 가리키는 항해의 필수 도구. 상자 안에서 눈금 위를 도는 형태다.", "수집가의 진열실", 15, 45 },
	{ "relic_roman_coin", "로마 동전", "Relic", "Common", "옛 로마 황제의 얼굴이 새겨진 청동 동전. 땅속에서 오랜 시간을 견뎠다.", "발굴지 조사", 5, 15 },
	{ "site_pont_du_gard", "퐁 뒤 가르", "Site", "Epic", "프랑스 남부 협곡을 가로지르는 3층 아치의 로마 수도교. 물을 먼 도시로 흘려 보냈다.", "유적 탐험", 90, 280 },
	{ "site_hadrian_wall", "하드리아누스 방벽", "Site", "Epic", "브리튼 북쪽을 가로지르는 로마 변경의 돌 성벽. 언덕을 따라 길게 이어진다.", "유적 탐험", 90, 280 },
	{ "site_giralda", "히랄다 탑", "Site", "Rare", "세비야 대성당 옆의 높은 종탑. 옛 이슬람 사원의 첨탑 위에 종루를 올렸다.", "유적 탐험", 40, 120 },
	{ "ast_halley_comet", "핼리 혜성", "Astronomy", "Epic", "긴 꼬리를 끌며 주기적으로 돌아오는 혜성. 다시 올 때를 계산해 낸 것이 큰 업적이었다.", "천문 관측", 85, 260 },
	{ "chem_phosphorus", "인의 발견", "Chemistry", "Rare", "함부르크의 연금술사가 오줌을 증류하다 어둠 속에서 빛나는 물질을 얻었다.", "학자의 실험실", 40, 120 },
	{ "chem_gunpowder_refine", "화약 정제법", "Chemistry", "Uncommon", "초석을 걸러 순도를 높여 더 안정적이고 강한 화약을 만드는 방법.", "학자의 실험실", 15, 45 },
	{ "phy_boyle_law", "보일의 법칙", "Physics", "Rare", "기체의 부피는 압력에 반비례한다. 유리관과 수은으로 확인했다.", "실험 기록 열람", 40, 120 },
	{ "phy_barometer", "기압계", "Physics", "Uncommon", "수은 기둥의 높이로 대기압을 재는 도구. 폭풍을 미리 알리는 데도 쓰였다.", "실험 기록 열람", 15, 45 },
	{ "phi_empiricism", "경험론", "Philosophy", "Uncommon", "모든 지식은 경험에서 나온다고 보는 생각. 관찰과 실험의 가치를 높였다.", "학자와의 대화", 15, 45 },
	{ "geo_trade_winds", "무역풍", "Geography", "Uncommon", "열대 바다 위로 일정하게 부는 동풍. 대서양을 건너는 길잡이가 되었다.", "항해 기록 열람", 15, 45 },
	{ "geo_polder", "운하와 간척지", "Geography", "Uncommon", "낮은 땅의 물을 풍차로 퍼내 만든 네덜란드의 땅. 운하는 길이자 배수로다.", "해안 관찰", 15, 45 },
	{ "med_lime_scurvy", "괴혈병과 라임", "Medicine", "Rare", "신선한 귤과 라임이 선원의 괴혈병을 막는다는 것을 비교 실험으로 보였다.", "병원 방문", 40, 120 },
	{ "med_inoculation", "천연두 접종", "Medicine", "Rare", "약한 병균을 미리 몸에 넣어 큰 병을 막는 방법이 동방에서 유럽으로 전해졌다.", "병원 방문", 40, 120 },
	{ "myth_dutchman", "떠도는 유령선", "Myth", "Epic", "폭풍 속에서 영원히 항구에 닿지 못하고 떠돈다는 배의 전설. 목격담은 지금도 이어진다.", "항구 전설", 80, 250 },
	{ "myth_atlantis", "가라앉은 대륙의 전설", "Myth", "Epic", "고대 철학자가 남긴 글에서 시작된, 바다 밑으로 사라진 강대한 섬 이야기.", "항구 전설", 80, 250 },
	{ "myth_selkie", "물개 처녀 셀키", "Myth", "Rare", "물가에서 물개 가죽을 벗고 사람이 된다는 북쪽 바다의 전설.", "항구 전설", 35, 110 },
	{ "relic_sextant", "육분의", "Relic", "Uncommon", "해와 별의 높이를 재어 현재 위치를 알려 주는 정밀한 항해 기구.", "유물 조사", 15, 45 },
	{ "relic_hourglass", "모래시계", "Relic", "Common", "뱃사람이 당직 시간을 재던 단순한 시계. 모래가 다 떨어지면 종을 쳤다.", "유물 조사", 5, 12 },
	{ "relic_ship_log", "옛 항해 일지", "Relic", "Uncommon", "날씨, 속도, 사건이 날마다 적힌 선장의 일지. 당시 바다의 생활이 그대로 남아 있다.", "유물 조사", 15, 45 },
	{ "zoo_cod", "대서양 대구", "Zoology", "Common", "북쪽 바다의 가장 중요한 물고기. 소금에 절이거나 말려 유럽 전역에 팔렸다.", "동물 관찰", 5, 12 },
	{ "zoo_gull", "갈매기", "Zoology", "Common", "항구와 배 주변을 맴도는 흰 새. 뱃사람들은 갈매기를 보면 육지가 가깝다고 여겼다.", "동물 관찰", 5, 12 },
	{ "zoo_dolphin", "돌고래", "Zoology", "Uncommon", "배 앞에서 뛰어오르는 영리한 포유류. 뱃사람들 사이에서 행운의 상징이었다.", "동물 관찰", 15, 45 },
	{ "zoo_stork", "황새", "Zoology", "Common", "지붕과 굴뚝 위에 둥지를 트는 큰 철새. 발트해 연안 마을에서 사랑받았다.", "동물 관찰", 5, 12 },
	{ "phy_lever", "지레와 도르래", "Physics", "Uncommon", "작은 힘으로 무거운 짐을 옮기는 원리. 항구 크레인과 돛 줄 장치의 바탕이다.", "실험 기록 열람", 15, 45 },
	{ "phy_refraction", "빛의 굴절", "Physics", "Uncommon", "물과 유리를 지날 때 빛이 꺾이는 현상. 렌즈와 망원경을 설명하는 기초다.", "실험 기록 열람", 15, 45 },
	{ "phy_buoyancy", "부력", "Physics", "Common", "물에 뜨는 물체가 밀려난 물의 무게만큼 힘을 받는다는 원리. 배가 뜨는 이유다.", "실험 기록 열람", 5, 12 },
	{ "phy_magnetism", "자기와 지구", "Physics", "Rare", "지구 자체가 커다란 자석이어서 나침반이 북쪽을 가리킨다는 설명.", "실험 기록 열람", 40, 120 },
	{ "site_paestum", "파이스툼의 신전", "Site", "Rare", "남이탈리아 평야에 선 고대 그리스 신전. 굵은 돌기둥이 거의 온전히 남아 있다.", "유적 탐험", 40, 120 },
	{ "site_herculaneum", "헤르쿨라네움", "Site", "Epic", "화산 폭발로 묻힌 고대 로마의 해안 도시. 나무 가구와 두루마리까지 숯이 되어 남았다.", "유적 탐험", 85, 260 },
	{ "site_belem_tower", "벨렝 탑", "Site", "Uncommon", "리스본 항구 어귀에 선 탑. 먼 바다로 떠나는 배를 지켜보았다.", "유적 탐험", 15, 45 },
	{ "site_visby_walls", "비스뷔 성벽", "Site", "Rare", "발트해 섬 도시를 둘러싼 중세 성벽. 상인들이 모이던 한자 동맹 시절의 흔적이다.", "유적 탐험", 40, 120 },
	{ "site_kronborg", "크론보르 성", "Site", "Rare", "좁은 해협을 내려다보는 덴마크의 성. 지나가는 배에서 통행세를 거두었다.", "유적 탐험", 40, 120 },
	{ "site_bryggen", "브뤼겐 부두", "Site", "Uncommon", "베르겐 항구를 따라 늘어선 알록달록한 목조 상관. 한자 상인들의 창고였다.", "유적 탐험", 15, 45 },
	{ "site_arles_arena", "아를 원형경기장", "Site", "Rare", "프랑스 남부에 남은 로마의 원형경기장. 중세에는 그 안에 마을이 들어서기도 했다.", "유적 탐험", 40, 120 },
	{ "site_roman_baths", "로마 목욕장", "Site", "Uncommon", "브리튼 남서부의 온천 위에 지은 로마 시대의 공중 목욕장.", "유적 탐험", 15, 45 },
	{ "geo_tides", "조석", "Geography", "Common", "달의 끌림으로 하루 두 번 바닷물이 차고 빠지는 현상. 항구 출입 시간을 정한다.", "해안 관찰", 5, 12 },
	{ "geo_fjord", "피오르", "Geography", "Uncommon", "빙하가 깎아 만든 깊고 좁은 바다 골짜기. 큰 배도 바위 절벽 사이로 들어갈 수 있다.", "해안 관찰", 15, 45 },
	{ "geo_baltic_ice", "발트해의 결빙", "Geography", "Uncommon", "겨울이면 바다가 얼어 배가 다니지 못한다. 항해는 봄에 얼음이 풀려야 시작된다.", "해안 관찰", 15, 45 },
	{ "geo_med_currents", "지중해의 해류", "Geography", "Uncommon", "지브롤터로 들어온 대서양 물이 지중해를 시계 반대로 돈다. 배는 이 흐름을 이용했다.", "해안 관찰", 15, 45 },
	{ "geo_tidal_flats", "갯벌", "Geography", "Common", "바닷물이 빠지면 드러나는 넓은 진흙 벌. 북해 연안에서는 걸어서 건너기도 했다.", "해안 관찰", 5, 12 },
	{ "geo_azores_high", "아조레스 고기압", "Geography", "Uncommon", "대서양 한가운데 머무는 고기압. 그 가장자리를 따라 항해하면 순풍을 탄다.", "해안 관찰", 15, 45 },
	{ "ast_orion", "오리온자리", "Astronomy", "Common", "겨울 밤하늘에 세 별이 나란히 놓인 사냥꾼의 별자리. 방향을 찾기 쉽다.", "천문 관측", 5, 12 },
	{ "ast_polaris", "북극성", "Astronomy", "Common", "하늘의 북극 가까이에서 거의 움직이지 않는 별. 그 높이가 곧 위도다.", "천문 관측", 5, 12 },
	{ "ast_moon_phases", "달의 위상", "Astronomy", "Common", "초승달에서 보름달까지 모양이 바뀌는 달. 조석과 날짜를 헤아리는 달력이 되었다.", "천문 관측", 5, 12 },
	{ "ast_solar_eclipse", "일식", "Astronomy", "Rare", "달이 해를 가려 한낮에도 어두워지는 현상. 예고 없이 오면 선원들이 크게 놀랐다.", "천문 관측", 40, 120 },
	{ "ast_milky_way", "은하수", "Astronomy", "Uncommon", "밤하늘을 가로지르는 별의 띠. 망원경으로 보면 수많은 별의 모임이라는 것이 드러났다.", "천문 관측", 15, 45 },
	{ "ast_venus", "금성의 위상", "Astronomy", "Uncommon", "망원경으로 보면 달처럼 차고 기우는 금성. 행성이 해를 돈다는 증거가 되었다.", "천문 관측", 15, 45 },
	{ "ast_mars_opposition", "화성의 충", "Astronomy", "Rare", "화성이 지구와 가장 가까워지는 때. 이 순간의 관측으로 태양계의 크기를 가늠했다.", "천문 관측", 40, 120 },
	{ "min_granite", "화강암", "Mineral", "Common", "단단하고 결이 거친 암석. 부두와 건물의 기초에 널리 쓰였다.", "광물 조사", 5, 12 },
	{ "min_slate", "점판암", "Mineral", "Common", "얇게 쪼개지는 검푸른 돌. 지붕을 덮고 글씨를 쓰는 판으로 썼다.", "광물 조사", 5, 12 },
	{ "min_quartz", "석영", "Mineral", "Common", "투명하거나 하얀 결정. 모래의 주성분이고 유리의 재료다.", "광물 조사", 5, 12 },
	{ "min_tin", "주석", "Mineral", "Uncommon", "구리와 섞어 청동을 만드는 부드러운 금속. 서쪽 땅끝 광산에서 캤다.", "광물 조사", 15, 45 },
	{ "min_jet", "흑옥", "Mineral", "Uncommon", "오래된 나무가 변해 생긴 검고 가벼운 돌. 장신구로 갈아 팔았다.", "광물 조사", 15, 45 },
	{ "min_lodestone", "자철석", "Mineral", "Rare", "쇠를 끌어당기는 천연 자석. 나침반 바늘에 자성을 주는 데 썼다.", "광물 조사", 40, 120 },
	{ "min_pumice", "부석", "Mineral", "Uncommon", "화산이 뿜은 거품 같은 돌. 구멍이 많아 물에 뜬다.", "광물 조사", 15, 45 },
	{ "min_alum", "명반", "Mineral", "Rare", "염색할 때 색이 빠지지 않게 하는 광물. 토스카나에서 큰 이익을 낸 상품이었다.", "광물 조사", 40, 120 },
	{ "myth_leviathan", "리바이어던", "Myth", "Epic", "성경에 나오는 거대한 바다 괴물. 뱃사람들은 고래와 바다뱀의 이야기를 여기에 겹쳤다.", "항구 전설", 85, 260 },
	{ "myth_mermaid", "인어", "Myth", "Uncommon", "상반신은 사람, 하반신은 물고기인 바다의 존재. 선원들의 눈앞에 나타났다는 목격담이 전해진다.", "항구 전설", 15, 45 },
	{ "myth_sea_monk", "바다 수도사", "Myth", "Rare", "북쪽 바다에서 잡혔다는 수도사 모습의 물고기에 대한 기록.", "항구 전설", 40, 120 },
	{ "myth_st_elmo", "성 엘모의 불", "Myth", "Rare", "폭풍 속 돛대 끝에서 푸르게 타는 불. 뱃사람들은 수호성인의 징표로 여겼다.", "항구 전설", 40, 120 },
	{ "myth_charybdis", "카리브디스", "Myth", "Epic", "좁은 해협에서 배를 삼키는 거대한 소용돌이. 고대 서사시 속 괴물이다.", "항구 전설", 85, 260 },
	{ "myth_ys", "가라앉은 도시 이스", "Myth", "Rare", "브르타뉴 앞바다에 가라앉았다는 전설의 도시. 종소리가 들린다고 한다.", "항구 전설", 40, 120 },
	{ "myth_lyonesse", "잃어버린 땅 라이어네스", "Myth", "Rare", "브리튼 서쪽 바다 밑에 있다는 전설의 땅. 교회 종소리가 들린다는 이야기가 전해진다.", "항구 전설", 40, 120 },
	{ "myth_brendan", "성 브렌던의 항해", "Myth", "Epic", "수도사가 가죽배로 바다 건너 축복받은 섬을 찾아갔다는 중세의 항해 전설.", "항구 전설", 85, 260 },
	{ "myth_ghost_light", "바다의 도깨비불", "Myth", "Common", "밤바다 위를 떠도는 푸른 불빛. 물에 빠진 영혼이라 믿는 사람도 있었다.", "항구 전설", 5, 12 },
	{ "chem_saltpeter", "초석", "Chemistry", "Common", "화약의 주재료가 되는 흰 결정. 외양간과 동굴 바닥에서 긁어모았다.", "학자의 실험실", 5, 12 },
	{ "chem_distillation", "증류", "Chemistry", "Common", "액체를 끓여 증기를 식혀 다시 모으는 방법. 술과 약, 향수를 만드는 기본 기술이다.", "학자의 실험실", 5, 12 },
	{ "chem_acid_base", "산과 염기", "Chemistry", "Uncommon", "신 것과 쓴 것이 만나면 서로의 성질이 사라진다는 관찰에서 출발한 개념.", "학자의 실험실", 15, 45 },
	{ "chem_dye", "천연 염료", "Chemistry", "Common", "식물과 벌레와 광물에서 얻은 물감. 옷감 색이 곧 재산을 나타냈다.", "학자의 실험실", 5, 12 },
	{ "chem_indigo", "쪽빛 염료", "Chemistry", "Uncommon", "짙은 푸른색을 내는 식물성 염료. 먼 곳에서 들여온 귀한 물품이었다.", "학자의 실험실", 15, 45 },
	{ "chem_vitriol", "황산염", "Chemistry", "Uncommon", "푸르거나 녹색인 결정. 잉크와 염색, 약제로 쓰였다.", "학자의 실험실", 15, 45 },
	{ "chem_glass", "유리 제조", "Chemistry", "Uncommon", "모래와 재를 불에 녹여 만든 투명한 물질. 베네치아의 비법은 엄격히 지켜졌다.", "학자의 실험실", 15, 45 },
	{ "chem_soap", "마르세유 비누", "Chemistry", "Common", "올리브유와 소다로 만든 단단한 비누. 선원들의 위생을 지켜 주었다.", "학자의 실험실", 5, 12 },
	{ "chem_oxygen", "연소와 공기", "Chemistry", "Rare", "불이 타려면 공기 속 무언가가 필요하다는 것을 밀폐 용기 실험으로 보였다.", "학자의 실험실", 40, 120 },
	{ "chem_mercury", "수은", "Chemistry", "Rare", "상온에서 액체인 은빛 금속. 기압계와 온도계, 거울에 쓰였다.", "학자의 실험실", 40, 120 },
	{ "chem_alcohol", "독한 술", "Chemistry", "Common", "증류로 얻은 알코올. 뱃사람의 보급품이자 상처 소독약이었다.", "학자의 실험실", 5, 12 },
	{ "phi_rationalism", "합리주의", "Philosophy", "Uncommon", "이성으로 확실한 지식을 세울 수 있다고 보는 생각. 수학이 모범이었다.", "학자와의 대화", 15, 45 },
	{ "phi_scientific_method", "과학적 방법", "Philosophy", "Rare", "가설을 세우고 실험으로 확인해 법칙을 찾는 방법. 근대 과학의 뼈대가 되었다.", "학자와의 대화", 40, 120 },
	{ "phi_natural_law", "자연법", "Philosophy", "Uncommon", "모든 사람에게 적용되는 이성의 법이 있다는 생각. 바다의 자유 논쟁에도 쓰였다.", "학자와의 대화", 15, 45 },
	{ "phi_social_contract", "사회 계약", "Philosophy", "Uncommon", "사람들이 약속으로 국가를 세웠다고 보는 이론. 왕의 권력을 묻는 토론을 불렀다.", "학자와의 대화", 15, 45 },
	{ "phi_atomism", "원자론", "Philosophy", "Common", "모든 것이 더 쪼갤 수 없는 작은 알갱이로 이루어졌다는 오래된 생각.", "학자와의 대화", 5, 12 },
	{ "phi_mechanical", "기계적 세계관", "Philosophy", "Uncommon", "세상을 정교한 시계처럼 법칙으로 움직이는 기계로 보는 관점.", "학자와의 대화", 15, 45 },
	{ "phi_skepticism", "회의주의", "Philosophy", "Common", "확실하지 않은 것은 의심하고 따져 본다는 태도. 연구의 출발점이다.", "학자와의 대화", 5, 12 },
	{ "phi_utopia", "이상향", "Philosophy", "Common", "어디에도 없는 완전한 사회를 그린 책 이야기. 먼 섬을 상상하게 했다.", "학자와의 대화", 5, 12 },
	{ "phi_vacuum", "진공 논쟁", "Philosophy", "Rare", "텅 빈 공간은 존재할 수 있는가. 실험이 말과 생각을 바꾸기 시작했다.", "학자와의 대화", 40, 120 },
	{ "phi_monadology", "단자론", "Philosophy", "Epic", "세계가 서로 비추는 무수한 작은 단위로 이루어졌다는 독특한 설명.", "학자와의 대화", 85, 260 },
	{ "phi_enlightenment", "계몽", "Philosophy", "Epic", "이성으로 어둠을 밝히자는 18세기의 큰 흐름. 학회와 신문을 통해 퍼졌다.", "학자와의 대화", 85, 260 },
	{ "med_herb_garden", "약초원", "Medicine", "Common", "병을 고치는 풀을 가꾸던 수도원과 대학의 정원.", "병원 방문", 5, 12 },
	{ "med_bloodletting", "사혈", "Medicine", "Common", "몸의 피를 조금 빼면 병이 낫는다고 믿던 옛 치료. 지금은 위험하다고 본다.", "병원 방문", 5, 12 },
	{ "med_anatomy", "해부학", "Medicine", "Uncommon", "사람의 몸속을 직접 보고 그림으로 남긴 학문. 옛 설명이 틀렸음을 밝혔다.", "병원 방문", 15, 45 },
	{ "med_circulation", "혈액 순환", "Medicine", "Rare", "피가 심장에서 나와 온몸을 돌고 돌아온다는 것을 보인 발견.", "병원 방문", 40, 120 },
	{ "med_pharmacy", "약방", "Medicine", "Common", "약초와 광물을 달이고 빻아 약을 지어 주던 가게.", "병원 방문", 5, 12 },
	{ "med_surgery", "외과 수술", "Medicine", "Uncommon", "전투와 사고로 다친 몸을 칼과 바늘로 치료하는 기술. 이발사가 맡던 때도 있었다.", "병원 방문", 15, 45 },
	{ "med_plague_quarantine", "검역", "Medicine", "Uncommon", "전염병이 돌 때 배를 일정 기간 항구 밖에 세워 두는 제도. 40일에서 이름이 나왔다.", "병원 방문", 15, 45 },
	{ "med_ship_surgeon", "선상 의사", "Medicine", "Common", "긴 항해를 따라 선원들의 병과 상처를 돌보던 의사.", "병원 방문", 5, 12 },
	{ "med_cell_observation", "세포 관찰", "Medicine", "Rare", "현미경으로 코르크를 들여다보고 작은 방들을 발견했다. 생명을 보는 눈이 열렸다.", "병원 방문", 40, 120 },
	{ "med_opium", "아편 약제", "Medicine", "Uncommon", "통증을 줄이는 약으로 쓰였지만 중독 위험이 컸다.", "병원 방문", 15, 45 },
	{ "med_hospital", "항구 병원", "Medicine", "Common", "병든 선원을 돌보던 시설. 오랜 항해 뒤 많은 선원이 이곳에서 쉬었다.", "병원 방문", 5, 12 },
	{ "med_diet", "식이요법", "Medicine", "Uncommon", "무엇을 먹느냐가 건강을 좌우한다는 생각. 신선한 과일을 선원 식단에 넣는 근거가 되었다.", "병원 방문", 15, 45 },
	{ "nav_compass_rose", "나침반 장미", "Navigation", "Common", "나침반 카드에 그려진 방위 무늬. 32방위로 바람과 방향을 불렀다.", "항해 기록 열람", 5, 12 },
	{ "nav_portolan", "포르톨라노 해도", "Navigation", "Rare", "항구와 해안선을 방위선으로 빽빽이 이은 지중해 항해용 지도.", "항해 기록 열람", 40, 120 },
	{ "nav_dead_reckoning", "추측 항법", "Navigation", "Common", "속도와 시간과 방향으로 지금 위치를 계산해 내는 기본 항법.", "항해 기록 열람", 5, 12 },
	{ "nav_log_line", "측정줄", "Navigation", "Common", "매듭이 달린 줄을 바다에 던져 배의 속도를 재던 도구. 속도 단위 '노트'가 여기서 왔다.", "항해 기록 열람", 5, 12 },
	{ "nav_lead_line", "측심줄", "Navigation", "Common", "납 추를 매단 줄로 바다 깊이를 재고 바닥의 모래와 진흙을 확인했다.", "항해 기록 열람", 5, 12 },
	{ "nav_cross_staff", "십자 관측기", "Navigation", "Uncommon", "긴 막대 위에 가로대를 움직여 별과 수평선 사이의 각도를 재는 도구.", "항해 기록 열람", 15, 45 },
	{ "nav_backstaff", "백스태프", "Navigation", "Uncommon", "해를 등지고 그림자로 높이를 재는 기구. 눈을 해치지 않고 관측할 수 있었다.", "항해 기록 열람", 15, 45 },
	{ "nav_octant", "팔분의", "Navigation", "Rare", "거울 두 개로 천체의 높이를 정확히 재는 새 기구. 흔들리는 배 위에서도 쓸 수 있었다.", "항해 기록 열람", 40, 120 },
	{ "nav_chronometer", "해상 시계", "Navigation", "Legendary", "배가 흔들려도 정확히 가는 시계. 이것이 있으면 경도를 알 수 있다.", "항해 기록 열람", 150, 450 },
	{ "nav_mercator", "메르카토르 도법", "Navigation", "Rare", "항로를 직선으로 그을 수 있게 만든 지도 투영법. 항해용 해도의 표준이 되었다.", "항해 기록 열람", 40, 120 },
	{ "nav_longitude_problem", "경도 문제", "Navigation", "Epic", "동서 위치를 알 방법을 찾는 오랜 난제. 나라마다 큰 상금을 걸었다.", "항해 기록 열람", 85, 260 },
	{ "nav_lighthouse", "등대", "Navigation", "Uncommon", "밤에 불을 밝혀 배에게 암초와 항구의 위치를 알리는 탑.", "항해 기록 열람", 15, 45 },
	{ "nav_buoy", "부표", "Navigation", "Common", "물 위에 띄워 얕은 곳과 뱃길을 표시하는 표식.", "항해 기록 열람", 5, 12 },
	{ "nav_pilot_book", "수로 안내서", "Navigation", "Uncommon", "항구 입구의 암초와 조류와 표지를 적은 책. 도선사가 늘 지니던 물건이다.", "항해 기록 열람", 15, 45 },
	{ "nav_star_compass", "별 나침반", "Navigation", "Rare", "뜨고 지는 별의 방향으로 바다 위 길을 찾던 오래된 기술.", "항해 기록 열람", 40, 120 },
	{ "wx_cumulus", "뭉게구름", "Weather", "Common", "솜뭉치처럼 피어오르는 구름. 높이 솟으면 소나기를 부른다.", "날씨 관측", 5, 12 },
	{ "wx_cirrus", "새털구름", "Weather", "Common", "하늘 높이 가늘게 퍼진 구름. 날씨가 곧 변한다는 신호로 읽혔다.", "날씨 관측", 5, 12 },
	{ "wx_fog", "바다 안개", "Weather", "Common", "차가운 바다 위를 덮는 짙은 안개. 뱃고동과 종소리가 길잡이였다.", "날씨 관측", 5, 12 },
	{ "wx_sea_breeze", "해륙풍", "Weather", "Common", "낮에는 바다에서, 밤에는 육지에서 부는 바람. 항구를 드나들 때 이용했다.", "날씨 관측", 5, 12 },
	{ "wx_thunderstorm", "뇌우", "Weather", "Uncommon", "번개와 큰 비를 부르는 구름. 돛대 끝에 불이 붙었다는 이야기가 많다.", "날씨 관측", 15, 45 },
	{ "wx_waterspout", "용오름", "Weather", "Rare", "바다 위에서 구름과 물이 이어져 솟는 회오리. 배를 위협하는 현상이다.", "날씨 관측", 40, 120 },
	{ "wx_hurricane", "대서양 폭풍", "Weather", "Epic", "서쪽 바다에서 일어나는 거대한 소용돌이 폭풍. 한번 만나면 배가 흩어졌다.", "날씨 관측", 85, 260 },
	{ "wx_monsoon", "계절풍", "Weather", "Uncommon", "계절에 따라 방향이 바뀌는 바람. 먼 바다 무역은 이 바람에 맞춰 떠났다.", "날씨 관측", 15, 45 },
	{ "wx_doldrums", "무풍대", "Weather", "Uncommon", "적도 가까이에서 바람이 멎는 바다. 돛이 늘어진 채 며칠씩 머물기도 했다.", "날씨 관측", 15, 45 },
	{ "wx_gale", "강풍", "Weather", "Common", "돛을 줄여야 하는 거센 바람. 북해의 늦가을에 잦았다.", "날씨 관측", 5, 12 },
	{ "wx_rainbow", "무지개", "Weather", "Common", "비 갠 뒤 해의 반대편에 뜨는 색 띠. 물방울에서 빛이 갈라지는 현상이다.", "날씨 관측", 5, 12 },
	{ "wx_halo", "달무리", "Weather", "Uncommon", "달 둘레에 번지는 둥근 빛. 곧 비가 올 징조로 읽혔다.", "날씨 관측", 15, 45 },
	{ "wx_storm_glass", "폭풍 유리", "Weather", "Rare", "결정이 변하는 모양으로 날씨를 예측한다는 병. 아직 정확한지는 논란이다.", "날씨 관측", 40, 120 },
	{ "wx_frost", "서리", "Weather", "Common", "추운 밤 밧줄과 돛에 내리는 얼음 결정.", "날씨 관측", 5, 12 },
