-- KnowledgeCards.luau · 기존 지식카드 정규 데이터 / 개체·관계·근거·분류 메타데이터
-- 지식 카드(세계 백과). 새 항목은 이 테이블에 추가만 하면 도감이 늘어난다.

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"

export type Card = {
	id: string,
	name: string,
	field: string, -- Botany, Zoology, Mineral, Relic, Site, Astronomy, Chemistry, Physics, Geography, Philosophy, Medicine
	rarity: Rarity,
	description: string,
	source: string, -- 발견 방법 (표시용)
	fromYear: number?, -- 실제 등장 시기 이전 연구/발견 방지(명시된 카드만)
	research: { found: { string }?, reported: { string }?, quest: string?, assistDisc: string?, allowReported: string? }?, -- 단계형 연구 과정(신규 카드만)
	visitPort: string?, -- 단순 방문으로 등록되는 카드만 명시. 기존 지점의 드롭률은 바꾸지 않는다.
	meta: {
		kind: string?, -- 오인 분류 방지: 신규/애매한 개체는 명시 종류가 기존 이름 유추보다 우선한다.
		subkind: string?, -- 소재 세부 종류. 없는 기존 카드는 정규 분류에서 추론.
		discipline: string?, -- 신규 카드의 주학문(현재 57개 활성 중 하나). 없으면 기존 분야 자동 분류.
		entityType: string?, -- 실물·문헌·무형 지식(관습·제도 포함)의 존재 형태
		era: string?, -- 카드가 나타내는 역사 시대. 발견 가능 연도(fromYear)와 분리.
		region: string?, -- 대표 항구 id(원본 Ports). 여러 지역 연결은 relations로 확장.
		relatedDisciplines: { string }?, -- 실제 활성 학문의 교차 연결(주학문 보상 중복 없음).
		topic: string?, -- 14개 백과 주제 분류(학문 대분류 및 실물 소재와 분리).
		evidence: string?, -- documented / hypothesis / legend / fiction / unreviewed.
		tags: { string }?, -- 여러 관점에서 찾는 태그(단일 분류와 독립).
		aliases: { string }?, -- 중복 카드 대신 다른 표기 이름으로 검색.
		wikidata: string?, -- 검증된 외부 개체 식별자만 기록(CC0 사실 데이터).
		relations: { { type: string, target: string } }?, -- cardId, good:id, port:id, site:id (유형 있는 연결).
	}?,
	reward: { fame: number, coins: number },
}

local function card(id: any, name: any, field: any, rarity: any, description: any, source: any, fame: any, coins: any, fromYear: number?, research: any?, visitPort: string?, meta: any?): Card
	return {
		id = id,
		name = name,
		field = field,
		rarity = rarity :: Rarity,
		description = description,
		source = source,
		fromYear = fromYear,
		research = research,
		visitPort = visitPort,
		meta = meta,
		reward = { fame = fame, coins = coins },
	}
end

