export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"

export type Card = {
	id: string,
	name: string,
	field: string, -- Botany, Zoology, Mineral, Relic, Site, Astronomy, Chemistry, Physics, Geography, Philosophy, Medicine
	rarity: Rarity,
	description: string,
	source: string, -- 발견 방법 (표시용)
	reward: { fame: number, coins: number },
}

local function card(id: any, name: any, field: any, rarity: any, description: any, source: any, fame: any, coins: any): Card
	return {
		id = id,
		name = name,
		field = field,
		rarity = rarity :: Rarity,
		description = description,
		source = source,
		reward = { fame = fame, coins = coins },
	}
end

