local TopicById, TopicOfKind = {}, {}
for _, row in Topics do
	TopicById[row.id] = row
	for _, kind in row.kinds do
		assert(KindById[kind] ~= nil and TopicOfKind[kind] == nil, "중복·미등록 백과 유형: " .. kind)
		TopicOfKind[kind] = row.id
	end
end
for _, kind in Kinds do assert(TopicOfKind[kind.id] ~= nil, "백과 주제 누락: " .. kind.id) end
local FieldKind = {
	Botany = "plant", Zoology = "animal", Mineral = "mineral", Relic = "relic",
	Site = "wonder", Architecture = "building", Astronomy = "weather", Weather = "weather",
	Medicine = "medicine", Shipbuilding = "ship", Navigation = "map", Geography = "terrain",
	Physics = "science", Chemistry = "science", Philosophy = "science", Goods = "goods",
	Art = "art", Language = "language", Religion = "religion", Politics = "politics", Law = "law", Culture = "custom", Myth = "legend", Mystery = "legend", Lost = "legend", Military = "military",
}
local function kindOf(c: Card): string
	if c.meta and c.meta.kind and KindById[c.meta.kind] then return c.meta.kind end
	if c.field == "Site" then
		if string.find(c.name, "산", 1, true) or string.find(c.name, "폭포", 1, true) or string.find(c.name, "협곡", 1, true) or string.find(c.name, "해협", 1, true) then
			return "terrain"
		end
		for _, word in { "성당", "모스크", "교회", "궁전", "다리", "부두", "운하", "크레인", "요새", "성벽", "브리지", "박물관", "대성채", "등대" } do
			if string.find(c.name, word, 1, true) then return "building" end
		end
	elseif c.field == "Geography" then
		for _, word in { "해도", "지도", "항로", "항해 기록", "해류도" } do
			if string.find(c.name, word, 1, true) then return "map" end
		end
	elseif c.field == "Botany" and (string.find(c.name, "기록", 1, true) or string.find(c.name, "분류법", 1, true)) then
		return "archive"
	end
	return FieldKind[c.field] or "archive"
end
-- [선박 세부 종류] 실물 선박과 설계·부품·조선소 시설을 혼동하지 않는다.
local function subkindOf(c: Card): string?
	if c.meta and c.meta.subkind then return c.meta.subkind end
	if c.field == "Mineral" then
		if string.find(c.name, "화석", 1, true) or string.find(c.name, "호박", 1, true) or string.find(c.name, "암모나이트", 1, true) then return "화석·고생물 흔적" end
		for _, word in { "광석", "철", "구리", "금", "은", "주석", "초석", "유황", "석탄" } do
			if string.find(c.name, word, 1, true) then return "광석·금속·광물 자원" end
		end
		for _, word in { "보석", "루비", "사파이어", "진주", "옥", "수정", "다이아" } do
			if string.find(c.name, word, 1, true) then return "보석·결정" end
		end
		return "암석·석재·지질"
	elseif c.field == "Botany" then
		if string.find(c.name, "나무", 1, true) or string.find(c.name, "수목", 1, true) then return "삼림·목재 원료" end
		if string.find(c.name, "약초", 1, true) or string.find(c.name, "인삼", 1, true) then return "약용 식물" end
		return "식물·작물·표본"
	elseif c.field == "Zoology" then
		if string.find(c.name, "고래", 1, true) or string.find(c.name, "상어", 1, true) or string.find(c.name, "물고기", 1, true) then return "해양 생물" end
		return "육상·조류·해양 생물"
	elseif c.field == "Shipbuilding" then
		if c.id == "ship_caravel" or c.id == "ship_galleon" or c.id == "ship_longship" then return "선박 실물" end
		if string.find(c.id, "design", 1, true) or string.find(c.name, "설계", 1, true) then return "선박 설계" end
		if c.id == "ship_dry_dock" then return "조선 시설" end
		return "선박 장비·공법"
	elseif c.field == "Site" then
		local kind = kindOf(c)
		if kind == "building" then return "실존 건축물" elseif kind == "terrain" then return "자연 지형" end
		return "유적·원더"
	end
	return nil
end
-- [백과 사전식 관계] 위키데이터의 개체→분류/부분/연결 개념을 게임의 기존 id 체계로 번역한다.
local RelationNames = {
	requires = "선행 지식", design = "설계도", usesMaterial = "재료", studiedAs = "연구 기록",
	usedIn = "활용 연구", studies = "연구 대상", describes = "설계 대상", tradedAs = "교역 자원",
	locatedAt = "위치", foundAt = "탐험 장소", scholarlySource = "학자 보고",
	associatedWith = "관련 장소·제도", relatedTo = "연관 지식",
	belongsTo = "소속", partOf = "구성 요소", causes = "원인", resultsIn = "결과", evolvesInto = "발전", influences = "영향", usesTechnology = "사용 기술",
}
local EntityTypes = {
	class = "종류·개념", place = "실존 장소", process = "연구·과정", taxon = "생물 분류군",
	design = "설계·도면", substance = "물질·재료", phenomenon = "자연 현상",
	work = "문헌·작품", legend = "전설·가설", intangible = "무형 지식", practice = "의례·관습", institution = "사회 제도",
	person = "역사 인물", polity = "국가·정체", organization = "조직", event = "역사 사건", body = "인체 기관", ecosystem = "생태계", convention = "시간·사회 약속", concept = "추상 개념",
}
local function entityTypeOf(c: Card): string
	if c.meta and c.meta.entityType and EntityTypes[c.meta.entityType] then return c.meta.entityType end
	local kind = kindOf(c)
	if kind == "terrain" or kind == "building" or kind == "wonder" then return "place" end
	if kind == "animal" or kind == "plant" then return "taxon" end
	if kind == "mineral" or kind == "goods" then return "substance" end
	if kind == "science" or kind == "medicine" then return "process" end
	if kind == "weather" then return "phenomenon" end
	if kind == "legend" then return "legend" end
	if kind == "archive" or kind == "art" then return "work" end
	return "class"
end
-- [지식 신뢰도] 표시용 분류일 뿐 확정성 보장이나 전투 보너스로 취급하지 않는다.
local EvidenceNames: { [string]: string } = {
	documented = "기록·관찰 근거", hypothesis = "학설·가설", legend = "전설·전승",
	fiction = "게임 속 가상", unreviewed = "근거 미분류",
}
local function evidenceOf(c: Card): string
	if c.meta and c.meta.evidence and EvidenceNames[c.meta.evidence] then return c.meta.evidence end
	if string.find(c.id, "lost_astheria", 1, true) == 1 then return "fiction" end
	if c.id == "lost_lemuria" or c.id == "lost_terra_australis" then return "hypothesis" end
	if c.field == "Myth" or c.field == "Lost" then return "legend" end
	return "unreviewed"
end
local function topicOf(c: Card): string
	if c.meta and c.meta.topic and TopicById[c.meta.topic] then return c.meta.topic end
	return TopicOfKind[kindOf(c)]
end
local function tagsOf(c: Card): { string }
	local tags, seen = {}, {}
	local function add(value)
		if type(value) == "string" and #value > 0 and not seen[value] then
			seen[value] = true
			table.insert(tags, value)
		end
	end
	local kind = KindById[kindOf(c)]
	add(kind and kind.name)
	local meta = c.meta
	for _, tag in (meta and meta.tags or {}) do add(tag) end
	return tags
end
local RarityNames = { Common = "일반", Uncommon = "고급", Rare = "희귀", Epic = "영웅", Legendary = "전설" }

local ById: { [string]: Card } = {}
for _, c in Cards do
	ById[c.id] = c
end

