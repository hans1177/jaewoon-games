	{ "geo_kilauea", "킬라우에아", "Geography", "Rare", "끊임없이 용암을 뿜는 하와이 화산.", "화산 기록", 40, 110 },
	{ "geo_doldrums_pacific", "태평양 무풍대", "Geography", "Uncommon", "바람이 멎는 적도 부근의 넓은 바다.", "항해 기록", 15, 36 },
	{ "geo_fiord_nz", "뉴질랜드 피오르", "Geography", "Uncommon", "가파른 절벽 사이의 깊은 물길.", "연안 항해", 15, 36 },
	{ "geo_aleutians", "알류샨 열도", "Geography", "Uncommon", "북태평양을 가르는 안개 낀 섬줄기.", "연안 항해", 15, 36 },
	{ "geo_inside_passage", "내부 항로", "Geography", "Uncommon", "알래스카와 캐나다 해안의 섬 사이 물길.", "연안 항해", 15, 36 },
	{ "geo_torres_strait", "토레스 해협", "Geography", "Uncommon", "호주와 뉴기니 사이의 암초 많은 좁은 물길.", "해협 항해", 15, 36 },
	{ "geo_south_pacific_gyre", "남태평양 환류", "Geography", "Uncommon", "남태평양을 도는 거대한 해류.", "항해 기록", 15, 36 },
	{ "site_great_zimbabwe", "그레이트 짐바브웨", "Site", "Legendary", "남아프리카 내륙에 돌을 쌓아 올린 거대한 도시 유적. 금과 상아 교역으로 번성했다.", "지역 대장정 보상", 150, 450 },
	{ "site_kilwa", "킬와 키시와니", "Site", "Epic", "동아프리카 해안의 섬 도시국가. 인도양 금 교역의 중심이었다.", "지역 대장정 보상", 100, 300 },
	{ "relic_kilwa_coins", "킬와의 동전", "Relic", "Epic", "킬와 술탄이 구리로 찍어 낸 동전. 사하라 남쪽에서 가장 이른 주조 화폐 중 하나다.", "지역 대장정 보상", 100, 300 },
	{ "site_timbuktu", "팀북투", "Site", "Epic", "사하라 남쪽 가장자리의 교역·학문 도시. 소금과 금이 오가고 필사본이 쌓였다.", "지역 대장정 보상", 100, 300 },
	{ "relic_benin_bronzes", "베닌 청동 부조판", "Relic", "Epic", "베닌 왕국 궁정을 장식한 청동 부조판. 왕과 전사들의 모습을 새겼다.", "지역 대장정 보상", 100, 300 },
	{ "relic_mansa_musa", "만사 무사의 황금 순례", "Relic", "Legendary", "14세기 말리의 왕 만사 무사가 황금을 싣고 떠난 메카 순례의 기록. 카이로의 금값을 흔들었다.", "지역 대장정 보상", 150, 450 },
	{ "relic_iron_pillar", "델리의 철 기둥", "Relic", "Legendary", "델리에 서 있는 오래된 철 기둥. 천 년이 넘도록 거의 녹슬지 않았다.", "지역 대장정 보상", 150, 450 },
	{ "site_hampi", "함피", "Site", "Epic", "남인도 비자야나가르 제국의 수도 유적. 향신료와 말 교역으로 번성했다.", "지역 대장정 보상", 100, 300 },
	{ "site_sanchi", "산치 대탑", "Site", "Epic", "인도 아소카 시대에 세운 불탑. 문마다 새긴 조각이 이야기를 전한다.", "지역 대장정 보상", 100, 300 },
	{ "site_bagan", "바간", "Site", "Epic", "미얀마 이라와디 강변에 수천 개의 탑이 서 있던 옛 왕도.", "지역 대장정 보상", 100, 300 },
	{ "relic_zheng_he_fleet", "정화의 대함대 기록", "Relic", "Epic", "15세기 초 명나라 정화가 이끈 대함대의 기록. 인도양과 동아프리카까지 닿았다.", "지역 대장정 보상", 100, 300 },
	{ "site_persepolis", "페르세폴리스", "Site", "Epic", "페르시아 아케메네스 제국의 의례 도시 유적. 거대한 계단과 돌기둥이 남았다.", "지역 대장정 보상", 100, 300 },
	{ "site_tenochtitlan", "테노치티틀란", "Site", "Epic", "호수 위에 세운 아즈텍의 수도. 둑길과 운하로 이어진 도시였다.", "지역 대장정 보상", 100, 300 },
	{ "mys_sargasso", "사르가소 해의 정적", "Mystery", "Uncommon", "바람이 멎고 해초가 끝없이 깔린 대서양 한복판의 바다. 배가 오래 갇힌다는 이야기가 선원들 사이에 퍼졌다.", "해상 소문", 15, 40 },
	{ "mys_green_children", "울피트의 초록 아이들", "Mystery", "Uncommon", "12세기 잉글랜드의 한 마을에 피부가 초록빛인 남매가 나타났다는 이야기. 어디서 왔는지는 지금도 설명이 엇갈린다.", "마을 전설", 15, 40 },
	{ "mys_stone_circle", "거석 원의 수수께끼", "Mystery", "Uncommon", "거대한 돌을 둥글게 세운 선사 시대 유적. 하지의 해돋이와 이어졌다는 이야기가 있으나 쓰임은 정확히 알 수 없다.", "유적 답사", 15, 40 },
	{ "mys_roanoke", "사라진 로어노크 식민지", "Mystery", "Rare", "1587년 북아메리카에 세워진 식민지가 3년 뒤 텅 빈 채 발견되었다. 나무 기둥에는 '크로아토안'이라는 글자만 새겨져 있었다.", "항구 소문", 25, 70 },
	{ "mys_voynich", "보이니치 필사본", "Mystery", "Rare", "알 수 없는 문자와 낯선 식물 그림으로 가득한 중세의 책. 누가 무엇을 적었는지 아직 풀리지 않았다.", "고서 수집", 25, 70 },
	{ "mys_oak_island", "오크 아일랜드의 구덩이", "Mystery", "Rare", "캐나다 해안의 작은 섬에서 1790년대 깊은 구덩이가 발견되었고, 보물이 묻혀 있다는 소문이 이어졌다. 파 내려갈수록 물이 차올랐다고 전한다.", "현지 전설", 25, 70 },
	{ "mys_piri_reis", "피리 레이스의 지도", "Mystery", "Rare", "1513년 오스만의 제독이 그린 세계 지도. 대서양 건너 해안선이 놀랍도록 정교해서 어떤 자료를 썼는지 논쟁이 이어진다.", "고지도 연구", 25, 70 },
	{ "mys_gevaudan", "제보당의 짐승", "Mystery", "Rare", "1760년대 프랑스 남부 산간에서 사람들을 습격했다는 정체불명의 짐승. 늑대라는 설과 다른 짐승이라는 설이 맞섰다.", "마을 기록", 25, 70 },
	{ "mys_greenland_norse", "사라진 그린란드 정착민", "Mystery", "Rare", "수백 년을 이어 온 노르드인 마을이 15세기 무렵 기록에서 사라졌다. 기후 변화와 교역 단절이 이유로 거론된다.", "북해 항해", 25, 70 },
	{ "mys_rongorongo", "롱고롱고 문자", "Mystery", "Rare", "이스터 섬의 나무판에 새겨진 아직 읽히지 않은 그림 문자. 섬 사람들의 역사가 담겼을 거라고 짐작한다.", "섬 탐사", 25, 70 },
	{ "mys_mary_celeste", "마리 셀레스트호의 비밀", "Mystery", "Epic", "1872년 대서양에서 선원 한 명 없이 항해 중이던 배가 발견되었다. 화물과 식량은 멀쩡했고 구명정만 사라져 있었다.", "선박 기록", 40, 120 },
	{ "mys_franklin", "프랭클린 탐험대의 실종", "Mystery", "Epic", "1845년 북극 항로를 찾아 떠난 두 척의 배와 백수십 명이 돌아오지 않았다. 수십 년에 걸친 수색으로 남은 흔적이 하나씩 발견되었다.", "북극 탐험", 40, 120 },
	{ "mys_antikythera", "안티키테라의 기계", "Mystery", "Epic", "1900년 그리스 앞바다 난파선에서 올라온 청동 톱니바퀴 장치. 하늘의 움직임을 계산했던 고대의 기계로 추정된다.", "해저 인양", 40, 120 },
	{ "mys_flannan", "플래넌 제도 등대지기 실종", "Mystery", "Rare", "1900년 말 스코틀랜드 외딴 등대에서 세 사람이 사라진 채 발견되었다. 폭풍 속 파도에 휩쓸렸다는 설명이 가장 유력하다.", "등대 기록", 25, 70 },
	{ "mys_bermuda", "버뮤다 해역의 소문", "Mystery", "Rare", "배와 비행기가 이 바다에서 사라진다는 이야기. 실제로는 날씨가 거칠고 오가는 배가 많다는 점이 자주 지적된다.", "선원 소문", 25, 70 },
	{ "lost_terra_incognita", "미지의 땅", "Lost", "Common", "옛 지도의 빈 가장자리에 적힌 라틴어 문구. 아직 아무도 가 보지 못한 곳이라는 뜻이다.", "고지도", 8, 20 },
	{ "lost_edge_dragons", "여기에 용이 있다", "Lost", "Uncommon", "지도 가장자리에 괴물을 그려 넣고 위험을 알리던 옛 풍습. 이 문구가 실제 지구본에 새겨진 사례가 남아 있다.", "고지도", 15, 40 },
	{ "lost_thule", "툴레", "Lost", "Uncommon", "고대 항해자 피테아스가 북쪽 끝에서 보았다고 전한 땅. 노르웨이나 아이슬란드를 가리킨다는 해석이 있다.", "옛 기록", 15, 40 },
	{ "lost_antillia", "안티아일리아 섬", "Lost", "Rare", "15세기 해도에 대서양 서쪽 끝 사각형 섬으로 그려진 전설의 땅. 일곱 도시가 있다고 전해졌다.", "옛 해도", 25, 70 },
	{ "lost_hy_brasil", "하이 브라실", "Lost", "Rare", "아일랜드 서쪽 바다에 안개 속에서만 나타난다는 섬. 오랫동안 실제 지도에도 이름이 올랐다.", "옛 해도", 25, 70 },
	{ "lost_blessed_isles", "축복받은 섬", "Lost", "Rare", "고대 사람들이 서쪽 바다 끝에 있다고 믿은 낙원. 영웅들이 죽은 뒤 간다는 이야기도 있다.", "고전 문헌", 25, 70 },
	-- [사건 조사 백과] 역사 기록/의혹/신화의 증거 수준은 카드마다 구별한다.
	{ "history_fire_london_1666", "1666년 런던 대화재", "Site", "Rare", "1666년 9월 런던을 휩쓴 화재. 당시 방화 음모 소문이 퍼졌으나 의회 조사는 사고라는 결론을 내렸다.", "런던 재건 기록", 40, 110, 1666, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "documented", era = "1666년", region = "london", tags = { "런던", "재난", "역사" } } },
	{ "history_fire_rumor_1666", "런던 대화재 방화 음모설", "Mystery", "Uncommon", "1666년 대화재 뒤 외국인과 가톨릭 신자 등을 범인으로 지목하는 소문이 확산됐다. 당시 수사 기록은 조직적 방화를 입증하지 못했다.", "런던 소문과 조사 문서", 40, 110, 1666, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "hypothesis", era = "1666년", region = "london", tags = { "음모론", "소문", "반증" } } },
	{ "history_tulip_contract_1637", "1637년 튤립 계약 소동", "Goods", "Rare", "1636~1637년 네덜란드의 튤립 구근 거래가 과열되고 값이 폭락했다. 온 나라가 파산했다는 극적인 통설은 후대의 과장으로 평가된다.", "네덜란드 상업 장부", 40, 110, 1637, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "documented", era = "1637년", region = "amsterdam", tags = { "경제", "투기", "금융" } } },
	{ "history_roanoke_croatoan_1590", "크로아토안 표식", "Mystery", "Rare", "1590년 로어노크 식민지를 방문한 존 화이트는 사람이 사라진 정착지에서 CROATOAN 표식을 발견했다. 이주설을 포함해 여러 가설이 있지만 최종 행방은 확인되지 않았다.", "로어노크 식민지 기록", 40, 110, 1590, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "documented", era = "1590년", region = "havana", tags = { "실종", "미해결", "북아메리카" } } },
	{ "history_salem_trial_1692", "1692년 세일럼 재판 기록", "Site", "Rare", "1692년 매사추세츠 세일럼 일대에서 마녀재판이 벌어져 무고한 사람들이 처형됐다. 초자연적 주장은 입증되지 않았으며 재판 절차와 증거의 문제가 비판받는다.", "매사추세츠 법정 기록", 40, 110, 1692, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "documented", era = "1692년", region = "boston", tags = { "재판", "정치", "종교" } } },
	{ "history_south_sea_bubble_1720", "1720년 남해회사 투기", "Goods", "Rare", "영국 남해회사를 둘러싼 주식 투기가 1720년에 급격히 붕괴했다. 왕실·의회·상인들의 이해관계와 소문이 시장을 뒤흔들었다.", "런던 주식 장부", 40, 110, 1720, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "documented", era = "1720년", region = "london", tags = { "경제", "투기", "정치" } } },
	{ "history_lisbon_quake_1755", "1755년 리스본 대지진", "Geography", "Rare", "1755년 11월 1일 리스본에 큰 지진과 해일, 화재가 잇따랐다. 재난 원인과 구호를 둘러싼 신학·철학·정치 논쟁이 유럽으로 퍼졌다.", "리스본 지진 기록", 40, 110, 1755, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "documented", era = "1755년", region = "lisbon", tags = { "재난", "철학", "정치" } } },
	{ "history_boston_tea_1773", "1773년 보스턴 차 사건", "Site", "Rare", "1773년 12월 16일 북아메리카 보스턴에서 영국 동인도회사 차 상자들이 바다에 던져졌다. 세금·독점·대표권을 둘러싼 갈등이 배경이었다.", "보스턴 항만·차 무역 기록", 40, 110, 1773, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "documented", era = "1773년", region = "boston", tags = { "정치", "교역", "저항" } } },
	{ "history_dejima_exchange_1641", "1641년 데지마 무역 거점", "Site", "Rare", "1641년 네덜란드 상관이 히라도에서 나가사키 데지마로 옮겨졌다. 대외 교류가 제한된 시대에도 일본과 해외 사이의 교역·지식 교류는 이어졌다.", "나가사키 데지마 기록", 40, 110, 1641, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "documented", era = "1641년", region = "nagasaki", tags = { "동아시아", "무역", "외교" } } },
	{ "myth_plato_atlantis_record", "플라톤의 아틀란티스 기록", "Myth", "Rare", "아틀란티스는 플라톤의 대화편에 등장하는 섬 이야기다. 실제 도시가 발견되었다는 학술적 합의는 없으며 문헌의 철학적 맥락을 함께 살펴야 한다.", "고대 문헌 비교", 40, 110, 1517, nil, nil, { kind = "event", topic = "history", discipline = "history", entityType = "event", evidence = "legend", era = "1517년", region = "venice", tags = { "고대철학", "신화", "문헌" } } },
