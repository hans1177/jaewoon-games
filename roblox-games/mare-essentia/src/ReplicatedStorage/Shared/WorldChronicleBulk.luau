	{ id = "c_b2_sakoku", year = 1639, month = 7, ports = { "nagasaki" }, voice = "japan", disc = "commerce", kind = "politics", title = "쇄국령과 데지마 교역", scholar = "막부 관리", fact = "1633~1639년 에도 막부는 일본인의 해외 왕래와 포르투갈 선박의 입항을 금지했다. 이후 서양과의 교역은 나가사키 데지마의 네덜란드 상관과 중국 상인 중심으로 이어졌다." },
	{ id = "c_b2_ming_fall", year = 1644, month = 4, ports = { "canton" }, voice = "china", disc = "history", kind = "politics", title = "명 왕조의 멸망", scholar = "연대기 기록자", fact = "1644년 4월 이자성의 군대가 베이징을 점령해 명 황제가 숨졌고, 곧 청군이 들어와 베이징을 차지했다. 이후 청 왕조가 중국 전역을 다스리게 되었다." },
	{ id = "c_b2_cape_town", year = 1652, month = 4, ports = { "cape_town" }, voice = "sea", disc = "geography", kind = "trade", title = "케이프타운 보급 기지 건설", scholar = "네덜란드 동인도회사 파견관 얀 판 리베이크", fact = "1652년 4월 네덜란드 동인도회사가 희망봉 아래 테이블 만에 보급 기지를 세웠다. 아시아로 가는 배들이 신선한 식량과 물을 얻는 중간 기지가 되었다." },
	{ id = "c_b2_new_york", year = 1664, month = 9, ports = { "new_york" }, voice = "europe", disc = "history", kind = "politics", title = "뉴암스테르담이 뉴욕으로", scholar = "식민지 기록자", fact = "1664년 9월 영국 함대가 뉴암스테르담의 항복을 받았고, 도시는 뉴욕으로 이름이 바뀌었다. 네덜란드는 이후 1673년 잠시 되찾았다가 1674년 영국에 넘겼다." },
	{ id = "c_b2_taiwan", year = 1683, month = 8, ports = { "macau" }, voice = "china", disc = "history", kind = "politics", title = "청의 타이완 편입", scholar = "연대기 기록자", fact = "1683년 청군이 정씨 세력을 항복시키고 타이완을 영토에 넣었다. 이전에는 네덜란드가 1662년까지 일부를 다스렸다." },
	{ id = "c_b2_st_petersburg", year = 1703, month = 5, ports = { "st_petersburg" }, voice = "europe", disc = "architecture", kind = "politics", title = "상트페테르부르크 건설", scholar = "차르 표트르 1세", fact = "1703년 5월 표트르 1세가 발트해 연안 네바강 하구 늪지에 요새를 세우며 상트페테르부르크의 건설이 시작되었다. 러시아가 바다로 나가는 창으로 계획한 도시였다." },
	{ id = "c_b2_muteferrika", year = 1727, month = 7, ports = { "istanbul" }, voice = "islam", disc = "linguistics", kind = "sci", title = "오스만 최초의 인쇄소", scholar = "인쇄업자 이브라힘 뮈테페리카", fact = "1727년 이브라힘 뮈테페리카가 오스만 제국에서 아랍 문자로 책을 찍는 인쇄소를 열도록 허가를 받았다. 사전과 역사서, 지리서 등을 먼저 펴냈다." },
	{ id = "c_b2_delhi_sack", year = 1739, month = 3, ports = { "goa" }, voice = "india", disc = "history", kind = "war", title = "나디르 샤의 델리 약탈", scholar = "연대기 기록자", fact = "1739년 3월 페르시아의 나디르 샤가 델리를 점령하고 크게 약탈했다. 무굴 제국의 권위가 크게 흔들린 사건이었다." },
	{ id = "c_b2_plassey", year = 1757, month = 6, ports = { "calcutta" }, voice = "india", disc = "history", kind = "war", title = "플라시 전투", scholar = "연대기 기록자", fact = "1757년 6월 영국 동인도회사의 군대가 벵골 태수의 군대를 꺾었다. 이후 회사가 벵골에서 정치적 영향력을 크게 넓혔다." },
	{ id = "c_b2_cook_hawaii", year = 1779, month = 2, ports = { "honolulu" }, voice = "sea", disc = "geography", kind = "sci", title = "쿡 선장의 하와이 방문", scholar = "항해가 제임스 쿡", fact = "1778년 말 쿡이 하와이 제도에 이르렀고, 1779년 2월 켈라케쿠아 만에서 원주민과 충돌해 숨졌다. 쿡의 항해는 태평양 해도를 크게 보완했다." },
	{ id = "c_b2_asiatic_society", year = 1784, month = 1, ports = { "calcutta" }, voice = "india", disc = "linguistics", kind = "sci", title = "아시아 학회 창립", scholar = "법관이자 언어학자 윌리엄 존스", fact = "1784년 1월 캘커타에서 윌리엄 존스 등이 아시아 학회를 세웠다. 존스는 산스크리트어와 그리스어, 라틴어 사이의 닮은 점을 지적해 비교 언어학의 길을 열었다." },
	{ id = "c_b2_first_fleet", year = 1788, month = 1, ports = { "sydney" }, voice = "sea", disc = "geography", kind = "politics", title = "제1함대의 시드니 도착", scholar = "선단 지휘관 아서 필립", fact = "1788년 1월 영국의 죄수 이송 선단이 오스트레일리아 동해안에 닿았다. 원주민의 땅에 정착지가 세워지며 큰 갈등이 시작되었다." },
	{ id = "c_b2_rosetta", year = 1799, month = 7, ports = { "alexandria" }, voice = "europe", disc = "archaeology", kind = "sci", title = "로제타석 발견", scholar = "프랑스 원정군 공병 장교", fact = "1799년 7월 나폴레옹의 이집트 원정군이 로제타 근처에서 세 가지 문자로 같은 글이 새겨진 돌을 발견했다. 훗날 이집트 상형문자 해독의 열쇠가 되었다." },
	{ id = "c_b2_tambora", year = 1815, month = 4, ports = { "batavia" }, voice = "sea", disc = "meteorology", kind = "nature", title = "탐보라 화산 폭발", scholar = "관리 래플스의 기록", fact = "1815년 4월 인도네시아 숨바와섬의 탐보라 화산이 근대 이후 가장 큰 규모로 폭발했다. 이듬해 1816년에는 북반구 여러 곳에서 기온이 낮아 '여름 없는 해'로 기억되었다." },
	{ id = "c_b2_fulton", year = 1807, month = 8, ports = { "new_york" }, voice = "europe", disc = "shipbuilding", kind = "sci", title = "풀턴의 증기선 시험 운항", scholar = "발명가 로버트 풀턴", fact = "1807년 8월 풀턴의 증기선이 뉴욕과 올버니 사이 허드슨강을 오갔다. 이후 상업용 증기선 운항이 빠르게 퍼졌다." },
	{ id = "c_sample_cape_comet", year = 1680, month = 11, ports = { "london" }, voice = "europe", disc = "astronomy", kind = "sci", title = "1680년의 대혜성", scholar = "천문 관측가 존", fact = "1680년 말 밝은 혜성이 유럽 하늘에 나타나 여러 천문학자가 위치를 꾸준히 기록했다. 이 관측은 훗날 혜성 궤도 연구의 자료가 되었다.", lore = "사람들은 하늘의 불길한 징조라며 두려워했다.", loreTag = "미신" },
}
