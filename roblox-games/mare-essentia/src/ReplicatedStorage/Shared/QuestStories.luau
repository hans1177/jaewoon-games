	q_field_south_asia_1 = { [==[코친의 아샤는 아버지 라비에게 배운 어망 조작을 외웠지만 왜 그렇게 움직이는지 설명하지 못한다. 라비는 기술을 물려주는 것이 질문을 막는 일은 아니라고 말한다. 어망 기록을 찾아보자.]==], [==[어망 카드가 채워졌다. 아샤는 아버지의 가르침에 자신의 질문을 덧붙인다. 캘리컷의 후추 농부가 다음 스승이다.]==] },
	q_field_south_asia_2 = { [==[말라바르 농부는 신밧드의 모험담보다 매일 덩굴을 가꾸는 일이 자신의 삶을 바꾸었다고 말한다. 아샤는 후추를 값으로만 알던 때를 떠올린다. 후추 덩굴을 기록하자.]==], [==[후추 덩굴 카드가 추가됐다. 아샤는 재배자의 기술도 항해술만큼 중요하다고 적는다. 농부는 해안 사원의 청동 장인을 소개한다.]==] },
	q_field_south_asia_3 = { [==[해안 사원의 장인은 청동 신상의 형태와 사람들이 간직한 신앙의 의미를 설명한다. 아샤는 기술을 배운다고 모든 문화의 의미를 알게 되는 것은 아니라는 점을 깨닫는다. 청동상 기록을 찾자.]==], [==[청동상 카드가 채워졌다. 제작 기술과 신앙의 설명을 나누어 적었다. 장인이 들려준 푸른 보석 이야기가 실론으로 이어진다.]==] },
	q_field_south_asia_4 = { [==[실론 보석상은 사파이어의 빛보다 원석을 찾아 다듬는 시간이 중요하다고 말한다. 아샤는 물건의 값만 보고 일한 사람을 잊었던 일을 돌아본다. 사파이어 기록을 확보하자.]==], [==[사파이어 카드가 더해졌다. 아샤는 아름다움 뒤의 노동을 기억하기로 한다. 보석상은 내륙에서 만난 코끼리 이야기를 들려준다.]==] },
	q_field_south_asia_5 = { [==[아그라 방향의 내륙 길에서 인도코끼리 기록을 확보하자. 아샤는 왕궁 그림 속 코끼리와 살아 있는 동물을 같은 시선으로 바라봐도 되는지 질문한다.]==], [==[인도코끼리 카드로 일지를 완성했다. 아샤는 어부와 농부, 장인과 자연의 기록을 아버지에게 전한다. 전통은 답을 외우는 것이 아니라 다음 사람이 질문할 수 있게 하는 것이라고 적었다.]==] },
	q_field_southeast_asia_1 = { [==[마닐라 화가 마리아는 성벽 그림을 주문받지만 의뢰인은 항구의 사람을 모두 지우라고 한다. 그녀는 성벽과 그 안팎에서 살아간 사람을 함께 그리고 싶다. 인트라무로스 자료를 찾자.]==], [==[성벽 카드가 채워졌다. 마리아는 건축과 사람의 삶을 함께 담을 그림을 구상한다. 호이안 칠기 상자 그림이 다음 장의 단서다.]==] },
	q_field_southeast_asia_2 = { [==[호이안 장인은 마리아가 완성품의 광택만 그린 것을 보고 보이지 않는 작업도 기억해 달라고 부탁한다. 칠기 상자 자료에서 장인의 기술을 살펴보자.]==], [==[칠기 카드가 추가됐다. 마리아는 광택뿐 아니라 그것을 만든 손도 기록한다. 장인은 양곤의 불탑 여행기를 건넨다.]==] },
	q_field_southeast_asia_3 = { [==[쉐다곤 파고다를 그리던 마리아는 낯선 신앙을 자기에게 익숙한 이야기로 설명하려다 안내인의 말을 듣고 생각을 바꾼다. 실제 건축과 전승을 존중해 자료를 확보하자.]==], [==[불탑 카드가 채워졌다. 마리아는 모르는 의미를 억지로 설명하지 않기로 한다. 여행기에는 반다의 향신료 교역을 둘러싼 이야기가 이어진다.]==] },
	q_field_southeast_asia_4 = { [==[반다 농부는 육두구가 귀한 열매로만 그려지면 독점과 식민 지배의 역사에 놓인 사람을 누가 기억하겠느냐고 묻는다. 육두구나무 기록을 확보하자.]==], [==[육두구 카드가 더해졌다. 마리아는 열매의 그림 곁에 교역과 사람의 삶을 기록한다. 마지막 장에는 먼 섬의 용처럼 생긴 동물이 등장한다.]==] },
	q_field_southeast_asia_5 = { [==[코모도왕도마뱀을 기록할 차례다. 마리아는 실제 동물을 전설 속 용처럼 그리라는 제안을 받는다. 상상화와 관찰 자료를 다른 그림으로 남기려 한다.]==], [==[코모도왕도마뱀 카드가 마지막 장을 채웠다. 마리아는 성벽과 칠기, 신앙과 향신료, 자연을 담은 그림책을 완성한다. 낯선 것을 자기 상상에 맞춰 바꾸지 않겠다는 약속도 남긴다.]==] },
	q_field_east_asia_1 = { [==[인천의 윤호는 먼 항구로 떠난 형에게 두루미 그림을 보내고 싶다. 길한 징조라는 이야기를 믿으면 형이 돌아올 것만 같다. 갯벌의 실제 두루미 기록을 찾자.]==], [==[두루미 카드가 채워졌다. 윤호는 그림이 귀환을 보증하지는 않아도 고향의 기억을 전할 수 있다고 생각한다. 형의 차 교역선 이야기가 광저우로 이어진다.]==] },
	q_field_east_asia_2 = { [==[광저우 차 농부는 윤호의 형이 운반했을 찻잎과 그것을 가꾸는 사람의 관계를 이야기한다. 윤호는 향만 알았지 그 노동을 생각하지 못했다. 차나무 자료를 확보하자.]==], [==[차나무 카드가 추가됐다. 윤호는 형의 항해가 많은 사람의 노동과 연결된다고 적는다. 농부는 나가사키 통역관 하루를 소개한다.]==] },
	q_field_east_asia_3 = { [==[데지마의 하루는 서로 다른 언어의 편지가 언제나 정확히 전달되지는 않았다고 말한다. 윤호는 소식이 늦는 이유를 단정하지 않기로 한다. 데지마 유적 기록을 찾아보자.]==], [==[데지마 카드가 채워졌다. 하루는 제한된 교역과 사람 사이의 교류를 설명한다. 윤호가 편지에 넣고 싶어 하는 후지 산 그림이 다음 자료다.]==] },
	q_field_east_asia_4 = { [==[에도의 후지 산 자료를 찾자. 윤호는 같은 산이 사람마다 다른 신앙과 문학 속에 남는다는 것을 배운다. 형에게 보낼 그림에는 실제 모습과 자신의 소망을 나누어 담으려 한다.]==], [==[후지 산 카드가 더해졌다. 윤호는 산의 기록과 가족의 소망을 다른 쪽에 적는다. 하루의 마지막 편지에는 마카오 앞바다의 거친 날씨가 적혀 있다.]==] },
	q_field_east_asia_5 = { [==[마카오 앞바다의 태풍 기록을 조사하자. 윤호는 불길한 전승보다 바람과 항해 조건을 이해하는 것이 형을 기다리는 데 도움이 된다고 느낀다.]==], [==[태풍 카드로 다섯 기록을 채웠다. 윤호는 형의 행방을 알아냈다고 말하지 않는다. 두루미와 차나무, 교역소와 산, 바람의 이야기를 모아 기다림이 담긴 편지를 완성한다.]==] },
	q_field_americas_1 = { [==[헤시피 어민 루시아는 어린 시절 만난 바다거북 그림을 보여 주지만 상인은 등딱지의 값만 묻는다. 살아 있는 동물의 이야기를 남기고 싶어 푸른바다거북 자료를 부탁한다.]==], [==[푸른바다거북 카드가 채워졌다. 루시아는 상품 목록과 자연 기록을 나누어 여행기를 시작한다. 다음 장에는 베네수엘라 해안의 카카오 그림이 있다.]==] },
	q_field_americas_2 = { [==[베네수엘라 해안의 카카오를 기록하자. 루시아는 유럽 상인의 장부가 카카오의 시작인 것처럼 설명하는 말에 의문을 품는다. 아메리카의 오랜 이용 전통과 식물을 함께 살펴본다.]==], [==[카카오 카드가 추가됐다. 루시아는 작물의 역사가 바다 건너 거래보다 오래되었음을 기억한다. 다음은 캄페체의 마야 석비다.]==] },
	q_field_americas_3 = { [==[캄페체의 마야 석비를 살펴보자. 루시아는 글자를 읽지 못하면 역사가 없다는 여행자의 말에 동의하지 않는다. 유물의 실제 형태와 문자에 관한 질문을 기록하려 한다.]==], [==[마야 석비 카드가 채워졌다. 루시아는 모든 글자를 해독했다고 주장하지 않고 기록 문화의 존재를 남긴다. 아마존 하구를 그린 해도가 다음 단서다.]==] },
	q_field_americas_4 = { [==[벨렝 안내인은 거대한 강이 여행자에게는 경이로운 풍경이지만 현지 사람에게는 삶의 터전이라고 말한다. 루시아는 아마존 하구의 실제 지형을 기록하고 싶다.]==], [==[아마존 하구 카드가 추가됐다. 여행자의 감탄과 지리 자료를 나누어 적는다. 마지막 쪽에는 안데스의 산줄기와 황금 도시의 전설이 그려져 있다.]==] },
	q_field_americas_5 = { [==[안데스 산맥의 기록을 확보하자. 루시아는 황금 도시의 여행담이 여러 사회의 역사를 하나의 이야기로 덮어 버렸다고 생각한다. 자연과 문명을 각자의 모습으로 남기려 한다.]==], [==[안데스 카드로 마지막 장을 채웠다. 루시아에게 가장 귀한 것은 금이 아니라 거북과 작물, 글자와 강, 산의 기록이었다. 누군가의 삶이 있는 땅을 빈 지도라 부르지 않겠다고 적는다.]==] },
	q_field_pacific_1 = { [==[시드니 해안의 톰은 캥거루를 처음 그린 그림이 엉뚱하다고 고백한다. 사람들이 웃을까 걱정되지만 실제 자연을 기록하는 그림책을 만들고 싶다. 캥거루 자료부터 확보하자.]==], [==[캥거루 카드가 채워졌다. 톰은 틀린 첫 그림을 버리지 않고 무엇을 고칠지 적어 둔다. 파푸아에서 본 작물 그림이 두 번째 장이다.]==] },
	q_field_pacific_2 = { [==[포트모르즈비 주변의 타로를 살펴보자. 톰은 낯선 작물을 자신이 처음 발견한 듯 자랑하려다 현지의 오랜 재배 지식을 듣는다. 그들의 지식을 존중해 기록하기로 한다.]==], [==[타로 카드가 추가됐다. 톰은 자기에게 새로운 것이 다른 사람에게도 새로운 것은 아니라고 적는다. 다음은 피지의 꽃이다.]==] },
	q_field_pacific_3 = { [==[수바의 히비스커스 그림은 선원마다 색과 모양이 다르다. 톰은 아름다운 그림을 고르는 것과 실제 식물의 특징을 기록하는 일이 다르다고 깨닫는다. 히비스커스 자료를 찾자.]==], [==[히비스커스 카드가 채워졌다. 꽃의 관찰 자료와 여행자의 추억을 다른 쪽에 그린다. 북쪽 바다에서 거대한 고래를 보았다는 이야기가 다음 장을 연다.]==] },
	q_field_pacific_4 = { [==[다윈 북부 해안의 혹등고래 자료를 조사하자. 톰은 거대한 생물을 괴물처럼 그리면 책이 잘 팔릴 것이라는 말을 듣지만 실제 자연의 모습을 우선하기로 한다.]==], [==[혹등고래 카드가 더해졌다. 톰은 경외심을 여행자의 감정으로 기록하고 생태와 구분한다. 마지막 그림은 오클랜드의 카우리 숲이다.]==] },
	q_field_pacific_5 = { [==[카우리 숲의 기록을 확보하자. 처음에는 거대한 나무를 돛대감으로만 보았던 톰은 이제 숲 자체의 역사와 현지 사회의 지식이 궁금하다. 살아 있는 나무를 마지막 장에 담는다.]==], [==[카우리 카드로 다섯 기록을 완성했다. 톰은 서툰 첫 캥거루 그림을 책의 첫 장에 남겨 두었다. 부끄러운 그림이 아니라 얼마나 배웠는지 보여 주는 증거였기 때문이다.]==] },
	q_willow_field = { [==[안트베르펜 약초원 서기 엘리스는 돌아가신 스승의 표본 상자에서 같은 이름이 붙은 서로 다른 잎을 발견한다. 강변의 버드나무 기록부터 확보해야 스승의 오류인지 필사자의 실수인지 살필 수 있다.]==], [==[버드나무 카드가 기록에 추가되었다. 엘리스는 오래된 표본의 이름을 섣불리 바꾸지 않고 수도원 약초원의 비교 기록을 찾기로 했다.]==] },
	q_willow_notes = { [==[수도원 서기는 서로 다른 나무가 같은 이름으로 적힌 필사본 두 권을 보여 준다. 엘리스가 가져온 표본 기록과 기존 약초원의 관찰 기록을 대조할 자료가 필요하다.]==], [==[버드나무 비교 기록을 확보했다. 엘리스는 이름을 구별하는 문제와 약방에서 어떻게 이용했는지를 조사하는 문제를 나누어 정리했다.]==] },
	q_willow_medicine = { [==[약방의 서기는 버드나무 껍질을 사용했다는 옛 기록을 읽어 준다. 전해진 처방을 그대로 믿기보다 당시 관찰과 전통적 사용을 구별할 연구 기록을 찾아야 한다.]==], [==[버드나무 의학 연구 카드가 기록에 추가되었다. 엘리스는 스승의 자료를 존중하면서도 치료 효과를 단정하지 않는 새로운 주석을 남겼다.]==] },
