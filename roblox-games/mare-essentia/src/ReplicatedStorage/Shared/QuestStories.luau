	q_logwood_amsterdam2 = { [==[암스테르담 염료 상인 비텐은 장인의 자녀들이 글을 배울 자리를 마련하고 싶다. 기존 주문부터 책임져야 한다며 로그우드 거래를 부탁한다.]==], [==[로그우드가 도착해 비텐은 기존 주문 장부를 정리했다. 학교를 세우는 꿈은 앞으로의 책임으로 남겨 두었다.]==] },
