	q_sao_tome_cloth = { [==[상투메 시장의 아다는 수입 천이 떨어져 주민의 주문을 받지 못한다. 대서양 섬의 직물 공급을 기록하고 작은 시장의 계약을 지키고 싶다.]==], [==[옷감이 상투메에 도착했다. 아다는 입고표를 정리해 밀렸던 주문을 준비했다.]==] },
	q_sao_tome_iron = { [==[상투메 장인 페르난두는 마을과 농장의 도구 수리 요청이 쌓이는 것을 본다. 섬의 생산과 노동의 역사를 기억하며 철물 재료를 요청한다.]==], [==[철이 도착하자 페르난두는 마을과 농업 도구의 수리 재료를 정리했다. 실제 수확량은 아직 알 수 없다.]==] },
