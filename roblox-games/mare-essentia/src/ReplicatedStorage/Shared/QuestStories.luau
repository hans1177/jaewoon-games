	q_field_americas_3 = { [==[캄페체의 마야 석비를 살펴보자. 루시아는 글자를 읽지 못하면 역사가 없다는 여행자의 말에 동의하지 않는다. 유물의 실제 형태와 문자에 관한 질문을 기록하려 한다.]==], [==[마야 석비 카드가 채워졌다. 루시아는 모든 글자를 해독했다고 주장하지 않고 기록 문화의 존재를 남긴다. 아마존 하구를 그린 해도가 다음 단서다.]==] },
	q_field_americas_4 = { [==[벨렝 안내인은 거대한 강이 여행자에게는 경이로운 풍경이지만 현지 사람에게는 삶의 터전이라고 말한다. 루시아는 아마존 하구의 실제 지형을 기록하고 싶다.]==], [==[아마존 하구 카드가 추가됐다. 여행자의 감탄과 지리 자료를 나누어 적는다. 마지막 쪽에는 안데스의 산줄기와 황금 도시의 전설이 그려져 있다.]==] },
	q_field_americas_5 = { [==[안데스 산맥의 기록을 확보하자. 루시아는 황금 도시의 여행담이 여러 사회의 역사를 하나의 이야기로 덮어 버렸다고 생각한다. 자연과 문명을 각자의 모습으로 남기려 한다.]==], [==[안데스 카드로 마지막 장을 채웠다. 루시아에게 가장 귀한 것은 금이 아니라 거북과 작물, 글자와 강, 산의 기록이었다. 누군가의 삶이 있는 땅을 빈 지도라 부르지 않겠다고 적는다.]==] },
	q_field_pacific_1 = { [==[시드니 해안의 톰은 캥거루를 처음 그린 그림이 엉뚱하다고 고백한다. 사람들이 웃을까 걱정되지만 실제 자연을 기록하는 그림책을 만들고 싶다. 캥거루 자료부터 확보하자.]==], [==[캥거루 카드가 채워졌다. 톰은 틀린 첫 그림을 버리지 않고 무엇을 고칠지 적어 둔다. 파푸아에서 본 작물 그림이 두 번째 장이다.]==] },
	q_field_pacific_2 = { [==[포트모르즈비 주변의 타로를 살펴보자. 톰은 낯선 작물을 자신이 처음 발견한 듯 자랑하려다 현지의 오랜 재배 지식을 듣는다. 그들의 지식을 존중해 기록하기로 한다.]==], [==[타로 카드가 추가됐다. 톰은 자기에게 새로운 것이 다른 사람에게도 새로운 것은 아니라고 적는다. 다음은 피지의 꽃이다.]==] },
	q_field_pacific_3 = { [==[수바의 히비스커스 그림은 선원마다 색과 모양이 다르다. 톰은 아름다운 그림을 고르는 것과 실제 식물의 특징을 기록하는 일이 다르다고 깨닫는다. 히비스커스 자료를 찾자.]==], [==[히비스커스 카드가 채워졌다. 꽃의 관찰 자료와 여행자의 추억을 다른 쪽에 그린다. 북쪽 바다에서 거대한 고래를 보았다는 이야기가 다음 장을 연다.]==] },
	q_field_pacific_4 = { [==[다윈 북부 해안의 혹등고래 자료를 조사하자. 톰은 거대한 생물을 괴물처럼 그리면 책이 잘 팔릴 것이라는 말을 듣지만 실제 자연의 모습을 우선하기로 한다.]==], [==[혹등고래 카드가 더해졌다. 톰은 경외심을 여행자의 감정으로 기록하고 생태와 구분한다. 마지막 그림은 오클랜드의 카우리 숲이다.]==] },
	q_field_pacific_5 = { [==[카우리 숲의 기록을 확보하자. 처음에는 거대한 나무를 돛대감으로만 보았던 톰은 이제 숲 자체의 역사와 현지 사회의 지식이 궁금하다. 살아 있는 나무를 마지막 장에 담는다.]==], [==[카우리 카드로 다섯 기록을 완성했다. 톰은 서툰 첫 캥거루 그림을 책의 첫 장에 남겨 두었다. 부끄러운 그림이 아니라 얼마나 배웠는지 보여 주는 증거였기 때문이다.]==] },
	q_willow_field = { [==[안트베르펜 약초원 서기 엘리스는 돌아가신 스승의 표본 상자에서 같은 이름이 붙은 서로 다른 잎을 발견한다. 강변의 버드나무 기록부터 확보해야 스승의 오류인지 필사자의 실수인지 살필 수 있다.]==], [==[버드나무 카드가 기록에 추가되었다. 엘리스는 오래된 표본의 이름을 섣불리 바꾸지 않고 수도원 약초원의 비교 기록을 찾기로 했다.]==] },
	q_willow_notes = { [==[수도원 서기는 서로 다른 나무가 같은 이름으로 적힌 필사본 두 권을 보여 준다. 엘리스가 가져온 표본 기록과 기존 약초원의 관찰 기록을 대조할 자료가 필요하다.]==], [==[버드나무 비교 기록을 확보했다. 엘리스는 이름을 구별하는 문제와 약방에서 어떻게 이용했는지를 조사하는 문제를 나누어 정리했다.]==] },
	q_willow_medicine = { [==[약방의 서기는 버드나무 껍질을 사용했다는 옛 기록을 읽어 준다. 전해진 처방을 그대로 믿기보다 당시 관찰과 전통적 사용을 구별할 연구 기록을 찾아야 한다.]==], [==[버드나무 의학 연구 카드가 기록에 추가되었다. 엘리스는 스승의 자료를 존중하면서도 치료 효과를 단정하지 않는 새로운 주석을 남겼다.]==] },
	q_field_mystery = { [==[필사공 이사벨은 읽을 수 없는 글자가 남은 책의 사본을 받았다. 해독하지 못한 부분을 억지로 채우라는 주문을 거절하고 다른 미스터리 기록과 비교하고자 한다.]==], [==[미스터리 카드 목표를 채웠다. 이사벨은 확인한 자료와 해석 가설을 나누고 해결되지 않은 의문을 그대로 남겼다.]==] },
	q_field_lost = { [==[지도상 로렌초는 오래된 해도에서 남방 대륙과 전설 속 섬을 발견한다. 탐험가의 관측과 지도 제작자의 상상이 어떻게 뒤섞였는지 잃어버린 대륙 분야의 기록을 모아 살펴보자.]==], [==[관련 카드 목표를 달성했다. 로렌초는 실제로 확인된 지리와 가설, 전승을 서로 다른 표식으로 구분했다.]==] },
	q_chr_draft = { [==[인쇄공 마리는 관찰 노트를 읽고 먼저 결론을 정해 놓은 원고의 문제를 발견한다. 확인한 자료를 바탕으로 기존 논문 초안 작성 목표를 수행하자.]==], [==[논문 초안을 작성했다. 마리는 초안을 최종 결론으로 여기지 않고 후속 검토를 위한 자료로 정리했다.]==] },
	q_chr_paper = { [==[마리는 인쇄될 원고의 여백에 아직 답을 찾지 못한 질문을 남긴다. 출판은 연구를 끝내는 것이 아니라 다른 독자에게 검토할 기회를 주는 일이다. 논문 출판 목표를 마치자.]==], [==[논문 출판 목표를 완료했다. 마리는 출판 기록과 연구의 입증 여부를 구별하며 다음 연구의 여백을 남겼다.]==] },
	q_war_europe = { [==[베네치아 출신 서기 비토는 지중해 사략과 봉쇄로 손해를 본 가상 선주들의 보험 청구서를 펼친다. 그들의 불안을 이해하기 위해 이 해역의 함대 작전 기록을 요청한다.]==], [==[지중해 함대 작전 완료를 기록했다. 비토가 꺼낸 다음 봉투에는 서아프리카 노예무역의 피해를 기억하는 자료가 들어 있었다.]==] },
	q_war_w_africa = { [==[서아프리카 기록자 아마는 해안 요새와 대서양 노예무역 자료를 펼쳐 지워진 이름을 기억하려 한다. 가상 차단 임무를 포함한 이 해역의 함대 작전 기록을 요청한다. 전투 성과가 역사적 피해를 대신 설명해서는 안 된다고 당부한다.]==], [==[서아프리카 함대 작전 완료가 기록되었다. 아마는 피해자의 기억을 따로 보존하고 카리브 선단 교역에 관한 다음 보고서를 건넸다.]==] },
	q_war_new_world = { [==[카리브 서기 루시아는 은과 설탕 선단 장부에서 선주와 노동자의 기록이 다르게 남았음을 발견한다. 사략과 식민지 경쟁을 배경으로 하는 함대 작전의 경험을 남겨 달라고 한다.]==], [==[카리브 함대 작전 완료를 기록했다. 루시아는 특정 화물을 얻었다고 단정하지 않고 인도양의 계절풍 교역로가 그려진 다음 문서를 건넸다.]==] },
	q_war_indian = { [==[말라바르 상인 미라는 계절풍이 돌아오기 전에 물량을 보내야 하는 농가의 편지를 읽는다. 신밧드의 항해담은 전승이지만 상인들의 공급 걱정은 현실적인 문제다. 인도양 함대 작전의 기록을 부탁한다.]==], [==[인도양 함대 작전을 마친 기록이 남았다. 미라는 계절풍 표를 접고 말라카 해협의 통행 기록을 꺼냈다.]==] },
	q_war_far_east = { [==[말라카 통역관 라흐만은 서로 다른 언어의 통행 기록을 보여 준다. 해협에는 여러 교역 공동체가 오갔고 소문만으로 범인을 정할 수 없다. 동남아 함대 작전의 경험을 남기자.]==], [==[동남아 함대 작전 완료를 기록했다. 라흐만은 해협 전체의 평화를 단정하지 않고 태평양 원정 자료를 건넸다.]==] },
	q_war_pacific = { [==[항해자 모아나는 태평양 섬 사이를 오가던 별과 파도에 관한 지식을 이야기한다. 먼바다의 함대는 전투력만으로 항해할 수 없다. 마지막 해역의 함대 작전 기록을 남기자.]==], [==[태평양 함대 작전 완료를 기록했다. 앞선 해역의 기록과 별·파도 지식을 한 일지에 모았다. 여섯 해역의 기록이 마지막 장이 되었다.]==] },
	q_hist_1 = { [==[항만 서기 세바스티안은 같은 역사 사건을 두 사람이 서로 다르게 전하는 것을 듣는다. 소문을 옮기기 전에 게임에서 경험한 첫 역사 사건의 기록을 확보하자.]==], [==[첫 역사 사건 기록을 얻었다. 세바스티안은 목격 기록과 전해 들은 설명을 구별하기로 했다.]==] },
	q_hist_2 = { [==[세바스티안은 첫 사건의 설명만으로 시대를 이해하려던 자신의 실수를 인정한다. 서로 다른 사건 기록을 모아 한 가지 설명으로 묶을 수 없는 부분을 찾아보자.]==], [==[역사 사건 목표를 채웠다. 서기는 기록 사이의 차이가 새로운 질문이 될 수 있음을 깨달았다.]==] },
	q_hist_3 = { [==[인쇄공 마리는 사건의 결말을 먼저 정해 놓고 연대기를 쓰라는 주문을 받는다. 실제로 경험한 역사 사건 기록을 확보해 관찰과 소문을 구별하는 책을 준비하려 한다.]==], [==[역사 사건 목표를 달성했다. 마리는 연대기의 자료를 정리하고 빈칸을 추측으로 채우지 않았다.]==] },
	q_hist_4 = { [==[늙은 세바스티안은 마리에게 이전 연대기들을 건네며 모든 사건의 원인을 안다고 말하지 말라고 당부한다. 더 많은 역사 사건 기록을 남겨 시대를 비교할 자료를 마련하자.]==], [==[마지막 역사 사건 목표를 채웠다. 두 사람은 확인한 사건과 여전히 모르는 원인을 구별한 기록을 남겼다.]==] },
	q_person_1 = { [==[통역사 마리온은 같은 항구의 사건을 서로 다르게 기억하는 사람들의 이야기를 듣는다. 누구의 목소리만 믿어야 하는지 판단하기 전에 다양한 인물에게 직접 말을 걸어 보라고 한다.]==], [==[첫 인물 대화 목표를 달성했다. 마리온은 한 가지 설명에 머물지 않고 다른 관점도 모으자고 제안했다.]==] },
	q_person_2 = { [==[마리온은 상인과 장인, 학자가 같은 문제를 바라보는 방식이 다르다는 점에 주목한다. 서로 다른 인물과 더 많이 대화해 앞으로 연구할 질문을 마련하자.]==], [==[인물 대화 목표를 채웠다. 마리온은 여러 관점을 살펴볼 자료를 확보하고 학회에서 연구를 발표하는 다음 의뢰를 소개했다.]==] },
	q_person_3 = { [==[학회 서기 베아트리체는 발표가 유명해지는 수단이 아니라 자신의 설명을 검토받는 기회라고 말한다. 지금까지의 호기심을 바탕으로 실제 학회 발표 목표를 수행하자.]==], [==[학회 발표를 마쳤다. 베아트리체는 발표했다는 사실과 연구가 입증됐다는 주장을 구분하고 더 많은 지식을 이해할 다음 과제를 소개했다.]==] },
	q_person_4 = { [==[후원자 엘레나는 발표를 마친 연구자라도 새로운 근거가 나타나면 생각을 수정해야 한다고 믿는다. 기존 지식 이해 목표를 채워 연구의 토대를 넓히자.]==], [==[지식 이해 목표를 완료했다. 엘레나는 인물과의 대화, 학회 발표, 이해한 지식을 서로 다른 성과로 기록하며 연구 일지를 마쳤다.]==] },
	-- [항구 길드 허가증] 실제 항구별 수요·기존 납품 조건에 맞춘 개별 창작 서사.
	permit_london = { [==[런던 길드의 가상 의뢰. 템스강 부두의 약종상은 원산지를 속인 향료 때문에 손님과 다투었다. 향료의 출처를 기록할 새 거래가 필요하다. 향신료 6개를 납품해 신용 기록을 남기자.]==], [==[약종상은 향료 거래 장부에 새 거래선을 기록했다. 런던 특산품 거래 자격을 얻었다.]==] },
