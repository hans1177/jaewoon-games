	q_wine_london = { [==[런던 주점 주인 윌은 밀린 외상 때문에 가게를 닫을까 고민한다. 빈 저장고를 채워 기존 공급 계약부터 지키려 한다.]==], [==[포도주가 도착하자 윌은 입고표와 외상 장부를 따로 정리했다. 아직 빚은 남았지만 주문을 준비할 수 있게 되었다.]==] },
	q_timber_edinburgh = { [==[에든버러 목수 맥그리거는 비가 새는 공동 회관의 서까래를 조사한다. 주민이 모은 돈을 헛되게 쓰지 않으려면 수리용 목재부터 확보해야 한다.]==], [==[목재가 도착하자 맥그리거는 수리 목록을 정리했다. 주민들에게 준비된 작업표를 보여 줄 수 있게 되었다.]==] },
	q_beer_copenhagen = { [==[코펜하겐 양조사 한스는 돌아가신 아버지의 축제 공급 장부를 펼친다. 우승보다 가업의 계약을 지키는 것이 먼저라며 맥주 납품을 부탁한다.]==], [==[한스는 납품된 맥주를 축제 공급 목록에 올렸다. 아버지의 장부에 이어 쓸 거래 기록이 생겼다.]==] },
	q_olive_london = { [==[런던 수도원 부엌의 베네딕트 수사는 겨울 공동 식사에 쓸 올리브유가 부족하다고 말한다. 지중해에서 이어진 기름 교역을 기록하며 주문을 채우자.]==], [==[올리브유가 도착해 공동 식사의 재료 목록에 올랐다. 수사는 먼 바다에서 온 식재료의 거래 기록도 남겼다.]==] },
	q_silk_istanbul = { [==[이스탄불 비단 상인 유수프는 암스테르담 거래처의 주문서에서 누락된 산지 표기를 발견한다. 그곳에 비단을 납품하여 동서 교역 기록을 이어 달라고 부탁한다.]==], [==[암스테르담의 비단 주문이 완료되었다. 유수프의 참고 장부에 교역의 다음 연결점이 생겼다.]==] },
	q_amber_riga = { [==[리가의 호박 세공사 아우구스트는 가업을 강요하다 아들과 다투었다. 함부르크 주문을 통해 호박이 장신구가 되기 전 어떤 길을 걷는지 보여 주려 한다.]==], [==[함부르크 호박 납품이 기록되었다. 부자는 가업을 정하기 전에 거래의 의미부터 알아보기로 했다.]==] },
	q_furs_petersburg = { [==[북쪽 모피 상인은 베네치아 거래처의 주문서에서 산지와 동물 이름이 섞인 것을 발견한다. 실제 납품을 통해 역사적 모피 교역 기록을 정리하려 한다.]==], [==[베네치아 모피 주문이 완료되었다. 상품의 거래 기록과 동물의 자연사는 구별해 남겼다.]==] },
	q_wine_porto = { [==[포르투 양조업자 마누엘은 런던 거래처로부터 운송 중 품질이 변했다는 항의를 받는다. 런던 포도주 주문을 채워 운송과 저장 기록의 비교 자료를 마련하자.]==], [==[런던 포도주 납품이 완료되었다. 마누엘이 검토할 운송 기록이 생겼지만 품질 개선은 별도의 조사로 남았다.]==] },
	q_sugar_cadiz = { [==[카디스 상인은 암스테르담으로 향할 설탕 주문서와 생산지의 기록을 펼친다. 달콤한 상품의 이문만 적던 장부에 대서양 교역과 강제 노동의 역사도 남기고 싶다.]==], [==[암스테르담에 설탕 납품이 기록되었다. 상품 가격과 생산 노동에 관한 질문을 함께 남겼다.]==] },
	q_salt_lubeck = { [==[뤼베크 청어 상인 한자는 보존 식품 주문이 밀렸는데 소금 창고가 비었다고 한다. 북유럽 교역품이 서로 의존하는 모습을 보여 주는 계약이다.]==], [==[소금이 보존 식품용 재료 장부에 올랐다. 청어 상인은 밀린 작업을 준비할 수 있게 되었다.]==] },
	q_logwood_oslo = { [==[오슬로 직조공 시그리드는 겨울 축제에 걸 천의 색을 고르다가 염료 공급이 끊겼다는 소식을 듣는다. 먼 바다의 로그우드를 주문한다.]==], [==[시그리드는 로그우드 납품을 확인하고 염색 견본 작업을 준비했다. 축제용 천에 새 색을 시험할 수 있게 되었다.]==] },
	q_med_tour = { [==[통역관 사라는 지중해 상인들이 서로의 말을 빌려 거래한 기록을 보여 준다. 항구 방문 경험을 넓혀 여러 언어와 신앙, 교역 전통에 관한 비교 자료를 모으자.]==], [==[항구 방문 목표를 달성했다. 사라는 실제 기항 기록과 지중해 공통 교역어에 관한 자료를 함께 정리했다.]==] },
	q_world_tour = { [==[지도 제작자 로렌초는 낡은 세계지도를 펼치며 유럽 항구의 이름도 시대마다 달라졌다고 말한다. 다양한 항구를 방문하여 자신의 지도 기록을 넓히자.]==], [==[방문 목표를 달성했다. 로렌초는 확인된 기항지와 옛 지도의 표기를 구별해 남겼다.]==] },
	q_marble_london = { [==[런던 조각가 이사벨라는 남편의 추모 비문을 새길 돌을 고른다. 수입 대리석을 받아 석질을 비교하는 일부터 시작하려 한다.]==], [==[대리석이 도착하자 이사벨라는 비문 초안과 재료 목록을 나란히 놓았다. 추모 조각의 첫 재료를 마련했다.]==] },
	q_coral_venice = { [==[베네치아 보석 장인은 산호를 돌이라고 기록한 오래된 장식품 목록을 발견한다. 기존 산호 주문을 채우며 장식 전통과 실제 자연사를 구분하려 한다.]==], [==[산호 납품이 완료되었다. 장인은 장식품의 형태와 산호의 생물학적 기록을 구별했다.]==] },
	q_saffron_london = { [==[런던 요리사 마사는 연회 주문서에 사프란을 적고도 재료 값을 보고 망설인다. 값비싼 향료를 다른 색소로 속이지 않기 위해 실제 주문을 요청한다.]==], [==[사프란이 도착하자 마사는 재료와 대체품을 구분한 주방 장부를 만들었다. 연회 준비의 부족분이 채워졌다.]==] },
	q_carpet_amsterdam = { [==[암스테르담 상인 클라스는 값비싼 융단이 큰 계약을 가져올 것이라는 친구의 말에 흔들린다. 그러나 문양과 제작 지역을 모른 채 거래하기 부끄러워 실제 견본을 주문한다.]==], [==[융단을 받은 클라스는 문양과 거래 기록을 정리했다. 응접실의 화려함보다 상품을 이해하는 일이 먼저라고 생각했다.]==] },
	q_incense_seville = { [==[세비야 사제 라파엘의 예배 준비 장부에서 향료가 떨어졌다. 오래된 유향 교역로와 종교 의례의 관계를 기억하며 보급을 부탁한다.]==], [==[유향이 도착해 라파엘은 의례 준비 목록의 부족분을 지웠다. 향료의 거래 기록도 함께 남겼다.]==] },
	q_dates_hamburg = { [==[함부르크 제과장 바르바라는 겨울 시장에서 값싼 과자를 찾는 아이들을 본다. 대추야자의 단맛을 새 조리법에 시험하고 싶다.]==], [==[대추야자를 받은 바르바라는 새 과자의 재료표를 만들었다. 판매 성과를 장담하기보다 시험을 준비했다.]==] },
	q_raisins_bergen = { [==[베르겐 선원은 긴 항해에서 신선한 식량이 부족했던 기억을 떠올린다. 건포도 같은 저장 식품을 보충하고 항해 식량의 한계를 기록하려 한다.]==], [==[건포도가 보급 장부에 올랐다. 선원은 저장 식품의 편리함과 괴혈병 예방 지식을 혼동하지 않기로 했다.]==] },
	q_cotton_rouen = { [==[루앙 직조공 클레르는 양모 가격이 올라 일감을 잃을까 두렵다. 새로운 면직물을 검토하기 위해 면화 원료를 먼저 확보하려 한다.]==], [==[면화 납품이 끝나자 클레르는 베틀의 재료표를 고쳤다. 새 직물 시험을 준비할 수 있게 되었다.]==] },
	q_leather_amsterdam = { [==[암스테르담 제화공 데이크는 물이 스며든 선원의 낡은 신발을 받았다. 값싼 대체 재료를 쓰라는 압박에도 수리용 가죽을 주문한다.]==], [==[가죽이 도착하자 데이크는 수선 순서를 정리했다. 밀렸던 작업을 시작할 재료가 마련되었다.]==] },
	q_pepper_hamburg = { [==[함부르크 식료품 장인 요한은 후추값이 오를 때마다 손님의 불만을 듣는다. 향신료 가격과 음식에 쓰이는 양을 정확히 기록하려 한다.]==], [==[후추가 입고되자 요한은 향료 원가를 계산했다. 막연한 효능 대신 실제 재료값을 설명할 수 있게 되었다.]==] },
	q_gold_london = { [==[런던 금세공사 에드먼드는 큰 계약을 따내려다 금의 품질을 보증하기 어렵다는 것을 깨닫는다. 황금 해안의 금가루 교역 기록과 견본을 확보하려 한다.]==], [==[금가루 납품을 확인한 에드먼드는 감정 작업 목록을 작성했다. 명성을 증명할 기회가 생겼다.]==] },
	q_palmoil_hamburg = { [==[함부르크 비누공 게르트루트는 세정 재료가 비싸 작은 가게들이 주문을 취소하는 모습을 본다. 야자유의 쓰임을 비교할 재료가 필요하다.]==], [==[야자유가 도착해 비누공의 재료표가 채워졌다. 더 저렴한 제품의 가능성을 검토할 수 있게 되었다.]==] },
	q_gum_amsterdam = { [==[암스테르담 화가 아드리안은 물감이 갈라진 제자의 그림을 돌려주었다. 안료를 묶는 재료로 쓰이는 아라비아 고무를 주문한다.]==], [==[아드리안은 아라비아 고무를 안료 연구 목록에 올렸다. 그림 보존 문제를 다시 시험할 준비가 되었다.]==] },
	q_ebony_london = { [==[런던 악기 장인 하워드는 오르간 연주자에게 닳은 건반을 고쳐 달라는 편지를 받는다. 흑단 공급을 확보해 수리를 준비하려 한다.]==], [==[흑단이 도착하자 하워드는 건반 수리용 재료를 정리했다. 연주자의 주문을 이어 갈 수 있게 되었다.]==] },
	q_feathers_venice = { [==[베네치아 의상 장인 로렌차는 가면 축제의 깃털 장식이 너무 비싸다는 항의를 받는다. 타조 깃털의 산지와 거래를 확인할 주문을 낸다.]==], [==[깃털이 도착해 로렌차는 재료비를 기록했다. 장식의 유행과 동물의 자연사를 구분했다.]==] },
	q_ivory_amsterdam = { [==[암스테르담 장인 코르넬리스는 상아 장식 주문을 받고도 그 재료의 출처를 설명하지 못한다. 역사적 상품 교역과 코끼리에게 돌아간 대가를 함께 기록하려 한다.]==], [==[상아 납품이 기록되었다. 코르넬리스는 장식품의 가격과 동물의 생태가 같은 가치로 환원될 수 없음을 적었다.]==] },
	q_west_africa_tour = { [==[서아프리카의 기록자 아마는 기니만 해안의 여러 사회가 서로 다른 역사와 교역을 지녔다고 설명한다. 넓어진 항구 방문 경험을 통해 해안의 삶과 기록을 비교할 토대를 만들자.]==], [==[항구 방문 목표를 채웠다. 아마는 실제 기항지 기록과 기니만 지리 자료를 나누어 보관했다.]==] },
	q_cloves_london = { [==[런던 약종상 윌리엄은 정향의 민간 요법을 적은 편지를 받는다. 치료 효과를 약속하기 전에 향신료의 정체와 당시 쓰임부터 비교하려 한다.]==], [==[정향이 입고되어 윌리엄은 향료와 민간 요법에 관한 주장을 따로 기록했다. 치료 결과는 단정하지 않았다.]==] },
	q_nutmeg_amsterdam = { [==[암스테르담 향료상 야니케는 육두구 가격이 바뀔 때마다 거래처와 다툰다. 희귀 향신료의 산지와 중개 경로를 알아볼 주문을 준비한다.]==], [==[육두구를 받은 야니케는 향료의 거래 내역을 정리했다. 가격과 향의 차이를 비교할 자료가 마련되었다.]==] },
