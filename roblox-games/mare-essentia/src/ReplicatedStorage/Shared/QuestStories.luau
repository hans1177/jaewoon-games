	q_rg_east_asia_1 = { [==[광저우의 천은 같은 은의 무게를 서로 다르게 적은 두 문서를 받았다. 은 주문을 마친 뒤 장부를 비교하자.]==], [==[은 거래를 마쳤다. 천은 도장의 그림이 히메지 성의 문양과 닮았다는 중개상의 주장을 기록했다.]==] },
