	q_tahiti_cloth = { [==[파페에테 직물 장인 모아나는 나무껍질 천과 수입 옷감의 문양을 비교한다. 전통을 지우지 않고 새 직물의 쓰임을 기록하려 한다.]==], [==[옷감이 파페에테에 도착했다. 모아나는 기존 직물과 수입 재료를 구분해 공예 견본을 준비했다.]==] },
