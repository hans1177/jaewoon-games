	q_people_ruler = { [==[왕관은 무겁다. 그 무게를 감당한 사람과 감당 못한 사람의 이름 열 개가 필요하다. 그 열 이름이 항구가 왜 지금 이 모양인지 알려 준다.]==], [==[열 번째 군주의 이름이 올랐다. 도시의 성곽이 갑자기 사람 얼굴로 보였다.]==] },
	q_people_letters = { [==[펜과 악보는 칼보다 느리지만 더 멀리 간다. 여섯 사람의 이름이 한 시대의 노래와 글을 대표한다. 선술집에서 흘러나오는 가락의 작곡자 이름을 알게 되는 날이다.]==], [==[여섯 번째 이름이 적히자 어디선가 낯익은 가락이 들려오는 듯했다.]==] },
	q_talk_1 = { [==[이름을 적는 것과 이야기를 듣는 것은 다르다. 인물과 대화하면 책에 없는 한마디를 얻을 수 있다. 다섯 번의 대화는 다섯 개의 숨은 쪽이다.]==], [==[다섯 번째 대화가 끝났다. 당신은 노트에 적지 못한 한마디를 마음에 넣었다.]==] },
	q_talk_2 = { [==[스무 번쯤 대화하면 단골이 된다. 항구 사람들은 당신이 오면 의자를 먼저 빼 준다. 이야기는 의자를 내주는 사람에게만 열린다.]==], [==[스무 번째 대화가 끝났다. 객석 맨 앞 의자에 당신 이름의 명패가 놓여 있었다.]==] },
	q_talk_3 = { [==[쉰 번의 대화는 쉰 개의 목소리다. 당신은 문서가 아니라 증언을 모았다. 구술사는 그 목소리들의 합창이다.]==], [==[쉰 번째 대화가 끝나자 쉰 개의 목소리가 한꺼번에 기억 속에서 울렸다.]==] },
	q_order_1 = { [==[항구가 밤에도 조용한 건 누군가 순찰하기 때문이다. 처음 순찰대를 보내는 날 당신은 이 항구가 얼마나 어두웠는지 알게 된다.]==], [==[세 번째 순찰대가 돌아오자 선술집 주인이 처음으로 문을 늦게 닫았다.]==] },
	q_order_2 = { [==[열 번의 순찰이 쌓이면 주민들이 먼저 인사를 건넨다. 항구의 파수꾼은 칭찬을 바라지 않지만 인사에는 약하다.]==], [==[열 번째 순찰이 끝나자 빵집 아주머니가 빵을 한 덩이 건네며 말했다. "밤새 수고했어요."]==] },
	q_order_3 = { [==[스물다섯 번의 순찰은 항구의 기억이 되었다. 아이들은 순찰대 행렬을 따라 걸으며 정의라는 말을 배운다. 치안관은 한 사람이 아니라 하나의 습관이다.]==], [==[스물다섯 번째 순찰이 끝나자 부두의 아이들이 순찰 놀이를 시작했다.]==] },
	q_era_2 = { [==[대항해의 문은 두 가지 열쇠로 열린다. 하나는 용기, 다른 하나는 지식이다. 문이 열린 뒤에야 비로소 사람들은 그 문 뒤에 무엇이 있는지 알게 된다.]==], [==[문이 열렸다. 항구의 늙은 항해사가 "우리 때는 문이 없었다"고 중얼거렸다.]==] },
	q_era_3 = { [==[과학 혁명은 한 사람의 발견이 아니라 서로를 의심한 사람들의 대화다. 증인은 혁명을 일으키지 않아도 증언해야 한다. 당신은 지금 그 증인석에 앉아 있다.]==], [==[혁명의 증인으로 이름이 올랐다. 이름 아래 한 줄이 적혔다. "보았다."]==] },
	q_era_4 = { [==[계몽의 빛은 어둠이 있던 곳에서만 보인다. 당신이 이해한 지식이 늘수록 그 빛이 닿는 어둠도 선명해진다. 빛을 든 사람은 그림자도 함께 본다.]==], [==[빛이 닿자 오랜 편견 하나가 조용히 무너졌다. 당신은 그 소리를 들었다.]==] },
	q_era_5 = { [==[증기의 새벽이 오면 항구의 소리가 바뀐다. 돛 소리 대신 압력의 숨소리가 퍼진다. 이 시대의 증인이 되는 일은 한 세계의 마지막 저녁을 기록하는 일이기도 하다.]==], [==[새벽이 왔다. 당신은 돛과 증기가 함께 선 마지막 부두에서 오래 서 있었다.]==] },
	q_chr_any = { [==[항구 술집에서 들은 사건이 정말 있었는지 확인하러 가는 일은 소문을 사실로 바꾸는 첫 단계다. 현장 세 곳을 서면 소문과 사실의 거리가 눈에 보이기 시작한다.]==], [==[세 번째 현장의 증언을 적자 서기가 "소문이 이렇게 얇은 줄 몰랐소" 하고 웃었다.]==] },
	q_chr_astronomy = { [==[하늘의 사건은 한 사람의 눈으로는 믿기 어렵다. 같은 밤 서로 다른 항구의 관측자가 같은 별빛을 보았는지 확인하는 일이 필요하다.]==], [==[두 번째 현장에서 다른 관측자의 기록이 맞아떨어졌다. 하늘이 처음으로 증인을 얻었다.]==] },
	q_chr_medicine = { [==[역병이 번진 항구와 치료가 시작된 항구는 같은 해에 존재했다. 두 곳의 이야기를 나란히 적어야 한 시대의 의학이 어디까지 왔는지 알 수 있다.]==], [==[두 번째 현장에서 의사가 눈물을 보이며 말했다. "기록해 줘서 고맙소. 잊히는 게 제일 무서웠소."]==] },
	q_chr_geography = { [==[새 바다가 열린 날의 항구는 그날 평소와 다름없이 시장을 열었다고 한다. 역사는 늘 평범한 아침에 시작된다. 그 아침의 기록을 직접 보러 간다.]==], [==[두 번째 현장의 갑 위에서 당신은 지도가 바뀐 날의 바람을 맞았다.]==] },
	q_chr_navigation = { [==[항해술이 바뀐 날은 한 척의 배가 처음으로 늘 가던 길 대신 다른 길을 선택한 순간이었다. 그 항구의 늙은 선원들이 아직 그날을 기억한다.]==], [==[두 번째 현장의 늙은 선원이 말했다. "그날 아무도 믿지 않았지, 그가 돌아올 때까지는."]==] },
	q_chr_commerce = { [==[시장이 뒤집힌 날은 누군가에게는 파산이고 누군가에게는 기회였다. 같은 사건의 두 얼굴을 모두 적어야 진짜 기록이 된다.]==], [==[두 번째 현장에서 한 상인은 울었고 한 상인은 웃었다. 당신은 둘의 말을 같은 쪽에 적었다.]==] },
	q_chr_history = { [==[전쟁과 정치의 현장은 승자의 기록과 패자의 기록이 다르다. 네 곳을 돌면 같은 날을 다르게 기억하는 사람들의 목소리가 쌓인다. 진실은 그 틈에 있다.]==], [==[네 번째 현장에서 두 개의 기록이 만나 하나의 문장이 되었다. 당신은 그 문장을 오래 읽었다.]==] },
	q_chr_architecture = { [==[무너진 도시가 다시 설 때 사람들은 이전보다 높게 짓지 않았다. 더 오래 가도록 지었다. 현장 두 곳에서 그 선택의 흔적을 찾는다.]==], [==[두 번째 현장의 새 벽돌 사이에서 옛 벽의 그을음이 보였다. 도시는 잊지 않고 짓는 중이었다.]==] },
	q_chr_10 = { [==[열 곳의 현장을 모두 돌면 당신은 더 이상 소문을 옮기는 사람이 아니다. 시대의 목격자 중 가장 많이 걸은 사람이 된다. 연대기 수집가라는 이름은 걸어서 얻는 것이다.]==], [==[열 번째 현장을 적은 날 당신의 장부는 한 권의 짧은 역사서가 되었다.]==] },
	q_field_north_sea_1 = { [==[포스 만 어부가 셀키 전승을 들려주며 물범이 사라진 물길을 가리킨다. 물범의 실제 서식지를 확인해 전승과 관찰을 구분하자.]==], [==[물범의 이동 기록을 얻었다. 어부는 돌기둥 방향을 표시한 옛 지도를 내민다.]==] },
	q_field_north_sea_2 = { [==[솔즈베리의 거석에는 고대 의례와 천체 관측에 관한 여러 해석이 있다. 스톤헨지의 배치를 확인해 지도에 적힌 방향과 대조하자.]==], [==[거석 배치를 기록했다. 지도에 적힌 바다의 시간표를 확인하려면 조석 기록이 필요하다.]==] },
	q_field_north_sea_3 = { [==[런던의 수로 안내자는 지도 속 기호를 조수 기록과 비교해 보자고 한다. 실제 물때를 관찰해 항해에 쓸 수 있는 기록을 남기자.]==], [==[조석 관측을 정리했다. 지도 뒷면의 로마식 지명이 북쪽 방벽 조사로 이어진다.]==] },
	q_field_north_sea_4 = { [==[로마 시대 북쪽 경계를 지켰던 방벽은 후대의 전승과도 얽혀 있다. 실제 돌 구조를 관찰해 오래된 지도에 적힌 시대를 구별하자.]==], [==[방벽 기록을 얻었다. 서로 다른 시대의 위치 기록을 비교하려면 측량 도구의 원리를 알아야 한다.]==] },
	q_field_north_sea_5 = { [==[런던의 항해사는 육분의와 오래된 해도를 나란히 놓는다. 도구를 조사해 측량과 전승이 뒤섞인 항로 일지를 정리하자.]==], [==[육분의 기록으로 항해 자료를 정리했다. 셀키 전승은 전승으로, 관측과 유적은 실제 증거로 남겼다.]==] },
	q_field_baltic_1 = { [==[코펜하겐의 상인은 호박 속 벌레를 보이며 바다의 눈물이라는 옛 이야기를 전한다. 해안에서 호박 표본을 찾아 거래 장부의 첫 단서를 확인하자.]==], [==[호박 표본을 기록했다. 장부의 북쪽 선박 그림이 베르겐으로 이어진다.]==] },
	q_field_baltic_2 = { [==[베르겐에서 북유럽 사가의 항해담과 실제 바이킹 배의 구조를 비교하자는 제보가 왔다. 배의 흔적을 조사하자.]==], [==[선박의 구조를 기록했다. 장인은 철 부품과 광산 거래의 기록을 살펴보라고 한다.]==] },
	q_field_baltic_3 = { [==[스웨덴 철을 둘러싼 상인들의 가격표가 서로 다르다. 광산에서 실제 자원과 생산의 흔적을 확인하자.]==], [==[철광 기록을 확보했다. 운송 장부에 남은 별 그림이 다음 항해의 실마리다.]==] },
	q_field_baltic_4 = { [==[북쪽 선원이 별의 이름을 서로 다르게 부른다. 오리온자리를 관측해 구술과 실제 별자리 위치를 구분하자.]==], [==[별 관측표를 만들었다. 그 표와 함께 팔룬에서 온 구리 장부를 받았다.]==] },
	q_field_baltic_5 = { [==[팔룬 광산의 붉은 광석에는 북쪽 도시의 자원 교역사가 담겨 있다. 구리 표본과 운송 기록을 확인하자.]==], [==[구리의 기록까지 갖췄다. 호박·배·철·별·구리로 북방 교역의 흐름을 정리했다.]==] },
	q_field_red_sea_1 = { [==[오랑의 어부가 붉은 날개를 항해의 징조로 여기는 이야기를 들려준다. 홍학의 실제 먹이활동과 이동을 관찰하자.]==], [==[홍학을 기록했다. 어부가 카르타고의 옛 동전 그림을 건넨다.]==] },
	q_field_red_sea_2 = { [==[카르타고의 해상 교역 역사를 떠올리게 하는 낡은 동전 그림이 발견됐다. 실제 동전의 문양과 유적을 비교하자.]==], [==[동전 기록을 남겼다. 상인은 아덴을 거치는 옛 교역로의 해도를 보여 준다.]==] },
	q_field_red_sea_3 = { [==[아덴의 해도에는 홍해와 인도양을 잇는 물길이 그려져 있다. 실제 지형을 조사해 옛 항로의 지리적 배경을 알아보자.]==], [==[홍해 물길을 기록했다. 제다 선원이 산호초에서 거대한 생물을 보았다는 제보를 전한다.]==] },
	q_field_red_sea_4 = { [==[선원들이 바다 괴물이라고 부른 것은 어떤 생물일까. 제다에서 고래상어의 실제 모습을 관찰해 과장된 이야기와 구별하자.]==], [==[고래상어를 기록했다. 상인은 페르시아 왕궁의 옛 교역 기록을 조사하자고 한다.]==] },
	q_field_red_sea_5 = { [==[페르세폴리스의 왕궁 유적에는 고대 제국의 권력과 교류 흔적이 남아 있다. 기둥과 궁전 터를 답사해 해상 기록과 구분해 정리하자.]==], [==[왕궁 유적 기록을 남겼다. 북아프리카·홍해·페르시아의 교류를 서로 다른 시대의 자료로 엮었다.]==] },
	q_field_west_africa_1 = { [==[세네갈 강 어귀에서 건조한 바람 때문에 배가 늦어진다는 제보가 왔다. 하르마탄을 관측해 바람의 실제 영향을 기록하자.]==], [==[바람의 기록을 확보했다. 어민은 비사고스의 뿌리 숲이 물길을 알려 준다고 한다.]==] },
	q_field_west_africa_2 = { [==[비사고스 맹그로브는 물과 땅의 경계에 산다. 어민의 증언을 따라 뿌리와 물길을 관찰하자.]==], [==[맹그로브 기록을 남겼다. 항해 일지의 고레 섬 이름이 다음 조사로 이어진다.]==] },
	q_field_west_africa_3 = { [==[고레 섬의 역사에는 대서양 노예무역과 관련된 고통의 기억이 있다. 현장을 찾아 장소와 사람의 역사를 존중하며 기록하자.]==], [==[섬의 기억을 기록했다. 비슷한 해안 요새의 기록을 비교하기 위해 엘미나로 향한다.]==] },
	q_field_west_africa_4 = { [==[엘미나 성은 해안 교역과 노예무역의 역사를 함께 지닌다. 요새 구조와 그곳에서 일어난 일을 구분해 조사하자.]==], [==[엘미나 기록을 남겼다. 이제 해안 밖 베닌 왕국 방향의 자연과 교류 경로를 알아본다.]==] },
	q_field_west_africa_5 = { [==[베닌 내륙으로 이어지는 길에서 코끼리의 흔적을 조사한다. 상아 거래의 역사와 살아 있는 동물의 생태를 구분해 기록하자.]==], [==[코끼리 관찰을 마쳤다. 항로의 기록에는 자연, 교역, 사람들의 역사적 피해가 함께 남았다.]==] },
