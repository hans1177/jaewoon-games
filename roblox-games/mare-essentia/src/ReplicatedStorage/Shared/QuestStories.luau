	q_cod_bergen = { [==[베르겐 창고지기 아스트리드는 북방 어업이 부진하다는 편지를 읽는다. 건조 대구 교역으로 이어진 식량 창고에 생선을 보충해야 한다.]==], [==[아스트리드는 생선 입고를 보존 식품 장부에 기록했다. 겨울 식량 준비의 첫 부족분을 채웠다.]==] },
