	q_kn_art = { [==[화가 마리아는 완성된 그림만 보던 견습생에게 안료와 제작 과정에도 이야기가 있다고 설명한다. 여러 예술 지식을 이해해 작품을 바라보는 관점을 넓히자.]==], [==[예술 지식 목표를 마쳤다. 마리아는 작품의 재료와 표현, 역사적 배경을 비교할 자료를 남겼다.]==] },
