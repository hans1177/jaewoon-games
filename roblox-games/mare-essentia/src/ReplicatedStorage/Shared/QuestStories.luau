	q_lacquer_london = { [==[런던 수집가는 동방 칠기와 광택만 낸 모조품을 구별하지 못해 속은 적이 있다. 칠기 주문을 통해 공예 기술의 차이를 살펴보려 한다.]==], [==[칠기가 도착해 제작 방식에 관한 질문을 목록에 남겼다. 광택만으로 진품을 단정하지 않기로 했다.]==] },
	q_copper_amsterdam = { [==[암스테르담 금속 장인 바우터는 일본 구리 교역 기록을 읽다가 색만으로 품질을 판단했던 실수를 떠올린다. 새로운 구리 견본을 부탁한다.]==], [==[구리 납품이 기록되었다. 바우터는 산지의 명성보다 재료의 특성을 비교하기로 했다.]==] },
	q_jade_istanbul = { [==[이스탄불 세공사 카이르는 푸른 돌로 인장을 만들라는 주문을 받았으나 옥의 종류를 비교할 견본이 부족하다. 재료부터 알아보려 한다.]==], [==[옥이 도착하자 카이르는 조각 재료 목록을 작성했다. 인장을 제작하기 전에 돌을 비교할 수 있게 되었다.]==] },
