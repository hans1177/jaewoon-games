	q_rg_americas_4 = { [==[철 거래를 마쳐 치첸이트사 기록을 받자. 가상 여행기의 그림이 여러 토착 문명을 혼동했는지 살핀다.]==], [==[치첸이트사 기록을 얻었다. 다음은 다른 도시 테오티우아칸의 자료다.]==] },
	q_rg_americas_5 = { [==[도감 발견 목표를 채워 테오티우아칸 유산을 확보한다. 모든 도시를 하나의 황금 제국으로 묶지 않는다.]==], [==[테오티우아칸 기록을 얻었다. 안데스의 마추픽추가 마지막 비교 자료다.]==] },
	q_rg_americas_6 = { [==[항구 방문 목표를 채워 마추픽추 기록을 받자. 라몬은 엘도라도 여행기의 출처를 다시 검토한다.]==], [==[황금이 아닌 도시라는 결론을 남겼다. 가상 여행기는 서로 다른 사회의 역사를 뒤섞었고 실제 유산들은 각자의 기록으로 보존됐다.]==] },
	q_stock_1 = { [==[암스테르담 거래소에는 종이 한 장이 배 한 척을 사고판다. 처음 거래하는 사람은 숫자를 보지 않고 손을 본다. 상대가 믿을 만한 사람인지 읽는 법을 배우는 날이다.]==], [==[세 번째 거래가 끝났다. 서기가 당신의 서명을 오래 쳐다보았다.]==] },
	q_stock_2 = { [==[배당은 일하지 않은 돈이 아니다. 누군가의 성실이 시간을 거쳐 돌아오는 것이다. 처음 받는 천 코인은 다른 돈과 맛이 다르다.]==], [==[첫 배당 영수증을 받았다. 당신은 그 종이를 액자에 넣을지 한참 고민했다.]==] },
	q_stock_3 = { [==[스무 번 거래한 사람은 이제 시장의 분위기를 읽는다. 손이 빠른 사람이 아니라 숨을 멈출 줄 아는 사람이 큰손이 된다. 거래소의 늙은 중개인이 지켜본다.]==], [==[스무 번째 거래가 끝나자 늙은 중개인이 말했다. "이제 자네는 숫자를 듣는군."]==] },
	q_people_1 = { [==[인물 백과의 편집자 로자는 낡은 항구 일지에서 직업만 적혀 있고 이름이 지워진 사람들을 발견한다. 유명한 사람뿐 아니라 각자의 삶을 기록하는 책을 만들고 싶다. 인물 백과에 첫 이름들을 등록하자.]==], [==[인물 기록 목표를 채웠다. 로자는 이름과 알려진 활동을 구분해 기록하는 첫 목록을 준비했다. 이제 서로 다른 직업의 삶도 살펴볼 차례다.]==] },
	q_people_2 = { [==[로자는 선주와 학자, 장인에 관한 자료가 서로 다른 책에 흩어져 있다는 사실을 알아차린다. 어느 한 사람의 이야기만으로 시대를 설명하지 않기 위해 인물 백과의 범위를 넓히려 한다.]==], [==[인물 기록이 늘어났다. 로자는 서로 다른 활동을 비교할 목록을 준비했다. 실제로 만나거나 협력했다는 근거가 없는 인물들을 억지로 연결하지 않았다.]==] },
	q_people_3 = { [==[출판업자는 유명한 이름만 모으면 책이 잘 팔린다고 말하지만 로자는 반대한다. 항해와 교역, 연구와 예술을 함께 바라볼 때 시대의 여러 모습을 알 수 있다고 믿는다. 인물 백과에 더 많은 기록을 남기자.]==], [==[인물 기록 목표를 달성했다. 로자는 시대와 직업을 비교할 자료를 확보했다. 이제 마지막 권을 위해 기록의 범위를 더 넓히려 한다.]==] },
	q_people_4 = { [==[로자는 마지막 원고에 군주와 항해자, 학자와 사략선장의 기록을 함께 싣는다. 명성과 실제 행적이 반드시 일치하지 않는다는 것을 보여 주고 싶다. 인물 백과의 마지막 등록 목표를 완료하자.]==], [==[인물 등록 목표를 마쳤다. 로자는 업적과 행적의 기록, 아직 판단하기 어려운 부분을 나누어 남겼다. 책의 마지막 장에는 다음 세대가 추가할 여백이 마련되었다.]==] },
	q_people_explorer = { [==[지도상 이네스는 유럽 항해자의 지도뿐 아니라 오래전부터 바다를 오가던 여러 지역의 항해 지식에도 관심을 가진다. 항해가 한 사람의 공로만으로 이루어졌다는 이야기에 의문을 품는다. 탐험가와 항해가의 기록을 모으자.]==], [==[탐험가·항해가 기록 목표를 채웠다. 이네스는 항로와 탐험의 배경을 비교할 목록을 마련했다. 이미 사람이 살던 땅을 무인도로 기록하지 않기로 했다.]==] },
	q_people_science = { [==[천문 관측 조수 파벨은 같은 하늘을 보아도 학자들의 결론이 달랐던 까닭을 묻는다. 과학자와 지도 제작자의 활동을 비교하면 어떤 지식이 발전하고 수정됐는지 살펴볼 수 있다. 관련 인물 기록을 모으자.]==], [==[과학자·지도 제작자 기록을 확보했다. 파벨은 관측과 연구의 차이를 살펴볼 자료를 정리했다. 이름을 모았다는 사실만으로 연구를 입증했다고 주장하지 않았다.]==] },
	q_people_merchant = { [==[견습 서기 아민은 환어음과 거래 장부에서 상인마다 다른 방식으로 신용을 쌓는다는 점을 발견한다. 이익뿐 아니라 계약과 교역이 사람들에게 미친 영향도 알고 싶다. 상인과 금융가의 기록을 모으자.]==], [==[상인·금융가 기록 목표를 달성했다. 아민은 금융과 교역의 변화에 관한 비교 목록을 준비했다.]==] },
	q_people_pirate = { [==[항구 법률 서기 브루노는 사략 허가장과 해적에 관한 재판 기록의 차이를 살펴본다. 낭만적인 해적담만으로는 약탈의 피해와 당시의 법을 설명할 수 없다. 해적과 사략선장의 인물 기록을 모으자.]==], [==[해적·사략선장 기록을 확보했다. 브루노는 전승 속 영웅담과 실제 행적, 피해의 기록을 구별할 자료를 마련했다.]==] },
	q_people_ruler = { [==[서기 레일라는 왕관이 그려진 여러 항구의 기록을 비교하며 같은 직함을 가진 군주라도 제도와 정책은 달랐다는 사실에 주목한다. 군주와 정치가의 기록을 모아 항구와 권력의 관계를 살펴보자.]==], [==[군주·정치가 기록 목표를 채웠다. 레일라는 국가의 제도와 각 인물의 알려진 행적을 구분해 검토할 목록을 남겼다.]==] },
	q_people_letters = { [==[악보 필사공 엘리나는 선술집에서 들은 노래와 인쇄된 시에 서로 다른 시대의 표현이 남아 있다는 것을 발견한다. 작품의 실제 작가와 후대에 전해진 이야기를 구별하고 싶다. 문학가와 음악가의 기록을 모으자.]==], [==[문학·음악 인물 기록을 확보했다. 엘리나는 작품과 창작자의 관계를 살펴볼 자료를 마련했다. 확인되지 않은 작품의 귀속은 별도로 검토하기로 했다.]==] },
	q_talk_1 = { [==[통역관 하루는 인물 백과의 짧은 소개만으로는 각 사람이 품은 고민을 이해하기 어렵다고 말한다. 항구에서 인물들의 이야기를 직접 들어 보는 일을 시작하자.]==], [==[인물 대화 목표를 달성했다. 하루는 게임 속 대화와 실제 역사 인물의 기록을 혼동하지 않도록 일지를 나누어 정리했다.]==] },
	q_talk_2 = { [==[하루는 여러 인물의 이야기를 듣다 보면 같은 항구에서도 서로 다른 관점이 드러난다고 말한다. 자신의 익숙한 질문만 되풀이하지 않고 다른 목소리도 들어 보려 한다. 인물 대화 기록을 더 쌓자.]==], [==[추가 대화 목표를 채웠다. 하루는 들은 이야기들을 비교할 참고 목록을 마련했다. 다음에는 더 넓은 범위의 목소리를 모을 차례다.]==] },
	q_talk_3 = { [==[하루와 기록자 로자는 구술 기록을 책으로 만들 때 기억과 사실을 구분하는 것이 중요하다고 이야기한다. 더 많은 인물과 대화해 세계의 다양한 관점을 모으자.]==], [==[인물 대화 목표를 완료했다. 로자는 가상의 대화와 확인 가능한 역사 자료를 분리해 보관했다. 서로 다른 목소리를 한 사람의 주장으로 바꾸지 않았다.]==] },
	q_order_1 = { [==[항만 서기 로자는 밤의 부두에서 잃어버린 물건을 찾는 주민의 청원을 읽는다. 주민의 신뢰를 얻으려면 순찰을 보낸 기록부터 남겨야 한다. 첫 순찰 의뢰를 맡아 달라.]==], [==[순찰 파견 목표를 달성했다. 로자는 파견 기록과 사건 해결 기록을 구별하며 다음 준비표를 펼쳤다.]==] },
	q_order_2 = { [==[로자는 순찰 요청이 많은 구역과 적은 구역의 장부를 비교한다. 상인의 목소리만 들으면 다른 주민의 불편을 놓칠 수 있다. 순찰 파견 기록을 더 쌓자.]==], [==[추가 순찰 파견 기록이 채워졌다. 로자는 주민 청원을 따로 모아 마지막 치안 의뢰의 참고 자료로 남겼다.]==] },
	q_order_3 = { [==[항만 회의에서 로자는 순찰 횟수만으로 공정한 치안이 보장되지는 않는다고 말한다. 오래 이어질 제도에는 기록과 책임이 필요하다. 마지막 순찰 파견 의뢰를 마치자.]==], [==[순찰 파견 목표를 완료했다. 로자는 주민의 안전과 신뢰는 앞으로도 확인해야 할 책임이라고 적었다.]==] },
	q_era_2 = { [==[대항해의 문은 두 가지 열쇠로 열린다. 하나는 용기, 다른 하나는 지식이다. 문이 열린 뒤에야 비로소 사람들은 그 문 뒤에 무엇이 있는지 알게 된다.]==], [==[문이 열렸다. 항구의 늙은 항해사가 "우리 때는 문이 없었다"고 중얼거렸다.]==] },
	q_era_3 = { [==[과학 혁명은 한 사람의 발견이 아니라 서로를 의심한 사람들의 대화다. 증인은 혁명을 일으키지 않아도 증언해야 한다. 당신은 지금 그 증인석에 앉아 있다.]==], [==[혁명의 증인으로 이름이 올랐다. 이름 아래 한 줄이 적혔다. "보았다."]==] },
	q_era_4 = { [==[계몽의 빛은 어둠이 있던 곳에서만 보인다. 당신이 이해한 지식이 늘수록 그 빛이 닿는 어둠도 선명해진다. 빛을 든 사람은 그림자도 함께 본다.]==], [==[빛이 닿자 오랜 편견 하나가 조용히 무너졌다. 당신은 그 소리를 들었다.]==] },
	q_era_5 = { [==[증기의 새벽이 오면 항구의 소리가 바뀐다. 돛 소리 대신 압력의 숨소리가 퍼진다. 이 시대의 증인이 되는 일은 한 세계의 마지막 저녁을 기록하는 일이기도 하다.]==], [==[새벽이 왔다. 당신은 돛과 증기가 함께 선 마지막 부두에서 오래 서 있었다.]==] },
	q_chr_any = { [==[항구 술집에서 들은 사건이 정말 있었는지 확인하러 가는 일은 소문을 사실로 바꾸는 첫 단계다. 현장 세 곳을 서면 소문과 사실의 거리가 눈에 보이기 시작한다.]==], [==[세 번째 현장의 증언을 적자 서기가 "소문이 이렇게 얇은 줄 몰랐소" 하고 웃었다.]==] },
	q_chr_astronomy = { [==[하늘의 사건은 한 사람의 눈으로는 믿기 어렵다. 같은 밤 서로 다른 항구의 관측자가 같은 별빛을 보았는지 확인하는 일이 필요하다.]==], [==[두 번째 현장에서 다른 관측자의 기록이 맞아떨어졌다. 하늘이 처음으로 증인을 얻었다.]==] },
	q_chr_medicine = { [==[역병이 번진 항구와 치료가 시작된 항구는 같은 해에 존재했다. 두 곳의 이야기를 나란히 적어야 한 시대의 의학이 어디까지 왔는지 알 수 있다.]==], [==[두 번째 현장에서 의사가 눈물을 보이며 말했다. "기록해 줘서 고맙소. 잊히는 게 제일 무서웠소."]==] },
	q_chr_geography = { [==[새 바다가 열린 날의 항구는 그날 평소와 다름없이 시장을 열었다고 한다. 역사는 늘 평범한 아침에 시작된다. 그 아침의 기록을 직접 보러 간다.]==], [==[두 번째 현장의 갑 위에서 당신은 지도가 바뀐 날의 바람을 맞았다.]==] },
	q_chr_navigation = { [==[항해술이 바뀐 날은 한 척의 배가 처음으로 늘 가던 길 대신 다른 길을 선택한 순간이었다. 그 항구의 늙은 선원들이 아직 그날을 기억한다.]==], [==[두 번째 현장의 늙은 선원이 말했다. "그날 아무도 믿지 않았지, 그가 돌아올 때까지는."]==] },
	q_chr_commerce = { [==[시장이 뒤집힌 날은 누군가에게는 파산이고 누군가에게는 기회였다. 같은 사건의 두 얼굴을 모두 적어야 진짜 기록이 된다.]==], [==[두 번째 현장에서 한 상인은 울었고 한 상인은 웃었다. 당신은 둘의 말을 같은 쪽에 적었다.]==] },
	q_chr_history = { [==[전쟁과 정치의 현장은 승자의 기록과 패자의 기록이 다르다. 네 곳을 돌면 같은 날을 다르게 기억하는 사람들의 목소리가 쌓인다. 진실은 그 틈에 있다.]==], [==[네 번째 현장에서 두 개의 기록이 만나 하나의 문장이 되었다. 당신은 그 문장을 오래 읽었다.]==] },
