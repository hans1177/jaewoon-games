	q_st_johns_cloth = { [==[세인트존스의 모린은 북대서양 어선에서 돌아온 가족의 해진 외투를 고친다. 추위와 물보라를 견디는 어업 공동체의 옷감 보급을 부탁한다.]==], [==[옷감이 도착하자 모린은 수선할 외투의 목록을 펼쳤다. 다음 출항을 준비하는 가족에게 보급이 이어졌다.]==] },
