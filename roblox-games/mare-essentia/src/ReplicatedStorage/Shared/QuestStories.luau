	q_guano_hamburg = { [==[함부르크 근교 농부 오토는 수확이 줄어드는 밭을 걱정한다. 바닷새 배설물이 축적된 구아노의 농업 교역 기록을 읽고 비교 재료를 요청한다.]==], [==[구아노가 도착하자 오토는 농업 재료표를 정리했다. 실제 수확량은 다음 계절의 확인 과제로 남았다.]==] },
