	q_sealskin_canton = { [==[광저우 상인 왕은 북방에서 들어온 물개 가죽의 가격표에 산지 기록이 없음을 발견한다. 역사적 모피 거래와 동물의 생태를 함께 살펴보려 한다.]==], [==[물개 가죽 납품 기록이 남았다. 왕은 상품 가격과 바다 생물의 생태를 구별했다.]==] },
