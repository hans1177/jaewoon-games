	q_people_letters = { [==[펜과 악보는 칼보다 느리지만 더 멀리 간다. 여섯 사람의 이름이 한 시대의 노래와 글을 대표한다. 선술집에서 흘러나오는 가락의 작곡자 이름을 알게 되는 날이다.]==], [==[여섯 번째 이름이 적히자 어디선가 낯익은 가락이 들려오는 듯했다.]==] },
	q_talk_1 = { [==[이름을 적는 것과 이야기를 듣는 것은 다르다. 인물과 대화하면 책에 없는 한마디를 얻을 수 있다. 다섯 번의 대화는 다섯 개의 숨은 쪽이다.]==], [==[다섯 번째 대화가 끝났다. 당신은 노트에 적지 못한 한마디를 마음에 넣었다.]==] },
	q_talk_2 = { [==[스무 번쯤 대화하면 단골이 된다. 항구 사람들은 당신이 오면 의자를 먼저 빼 준다. 이야기는 의자를 내주는 사람에게만 열린다.]==], [==[스무 번째 대화가 끝났다. 객석 맨 앞 의자에 당신 이름의 명패가 놓여 있었다.]==] },
	q_talk_3 = { [==[쉰 번의 대화는 쉰 개의 목소리다. 당신은 문서가 아니라 증언을 모았다. 구술사는 그 목소리들의 합창이다.]==], [==[쉰 번째 대화가 끝나자 쉰 개의 목소리가 한꺼번에 기억 속에서 울렸다.]==] },
	q_order_1 = { [==[항구가 밤에도 조용한 건 누군가 순찰하기 때문이다. 처음 순찰대를 보내는 날 당신은 이 항구가 얼마나 어두웠는지 알게 된다.]==], [==[세 번째 순찰대가 돌아오자 선술집 주인이 처음으로 문을 늦게 닫았다.]==] },
	q_order_2 = { [==[열 번의 순찰이 쌓이면 주민들이 먼저 인사를 건넨다. 항구의 파수꾼은 칭찬을 바라지 않지만 인사에는 약하다.]==], [==[열 번째 순찰이 끝나자 빵집 아주머니가 빵을 한 덩이 건네며 말했다. "밤새 수고했어요."]==] },
	q_order_3 = { [==[스물다섯 번의 순찰은 항구의 기억이 되었다. 아이들은 순찰대 행렬을 따라 걸으며 정의라는 말을 배운다. 치안관은 한 사람이 아니라 하나의 습관이다.]==], [==[스물다섯 번째 순찰이 끝나자 부두의 아이들이 순찰 놀이를 시작했다.]==] },
	q_era_2 = { [==[대항해의 문은 두 가지 열쇠로 열린다. 하나는 용기, 다른 하나는 지식이다. 문이 열린 뒤에야 비로소 사람들은 그 문 뒤에 무엇이 있는지 알게 된다.]==], [==[문이 열렸다. 항구의 늙은 항해사가 "우리 때는 문이 없었다"고 중얼거렸다.]==] },
	q_era_3 = { [==[과학 혁명은 한 사람의 발견이 아니라 서로를 의심한 사람들의 대화다. 증인은 혁명을 일으키지 않아도 증언해야 한다. 당신은 지금 그 증인석에 앉아 있다.]==], [==[혁명의 증인으로 이름이 올랐다. 이름 아래 한 줄이 적혔다. "보았다."]==] },
	q_era_4 = { [==[계몽의 빛은 어둠이 있던 곳에서만 보인다. 당신이 이해한 지식이 늘수록 그 빛이 닿는 어둠도 선명해진다. 빛을 든 사람은 그림자도 함께 본다.]==], [==[빛이 닿자 오랜 편견 하나가 조용히 무너졌다. 당신은 그 소리를 들었다.]==] },
	q_era_5 = { [==[증기의 새벽이 오면 항구의 소리가 바뀐다. 돛 소리 대신 압력의 숨소리가 퍼진다. 이 시대의 증인이 되는 일은 한 세계의 마지막 저녁을 기록하는 일이기도 하다.]==], [==[새벽이 왔다. 당신은 돛과 증기가 함께 선 마지막 부두에서 오래 서 있었다.]==] },
	q_chr_any = { [==[항구 술집에서 들은 사건이 정말 있었는지 확인하러 가는 일은 소문을 사실로 바꾸는 첫 단계다. 현장 세 곳을 서면 소문과 사실의 거리가 눈에 보이기 시작한다.]==], [==[세 번째 현장의 증언을 적자 서기가 "소문이 이렇게 얇은 줄 몰랐소" 하고 웃었다.]==] },
	q_chr_astronomy = { [==[하늘의 사건은 한 사람의 눈으로는 믿기 어렵다. 같은 밤 서로 다른 항구의 관측자가 같은 별빛을 보았는지 확인하는 일이 필요하다.]==], [==[두 번째 현장에서 다른 관측자의 기록이 맞아떨어졌다. 하늘이 처음으로 증인을 얻었다.]==] },
	q_chr_medicine = { [==[역병이 번진 항구와 치료가 시작된 항구는 같은 해에 존재했다. 두 곳의 이야기를 나란히 적어야 한 시대의 의학이 어디까지 왔는지 알 수 있다.]==], [==[두 번째 현장에서 의사가 눈물을 보이며 말했다. "기록해 줘서 고맙소. 잊히는 게 제일 무서웠소."]==] },
	q_chr_geography = { [==[새 바다가 열린 날의 항구는 그날 평소와 다름없이 시장을 열었다고 한다. 역사는 늘 평범한 아침에 시작된다. 그 아침의 기록을 직접 보러 간다.]==], [==[두 번째 현장의 갑 위에서 당신은 지도가 바뀐 날의 바람을 맞았다.]==] },
	q_chr_navigation = { [==[항해술이 바뀐 날은 한 척의 배가 처음으로 늘 가던 길 대신 다른 길을 선택한 순간이었다. 그 항구의 늙은 선원들이 아직 그날을 기억한다.]==], [==[두 번째 현장의 늙은 선원이 말했다. "그날 아무도 믿지 않았지, 그가 돌아올 때까지는."]==] },
	q_chr_commerce = { [==[시장이 뒤집힌 날은 누군가에게는 파산이고 누군가에게는 기회였다. 같은 사건의 두 얼굴을 모두 적어야 진짜 기록이 된다.]==], [==[두 번째 현장에서 한 상인은 울었고 한 상인은 웃었다. 당신은 둘의 말을 같은 쪽에 적었다.]==] },
	q_chr_history = { [==[전쟁과 정치의 현장은 승자의 기록과 패자의 기록이 다르다. 네 곳을 돌면 같은 날을 다르게 기억하는 사람들의 목소리가 쌓인다. 진실은 그 틈에 있다.]==], [==[네 번째 현장에서 두 개의 기록이 만나 하나의 문장이 되었다. 당신은 그 문장을 오래 읽었다.]==] },
	q_chr_architecture = { [==[무너진 도시가 다시 설 때 사람들은 이전보다 높게 짓지 않았다. 더 오래 가도록 지었다. 현장 두 곳에서 그 선택의 흔적을 찾는다.]==], [==[두 번째 현장의 새 벽돌 사이에서 옛 벽의 그을음이 보였다. 도시는 잊지 않고 짓는 중이었다.]==] },
	q_chr_10 = { [==[열 곳의 현장을 모두 돌면 당신은 더 이상 소문을 옮기는 사람이 아니다. 시대의 목격자 중 가장 많이 걸은 사람이 된다. 연대기 수집가라는 이름은 걸어서 얻는 것이다.]==], [==[열 번째 현장을 적은 날 당신의 장부는 한 권의 짧은 역사서가 되었다.]==] },
	q_field_north_sea_1 = { [==[포스 만의 어부 앨리스는 돌아가신 어머니가 셀키였다는 동생의 말을 차마 부정하지 못한다. 물범을 찾아 어머니가 사랑했던 바다의 모습을 기록해 달라고 한다.]==], [==[물범의 기록을 건네자 앨리스는 동생에게 어머니의 이야기를 계속 들려주기로 했다. 어머니의 오래된 거석 그림을 따라 솔즈베리로 향한다.]==] },
	q_field_north_sea_2 = { [==[앨리스의 어머니는 돌기둥 사이로 햇빛이 드는 모습을 그렸다. 솔즈베리에서 스톤헨지의 실제 배치를 살펴 그 그림이 담은 계절의 기억을 찾아보자.]==], [==[스톤헨지 기록을 얻었다. 앨리스는 그림 아래 적힌 물때 이야기를 읽으며 런던의 수로 안내인을 소개한다.]==] },
	q_field_north_sea_3 = { [==[런던의 수로 안내인 토머스는 조수를 읽지 못해 곤경에 처했던 젊은 시절을 떠올린다. 물때를 관측해 초보 선원에게 남길 교본을 도와주자.]==], [==[조수 기록을 얻었다. 토머스는 자신의 스승이 남긴 북쪽 로마 방벽 여행기를 건넨다.]==] },
	q_field_north_sea_4 = { [==[하드리아누스 방벽을 답사하는 노학자는 제국의 경계에서 살아갔던 이름 없는 사람들을 이야기한다. 돌에 남은 구조와 시대의 기록을 살펴보자.]==], [==[방벽의 기록을 남겼다. 노학자는 서로 다른 시대의 여행을 하나의 항해 일지에 엮으려면 측량의 원리도 알아야 한다고 말한다.]==] },
	q_field_north_sea_5 = { [==[런던의 항해사와 육분의를 조사한다. 앨리스의 가족 이야기와 노학자의 여행기는 각각의 기억으로, 측량 자료는 관측의 근거로 정리하자.]==], [==[육분의 기록으로 일지를 마쳤다. 앨리스는 셀키 전승을 지우지 않았다. 동생에게 물범과 바다의 실제 모습을 함께 전할 수 있게 됐다.]==] },
	q_field_baltic_1 = { [==[코펜하겐의 세공 견습생 에리크는 아버지의 가업을 떠날지 고민한다. 바다의 눈물이라는 호박 전승을 듣고 해안의 표본을 조사해 첫 장인의 기록을 만들어 보자.]==], [==[호박 기록을 얻자 에리크는 아버지의 물건이 어디서 왔는지 궁금해졌다. 베르겐의 옛 선박 그림을 건넨다.]==] },
	q_field_baltic_2 = { [==[베르겐의 조선공은 북유럽 사가에 등장하는 항해와 실제 바이킹 배를 구분해 설명한다. 배의 구조를 확인해 에리크의 공예 일지에 남기자.]==], [==[바이킹 배의 기록을 얻었다. 조선공은 철 부품을 만들던 장인들의 이야기를 들려주며 스톡홀름 광산을 소개한다.]==] },
	q_field_baltic_3 = { [==[스웨덴 광부는 철 한 조각이 배와 농기구를 만드는 데 쓰인다고 말한다. 광산의 실제 철을 조사해 값표 뒤에 숨은 노동을 기록하자.]==], [==[철광 기록을 확보했다. 광부는 먼 항구로 떠난 동생이 남긴 오리온 그림을 보여 준다.]==] },
	q_field_baltic_4 = { [==[코펜하겐의 밤, 에리크는 서로 다른 항해자가 같은 별을 다른 이름으로 불렀다는 이야기에 귀를 기울인다. 오리온자리를 관측해 기록하자.]==], [==[별자리 기록을 얻었다. 에리크는 아버지의 호박 장식에 쓰였던 붉은 금속을 알아보기 위해 팔룬으로 향하겠다고 한다.]==] },
	q_field_baltic_5 = { [==[팔룬에서 구리 광석을 조사한다. 에리크는 호박과 금속, 선박, 별을 이어 준 사람들의 기술을 자신의 작품에 담고 싶어 한다.]==], [==[팔룬 구리 기록을 얻었다. 에리크는 가업을 그대로 반복하는 대신 배운 기술을 바탕으로 새 작품을 만들기로 했다. 북방 장인의 이야기가 완성됐다.]==] },
	q_field_red_sea_1 = { [==[오랑의 젊은 여행가 사라는 홍학이 날아오르는 모습을 여행기의 첫 장으로 삼으려 한다. 실제 홍학의 모습을 관찰하고 그 기록을 함께 만들자.]==], [==[홍학 기록을 얻었다. 사라는 다음 장에 옛 카르타고 상인의 이야기를 담겠다며 동전 그림을 펼친다.]==] },
	q_field_red_sea_2 = { [==[튀니스에서 카르타고 동전을 조사한다. 사라는 한때 지중해를 건너던 상인들의 삶을 동전의 문양에서 상상하지만 실제 유물과 창작 장면을 구별하고자 한다.]==], [==[카르타고 기록을 확보했다. 사라의 여행기는 이제 북아프리카를 떠나 홍해로 이어진다.]==] },
	q_field_red_sea_3 = { [==[아덴의 도선사는 홍해로 이어지는 물길을 보여 주며 바람과 바위가 항해자의 계획을 바꾼다고 이야기한다. 실제 지형을 조사하자.]==], [==[홍해 기록을 얻었다. 도선사는 제다의 어부들이 거대한 물고기에 관해 들려줄 이야기가 있다고 한다.]==] },
	q_field_red_sea_4 = { [==[제다 어부는 어린 시절 배 아래를 지나던 고래상어에 압도됐던 기억을 말한다. 큰 몸집이 곧 위험을 뜻하지는 않는다. 실제 생물을 관찰하자.]==], [==[고래상어 기록을 얻었다. 사라는 바다의 경이로움을 책에 담고, 내륙의 오래된 왕궁을 마지막 장으로 삼기로 한다.]==] },
	q_field_red_sea_5 = { [==[페르세폴리스에서 고대 왕궁을 답사한다. 사라는 바다와 내륙을 잇는 여러 시대의 역사에서 여행기의 마지막 장을 완성하려 한다.]==], [==[페르세폴리스 기록을 얻었다. 사라는 고대 도시의 유산과 홍해의 자연을 함께 담은 여행기를 남겼다. 첫 항해의 두려움은 새로운 세계를 향한 호기심으로 바뀌었다.]==] },
	q_field_west_africa_1 = { [==[세네갈 강 어귀의 어민 아와는 건조한 바람이 부는 계절이면 가족의 생업이 달라진다고 한다. 하르마탄의 실제 기록을 만들어 달라고 부탁한다.]==], [==[하르마탄 기록을 얻었다. 아와는 바람을 견디며 살아가는 비사고스의 어민들을 소개한다.]==] },
	q_field_west_africa_2 = { [==[비사고스의 안내인과 맹그로브 뿌리 숲을 조사한다. 나무와 물길은 어민들의 생활을 지탱하는 환경이다. 그들의 설명과 실제 식물 관찰을 함께 기록하자.]==], [==[맹그로브 기록을 얻었다. 안내인은 고레 섬의 역사에 귀를 기울여 달라고 부탁한다.]==] },
	q_field_west_africa_3 = { [==[고레 섬에서 노예무역과 관련된 고통의 역사를 조사한다. 아와는 사람을 숫자와 물품으로만 기억하는 기록을 경계한다. 장소의 실제 유산을 존중하며 기록하자.]==], [==[고레 섬 기록을 얻었다. 아와는 엘미나 성에도 남아 있는 교역과 강제 이주의 역사를 별도로 조사하자고 한다.]==] },
	q_field_west_africa_4 = { [==[엘미나 성을 답사한다. 요새의 건축뿐 아니라 그곳을 거쳐간 사람들의 고통과 역사적 기억도 잊지 말아야 한다.]==], [==[엘미나 성 기록을 얻었다. 아와는 베닌 방향 내륙의 삶과 자연도 해안 무역의 역사만으로 설명할 수 없다고 말한다.]==] },
	q_field_west_africa_5 = { [==[베닌으로 이어지는 내륙 길에서 아프리카코끼리의 생태를 조사한다. 상아 상품의 역사와 살아 있는 동물의 기록은 다르게 남기자.]==], [==[코끼리 기록을 얻었다. 아와는 바람과 숲, 사람들의 고통과 생업을 함께 담은 항해 일지를 마쳤다. 해안의 역사를 거래량만으로 평가하지 않는다는 약속을 남겼다.]==] },
	q_field_east_africa_1 = { [==[몸바사의 어린 어부 하산은 바다뱀 이야기가 무서워 바닷가를 멀리한다. 산호초의 실제 생물을 안전하게 관찰하고 그에게 바다의 다양성을 알려 주자.]==], [==[바다뱀 기록을 얻었다. 하산은 바다가 무섭기만 한 곳은 아니라고 말하며 잔지바르의 장인에게 소개장을 써 준다.]==] },
	q_field_east_africa_2 = { [==[스톤 타운의 장인은 여러 문화의 흔적이 깃든 골목을 보여 준다. 항구의 실제 건축을 조사해 사람들이 바다로 맺은 관계를 기록하자.]==], [==[스톤 타운 기록을 얻었다. 장인은 킬와의 조각 문에서 다른 지역의 기술을 배울 수 있다고 한다.]==] },
	q_field_east_africa_3 = { [==[킬와의 조각 문을 조사한다. 장인은 문양을 단순한 장식이 아니라 장인의 노력과 교류를 보여 주는 기록으로 남겨 달라고 한다.]==], [==[조각 문 기록을 얻었다. 장인은 남쪽 항해를 다녀온 박물학자가 테이블 산의 꽃을 그리고 있었다고 말한다.]==] },
	q_field_east_africa_4 = { [==[테이블 산에서 프로테아를 관찰한다. 박물학자는 먼 항로를 여행하면서도 식물의 이름과 현지인의 설명을 잊지 않으려 한다.]==], [==[프로테아 기록을 얻었다. 박물학자는 이제 희망봉 해안 자체를 조사하자고 제안한다.]==] },
	q_field_east_africa_5 = { [==[희망봉의 해안과 지형을 관찰한다. 유령선 전승처럼 항해자의 공포를 담은 이야기와 실제 지리를 구별하고 남방 여행의 끝을 기록하자.]==], [==[희망봉 기록을 얻었다. 하산에게 전할 일지에는 바다뱀과 항구의 기술, 남쪽의 꽃과 해안이 담겼다. 바다를 이해하는 첫 모험이 끝났다.]==] },
	q_field_south_asia_1 = { [==[코친 어부 라비와 딸 아샤는 고정식 어망을 움직이는 일을 함께 배운다. 어망의 구조를 조사해 세대 사이에 전해지는 기술을 기록하자.]==], [==[어망 기록을 얻었다. 라비는 바람을 기다리는 후추 농부에게 아샤의 여행 이야기를 전해 달라고 한다.]==] },
	q_field_south_asia_2 = { [==[말라바르의 후추 농부는 신밧드의 모험담을 즐겨 이야기하지만 자신의 삶은 덩굴을 가꾸고 수확하는 일에서 시작된다고 말한다. 후추 식물을 조사하자.]==], [==[후추 덩굴 기록을 얻었다. 농부는 해안 사원의 청동 조각을 만든 장인의 전통에 관해 이야기한다.]==] },
	q_field_south_asia_3 = { [==[해안 사원의 청동 신상을 조사한다. 장인의 제작 기술과 신앙의 의미를 존중하며 실제 유물의 기록을 남기자.]==], [==[청동상 기록을 얻었다. 장인의 여행 이야기에는 실론에서 온 푸른 보석이 등장한다.]==] },
	q_field_south_asia_4 = { [==[실론의 보석상은 사파이어의 아름다움보다 원석을 찾아 다듬는 시간이 중요하다고 말한다. 광산의 실제 보석을 조사하자.]==], [==[사파이어 기록을 얻었다. 보석상은 내륙을 여행하며 본 코끼리의 이야기를 전한다.]==] },
	q_field_south_asia_5 = { [==[아그라 방향의 길에서 인도코끼리를 관찰한다. 왕궁의 이야기 속 동물과 살아 있는 코끼리의 생태를 함께 이해하되 서로 혼동하지 않도록 하자.]==], [==[코끼리 기록을 얻었다. 아샤에게 전할 일지는 어부와 농부, 장인, 보석상과 자연의 이야기로 채워졌다. 여러 기술을 익히는 여행이 마무리됐다.]==] },
	q_field_southeast_asia_1 = { [==[마닐라의 젊은 화가 마리아는 항구를 지키는 성벽 너머의 세상을 그리고 싶어 한다. 인트라무로스를 조사해 식민지 시대의 건축과 교역을 기록하자.]==], [==[성벽 기록을 얻었다. 마리아는 호이안의 칠기 장인에게서 배울 것이 많다며 첫 그림을 건넨다.]==] },
	q_field_southeast_asia_2 = { [==[호이안의 장인은 칠기 상자를 보여 주며 한 겹씩 쌓이는 작업에는 시간이 필요하다고 말한다. 실제 상자를 조사해 마리아의 그림 자료에 보태자.]==], [==[칠기 기록을 얻었다. 장인은 양곤의 불탑을 그린 여행기를 소개한다.]==] },
	q_field_southeast_asia_3 = { [==[쉐다곤 파고다에서 여러 시대의 건축과 신앙의 전승을 살펴본다. 마리아는 낯선 문화를 자신이 아는 이야기로 바꾸지 않고 기록하려 한다.]==], [==[불탑 기록을 얻었다. 여행기에는 반다의 향신료 교역을 둘러싼 갈등도 담겨 있다.]==] },
	q_field_southeast_asia_4 = { [==[반다에서 육두구나무를 조사한다. 향신료의 가치뿐 아니라 독점 경쟁과 식민 지배가 사람들의 삶에 남긴 역사도 함께 기록하자.]==], [==[육두구 기록을 얻었다. 한 선원은 먼 섬에 용처럼 생긴 동물이 산다는 이야기를 들려준다.]==] },
	q_field_southeast_asia_5 = { [==[코모도왕도마뱀을 안전하게 관찰한다. 마리아는 용 전설을 상상화로, 실제 동물의 모습은 자연 기록으로 나누어 그리려 한다.]==], [==[코모도왕도마뱀 기록을 얻었다. 마리아는 성벽과 공예, 신앙과 향신료, 자연을 담은 그림 여행기를 완성했다. 자신이 몰랐던 세계를 존중하며 그리는 것이 마지막 교훈이었다.]==] },
	q_field_east_asia_1 = { [==[인천 어민의 아들 윤호는 먼 항구로 떠나는 형에게 두루미 그림을 보내고 싶어 한다. 길한 징조라는 전승을 간직한 채 실제 두루미를 관찰하자.]==], [==[두루미 기록을 얻었다. 윤호는 형이 일하던 차 교역선 이야기를 떠올리며 광저우의 차밭을 소개한다.]==] },
	q_field_east_asia_2 = { [==[광저우의 차 농부는 한 잔의 차가 잎을 가꾸는 사람과 먼 항구를 연결한다고 말한다. 차나무의 실제 재배 모습을 조사하자.]==], [==[차나무 기록을 얻었다. 농부는 차를 취급하는 나가사키의 통역관에게 이야기를 전해 달라고 한다.]==] },
	q_field_east_asia_3 = { [==[데지마의 교역 유적을 답사한다. 통역관 하루는 제한된 교류 속에서도 서로의 언어를 배우고 편지를 읽는 일이 중요했다고 말한다.]==], [==[데지마 기록을 얻었다. 하루는 윤호에게 전할 여행기에 후지 산 그림도 함께 담자고 한다.]==] },
	q_field_east_asia_4 = { [==[에도에서 후지 산의 지형을 관찰한다. 산에 관한 신앙과 문학의 전승을 존중하며 실제 모습도 기록해 윤호의 여행기에 담자.]==], [==[후지 산 기록을 얻었다. 하루는 남쪽으로 떠나는 배들이 태풍을 걱정한다는 편지를 전한다.]==] },
	q_field_east_asia_5 = { [==[마카오 앞바다의 태풍 기록을 조사한다. 윤호가 기다리는 선원들의 삶을 생각하며 기상 현상의 실제 기록을 남기자.]==], [==[태풍 기록을 얻었다. 윤호에게 보내는 여행기에는 두루미와 차나무, 교역의 역사, 산과 바람이 담겼다. 가족을 향한 기다림이 바다를 이해하려는 여행으로 이어졌다.]==] },
	q_field_americas_1 = { [==[헤시피의 어민 루시아는 어린 시절 만난 바다거북을 기억하며 해안 자연의 이야기를 모으고 싶어 한다. 푸른바다거북의 생태를 조사하자.]==], [==[거북 기록을 얻었다. 루시아는 먼 항구에서 온 카카오 열매 이야기를 전한다.]==] },
	q_field_americas_2 = { [==[베네수엘라 해안에서 카카오 꼬투리를 조사한다. 카카오는 유럽에 전해지기 전부터 여러 아메리카 사회에서 이용됐다. 작물과 사람들의 역사를 함께 살펴보자.]==], [==[카카오 기록을 얻었다. 여행 기록에는 캄페체의 마야 석비가 등장한다.]==] },
	q_field_americas_3 = { [==[캄페체에서 마야 석비를 조사한다. 그 문자를 모두 해독했다고 주장하기보다 실제 형태와 고대 사회의 기록 문화를 존중해 남기자.]==], [==[마야 석비 기록을 얻었다. 루시아는 거대한 아마존 강을 그린 해도를 보여 준다.]==] },
	q_field_americas_4 = { [==[벨렝에서 아마존 하구를 관찰한다. 강의 규모에 놀랐던 선원들의 여행담과 실제 지형을 함께 기록한다.]==], [==[아마존 하구 기록을 얻었다. 이제 내륙의 안데스 산맥으로 이어지는 지리를 조사할 차례다.]==] },
	q_field_americas_5 = { [==[안데스 산맥의 지형을 기록한다. 황금 도시 전설보다 여러 토착 사회의 삶과 자연에 대한 실제 기록을 존중하는 탐험을 마치자.]==], [==[안데스 기록을 얻었다. 루시아의 여행기에는 살아 있는 자연과 작물, 문명의 역사와 산줄기가 담겼다. 황금보다 오래 남을 기록을 모으는 모험이었다.]==] },
	q_field_pacific_1 = { [==[호주 해안에 도착한 선원 톰은 캥거루를 처음 본 자신의 그림이 엉뚱하다며 웃는다. 실제 동물의 모습과 서식지를 관찰해 그림 일지를 시작하자.]==], [==[캥거루 기록을 얻었다. 톰은 파푸아에서 배운 식생활 이야기도 그려 보고 싶다고 한다.]==] },
	q_field_pacific_2 = { [==[포트모르즈비 주변에서 타로 작물을 조사한다. 현지 사람들이 오랫동안 익혀 온 재배 지식을 존중하며 작물의 특징을 기록하자.]==], [==[타로 기록을 얻었다. 톰은 피지의 꽃을 그린 여행 자료를 다음 장으로 삼는다.]==] },
	q_field_pacific_3 = { [==[수바에서 히비스커스를 관찰한다. 여행자의 낭만적인 꽃 이야기와 실제 식물의 형태를 나누어 기록하자.]==], [==[히비스커스 기록을 얻었다. 북쪽 바다를 지나던 선원이 혹등고래의 모습을 보고 감탄했다는 이야기가 이어진다.]==] },
	q_field_pacific_4 = { [==[다윈 북부 해안에서 혹등고래를 안전하게 관찰한다. 거대한 동물에 대한 경외심을 전설과 섞지 않고 자연의 기록으로 남기자.]==], [==[혹등고래 기록을 얻었다. 톰은 마지막으로 뉴질랜드의 카우리 숲을 기록하고 싶다고 한다.]==] },
	q_field_pacific_5 = { [==[오클랜드 일대의 카우리나무를 조사한다. 숲의 자연사와 현지 사회의 지식을 존중하며 긴 여행을 마무리하자.]==], [==[카우리 기록을 얻었다. 톰의 첫 그림은 서툴렀지만 마지막 일지에는 동물과 작물, 꽃과 숲이 정확한 기록으로 담겼다. 낯선 세계를 배우는 모험이 끝났다.]==] },
	q_willow_field = { [==[안트베르펜의 약초원 서기는 버드나무와 닮은 잎이 뒤섞인 표본을 받았다. 강변에서 실제 버드나무를 관찰해 이름을 바로잡자.]==], [==[버드나무 표본을 기록했다. 수도원 약초원에서 비교 기록을 확인할 차례다.]==] },
	q_willow_notes = { [==[수도원의 약초 기록에는 서로 다른 나무가 같은 이름으로 적혀 있다. 앞서 확보한 표본과 기록을 비교하자.]==], [==[표본의 비교 기록을 확보했다. 약방에서 전통적인 사용 기록을 검토하자.]==] },
