	q_timber_edinburgh = { [==[에든버러의 언덕 위 성당은 지붕이 반쯤 날아간 채 겨울을 났다. 석공 맥그리거가 말한다. "기도는 하늘 아래서도 되지만, 아이들 세례는 지붕 아래서 해야 하오."]==], [==[새 서까래가 올라가던 날 종소리가 다시 울렸다. 맥그리거가 지붕 위에서 모자를 흔들었다.]==] },
	q_beer_copenhagen = { [==[코펜하겐 맥주 축제에서 양조사 한스는 삼 년 연속 이등이다. 그의 비결은 먼 곳의 홉에 있다. "올해는 일등이 목표가 아니오. 아버지 무덤에 잔을 올리고 싶을 뿐이오."]==], [==[한스의 맥주가 마침내 금 잔을 받았다. 그는 축제가 끝나자 곧장 묘지로 향했다.]==] },
	q_olive_london = { [==[런던 수도원 부엌의 수사 베네딕트는 신앙보다 올리브유가 귀하다고 농담한다. 하지만 성유가 떨어지면 장례도 세례도 멈춘다. "기름 한 병에 영혼 한 명이 달렸소."]==], [==[성유병이 다시 채워졌다. 수사가 당신에게 짧은 축복을 건넸다.]==] },
	q_silk_istanbul = { [==[이스탄불의 상인 유수프는 비단의 길을 거꾸로 되짚는 꿈을 꾼다. 동방 비단을 서쪽 큰 항구로 보내 이 길이 반대로도 열리는지 시험하려 한다. "길은 한쪽으로만 흐르지 않소."]==], [==[암스테르담에서 첫 비단이 풀리자 유수프의 편지가 도착했다. "이제 길이 양쪽으로 숨 쉬오."]==] },
	q_amber_riga = { [==[리가의 호박 세공사 아우구스트는 아들에게 가업을 물려주려 한다. 아들은 이 일을 지겨워한다. "호박 하나를 끝까지 깎아 보면 알 거요. 돌이 아니라 시간이오."]==], [==[아들이 처음으로 호박을 스스로 깎았다. 아우구스트가 손을 뒤로 감추고 모른 척했다.]==] },
	q_furs_petersburg = { [==[상트페테르부르크의 사냥꾼 이반은 겨울 내내 모은 모피를 한 번에 팔아야 한다. 값이 맞는 곳은 멀리 베네치아뿐이다. "눈 속에서 번 건 눈보다 빨리 사라지오."]==], [==[이반의 모피가 가면무도회의 외투가 되었다. 그의 아내가 처음으로 새 장화를 신었다.]==] },
	q_wine_porto = { [==[포르투의 양조업자 마누엘의 포도주는 배에 실으면 쉬어 버린다. 그래서 브랜디를 섞어 보기로 했다. 첫 실험이 런던으로 간다. "실패하면 우린 포도밭을 접소."]==], [==[런던에서 온 답장은 한 줄이었다. "더 보내시오." 마누엘이 포도밭 한가운데에서 주저앉아 웃었다.]==] },
	q_sugar_cadiz = { [==[카디스의 항구에 설탕 맛을 본 아이가 있다. 선원의 아들 디에고는 신대륙 이야기를 설탕 알갱이 하나로 상상한다. "하얀 모래가 이렇게 달 수 있다면 그 땅은 어떤 곳이에요?"]==], [==[암스테르담 제과점 문 앞에서 설탕이 풀렸다. 디에고에게 보낼 편지가 한 통 더 늘었다.]==] },
	q_salt_lubeck = { [==[뤼베크의 청어 상인들은 소금이 없으면 아무것도 보존하지 못한다. 길드장 한자는 말한다. "소금은 돈이 아니라 시간이오. 생선의 시간을 늘려 주는 거요."]==], [==[소금 통이 줄지어 열렸다. 청어가 겨울 지나 봄까지 갈 수 있게 되었다.]==] },
	q_logwood_oslo = { [==[오슬로의 직조공 시그리드는 북쪽의 잿빛 겨울에 지쳤다. 그래서 가장 진한 보라색으로 짠 천을 마을 교회 깃발로 만들고 싶다. "겨울에도 색은 있어야 해요."]==], [==[교회 지붕 위에서 보라색 깃발이 눈 속에 펄럭였다. 마을 사람들이 한참 올려다보았다.]==] },
	q_med_tour = { [==[지중해 스물다섯 항구를 도는 일은 서로 다른 신들을 만나는 일이다. 어느 항구는 십자가를, 어느 항구는 초승달을 세운다. 그 모두를 존중하는 법을 배우게 된다.]==], [==[스물다섯 번째 항구의 새벽에 각기 다른 종소리가 한꺼번에 울렸다. 당신은 그 소리를 지도에 적었다.]==] },
	q_world_tour = { [==[마흔 개의 항구면 유럽의 숨결을 알게 된다. 한 항구의 빵집 주인이 다른 항구의 소문을 먼저 아는 이유를 이해하게 된다. 길이 곧 신문이다.]==], [==[마흔 번째 항구에서 만난 노인이 말했다. "자네가 우리를 전부 아는군." 당신은 수줍게 웃었다.]==] },
	q_marble_london = { [==[런던의 조각가 이사벨라는 죽은 남편의 묘비를 하얀 돌로 세우고 싶다. 영국 땅에서는 나지 않는 돌이다. "그이는 평생 흙 속에서 일했어요. 마지막만은 빛 나는 곳에 두고 싶어요."]==], [==[묘비가 세워진 날 이사벨라가 돌에 이마를 대고 한참 서 있었다.]==] },
	q_coral_venice = { [==[베네치아의 보석상 아드리아나는 딸의 목걸이에 쓸 붉은 산호를 찾는다. 딸은 열병을 앓은 후 말을 잃었다. "아이가 붉은색에는 아직 웃는답니다."]==], [==[산호 목걸이를 건 딸이 처음으로 어머니의 이름을 불렀다.]==] },
	q_saffron_london = { [==[런던의 요리사 마사는 왕의 생일 연회에서 황금빛 쌀을 낸다. 사프란이 부족하면 접시는 그저 평범한 흰 쌀이다. "왕은 금을 먹고 싶어 하지 않소, 금빛을 기억하고 싶어 하오."]==], [==[금빛 접시가 식탁에 오르자 연회장이 조용해졌다. 마사가 주방 구석에서 숨을 길게 내쉬었다.]==] },
	q_carpet_amsterdam = { [==[암스테르담 상인 클라스의 응접실 바닥은 맨돌이다. 부자들의 집에는 동방의 융단이 깔려 있다. 그는 융단 위에서 첫 상담을 하고 싶어 한다. "발밑이 믿음직해야 거래도 믿음직하거든."]==], [==[융단이 깔린 응접실에서 첫 큰 계약이 성사되었다. 클라스가 맨발로 융단을 쓸어 보았다.]==] },
	q_incense_seville = { [==[세비야 대성당의 사제 라파엘은 부활절 미사에 쓸 유향이 부족하다. "향이 오르면 사람들의 눈이 위로 향하오. 그 한 번의 시선을 위해 모든 준비를 하는 거요."]==], [==[대성당 천장에 향연이 퍼졌다. 라파엘이 눈을 감고 오래 숨을 들이쉬었다.]==] },
	q_dates_hamburg = { [==[함부르크 제과장 바르바라는 사막에서 온 대추야자를 처음 맛보았다. 그 단맛을 고향의 겨울 과자에 넣고 싶다. "먼 곳의 단맛이 우리 겨울에 필요해요."]==], [==[겨울 시장에서 대추야자 과자가 가장 먼저 팔렸다. 바르바라가 과자 한 개를 당신에게 따로 남겨 두었다.]==] },
	q_raisins_bergen = { [==[베르겐의 어부 마그누스는 항해 중 괴혈병으로 이빨을 잃었다. 건포도 한 줌이 그의 아이들에게 같은 운명을 피하게 해 줄지도 모른다. "과일을 구경도 못 하는 땅이오."]==], [==[마그누스의 아이들이 건포도를 하나씩 입에 넣고 신 얼굴을 했다. 그가 크게 웃었다.]==] },
	q_cotton_rouen = { [==[루앙의 직조 마을은 양모 값에 짓눌려 있다. 젊은 직조공 클레르는 면이라는 새 천에 모든 것을 걸었다. "가볍고 빨리 마르는 천이 세상을 바꿀 거예요."]==], [==[첫 면직물이 시장에 걸렸다. 클레르의 베틀 소리가 밤새 이어졌다.]==] },
	q_leather_amsterdam = { [==[암스테르담 제화공 데이크는 한 켤레에 석 달을 들인다. 좋은 가죽이 없으면 석 달이 헛된다. "신발은 걷는 사람의 이야기를 대신 짊어지는 거요."]==], [==[데이크가 만든 부츠를 신은 선원이 부두를 걸었다. 발소리가 달랐다.]==] },
	q_pepper_hamburg = { [==[함부르크 소시지 장인 요한은 후추 한 알 값을 알고 있다. 그것이 가게의 가치를 결정한다. "후추가 들어간 고기와 안 들어간 고기는 다른 음식이오."]==], [==[소시지 가게 앞에 줄이 늘어섰다. 요한이 후추 한 알을 당신에게 내밀며 말했다. "깨물어 보시오."]==] },
	q_gold_london = { [==[런던 금세공사 에드먼드의 가게 위에는 '궁정 납품'이라는 간판이 없다. 그는 그 간판을 달고 싶다. 황금 해안의 금가루가 필요하다. "간판 한 줄에 평생이 걸렸소."]==], [==[새 간판이 걸리던 날 에드먼드가 가게 앞에서 오래 서 있었다. 비가 오는데도 우산을 펴지 않았다.]==] },
	q_palmoil_hamburg = { [==[함부르크 비누공 게르트루트는 야자유가 새로운 비누를 만들 수 있다고 믿는다. "깨끗함은 부자만의 것이 아니어야 해요. 노동자도 손이 깨끗했으면 해요."]==], [==[새 비누가 노동자 거리에서 팔렸다. 게르트루트가 손을 씻는 아이를 오래 지켜보았다.]==] },
	q_gum_amsterdam = { [==[암스테르담 화가 아드리안은 물감이 갈라지는 문제로 걸작을 망쳤다. 아라비아 고무가 해결책이라는 소문이 있다. "그림이 백 년 가려면 그 아래 접착제가 먼저 백 년 가야 하오."]==], [==[새 물감으로 그린 그림이 마르는 동안 아드리안이 밤새 곁을 지켰다.]==] },
	q_ebony_london = { [==[런던의 악기 장인 하워드는 오르간 건반을 흑단으로 만들고 싶다. 하얀 건반 사이에 검은 건반이 선명해야 연주자가 길을 잃지 않는다. "음악에도 그림자가 필요하오."]==], [==[오르간이 처음 울린 날, 하워드는 맨 뒷줄에서 눈을 감고 들었다.]==] },
	q_feathers_venice = { [==[베네치아 가면무도회의 의상 장인 로렌차는 타조 깃털을 오래 기다렸다. "가면 뒤에서 사람은 가장 솔직해져요. 그러니 가면은 가장 아름다워야 해요."]==], [==[가면무도회 밤, 운하 위에 깃털이 흩날렸다. 로렌차가 다리 위에서 조용히 바라보았다.]==] },
	q_ivory_amsterdam = { [==[암스테르담 당구장 주인 코르넬리스는 상아 공의 광택을 잊지 못한다. 지금 쓰는 나무 공은 너무 가볍다. "공이 닿는 소리가 맑아야 내기도 맑아지오."]==], [==[상아 공이 부딪치는 맑은 소리가 가게를 채웠다. 코르넬리스가 눈을 감았다.]==] },
	q_west_africa_tour = { [==[서아프리카의 항구 쉰다섯 곳은 금, 상아, 노래의 길이다. 해안은 길고 마을마다 북이 다르다. 한 번의 방문으로는 북소리 하나만 배울 수 있다.]==], [==[마지막 항구의 북소리가 당신의 이름을 불렀다. 이 해안이 이제 낯설지 않다.]==] },
	q_cloves_london = { [==[런던의 치과의사 윌리엄은 정향이 이앓이를 가라앉힌다는 소문을 확인하고 싶다. 환자가 줄을 서 있다. "아픈 사람 앞에서 소문은 책임이 되오."]==], [==[정향을 문 환자의 얼굴이 풀렸다. 윌리엄이 약상자에 새 칸을 하나 만들었다.]==] },
	q_nutmeg_amsterdam = { [==[암스테르담 조향사 야니케는 육두구 한 알로 방 하나의 공기를 바꾼다는 걸 안다. 하지만 그 한 알이 금보다 귀하다. "향은 사라지는 것 중에 가장 비싸요."]==], [==[야니케가 만든 향이 병원 병실에 쓰였다. 환자들이 깊이 숨을 쉬었다.]==] },
	q_cinnamon_venice = { [==[베네치아 제빵사 파올로는 계피 향이 나는 빵을 구우면 손님이 기억을 되살린다고 믿는다. "어릴 때 할머니 부엌 냄새가 계피였소. 모두에게 그런 냄새가 하나씩 있소."]==], [==[빵집 앞을 지나던 노인이 걸음을 멈추고 한참 서 있었다.]==] },
	q_indigo_rouen = { [==[루앙 염색공 필립은 인디고로 청바지 같은 질긴 푸른 천을 염색하고 싶다. 하지만 푸른색은 빨래할수록 더 깊어진다. "오래 입을수록 아름다워지는 색은 드물지."]==], [==[푸른 천이 햇빛에 널렸다. 필립이 손에 푸른 물이 든 채 웃었다.]==] },
	q_gems_istanbul = { [==[이스탄불 궁정의 보석 감정사 아흐메트는 왕비의 반지에 꼭 맞는 보석을 찾는 중이다. "보석은 돌이 아니라 약속이오. 왕비가 받는 약속이 흠집 하나라도 있으면 안 되오."]==], [==[반지가 왕비의 손에 끼워졌다. 아흐메트가 궁정 복도에서 길게 숨을 내쉬었다.]==] },
	q_ambergris_london = { [==[런던의 향수 제조사 클라리사는 용연향이 향의 수명을 열 배로 늘린다고 들었다. 바다에서 떠밀려 온 이 회색 덩어리가 모든 향수의 비밀이다. "바다가 오래 품은 걸 우리가 잠시 빌리는 거예요."]==], [==[향수병 뚜껑을 열자 방 안이 잔잔한 파도 소리로 채워지는 듯했다.]==] },
	q_rice_lisbon = { [==[리스본 부두의 하역 감독 조아킴은 인도에서 온 쌀을 보고 눈물을 흘렸다. 선원이던 아버지가 바다에서 죽던 날 마지막 식사가 쌀밥이었다. "그 쌀이 어디서 온 건지 이제야 알겠소."]==], [==[쌀 자루를 내리는 조아킴의 손길이 평소보다 느렸다.]==] },
	q_pepper_goa = { [==[고아의 후추 농부 라지는 한 번도 자기 후추가 어디로 가는지 본 적이 없다. 당신의 짐에는 그의 편지가 있다. "이 후추가 닿는 곳의 사람에게, 먼 곳에서도 따뜻하기를."]==], [==[암스테르담에서 편지를 읽은 상인이 답장을 써 주었다. 당신이 그것을 라지에게 전할 날이 기다려진다.]==] },
	q_indian_tour = { [==[인도양은 계절풍이 방향을 정하는 바다다. 일흔다섯 항구를 도는 일은 바람의 달력을 몸으로 익히는 일이다. 돌아오는 날을 정하는 건 선장이 아니라 바람이다.]==], [==[일흔다섯 번째 항구에서 바람의 방향이 바뀌었다. 당신은 처음으로 그걸 기다림 없이 받아들였다.]==] },
	q_tea_london = { [==[런던의 의사 헨리는 환자들에게 술 대신 차를 권하고 싶다. 취하지 않고 따뜻해지는 법을 가르치는 것이다. "이 도시의 절반은 술로 아침을 시작하오. 다른 길이 필요하오."]==], [==[찻집 문이 열리고 노동자들이 줄을 섰다. 헨리가 문 앞에서 첫 잔을 따랐다.]==] },
	q_porcelain_amsterdam = { [==[암스테르담 도공 한스는 푸른 무늬 자기를 흉내 내고 싶다. 하지만 흙부터 다르다. 진짜 자기를 한 번 손에 쥐어야 그 얇음을 이해할 수 있다. "본 적 없는 걸 어떻게 흉내 내겠소."]==], [==[한스가 자기를 빛에 비추며 한참 말이 없었다. "이건 흙이 아니라 빛이오."]==] },
	q_silk_venice = { [==[베네치아 직조 길드의 노인 마르코는 비단길이 끝나는 곳이 자기 가게라는 걸 자랑스러워한다. 하지만 길이 끊기려는 조짐이 있다. "끝이 아니라 마지막 손이오. 비단을 받아 완성하는."]==], [==[베네치아 베틀에서 마지막 비단이 풀려나갔다. 마르코가 오래 쓰다듬었다.]==] },
	q_lacquer_london = { [==[런던 귀족의 마님이 동방 칠기 상자를 선물받았다. 거기엔 열 겹 이상의 옻이 입혀져 있다. 그녀는 그 인내가 부럽다. "영국엔 이만큼 오래 기다릴 줄 아는 사람이 없지요."]==], [==[칠기 상자가 응접실 탁자 위에서 은은히 빛났다. 마님이 매일 아침 한 번씩 쓰다듬었다.]==] },
	q_copper_amsterdam = { [==[암스테르담 놋쇠 장인 바우터는 일본 구리의 색을 잊지 못한다. 유럽 구리보다 붉고 깊다. "한 번 보면 다른 구리는 시시해지오."]==], [==[새로 만든 놋 촛대가 교회 제단에서 은은한 붉은빛을 냈다.]==] },
	q_jade_istanbul = { [==[이스탄불 궁정의 장인 카이르는 죽은 왕의 인장을 새로 만든다. 푸른 옥이 아니면 안 된다고 왕비가 고집한다. "돌 하나에 한 사람의 평생을 담는 일이오."]==], [==[인장이 새로 새겨졌다. 카이르가 마지막 획 후 손을 오래 떨었다.]==] },
	q_ginseng_venice = { [==[베네치아 의사 피에트로는 동방의 뿌리 하나가 늙은 총독의 기력을 되살렸다는 소문을 듣고 믿지 않았다. 하지만 직접 보고 믿기로 했다. "의심하려면 증거를 먼저 모아야 하오."]==], [==[피에트로가 인삼을 연구실 선반에 올렸다. 첫 줄에 '의심을 거두며'라고 적었다.]==] },
	q_sandalwood_seville = { [==[세비야 수도원의 수사 곤살로는 향기가 오래 남는 십자가를 깎고 싶다. 백단향은 베어 낸 뒤에도 백 년을 향기로 말한다. "기도가 끝나도 향이 남아 있으면 기도는 끝난 게 아니오."]==], [==[십자가가 제단에 놓이자 예배당이 고요해졌다. 곤살로가 눈을 감고 향을 마셨다.]==] },
	q_camphor_antwerp = { [==[안트베르펜 약방의 조수 리너스는 좀이 슨 모직 외투 앞에서 울상이다. 장뇌 한 조각이면 한 계절 옷을 지킬 수 있다. "가난한 집에는 옷이 한 벌뿐이라 좀이 슬면 겨울이 끝나요."]==], [==[옷장 문을 열자 서늘한 향이 퍼졌다. 리너스가 외투 소매를 오래 쓰다듬었다.]==] },
	q_east_asia_tour = { [==[동아시아의 백 개 항구는 하나의 문명을 열 개의 방식으로 해석한다. 같은 글자를 다르게 읽고 같은 차를 다르게 마신다. 그 차이가 바로 이 바다의 풍경이다.]==], [==[백 번째 항구의 찻잔 앞에서 당신은 오래 앉아 있었다. 맛이 이제 지도처럼 읽혔다.]==] },
	q_world_tour2 = { [==[백스무 개의 항구를 돌면 세계가 크지 않다는 걸 알게 된다. 낯선 곳마다 비슷한 그리움을 가진 사람이 산다. 이 사실이 세계일주의 진짜 전리품이다.]==], [==[백스무 번째 항구에서 당신은 처음으로 어디에도 이방인이 아니라고 느꼈다.]==] },
	q_cocoa_seville = { [==[세비야의 수녀원은 작은 비밀이 있다. 수녀 마리아는 신대륙의 음료를 몰래 만들어 병든 이에게 먹인다. "쓴 것을 달게 만드는 건 약이 아니라 정성이에요."]==], [==[수녀원 부엌에서 따뜻한 김이 올랐다. 병실의 아이가 처음으로 잔을 끝까지 비웠다.]==] },
	q_mahogany_london = { [==[런던 가구공 새뮤얼은 물려줄 식탁을 만들고 싶다. 마호가니는 백 년 후에도 윤이 난다. "이 식탁에서 내 손자의 손자가 밥을 먹는다고 생각하면 손이 떨리오."]==], [==[식탁 위에 첫 접시가 놓였다. 새뮤얼이 나무결을 손가락으로 따라 걸었다.]==] },
	q_rum_edinburgh = { [==[에든버러 항구 술집의 늙은 주인 앵거스는 선원들이 돌아오는 날마다 같은 술을 낸다. 오늘은 카리브의 럼이 필요하다. "먼 곳에서 돌아온 사람은 먼 곳의 술을 마셔야 비로소 돌아온 기분이 들지."]==], [==[선원들이 잔을 부딪쳤다. 앵거스가 말없이 가장 오래된 의자를 당신에게 내밀었다.]==] },
	q_logwood_antwerp = { [==[안트베르펜의 염색 길드는 이번 봄 보랏빛 한 가지로 승부를 건다. 로그우드가 시기에 맞춰 닿지 않으면 길드의 한 해가 날아간다. "색은 유행이고, 유행은 기다려 주지 않소."]==], [==[축제 행렬이 보라색 깃발로 물들었다. 길드장이 모자를 벗어 인사했다.]==] },
	q_cochineal_venice = { [==[베네치아의 화가 티치아노는 마지막 그림의 붉은색을 못 정했다. 코치닐에서 나오는 붉은색은 피보다 깊다. "이 붉은색 아니면 이 그림은 미완성으로 남소."]==], [==[그림이 마르는 동안 화실 문이 조용히 닫혔다. 붉은 한 겹이 전체 그림을 바꿨다.]==] },
	q_vanilla_rouen = { [==[루앙 제과장의 젊은 아내 에밀리는 임신 중에 먹고 싶은 맛이 있다. 아직 이름도 모르는 달콤한 향이다. "그 향을 맡으면 아이가 웃는 것 같아요."]==], [==[케이크 향이 부엌을 가득 채웠다. 에밀리가 배에 손을 얹고 눈을 감았다.]==] },
	q_maize_lisbon = { [==[리스본 빈민가에 굶주림이 돌고 있다. 수도원의 수사 안토니우는 신대륙의 곡식이 밀보다 빨리 자란다는 걸 안다. "한 알이 삼백 알이 되는 곡식이오. 이건 기적이 아니라 계산이오."]==], [==[죽 한 솥이 빈민가에 놓였다. 줄이 길었지만 아무도 다투지 않았다.]==] },
	q_brazilwood_amsterdam = { [==[암스테르담 직조공 마리아의 딸이 시집간다. 붉은 염료로 물들인 혼례복이 아니면 이 집안 딸들은 시집가지 않는다. "붉은 천 한 필이 삼 대의 약속이에요."]==], [==[혼례 날 붉은 천이 햇빛에 은은하게 빛났다. 어머니가 딸의 소매를 매만졌다.]==] },
	q_sugar_london2 = { [==[런던 설탕 정제업자 조슈아는 큰 공장을 짓는 중이다. 주변 사람들은 미쳤다고 한다. "설탕이 약이던 시절은 갔소. 이제는 모두의 식탁에 오를 거요."]==], [==[공장 굴뚝에서 첫 연기가 올랐다. 조슈아가 낡은 장부를 불에 던졌다.]==] },
	q_logwood_amsterdam2 = { [==[암스테르담 염료 상인 비텐은 로그우드를 팔아 학교를 세우려 한다. 색깔 장인의 아들딸이 읽고 쓰는 법을 배우게 하고 싶다. "염색공의 손은 물들지만 마음은 물들지 않게 하고 싶소."]==], [==[학교 개교 날 아이들이 푸른 손으로 첫 글자를 썼다.]==] },
	q_americas_tour = { [==[신대륙 백오십 항구는 아직 이름이 정해지지 않은 도시들이다. 같은 곳이 스페인, 포르투갈, 영국, 프랑스의 이름으로 불린다. 그 이름의 겹침이 이 대륙의 역사다.]==], [==[백오십 번째 항구의 부두에서 당신은 여러 이름을 모두 불러 보았다. 바다가 모두에게 대답했다.]==] },
	q_kauri_london = { [==[런던 조선소의 늙은 목수 헨리는 돛대 하나에 평생을 바쳤다. 카우리 목재는 곧고 굵어 이상적이다. "배의 등뼈가 곧아야 항해도 곧소."]==], [==[돛대가 서던 날, 헨리는 가장 높은 곳을 올려다보며 오래 서 있었다.]==] },
	q_sealskin_canton = { [==[광저우 상인 왕은 북쪽 바다 물개 가죽으로 겨울 외투를 만들고 싶다. 하지만 이 가죽이 이곳에서 얼마나 귀한지는 아무도 모른다. "처음 파는 물건은 값을 정하는 사람이 곧 시장이오."]==], [==[광저우 시장에 물개 가죽 외투가 걸렸다. 왕이 값표를 쓰는 손이 떨렸다.]==] },
	q_sandal_canton = { [==[광저우의 향 장인 리는 하와이 백단의 향을 맡고 눈을 의심했다. 중국 백단과 다른 달콤함이 있다. "바다 끝 섬에서도 같은 나무가 다른 이야기를 품고 있구려."]==], [==[새로운 향이 사원에서 피어올랐다. 리가 고개 숙여 조용히 기도했다.]==] },
	q_guano_hamburg = { [==[함부르크 근교 농부 오토의 밭은 해마다 수확이 줄어든다. 구아노라는 새똥 비료가 해답이라는 소문을 들었다. "똥이 금이 되는 세상이라니, 웃기지만 믿어 보겠소."]==], [==[다음 해 밭은 푸르렀다. 오토가 흙을 한 줌 쥐고 냄새를 맡았다.]==] },
	q_nitrate_london = { [==[런던 화약 제조소의 감독 로버트는 초석이 부족해 훈련용 화약조차 만들지 못한다. "전쟁은 싫지만 방어는 필요하오. 그러니 화약은 만들어야 하오."]==], [==[화약 통이 해군 창고로 옮겨졌다. 로버트가 문을 잠그며 한숨을 쉬었다.]==] },
	q_pearlshell_venice = { [==[베네치아 장인 알비세는 무지갯빛 자개로 성가대의 악보함을 장식하고 싶다. "음악은 보이지 않지만 상자는 보일 수 있소. 소리를 담는 그릇이 아름다워야 하오."]==], [==[성가대가 악보함을 열자 빛이 퍼졌다. 알비세가 멀리서 조용히 지켜보았다.]==] },
	q_pacific_tour = { [==[태평양은 바다가 아니라 우주에 가깝다. 이백 개의 항구는 서로 닿지 못하는 섬처럼 흩어져 있다. 그곳을 모두 도는 사람은 인류에서 손에 꼽을 것이다.]==], [==[이백 번째 항구의 석양이 모든 항로를 하나로 이었다. 당신은 지도를 접고 하늘을 올려다보았다.]==] },
	q_gibraltar_cloth = { [==[지브롤터 바위 위의 수비대는 옷이 해져 간다. 보급선이 두 달째 오지 않는다. 대위 해리스가 낡은 외투를 펼쳐 보인다. "요새는 벽이 아니라 사람이 지키는 거요."]==], [==[새 군복이 병사들에게 나눠졌다. 해리스가 처음으로 허리를 곧게 폈다.]==] },
	q_gibraltar_iron = { [==[지브롤터 요새의 대장장이 파블로는 부서진 대포 바퀴를 고치고 싶다. 철이 부족하면 대포는 장식일 뿐이다. "바위는 단단해도 그 위의 쇠는 약하오."]==], [==[대포 바퀴가 새로 걸렸다. 파블로가 망치를 내려놓고 어깨를 폈다.]==] },
	q_banda_cloth = { [==[반다 섬의 육두구 농부들은 거래용 옷이 낡았다. 상인 앞에서 초라하면 값이 깎인다는 걸 안다. 촌장 하산이 말한다. "체면은 음식 이전에 값이오."]==], [==[촌장이 새 옷을 입고 거래 자리에 섰다. 첫 흥정이 평소보다 좋았다.]==] },
	q_banda_iron = { [==[반다 섬 농부의 아들 라무는 육두구 수확용 칼이 닳았다. 철이 모자라 새 칼을 못 만든다. "칼이 무디면 한 철 농사가 짧아지오."]==], [==[새 칼이 수확에 쓰였다. 라무가 날을 햇빛에 비추며 환하게 웃었다.]==] },
	q_darwin_cloth = { [==[다윈 항구의 선교사 윌리엄은 원주민 아이들에게 입힐 옷이 없다. 그는 옷을 강요하지는 않지만 비바람을 막아 주고 싶다. "믿음보다 먼저 필요한 건 따뜻함이오."]==], [==[아이들이 새 옷을 입고 모래사장을 달렸다. 윌리엄이 기도 대신 웃었다.]==] },
	q_darwin_iron = { [==[다윈 항구의 대장장이 마이클은 삽과 괭이의 날이 모두 닳았다. 철이 없으면 이 항구는 자라지 못한다. "땅을 파는 도구가 곧 도시의 뼈대요."]==], [==[새 삽이 땅을 파기 시작했다. 마이클이 첫 삽날에 이니셜을 새겼다.]==] },
	q_st_helena_cloth = { [==[세인트헬레나 섬의 총독 부인은 낡은 커튼으로 아이들 옷을 지어 입혔다. 이 외딴 섬엔 배가 한 해에 몇 번만 온다. "섬에서는 옷 한 벌이 달력이에요."]==], [==[새 천이 도착하자 부인이 아이들의 치수를 재기 시작했다.]==] },
	q_st_helena_iron = { [==[세인트헬레나 섬의 목수 존은 부서진 수레바퀴를 철사로 묶어 쓰고 있다. 철이 닿으면 섬의 운송이 되살아난다. "여기선 못 하나가 하루 일이오."]==], [==[수레가 다시 굴러가자 아이들이 뒤를 따라 달렸다.]==] },
	q_st_johns_cloth = { [==[세인트존스 어부의 아내 모린은 남편의 외투 안감을 열 번째 기웠다. 북대서양의 바람은 천을 가리지 않는다. "바다에서 돌아오지 못한 사람 외투는 아직 못 버렸어요."]==], [==[새 외투가 걸렸다. 모린이 낡은 외투를 접어 서랍 깊이 넣었다.]==] },
	q_st_johns_iron = { [==[세인트존스의 어부 패트릭은 닻이 녹슬어 그물에 걸렸다. 철이 닿으면 이번 시즌 어장을 놓치지 않는다. "바다는 무거운 것을 붙잡아 주는 사람만 살려 주오."]==], [==[새 닻이 바다에 내려갔다. 패트릭이 줄을 한참 쥐고 있었다.]==] },
	q_suva_cloth = { [==[수바의 선교학교 교사 루시아는 아이들에게 교복을 입히고 싶다. 다 같은 옷을 입으면 아이들이 서로의 차이보다 공통점을 먼저 본다. "한 줄로 서서 하나가 되는 기쁨이 있어요."]==], [==[아이들이 교복을 입고 운동장에 섰다. 루시아가 이름을 하나씩 불렀다.]==] },
	q_suva_iron = { [==[수바의 대장장이 조지는 섬 사이를 오가는 작은 배의 못이 필요하다. 못이 빠지면 뱃사람은 바다에서 뜯긴다. "작은 못 하나가 큰 섬들을 이어 주오."]==], [==[작은 배가 새 못으로 수리되어 다시 출항했다. 조지가 부두에서 손을 흔들었다.]==] },
	q_tahiti_cloth = { [==[파페에테의 여왕은 낡은 나무껍질 옷을 벗고 서양 천을 입어 보고 싶어 한다. 하지만 전통도 놓치지 않으려 한다. "옷은 바뀌어도 이름은 바뀌지 않아요."]==], [==[여왕이 새 천 위에 전통 무늬를 직접 수놓기 시작했다.]==] },
	q_tahiti_iron = { [==[파페에테 해변의 어부 모아나는 조개껍데기로 만든 낚싯바늘을 쓰고 있다. 쇠 바늘 하나가 하루 어획을 두 배로 늘린다. "신의 선물이란 게 있다면 쇠가 그중 하나일 거요."]==], [==[쇠 낚싯바늘로 건진 참치가 해변에 쌓였다. 모아나의 아이들이 박수를 쳤다.]==] },
	q_sao_tome_cloth = { [==[상투메 섬의 시장 아다는 물려받은 상점의 천이 다 떨어졌다. 섬의 여자들이 찾아와도 줄 것이 없다. "천이 없으면 가게는 그냥 빈 방이에요."]==], [==[가게 진열대에 새 천이 걸리자 여자들이 줄을 섰다.]==] },
	q_sao_tome_iron = { [==[상투메 농장의 감독 페르난두는 농기구가 모두 부서졌다. 철이 오지 않으면 이번 수확은 손으로 해야 한다. "손은 칼보다 빨리 닳아 버리오."]==], [==[새 낫이 농장에 도착했다. 감독이 날을 만져 보고 안도했다.]==] },
	q_kn_first = { [==[발견한 지식은 혼자 가지고 있으면 그냥 메모다. 학자에게 설명하고 반박을 받고 다시 설명해야 비로소 이해가 된다. 첫 보고에서 가장 어려운 건 입을 여는 일이다.]==], [==[학자가 "그래서요?"라고 물었다. 당신이 대답을 이어가자 그의 눈빛이 달라졌다.]==] },
	q_kn_astro = { [==[별은 늘 그 자리에 있는데도 사람들은 매번 새로 놀란다. 천문학 지식 다섯 개를 이해하면 밤하늘이 지도가 된다. 항해사의 밤이 달라진다.]==], [==[다섯 번째 별자리의 의미가 풀리자 밤바다가 갑자기 환해 보였다.]==] },
	q_kn_physics = { [==[떨어지는 사과와 휘어지는 빛 사이에는 같은 질서가 숨어 있다. 물리학 지식 여섯 개를 이해하는 순간 세상은 규칙의 연속으로 보이기 시작한다.]==], [==[여섯 번째 법칙이 맞물리자 낡은 시계가 갑자기 정확하게 느껴졌다.]==] },
	q_kn_chem = { [==[연금술사는 납을 금으로 바꾸지 못했지만 물질의 마음을 바꾸는 법은 알아냈다. 화학 지식 다섯 개를 이해하면 불꽃이 그저 불꽃이 아니게 된다.]==], [==[다섯 번째 반응이 이해되자 실험대 위의 연기가 말을 거는 듯했다.]==] },
	q_kn_art = { [==[거장의 공방에서는 색을 만드는 시간이 그리는 시간보다 길다. 예술 지식 다섯 개를 이해하면 한 폭의 그림이 한 권의 책이 된다.]==], [==[다섯 번째 기법이 이해되자 낯익은 그림이 처음 보는 그림처럼 새로웠다.]==] },
	q_kn_masterpiece = { [==[거장은 걸작을 한 번에 그리지 않는다. 안료를 갈고, 유화로 바탕을 쌓고, 초상으로 얼굴을 담고, 풍경으로 숨을 틔운다. 하나라도 빠지면 그림은 미완성이다.]==], [==[네 단계가 맞물리자 걸작이 한눈에 보였다. 거장이 붓을 내려놓으며 짧게 웃었다.]==] },
	q_kn_steam = { [==[뉴커먼 기관은 한 번에 나오지 않았다. 진자, 압력, 진공, 피스톤. 이전 지식을 차례로 보고해야 기관의 이치가 한 줄로 이어진다. 학자가 조용히 순서대로 묻는다.]==], [==[마지막 이해가 닿자 학자가 기관 모형의 밸브를 열었다. 증기가 길게 숨을 내쉬었다.]==] },
	q_kn_halley = { [==[핼리는 76년 뒤 혜성이 온다고 예언했다. 믿는 이가 거의 없었다. 지식 하나하나가 예언의 증거가 된다. 증거를 끝까지 따라가야 예언이 약속으로 바뀐다.]==], [==[예측의 마지막 칸이 채워졌다. 학자가 하늘을 보며 말했다. "우리가 못 봐도 그가 옳을 거요."]==] },
	q_kn_dye = { [==[푸른 염료는 쪽풀의 비밀이다. 어느 계절에 베고 어떻게 발효시키느냐가 색의 깊이를 정한다. 이 지식을 이해하면 평범한 천이 노을빛 푸른색으로 변한다.]==], [==[염료 교역품이 개량되었다. 천이 빛을 받아 바다처럼 빛났다.]==] },
	q_kn_present = { [==[학회 연단은 높지 않지만 서는 사람은 모두 떨린다. 청중은 당신 증거의 약한 곳부터 찾는다. 두 번의 발표는 두 번의 반박을 견디는 일이다.]==], [==[두 번째 발표가 끝나자 객석에서 천천히 박수가 터졌다. 반박하던 학자가 악수를 청했다.]==] },
	q_kn_expo = { [==[박람회에는 세상의 새것이 모인다. 개량한 교역품이 그곳에 서면 상품이 아니라 이야기가 된다. 출품자는 자기 물건의 이야기를 직접 설명해야 한다.]==], [==[두 번째 출품에서 심사위원이 상품 앞에 멈춰 한참 서 있었다. 메달보다 그 시간이 값졌다.]==] },
	q_kn_joint = { [==[혼자 하는 발표는 선언이고, 둘이 하는 발표는 대화다. 학자와 나란히 서면 서로의 약점을 가려 주고 강점을 드러내 준다. 세 번의 공동 발표가 필요하다.]==], [==[세 번째 발표가 끝나자 학자가 낮게 말했다. "이제 당신을 동료라 부르겠소."]==] },
	q_kn_porttech = { [==[항구는 상품만 오가는 곳이 아니라 기술이 정착하는 땅이다. 학자와 함께 한 항구의 한 학문을 3단계까지 키우면 그 도시가 달라 보이기 시작한다.]==], [==[3단계에 이르자 항구 사람들이 새 기술을 자랑스레 부르기 시작했다.]==] },
	q_kn_landmark = { [==[도시의 얼굴은 건물로 남는다. 박물관이든 천문대든 지식이 벽돌이 되어 서면 사람들은 매일 그 앞을 지나며 배운다. 당신의 이름이 정초석에 새겨진다.]==], [==[준공식 날 아이들이 건물 앞에서 소풍을 열었다. 당신은 그 소리를 가장 오래 기억했다.]==] },
	q_kn_launch = { [==[신제품 출시 행사는 상품의 첫 인사다. 처음 보는 사람이 상품을 어떻게 맞이하느냐가 평생의 평판이 된다. 두 번의 행사는 두 번의 첫인상이다.]==], [==[두 번째 행사에서 사람들이 상품을 서로 먼저 만져 보려 했다. 진열대가 순식간에 비었다.]==] },
	q_kn_all = { [==[지식 스무 개를 이해한 사람은 더 이상 호기심 많은 선장이 아니라 계몽의 증인이다. 이 숫자는 한 개인이 시대를 바라보는 눈이 열리는 문턱이다.]==], [==[스무 번째 지식이 맞물리자 당신은 시대가 어떻게 바뀌어 가는지 처음으로 한눈에 보았다.]==] },
	q_ch_nav_compass = { [==[바늘 하나가 북쪽을 가리킨다는 사실을 처음 본 선원은 믿지 못했을 것이다. 나침반 장미의 서른두 방위가 이제 하나의 원으로 정리된다. 어둠 속에서도 길이 있다.]==], [==[첫 장이 끝났다. 당신은 처음으로 안개 속에서도 방향을 잃지 않을 거라 확신했다.]==] },
	q_ch_nav_cross = { [==[십자 관측기는 막대 두 개로 하늘을 잰다. 별의 높이를 알면 위도를 안다. 대서양을 건너려는 이들이 가장 먼저 배우는 도구다. 늙은 항해사가 막대를 건넨다.]==], [==[별 하나의 높이를 재고 지도에 점을 찍었다. 대양 한가운데에 처음으로 당신의 위치가 생겼다.]==] },
	q_ch_nav_pirates = { [==[바다의 길목마다 해적이 기다린다. 길잡이가 되려면 먼저 길을 지켜야 한다. 다섯 번의 승리가 항로를 처음으로 안전하게 만든다.]==], [==[다섯 번째 승리 뒤 길목에서 해적 깃발이 사라졌다. 상선 선장들이 항해 일지에 당신의 이름을 적었다.]==] },
	q_ch_nav_staff = { [==[백스태프는 해를 등지고 서서 그림자로 높이를 잰다. 눈을 해에서 지킬 수 있다는 단순한 발상이 수많은 항해사의 눈을 살렸다. 지혜는 때로 방향을 바꿔 보는 것이다.]==], [==[그림자 끝에 눈금이 닿았다. 항해사가 "눈이 멀지 않고도 해를 잴 수 있다니" 하며 웃었다.]==] },
	q_ch_nav_mercator = { [==[둥근 땅을 평평한 종이에 그리면 어딘가는 틀어진다. 메르카토르는 일부러 틀림으로써 항해사에게 직선을 주었다. 선장은 그 틀림을 이해하고 써야 한다.]==], [==[해도 위에 직선 하나를 그었다. 그 선은 거짓이었지만 항해에는 진실이었다.]==] },
	q_ch_nav_longitude = { [==[위도는 별이 알려 주지만 경도는 시간이 알려 준다. 시계가 없던 시절 수많은 배가 경도를 몰라 암초에 부딪혔다. 이 문제를 이해하는 것이 태평양의 열쇠다.]==], [==[경도 문제가 풀렸다. 학자가 해도의 가로선에 처음으로 숫자를 적었다.]==] },
	q_ch_nav_chrono = { [==[바다에서는 시계가 흔들린다. 습기, 온도, 파도가 시계를 틀리게 한다. 해상 시계 제작자는 평생 하나의 시계를 흔들리지 않게 하는 데 바쳤다.]==], [==[시계가 한 달 뒤에도 정확히 맞았다. 시계공이 조용히 상자를 닫았다.]==] },
	q_ch_geo_trade = { [==[무역풍은 같은 방향으로 계절 내내 분다. 이 사실을 믿는 사람만이 대서양을 쉽게 건넌다. 바람이 변덕스럽지 않다는 믿음이 항로의 시작이다.]==], [==[무역풍을 탄 항해 일지의 첫 줄이 적혔다. "바람이 약속을 지켰다."]==] },
	q_ch_geo_cape = { [==[희망봉은 이름만큼 희망적이지 않다. 폭풍의 곶이라 불리다가 왕이 이름을 바꿨다. 이 곶을 이해하는 것은 두려움에 다른 이름을 붙이는 일이다.]==], [==[곶의 해류가 지도에 그려졌다. 인도양이 처음으로 닿을 수 있는 바다처럼 보였다.]==] },
	q_ch_geo_monsoon = { [==[계절풍은 반년은 동쪽으로, 반년은 서쪽으로 분다. 이를 믿고 기다리는 선원만이 동남아에서 돌아온다. 바람의 달력을 아는 자가 바다의 주인이다.]==], [==[계절풍 표의 첫 칸이 채워졌다. 당신은 처음으로 바람을 기다릴 줄 알게 되었다.]==] },
	q_ch_geo_spice = { [==[바람과 해류를 읽는 법을 배웠으니 이제 시험할 때다. 후추는 가장 멀리, 가장 값진 짐이다. 항로를 아는 선장만이 후추를 손상 없이 암스테르담까지 가져올 수 있다. "항로는 지식이고, 지식은 돈이 된다는 걸 증명하시오."]==], [==[후추 자루가 암스테르담 부두에 쌓였다. 상인들이 당신의 항해 일지를 구경하러 모여들었다.]==] },
	q_ch_geo_magellan = { [==[마젤란은 해협 하나를 찾기 위해 배 네 척을 잃었다. 그가 남긴 물길은 폭이 좁고 안개가 짙다. 이 해협을 이해하는 것은 한 사람의 집념을 이해하는 일이다.]==], [==[해협의 물길이 도해에 이어졌다. 학자가 "그는 돌아오지 못했지만 길은 남았소"라고 말했다.]==] },
	q_ch_geo_horn = { [==[케이프혼은 지구 끝의 바위다. 서풍이 쉼 없이 불고 파도가 산처럼 일어선다. 이 곶을 이해하는 선원은 두려움을 존경으로 바꾼다.]==], [==[마지막 장이 끝났다. 당신은 세상의 끝이 사실은 또 다른 시작이라는 걸 알게 되었다.]==] },
	q_ch_steam_pendulum = { [==[교회의 샹들리에가 흔들리는 것을 본 한 젊은이가 맥박으로 시간을 재 보았다. 흔들림의 주기가 같다는 것을 발견한 순간 시계의 역사가 달라졌다.]==], [==[추가 정확히 같은 간격으로 오갔다. 학자가 "세상은 규칙적이다"라고 속삭였다.]==] },
	q_ch_steam_gravity = { [==[사과가 떨어지는 것은 누구나 봤다. 그러나 달이 떨어지지 않는 이유를 묻는 사람은 한 명뿐이었다. 같은 힘이 사과와 달을 모두 붙잡는다.]==], [==[중력의 식이 완성되었다. 학자가 창밖의 달을 올려다보며 오래 말이 없었다.]==] },
	q_ch_steam_boyle = { [==[공기에도 탄성이 있다. 눌러 주면 반발하고 놓아주면 되돌아온다. 보일의 실험은 보이지 않는 것을 보이게 한 첫 걸음이었다.]==], [==[유리관 속 수은이 올랐다 내려갔다. 학자가 "공기도 몸이 있었네" 하고 웃었다.]==] },
	q_ch_steam_papin = { [==[파팽의 솥은 압력으로 뼈까지 부드럽게 삶는다. 솥이 터지지 않게 하는 밸브가 증기 기관의 아버지가 되었다. 안전장치가 발명이 된 드문 사례다.]==], [==[밸브에서 칙 소리가 났다. 학자가 "이 소리가 시대의 숨소리요"라고 속삭였다.]==] },
	q_ch_steam_coal = { [==[증기 기관은 이론만으로 움직이지 않는다. 불이 필요하고, 불에는 석탄이 필요하다. 루앙의 시험 공장이 첫 증기 압력을 올릴 날이 다가온다. "지식이 불꽃을 만나는 순간이오."]==], [==[공장의 압력계 바늘이 올라갔다. 모두가 숨을 죽이고 지켜보았다.]==] },
	q_ch_steam_engine = { [==[뉴커먼 기관은 광산의 물을 퍼 올리려고 만들어졌다. 그러나 이 기관이 언젠가 배를 움직일 거라고 처음 말한 사람은 웃음거리가 되었다.]==], [==[기관이 물을 퍼 올렸다. 광부들이 처음으로 박수를 쳤다.]==] },
	q_ch_steam_engine_ship = { [==[스스로 가는 배는 모두의 꿈이었다. 기관을 작게 만들고 바다 위로 옮기는 일에 수많은 기술자가 인생을 걸었다. 지금 당신은 그 마지막 설계도를 이해한다.]==], [==[설계도가 맞물렸다. 기술자가 도면을 접으며 "이제 바다가 바뀌겠군" 하고 중얼거렸다.]==] },
	q_ch_sky_polaris = { [==[모든 별이 도는데 한 별만 가만히 있다. 선원들은 오래전부터 그 별에 이름을 붙였다. 북극성은 길을 잃은 자의 가장 오래된 친구다.]==], [==[북극성의 높이가 지도에 적혔다. 항해사들이 그 별을 올려다보며 조용히 고개를 끄덕였다.]==] },
	q_ch_sky_observer = { [==[옛 관측자는 이름이 남지 않았다. 그러나 그가 점토판에 새긴 달의 움직임은 수천 년을 넘어 오늘 우리를 가르친다. 이름보다 기록이 오래간다.]==], [==[점토판의 숫자가 해독되었다. 학자가 "이 사람이 우리의 첫 스승이오"라고 속삭였다.]==] },
	q_ch_sky_jupiter = { [==[망원경으로 본 목성 곁에 작은 불빛 넷이 있었다. 그것이 목성을 도는 달이라는 걸 깨닫는 순간 모든 것이 지구를 돈다는 오래된 믿음에 금이 갔다.]==], [==[네 개의 불빛이 도표에 그려졌다. 학자가 "세상의 중심이 하나가 아니었군요"라고 말했다.]==] },
	q_ch_sky_comet = { [==[혜성은 재앙의 징조로 두려움을 받았다. 그러나 혜성이 규칙적으로 돌아온다고 처음 말한 사람은 하늘을 신의 변덕에서 구해 냈다.]==], [==[혜성의 궤도가 그려졌다. 학자가 "이제 두려워하지 않아도 되겠소"라고 말했다.]==] },
	q_ch_sky_halley = { [==[핼리는 자신이 죽은 뒤에 혜성이 돌아올 것이라 예언했다. 살아서 확인할 수 없는 증거를 위해 평생을 바친 사람이다. 그의 약속이 76년을 건너 닿는다.]==], [==[예측의 마지막 숫자가 맞았다. 학자가 밤하늘을 보며 한참 서 있었다.]==] },
	q_ch_alchemy_distill = { [==[증류기 속에서 액체가 증기가 되고 다시 액체로 돌아온다. 이 순환에서 연금술사는 영혼의 정화를 보았고 화학자는 물질의 분리를 보았다.]==], [==[맑은 방울이 하나씩 떨어졌다. 학자가 "이 한 방울이 시작이오"라고 말했다.]==] },
	q_ch_alchemy_acid = { [==[신맛이 나는 것과 미끈한 것이 만나면 중화된다. 이 사소한 관찰이 물질의 성질을 두 편으로 나누었다. 선과 악이 아니라 산과 염기로.]==], [==[시험지의 색이 변했다. 학자가 "세상에는 반대가 필요하오" 하고 웃었다.]==] },
	q_ch_alchemy_powder = { [==[화약은 정제할수록 힘이 강해진다. 그러나 더 강한 화약은 더 위험하다. 정제의 지식은 파괴와 보호를 동시에 가능하게 한다.]==], [==[새 화약이 안전하게 점화되었다. 학자가 "이 힘이 올바른 손에 있기를" 하고 기도했다.]==] },
	q_ch_alchemy_battle = { [==[새로 다듬은 화약은 실험실에서는 완벽했다. 이제 바다에서 시험할 차례다. 여덟 번의 해전이 정제된 화약의 진짜 성적표가 된다.]==], [==[여덟 번째 승리 뒤 화약 장인이 보고서를 받았다. 마지막 줄에 "실험 성공"이라 적혔다.]==] },
	q_ch_alchemy_glass = { [==[모래와 재가 불 속에서 투명해진다. 유리는 연금술사가 금보다 먼저 얻은 기적이었다. 렌즈, 거울, 시험관이 모두 이 투명함에서 나왔다.]==], [==[유리 한 장이 불에서 나왔다. 학자가 빛에 비춰 보며 오래 말이 없었다.]==] },
	q_ch_alchemy_oxygen = { [==[불이 타려면 무엇이 필요한가. 오래 사람들은 불의 정령을 말했다. 그러나 한 학자가 유리 종 속에서 촛불이 꺼지는 걸 보며 보이지 않는 숨을 발견했다.]==], [==[새 기체가 병에 담겼다. 학자가 "우리는 늘 이걸 마셨소"라고 속삭였다.]==] },
	q_ch_med_anatomy = { [==[몸속을 보는 일은 한때 금기였다. 그러나 해부학자는 죽은 이를 통해 산 이를 살리는 길을 열었다. 몸속의 지도가 처음 그려졌다.]==], [==[도해가 완성되었다. 해부학자가 "이 선들은 모두 누군가의 선물이오"라고 말했다.]==] },
	q_ch_med_surgeon = { [==[배 위의 의사는 한 사람이 내과와 외과와 약사를 겸한다. 흔들리는 갑판에서 수술하는 일은 평지의 열 배는 어렵다. 선상 의사는 바다의 조용한 영웅이다.]==], [==[첫 수술이 성공했다. 의사가 땀을 닦으며 "파도가 오늘은 도와줬소"라고 웃었다.]==] },
	q_ch_med_scurvy = { [==[괴혈병은 한 항해에서 선원 절반을 앗아 가기도 했다. 라임 한 개가 그 병을 막는다는 사실을 증명하기 위해 한 의사는 선원을 두 편으로 나누어 실험했다.]==], [==[라임 상자가 선창에 실렸다. 선원들이 신 얼굴로 한 개씩 베어 물었다.]==] },
	q_ch_med_quarantine = { [==[항구에서 배를 사십 일 세워 두는 일은 상인에게 손해다. 그러나 사십 일이 도시 하나를 구한다. 검역은 사랑보다 불편하지만 사랑만큼 깊다.]==], [==[검역소 깃발이 내려갔다. 도시 사람들이 조용히 숨을 내쉬었다.]==] },
	q_ch_med_inoculation = { [==[천연두는 왕궁도 오두막도 가리지 않았다. 한 부인이 터키에서 얻은 접종법을 영국에 전하며 아이들의 목숨을 구했다. 두려움을 이긴 용기가 의학을 바꿨다.]==], [==[접종받은 아이가 열 하루 뒤 건강히 뛰어놀았다. 어머니가 눈물을 훔쳤다.]==] },
	q_ch_phi_skeptic = { [==[의심은 불신이 아니라 질문이다. 의심하는 법을 아는 사람만이 속지 않는다. 먼 땅에서 온 이야기를 믿지 않는 법을 배우는 것이 첫 계단이다.]==], [==[첫 의심이 끝났다. 학자가 "이제 믿을 준비가 되었소"라고 말했다.]==] },
	q_ch_phi_reason = { [==[모든 것을 의심한 사람도 의심하는 자기만은 의심할 수 없었다. 거기서 이성이 출발한다. 생각하는 나는 곧 존재하는 나다.]==], [==[한 줄의 논증이 맞물렸다. 학자가 "여기가 땅이오"라고 낮게 말했다.]==] },
	q_ch_phi_method = { [==[가설을 세우고 실험하고 반증한다. 틀린 가설이 맞은 가설만큼 가르친다는 사실이 과학적 방법의 정신이다. 틀림이 지식의 길이 되는 신기한 계단이다.]==], [==[첫 가설이 반증되었다. 학자가 "축하하오, 하나를 배웠소"라고 웃었다.]==] },
	q_ch_phi_contract = { [==[왕이 있어서 법이 있는 게 아니라 사람들의 약속이 있어서 왕이 있다. 사회 계약은 권력의 방향을 바꾸었다. 한 줄의 문장이 왕좌를 흔들었다.]==], [==[계약서의 마지막 줄이 읽혔다. 학자가 "이건 우리 모두의 서명이오"라고 속삭였다.]==] },
	q_ch_phi_light = { [==[계몽은 빛이 아니라 눈을 뜨는 일이다. 눈을 뜬 사람만이 어둠을 본다. 어둠을 보는 순간 사람은 고통스럽지만 비로소 움직일 수 있다.]==], [==[이성의 계단 끝에서 학자가 창을 열었다. 아침 햇빛이 방을 가득 채웠다.]==] },
	q_ch_ship_lateen = { [==[삼각돛은 바람을 비스듬히 받는다. 맞바람에도 갈 수 있다는 사실이 지중해 상인들의 한 세대를 바꾸었다. 방향이 막혀도 길이 있다는 증거다.]==], [==[삼각돛이 바람을 받아 조금씩 맞바람을 거슬렀다. 선원들이 환호했다.]==] },
	q_ch_ship_fluyt = { [==[플루트선은 대포 대신 짐칸을 넓혔다. 적은 선원으로 많은 짐을 싣는다는 단순한 설계가 네덜란드를 상업의 제국으로 만들었다.]==], [==[플루트선의 도면이 맞아떨어졌다. 조선공이 "배도 장부처럼 정직해야 하오"라고 말했다.]==] },
	q_ch_ship_crane = { [==[부두의 크레인은 사람 열 명이 하던 일을 한 명이 하게 한다. 그러나 그 한 명은 열 명의 몫을 책임져야 한다. 기계가 사람을 대신하는 방식을 처음 배우는 날이다.]==], [==[크레인이 상자를 들어 올렸다. 부두 사람들이 말없이 지켜보았다.]==] },
	q_ch_ship_arsenal = { [==[조선소는 배를 만드는 곳이자 한 도시가 스스로를 믿는 방식이다. 베네치아는 하루에 한 척씩 배를 만들었다고 한다. 건물 하나가 한 나라의 자신감이 된다.]==], [==[조선소 설계가 완성되었다. 건축가가 "이 건물은 배보다 오래갈 거요"라고 말했다.]==] },
	q_ch_ship_dock = { [==[건선거는 물을 빼고 배를 마른 땅 위에 올리는 방이다. 바다에서는 못 보는 선체의 상처가 드러난다. 보이지 않는 곳을 고쳐야 배가 오래 산다.]==], [==[배가 마른 바닥 위에 올랐다. 조선공이 선체의 조개를 긁으며 "몇 년을 견뎠군" 하고 웃었다.]==] },
	q_ch_ship_copper = { [==[배 밑바닥에 구리를 입히면 조개와 벌레가 붙지 않는다. 배가 더 빠르고 더 오래간다. 한 장의 구리가 선원 수천 명의 목숨을 연장한다.]==], [==[구리 입힌 배가 바다에 내려가자 선체가 붉게 빛났다. 선원들이 감탄했다.]==] },
	q_ch_nature_herbarium = { [==[표본집은 죽은 식물을 종이 위에 눕혀 둔 책이다. 그러나 이 책 속의 식물은 오히려 사진처럼 오래 산다. 사라지는 것을 붙잡는 가장 오래된 방법이다.]==], [==[첫 표본이 종이에 눌렸다. 식물학자가 "이 한 장이 숲 하나요"라고 속삭였다.]==] },
	q_ch_nature_binomial = { [==[모든 풀에 두 단어의 이름을 붙이는 단순한 규칙이 세상의 혼란을 정리했다. 이름이 없으면 질서도 없다는 린네의 믿음이 이명법이 되었다.]==], [==[이름 하나가 붙었다. 식물학자가 "이제 이 풀은 어디서도 같은 풀이오"라고 말했다.]==] },
	q_ch_nature_explore = { [==[집 근처 식물은 이미 린네의 목록에 있다. 먼 나라에서 가져온 한 포기가 목록을 바꾼다. 스물다섯 장의 카드는 그 먼 나라들의 증언이다.]==], [==[스물다섯 번째 카드가 표본집에 꽂히자 식물학자가 이름표를 새로 쓰기 시작했다.]==] },
	q_ch_nature_anatomy = { [==[꽃 한 송이도 해부하면 수술과 암술의 정교한 설계가 드러난다. 식물의 속을 보는 일은 아름다움이 계산이기도 하다는 걸 배우는 일이다.]==], [==[확대된 도해에서 꽃의 속이 드러났다. 식물학자가 "이 정밀함에는 말이 없소"라고 속삭였다.]==] },
	q_ch_nature_systema = { [==[자연을 한 권의 책으로 정리한다는 야심은 오만으로 보였다. 그러나 이 책이 나온 뒤 세상은 같은 언어로 자연을 말하게 되었다. 질서는 때로 오만에서 나온다.]==], [==[마지막 쪽이 덮였다. 식물학자가 "이제 숲이 한 권이 되었소" 하고 웃었다.]==] },
	q_rg_north_sea_1 = { [==[암스테르담의 양모 길드는 겨울 직전 마지막 배를 기다린다. 늙은 길드장은 북해의 안개를 오래 봐 와서 말이 짧다. "이번 짐이 닿으면 겨울 장부가 맞소. 아니면 직공 서른 집이 굶소."]==], [==[양모가 창고로 들어가자 직조기 소리가 다시 거리를 채웠다. 길드장이 처음으로 당신 이름을 불러 주었다.]==] },
	q_rg_north_sea_2 = { [==[북해 항구의 학자들은 추의 흔들림과 조수의 숨결이 같은 법칙일지 모른다고 의심한다. 물리 카드 세 장이 그 의심을 증거로 바꿀 수 있다.]==], [==[세 번째 카드가 맞물리자 학자가 칠판에 줄 하나를 그었다. "드디어 같은 숫자예요."]==] },
	q_rg_north_sea_3 = { [==[북해의 파도는 해적선보다 정직하다. 그러나 그 파도 위에 깃발을 올리는 자들은 정직하지 않다. 항로를 지킬 네 번의 승리가 필요하다.]==], [==[네 번째 승리 뒤 파도가 잔잔해졌다. 상선들이 안개 속에서 줄지어 지나갔다.]==] },
	q_rg_north_sea_4 = { [==[함부르크 한자 상인들은 동방 도자기를 한 번에 사들이는 큰 장을 연다. 이 장에서 값이 정해지면 북해 전체 시세가 따라간다. "한 번의 장이 한 해의 값이오."]==], [==[큰 장이 끝났다. 함부르크 시청 종탑에서 당신의 이름이 처음 낭독되었다.]==] },
	q_rg_north_sea_5 = { [==[북해의 기록은 늘 파도에 지워졌다. 누군가 도감 열다섯 장으로 이 바다의 얼굴을 한 번 남겨 두면 다음 세대는 그것을 지도처럼 읽을 것이다.]==], [==[열다섯 번째 카드가 꽂히자 도감이 북해의 겨울 풍경을 닮았다.]==] },
	q_rg_north_sea_6 = { [==[북해의 마지막 장은 먼 곳에 있다. 서로 다른 열 항구를 돌면 이 바다 전체가 한 사람의 몸처럼 느껴질 것이다. 마지막에 태곳적 돌이 당신을 기다린다.]==], [==[열 번째 항구에서 당신은 처음으로 북해를 한 문장으로 요약할 수 있었다. "이곳은 기다리는 바다다."]==] },
	q_rg_atlantic_europe_1 = { [==[리스본의 철 상인 에스테방은 대서양을 건너는 배의 못과 닻을 만든다. 이번 달 철이 모자라 신대륙으로 가는 배가 부두에 묶였다. "바다는 기다리는 사람을 가장 먼저 잊소."]==], [==[철이 닿자 부두에 망치 소리가 울렸다. 에스테방이 첫 못을 당신 손에 쥐여 주었다.]==] },
	q_rg_atlantic_europe_2 = { [==[대서양 연안의 해안에는 고래, 바다표범, 철새가 지나간다. 동물 카드 세 장은 이 해안이 하나의 큰 이동로라는 증거가 된다.]==], [==[세 번째 카드가 올랐다. 늙은 사냥꾼이 "그들도 항로가 있었군"이라고 중얼거렸다.]==] },
	q_rg_atlantic_europe_3 = { [==[대서양의 파도는 길다. 그만큼 해적에게 숨을 곳도 많다. 네 번의 승리는 이 긴 바다에 처음으로 안전한 선 하나를 긋는 일이다.]==], [==[네 번째 승리 뒤 대서양의 수평선이 조금 좁아 보였다.]==] },
	q_rg_atlantic_europe_4 = { [==[세비야는 신대륙의 은과 금이 쏟아져 내리는 항구다. 이 도시의 큰 장에 양모를 낼 수 있는 상인은 드물다. "은을 가진 자가 아니라 은을 쓰는 법을 아는 자가 이긴다."]==], [==[큰 장이 끝나자 세비야 거리의 종이 울렸다. 상인 조합이 당신에게 자리를 하나 마련했다.]==] },
	q_rg_atlantic_europe_5 = { [==[대서양 연안의 기록은 포르투갈 일지, 스페인 장부, 프랑스 지도에 흩어져 있다. 열다섯 장의 카드가 그 흩어진 조각들을 한 권으로 꿰맨다.]==], [==[열다섯 번째 카드가 맞물리자 세 나라의 기록이 하나의 해안선으로 이어졌다.]==] },
	q_rg_atlantic_europe_6 = { [==[대서양 연안의 마지막 장은 땅끝에서 열린다. 열 항구를 돌고 나면 이 바다가 왜 새로운 세상을 열었는지 알게 된다. 길 끝에는 바다 위로 솟은 기둥 돌이 기다린다.]==], [==[열 번째 항구의 갑 위에 서서 당신은 대서양의 끝을 보았다. 끝은 시작처럼 보였다.]==] },
	q_rg_mediterranean_1 = { [==[베네치아의 무기고는 철이 떨어지면 배를 못 만든다. 총독이 직접 부두에 나와 선박장 앞을 서성인다. "공화국의 배가 멈추면 공화국도 멈추오."]==], [==[철이 닿자 무기고에서 망치 소리가 울렸다. 총독이 당신에게 조용히 고개를 숙였다.]==] },
	q_rg_mediterranean_2 = { [==[지중해 연안은 옛 신전, 수도교, 성당이 나란히 서 있는 지붕 없는 박물관이다. 건축 카드 세 장은 서로 다른 시대가 같은 해법을 반복했다는 증거다.]==], [==[세 번째 카드가 올랐다. 건축가가 "천 년 전에도 우리와 같은 고민을 했네"라고 웃었다.]==] },
	q_rg_mediterranean_3 = { [==[지중해의 바다는 좁지만 그만큼 해적도 빠르다. 오스만, 베네치아, 제노바의 깃발이 서로 엇갈리는 길목에서 네 번의 승리를 쌓아야 한다.]==], [==[네 번째 승리 뒤 갈라진 깃발들이 잠시 침묵했다. 이 바다에서 침묵은 존중이다.]==] },
	q_rg_mediterranean_4 = { [==[이스탄불의 대시장은 동서의 유리 값을 정하는 곳이다. 이곳에서 베네치아 유리가 제값을 받으면 지중해 전체의 장인들이 숨을 쉰다.]==], [==[큰 장에서 유리 한 점이 햇빛을 받아 터키석처럼 빛났다. 시장의 소음이 잠깐 멎었다.]==] },
	q_rg_mediterranean_5 = { [==[지중해의 기록은 한 문명이 다른 문명 위에 쌓인 지층이다. 열다섯 장의 카드는 그 지층을 한 겹씩 떼어 읽는 일이다.]==], [==[열다섯 번째 카드가 맞춰지자 도감 속에서 그리스, 로마, 오스만이 한 줄로 서 있었다.]==] },
	q_rg_mediterranean_6 = { [==[지중해의 마지막 장은 오래된 언덕 위의 신전이다. 열 항구를 돌고 나면 이 바다가 왜 문명의 요람이 되었는지 알게 된다. 언덕의 대리석이 당신을 기다린다.]==], [==[열 번째 항구에서 당신은 신전 기둥의 그림자 속에 앉아 오래 바다를 바라보았다.]==] },
	q_rg_red_sea_1 = { [==[알렉산드리아의 유리 장인 하미드는 등대의 거울을 다시 닦을 날을 기다렸다. 유리가 모자라 거울이 흐려졌고 배들이 항구를 놓치기 시작했다. "빛이 약해지면 바다가 먼저 알아채오."]==], [==[유리가 닿자 장인이 거울을 닦았다. 그날 밤 등대가 평소보다 멀리까지 빛을 보냈다.]==] },
	q_rg_red_sea_2 = { [==[홍해와 북아프리카에는 세 개의 문자가 한 비석에 새겨진 곳이 있다. 언어 카드 세 장은 서로 다른 말들이 같은 뜻을 가졌다는 걸 알려 준다.]==], [==[세 번째 카드가 올랐다. 비석의 세 줄이 같은 문장이라는 걸 당신은 소리 내어 읽었다.]==] },
	q_rg_red_sea_3 = { [==[홍해는 좁은 바다라 해적이 숨을 곳이 적지만 한 번 걸리면 도망칠 곳도 없다. 네 번의 승리가 순례선과 향료선의 길을 안전하게 만든다.]==], [==[네 번째 승리 뒤 홍해 위에 평화가 깔렸다. 순례선들이 새벽에 줄지어 지나갔다.]==] },
	q_rg_red_sea_4 = { [==[아덴의 큰 장은 인도양과 홍해가 만나는 곳이다. 쌀 한 가마니의 값이 이 장에서 동쪽과 서쪽의 가격을 정한다. "문 앞의 시장은 두 대륙의 입이오."]==], [==[큰 장이 열리자 아덴 부두가 쌀 향기로 가득했다. 상인들이 당신에게 장부 한 칸을 비워 주었다.]==] },
	q_rg_red_sea_5 = { [==[홍해와 북아프리카의 기록은 모래에 쓰인 글처럼 바람에 지워졌다. 열다섯 장의 카드는 그 글자를 다시 붙잡는 일이다.]==], [==[열다섯 번째 카드가 맞춰지자 모래 속에서 한 문명의 숨소리가 들리는 듯했다.]==] },
	q_rg_red_sea_6 = { [==[홍해의 마지막 장은 사막 위에 솟은 가장 거대한 무덤이다. 열 항구를 돌고 나면 이 땅이 왜 시간에 도전했는지 알게 된다.]==], [==[열 번째 항구에서 당신은 모래언덕 위에 앉아 피라미드의 그림자가 길어지는 걸 지켜보았다.]==] },
	q_rg_west_africa_1 = { [==[엘미나 시장의 직조 상인 아와는 고향의 옷감 무늬를 해변에서 팔고 싶다. 하지만 물량이 모자라 이번 장을 놓칠 판이다. "무늬마다 이름이 있어요. 이름을 파는 거예요."]==], [==[옷감이 시장에 펼쳐지자 사람들이 무늬 이름을 하나씩 불러 보았다. 아와가 눈물을 훔쳤다.]==] },
	q_rg_west_africa_2 = { [==[서아프리카의 유물은 북소리처럼 입에서 입으로 전해졌다. 유물 카드 세 장은 구전의 기억을 금속과 흙으로 붙잡는 일이다.]==], [==[세 번째 카드가 올랐다. 노인이 청동 두상을 쓰다듬으며 "우리 조상이 이렇게 웃었구나" 속삭였다.]==] },
	q_rg_west_africa_3 = { [==[서아프리카 해안은 길고 곳곳이 얕다. 약탈선이 숨기에 좋다. 네 번의 승리가 해안 마을들이 안심하고 밤에 불을 켜게 만든다.]==], [==[네 번째 승리 뒤 해안 마을마다 밤 불이 켜졌다. 멀리서 보면 길게 이어진 목걸이 같았다.]==] },
	q_rg_west_africa_4 = { [==[우이다의 큰 장에서 포도주 여섯 병은 금가루 몇 줌의 값이다. 상인 코조는 말한다. "값은 서로가 믿는 만큼 정해지오. 서둘러선 안 되오."]==], [==[큰 장이 끝났다. 코조가 금가루 주머니를 건네며 말했다. "다음 장에도 당신의 자리를 비워 두겠소."]==] },
	q_rg_west_africa_5 = { [==[서아프리카의 기록은 노래다. 열다섯 장의 카드는 노래의 가사를 글로 옮기는 일이다. 어떤 노래는 이미 사라졌고 어떤 노래는 오늘도 불린다.]==], [==[열다섯 번째 카드가 맞춰지자 도감에서 낮은 북소리가 들리는 듯했다.]==] },
	q_rg_west_africa_6 = { [==[서아프리카의 마지막 장은 한 왕이 낙타에 금을 실어 순례 길에 오른 이야기다. 열 항구를 돌고 나면 그 왕의 마음을 조금 알게 된다. 진짜 부는 나눔에서 나왔다.]==], [==[열 번째 항구에서 당신은 해변에 서서 황금이 아닌 한 사람의 이름을 오래 불러 보았다.]==] },
