	q_kn_steam = { [==[로이드는 뉴커먼 기관을 단번에 이해하려다가 앞선 물리 지식의 의미를 놓쳤다. 관련 선행 기록을 차례로 살펴 기관의 역사적 원리를 이해하자.]==], [==[뉴커먼 기관 지식을 보고했다. 로이드는 연구 기록을 연결하고 실제 기계의 성능은 별도 시험으로 남겼다.]==] },
