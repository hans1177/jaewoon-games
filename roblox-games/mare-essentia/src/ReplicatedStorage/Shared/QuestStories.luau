	q_kn_launch = { [==[상인 클라스는 개량 상품을 소개할 때 손님이 무엇을 알고 싶어 하는지 묻는다. 과장된 광고보다 실제 출시 행사의 경험을 쌓자.]==], [==[신제품 출시 행사 목표를 완료했다. 클라스는 행사 기록과 실제 판매 실적을 구분해 장부에 남겼다.]==] },
	q_kn_all = { [==[서기 마리는 한 분야의 지식만으로 시대의 모든 변화를 설명할 수 없음을 깨닫는다. 여러 지식을 이해해 자신의 질문을 넓히자.]==], [==[지식 이해 목표를 달성했다. 마리는 계몽의 여러 관점과 아직 모르는 문제를 일지에 함께 남겼다.]==] },
	q_ch_nav_compass = { [==[항해 교관은 안개 속에서 방향을 잃었던 제자의 일지를 펼친다. 나침반의 방위 표시를 이해하지 못해 서로 다른 명령을 내렸던 기억이다. 나침반 장미의 지식을 보고하자.]==], [==[나침반 장미 지식을 이해했다. 교관은 방향의 기준과 실제 항해 조건을 구별해 일지에 적고 다음 관측 도구를 소개한다.]==] },
	q_ch_nav_cross = { [==[늙은 항해사는 같은 별을 보고도 서로 다른 값을 적은 두 관측 기록을 보여 준다. 십자 관측기의 원리를 알아야 그 차이를 설명할 수 있다. 관련 지식을 이해하자.]==], [==[십자 관측기 지식을 보고했다. 실제 위도를 측정했다는 뜻은 아니지만 관측 오차를 검토할 토대가 생겼다. 교관은 해상 위험에 관한 다음 의뢰를 꺼낸다.]==] },
	q_ch_nav_pirates = { [==[항해 교관은 낡은 해도에 남은 사략선과 해적에 관한 선원들의 메모를 보여 준다. 항해 지식과 위험에 대응하는 판단을 함께 배우려면 해전 경험도 필요하다.]==], [==[교관은 승리 기록을 위험 해역 자료와 함께 보관했다. 특정 항로의 안전을 단정하지 않고 다음 항해에 참고하기로 했다.]==] },
	q_ch_nav_staff = { [==[항해 교관은 햇빛 아래 관측했던 선원의 불편을 기록한 편지를 보여 준다. 관측 방향을 바꾼 백스태프의 역사적 원리를 알아보자.]==], [==[백스태프 지식을 이해했다. 교관은 서로 다른 관측 기구의 장단점을 비교할 자료를 확보한다. 다음은 해도 자체의 문제다.]==] },
	q_ch_nav_mercator = { [==[지도상 마르틴은 같은 항로가 다른 지도에서는 서로 다르게 보이는 이유를 묻는다. 둥근 지구를 평면으로 나타내는 메르카토르 도법의 특징과 한계를 이해하자.]==], [==[메르카토르 도법 지식을 보고했다. 마르틴은 항해에 유용한 성질과 면적 왜곡을 구별해 정리했다. 남은 질문은 경도다.]==] },
	q_ch_nav_longitude = { [==[마르틴은 위도를 알아도 동서 위치를 알기 어려웠던 선원의 항해 일지를 읽는다. 오래된 경도 문제를 해결하려 했던 여러 방법을 살펴보자.]==], [==[경도 문제에 관한 지식을 이해했다. 실제 위치 계산과 지식 보고는 구별된다. 해상 시계가 다음 연구 대상이다.]==] },
	q_ch_nav_chrono = { [==[시계공은 육지에서 잘 맞는 시계도 배의 움직임과 환경을 만나면 오차가 생길 수 있다고 설명한다. 해상 시계의 역사와 설계 목적을 이해하자.]==], [==[해상 시계 지식을 보고했다. 교관과 마르틴은 방향·관측·해도·경도의 기록을 한데 정리했다. 실제 항해 시험은 별개의 과제로 남겼다.]==] },
	q_ch_geo_trade = { [==[도선사 카림은 먼바다의 바람을 모두 우연으로 생각했던 항해자의 기록을 보여 준다. 무역풍의 일반적인 흐름을 이해하되 날씨를 보증하는 약속으로 여기지 말자.]==], [==[무역풍 지식을 이해했다. 카림은 바람의 경향과 개별 항해의 기상 기록을 구별한다. 다음은 남쪽 곶의 지리다.]==] },
	q_ch_geo_cape = { [==[희망봉을 지나온 선원의 편지에는 두려움과 바다의 지리가 뒤섞여 있다. 곶의 이름에 관한 전승보다 실제 위치와 항해 조건을 이해하자.]==], [==[희망봉 지식을 보고했다. 카림은 항로의 의미를 정리하고 인도양의 계절풍 자료를 꺼냈다.]==] },
	q_ch_geo_monsoon = { [==[말라바르 상인 미라는 구매선이 늦어져 농가 계약을 지키기 어려웠던 때를 이야기한다. 지역과 계절에 따라 달라지는 바람의 지식을 이해하자.]==], [==[계절풍 지식을 이해했다. 미라는 바람의 변화와 교역 일정의 관계를 설명하며 암스테르담 후추 주문을 부탁한다.]==] },
	q_ch_geo_spice = { [==[미라는 바람에 관한 지식을 배웠다고 모든 운송이 성공하는 것은 아니라고 한다. 실제 주문을 지키는 일이 항해자의 다음 책임이다. 암스테르담 후추 납품을 마치자.]==], [==[후추 납품이 기록되었다. 미라는 운송 기록과 배운 지리를 별도로 정리하고 남아메리카의 좁은 물길 자료를 건넨다.]==] },
	q_ch_geo_magellan = { [==[마르틴은 세계 일주 원정의 기록에서 마젤란의 항해와 귀환한 선원들의 이야기가 다르게 남았음을 발견한다. 마젤란 해협의 실제 지리 지식을 이해하자.]==], [==[해협 지식을 보고했다. 한 사람의 영웅담만으로 원정 전체를 설명하지 않기로 했다. 더 남쪽의 케이프혼이 다음 자료다.]==] },
	q_ch_geo_horn = { [==[케이프혼의 거친 바다를 그린 선원담에는 실제 항해 경험과 과장이 섞여 있다. 곶의 지리와 바다를 이해하는 지식으로 여정을 마치자.]==], [==[케이프혼 지식을 이해했다. 카림은 무역풍부터 남쪽 물길까지 지리 자료를 모았다. 항해의 성공을 장담하는 대신 준비의 근거로 남긴다.]==] },
	q_ch_steam_pendulum = { [==[시계 견습공 로이드는 진자가 언제나 정확히 같은 간격으로 움직인다고 믿다가 스승의 반문을 듣는다. 진자 운동의 원리와 적용 조건을 이해하자.]==], [==[진자 지식을 보고했다. 로이드는 이상적인 규칙과 실제 시계의 오차를 구별해 기록한다. 다음은 물체의 운동이다.]==] },
	q_ch_steam_gravity = { [==[로이드는 떨어지는 물체와 달의 운동을 서로 다른 문제라고 생각했다. 뉴턴의 중력에 관한 지식을 통해 두 현상을 설명하는 관점을 알아보자.]==], [==[중력 지식을 이해했다. 사과 일화 자체를 증거로 삼지 않고 법칙의 의미를 정리했다. 다음은 공기의 성질이다.]==] },
	q_ch_steam_boyle = { [==[연구자는 보이지 않는 공기를 아무것도 없는 공간이라고 여겼던 견습생의 노트를 보여 준다. 보일의 법칙을 비롯한 공기의 물리적 성질을 이해하자.]==], [==[보일의 법칙 지식을 보고했다. 실험을 직접 수행했다는 기록 대신 압력과 부피의 관계에 대한 이해를 남겼다.]==] },
	q_ch_steam_papin = { [==[로이드는 파팽이 연구한 증기 솥의 기록에서 압력과 안전이라는 두 질문을 발견한다. 증기 기술의 역사적 발전에 관한 지식을 이해하자.]==], [==[파팽의 증기 솥 지식을 이해했다. 장치는 실제로 제작하거나 작동시킨 것이 아니다. 로이드는 후속 연구에 필요한 석탄 주문을 준비한다.]==] },
	q_ch_steam_coal = { [==[루앙 공방은 연료의 공급 문제로 연구 일정이 밀렸다. 로이드는 이론뿐 아니라 재료의 조달도 기술 발전의 일부라고 말한다. 석탄 주문을 납품하자.]==], [==[석탄 납품이 기록되었다. 공방은 연구 재료를 확보했으며 장치의 작동 성과는 아직 확인할 과제로 남았다.]==] },
	q_ch_steam_engine = { [==[광산의 물을 퍼 올리려는 기술자들의 기록을 로이드가 펼친다. 뉴커먼 기관이 어떤 문제를 해결하려 등장했는지 이해하자.]==], [==[뉴커먼 기관 지식을 보고했다. 광산 배수 기술의 역사와 선박용 기관은 다른 발전 단계로 기록한다.]==] },
	q_ch_steam_engine_ship = { [==[조선 기술자는 육상 기관을 배에 옮기는 일이 단순한 복제가 아니라고 말한다. 선박용 증기기관의 지식을 이해해 연구의 마지막 자료를 마련하자.]==], [==[선박용 증기기관 지식을 이해했다. 로이드는 앞선 물리 지식과 기관의 역사적 관계를 정리한다. 실제 선박 제작과 운항은 별도다.]==] },
	q_ch_sky_polaris = { [==[천문 관측 조수 파벨은 별 하나가 언제나 모든 바다에서 길을 알려 준다고 생각했다. 북극성이 항해에 쓰이는 이유와 관측 가능한 범위를 이해하자.]==], [==[북극성 지식을 보고했다. 파벨은 별의 위치와 항해자의 관측 조건을 구별한다. 다음은 옛 관측자의 기록이다.]==] },
	q_ch_sky_observer = { [==[파벨은 오래된 하늘 기록의 작성자가 누구인지 알 수 없어 답답해한다. 이름이 없어도 남은 관측 자료의 의미를 알아볼 수 있다. 옛 관측자 지식을 이해하자.]==], [==[옛 관측자 기록을 이해했다. 파벨은 알려진 자료와 확인할 수 없는 작성자의 이름을 구별해 적었다.]==] },
	q_ch_sky_jupiter = { [==[파벨은 목성 곁의 작은 빛을 고정된 별이라고 여겼던 관측 기록을 살펴본다. 갈릴레오의 목성 위성 관측이 당시 우주관에 던진 질문을 이해하자.]==], [==[목성의 달 지식을 보고했다. 파벨은 관측과 그 해석을 구분해 남겼다. 다음 자료는 두려움의 대상이었던 혜성이다.]==] },
	q_ch_sky_comet = { [==[항구에서 혜성이 재앙의 징조라는 소문이 퍼진다. 파벨은 사람의 두려움을 존중하되 하늘의 물체를 관측과 이론으로 이해하고 싶다.]==], [==[혜성 지식을 이해했다. 징조에 대한 전승과 천문학적 설명을 다른 기록으로 나눴다. 핼리의 귀환 예측을 살펴볼 차례다.]==] },
	q_ch_sky_halley = { [==[핼리의 혜성 연구를 읽던 파벨은 예측과 확인을 같은 것으로 적었던 실수를 발견한다. 과거 관측을 비교하여 귀환을 예측한 역사적 의미를 이해하자.]==], [==[핼리의 예측 지식을 보고했다. 파벨은 예측을 세운 일과 후대의 관측 확인을 구별했다. 자신이 실제 혜성을 관측했다고 쓰지는 않았다.]==] },
	q_ch_alchemy_distill = { [==[견습 연구자 엘리스는 연금술 필사본의 상징과 물질을 분리하는 기술의 기록을 함께 읽는다. 증류가 역사적으로 어떤 질문에 쓰였는지 이해하자.]==], [==[증류 지식을 보고했다. 엘리스는 상징적 해석과 실제 물질 연구의 목적을 구별한다.]==] },
	q_ch_alchemy_acid = { [==[엘리스는 옛 약종상의 설명이 서로 맞지 않는 이유를 묻는다. 물질을 분류하고 성질을 설명하는 산과 염기의 개념을 이해하자.]==], [==[산과 염기 지식을 보고했다. 실제 화학 실험 결과를 만들어내지 않고 분류의 근거를 정리했다.]==] },
	q_ch_alchemy_powder = { [==[연구자는 역사적 화약 기술의 기록을 보며 새로운 기술에 따르는 책임과 위험을 이야기한다. 제조법을 시험하는 대신 관련 지식의 역사적 배경을 이해하자.]==], [==[관련 기술 지식을 보고했다. 연구자는 이해와 실제 제조·성능 검증을 구별하며 다음 전투 기록 의뢰를 소개한다.]==] },
	q_ch_alchemy_battle = { [==[연구자는 실험실 기록과 선상의 전투 경험을 혼동하지 말라고 한다. 해전 승리가 화약이나 장비의 성능을 증명하지는 않는다. 연구의 다음 질문을 찾을 전투 기록을 부탁한다.]==], [==[해전 승리 기록을 연구 장부의 참고 자료로 남겼다. 기술의 효능은 별도의 검증으로 남겨 두었다.]==] },
	q_ch_alchemy_glass = { [==[엘리스는 깨진 렌즈와 공방 장부를 보고 투명한 재료가 관찰 도구의 발전에 어떤 역할을 했는지 묻는다. 유리 제조에 관한 지식을 이해하자.]==], [==[유리 지식을 보고했다. 공예 기술과 과학 관측의 관계를 정리했으며 실제 유리를 제작했다는 결과는 남기지 않았다.]==] },
	q_ch_alchemy_oxygen = { [==[옛 연소 설명을 읽던 엘리스는 새로운 관측이 기존 이론을 바꾸는 과정을 궁금해한다. 산소의 발견과 연소 연구의 역사적 의미를 이해하자.]==], [==[산소 지식을 보고했다. 엘리스는 물질에 대한 설명이 증거와 함께 수정된다는 점을 연구 일지에 남겼다.]==] },
	q_ch_med_anatomy = { [==[선의 토머스는 서로 다른 해부학 도해를 보여 주며 옛 그림을 그대로 믿기 어렵다고 말한다. 인체 구조를 기록한 의학의 역사를 이해하자.]==], [==[해부학 지식을 보고했다. 토머스는 도해의 역사적 의미를 정리했으며 실제 의료 행위의 결과로 기록하지 않았다.]==] },
	q_ch_med_surgeon = { [==[토머스는 항해 중 아픈 선원을 돌보던 의사의 일지를 읽는다. 배 위의 제한된 환경에서 의료가 어떤 어려움을 겪었는지 알아보자.]==], [==[선상 의사 지식을 이해했다. 치료 성공을 단정하지 않고 의료 환경과 당시 지식의 한계를 기록했다.]==] },
	q_ch_med_scurvy = { [==[선원들의 식량 장부에서 긴 항해 중 발생한 괴혈병의 문제를 발견한다. 토머스는 감귤류와 괴혈병 연구의 역사를 당시의 지식과 구별해 이해하려 한다.]==], [==[괴혈병 관련 지식을 보고했다. 식량과 질병의 역사적 관계를 정리했으며 실제 환자를 치료했다는 의미는 아니다.]==] },
	q_ch_med_quarantine = { [==[항만 관리와 상인은 질병 확산을 막는 일과 생업을 이어 가는 일을 두고 의견이 다르다. 토머스는 검역의 역사와 목적을 이해할 자료를 부탁한다.]==], [==[검역 지식을 보고했다. 토머스는 당시 제도와 현대의 방역 지식을 구별하고 실제 유행이 끝났다고 주장하지 않는다.]==] },
	q_ch_med_inoculation = { [==[토머스는 천연두를 예방하려 했던 여러 사회의 기록을 읽는다. 역사적 인두법과 후대의 예방접종을 같은 기술로 혼동하지 않도록 관련 지식을 이해하자.]==], [==[천연두 접종의 역사 지식을 보고했다. 의료 발전의 의미와 당시 방법의 위험을 구분해 기록했으며 실제 접종은 수행하지 않았다.]==] },
	q_ch_phi_skeptic = { [==[서기 마리는 믿고 싶었던 항해담이 다른 증언과 맞지 않아 고민한다. 회의주의가 무조건 부정하는 태도와 어떻게 다른지 이해하자.]==], [==[회의주의 지식을 보고했다. 마리는 질문을 남기는 것과 모든 기록을 불신하는 것을 구별하기로 한다.]==] },
	q_ch_phi_reason = { [==[마리는 서로 다른 철학자가 지식의 근거를 다르게 설명하는 글을 읽는다. 이성을 중시하는 합리주의의 역사적 논의를 이해하자.]==], [==[합리주의 지식을 보고했다. 하나의 철학적 입장을 모든 질문의 정답으로 만들지 않고 다른 관점과 비교할 자료로 남겼다.]==] },
	q_ch_phi_method = { [==[마리는 자신의 예상에 맞는 기록만 모았다는 사실을 발견한다. 관찰과 가설, 검토가 지식의 변화에 어떤 역할을 하는지 이해하자.]==], [==[과학적 방법 지식을 보고했다. 실제 실험 성공을 주장하지 않고 틀릴 수 있는 설명을 검토하는 태도를 기록했다.]==] },
	q_ch_phi_contract = { [==[항만 회의의 권한을 두고 상인과 주민의 의견이 갈린다. 마리는 사회 계약론이 권력의 정당성을 어떻게 질문했는지 이해하려 한다.]==], [==[사회 계약론 지식을 보고했다. 특정 정치 제도가 실제로 바뀌었다는 뜻이 아니라 서로 다른 정당성의 설명을 비교할 자료가 생겼다.]==] },
	q_ch_phi_light = { [==[마리는 앞서 읽은 철학자들이 모든 문제에 같은 답을 내놓지 않았음을 깨닫는다. 계몽 사상의 여러 질문과 시대적 한계를 이해하자.]==], [==[계몽 지식을 보고했다. 마리는 이성의 가치와 당시 사회의 모순을 함께 기록하며 철학의 여정을 마쳤다.]==] },
	q_ch_ship_lateen = { [==[조선 견습공 이네스는 돛의 모양이 다르면 같은 바람에서도 운용 방식이 달라진다는 설명을 듣는다. 삼각돛의 역사와 설계 목적을 이해하자.]==], [==[삼각돛 지식을 보고했다. 이네스는 실제 항해 성능과 도면의 이해를 구별해 기록한다.]==] },
	q_ch_ship_fluyt = { [==[이네스는 화물을 많이 싣는 배와 다른 임무를 가진 배의 도면을 비교한다. 네덜란드 플루트선의 상업적 설계 특징을 이해하자.]==], [==[플루트선 지식을 보고했다. 배의 목적에 따른 설계 차이를 정리했으며 선박을 건조했다고 기록하지 않았다.]==] },
	q_ch_ship_crane = { [==[부두 노동자는 화물을 다루는 도구가 바뀌어도 안전과 노동의 책임은 남는다고 말한다. 이네스와 함께 항만 크레인의 역사적 기능을 이해하자.]==], [==[항만 크레인 지식을 보고했다. 이네스는 작업 시설의 목적을 정리하고 실제 하역 작업의 성과는 별도로 남겼다.]==] },
	q_ch_ship_arsenal = { [==[베네치아의 조선소 기록에는 장인과 재료, 작업 공간의 관계가 드러난다. 이네스는 한 사람의 솜씨만으로 함대를 만들 수 없다는 점을 이해하려 한다.]==], [==[조선소 지식을 보고했다. 이네스는 작업의 조직과 건축의 역할을 정리한다. 다음 자료는 건선거다.]==] },
	q_ch_ship_dock = { [==[조선공은 물속에 잠긴 선체를 제대로 살펴보기 어려웠던 일을 이야기한다. 건선거가 선박의 점검과 수리에 어떤 역할을 하는지 이해하자.]==], [==[건선거 지식을 보고했다. 실제 선체 수리와 시설의 원리 이해를 구별했다.]==] },
	q_ch_ship_copper = { [==[이네스는 선체의 오염과 손상을 줄이려 했던 여러 역사적 기술을 비교한다. 구리 피복의 목적과 당시 조선 기술에서의 위치를 이해하자.]==], [==[구리 피복 지식을 보고했다. 이네스는 선박 설계의 여러 자료를 한 일지에 정리했다. 실제 선박의 속도나 수명은 측정하지 않았다.]==] },
	q_ch_nature_herbarium = { [==[식물학 견습생 레나는 이름이 지워진 표본을 정리하면서 관찰 기록의 중요성을 깨닫는다. 식물 표본집이 연구와 비교에 어떻게 쓰이는지 이해하자.]==], [==[식물 표본집 지식을 보고했다. 레나는 표본의 출처와 이름을 함께 기록해야 한다는 질문을 남긴다.]==] },
	q_ch_nature_binomial = { [==[레나는 같은 식물이 항구마다 다른 이름으로 불리는 문제를 살펴본다. 린네의 이명법과 분류 명칭이 연구자 사이의 의사소통에 어떤 역할을 하는지 이해하자.]==], [==[이명법 지식을 보고했다. 지역의 이름을 지우지 않고 학술 명칭과 구분해 정리했다. 다음은 발견 기록을 넓히는 일이다.]==] },
	q_ch_nature_explore = { [==[식물학자는 오래된 분류표만으로 새로운 발견을 설명할 수 없다고 말한다. 다양한 도감 기록을 모아 자연의 체계에 어떤 질문을 던질 수 있는지 살펴보자.]==], [==[발견 목표가 채워졌다. 식물학자는 식물 분야의 기록과 다른 분야의 기록을 나누어 후속 연구의 자료로 삼았다.]==] },
	q_ch_nature_anatomy = { [==[레나는 겉모양만 비슷한 식물의 구조가 다를 수 있다는 설명을 듣는다. 식물 해부도의 역사적 가치와 관찰의 목적을 이해하자.]==], [==[식물 해부도 지식을 보고했다. 실제 식물 해부를 했다는 주장 대신 구조를 비교할 자료를 정리했다.]==] },
	q_ch_nature_systema = { [==[레나는 자연을 분류한 책이 모든 생물에 관한 마지막 정답은 아니라는 것을 배운다. 린네의 자연의 체계와 분류학의 역사적 의미를 이해하자.]==], [==[자연의 체계 지식을 보고했다. 레나는 표본과 이름, 발견과 구조의 기록을 연결했다. 새로운 관찰로 분류가 수정될 수 있다는 질문을 남겼다.]==] },
	q_rg_north_sea_1 = { [==[얀센의 딸 마르타는 실종선 편지에 그려진 방벽이 바다의 길을 표시한다고 믿는다. 그러나 양모 주문부터 살려야 조사비가 생긴다.]==], [==[납품을 받은 마르타는 편지 속 방벽의 돌을 세기 시작했다. 로마의 방벽 기록과 비교할 차례다.]==] },
	q_rg_north_sea_2 = { [==[물리 발견 자료를 모아 방벽과 자연의 흔적을 구별하자. 마르타는 편지의 방향이 거꾸로 복사된 것 같다고 의심한다.]==], [==[방벽의 유산 기록에는 북해의 비밀 항로가 없었다. 편지가 항해용 지도인지부터 의심하게 됐다.]==] },
	q_rg_north_sea_3 = { [==[마르타가 방벽 그림을 뒤집자 선주의 편지와 닮은 표식이 나타난다. 셀키 전승은 실종에 대한 두려움을 설명할 뿐 범인의 증거는 아니다. 해전 경험과 문서 조사를 따로 진행한다.]==], [==[해전 승리 기록을 남겼다. 마르타는 편지의 진위를 보류하고 스카라 브레 집터 그림을 꺼냈다.]==] },
	q_rg_north_sea_4 = { [==[함부르크의 도자기 주문을 마치고 오래된 집터 기록을 받자. 편지의 돌집은 방벽과 같은 시대라는 주장이 있다.]==], [==[스카라 브레 기록을 받았다. 서로 다른 시대의 유산을 한 장에 그려 넣었다는 의심이 커졌다.]==] },
	q_rg_north_sea_5 = { [==[거석 원이 별의 위치를 알려 주는 지도라는 편지의 주장을 살펴보자. 발견 기록을 쌓아 브로드가르 자료를 확보한다.]==], [==[거석 원의 기록이 도착했다. 마지막으로 스톤헨지와 비교해야 편지의 의도를 판단할 수 있다.]==] },
	q_rg_north_sea_6 = { [==[항구 방문 목표를 채워 마지막 유산을 받자. 마르타는 아버지의 그림을 펼치며 이것이 항해도가 아니라 유적을 찾아보라는 편지일 수도 있다고 말한다.]==], [==[마르타는 거꾸로 그린 방벽을 더 이상 보물 지도로 읽지 않았다. 여러 시대 유산의 그림을 모은 가상 편지였다는 해석을 남기고 네 유산을 각각 기록했다.]==] },
	q_rg_atlantic_europe_1 = { [==[리스본의 이네스에게 이스의 침몰 도시에서 종소리를 들었다는 편지가 왔다. 편지를 보낸 선원의 배는 수리를 기다린다. 철 주문부터 마치자.]==], [==[철이 도착하자 선원은 바다에서 들린 종이 아니라 그림 속 돌의 배열이 기억난다고 고백했다. 카르나크 자료가 필요하다.]==] },
	q_rg_atlantic_europe_2 = { [==[동물 분야의 발견을 쌓아 카르나크 유산 기록을 받자. 이네스는 전승과 직접 관찰을 섞지 않겠다고 약속한다.]==], [==[카르나크는 실제 거석 유산이지만 침몰 도시의 증거는 아니었다. 다음 계약에는 해상 위험을 기록한 선주들의 의뢰가 들어 있다.]==] },
	q_rg_atlantic_europe_3 = { [==[이네스는 물에 잠긴 이스의 전설을 듣고 사라진 가족의 항해를 떠올린다. 선주들의 불안에는 실제 해상 위험도 얽혀 있다. 해전 경험을 쌓는 동안 편지 문양을 따로 조사하자.]==], [==[승리 목표를 마쳤다. 이네스가 편지를 뒤집자 뉴그레인지처럼 보이는 둥근 구조의 그림이 나타났다.]==] },
	q_rg_atlantic_europe_4 = { [==[세비야의 양모 계약을 마치면 뉴그레인지 기록을 받을 수 있다. 선원은 그 그림이 종탑이라고 주장한다.]==], [==[뉴그레인지 기록은 종탑이라는 설명과 맞지 않았다. 이네스는 루앙 성당 그림과 혼동한 것인지 비교하려 한다.]==] },
	q_rg_atlantic_europe_5 = { [==[발견 목표를 채워 루앙 성당 유산을 얻자. 종소리 기억과 건축 그림의 관계를 알아볼 자료다.]==], [==[성당과 무덤은 서로 다른 건축이었다. 편지의 마지막 육각형 그림은 자이언츠 코즈웨이 자료와 비교할 수 있다.]==] },
	q_rg_atlantic_europe_6 = { [==[항구 방문 목표를 마쳐 자이언츠 코즈웨이 기록을 받자. 이네스는 선원의 여행담에 여러 장소의 기억이 섞였을 가능성을 살핀다.]==], [==[물에 잠긴 종소리는 전승으로 남겼다. 선원은 여러 장소의 그림을 한 도시의 기억으로 오해했다는 가상 결말을 기록했다.]==] },
	q_rg_mediterranean_1 = { [==[엘레나의 철 주문서 안에 고대 도시의 불에 그을린 도면 사본이 들어 있다. 그녀는 도면을 공방의 비밀이라 주장하는 수집가를 의심한다. 철을 납품하자.]==], [==[철 계약을 마치자 수집가의 도면에 폼페이의 건축을 떠올리게 하는 그림이 보였다.]==] },
