	q_indigo_rouen = { [==[루앙 염색공 필립은 같은 푸른색 주문인데 견본마다 색이 다르다는 항의를 받는다. 인디고 염료의 특징을 비교하려 한다.]==], [==[인디고가 도착해 필립은 염색 견본을 다시 준비했다. 색의 변화는 시험을 거쳐 기록하기로 했다.]==] },
