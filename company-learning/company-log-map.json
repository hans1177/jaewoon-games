{
  "version": 4,
  "authority": "MACHINE_EXECUTION_LOG_MAP",
  "sourceOfTruth": "company-learning/company-log-map.json",
  "centralPolicy": "company-learning/platform-release-roadmap.json",
  "architectureMap": "company-learning/company-architecture-map.json",
  "purpose": "ALL_AI_AND_WORKERS_SHARE_ONE_LOG_LOCATION_AND_CORRELATION_CONTRACT",
  "requiredForAllWorkers": true,
  "canonicalCorrelationKeys": [
    "GITHUB_RUN_ID",
    "GITHUB_RUN_ATTEMPT",
    "TASK_ID",
    "GAME_ID",
    "CANDIDATE_SHA",
    "SOURCE_REVISION",
    "FAILURE_STAGE",
    "FAILURE_SIGNATURE"
  ],
  "logChannels": {
    "githubActions": {
      "role": "PRIMARY_EXECUTION_LOG",
      "location": "GITHUB_ACTIONS_JOB_LOG",
      "retentionDaysMinimum": 7,
      "duplicatePersistentLogForbidden": true
    },
    "artifacts": {
      "role": "STRUCTURED_EVIDENCE_ONLY",
      "locations": [
        "/tmp/*-evidence.json",
        "/tmp/*-result.json",
        "/tmp/*-telemetry.json",
        "/tmp/*-handoff.json"
      ],
      "retentionDaysDefault": 7
    },
    "companyRuntime": {
      "role": "DURABLE_MACHINE_STATE_NOT_RAW_LOG",
      "branch": "company-runtime",
      "allowedStateFiles": [
        "development-queue.json",
        "game-seed-state.json",
        "game-catalog.json",
        "company-status.json"
      ]
    },
    "vibeControl": {
      "role": "DURABLE_VIBE_MACHINE_STATE_NOT_RAW_LOG",
      "branch": "vibe2-unreal-core",
      "allowedStateRoots": [
        ".vibe2/"
      ]
    }
  },
  "requiredMarkers": [
    "WORKER_CONTEXT_POLICY_SHA256",
    "WORKER_CONTEXT_LOG_MAP_SHA256",
    "WORKER_CONTEXT_ARCHITECTURE_SHA256",
    "WORKER_CONTEXT_SYNC=PASS"
  ],
  "failureContract": {
    "exactStageRequired": true,
    "exactSignatureRequired": true,
    "repeatedFailureDedupeRequired": true,
    "staleFailureMayNotOverrideCurrentRawState": true
  },
  "completionContract": {
    "structuredEvidenceBeforeCompletion": true,
    "rawLogAloneCannotProvePass": true,
    "centralPolicyAndArchitectureMustMatchExecution": true
  },
  "orchestrationLogContract": {
    "primaryAiMarkers": [
      "PRIMARY_AI_PRIORITY_DIRECTIVE_ID",
      "PRIMARY_AI_REVIEW=PASS|REWORK|REOPEN|REDIRECT",
      "PRIMARY_AI_SUPERVISION_DOMAIN",
      "PRIMARY_AI_PRIORITY_REASON"
    ],
    "externalWorkerMarkers": [
      "EXTERNAL_AI_WORKER_ID",
      "ASSIGNED_SCOPE",
      "CHANGED_SCOPE",
      "VERIFICATION_EVIDENCE",
      "FAILURE_STAGE",
      "FAILURE_SIGNATURE"
    ],
    "finalAcceptanceRequiresPrimaryAiReview": false,
    "workerSelfAcceptanceForbidden": true,
    "reworkMustReferencePriorAssignment": true,
    "workerMarkers": [
      "WORKER_ID",
      "CANONICAL_TASK_ID",
      "ASSIGNED_OR_AUTONOMOUS_SCOPE",
      "CHANGED_SCOPE",
      "VERIFICATION_EVIDENCE",
      "FAILURE_STAGE",
      "FAILURE_SIGNATURE"
    ],
    "deterministicMachineGateMayCompleteWithoutPrimaryAi": true,
    "workerMustNotInventPolicy": true,
    "workerMayCompleteCanonicalTaskWhenDeterministicGatePasses": true,
    "reworkDirectiveMustReferenceTaskOrPriorEvidence": true,
    "supervisorAbsenceIsNotAWorkerBlocker": true
  },
  "systemAiWorkerLogContract": {
    "queue": "vibe2-unreal-core:.vibe2/system-ai-queue.json",
    "requiredMarkers": [
      "SYSTEM_AI_TASK_ID",
      "SYSTEM_AI_RESERVATION_ID",
      "SYSTEM_AI_CANDIDATE_BRANCH",
      "SYSTEM_AI_PR_URL",
      "SYSTEM_AI_VERIFICATION",
      "PRIMARY_AI_REVIEW"
    ],
    "rawModelOutputStored": false,
    "rawModelOutputSha256Required": true,
    "workerSelfAcceptanceForbidden": true,
    "failedVerificationMustRequeueOrFail": true,
    "primaryAiReviewMayAcceptReworkReopenOrRedirect": true
  }
}
