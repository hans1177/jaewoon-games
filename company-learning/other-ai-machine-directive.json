      "webBaseMustCarryForward": true,
      "platformAdaptationAllowed": true,
      "silentScopeDropForbidden": true,
      "nativeRuntimeEvidenceRequiredSeparately": true,
      "webPassCannotSubstituteNativePass": true
    },
    "robloxPostRelease": {
      "enabled": true,
      "state": "POST_RELEASE_FOCUSED_DEVELOPMENT",
      "protectedRunnerSlots": 1,
      "maxActiveFocusTaskPerProject": 1,
      "continuousRefill": true,
      "sourceRoot": "roblox-games/<gameId>",
      "priorities": [
        "gameplay-completeness",
        "content-depth",
        "roblox-native-ux",
        "mobile-readability",
        "performance",
        "maintainability",
        "verified-learning-reuse"
      ],
      "ownerHoldOrKillStopsFocus": true
    }
