{
  "version": 2,
  "updatedAt": "2026-09-19",
  "kind": "MACHINE_EXECUTION_DIRECTIVE",
  "audience": "OTHER_AI_AND_RUNNERS",
  "humanDocumentRequired": false,
  "authority": "NON_AUTHORITATIVE_EXECUTION_GUIDE",
  "sourceOfTruth": "company-learning/platform-release-roadmap.json",
  "policyOverrideAllowed": false,
  "requiredReads": [
    "company-directive.json",
    "company-learning/platform-release-roadmap.json",
    "company-learning/canonical-learning-pipeline.json",
    "company-learning/vibe2-learning-motor.json",
    ".vibe2/experience.json"
  ],
  "executionRules": {
    "latestMainRequired": true,
    "latestControlStateRequiredWhenTouchingVibeRuntime": true,
    "preserveExistingAutomation": true,
    "preserveExistingSettings": true,
    "inventVerifiedPassForbidden": true,
    "directPolicyMutationForbidden": true,
    "gameplayImplementationOwner": "VIBE2_VIBE3",
    "nonVibeGameSourceWriteAllowed": false,
    "nonVibeRole": [
      "TEACH",
      "REVIEW",
      "DIAGNOSE",
      "UNBLOCK",
      "VALIDATE",
      "ORCHESTRATION_CI_WHEN_NEEDED"
    ]
  },
  "developmentLifecycle": {
    "platformGenreDecisionRequiredBeforeImplementation": true,
    "webFirst": {
      "required": true,
      "role": "PORTABLE_EXECUTABLE_GAMEPLAY_BASELINE",
      "disposablePrototype": false,
      "implementRealBaseSystems": true,
      "carryForward": [
        "core-loop",
        "gameplay-state-model",
        "progression-model",
        "input-intent",
        "ui-flow",
        "save-meaning",
        "content-structure",
        "balance-intent",
        "verified-learning-context"
      ],
      "preserveReusableSystems": true,
      "preserveSaveMeaningWhenCompatible": true,
      "restartFromBlankForbiddenWhenValidContinuationExists": true
    },
    "nativeSecondStage": {
      "selectedPlatformSourceBindRequired": true,
      "webBaseMustCarryForward": true,
      "platformAdaptationAllowed": true,
      "silentScopeDropForbidden": true,
      "nativeRuntimeEvidenceRequiredSeparately": true,
      "webPassCannotSubstituteNativePass": true
    },
    "robloxPostRelease": {
      "enabled": true,
      "state": "POST_RELEASE_FOCUSED_DEVELOPMENT",
      "protectedRunnerSlots": 1,
      "maxActiveFocusTaskPerProject": 1,
      "continuousRefill": true,
      "sourceRoot": "roblox-games/<gameId>",
      "priorities": [
        "gameplay-completeness",
        "content-depth",
        "roblox-native-ux",
        "mobile-readability",
        "performance",
        "maintainability",
        "verified-learning-reuse"
      ],
      "ownerHoldOrKillStopsFocus": true
    }
  },
  "learning": {
    "continuous24h": true,
    "googlePlayRotationContinuous": true,
    "catalogWrapMustNotStopStudy": true,
    "canonicalDistillationContinuous": true,
    "waitingForVerifiedSamplesMeansCollectionStateNotFailure": true,
    "maximizeVerifiedLearningUse": true,
    "sameGameVerifiedKnowledgeHighestPriority": true,
    "crossGameTransformativeRecombinationAllowed": true,
    "rawCopyForbidden": true,
    "newExpressionRequired": true,
    "retrievalSources": [
      ".vibe2/experience.json",
      ".vibe2/game-study-knowledge.json",
      "company-learning/vibe3-memory-index.json",
      "company-learning/vibe3-recombination-memory.json",
      "company-learning/vibe3-task-playbooks.json",
      "company-learning/vibe2-code-pattern-library.json"
    ],
    "learningMayExpandAuthority": false,
    "learningMayReplaceNativeVerification": false,
    "promotionStillRequires": "FIXED_HOLDOUT_AB_THEN_CANARY"
  },
  "localExecution": {
    "initiateLocalModelTraining": false,
    "reason": "OWNER_CURRENTLY_HAS_NO_LOCAL_TRAINING_PLAN",
    "doNotChangeCanonicalTrainingRoute": true
  },
  "doNot": [
    "CREATE_SHADOW_PIPELINE",
    "LOWER_VERIFICATION_GATES",
    "RESTART_VALID_PROJECT_FROM_BLANK",
    "DROP_APPROVED_SCOPE_SILENTLY",
    "TREAT_WEB_PASS_AS_NATIVE_PASS",
    "WRITE_GAMEPLAY_SOURCE_AS_NON_VIBE_AI",
    "STOP_24H_LEARNING_AT_CATALOG_WRAP",
    "CLAIM_MODEL_TRAINING_BEFORE_READINESS"
  ],
  "successContract": [
    "CENTRAL_POLICY_READ",
    "VERIFIED_LEARNING_REUSED",
    "WEB_BASE_PRESERVED_IN_NATIVE_CONTINUATION",
    "NATIVE_RUNTIME_REVERIFIED",
    "ROBLOX_RELEASE_CAN_ENTER_ONE_SLOT_POST_RELEASE_FOCUS",
    "NEW_VERIFIED_LESSONS_PERSISTED"
  ],
  "workOrder": {
    "id": "WEB_TO_NATIVE_TO_POST_RELEASE_CONTINUOUS_DEVELOPMENT_V1",
    "authority": "EXECUTION_SEQUENCE_ONLY",
    "sourceOfTruth": "company-learning/platform-release-roadmap.json",
    "policyCreationAllowed": false,
    "implementationOwner": "VIBE2_VIBE3",
    "startCondition": "PRODUCTION_CLASS=DEVELOPMENT_CONFIRMED_AND_PLATFORM_AND_GENRE_LOCKED",
    "steps": [
      {
        "order": 1,
        "stage": "LOAD_VERIFIED_LEARNING_CONTEXT",
        "requiredInputs": [
          ".vibe2/experience.json",
          ".vibe2/game-study-knowledge.json",
          "company-learning/vibe3-memory-index.json",
          "company-learning/vibe3-recombination-memory.json",
          "company-learning/vibe3-task-playbooks.json",
          "company-learning/vibe2-code-pattern-library.json"
        ],
        "rules": [
          "SAME_GAME_VERIFIED_KNOWLEDGE_FIRST",
          "CROSS_GAME_TRANSFORMATIVE_RECOMBINATION_ALLOWED",
          "RAW_COPY_FORBIDDEN",
          "NATIVE_VERIFICATION_NOT_REPLACED"
        ]
      },
      {
        "order": 2,
        "stage": "WEB_BASE_IMPLEMENTATION",
        "owner": "VIBE2_VIBE3",
        "requiredBaseSystems": [
          "core-loop-runtime",
          "gameplay-state-model",
          "progression-model",
          "input-intent",
          "ui-flow",
          "save-meaning",
          "content-structure",
          "balance-intent"
        ],
        "output": "webPlatformHandoff",
        "disposablePrototype": false
      },
      {
        "order": 3,
        "stage": "WEB_RUNTIME_VALIDATION",
        "requireRealRuntime": true,
        "completionSignal": "WEB_DEVELOPMENT_BASELINE_READY",
        "nativePassClaimAllowed": false
      },
      {
        "order": 4,
        "stage": "TARGET_PLATFORM_SOURCE_BIND",
        "carryForwardRequired": [
          "core-loop",
          "gameplay-state-model",
          "progression-model",
          "input-intent",
          "ui-flow",
          "save-meaning",
          "content-structure",
          "balance-intent",
          "verified-learning-context"
        ],
        "silentScopeDropForbidden": true,
        "restartFromBlankWhenValidContinuationExists": false
      },
      {
        "order": 5,
        "stage": "TARGET_PLATFORM_IMPLEMENTATION",
        "selectedPlatformOwnsSecondImplementation": true,
        "owner": "VIBE2_VIBE3",
        "platformAdaptationAllowed": true,
        "webBasePreservedAsReference": true
      },
      {
        "order": 6,
        "stage": "TARGET_PLATFORM_VERIFICATION",
        "required": [
          "TARGET_PLATFORM_RUNTIME",
          "TARGET_PLATFORM_INDEPENDENT_QA",
          "TARGET_PLATFORM_REGRESSION",
          "EXACT_REVISION_BINDING"
        ],
        "webEvidenceCannotSubstitute": true
      },
      {
        "order": 7,
        "stage": "RELEASE_PROMOTION",
        "requiresOwnPlatformEvidencePass": true,
        "automaticPublicRepublish": false
      },
      {
        "order": 8,
        "stage": "ROBLOX_POST_RELEASE_FOCUSED_DEVELOPMENT",
        "appliesWhen": "SELECTED_PLATFORM=ROBLOX_AND_RELEASE_PROMOTION=PASS",
        "protectedRunnerSlots": 1,
        "activeTaskMaxPerProject": 1,
        "continuousRefill": true,
        "scheduler": "vibe2-24h-runner",
        "worker": "vibe2-continuous-core",
        "feeder": "tools/vibe2-post-release-focus.mjs",
        "queue": ".vibe2/queue.json",
        "sourceRoot": "roblox-games/<gameId>",
        "priorities": [
          "gameplay-completeness",
          "content-depth",
          "roblox-native-ux",
          "mobile-readability",
          "performance",
          "maintainability",
          "verified-learning-reuse"
        ],
        "loop": [
          "LOAD_RELEASED_SOURCE_AND_VERIFIED_LEARNING",
          "IDENTIFY_ONE_CONCRETE_COMPLETENESS_OR_QUALITY_GAP",
          "IMPLEMENT_WITHIN_CURRENT_GAME_IDENTITY",
          "INCREMENTAL_QA",
          "PERFORMANCE_SANITY",
          "FAN_IN_REGRESSION",
          "PROMOTE_VERIFIED_SOURCE_CHANGE_OR_REQUEUE",
          "CREATE_NEXT_FOCUS_CYCLE"
        ]
      },
      {
        "order": 9,
        "stage": "LEARNING_PERSISTENCE",
        "continuous24h": true,
        "catalogWrapStopsLearning": false,
        "persistTo": [
          ".vibe2/experience.json",
          "vibe2-learning-runtime:company-learning/training-samples",
          "vibe2-learning-runtime:company-learning/vibe3-memory-index.json",
          "vibe2-learning-runtime:company-learning/vibe3-recombination-memory.json",
          "vibe2-learning-runtime:company-learning/vibe3-task-playbooks.json"
        ],
        "waitingForVerifiedSamplesIsFailure": false,
        "localModelTrainingInitiatedByThisWorkOrder": false
      }
    ],
    "stopConditions": [
      "OWNER_HOLD",
      "OWNER_KILL",
      "POLICY_CONTRACT_FAILURE",
      "NO_VERIFIABLE_SAFE_CONTINUATION"
    ],
    "forbidden": [
      "NEW_SHADOW_PIPELINE",
      "NEW_PLATFORM_SPECIFIC_TRAINER",
      "NEW_PLATFORM_SPECIFIC_DISTILLATION_CRON",
      "WEB_PASS_AS_NATIVE_PASS",
      "SILENT_APPROVED_SCOPE_DROP",
      "NON_VIBE_GAMEPLAY_SOURCE_WRITE",
      "STOP_24H_LEARNING_AFTER_CATALOG_WRAP"
    ],
    "successSignals": [
      "WEB_BASE_IMPLEMENTED_AND_VALIDATED",
      "WEB_PLATFORM_HANDOFF_BOUND",
      "TARGET_PLATFORM_SOURCE_CONTINUES_APPROVED_SYSTEMS",
      "TARGET_PLATFORM_RUNTIME_QA_REGRESSION_PASS",
      "ROBLOX_RELEASE_GETS_ONE_PROTECTED_FOCUS_SLOT",
      "POST_RELEASE_FOCUS_REFILLS_CONTINUOUSLY",
      "VERIFIED_LEARNING_PERSISTS_CONTINUOUSLY"
    ]
  }
}
