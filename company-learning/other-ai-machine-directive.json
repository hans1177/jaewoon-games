  "learning": {
    "continuous24h": true,
    "googlePlayRotationContinuous": true,
    "catalogWrapMustNotStopStudy": true,
    "canonicalDistillationContinuous": true,
    "waitingForVerifiedSamplesMeansCollectionStateNotFailure": true,
    "maximizeVerifiedLearningUse": true,
    "sameGameVerifiedKnowledgeHighestPriority": true,
    "crossGameTransformativeRecombinationAllowed": true,
    "rawCopyForbidden": true,
    "newExpressionRequired": true,
    "retrievalSources": [
      ".vibe2/experience.json",
      ".vibe2/game-study-knowledge.json",
      "company-learning/vibe3-memory-index.json",
      "company-learning/vibe3-recombination-memory.json",
