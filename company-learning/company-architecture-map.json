      "policyCreationForbidden": true
    }
  },
  "authorityOrder": [
    "OWNER_DIRECTIVE",
    "company-learning/platform-release-roadmap.json",
    "company-learning/company-architecture-map.json",
    "company-learning/company-log-map.json",
    "VERIFIED_RUNTIME_EVIDENCE",
    "RUNTIME_STATE"
