  "forbidden": [
    "WORK_WITHOUT_SHARED_CONTEXT",
    "RUNTIME_STATE_CREATES_POLICY",
    "AI_ROLE_EXPANDS_OWN_AUTHORITY",
    "CODEX_WRITES_GAME_SOURCE",
