      "VIBE2_VIBE3_GAME_IMPLEMENTATION",
      "WEB_RUNTIME_VALIDATION",
      "STRICT_REVIEW",
      "PROMOTION_REVALIDATION"
    ],
    "selectedPlatform": [
      "SOURCE_BIND",
      "BUILD_OR_PACKAGE",
      "TARGET_RUNTIME",
      "INDEPENDENT_QA",
      "REGRESSION",
      "RELEASE_PROMOTION"
    ],
    "sustainedDevelopment": [
      "VIBE_PLANNER",
      "VIBE_SOURCE_WORKER",
