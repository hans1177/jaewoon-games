          "PROJECT_SPECIFIC_HYBRID"
        ]
      },
      "selectionRule": "DO_NOT_ASSIGN_ONE_FIXED_TEMPLATE_PER_GENRE; VIBE_CHOOSES_OR_HYBRIDIZES_INFORMATION_HIERARCHY_NAVIGATION_LAYOUT_AND_INTERACTION_FROM_ACTUAL_GAME_RULES_GENRE_SESSION_FLOW_AND_EXISTING_UI_RESPONSIBILITY",
      "mobileFirst": {
        "touchTargetMinimumPx": 44,
        "safeAreaRequired": true,
        "narrowScreenNoClipping": true,
        "scrollReachabilityRequired": true,
        "thumbReachabilityRequired": true
      },
      "preservation": {
        "reuseExistingUiSystemAndResponsibleFiles": true,
        "inventMissingGameplaySystemOnlyToFillMenuForbidden": true,
        "gameplayEconomySaveQuestAndProgressionMeaningUnchanged": true,
        "sameGameStyleLockRequired": true
      },
      "version": 3,
      "unityWebIsUnityBuildTargetNotIndependentPlatform": true,
      "implementationSeparation": {
        "version": 1,
        "sharedExperienceLayer": {
          "reusableAcrossPlatforms": true,
          "includes": [
            "GAME_STYLE_LOCK",
            "INFORMATION_HIERARCHY_INTENT",
            "MENU_PATTERN_FAMILY",
            "ICON_AND_TEXTURE_SOURCE_IDENTITY",
            "UI_MOTION_LANGUAGE",
            "PLAYER_FLOW_SEMANTICS"
          ],
          "runtimeCodeSharingNotImplied": true
        },
        "ROBLOX": {
          "runtimeImplementation": "ROBLOX_NATIVE_EXISTING_UI_SYSTEM",
          "directUnityRuntimeCodeReuseForbidden": true,
          "sharedSourceAssetReuseRequiresExplicitCompatibility": true
        },
        "UNITY_APP_AND_WEBGL": {
          "runtimeImplementation": "SAME_CANONICAL_UNITY_PROJECT_AND_UI_SOURCE",
          "canonicalSourceRoot": "unity-games/<gameId>/",
          "unityAppAndWebglUiSourceSharedByDefault": true,
          "separateHtmlCssJsGameplayUiForbidden": true,
          "webglCompatibilityAdaptationAllowedInsideCanonicalUnityProject": true,
          "gameplayUiSemanticForkForbidden": true,
          "requiredUnityWebPlannerProfile": "UNITY_WEBGL_SAME_CANONICAL_UNITY_PROJECT_AND_UI_SOURCE"
        },
        "GENERIC_WEB_OR_LEGACY_VALIDATION": {
          "runtimeImplementation": "EXISTING_WEB_UI_SYSTEM_ONLY",
          "mayRemainForExistingWebProjects": true,
          "cannotSubstituteForUnityWebglGameplayUi": true
        },
        "FORTNITE_UEFN": {
          "runtimeImplementation": "PAUSED_OWNER_HOLD_NO_BUILD_UP",
          "directUnityOrRobloxRuntimeCodeReuseForbidden": true,
          "resumeRuntimeImplementation": "UEFN_NATIVE_UI_SYSTEM",
          "ownerExplicitResumeRequired": true
        }
      },
      "pausedPlatforms": [
        "FORTNITE_UEFN"
      ],
      "pausedPlatformStatus": {
        "FORTNITE_UEFN": "개발보류"
      },
      "plannerActiveBindingProfileRequired": true,
      "unityWebMustNotUseGenericWebBindingProfile": true
    },
    "pausedPlatforms": [
      "FORTNITE_UEFN"
    ],
    "pausedPlatformRule": "FORTNITE_UEFN_OWNER_HOLD_NO_AUTONOMOUS_BUILD_UP_UNTIL_EXPLICIT_RESUME"
  }
