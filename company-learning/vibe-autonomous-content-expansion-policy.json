          "PROJECT_SPECIFIC_HYBRID"
        ],
        "SHOP_UI": [
          "CATALOG_COMPARE",
          "MERCHANT_CONTEXT",
          "UPGRADE_FIRST",
          "PROJECT_SPECIFIC_HYBRID"
        ],
        "CRAFT_UI": [
          "RECIPE_TREE",
          "STATION_CONTEXT",
