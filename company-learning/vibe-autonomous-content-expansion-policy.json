{
  "version": 13,
  "kind": "VIBE_AUTONOMOUS_CONTENT_EXPANSION_BUILD_UP_CONTRACT",
  "status": "ACTIVE",
  "authority": "OWNER_DIRECTIVE_2026-09-27",
  "sourceOfTruth": "company-learning/vibe-autonomous-content-expansion-policy.json",
  "objective": "Make every eligible Vibe BUILD_UP iteration improve the existing game toward a more complete coherent product while autonomously expanding content depth, variety, world logic, progression, story, rules, and presentation without creating a new workflow or approval stage.",
  "scope": {
    "lifecycle": "EXISTING_BUILD_UP_ONLY",
    "newWorkflowForbidden": true,
    "newStageForbidden": true,
    "newApprovalGateForbidden": true,
    "separateIdeaProposalStageForbidden": true,
    "platforms": [
      "WEB",
      "ROBLOX",
      "UNITY"
    ],
    "platformRule": "SAME_AUTONOMOUS_EXPANSION_CONTRACT_PLATFORM_NATIVE_IMPLEMENTATION_FOR_ACTIVE_PLATFORMS_ONLY",
    "pausedPlatforms": [
      "FORTNITE_UEFN"
    ],
    "pausedPlatformStatus": {
      "FORTNITE_UEFN": "개발보류"
    }
  },
  "autonomy": {
    "decisionOwner": "VIBE",
    "assistantManualIdeaDependencyForbidden": true,
    "ownerPromptPerExpansionForbidden": true,
    "chooseHighestValueCoherentGapFromCurrentGame": true,
    "inputs": [
      "APPROVED_GAME_DESIGN_AND_IDENTITY",
      "CURRENT_GAME_SOURCE",
      "CURRENT_IMPLEMENTED_CONTENT",
      "VERIFIED_BUILD_UP_HISTORY",
      "VALID_QUALITY_AND_RUNTIME_EVIDENCE",
      "CURRENT_PROGRESSION_AND_WORLD_FLOW"
    ],
    "selectionRule": "Prefer the highest-value missing, shallow, repetitive, disconnected, or underdeveloped area that can be improved without breaking the approved game identity or existing progression logic."
  },
  "completenessEvolution": {
    "target": "CONTINUOUSLY_MORE_COMPLETE_GAME",
    "eachIterationMustCheckExistingContentToo": true,
    "quantityOnlyExpansionForbidden": true,
    "cosmeticRenameOnlyVariationForbidden": true,
    "statOnlyCloneVariationForbidden": true,
    "disconnectedContentDumpForbidden": true,
    "preserveCoherence": true,
    "preserveCausality": true,
    "preserveProgressionFlow": true,
    "preserveWorldLogic": true,
    "preserveEstablishedIdentity": true,
    "improveWeakExistingContentWhenHigherValueThanAddingNewContent": true,
    "expectedDirection": [
      "MORE_COMPLETE",
      "MORE_CONNECTED",
      "MORE_DISTINCT",
      "MORE_PLAYABLE",
      "MORE_READABLE",
      "MORE_MEANINGFUL",
      "MORE_COHERENT"
    ]
  },
  "expansionDomains": [
    "WORLD_BACKGROUND_AND_ENVIRONMENT",
