{
  "version": 5,
  "kind": "vibe2-external-ai-distillation-policy",
  "authority": "MACHINE_EXECUTION_CONTRACT",
  "purpose": "Owner permits external AI to directly edit all visual design categories in isolated code candidate branches. Raw external knowledge still cannot self-promote or be accepted as verified QA, main, gameplay, save, security, or release authority.",
  "ingestion": {
    "rawExternalAiOutputDirectDevelopment": false,
    "rawExternalAiOutputPersistentRetrieval": false,
    "rawOutputPersistence": "HASH_ONLY",
    "candidateSourceKind": "external-ai",
    "requiredMetadata": [
      "provider",
      "model",
      "rawOutputSha256"
    ],
    "distilledPatternMaxChars": 240,
    "independentVerificationRequired": true,
    "minimumTraceableVerificationEvidenceItems": 2,
    "allowedVerificationMethods": [
      "runtime",
      "independent-qa",
      "source-backed-review",
      "multi-source-consistency"
    ]
  },
  "promotion": {
    "outputKind": "vibe2-external-ai-distilled-knowledge",
    "advisoryOnly": true,
    "reusableOnlyAfterIndependentVerification": true,
    "ranksAfterInternalVerifiedKnowledge": true,
    "directDevelopmentUse": false,
    "directSourceWrite": false,
    "directProductionPass": false,
    "directReleaseEvidence": false,
    "directMasteryCredit": false,
    "directCanonicalTrainingSample": false,
    "laterMasteryOrTrainingRequiresVerifiedProjectOutcome": true,
    "authorityExpanded": false,
    "lifecycleStates": [
      "CANDIDATE",
      "VERIFIED",
      "PREFERRED",
      "DEMOTED",
      "RETIRED"
    ],
    "freshProjectOutcomeAttributionRequired": true,
    "infrastructureFailureMayPenalizeKnowledge": false,
    "retiredKnowledgeRetrievalForbidden": true,
    "designOnlyCandidateWriteException": "Owner-design full visual code edits ONLY on exact source anchors in allowlisted responsible files; no main/direct release; independent QA and Studio proofs mandatory."
  },
  "retrieval": {
    "distilledKnowledgePath": ".vibe2/external-ai-distilled-knowledge.json",
    "distiller": "tools/vibe2-external-ai-distillation.mjs",
    "collector": "tools/vibe2-multisource-learning-collector.mjs",
    "rawExternalAiAvailableToPlanner": false,
    "rawGameplayValuesAvailableToPlanner": false,
    "externalAiAdvisoryLast": true,
    "continuousRunnerInjectionRequired": true,
    "exactInjectedKnowledgeIdTraceRequired": true,
    "rankAfterInternalVerifiedKnowledge": true
  },
  "gateWeakening": false,
  "closedLoop": {
    "centralContract": "company-learning/platform-release-roadmap.json#learningClosedLoopContract",
    "productionConfidenceSeparateFromMasteryXp": true,
    "directProductionConfidenceCredit": false,
    "verifiedProjectOutcomeRequiredForProductionConfidence": true,
    "singleSuccessDoesNotProveGeneralization": true,
    "holdoutEvidenceRequiredForStrongGeneralization": true,
    "authorityExpanded": false
  },
  "directVisualDesign": {
    "enabled": true,
    "authority": "OWNER_DIRECTIVE_2026-11-18_FULL_VISUAL_DESIGN_EDIT",
    "provider": "NVIDIA",
    "model": "nvidia/nemotron-3.5-super-vl-120b-a12b",
    "freeTrialOnly": true,
    "requiresNoPaidBilling": true,
    "missingKeyAction": "SKIP_WITH_EVIDENCE_NO_LOCAL_OR_PAID_FALLBACK",
    "gameIds": [
      "mare-essentia"
    ],
    "responsibility": "ALL_ROBLOX_VISUAL_DESIGN_CATEGORIES_FULL_CODE_EDIT_ON_ISOLATED_CANDIDATE",
    "existingStudioWorkflow": ".github/workflows/devloop-studio.yml",
    "executor": "tools/company-nemotron-design-review.mjs",
    "input": "VERIFIED_OFFICIAL_STUDIO_MCP_JPEG_OR_PNG",
    "allowedSourceFiles": [
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/Pose.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/PortScene.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/FieldScene.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/VoyageScene.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/CommonVFX.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/CommonMotion.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/FieldMotion.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/CardArt.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/CardGallery.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/WonderScenes.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/Flags.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/PortBuildings.luau",
      "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/Sfx.luau",
      "roblox-games/mare-essentia/src/StarterPlayer/Game.client.luau",
      "roblox-games/mare-essentia/src/StarterPlayer/TownMood.client.luau",
      "roblox-games/mare-essentia/src/StarterPlayer/VisualLadder.client.luau"
    ],
    "changesMustUseExactCurrentSourceAnchors": true,
    "modelMayProposeValuesOnly": false,
    "modelCannotSelectPathsOrCommands": false,
    "directCandidateSourceEditAllowed": true,
    "isolatedCandidateBranchRequired": true,
    "directMainWriteForbidden": true,
    "independentQaRequiredBeforePromotion": true,
    "freshStudioBeforeAfterEvidenceRequiredBeforeCompletion": true,
    "nativeSecurityAndReleaseGatesMandatory": true,
    "protected": [
      "combat",
      "economy",
      "save",
      "remote",
      "server",
      "progression",
      "security",
      "release-workflow"
    ],
    "untrustedModelTextNeverExecuted": false,
    "sensitiveContentOrCredentialsMayNotBeUploaded": true,
    "rawModelOutputPersistence": "HASH_ONLY; ONLY_EXACT_ACCEPTED_VISUAL_CANDIDATE_DIFF_IN_GIT",
    "output": "SANITIZED_STRUCTURED_VISUAL_REVIEW_AND_BOUNDED_CANDIDATE_DIFF",
    "learningAndProductionTrustUnchanged": true,
    "editingMode": "EXACT_SOURCE_VISUAL_CODE_REPLACEMENT",
    "allVisualCategoriesAllowed": true,
    "visualCategories": [
      "npc-face",
      "npc-hair",
      "npc-clothing",
      "npc-body-proportions",
      "npc-motion",
      "animation",
      "material",
      "texture",
      "lighting",
      "environment",
      "architecture",
      "ship-appearance",
      "vfx",
      "particles",
      "ui",
      "hud",
      "typography",
      "camera",
      "composition",
      "colors",
      "portraits",
      "card-art",
      "accessibility",
      "sound-presentation"
    ],
    "modelMayProposeSourceCode": true,
    "modelMayProposePathsWithinWhitelist": true,
    "modelCannotExecuteCommands": true,
    "maximumCandidateFilesPerRun": 4,
    "maximumSourceEditsPerRun": 10,
    "maximumReplacementBytes": 1800,
    "exactOldSourceMustMatchOnce": true,
    "visualOnlyChangeMustBeProvableFromDiff": true,
    "disallowGameplayAndSecurityCodeTokens": true,
    "existingAssetsAndCommercialUseLicenseRequired": true,
    "designIdeaGenerationAllowed": true,
    "independentQaBeforeCandidatePR": true,
    "independentStudioBeforeAfterQaBeforeAcceptance": true,
    "autoMergeOrReleaseWithoutOwnerDefinedGate": false,
    "modelGeneratedSourceCannotExecuteUntilBoundedCandidateQa": true,
    "modelCannotMutateCanonicalCentralPolicy": true,
    "studioEvidenceSelection": {
      "officialCaptureScenario": "roblox-games/mare-essentia/tools/devloop/studio-scripts/mare-qa-click.json",
      "expectedCoverageFrames": 83,
      "architectureAndStreetsFrames": 12,
      "residentFaceAndOutfitFrames": 9,
      "maxImagesPerFreeCall": 8,
      "rotationPhases": 5,
      "sourcesMustBeExactStudioCaptureAndCodeRevision": true,
      "preserveOriginalQASteps": true,
      "noImageGenerationOrSyntheticPass": true
    },
    "townLayoutEdit": {
      "enabled": true,
      "scope": "EXISTING_NAMED_FACILITY_POSITION_IN_PORTSCENE_ONLY",
      "sourceFile": "roblox-games/mare-essentia/src/ReplicatedStorage/Shared/PortScene.luau",
      "maximumHorizontalShiftStuds": 5,
      "verticalShiftStuds": 0,
      "sameStreetSideRequired": true,
      "minimumPlazaDistanceFromCenterlineStuds": 32,
      "sizeFloorsEconomyRoutesAndSaveUnchanged": true,
      "exactSourceAnchorAndIndependentStudioBeforeAfterQaRequired": true,
      "cannotCreateDestroyOrMoveGameplayFacilityIdentity": true
    }
  }
}
