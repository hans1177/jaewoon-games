    "slotRefillSingleVariantOnly": true,
    "slotRefillWorkerDirectControlWrite": false,
    "slotRefillSourceLocksHeldUntilFanIn": true,
    "postReleaseFocusedRunnerSlots": 1,
    "postReleaseFocusedRefill": true,
    "legacySlotRefillBranchCompatibility": true
  },
  "adaptiveBackpressure": {
    "enabled": true,
    "mode": "persistent-next-run-cap-plus-immediate-current-batch-protection",
    "stateFile": ".vibe2/parallelism-control.json",
    "steps": [
      20,
      16,
      12,
      8,
      4
    ],
