    "shards": [
      "roblox",
      "unity",
      "web",
      "verification",
      "support"
    ],
    "workStealing": true,
    "dynamicBackpressure": true,
    "speculativeParallelism": {
      "enabled": true,
      "variants": 3,
      "highRiskOptInOnly": false,
      "unityBuildCandidatesExcluded": true,
      "criticalHighRiskAutomatic": true
