    "maxModelCallsPerWorker": 1,
    "dispatchNextWhenCapacityOpens": true,
    "refillMode": "per-worker-repository-dispatch-with-fan-in-fallback",
    "refillRef": "vibe2-unreal-core",
    "refillRequiresEligibleWork": true,
    "refillPlannerOnDispatch": false,
    "ownerDirectivePreemptsAutonomy": true,
    "maxConcurrentGameTasks": 20,
    "unityReleaseFocusSlots": 1,
    "longWorkProtectedSlots": 1,
    "priorityOrder": [
      "owner-directive",
      "release-confirmed",
      "development-confirmed",
      "reviewing",
      "other"
    ],
    "sameTierEngineOrder": [
      "existing-roblox",
      "existing-unity",
      "existing-web",
      "new-unity",
      "other-engine"
