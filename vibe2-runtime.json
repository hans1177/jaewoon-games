    "strongPressureDownAfterRuns": 1,
    "mediumPressureDownAfterRuns": 2,
    "healthySaturatedUpAfterRuns": 2,
    "lowWorkloadChangesPersistentCap": false,
    "lowWorkloadBuildsRecoveryStreak": false,
    "immediateDynamicCapMayAlsoDownshiftPersistentCap": false,
    "duplicateRunMayChangePersistentCap": false,
    "missingStateFallbackMax": 20,
    "corruptStateFallbackMax": 20
