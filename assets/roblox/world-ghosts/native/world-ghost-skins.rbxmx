 {id="banshee",name="밴시",region="EUROPE",form="SHROUD",face="WEEPING",outfit="DRESS",features={"VEIL","LONG_HAIR","COMB"},role="창가 객실",index=69,provenance="FOLKLORE_INSPIRED_ORIGINAL_DESIGN",productionVerified=false},
 {id="dullahan",name="듀라한",region="EUROPE",form="HEADLESS",face="SKULL",outfit="COAT",features={"CARRIED_HEAD","CAPE","CHAINS"},role="마차 로비",index=70,provenance="FOLKLORE_INSPIRED_ORIGINAL_DESIGN",productionVerified=false},
