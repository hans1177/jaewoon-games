 {id="churel",name="추렐",region="SOUTH_ASIA",form="LONG_ARM",face="HALF_MASK",outfit="DRESS",features={"REVERSED_FEET","LONG_HAIR","BEADS"},role="발자국 복도",index=63,provenance="FOLKLORE_INSPIRED_ORIGINAL_DESIGN",productionVerified=false},
 {id="brahmadaitya",name="브라흐다이티야",region="SOUTH_ASIA",form="TALL",face="HOLLOW",outfit="ROBE",features={"TOPKNOT","SCROLL","WOOD_CROWN"},role="오래된 서재",index=64,provenance="FOLKLORE_INSPIRED_ORIGINAL_DESIGN",productionVerified=false},
 {id="ghoul",name="굴",region="MIDDLE_EAST",form="HUNCHED",face="FANGED",outfit="RAGS",features={"LONG_CLAWS","SKULL_CROWN","ONE_TAIL"},role="모래 지하실",index=65,provenance="FOLKLORE_INSPIRED_ORIGINAL_DESIGN",productionVerified=false},
 {id="ifrit",name="이프리트",region="MIDDLE_EAST",form="GIANT",face="SPLIT",outfit="ARMOR",features={"FLAME_CROWN","TWO_HORNS","SMOKE"},role="화로 홀",index=66,provenance="FOLKLORE_INSPIRED_ORIGINAL_DESIGN",productionVerified=false},
