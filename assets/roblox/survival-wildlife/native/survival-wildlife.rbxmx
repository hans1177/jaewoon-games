Catalog.Common = COMMON

function Catalog.getSpecies(name)
	return Catalog.Species[string.upper(tostring(name or ""))]
end

function Catalog.getSkin(speciesName, skinName)
	local species = Catalog.getSpecies(speciesName)
	if not species then
		return nil
	end
	local key = string.upper(tostring(skinName or ""))
	if key ~= "" and species.skins[key] then
		return species.skins[key], key
	end
	local firstKey, firstSkin = next(species.skins)
	return firstSkin, firstKey
end

return table.freeze(Catalog)
]]></string>
