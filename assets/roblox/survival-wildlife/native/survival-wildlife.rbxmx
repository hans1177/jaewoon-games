-- 원칙: 2D 스프라이트/빌보드 금지. 종별 실루엣과 관절 구조를 실제 3D 파츠로 만든다.

local Catalog = {}

local function c(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function v(x, y, z)
	return Vector3.new(x, y, z)
end

local function skin(body, chest, dark, light)
	return table.freeze({
		body = body,
		chest = chest,
		dark = dark,
		light = light,
	})
end

