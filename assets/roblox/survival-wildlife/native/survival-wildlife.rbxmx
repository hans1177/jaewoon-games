    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">WildlifeFactory</string>
        <string name="Source"><![CDATA[-- 파일명: assets/roblox/survival-wildlife/WildlifeFactory.luau
-- 역할: WildlifeCatalog을 실제 3D 저폴리 관절 모델로 생성한다.
-- 금지: BillboardGui/ImageLabel/SurfaceGui 기반 동물, 한 덩어리 root 이동만으로 걷는 동물.

local CollectionService = game:GetService("CollectionService")
local Catalog = require(script.Parent.WildlifeCatalog)

local Factory = {}

local function smoothPart(name, size, color, shape)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = true
	if shape == "BALL" then
		part.Shape = Enum.PartType.Ball
	elseif shape == "CYLINDER" then
		part.Shape = Enum.PartType.Cylinder
	end
	return part
end

local function wedgePart(name, size, color)
	local part = Instance.new("WedgePart")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = true
	return part
end

local function motor(parentPart, childPart, name, localCFrame)
	childPart.CFrame = parentPart.CFrame * localCFrame
	local joint = Instance.new("Motor6D")
	joint.Name = name
	joint.Part0 = parentPart
	joint.Part1 = childPart
	joint.C0 = localCFrame
	joint.C1 = CFrame.identity
	joint.Parent = parentPart
	return joint
end

local function weld(parentPart, childPart, localCFrame)
	childPart.CFrame = parentPart.CFrame * localCFrame
	local joint = Instance.new("WeldConstraint")
	joint.Part0 = parentPart
	joint.Part1 = childPart
	joint.Parent = childPart
	return joint
end

local function addEye(model, head, side, skin, headSize)
	local eye = smoothPart(side < 0 and "EyeL" or "EyeR", Vector3.new(0.17, 0.17, 0.17), Color3.fromRGB(18, 17, 15), "BALL")
	eye.Parent = model
	local x = side * headSize.X * 0.33
	local y = headSize.Y * 0.13
	local z = -headSize.Z * 0.43
	weld(head, eye, CFrame.new(x, y, z))
	return eye
end

local function addNose(model, muzzle, skin, muzzleSize)
	local nose = smoothPart("Nose", Vector3.new(muzzleSize.X * 0.48, muzzleSize.Y * 0.34, muzzleSize.Z * 0.30), skin.dark, "BALL")
	nose.Parent = model
	weld(muzzle, nose, CFrame.new(0, 0, -muzzleSize.Z * 0.48))
	return nose
end

local function addEar(model, head, name, side, kind, skin, headSize)
	if kind == "NONE" then
		return nil
	end
	local width = headSize.X * 0.23
	local height = headSize.Y * 0.38
	if kind == "LONG" or kind == "POINT_LONG" then
		height = headSize.Y * 0.62
	elseif kind == "RABBIT" then
		width = headSize.X * 0.24
		height = headSize.Y * 1.35
	elseif kind == "ROUND" or kind == "ROUND_SMALL" then
		height = headSize.Y * 0.28
	end
	local ear
	if kind == "ROUND" or kind == "ROUND_SMALL" then
		ear = smoothPart(name, Vector3.new(width, height, width * 0.55), skin.body, "BALL")
	else
		ear = wedgePart(name, Vector3.new(width, height, width * 0.45), skin.body)
	end
	ear.Parent = model
	local x = side * headSize.X * 0.31
	local y = headSize.Y * 0.47
	local z = -headSize.Z * 0.04
	local tilt = math.rad(side * 12)
	motor(head, ear, name .. "Joint", CFrame.new(x, y, z) * CFrame.Angles(0, 0, tilt))
	return ear
end

local function addLeg(model, parentPart, prefix, x, z, cfg, skin)
	local upper = smoothPart(prefix .. "Upper", cfg.legUpper, skin.body, "BALL")
	upper.Parent = model
	local upperJoint = motor(parentPart, upper, prefix .. "Hip", CFrame.new(x, -parentPart.Size.Y * 0.36, z))

	local lower = smoothPart(prefix .. "Lower", cfg.legLower, skin.dark, "BALL")
	lower.Parent = model
	local lowerJoint = motor(upper, lower, prefix .. "Knee", CFrame.new(0, -cfg.legUpper.Y * 0.70, 0.02))

	local foot = smoothPart(prefix .. "Foot", cfg.foot, skin.dark, "BALL")
	foot.Parent = model
	local footJoint = motor(lower, foot, prefix .. "Ankle", CFrame.new(0, -cfg.legLower.Y * 0.70, -cfg.foot.Z * 0.18))

	return {
		upper = upper,
		lower = lower,
		foot = foot,
		hip = upperJoint,
		knee = lowerJoint,
		ankle = footJoint,
	}
end

local function addTail(model, body, cfg, skin)
	local kind = cfg.tail
	if not kind or kind == "NONE" then
		return
	end
	local baseSize = Vector3.new(0.44, 0.44, 1.2)
	local tipSize = Vector3.new(0.35, 0.35, 1.0)
	if kind == "FOX" or kind == "SQUIRREL" then
		baseSize = Vector3.new(0.72, 0.72, 1.55)
		tipSize = Vector3.new(0.62, 0.62, 1.35)
	elseif kind == "PUFF" then
		baseSize = Vector3.new(0.72, 0.72, 0.72)
		tipSize = Vector3.new(0.01, 0.01, 0.01)
	elseif kind == "BEAVER" then
		baseSize = Vector3.new(0.70, 0.30, 1.45)
		tipSize = Vector3.new(0.82, 0.28, 1.15)
	elseif kind == "SHORT" then
		baseSize = Vector3.new(0.45, 0.45, 0.62)
		tipSize = Vector3.new(0.30, 0.30, 0.45)
	elseif kind == "BIRD_FAN" then
		baseSize = Vector3.new(1.45, 0.28, 1.15)
		tipSize = Vector3.new(1.82, 0.20, 0.90)
	elseif kind == "BIRD" then
		baseSize = Vector3.new(0.72, 0.22, 0.88)
		tipSize = Vector3.new(0.78, 0.18, 0.68)
	end

	local base = smoothPart("TailBase", baseSize, skin.body, kind == "BEAVER" and nil or "BALL")
	base.Parent = model
	motor(body, base, "TailBaseJoint", CFrame.new(0, body.Size.Y * 0.05, body.Size.Z * 0.52) * CFrame.Angles(math.rad(-12), 0, 0))

	if tipSize.X > 0.05 then
		local tip = smoothPart("TailTip", tipSize, kind == "FOX" and skin.light or skin.body, kind == "BEAVER" and nil or "BALL")
		tip.Parent = model
		motor(base, tip, "TailTipJoint", CFrame.new(0, 0, baseSize.Z * 0.68))
	end
end

local function addTusks(model, muzzle, cfg, skin)
	if not cfg.tusks then
		return
	end
	for _, side in ipairs({ -1, 1 }) do
		local tusk = smoothPart(side < 0 and "TuskL" or "TuskR", Vector3.new(0.16, 0.52, 0.16), Color3.fromRGB(226, 214, 181), "CYLINDER")
		tusk.Parent = model
		weld(muzzle, tusk, CFrame.new(side * muzzle.Size.X * 0.43, -muzzle.Size.Y * 0.18, -muzzle.Size.Z * 0.34) * CFrame.Angles(0, 0, math.rad(70)))
	end
end

local function addHornPair(model, head, kind, skin)
	if not kind then
		return
	end
	local length = kind == "BISON" and 0.82 or 0.92
	local sweep = kind == "BISON" and 34 or 18
	for _, side in ipairs({ -1, 1 }) do
		local horn = smoothPart(side < 0 and "HornL" or "HornR", Vector3.new(0.18, length, 0.18), Color3.fromRGB(184, 172, 143), "CYLINDER")
		horn.Parent = model
		weld(head, horn, CFrame.new(side * head.Size.X * 0.34, head.Size.Y * 0.45, -head.Size.Z * 0.02) * CFrame.Angles(0, 0, math.rad(90 + side * sweep)))
	end
end

local function antlerBranch(model, head, side, palm)
	local color = Color3.fromRGB(104, 82, 58)
	local base = smoothPart(side < 0 and "AntlerL" or "AntlerR", Vector3.new(0.16, palm and 1.25 or 1.55, 0.16), color, "CYLINDER")
	base.Parent = model
	weld(head, base, CFrame.new(side * head.Size.X * 0.31, head.Size.Y * 0.50, 0) * CFrame.Angles(0, 0, math.rad(90 + side * 18)))
	for i = 1, palm and 3 or 4 do
		local tine = smoothPart((side < 0 and "AntlerL" or "AntlerR") .. "Tine" .. i, Vector3.new(0.12, 0.62 + i * 0.09, 0.12), color, "CYLINDER")
		tine.Parent = model
		local along = -0.36 + i * 0.25
		weld(base, tine, CFrame.new(0, along, 0) * CFrame.Angles(0, 0, math.rad(side * (palm and 38 or 28))))
	end
	if palm then
		local plate = wedgePart((side < 0 and "AntlerL" or "AntlerR") .. "Palm", Vector3.new(0.46, 0.82, 0.16), color)
		plate.Parent = model
		weld(base, plate, CFrame.new(0, 0.32, 0))
	end
end

local function addAntlers(model, head, kind)
	if not kind then
		return
	end
	if kind == "PALMATE" then
		antlerBranch(model, head, -1, true)
		antlerBranch(model, head, 1, true)
	else
		antlerBranch(model, head, -1, false)
		antlerBranch(model, head, 1, false)
	end
end

local function addFaceMarkings(model, head, cfg, skin)
	if cfg.faceMask then
		for _, side in ipairs({ -1, 1 }) do
			local mask = smoothPart(side < 0 and "MaskL" or "MaskR", Vector3.new(head.Size.X * 0.34, head.Size.Y * 0.20, 0.08), skin.dark, "BALL")
			mask.Parent = model
			weld(head, mask, CFrame.new(side * head.Size.X * 0.20, head.Size.Y * 0.06, -head.Size.Z * 0.49))
		end
	elseif cfg.faceStripe then
		for _, side in ipairs({ -1, 1 }) do
			local stripe = smoothPart(side < 0 and "StripeL" or "StripeR", Vector3.new(head.Size.X * 0.20, head.Size.Y * 0.72, 0.08), skin.light, nil)
			stripe.Parent = model
			weld(head, stripe, CFrame.new(side * head.Size.X * 0.20, head.Size.Y * 0.03, -head.Size.Z * 0.50) * CFrame.Angles(0, 0, math.rad(side * 10)))
		end
	end
end

local function addWing(model, body, side, skin)
	local wing = wedgePart(side < 0 and "WingL" or "WingR", Vector3.new(body.Size.X * 0.72, body.Size.Y * 0.24, body.Size.Z * 0.75), skin.dark)
	wing.Parent = model
	motor(body, wing, side < 0 and "WingLJoint" or "WingRJoint", CFrame.new(side * body.Size.X * 0.48, 0.05, 0) * CFrame.Angles(0, math.rad(side * 5), math.rad(side * 8)))
end

local function addHump(model, chest, skin)
	local hump = smoothPart("ShoulderHump", Vector3.new(chest.Size.X * 0.88, chest.Size.Y * 0.52, chest.Size.Z * 0.72), skin.dark, "BALL")
	hump.Parent = model
	weld(chest, hump, CFrame.new(0, chest.Size.Y * 0.38, chest.Size.Z * 0.04))
end

local function addBearCharacterDetails(model, body, chest, head, muzzle, skin)
	local belly = smoothPart("Belly", Vector3.new(body.Size.X * 0.82, body.Size.Y * 0.70, body.Size.Z * 0.64), skin.chest, "BALL")
	belly.Parent = model
	motor(body, belly, "BellyJoint", CFrame.new(0, -body.Size.Y * 0.18, body.Size.Z * 0.12))

	local rump = smoothPart("Rump", Vector3.new(body.Size.X * 0.84, body.Size.Y * 0.76, body.Size.Z * 0.56), skin.body, "BALL")
	rump.Parent = model
	motor(body, rump, "RumpJoint", CFrame.new(0, 0, body.Size.Z * 0.34))

	local ruff = smoothPart("ChestRuff", Vector3.new(chest.Size.X * 0.78, chest.Size.Y * 0.46, chest.Size.Z * 0.42), skin.light, "BALL")
	ruff.Parent = model
	motor(chest, ruff, "ChestRuffJoint", CFrame.new(0, -chest.Size.Y * 0.18, -chest.Size.Z * 0.34))

	for _, side in ipairs({ -1, 1 }) do
		local suffix = side < 0 and "L" or "R"
		local eyeWhite = smoothPart("EyeWhite" .. suffix, Vector3.new(0.30, 0.25, 0.12), Color3.fromRGB(214, 196, 166), "BALL")
		eyeWhite.Parent = model
		weld(head, eyeWhite, CFrame.new(side * head.Size.X * 0.32, head.Size.Y * 0.15, -head.Size.Z * 0.44))

		local cheek = smoothPart("Cheek" .. suffix, Vector3.new(head.Size.X * 0.34, head.Size.Y * 0.30, head.Size.Z * 0.26), skin.chest, "BALL")
		cheek.Parent = model
		motor(head, cheek, "Cheek" .. suffix .. "Joint", CFrame.new(side * head.Size.X * 0.30, -head.Size.Y * 0.10, -head.Size.Z * 0.35))

		local brow = smoothPart("Brow" .. suffix, Vector3.new(head.Size.X * 0.24, head.Size.Y * 0.08, head.Size.Z * 0.10), skin.dark, "BALL")
		brow.Parent = model
		motor(head, brow, "Brow" .. suffix .. "Joint", CFrame.new(side * head.Size.X * 0.30, head.Size.Y * 0.34, -head.Size.Z * 0.43) * CFrame.Angles(0, 0, math.rad(side * 8)))
	end

	local muzzleTop = smoothPart("MuzzleTop", Vector3.new(muzzle.Size.X * 0.88, muzzle.Size.Y * 0.62, muzzle.Size.Z * 0.72), skin.light, "BALL")
	muzzleTop.Parent = model
	weld(muzzle, muzzleTop, CFrame.new(0, muzzle.Size.Y * 0.08, -muzzle.Size.Z * 0.06))
end

function Factory.create(speciesName, skinName)
	local key = string.upper(tostring(speciesName or "BEAR"))
	local cfg = Catalog.getSpecies(key) or Catalog.getSpecies("BEAR")
	local skinData, resolvedSkin = Catalog.getSkin(key, skinName)
	if not skinData then
		key = "BEAR"
		cfg = Catalog.getSpecies(key)
		skinData, resolvedSkin = Catalog.getSkin(key, skinName)
	end

	local model = Instance.new("Model")
	model.Name = key
	model:SetAttribute("WildlifeSpecies", key)
	model:SetAttribute("WildlifeSkin", resolvedSkin)
	model:SetAttribute("WildlifeGait", cfg.gait)
	model:SetAttribute("WildlifeRigVersion", 2)
	model:SetAttribute("AnimationQuality", "SMOOTH_3D_ARTICULATED")
	model:SetAttribute("TwoDimensionalPresentationForbidden", true)
	model:SetAttribute("RootOnlyLocomotionForbidden", true)
	model:SetAttribute("RuntimeVerified", false)
	model:SetAttribute("WildlifeMotionState", "LOCOMOTION")
	model:SetAttribute("WildlifeDesiredSpeed", nil)
	model:SetAttribute("WildlifeAnimatorRuntime", "ROBLOX_NATIVE")
	model:SetAttribute("WildlifeAnimationSource", "MOTOR6D_ARTICULATED_CHARACTER_ANIMATION")

	local animationController = Instance.new("AnimationController")
	animationController.Name = "AnimationController"
	animationController.Parent = model
	local robloxAnimator = Instance.new("Animator")
	robloxAnimator.Name = "Animator"
	robloxAnimator.Parent = animationController

	local rootHeight = cfg.legUpper.Y * 0.78 + cfg.legLower.Y * 0.78 + cfg.foot.Y * 0.65 + cfg.body.Y * 0.54
	local root = smoothPart("Root", Vector3.new(cfg.body.X * 0.62, math.max(0.8, cfg.body.Y * 0.62), cfg.body.Z * 0.58), skinData.body)
	root.Transparency = 1
	root.CanCollide = true
	root.CanTouch = true
	root.CanQuery = true
	root.Massless = false
	root.CFrame = CFrame.new(0, rootHeight, 0)
	root.Parent = model
	model.PrimaryPart = root

	local body = smoothPart("Body", cfg.body, skinData.body, "BALL")
	body.Parent = model
	motor(root, body, "BodyJoint", CFrame.new(0, 0, 0))

	local chest = smoothPart("Chest", cfg.chest, skinData.chest, "BALL")
	chest.Parent = model
	motor(body, chest, "ChestJoint", CFrame.new(0, cfg.body.Y * 0.06, -cfg.body.Z * 0.30))

	local neckSize = Vector3.new(cfg.head.X * 0.68, math.max(0.45, cfg.neckLength), cfg.head.Z * 0.62)
	local neck = smoothPart("Neck", neckSize, skinData.chest, "BALL")
	neck.Parent = model
	motor(chest, neck, "NeckJoint", CFrame.new(0, chest.Size.Y * 0.16, -chest.Size.Z * 0.48 - cfg.neckLength * 0.22) * CFrame.Angles(math.rad(-16), 0, 0))

	local head = smoothPart("Head", cfg.head, skinData.body, "BALL")
	head.Parent = model
	motor(neck, head, "HeadJoint", CFrame.new(0, cfg.neckLength * 0.55, -neck.Size.Z * 0.54))

	local muzzle = smoothPart("Muzzle", cfg.muzzle, skinData.light, "BALL")
	muzzle.Parent = model
	motor(head, muzzle, "MuzzleJoint", CFrame.new(0, -cfg.head.Y * 0.12, -cfg.head.Z * 0.55))

	local jaw = smoothPart("Jaw", Vector3.new(cfg.muzzle.X * 0.86, cfg.muzzle.Y * 0.36, cfg.muzzle.Z * 0.82), skinData.dark, "BALL")
	jaw.Parent = model
	motor(muzzle, jaw, "JawJoint", CFrame.new(0, -cfg.muzzle.Y * 0.35, -cfg.muzzle.Z * 0.04))

	addEye(model, head, -1, skinData, cfg.head)
	addEye(model, head, 1, skinData, cfg.head)
	addNose(model, muzzle, skinData, cfg.muzzle)
	if key == "BEAR" then
		addBearCharacterDetails(model, body, chest, head, muzzle, skinData)
	end
	addEar(model, head, "EarL", -1, cfg.ear, skinData, cfg.head)
	addEar(model, head, "EarR", 1, cfg.ear, skinData, cfg.head)
	addTail(model, body, cfg, skinData)
	addTusks(model, muzzle, cfg, skinData)
	addHornPair(model, head, cfg.horns, skinData)
	addAntlers(model, head, cfg.antlers)
	addFaceMarkings(model, head, cfg, skinData)
	if cfg.hump then
		addHump(model, chest, skinData)
	end
	if cfg.wing then
		addWing(model, body, -1, skinData)
		addWing(model, body, 1, skinData)
	end

	local frontZ = -cfg.body.Z * 0.30
	local backZ = cfg.body.Z * 0.30
	local x = cfg.body.X * 0.34
	addLeg(model, chest, "FL", -x, -cfg.chest.Z * 0.08, cfg, skinData)
	addLeg(model, chest, "FR", x, -cfg.chest.Z * 0.08, cfg, skinData)
	addLeg(model, body, "BL", -x, backZ, cfg, skinData)
	addLeg(model, body, "BR", x, backZ, cfg, skinData)

	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant:SetAttribute("Wildlife3DPart", true)
		end
	end

	model:ScaleTo(cfg.scale)
	CollectionService:AddTag(model, "VibeSurvivalWildlife")
	return model
end

function Factory.applySkin(model, skinName)
	if not model then
		return false
	end
	local species = tostring(model:GetAttribute("WildlifeSpecies") or model.Name)
	local cfg = Catalog.getSpecies(species)
	local skinData, resolvedSkin = Catalog.getSkin(species, skinName)
	if not cfg or not skinData then
		return false
	end
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			local name = part.Name
			if name == "Chest" or name == "Neck" then
				part.Color = skinData.chest
			elseif name:find("Lower") or name:find("Foot") or name:find("Mask") or name:find("Jaw") or name:find("ShoulderHump") then
				part.Color = skinData.dark
			elseif name:find("Stripe") or name == "Muzzle" or name == "TailTip" then
				part.Color = skinData.light
			elseif name ~= "Root" and not name:find("Eye") and not name:find("Nose") and not name:find("Horn") and not name:find("Antler") and not name:find("Tusk") then
				part.Color = skinData.body
			end
		end
	end
	model:SetAttribute("WildlifeSkin", resolvedSkin)
	return true
end

return table.freeze(Factory)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">WildlifeAnimator</string>
        <string name="Source"><![CDATA[-- 파일명: assets/roblox/survival-wildlife/WildlifeAnimator.luau
-- 역할: 3D 야생동물을 캐릭터 애니메이션 원칙(키포즈/발접지/오버랩/스프링 블렌드)으로 구동한다.
-- 원칙: Root 이동은 게임플레이가 소유한다. 이 모듈은 관절·체중·접지·후행동작을 담당한다.

local RunService = game:GetService("RunService")
local Catalog = require(script.Parent.WildlifeCatalog)

local Animator = {}

local function clamp01(v)
	return math.clamp(v, 0, 1)
end

local function smooth01(v)
	v = clamp01(v)
	return v * v * (3 - 2 * v)
end

local function smoother(v)
	v = clamp01(v)
	return v * v * v * (v * (v * 6 - 15) + 10)
end

local function springNumber(value, target, velocity, frequency, dt)
	local omega = 2 * math.pi * math.max(0.01, frequency)
	local x = value - target
	local exp = math.exp(-omega * math.max(0, dt))
	local nextValue = target + (x + (velocity + omega * x) * dt) * exp
	local nextVelocity = (velocity - omega * (velocity + omega * x) * dt) * exp
	return nextValue, nextVelocity
end

local function expAlpha(speed, dt)
	return 1 - math.exp(-math.max(0.01, speed) * math.max(0, dt))
end

local function pose(x, y, z, rx, ry, rz)
	return CFrame.new(x or 0, y or 0, z or 0)
		* CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
end

local function pitch(deg)
	return CFrame.Angles(math.rad(deg), 0, 0)
end

local function yaw(deg)
	return CFrame.Angles(0, math.rad(deg), 0)
end

local function roll(deg)
	return CFrame.Angles(0, 0, math.rad(deg))
end

local function pulse(t, a, b, c, d)
	if t <= a or t >= d then
		return 0
	end
	if t < b then
		return smooth01((t - a) / math.max(0.001, b - a))
	end
	if t < c then
		return 1
	end
	return 1 - smooth01((t - c) / math.max(0.001, d - c))
end

local function getJoints(model)
	local joints = {}
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("Motor6D") then
			joints[item.Name] = item
		end
	end
	return joints
end

local function zeroTargets(joints)
	local result = {}
	for name in pairs(joints) do
		result[name] = CFrame.identity
	end
	return result
end

local function set(targets, name, cf)
	if targets[name] then
		targets[name] = cf
	end
end

local function add(targets, name, cf)
	if targets[name] then
		targets[name] = targets[name] * cf
	end
end

local function phase01(radians)
	local p = radians / (math.pi * 2)
	return p - math.floor(p)
end

-- stance를 swing보다 길게 유지해서 발이 바닥 위에서 미끄러지는 인상을 줄인다.
local function stanceSample(radians)
	local p = phase01(radians)
	if p < 0.58 then
		local u = smoother(p / 0.58)
		return {
			x = 0.34 + (-0.34 - 0.34) * u,
			y = 0,
			stance = 1,
			swing = 0,
		}
	end
	local u = smoother((p - 0.58) / 0.42)
	return {
		x = -0.34 + (0.34 + 0.34) * u,
		y = math.sin(math.pi * u),
		stance = 0,
		swing = 1,
	}
end

local function gaitTuning(gait)
	if gait == "HEAVY" then
		return 0.72, 19, 24, 0.68
	elseif gait == "LOW_HEAVY" or gait == "SMALL_MAMMAL_HEAVY" then
		return 0.84, 22, 27, 0.80
	elseif gait == "HOOFED_HEAVY" then
		return 0.92, 27, 31, 0.94
	elseif gait == "HOOFED_LIGHT" or gait == "HOOFED_CLIMBER" then
		return 1.04, 31, 36, 1.05
	elseif gait == "CANINE" then
		return 1.08, 30, 34, 1.06
	elseif gait == "CANINE_LIGHT" or gait == "SMALL_MAMMAL_FAST" then
		return 1.18, 34, 39, 1.16
	elseif gait == "HOPPER" then
		return 1.14, 37, 43, 1.20
	elseif gait == "GROUND_BIRD" or gait == "BIRD" then
		return 1.12, 29, 32, 1.14
	end
	return 1, 26, 31, 1
end

local function applyLeg(targets, prefix, phase, amplitude, lift, turnLean, side)
	local sample = stanceSample(phase)
	local swing = sample.x * amplitude
	local knee = (0.16 + sample.y * 0.72) * amplitude
	local ankle = -swing * 0.30 + knee * 0.24
	local yLift = sample.y * lift

	set(targets, prefix .. "Hip", pose(0, yLift * 0.11, 0, swing, 0, side * turnLean * 5.2))
	set(targets, prefix .. "Knee", pitch(-knee))
	set(targets, prefix .. "Ankle", pose(0, yLift * 0.13, -sample.stance * 0.025, ankle, 0, 0))

	return sample
end

local function addBreathing(controller, targets, moving)
	local breath = 0.5 + 0.5 * math.sin(controller.time * 1.52)
	local chestLift = breath * (moving and 0.010 or 0.026)
	add(targets, "ChestJoint", pose(0, chestLift, 0, breath * (moving and 0.28 or 0.90), 0, 0))
	add(targets, "BodyJoint", pose(0, breath * (moving and 0.004 or 0.012), 0, -breath * 0.32, 0, 0))
	add(targets, "BellyJoint", pose(0, -breath * 0.015, breath * 0.012, -breath * 0.32, 0, 0))
	add(targets, "ChestRuffJoint", pose(0, breath * 0.012, -breath * 0.009, breath * 0.38, 0, 0))
	add(targets, "RumpJoint", pose(0, breath * 0.006, 0, -breath * 0.14, 0, 0))
	if not moving then
		add(targets, "HeadJoint", pitch(math.sin(controller.time * 0.63) * 0.9))
	end
end

local function locomotionTargets(controller, targets, dt, requestedSpeed)
	local cfg = controller.cfg
	local speedFactor, strideDeg, kneeDeg, cadenceFactor = gaitTuning(cfg.gait)

	controller.speed, controller.speedVelocity = springNumber(
		controller.speed,
		requestedSpeed,
		controller.speedVelocity,
		1.55,
		dt
	)

	local normalized = math.clamp(controller.speed / math.max(1, controller.nominalRunSpeed), 0, 1.35)
	local runTarget = smooth01((normalized - 0.35) / 0.55)
	controller.locomotionBlend, controller.locomotionBlendVelocity = springNumber(
		controller.locomotionBlend,
		runTarget,
		controller.locomotionBlendVelocity,
		1.20,
		dt
	)

	local moving = normalized > 0.025
	local cadence = (2.65 + normalized * 4.35) * cfg.stride * cadenceFactor
	if moving then
		controller.phase += dt * cadence
	else
		controller.phase += dt * 0.28
	end

	local amplitude = math.clamp(normalized * 1.15, 0.22, 1)
	local stride = strideDeg * speedFactor * amplitude * (1 + controller.locomotionBlend * 0.12)
	local lift = cfg.footLift * amplitude * (1 + controller.locomotionBlend * 0.30)
	local kneeScale = kneeDeg / math.max(1, strideDeg)

	local fl = applyLeg(targets, "FL", controller.phase, stride, lift, controller.turnLean, -1)
	local br = applyLeg(targets, "BR", controller.phase + 0.04, stride, lift, controller.turnLean, 1)
	local fr = applyLeg(targets, "FR", controller.phase + math.pi, stride, lift, controller.turnLean, 1)
	local bl = applyLeg(targets, "BL", controller.phase + math.pi + 0.04, stride, lift, controller.turnLean, -1)
	controller.footPlant = {
		FL = fl.stance,
		FR = fr.stance,
		BL = bl.stance,
		BR = br.stance,
	}

	local doublePhase = controller.phase * 2
	local suspension = math.sin(doublePhase)
	local compression = math.max(0, math.cos(doublePhase))
	local lateral = math.sin(controller.phase)

	local bob = moving and math.abs(suspension) * cfg.bodyBob * amplitude * (1 + controller.locomotionBlend * 0.35) or 0
	local pelvisRoll = moving and -lateral * 2.1 * amplitude or 0
	local shoulderRoll = -pelvisRoll * 0.92
	local pelvisPitch = moving and suspension * (1.2 + controller.locomotionBlend * 1.8) * amplitude or 0
	local chestPitch = -pelvisPitch * 0.82

	add(targets, "BodyJoint", pose(0, bob, 0, pelvisPitch, 0, pelvisRoll + controller.turnLean * 5.5))
	add(targets, "ChestJoint", pose(0, -bob * 0.14, 0, chestPitch - controller.spineLag * 3.5, 0, shoulderRoll - controller.turnLean * 3.2))
	add(targets, "BellyJoint", pose(0, -compression * 0.020 * amplitude, suspension * 0.015 * amplitude, -pelvisPitch * 0.22, 0, -pelvisRoll * 0.18))
	add(targets, "RumpJoint", pose(0, compression * 0.013 * amplitude, 0, pelvisPitch * 0.16, 0, pelvisRoll * 0.22))
	add(targets, "ChestRuffJoint", pose(0, math.abs(suspension) * 0.011 * amplitude, -compression * 0.009 * amplitude, chestPitch * 0.18, 0, shoulderRoll * 0.12))

	-- 큰 동물도 몸통이 판자처럼 움직이지 않도록 척추와 머리가 한 박자 늦게 따라온다.
	local headCounter = moving and (-suspension * 3.0 - lateral * 0.9) * amplitude or math.sin(controller.time * 0.74) * 1.1
	add(targets, "NeckJoint", pitch(headCounter * 0.52 - controller.spineLag * 2.3))
	add(targets, "HeadJoint", pose(0, 0, 0, headCounter - controller.headLag * 4.2, 0, -shoulderRoll * 0.42))

	local tailSway = math.sin(controller.time * (moving and 3.2 or 1.35) + 0.4) * (moving and 8.5 or 4.5)
	add(targets, "TailBaseJoint", yaw(tailSway - controller.turnLean * 7))
	add(targets, "TailTipJoint", yaw(-tailSway * 0.58 - controller.headLag * 4))

	local ear = math.sin(controller.time * 2.15 + controller.earPhase)
	add(targets, "EarLJoint", roll(ear * 2.1 - controller.turnLean * 2))
	add(targets, "EarRJoint", roll(-ear * 1.8 - controller.turnLean * 2))

	if cfg.gait == "HOPPER" and moving then
		local hop = math.max(0, math.sin(controller.phase))
		add(targets, "BodyJoint", pose(0, hop * cfg.bodyBob * 0.82, 0, -hop * 5, 0, 0))
	end
	if cfg.gait == "GROUND_BIRD" and moving then
		add(targets, "NeckJoint", pitch(math.sin(doublePhase) * 5.5))
		add(targets, "HeadJoint", pitch(-math.sin(doublePhase) * 7.5))
	end

	controller.compression = compression * amplitude
	controller.kneeScale = kneeScale
	addBreathing(controller, targets, moving)
end

local function alertTargets(controller, targets)
	local t = smooth01(math.min(1, controller.stateTime / 0.30))
	add(targets, "ChestJoint", pose(0, 0.03 * t, -0.03 * t, -5 * t, 0, 0))
	add(targets, "NeckJoint", pitch(-11 * t))
	add(targets, "HeadJoint", pose(0, 0, 0, -9 * t, math.sin(controller.time * 0.8) * 3 * t, 0))
	add(targets, "EarLJoint", roll(-7 * t))
	add(targets, "EarRJoint", roll(7 * t))
	add(targets, "BrowLJoint", roll(-10 * t))
	add(targets, "BrowRJoint", roll(10 * t))
	add(targets, "CheekLJoint", pose(0, 0.008 * t, -0.006 * t, 0, 0, -2 * t))
	add(targets, "CheekRJoint", pose(0, 0.008 * t, -0.006 * t, 0, 0, 2 * t))
	add(targets, "TailBaseJoint", pitch(7 * t))
end

local function grazeTargets(controller, targets)
	local t = smooth01(math.min(1, controller.stateTime / 0.42))
	add(targets, "NeckJoint", pitch(48 * t))
	add(targets, "HeadJoint", pitch(32 * t))
	add(targets, "ChestJoint", pitch(4 * t))
	local chew = math.max(0, math.sin(controller.time * 5.0)) * 5
	add(targets, "JawJoint", pitch(chew))
end

local function attackTargets(controller, targets)
	local duration = controller.attackDuration
	local t = math.clamp(controller.stateTime / duration, 0, 1)
	local anticipate = pulse(t, 0.02, 0.10, 0.18, 0.30)
	local contact = pulse(t, 0.22, 0.32, 0.39, 0.52)
	local follow = pulse(t, 0.38, 0.50, 0.64, 0.78)
	local settle = pulse(t, 0.70, 0.78, 0.90, 0.99)

	local gait = controller.cfg.gait
	if gait == "HEAVY" then
		add(targets, "BodyJoint", pose(0, 0, -0.04 * contact, 7 * anticipate - 10 * contact, -6 * anticipate + 10 * contact, -5 * anticipate + 8 * follow))
		add(targets, "ChestJoint", pose(0, 0, -0.08 * contact, 12 * anticipate - 20 * contact + 7 * follow, -10 * anticipate + 14 * contact, -7 * anticipate + 10 * follow))
		add(targets, "NeckJoint", pitch(14 * anticipate - 25 * contact + 8 * follow))
		add(targets, "HeadJoint", pitch(10 * anticipate - 22 * contact + 7 * follow))
		add(targets, "FLHip", pitch(-44 * contact + 12 * follow))
		add(targets, "FLKnee", pitch(18 * contact))
		add(targets, "BrowLJoint", pose(0, 0, 0, 0, 0, 14 * contact))
		add(targets, "BrowRJoint", pose(0, 0, 0, 0, 0, -14 * contact))
		add(targets, "CheekLJoint", pose(0, -0.010 * contact, -0.012 * contact, 0, 0, -3 * follow))
		add(targets, "CheekRJoint", pose(0, -0.010 * contact, -0.012 * contact, 0, 0, 3 * follow))
		add(targets, "BellyJoint", pose(0, -0.028 * anticipate + 0.018 * contact, 0.025 * follow, 4 * anticipate - 5 * contact, 0, 0))
		add(targets, "ChestRuffJoint", pose(0, 0.020 * contact, -0.018 * contact, -4 * contact, 0, 0))
	elseif gait == "LOW_HEAVY" then
		add(targets, "BodyJoint", pitch(9 * anticipate - 15 * contact))
		add(targets, "ChestJoint", pose(0, 0, -0.12 * contact, 13 * anticipate - 22 * contact, 0, 0))
		add(targets, "NeckJoint", pitch(17 * anticipate - 29 * contact))
		add(targets, "HeadJoint", pitch(12 * anticipate - 24 * contact))
	elseif gait == "CANINE" or gait == "CANINE_LIGHT" then
		add(targets, "BodyJoint", pose(0, 0, -0.05 * contact, 6 * anticipate - 14 * contact, 0, 0))
		add(targets, "NeckJoint", pitch(18 * anticipate - 34 * contact))
		add(targets, "HeadJoint", pitch(14 * anticipate - 28 * contact))
		add(targets, "JawJoint", pitch(31 * contact))
	else
		add(targets, "ChestJoint", pitch(10 * anticipate - 17 * contact + 5 * follow))
		add(targets, "NeckJoint", pitch(18 * anticipate - 25 * contact))
		add(targets, "HeadJoint", pitch(12 * anticipate - 22 * contact))
	end

	if settle > 0 then
		add(targets, "TailBaseJoint", yaw(math.sin(t * 18) * 5 * settle))
	end
end

local function hitTargets(controller, targets)
	local t = math.clamp(controller.stateTime / 0.58, 0, 1)
	local impact = pulse(t, 0.00, 0.06, 0.14, 0.55)
	local side = controller.hitSide
	add(targets, "BodyJoint", pose(0, 0, 0.05 * impact, 6 * impact, side * 8 * impact, side * 8 * impact))
	add(targets, "ChestJoint", pose(0, 0, 0.04 * impact, -13 * impact, -side * 12 * impact, -side * 10 * impact))
	add(targets, "NeckJoint", pose(0, 0, 0, 9 * impact, side * 6 * impact, 0))
	add(targets, "HeadJoint", pose(0, 0, 0, 12 * impact, side * 9 * impact, side * 5 * impact))
end

local function deathTargets(controller, targets)
	local t = smoother(math.clamp(controller.stateTime / 1.30, 0, 1))
	local side = controller.deathSide
	add(targets, "BodyJoint", pose(0, -0.40 * t, 0, 19 * t, 0, side * 70 * t))
	add(targets, "ChestJoint", pose(0, -0.18 * t, 0, 14 * t, 0, side * 26 * t))
	add(targets, "NeckJoint", pitch(22 * t))
	add(targets, "HeadJoint", pitch(20 * t))
	add(targets, "FLHip", pitch(-28 * t))
	add(targets, "FRHip", pitch(19 * t))
	add(targets, "BLHip", pitch(25 * t))
	add(targets, "BRHip", pitch(-20 * t))
	add(targets, "TailBaseJoint", roll(side * 24 * t))
end

local function updateLag(controller, dt)
	local root = controller.model.PrimaryPart
	local currentLook = root and root.CFrame.LookVector or Vector3.zAxis
	local lastLook = controller.lastLook
	local cross = lastLook:Cross(currentLook).Y
	local turnTarget = math.clamp(cross * 18, -1, 1)
	controller.turnLean, controller.turnLeanVelocity = springNumber(controller.turnLean, turnTarget, controller.turnLeanVelocity, 1.8, dt)
	controller.spineLag, controller.spineLagVelocity = springNumber(controller.spineLag, controller.turnLean, controller.spineLagVelocity, 1.05, dt)
	controller.headLag, controller.headLagVelocity = springNumber(controller.headLag, controller.spineLag, controller.headLagVelocity, 0.78, dt)
	controller.lastLook = lastLook:Lerp(currentLook, expAlpha(7, dt))
end

local function step(controller, dt)
	if not controller.model.Parent then
		controller:Destroy()
		return
	end

	controller.time += dt
	controller.stateTime += dt
	updateLag(controller, dt)

	local root = controller.model.PrimaryPart
	local velocity = root and root.AssemblyLinearVelocity or Vector3.zero
	local measuredSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local requestedSpeed = controller.manualSpeed ~= nil and controller.manualSpeed or measuredSpeed

	local targets = zeroTargets(controller.joints)
	locomotionTargets(controller, targets, dt, requestedSpeed)

	local state = controller.state
	if state == "ALERT" then
		alertTargets(controller, targets)
	elseif state == "GRAZE" or state == "FORAGE" then
		grazeTargets(controller, targets)
	elseif state == "ATTACK" then
		attackTargets(controller, targets)
		if controller.stateTime >= controller.attackDuration then
			controller:SetState("LOCOMOTION")
		end
	elseif state == "HIT" then
		hitTargets(controller, targets)
		if controller.stateTime >= 0.58 then
			controller:SetState("LOCOMOTION")
		end
	elseif state == "DEATH" then
		deathTargets(controller, targets)
	end

	local response = state == "ATTACK" and 19 or state == "HIT" and 24 or state == "DEATH" and 9 or 15
	local alpha = expAlpha(response, dt)
	for name, joint in pairs(controller.joints) do
		local target = targets[name] or CFrame.identity
		joint.Transform = joint.Transform:Lerp(target, alpha)
	end

	controller.model:SetAttribute("WildlifeSpeedBlend", controller.speed)
	controller.model:SetAttribute("WildlifeRunBlend", controller.locomotionBlend)
	controller.model:SetAttribute("WildlifeTurnLean", controller.turnLean)
	controller.model:SetAttribute("WildlifeFootPlantFL", controller.footPlant.FL or 0)
	controller.model:SetAttribute("WildlifeFootPlantFR", controller.footPlant.FR or 0)
	controller.model:SetAttribute("WildlifeFootPlantBL", controller.footPlant.BL or 0)
	controller.model:SetAttribute("WildlifeFootPlantBR", controller.footPlant.BR or 0)
end

local Controller = {}
Controller.__index = Controller

function Controller:SetState(state, options)
	local nextState = string.upper(tostring(state or "LOCOMOTION"))
	if nextState == self.state and nextState ~= "ATTACK" and nextState ~= "HIT" then
		return
	end
	self.state = nextState
	self.stateTime = 0
	options = options or {}
	if nextState == "ATTACK" then
		self.attackDuration = math.max(0.58, tonumber(options.duration) or 0.92)
	elseif nextState == "HIT" then
		self.hitSide = math.clamp(tonumber(options.side) or 1, -1, 1)
	elseif nextState == "DEATH" then
		self.deathSide = (tonumber(options.side) or -1) >= 0 and 1 or -1
	end
	self.model:SetAttribute("WildlifeMotionState", nextState)
end

function Controller:SetSpeed(speed)
	self.manualSpeed = speed == nil and nil or math.max(0, tonumber(speed) or 0)
end

function Controller:Destroy()
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
end

function Animator.bind(model, options)
	assert(model and model:IsA("Model"), "WildlifeAnimator.bind requires Model")
	assert(model.PrimaryPart, "Wildlife model requires PrimaryPart")
	options = options or {}

	local species = string.upper(tostring(model:GetAttribute("WildlifeSpecies") or model.Name))
	local cfg = Catalog.getSpecies(species) or Catalog.getSpecies("BEAR")
	local initialLook = model.PrimaryPart.CFrame.LookVector
	local controller = setmetatable({
		model = model,
		cfg = cfg,
		joints = getJoints(model),
		time = 0,
		phase = tonumber(options.phase) or 0,
		earPhase = tonumber(options.earPhase) or (species:byte(1) or 1) * 0.17,
		state = "LOCOMOTION",
		stateTime = 0,
		attackDuration = 0.92,
		hitSide = 1,
		deathSide = -1,
		manualSpeed = options.speed,
		nominalRunSpeed = tonumber(options.nominalRunSpeed) or 15,
		speed = tonumber(options.speed) or 0,
		speedVelocity = 0,
		locomotionBlend = 0,
		locomotionBlendVelocity = 0,
		turnLean = 0,
		turnLeanVelocity = 0,
		spineLag = 0,
		spineLagVelocity = 0,
		headLag = 0,
		headLagVelocity = 0,
		lastLook = initialLook,
		footPlant = { FL = 1, FR = 0, BL = 0, BR = 1 },
		connection = nil,
	}, Controller)

	model:SetAttribute("WildlifeMotionDriver", "CHARACTER_ANIMATION_SPRING_GAIT_V3")
	model:SetAttribute("WildlifeMotionDimensionality", "FULL_3D")
	model:SetAttribute("WildlifeFootPlant", true)
	model:SetAttribute("WildlifeSecondaryMotion", true)
	model:SetAttribute("WildlifeAnimationPrinciples", "KEY_POSE_ANTICIPATION_OVERLAP_FOLLOW_THROUGH_SETTLE")

	local signal = RunService:IsClient() and RunService.RenderStepped or RunService.Heartbeat
	controller.connection = signal:Connect(function(dt)
		step(controller, math.min(dt, 1 / 20))
	end)

	return controller
end

return table.freeze(Animator)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">SurvivalWildlife</string>
        <string name="Source"><![CDATA[-- 파일명: assets/roblox/survival-wildlife/SurvivalWildlife.luau
-- 역할: 게임 코드에서 바로 호출하는 Roblox 네이티브 야생동물 패키지 API
-- 서버는 생성/상태/이동 명령을 소유하고 클라이언트는 관절 애니메이션을 재생한다.

local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Factory = require(script.Parent.WildlifeFactory)
local Catalog = require(script.Parent.WildlifeCatalog)

local Wildlife = {}

Wildlife.Tag = "VibeSurvivalWildlife"
Wildlife.Version = 3

local function assertServer()
	assert(RunService:IsServer(), "SurvivalWildlife spawn/state API must be called on the server")
end

function Wildlife.GetSpecies()
	local names = {}
	for name in pairs(Catalog.Species) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function Wildlife.Spawn(species, skin, cframe, parent)
	assertServer()
	local model = Factory.create(species, skin)
	model.Parent = parent or workspace
	model:PivotTo(cframe or CFrame.new())
	model:SetAttribute("WildlifeMotionState", "LOCOMOTION")
	model:SetAttribute("WildlifeDesiredSpeed", nil)
	model:SetAttribute("WildlifePackageVersion", Wildlife.Version)
	if not CollectionService:HasTag(model, Wildlife.Tag) then
		CollectionService:AddTag(model, Wildlife.Tag)
	end
	return model
end

function Wildlife.SetMotionState(model, state, options)
	assertServer()
	assert(model and model:IsA("Model"), "model required")
	local nextState = string.upper(tostring(state or "LOCOMOTION"))
	model:SetAttribute("WildlifeMotionState", nextState)
	if options then
		if options.hitSide ~= nil then
			model:SetAttribute("WildlifeHitSide", math.clamp(tonumber(options.hitSide) or 0, -1, 1))
		end
		if options.deathSide ~= nil then
			model:SetAttribute("WildlifeDeathSide", (tonumber(options.deathSide) or -1) >= 0 and 1 or -1)
		end
		if options.attackDuration ~= nil then
			model:SetAttribute("WildlifeAttackDuration", math.max(0.58, tonumber(options.attackDuration) or 0.92))
		end
	end
end

function Wildlife.SetDesiredSpeed(model, studsPerSecond)
	assertServer()
	assert(model and model:IsA("Model"), "model required")
	if studsPerSecond == nil then
		model:SetAttribute("WildlifeDesiredSpeed", nil)
	else
		model:SetAttribute("WildlifeDesiredSpeed", math.max(0, tonumber(studsPerSecond) or 0))
	end
end

function Wildlife.ApplySkin(model, skin)
	assertServer()
	return Factory.applySkin(model, skin)
end

function Wildlife.Destroy(model)
	assertServer()
	if model then
		CollectionService:RemoveTag(model, Wildlife.Tag)
		model:Destroy()
	end
end

return table.freeze(Wildlife)
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>
