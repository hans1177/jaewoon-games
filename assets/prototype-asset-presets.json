{
  "version": 1,
  "purpose": "재운컴퍼니/바이브2 게임 초안 제작용 무료 에셋 프리셋. 캐릭터·적·보스는 검증된 실제 애니메이션 리소스만 허용한다.",
  "rules": {
    "prototypeOnly": true,
    "actorRequiresVerifiedAnimation": true,
    "actorRequiredStates": ["idle", "move", "attack", "hit", "death"],
    "locomotionRequired": true,
    "staticActorBlocked": true,
    "geometricActorBlocked": true,
    "blockedLicenses": ["NC", "unknown", "unclear-redistribution"],
    "preferredLicenses": ["CC0", "MIT", "commercial-no-attribution", "CC-BY"],
    "downloadPolicy": "on-demand-cache-after-first-use",
    "replaceableWithoutGameplayRewrite": true,
    "releaseRequiresSeparateAssetReview": true
  },
  "presets": [
    {
      "id": "set-a-fantasy-rpg",
      "name": "판타지 RPG 기본형",
      "default": true,
