    {
      "id": "set-c-dungeon-tower",
      "name": "탑/던전형",
      "keywords": ["탑", "던전", "층", "보스", "로그라이크", "웨이브", "지하"],
      "actorAssets": [
        "oga-animated-monsters",
        "github-pixel-snapped-pirate-skeleton",
        "oga-unity-slime-12"
