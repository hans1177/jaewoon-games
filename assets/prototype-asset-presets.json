{
  "version": 3,
  "purpose": "재운컴퍼니/바이브2 모바일 게임 제작용 무료 재사용 프리셋. Web은 모바일에서 가능한 최대 품질을 목표로 하고, 무거운 3D 본개발은 Unity Android를 우선한다.",
  "rules": {
    "mobileFirst": true,
    "supportedTargets": ["mobile-web", "unity-android"],
    "webHighQualityAllowed": true,
    "unityAndroidPreferredForHeavy3D": true,
    "prototypeOnly": false,
    "actorRequiresVerifiedAnimation": true,
    "actorRequiredStates": ["idle", "move", "attack", "hit", "death"],
    "locomotionRequired": true,
    "staticActorBlocked": true,
    "geometricActorBlocked": true,
    "blockedLicenses": ["NC", "unknown", "unclear-redistribution"],
    "preferredLicenses": ["CC0", "MIT", "commercial-no-attribution", "CC-BY"],
    "downloadPolicy": "on-demand-cache-after-first-use",
    "replaceableWithoutGameplayRewrite": true,
    "releaseRequiresSeparateAssetReview": true,
    "publicUseRequiresLicenseLedger": true,
    "externalToolAutoInstall": false,
    "externalToolApprovalRequired": true
  },
  "reusableToolCandidates": [
    {"id":"unity-input-system","name":"Unity Input System","scope":"common","licenseReview":"package-policy","autoInstall":false},
    {"id":"unity-cinemachine","name":"Unity Cinemachine","scope":"3d-camera","licenseReview":"package-policy","autoInstall":false},
    {"id":"unity-probuilder","name":"Unity ProBuilder","scope":"level-blockout","licenseReview":"package-policy","autoInstall":false},
    {"id":"dotween","name":"DOTween","scope":"tween-ui-vfx","licenseReview":"external-ledger-required","autoInstall":false},
    {"id":"runtime-debug-console","name":"In-game Debug Console candidate","scope":"debug","licenseReview":"external-ledger-required","autoInstall":false}
  ],
