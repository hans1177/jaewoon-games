      ],
      "effectAssets": ["oga-basic-pixel-spells"],
      "supportingSourcePriority": ["Kenney", "Poly Haven", "ambientCG"],
      "notes": "주인공+슬라임+언데드/마녀 계열 전투 초안에 우선 사용"
    },
    {
      "id": "set-b-survival-field",
      "name": "생존/필드 전투형",
