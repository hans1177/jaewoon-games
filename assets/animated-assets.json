      "sourceUrl": "https://github.com/chongdashu/ai-pixel-snapped-game-sprites",
      "license": "MIT",
      "characters": ["pirate", "skeleton"],
      "animations": ["idle", "walk", "attack", "hurt", "jump", "death"],
      "normalizedStates": ["idle", "move", "attack", "hit", "death"],
      "evidence": ["preview.gif", "manifest.json", "spritesheet.png", "runtime-preview"],
