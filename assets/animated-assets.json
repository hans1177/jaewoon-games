{
  "version": 3,
  "purpose": "바이브2 웹게임 검증 애니메이션·Motion Engine 에셋 카탈로그",
  "rules": {
    "animationRequired": true,
    "rawStaticOnlyBlocked": true,
    "staticCharacterBlockedWithoutMotionEvidence": true,
    "staticEnemyBlockedWithoutMotionEvidence": true,
    "staticBossBlockedWithoutMotionEvidence": true,
    "geometricActorBlocked": true,
    "actorSelectionRequiresOneOf": [
      ["verified", "spritesheet-or-frame-files", "animation-preview-or-documented-animation-list", "locomotion-animation"],
      ["motion-engine-eligible", "motion-engine-profile", "runtime-motion-evidence", "mobile-performance-pass"]
    ],
    "locomotionAnimations": ["move", "walk", "run", "jump", "fly", "swim", "crawl"],
    "motionEnginePath": "assets/jaewoon-motion-engine.js",
    "motionEnginePresentationOnly": true,
    "preferExistingRepositoryAssets": true,
    "externalAssetTarget": "assets/animated/",
    "distributionReviewRequired": true,
    "licenseLedgerRequired": true
  },
  "assets": [
    {
      "id": "oga-animated-monsters",
      "name": "Animated Monsters",
      "source": "OpenGameArt",
      "sourceUrl": "https://opengameart.org/content/animated-monsters",
      "license": "CC0",
      "characters": ["zombie", "skeleton", "witch"],
      "animations": ["idle", "walk", "punch", "hurt", "fall"],
      "normalizedStates": ["idle", "move", "attack", "hit", "death"],
      "format": ["transparent-spritesheet"],
      "verified": true,
      "actorUsable": true,
      "downloaded": false,
      "priority": 1
    },
    {
      "id": "oga-adventurer-slime",
      "name": "Adventurer and Slime game Sprites",
      "source": "OpenGameArt",
      "sourceUrl": "https://opengameart.org/content/adventurer-and-slime-game-sprites",
      "license": "CC0",
      "characters": ["hero", "slime"],
      "animations": ["idle", "run", "move", "attack", "jump", "fall", "air-attack", "hurt", "dead"],
      "normalizedStates": ["idle", "move", "attack", "hit", "death"],
      "format": ["png"],
      "verified": true,
      "actorUsable": true,
      "downloaded": false,
      "priority": 1
    },
    {
      "id": "oga-basic-pixel-spells",
      "name": "Basic Pixel Animated Spells",
      "source": "OpenGameArt",
      "sourceUrl": "https://opengameart.org/content/basic-pixel-animated-spells",
      "license": "CC0",
      "characters": [],
      "animations": ["spell-1", "spell-2", "spell-3", "spell-4"],
      "frameInfo": "각 효과 6~10프레임",
      "format": ["gif", "png", "psd"],
      "verified": true,
      "actorUsable": false,
      "downloaded": false,
      "priority": 1
    },
    {
      "id": "oga-unity-slime-12",
      "name": "2D Slime Animated 12 Different Colors Unity Ready Prefab",
      "source": "OpenGameArt",
      "sourceUrl": "https://opengameart.org/content/2d-slime-animated-12-different-colors-unity-ready-prefab",
      "license": "CC0",
      "characters": ["slime-12-colors"],
      "animations": ["hurt", "idle", "jump", "attack", "die"],
      "normalizedStates": ["idle", "move", "attack", "hit", "death"],
      "format": ["unity-prefab", "psd", "clip"],
      "verified": true,
      "actorUsable": true,
      "downloaded": false,
      "priority": 1
    },
    {
      "id": "github-pixel-snapped-pirate-skeleton",
      "name": "AI Pixel Snapped Game Sprites",
