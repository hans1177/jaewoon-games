    "assetStrategies": ["KEEP", "ENHANCE", "COMBINE", "REPLACE"],
    "licenseLedgerRequired": true,
    "licenseLedgerFields": ["source", "creator", "license", "commercialUse", "modificationUse", "attribution", "verifiedAt", "targetGame", "purpose", "modified"],
    "styleGuideRequired": ["resolution", "palette", "outline", "shadow", "proportion", "uiShape", "vfxTone", "contrast"],
    "prototypePresetCatalog": "assets/prototype-asset-presets.json"
  },
