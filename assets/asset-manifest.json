  "policy": {
    "licensePriority": ["CC0", "public-domain", "MIT", "commercial-no-attribution", "CC-BY"],
    "blocked": ["NC", "unknown", "unclear-redistribution", "unknown-modification-rights", "lost-provenance"],
    "maxSingleAssetBytes": 104857600,
    "preferExistingAssets": true,
    "downloadOnDemand": true,
    "cacheAfterFirstUse": true,
    "requireVerifiedAnimationForActors": true,
    "allowStaticCharacter": false,
    "allowStaticEnemy": false,
    "allowStaticBoss": false,
    "allowGeometricActor": false,
    "allowStaticActorWithMotionEngine": true,
